# File: lit_program/apps/chat.lit
# App: GEMMA AI CHAT (Ứng dụng Hội thoại AI chạy trên nền std_tensor.lit & 16GB HugePage RAM)

include ../lib/ui_window.lit
include ../lib/ai_api.lit

# 1. Render lịch sử hội thoại trong cửa sổ Chat
func chat_render_messages void %0:ptr<VgaCell,921600> %1:ptr<DiskQword,64> %2:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000

    @b0
        %3 = const 0 bv64
        %4 = const 240 bv64
        %5 = const 148 bv64
        jmp @b1 %3 %4 %5

    @b1 %6:bv64 %7:bv64 %8:bv64
        @inv ule %6 512
        @inv uge %7 240
        @inv ule %7 1040
        @inv uge %8 148
        @inv ule %8 540
        %9 = const 512 bv64
        %10 = cmp ult %6 %9
        br %10 @b2 @b12

    @b2
        %20 = call std_mem_get_byte %2 %6
        %21 = const 0 bv64
        %22 = cmp eq %20 %21
        br %22 @b12 @b3

    @b3
        # Byte 10 (\n) -> Xuống dòng
        %23 = const 10 bv64
        %24 = cmp eq %20 %23
        br %24 @b4 @b8

    @b4
        %25 = const 500 bv64
        %26 = cmp ult %8 %25
        br %26 @b5 @b12

    @b5
        %27 = const 1 bv64
        %28 = add %6 %27
        %29 = const 240 bv64
        %30 = const 26 bv64
        %31 = add %8 %30
        jmp @b1 %28 %29 %31

    @b8
        %36 = const 1000 bv64
        %37 = cmp ugt %7 %36
        br %37 @b9 @b11

    @b9
        %38 = const 500 bv64
        %39 = cmp ult %8 %38
        br %39 @b10 @b12

    @b10
        %40 = const 240 bv64
        %41 = const 26 bv64
        %42 = add %8 %41
        jmp @b13 %40 %42

    @b11
        jmp @b13 %7 %8

    @b13 %43:bv64 %44:bv64
        @inv ule %6 511
        @inv uge %43 240
        @inv ule %43 1000
        @inv uge %44 148
        @inv ule %44 540
        %45 = const 0x38bdf8 bv32
        call gfx_draw_char16 %0 %1 %43 %44 %20 %45
        %46 = const 16 bv64
        %47 = add %43 %46
        %48 = const 1 bv64
        %49 = add %6 %48
        jmp @b1 %49 %47 %44

    @b12
        ret
}

# 2. Hàm bắt buộc của App: Tự vẽ Icon AI màu Tím (52x52) lên Thanh Dock!
func app_draw_icon void %0:ptr<VgaCell,921600> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ule %1 1200
    @req ule %2 650

    @b0
        # 1. Nền khối AI màu Tím đậm (0x7e22ce) kích thước 52x52
        %3 = const 52 bv64
        %4 = add %1 %3
        %5 = add %2 %3
        %6 = const 0x7e22ce bv32
        call gfx_fill_rect %0 %1 %2 %4 %5 %6

        # 2. Khung màn hình Robot/Chat sáng màu Tím hồng (0xa855f7) bên trong
        %7 = const 8 bv64
        %8 = const 44 bv64
        %9 = add %1 %7
        %10 = add %1 %8
        %11 = add %2 %7
        %12 = add %2 %8
        %13 = const 0x1e1b4b bv32
        call gfx_fill_rect %0 %9 %11 %10 %12 %13

        # 3. Hai mắt AI sáng màu Xanh Cyan (0x38bdf8)
        %14 = const 15 bv64
        %15 = const 22 bv64
        %16 = const 29 bv64
        %17 = const 36 bv64
        %18 = add %1 %14
        %19 = add %1 %15
        %20 = add %1 %16
        %21 = add %1 %17
        %22 = add %2 %15
        %23 = add %2 %16
        %24 = const 0x38bdf8 bv32
        call gfx_fill_rect %0 %18 %22 %19 %23 %24
        call gfx_fill_rect %0 %20 %22 %21 %23 %24

        # 4. Vạch miệng cười phát sáng màu Vàng (0xfde047)
        %25 = const 34 bv64
        %26 = const 38 bv64
        %27 = add %2 %25
        %28 = add %2 %26
        %29 = const 0xfde047 bv32
        call gfx_fill_rect %0 %18 %27 %21 %28 %29

        # 5. Chấm tròn Active dưới chân Icon trên Dock
        %30 = const 23 bv64
        %31 = const 29 bv64
        %32 = const 60 bv64
        %33 = const 64 bv64
        %34 = add %1 %30
        %35 = add %1 %31
        %36 = add %2 %32
        %37 = add %2 %33
        call gfx_fill_rect %0 %34 %36 %35 %37 %24
        ret
}

# 3. Hàm chính của App Chat AI (Nhận %62 = Weights 0x40000000, %63 = Serial I/O 0x3f8)
func app_chat_main void %0:ptr<VgaCell,921600> %1:ptr<IpcChannel,1> %2:ptr<DiskQword,64> %3:ptr<DiskQword,64> %4:ptr<DiskQword,64> %62:ptr<DiskQword,2048> %63:io<0x3f8,0x3ff> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x70000000
    @req uge %3 0x10000
    @req ult %3 0x80000000
    @req uge %4 0x10000
    @req ult %4 0x80000000
    @req uge %62 0x10000
    @req ult %62 0x60000000

    @b0
        %5 = load %1 16 bv64                # mouse_x
        %6 = load %1 24 bv64                # mouse_y
        %7 = load %1 32 bv64                # mouse_click

        %8 = const 220 bv64                 # win_x
        %9 = const 60 bv64                  # win_y
        %10 = const 840 bv64                # win_w
        %11 = const 540 bv64                # win_h
        %12 = const 0 bv64
        %13 = const 1 bv64

        %14 = load %1 112 bv64
        %15 = cmp eq %14 %12
        br %15 @b10 @b1

    @b1
        %16 = cmp ne %7 %12
        br %16 @b2 @b6

    @b2
        %17 = call ui_win_check_close %5 %6 %7 %8 %9 %10
        %18 = cmp ne %17 %12
        br %18 @b21 @b3

    @b21
        call std_mem_zero %2
        call ui_win_close_app %1
        ret

    @b3
        %19 = const 96 bv64
        %20 = const 28 bv64
        %21 = const 90 bv64

        # Nút [SEND] màu Tím (x = 240, y = 96, w = 90, h = 28)
        %22 = const 240 bv64
        %23 = call ui_btn_hit %5 %6 %7 %22 %19 %21 %20
        %24 = cmp ne %23 %12
        br %24 @b4 @b5

    @b4
        # Gọi AI suy luận (Kết nối Gemma 4 E4B qua %63 hoặc chạy Tensor tại %62)
        call ai_chat_reply %2 %62 %63
        jmp @b12

    @b5
        # Nút [CLEAR] xóa lịch sử chat (x = 350, y = 96, w = 90, h = 28)
        %25 = const 350 bv64
        %26 = call ui_btn_hit %5 %6 %7 %25 %19 %21 %20
        %27 = cmp ne %26 %12
        br %27 @b51 @b99

    @b51
        call std_mem_zero %2
        %28 = const 0x203e bv64             # "> "
        %29 = const 2 bv64
        call ai_append_qword %2 %28 %29
        jmp @b12

    @b6
        %30 = load %1 0 bv64
        %31 = cmp ne %30 %12
        br %31 @b7 @b99

    @b7
        store %1 0 %12
        %32 = load %1 8 bv8
        %33 = const 27 bv8                  # Phím ESC -> Đóng App
        %34 = cmp eq %32 %33
        br %34 @b21 @b8

    @b8
        # Bấm phím Enter (ASCII 10) -> Gửi tin nhắn cho AI!
        %35 = const 10 bv8
        %36 = cmp eq %32 %35
        br %36 @b4 @b9

    @b9
        call std_str_push_or_bs %2 %32
        jmp @b12

    @b10
        store %1 112 %13
        call std_mem_zero %2
        %37 = const 0x205944414552203e bv64 # "> READY "
        %38 = const 8 bv64
        call ai_append_qword %2 %37 %38
        %39 = const 0x203e0a bv64           # "\n> "
        %40 = const 3 bv64
        call ai_append_qword %2 %39 %40

        %41 = const 0x2054414843204941 bv64 # "AI CHAT "
        %42 = const 0x0f172a bv32
        call ui_win_draw %0 %3 %8 %9 %10 %11 %41 %42

        %43 = const 240 bv64
        %44 = const 96 bv64
        %45 = const 90 bv64
        %46 = const 28 bv64
        %47 = const 0x9333ea bv32
        %48 = const 0xffffff bv32
        %49 = const 0x444e4553 bv64         # "SEND"
        %50 = const 4 bv64
        call ui_btn_draw_text %0 %3 %43 %44 %45 %46 %47 %48 %49 %50 %12

        %51 = const 350 bv64
        %52 = const 0x334155 bv32
        %53 = const 0x5241454c43 bv64       # "CLEAR"
        %54 = const 5 bv64
        call ui_btn_draw_text %0 %3 %51 %44 %45 %46 %52 %48 %53 %54 %12

        call chat_render_messages %0 %3 %2
        %55 = const 1066 bv64
        %56 = const 606 bv64
        call ui_invalidate_rect %1 %8 %9 %55 %56
        ret

    @b12
        %57 = const 230 bv64
        %58 = const 136 bv64
        %59 = const 1050 bv64
        %60 = const 580 bv64
        %61 = const 0x0f172a bv32
        call gfx_fill_rect %0 %57 %58 %59 %60 %61
        call chat_render_messages %0 %3 %2
        call ui_invalidate_rect %1 %57 %58 %59 %60
        ret

    @b99
        ret
}
