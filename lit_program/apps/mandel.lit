# File: lit_program/apps/mandel.lit
# App MANDELBROT: vẽ tập Mandelbrot bằng số điểm cố định Q4.60 (std/fixq.lit), chia hàng cho mọi nhân CPU bằng
# `parallel`, vẽ dần từng lô hàng mỗi nhịp (run_req) nên hệ thống không bị đứng khi đang tính.
#
# Điều khiển: nhấn chuột = lấy điểm đó làm tâm + phóng x2 | + / - phóng to / thu nhỏ | W A S D di chuyển
#             Z bật/tắt tự phóng (vào tâm hiện tại) | T chuyến tham quan vùng cá ngựa (tự phóng) | R về đầu | ESC đóng
#
# GIỚI HẠN PHÓNG: Q4.60 có 60 bit lẻ, bước điểm ảnh nhỏ nhất MB_STEP_MIN (đo bằng tools/mandel_model.py). Phóng sâu
# hơn cần số nhiều chữ số + kỹ thuật nhiễu loạn (perturbation) — chưa có. Tự phóng chạm đáy thì quay lại từ đầu.
#
# Trạng thái (Qword đầu của st): 0 magic, 3 cx, 4 cy, 5 step (độ dài 1 điểm ảnh), 6 hàng kế tiếp cần vẽ, 7 tự phóng,
# 8 số khung đã xong, 1/2 kích thước cửa sổ đã vẽ. Bộ đệm `parallel`: st[4096 ..), tối đa 16 phần x 17168 Qword
# (16 Qword đầu + 16 hàng x 1072 điểm ảnh). Số phần = số nhân (smp_workers + 1), nên mỗi nhịp <= 16 hàng mỗi nhân.

include ../std/fmt.lit
include ../std/widget.lit
include ../std/mem.lit
include ../std/fixq.lit

def MB_MAGIC 0x4d414e44454c3031              # "10LEDNAM"
def MB_TITLE 0x20204c45444e414d              # "MANDEL  "
def MB_BG 0x000764
def MB_PART 17168                           # Qword mỗi phần của `parallel`: 16 đầu + 16 hàng x 1072
def MB_PAR_N 274688                         # 16 x MB_PART
def MB_PAR_OFF 4096
def MB_SPAN 0x3400000000000000              # 3.25: bề ngang khung nhìn ban đầu
def MB_STEP_MAX 0x20000000000000            # 2^-7 mỗi điểm ảnh
def MB_STEP_MIN 0x4000                      # 2^-46 mỗi điểm ảnh: đáy phóng (xem tools/mandel_model.py depth)
def MB_INIT_CX 0xf666666666666666           # -0.6
def MB_TGT_X 0xf42f97fbe46d59db             # -0.73838044743130 (bám biên: tools/mandel_model.py target)
def MB_TGT_Y 0x252b1d04cde76d3              #  0.14518910758298
def MB_BUDGET 3000000                       # số vòng lặp z^2+c mỗi nhân mỗi nhịp (~vài chục ms)
def MB_S_ZOOM 0x78204d4f4f5a                # "ZOOM x"
def MB_S_ITER 0x2052455449                  # "ITER "
def MB_S_FRAME 0x20454d415246               # "FRAME "
def MB_S_AUTO 0x4f545541                    # "AUTO"
def MB_S_LIMIT 0x54494d494c                 # "LIMIT"

data MB_L_HINT Byte {
    "CLICK +/- WASD Z T R"
}

# Icon 52x52: tập Mandelbrot thu nhỏ, x in [-2.05, 0.55), y in (-1.3, 1.3], bước 0.05
func app_draw_icon void %fb:ptr<VgaCell,1382400> %x:bv64 %y:bv64 {
    @req uge %fb 0x10000
    @req ult %fb 0x80000000
    @req ule %x 1200
    @req ule %y 650
    @b0
        jmp @r 0
    @r %j:bv64
        @inv ule %j 52
        @dec sub 52 %j
        %more = cmp ult %j 52
        br %more @row @done
    @row
        %dy = mul_wrap %j 0xcccccccccccccd
        %ci = sub_wrap 0x14cccccccccccccd %dy
        %yy = add %y %j
        %base = mul %yy 1920
        jmp @c 0
    @c %i:bv64
        @inv ule %i 52
        @dec sub 52 %i
        %mc = cmp ult %i 52
        br %mc @px @next
    @px
        %dx = mul_wrap %i 0xcccccccccccccd
        %cr = add_wrap 0xdf33333333333333 %dx
        %n = call mb_iter %cr %ci 40
        %col = call mb_color %n 40
        %xx = add %x %i
        %o = add %base %xx
        %cell = slice %fb %o ptr<VgaCell,1>
        store %cell 0 %col
        %i1 = add %i 1
        jmp @c %i1
    @next
        %j1 = add %j 1
        jmp @r %j1
    @done
        ret
}

# Worker `parallel`: phần p = [x0, ytop, step, rộng, maxit, hàng đầu, khoảng cách hàng, số hàng (<= 16), ... 16 Qword
# đầu | 16 x 1072 Qword: số vòng của từng điểm ảnh, hàng r ở 16 + r*1072]
func mb_worker void %p:ptr<DiskQword,17168> %arg:bv64 %i:bv64 {
    @b0
        %x0 = call mem_get_q MB_PART %p 0
        %yt = call mem_get_q MB_PART %p 1
        %st = call mem_get_q MB_PART %p 2
        %w0 = call mem_get_q MB_PART %p 3
        %m0 = call mem_get_q MB_PART %p 4
        %row0 = call mem_get_q MB_PART %p 5
        %rs = call mem_get_q MB_PART %p 6
        %c0 = call mem_get_q MB_PART %p 7
        %w = call math_min %w0 1072
        %mi = call math_min %m0 4096
        %cnt = call math_min %c0 16
        jmp @r 0 %row0 16
    @r %k:bv64 %row:bv64 %base:bv64
        @inv ule %k %cnt
        @inv eq %base add 16 mul %k 1072
        @dec sub %cnt %k
        %rm = cmp ult %k %cnt
        br %rm @line @done
    @line
        %dy = mul_wrap %row %st
        %ci = sub_wrap %yt %dy
        jmp @l 0 %x0
    @l %x:bv64 %cr:bv64
        @inv ule %x %w
        @dec sub %w %x
        %more = cmp ult %x %w
        br %more @px @next
    @px
        %n = call mb_iter %cr %ci %mi
        %o = add %base %x
        call mem_set_q MB_PART %p %o %n
        %x1 = add %x 1
        %c1 = add_wrap %cr %st
        jmp @l %x1 %c1
    @next
        %k1 = add %k 1
        %row1 = add_wrap %row %rs
        %b1 = add %base 1072
        jmp @r %k1 %row1 %b1
    @done
        ret
}

# Bước điểm ảnh ban đầu cho bề ngang cw: 3.25 / cw
func mb_step0 bv64 %cw:bv64 {
    @req uge %cw 1
    @b0
        %s = udiv MB_SPAN %cw
        %r = call math_min %s MB_STEP_MAX
        ret %r
}

# Số vòng tối đa tăng theo độ sâu: 96 + 48 * log2(step0 / step), tối đa 2000
func mb_maxit bv64 %step0:bv64 %step:bv64 {
    @ens uge %r 96
    @ens ule %r 2000
    @b0
        %d = call math_max %step 1
        %mag = udiv %step0 %d
        jmp @l %mag 0
    @l %m:bv64 %k:bv64
        @inv ule %k 64
        @dec sub 64 %k
        %big = cmp ugt %m 1
        %lim = cmp ult %k 64
        %go = and %big %lim
        br %go @sh @done
    @sh
        %m1 = lshr %m 1
        %k1 = add %k 1
        jmp @l %m1 %k1
    @done
        %e = mul %k 48
        %t = add %e 96
        %r0 = call math_min %t 2000
        %r = call math_max %r0 96
        ret %r
}

# Tọa độ thực của cột 0 / ảo của hàng 0
func mb_x0 bv64 %cx:bv64 %step:bv64 %cw:bv64 {
    @b0
        %h = lshr %cw 1
        %d = mul_wrap %h %step
        %r = sub_wrap %cx %d
        ret %r
}

func mb_ytop bv64 %cy:bv64 %step:bv64 %rh:bv64 {
    @b0
        %h = lshr %rh 1
        %d = mul_wrap %h %step
        %r = add_wrap %cy %d
        ret %r
}

func mb_reset void %s:ptr<DiskQword,16> %cw:bv64 {
    @req uge %cw 1
    @b0
        %st = call mb_step0 %cw
        call mem_set_q 16 %s 3 MB_INIT_CX
        call mem_set_q 16 %s 4 0
        call mem_set_q 16 %s 5 %st
        call mem_set_q 16 %s 6 0
        call mem_set_q 16 %s 7 0
        call mem_set_q 16 %s 8 0
        ret
}

# Ghi đầu của n phần cho t hàng (row .. row+t-1): phần j vẽ các hàng row+j, row+j+n, ... (< row+t)
func mb_headers void %buf:ptr<DiskQword,274688> %n:bv64 %t:bv64 %x0:bv64 %yt:bv64 %step:bv64 %cw:bv64 %maxit:bv64 %row:bv64 {
    @req ule %n 16
    @req uge %n 1
    @b0
        jmp @l 0
    @l %j:bv64
        @inv ule %j %n
        @dec sub %n %j
        %more = cmp ult %j %n
        br %more @set @done
    @set
        %o = mul %j MB_PART
        %p = slice %buf %o ptr<DiskQword,17168>
        call mem_set_q MB_PART %p 0 %x0
        call mem_set_q MB_PART %p 1 %yt
        call mem_set_q MB_PART %p 2 %step
        call mem_set_q MB_PART %p 3 %cw
        call mem_set_q MB_PART %p 4 %maxit
        %r = add_wrap %row %j
        call mem_set_q MB_PART %p 5 %r
        call mem_set_q MB_PART %p 6 %n
        # số hàng của phần j = ceil((t - j) / n)
        %tj = sub_sat %t %j
        %tn = add_sat %tj %n
        %tn1 = sub_sat %tn 1
        %c = udiv %tn1 %n
        call mem_set_q MB_PART %p 7 %c
        %j1 = add %j 1
        jmp @l %j1
    @done
        ret
}

# Tô hàng y của client từ số vòng ở part[off ..)
func mb_blit_row void %px:ptr<VgaCell,1205558> %cw:bv64 %y:bv64 %part:ptr<DiskQword,17168> %off:bv64 %maxit:bv64 {
    @req ule %cw 1070
    @req ult %y 524
    @req ule %off 16096
    @b0
        %base = mul %y 1920
        jmp @l 0
    @l %x:bv64
        @inv ule %x %cw
        @dec sub %cw %x
        %more = cmp ult %x %cw
        br %more @px @done
    @px
        %k = add %off %x
        %n = call mem_get_q MB_PART %part %k
        %c = call mb_color %n %maxit
        %o = add %base %x
        %cell = slice %px %o ptr<VgaCell,1>
        store %cell 0 %c
        %x1 = add %x 1
        jmp @l %x1
    @done
        ret
}

# Chép kết quả của n phần (hàng row .. row+t-1) lên client; hàng >= rh bị bỏ (kiểm lúc chạy)
func mb_blit_all void %px:ptr<VgaCell,1205558> %cw:bv64 %buf:ptr<DiskQword,274688> %n:bv64 %row:bv64 %rh:bv64 %maxit:bv64 {
    @req ule %n 16
    @req ule %cw 1070
    @req ule %rh 524
    @b0
        jmp @l 0
    @l %j:bv64
        @inv ule %j %n
        @dec sub %n %j
        %more = cmp ult %j %n
        br %more @one @done
    @one
        %o = mul %j MB_PART
        %p = slice %buf %o ptr<DiskQword,17168>
        %c0 = call mem_get_q MB_PART %p 7
        %cnt = call math_min %c0 16
        %y0 = add_sat %row %j
        jmp @r 0 %y0 16
    @r %k:bv64 %y:bv64 %off:bv64
        @inv ule %k %cnt
        @inv eq %off add 16 mul %k 1072
        @dec sub %cnt %k
        %rm = cmp ult %k %cnt
        br %rm @chk @nextj
    @chk
        %iny = cmp ult %y %rh
        br %iny @blit @skip
    @blit
        call mb_blit_row %px %cw %y %p %off %maxit
        jmp @skip
    @skip
        %k1 = add %k 1
        %y1 = add_sat %y %n
        %off1 = add %off 1072
        jmp @r %k1 %y1 %off1
    @nextj
        %j1 = add %j 1
        jmp @l %j1
    @done
        ret
}

# Thanh trạng thái: ZOOM x<độ phóng>  ITER <maxit>  FRAME <n>  [AUTO] [LIMIT]  ... gợi ý phím bên phải
func mb_status void %px:ptr<VgaCell,1205558> %cw:bv64 %ch:bv64 %mag:bv64 %maxit:bv64 %frame:bv64 %auto:bv64 %limit:bv64 {
    @req ule %cw 1070
    @b0
        %y = call wg_statusbar %px %cw %ch 24
        %ty = add_sat %y 6
        %a = call wg_qtext %px %cw %ch 10 %ty MB_S_ZOOM WG_INK
        %b = call wg_number %px %cw %ch %a %ty %mag WG_INK
        %b2 = add_sat %b 18
        %c = call wg_qtext %px %cw %ch %b2 %ty MB_S_ITER WG_INK2
        %d = call wg_number %px %cw %ch %c %ty %maxit WG_INK2
        %d2 = add_sat %d 18
        %e = call wg_qtext %px %cw %ch %d2 %ty MB_S_FRAME WG_INK2
        %f = call wg_number %px %cw %ch %e %ty %frame WG_INK2
        %f2 = add_sat %f 18
        %on = cmp ne %auto 0
        br %on @auto @noauto
    @noauto
        jmp @lim %f2
    @auto
        %g = call wg_qtext %px %cw %ch %f2 %ty MB_S_AUTO WG_ACCENT
        %g2 = add_sat %g 18
        jmp @lim %g2
    @lim %lx:bv64
        %atl = cmp ne %limit 0
        br %atl @limit @hint
    @limit
        %z = call wg_qtext %px %cw %ch %lx %ty MB_S_LIMIT 0xdc2626
        jmp @hint
    @hint
        %hl = addr MB_L_HINT
        %hx = sub_sat %cw 190
        call wg_label %px %cw %ch %hx %ty MB_L_HINT.len %hl WG_INK2
        ret
}

# Phím: trả 1 nếu khung nhìn đổi
func mb_on_key bv64 %s:ptr<DiskQword,16> %k:bv8 %cw:bv64 {
    @req uge %cw 1
    @b0
        %cx = call mem_get_q 16 %s 3
        %cy = call mem_get_q 16 %s 4
        %st = call mem_get_q 16 %s 5
        %pan = mul_wrap %st 48
        %i1 = cmp eq %k 43
        %i2 = cmp eq %k 61
        %in = or %i1 %i2
        br %in @zin @n1
    @zin
        %h = lshr %st 1
        %v1 = call math_max %h MB_STEP_MIN
        call mem_set_q 16 %s 5 %v1
        ret 1
    @n1
        %o = cmp eq %k 45
        br %o @zout @n2
    @zout
        %dd = shl %st 1
        %v2 = call math_min %dd MB_STEP_MAX
        call mem_set_q 16 %s 5 %v2
        ret 1
    @n2
        %z = cmp eq %k 122
        br %z @auto @n3
    @auto
        %a0 = call mem_get_q 16 %s 7
        %a1 = xor %a0 1
        %a2 = and %a1 1
        call mem_set_q 16 %s 7 %a2
        ret 1
    @n3
        %t = cmp eq %k 116
        br %t @tour @n4
    @tour
        %st0 = call mb_step0 %cw
        call mem_set_q 16 %s 3 MB_TGT_X
        call mem_set_q 16 %s 4 MB_TGT_Y
        call mem_set_q 16 %s 5 %st0
        call mem_set_q 16 %s 7 1
        ret 1
    @n4
        %r = cmp eq %k 114
        br %r @reset @n5
    @reset
        call mb_reset %s %cw
        ret 1
    @n5
        %kw = cmp eq %k 119
        br %kw @up @n6
    @up
        %y1 = add_wrap %cy %pan
        %y1c = call fq_clamp2 %y1
        call mem_set_q 16 %s 4 %y1c
        ret 1
    @n6
        %ks = cmp eq %k 115
        br %ks @down @n7
    @down
        %y2 = sub_wrap %cy %pan
        %y2c = call fq_clamp2 %y2
        call mem_set_q 16 %s 4 %y2c
        ret 1
    @n7
        %ka = cmp eq %k 97
        br %ka @left @n8
    @left
        %x1 = sub_wrap %cx %pan
        %x1c = call fq_clamp2 %x1
        call mem_set_q 16 %s 3 %x1c
        ret 1
    @n8
        %kd = cmp eq %k 100
        br %kd @right @none
    @right
        %x2 = add_wrap %cx %pan
        %x2c = call fq_clamp2 %x2
        call mem_set_q 16 %s 3 %x2c
        ret 1
    @none
        ret 0
}

# Nhấn chuột ở (mx, my) của vùng ảnh: lấy làm tâm, phóng x2. Trả 1 nếu khung nhìn đổi.
func mb_on_click bv64 %s:ptr<DiskQword,16> %mx:bv64 %my:bv64 %cw:bv64 %rh:bv64 {
    @b0
        %inx = cmp ult %mx %cw
        %iny = cmp ult %my %rh
        %in = and %inx %iny
        br %in @hit @miss
    @hit
        %cx = call mem_get_q 16 %s 3
        %cy = call mem_get_q 16 %s 4
        %st = call mem_get_q 16 %s 5
        %x0 = call mb_x0 %cx %st %cw
        %yt = call mb_ytop %cy %st %rh
        %dx = mul_wrap %mx %st
        %nx = add_wrap %x0 %dx
        %dy = mul_wrap %my %st
        %ny = sub_wrap %yt %dy
        %nxc = call fq_clamp2 %nx
        %nyc = call fq_clamp2 %ny
        call mem_set_q 16 %s 3 %nxc
        call mem_set_q 16 %s 4 %nyc
        %h = lshr %st 1
        %v = call math_max %h MB_STEP_MIN
        call mem_set_q 16 %s 5 %v
        ret 1
    @miss
        ret 0
}

func app_mandel_main void %fb:ptr<VgaCell,1382400> %ipc:ptr<IpcChannel,1> %st:ptr<DiskQword,3932160> %font:ptr<DiskQword,64> %x4:ptr<DiskQword,64> %smp:smp {
    @req uge %fb 0x10000
    @req ult %fb 0x80000000
    @req uge %ipc 0x10000
    @req ult %ipc 0x80000000
    @req uge %font 0x10000
    @req ult %font 0x80000000
    @b0
        %w = call wg_pick_w %ipc 800 400 1074
        %h = call wg_pick_h %ipc 520 200 558
        %cw = sub %w 4
        %ch = sub %h 34
        %rh = sub %ch 24
        %px = call wg_client %fb
        %s = slice %st 0 ptr<DiskQword,16>
        %mg = call mem_get_q 16 %s 0
        %fresh = cmp ne %mg MB_MAGIC
        br %fresh @init @have
    @init
        call mb_reset %s %cw
        call mem_set_q 16 %s 0 MB_MAGIC
        jmp @have
    @have
        %ow = call mem_get_q 16 %s 1
        %oh = call mem_get_q 16 %s 2
        %drawn = load %ipc IpcChannel.win_drawn
        %c1 = cmp ne %w %ow
        %c2 = cmp ne %h %oh
        %c3 = cmp eq %drawn 0
        %c12 = or %c1 %c2
        %c123 = or %c12 %c3
        br %c123 @full @input
    @full
        store %ipc IpcChannel.win_drawn 1
        call mem_set_q 16 %s 1 %w
        call mem_set_q 16 %s 2 %h
        call wg_window_open %fb %font %ipc %w %h MB_TITLE MB_BG
        call wg_damage_window %ipc %w %h
        call mem_set_q 16 %s 6 0
        jmp @input
    @input
        %k = call sys_key_pop %ipc
        %esc = cmp eq %k 27
        br %esc @close @key
    @close
        call sys_close %ipc
        ret
    @key
        %kc = call mb_on_key %s %k %cw
        %cl = call sys_click_take %ipc
        %hasc = cmp ne %cl 0
        br %hasc @click @noclick
    @noclick
        jmp @chg %kc
    @click
        %mx = call wg_mouse_x %ipc
        %my = call wg_mouse_y %ipc
        %cc = call mb_on_click %s %mx %my %cw %rh
        %any = or %kc %cc
        jmp @chg %any
    @chg %changed:bv64
        %ch1 = cmp ne %changed 0
        br %ch1 @restart @render
    @restart
        call mem_set_q 16 %s 6 0
        jmp @render
    @render
        store %ipc IpcChannel.run_req 1
        %row = call mem_get_q 16 %s 6
        %cx = call mem_get_q 16 %s 3
        %cy = call mem_get_q 16 %s 4
        %step = call mem_get_q 16 %s 5
        %step0 = call mb_step0 %cw
        %maxit = call mb_maxit %step0 %step
        %todo = cmp ult %row %rh
        br %todo @batch @fdone
    @batch
        %r0 = cmp eq %row 0
        br %r0 @stat @calc
    @stat
        %sd = call math_max %step 1
        %mag0 = udiv %step0 %sd
        %mag = call math_max %mag0 1
        %fr = call mem_get_q 16 %s 8
        %au = call mem_get_q 16 %s 7
        %lim = cmp ule %step MB_STEP_MIN
        call mb_status %px %cw %ch %mag %maxit %fr %au %lim
        %sy = sub %ch 25
        call wg_damage %ipc 0 %sy %cw %ch
        jmp @calc
    @calc
        %x0 = call mb_x0 %cx %step %cw
        %yt = call mb_ytop %cy %step %rh
        %nw = smp_workers %smp
        %cores = add %nw 1
        %per = mul %cw %maxit
        %bud = mul %cores MB_BUDGET
        %q = udiv %bud %per
        %left = sub %rh %row
        # n phần = số nhân (runtime giao phần i cho AP có APIC ID i, phần >= số nhân chạy trên nhân gọi), mỗi phần
        # <= 16 hàng: t = min(ngân sách, 16 * n, số hàng còn lại)
        %cap = shl %cores 4
        %t1 = call math_min %q %cap
        %t2 = call math_min %t1 %left
        %t = call math_max %t2 1
        %n1 = call math_min %cores %t
        %n = call math_max %n1 1
        %buf = slice %st MB_PAR_OFF ptr<DiskQword,274688>
        call mb_headers %buf %n %t %x0 %yt %step %cw %maxit %row
        parallel %smp %n mb_worker %buf 0
        call mb_blit_all %px %cw %buf %n %row %rh %maxit
        %nr = add %row %t
        call mem_set_q 16 %s 6 %nr
        call wg_damage %ipc 0 %row %cw %nr
        ret
    @fdone
        %au2 = call mem_get_q 16 %s 7
        %on = cmp ne %au2 0
        br %on @next @idle
    @next
        %sh = lshr %step 3
        %ns = sub %step %sh
        %low = cmp ult %ns MB_STEP_MIN
        br %low @wrap @keep
    @keep
        jmp @zoom %ns
    @wrap
        jmp @zoom %step0
    @zoom %ns2:bv64
        call mem_set_q 16 %s 5 %ns2
        %f0 = call mem_get_q 16 %s 8
        %f1 = add_wrap %f0 1
        call mem_set_q 16 %s 8 %f1
        call mem_set_q 16 %s 6 0
        ret
    @idle
        store %ipc IpcChannel.run_req 0
        ret
}
