# File: lit_program/apps/editor.lit
# App #1: GRAPHICAL TEXT EDITOR (Chạy trên Lô 1: 64GB = 0x10_0000_0000)

include ../lib/ui_window.lit
include ../lib/ui_file_browser.lit
include ../lib/std_lib.lit
include ../lib/ipc_bus.lit
include ../lib/ui_canvas.lit
include ../lib/cap_mem.lit
include ../lib/ui_text_view.lit

# 1. Render văn bản streaming đa dòng qua thư viện dùng chung ui_text_view
func editor_render_text void %0:ptr<VgaCell,1382400> %1:ptr<DiskQword,64> %2:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x10000000000

    @b0
        %3 = const 220 bv64
        %4 = const 148 bv64
        %5 = const 1020 bv64
        %6 = const 520 bv64
        %7 = const 0x0f172a bv32
        %8 = const 1 bv64
        call ui_text_view_render %0 %1 %2 %3 %4 %5 %6 %7 %8
        ret
}

# 2. Hàm bắt buộc của mọi App: Tự vẽ Icon 52x52 của App lên Thanh Dock
func app_draw_icon void %0:ptr<VgaCell,1382400> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ule %1 1200
    @req ule %2 650

    @b0
        %3 = const 52 bv64
        %4 = add %1 %3
        %5 = add %2 %3
        %6 = const 0xf8fafc bv32
        call gfx_fill_rect %0 %1 %2 %4 %5 %6

        %7 = const 14 bv64
        %8 = add %2 %7
        %9 = const 0x3b82f6 bv32
        call gfx_fill_rect %0 %1 %2 %4 %8 %9

        %10 = const 8 bv64
        %11 = const 44 bv64
        %12 = add %1 %10
        %13 = add %1 %11

        %14 = const 22 bv64
        %15 = const 26 bv64
        %16 = add %2 %14
        %17 = add %2 %15
        %18 = const 0x64748b bv32
        call gfx_fill_rect %0 %12 %16 %13 %17 %18

        %19 = const 32 bv64
        %20 = const 36 bv64
        %21 = add %2 %19
        %22 = add %2 %20
        call gfx_fill_rect %0 %12 %21 %13 %22 %18

        %23 = const 42 bv64
        %24 = const 46 bv64
        %25 = add %2 %23
        %26 = add %2 %24
        call gfx_fill_rect %0 %12 %25 %13 %26 %18

        ret
}

# 3. Hàm ứng dụng Soạn thảo chính (Lưu toàn bộ trạng thái vào vùng nhớ riêng %2 tại Lô 64GB)
#    - Qword 0..61 (496 bytes): Nội dung văn bản
#    - Qword 62: Trạng thái Browser (0 = Edit, >0 = Browser prefix)
#    - Qword 63: LBA của file đang mở
func app_editor_main void %0:ptr<VgaCell,1382400> %1:ptr<IpcChannel,1> %2:ptr<DiskQword,128> %3:ptr<DiskQword,64> %4:ptr<DiskQword,64> %5:smp {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x10000000000
    @req uge %3 0x10000
    @req ult %3 0x80000000
    @req uge %4 0x10000
    @req ult %4 0x80000000

    @b0
        %500 = call ipc_mouse_get_x %1
        %6 = call ipc_mouse_get_y %1
        %7 = call ipc_mouse_get_click %1

        %8 = const 200 bv64
        %9 = const 60 bv64
        %10 = const 880 bv64
        %11 = const 540 bv64
        %12 = const 0 bv64
        %13 = const 1 bv64
        %200 = const 58 bv64                # Slot 58: Browser state
        %201 = const 59 bv64                # Slot 59: Open file LBA
        # Hai slot trên nằm ở SECTOR 1 của State (%211): sector 0 là văn bản và bị lệnh đọc file ghi đè toàn bộ
        # (trước đây slot ở sector 0 nên LBA bị xóa khi mở file -> SAVE không bao giờ ghi)
        %210 = const 64 bv64
        %211 = slice %2 %210 ptr<DiskQword,64>

        %14 = load %1 112 bv64
        %15 = cmp eq %14 %12
        br %15 @b35 @b1

    @b1
        %16 = cmp ne %7 %12
        br %16 @b2 @b30

    @b2
        %17 = call ui_win_poll_close %1 %8 %9 %10
        %18 = cmp ne %17 %12
        br %18 @b21 @b3

    @b21
        # Đóng qua interface chuẩn: Shell sẽ tự reset State %2 về 0!
        ret

    @b3
        %20 = const 96 bv64
        %21 = const 28 bv64

        %22 = const 240 bv64
        %23 = const 80 bv64
        %24 = call ui_btn_hit %500 %6 %7 %22 %20 %23 %21
        %25 = cmp ne %24 %12
        br %25 @b4 @b5

    @b4
        # Nút [NEW]: Xóa sạch văn bản + Slot 62 (mode = 0) + Slot 63 (lba = 0)
        call std_mem_zero %2
        call std_mem_zero %211
        jmp @b36

    @b5
        %27 = const 340 bv64
        %28 = const 110 bv64
        %29 = call ui_btn_hit %500 %6 %7 %27 %20 %28 %21
        %30 = cmp ne %29 %12
        br %30 @b6 @b7

    @b6
        # Nút [BROWSE]: Bật Browser mode ở Slot 62
        call cap_state_set %211 %200 %13
        jmp @b36

    @b7
        %32 = const 470 bv64
        %33 = call ui_btn_hit %500 %6 %7 %32 %20 %23 %21
        %34 = cmp ne %33 %12
        br %34 @b8 @b10

    @b8
        # Nút [SAVE]: Ghi lại Sector nếu Slot 63 > 0
        %35 = call cap_state_get %211 %201
        %36 = const 0xffffff bv64
        %37 = and %35 %36
        %38 = cmp ugt %37 %12
        br %38 @b81 @b99

    @b81
        call ipc_disk_req_write %1 %37
        ret

    @b10
        %41 = call cap_state_get %211 %200
        %42 = cmp ugt %41 %12
        br %42 @b11 @b99

    @b11
        %43 = sub %41 %13
        %44 = const 0x7f bv64
        %45 = and %43 %44
        %46 = const 8 bv64
        %47 = lshr %43 %46
        %48 = const 0xff bv64
        %49 = and %47 %48

        %50 = const 230 bv64
        %51 = const 140 bv64
        %52 = call ui_fb_handle_click %3 %4 %500 %6 %7 %50 %51 %49 %45

        %53 = const 32 bv64
        %54 = lshr %52 %53
        %55 = const 0xffffff bv64
        %105 = and %52 %55

        %106 = cmp eq %54 %13
        br %106 @b121 @b12

    @b121
        # Click thư mục: cập nhật Slot 62
        %107 = add %105 %13
        call cap_state_set %211 %200 %107
        jmp @b36

    @b12
        %108 = const 3 bv64
        %109 = cmp eq %54 %108
        br %109 @b122 @b99

    @b122
        # Click tệp: Tự cập nhật Slot 62 = 0 và Slot 63 = lba trước khi yêu cầu Shell đọc sector
        call cap_state_set %211 %200 %12
        call cap_state_set %211 %201 %105
        store %1 112 %12
        call ipc_disk_req_read %1 %105
        ret

    @b30
        %56 = call cap_state_get %211 %200
        %58 = cmp ugt %56 %12
        br %58 @b99 @b31

    @b31
        %61 = call ipc_key_pop %1
        %59 = const 0 bv8
        %60 = cmp ne %61 %59
        br %60 @b32 @b99

    @b32
        %62 = const 27 bv8
        %63 = cmp eq %61 %62
        br %63 @b321 @b33

    @b321
        call ui_win_close_app %1
        ret

    @b33
        # Kẹp chiều dài văn bản < 460 bytes để không bao giờ chạm vào Slot 58..63!
        %202 = call std_str_len %2
        %203 = const 460 bv64
        %204 = cmp ult %202 %203
        %205 = const 8 bv8
        %206 = cmp eq %61 %205
        %207 = or %204 %206
        br %207 @b331 @b99

    @b331
        call std_str_push_or_bs %2 %61
        %64 = const 14 bv64
        %65 = const 82 bv64
        %66 = const 862 bv64
        %67 = const 502 bv64
        %68 = const 0xffffff bv32
        call canvas_fill_rect %0 %64 %65 %66 %67 %68
        call editor_render_text %0 %3 %2
        call canvas_invalidate_rect %1 %64 %65 %66 %67
        ret

    @b35
        store %1 112 %13
        %73 = const 0x2020524f54494445 bv64
        %74 = const 0xffffff bv32
        call ui_win_draw %0 %3 %8 %9 %10 %11 %73 %74
        %75 = const 1086 bv64
        %76 = const 606 bv64
        call ui_invalidate_rect %1 %8 %9 %75 %76
        jmp @b36

    @b36
        %77 = call cap_state_get %211 %200
        %79 = cmp ugt %77 %12

        %80 = const 96 bv64
        %81 = const 28 bv64
        %82 = const 0x2563eb bv32
        %83 = const 0x334155 bv32
        %84 = const 0xffffff bv32
        %85 = const 3 bv64
        %86 = const 6 bv64
        %87 = const 4 bv64

        %88 = const 240 bv64
        %89 = const 80 bv64
        %90 = const 0x57454e bv64
        call ui_btn_draw_text %0 %3 %88 %80 %89 %81 %83 %84 %90 %85 %12

        %91 = const 340 bv64
        %92 = const 110 bv64
        %93 = const 0x4553574f5242 bv64
        br %79 @b361 @b362

    @b361
        call ui_btn_draw_text %0 %3 %91 %80 %92 %81 %82 %84 %93 %86 %12
        jmp @b37

    @b362
        call ui_btn_draw_text %0 %3 %91 %80 %92 %81 %83 %84 %93 %86 %12
        jmp @b37

    @b37
        %94 = const 470 bv64
        %95 = const 0x45564153 bv64
        call ui_btn_draw_text %0 %3 %94 %80 %89 %81 %83 %84 %95 %87 %12

        %96 = const 0 bv64
        %97 = const 876 bv64
        %98 = const 70 bv64
        %99 = const 536 bv64
        %103 = const 34 bv64
        br %79 @b40 @b50

    @b40
        %100 = const 0x0f172a bv32
        call canvas_fill_rect %0 %96 %98 %97 %99 %100
        %101 = const 230 bv64
        %102 = const 140 bv64

        %110 = sub %77 %13
        %111 = const 0x7f bv64
        %112 = and %110 %111
        %113 = const 8 bv64
        %114 = lshr %110 %113
        %115 = const 0xff bv64
        %116 = and %114 %115

        call ui_fb_render %0 %3 %4 %101 %102 %116 %112
        call canvas_invalidate_rect %1 %96 %103 %97 %99
        ret

    @b50
        call canvas_fill_rect %0 %96 %98 %97 %99 %84
        call editor_render_text %0 %3 %2
        call canvas_invalidate_rect %1 %96 %103 %97 %99
        ret

    @b99
        ret
}
