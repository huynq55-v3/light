# File: lit_program/apps/editor.lit
# App #1: GRAPHICAL TEXT EDITOR (Chạy trên Lô 1: 64GB = 0x10_0000_0000)

include ../lib/ui_window.lit
include ../lib/ui_file_browser.lit
include ../lib/std_lib.lit
include ../lib/ipc_bus.lit
include ../lib/ui_canvas.lit
include ../lib/cap_mem.lit
include ../lib/lightfs_api.lit
include ../std/widget_fs.lit

# Bố cục (tọa độ client 876 x 506 của cửa sổ 880 x 540): thanh công cụ cao 52 (New / Open / Save + ô tên file),
# vùng tài liệu trắng, thanh trạng thái cao 28 (số ký tự, loại file). Khi duyệt file, vùng tài liệu là danh sách
# kiểu Finder (std/widget_fs.lit). Mọi hình vẽ đi qua bộ component std/widget.lit.
def ED_CW 876
def ED_CH 506
def ED_TB_H 52
def ED_SB_H 28
def ED_BTN_Y 12
def ED_BTN_H 28
def ED_NEW_X 16
def ED_NEW_W 64
def ED_OPEN_X 88
def ED_OPEN_W 72
def ED_SAVE_X 168
def ED_SAVE_W 64
def ED_FIELD_X 248
def ED_DOC_X 24
def ED_DOC_Y 68
def ED_TITLE 0x2020524f54494445         # "EDITOR  " (tên cửa sổ, compositor vẽ thanh tiêu đề)

data ED_L_NEW Byte {
    "New"
}
data ED_L_OPEN Byte {
    "Open"
}
data ED_L_SAVE Byte {
    "Save"
}
data ED_L_UNTITLED Byte {
    "Untitled"
}
data ED_L_CHARS Byte {
    "characters"
}
data ED_L_PLAIN Byte {
    "Plain Text"
}
data ED_L_PICK Byte {
    "Choose a file to open"
}

# 1. Vẽ lại toàn bộ client. %browse = 0 (soạn thảo) hoặc id thư mục + 1, %fid = id file đang mở (0 = chưa lưu)
func editor_draw void %fb:ptr<VgaCell,1382400> %text:ptr<DiskQword,64> %tab:ptr<DiskQword,4096> %browse:bv64 %fid:bv64 {
    @req uge %text 0x10000
    @req ult %text 0x10000000000
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @b0
        %px = call wg_client %fb
        call wg_box %px ED_CW ED_CH 0 0 ED_CW ED_CH WG_PAPER
        # thanh công cụ
        call wg_toolbar %px ED_CW ED_CH ED_TB_H
        %ln = addr ED_L_NEW
        call wg_pbutton %px ED_CW ED_CH ED_NEW_X ED_BTN_Y ED_NEW_W ED_BTN_H ED_L_NEW.len %ln 0
        %lo = addr ED_L_OPEN
        %isb = cmp ne %browse 0
        call wg_pbutton %px ED_CW ED_CH ED_OPEN_X ED_BTN_Y ED_OPEN_W ED_BTN_H ED_L_OPEN.len %lo %browse
        %ls = addr ED_L_SAVE
        call wg_pbutton %px ED_CW ED_CH ED_SAVE_X ED_BTN_Y ED_SAVE_W ED_BTN_H ED_L_SAVE.len %ls 0
        # ô tên file: biểu tượng tài liệu + tên (hoặc "Untitled")
        %fw = sub ED_CW ED_FIELD_X
        %fw1 = sub %fw 16
        call wg_field %px ED_CW ED_CH ED_FIELD_X ED_BTN_Y %fw1 ED_BTN_H
        call wg_icon_doc %px ED_CW ED_CH 258 17
        %ok1 = cmp ne %fid 0
        %ok2 = cmp ult %fid 256
        %ok = and %ok1 %ok2
        br %ok @named @untitled
    @named
        %id = call math_min %fid 255
        %e = call wg_fs_name %px ED_CW ED_CH 282 18 %tab %id WG_INK
        jmp @body
    @untitled
        %lu = addr ED_L_UNTITLED
        call wg_label %px ED_CW ED_CH 282 18 ED_L_UNTITLED.len %lu WG_INK2
        jmp @body
    @body
        # thanh trạng thái
        %sy = call wg_statusbar %px ED_CW ED_CH ED_SB_H
        %ty = add_sat %sy 7
        %dw = sub ED_CW 48
        br %isb @browser @editor
    @browser
        %dir0 = sub_sat %browse 1
        %dir = call math_min %dir0 255
        call wg_fs_list %px ED_CW ED_CH ED_DOC_X 64 %dw %tab %dir
        %lp = addr ED_L_PICK
        call wg_label %px ED_CW ED_CH 16 %ty ED_L_PICK.len %lp WG_INK2
        ret
    @editor
        %dh0 = sub_sat %sy ED_DOC_Y
        %dh = sub_sat %dh0 8
        call wg_textarea %px ED_CW ED_CH ED_DOC_X ED_DOC_Y %dw %dh %text WG_INK 1
        %n = call std_str_len %text
        %nx = call wg_number %px ED_CW ED_CH 16 %ty %n WG_INK2
        %cx = add_sat %nx 9
        %lc = addr ED_L_CHARS
        call wg_label %px ED_CW ED_CH %cx %ty ED_L_CHARS.len %lc WG_INK2
        %px2 = sub ED_CW 106
        %lpl = addr ED_L_PLAIN
        call wg_label %px ED_CW ED_CH %px2 %ty ED_L_PLAIN.len %lpl WG_INK2
        ret
}

# 2. Hàm bắt buộc của mọi App: icon 52x52 trên Dock (Dock tự bo góc): nền xanh nhạt, trang giấy trắng có dòng chữ,
#    bút chì vàng chéo góc
func app_draw_icon void %0:ptr<VgaCell,1382400> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ule %1 1200
    @req ule %2 650
    @b0
        %xe = add %1 52
        %ye = add %2 52
        call gfx_fill_rect %0 %1 %2 %xe %ye 0xdbeafe
        # trang giấy
        %px0 = add %1 12
        %py0 = add %2 7
        %px1 = add %1 40
        %py1 = add %2 45
        call gfx_fill_rect %0 %px0 %py0 %px1 %py1 0xffffff
        %sx0 = add %1 40
        %sy0 = add %2 9
        %sx1 = add %1 42
        %sy1 = add %2 47
        call gfx_fill_rect %0 %sx0 %sy0 %sx1 %sy1 0x93c5fd
        %bx0 = add %1 14
        %by0 = add %2 45
        call gfx_fill_rect %0 %bx0 %by0 %sx1 %sy1 0x93c5fd
        # dòng chữ
        %lx0 = add %1 17
        %lx1 = add %1 35
        %lx2 = add %1 29
        %a0 = add %2 14
        %a1 = add %2 16
        call gfx_fill_rect %0 %lx0 %a0 %lx1 %a1 0x007aff
        %b0 = add %2 21
        %b1 = add %2 23
        call gfx_fill_rect %0 %lx0 %b0 %lx1 %b1 0x9ca3af
        %c0 = add %2 27
        %c1 = add %2 29
        call gfx_fill_rect %0 %lx0 %c0 %lx1 %c1 0x9ca3af
        %d0 = add %2 33
        %d1 = add %2 35
        call gfx_fill_rect %0 %lx0 %d0 %lx2 %d1 0x9ca3af
        # bút chì chéo (bậc thang 3x3) ở góc dưới phải
        jmp @pen 0
    @pen %k:bv64
        @inv ule %k 7
        %more = cmp ult %k 7
        br %more @step @tip
    @step
        %k3 = mul %k 3
        %qx = add %1 26
        %qx0 = add %qx %k3
        %qy = add %2 44
        %qy0 = sub %qy %k3
        %qx1 = add %qx0 5
        %qy1 = add %qy0 5
        call gfx_fill_rect %0 %qx0 %qy0 %qx1 %qy1 0xf59e0b
        %k1 = add %k 1
        jmp @pen %k1
    @tip
        %tx0 = add %1 23
        %ty0 = add %2 46
        %tx1 = add %1 27
        %ty1 = add %2 50
        call gfx_fill_rect %0 %tx0 %ty0 %tx1 %ty1 0x374151
        ret
}

# 3. Tìm tên "noteN.txt" (N = 1..9) chưa có trong thư mục %1, ghi vào %2 (8 qword). Trả 1 nếu tìm được.
func editor_pick_name bv64 %0:ptr<DiskQword,4096> %1:bv64 %2:ptr<DiskQword,8> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req uge %2 0x10000
    @req ult %2 0x10000000000
    @ens ule %20 1

    @b0
        %3 = const 0 bv64
        %4 = const 1 bv64
        %5 = const 0x31 bv64
        jmp @b1 %5

    @b1 %6:bv64
        @inv uge %6 0x31
        @inv ule %6 0x3a
        %7 = const 0x3a bv64
        %8 = cmp ult %6 %7
        br %8 @b2 @b8

    @b2
        %9 = const 0x78742e0065746f6e bv64  # "note?.tx"
        %10 = const 32 bv64
        %11 = shl %6 %10
        %12 = or %9 %11
        %13 = slice %2 %3 ptr<DiskQword,1>
        store %13 0 %12
        %14 = slice %2 %4 ptr<DiskQword,1>
        %15 = const 0x74 bv64               # "t"
        store %14 0 %15
        jmp @b3 %4

    @b3 %16:bv64
        @inv uge %16 1
        @inv ule %16 7
        %17 = const 7 bv64
        %18 = cmp ult %16 %17
        br %18 @b4 @b5

    @b4
        %19 = add %16 %4
        %21 = slice %2 %19 ptr<DiskQword,1>
        store %21 0 %3
        jmp @b3 %19

    @b5
        %22 = call lfs_find_child %0 %1 %2
        %23 = cmp eq %22 %3
        br %23 @b6 @b7

    @b6
        jmp @b9 %4

    @b7
        %24 = add %6 %4
        jmp @b1 %24

    @b8
        jmp @b9 %3

    @b9 %20:bv64
        @inv ule %20 1
        ret %20
}

# 4. Hàm ứng dụng Soạn thảo chính. State:
#    - Sector 0 (qword 0..63): văn bản (< 460 byte, kết thúc bằng 0)
#    - Sector 1: slot 58 = duyệt file (0 = soạn thảo, > 0 = id thư mục + 1), 59 = id file đang mở, 60 = yêu cầu đang chờ
#    - Sector 2: tên file mới (CREATE)     Sector 16..: vùng đọc file (READ)
#    - Qword LFS_TAB_Q..: bản sao bảng LightFS do Kernel chép sau mỗi yêu cầu
func app_editor_main void %0:ptr<VgaCell,1382400> %1:ptr<IpcChannel,1> %2:ptr<DiskQword,3932160> %3:ptr<DiskQword,64> %4:ptr<DiskQword,64> %5:smp {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x10000000000
    @req uge %3 0x10000
    @req ult %3 0x80000000
    @req uge %4 0x10000
    @req ult %4 0x80000000

    @b0
        %500 = call ipc_mouse_get_x %1
        %6 = call ipc_mouse_get_y %1
        %7 = call ipc_mouse_get_click %1

        %8 = const 200 bv64
        %9 = const 60 bv64
        %10 = const 880 bv64
        %11 = const 540 bv64
        %12 = const 0 bv64
        %13 = const 1 bv64
        %200 = const 58 bv64                # slot 58: duyệt file
        %201 = const 59 bv64                # slot 59: id file đang mở
        %202 = const 60 bv64                # slot 60: yêu cầu LightFS đang chờ
        %210 = const 64 bv64
        %211 = slice %2 %210 ptr<DiskQword,64>
        %212 = slice %2 %12 ptr<DiskQword,64>   # văn bản
        %213 = const LFS_TAB_Q bv64
        %214 = slice %2 %213 ptr<DiskQword,4096>
        %215 = const 128 bv64
        %216 = slice %2 %215 ptr<DiskQword,8>   # tên file mới (sector 2)
        %217 = const 2 bv64
        %218 = const 3 bv64
        %219 = const 4 bv64
        %220 = const 16 bv64

        %14 = load %1 112 bv64
        %15 = cmp eq %14 %12
        br %15 @b35 @b100

    @b100
        # Kernel vừa phục vụ yêu cầu: xử lý kết quả, KHÔNG xử lý lại phím/chuột của lượt này
        %230 = call mem_get_q 64 %211 %202
        %231 = cmp eq %230 %12
        br %231 @b1 @b101

    @b101
        call mem_set_q 64 %211 %202 %12
        %232 = call lfs_result %1
        %233 = call lfs_is_err %232
        %234 = cmp ne %233 %12
        br %234 @b36 @b102

    @b102
        %235 = cmp eq %230 %217
        br %235 @b103 @b105

    @b103
        # READ xong: chép tối đa 456 byte đầu (57 qword) từ sector 16 vào văn bản, phần còn lại = 0
        %236 = const 1024 bv64
        %237 = slice %2 %236 ptr<DiskQword,64>
        jmp @b104 %12

    @b104 %238:bv64
        @inv ule %238 64
        %239 = const 64 bv64
        %240 = cmp ult %238 %239
        br %240 @b1041 @b36

    @b1041
        %241 = const 57 bv64
        %242 = cmp ult %238 %241
        %243 = call mem_get_q 64 %237 %238
        %244 = slice %212 %238 ptr<DiskQword,1>
        br %242 @b1042 @b1043

    @b1042
        store %244 0 %243
        jmp @b1044

    @b1043
        store %244 0 %12
        jmp @b1044

    @b1044
        %245 = add %238 %13
        jmp @b104 %245

    @b105
        %246 = cmp eq %230 %219
        br %246 @b106 @b36

    @b106
        # CREATE xong: ghi văn bản vào file mới
        call mem_set_q 64 %211 %201 %232
        jmp @b84

    @b1
        %16 = cmp ne %7 %12
        br %16 @b2 @b30

    @b2
        %17 = call ui_win_poll_close %1 %8 %9 %10
        %18 = cmp ne %17 %12
        br %18 @b21 @b3

    @b21
        # Đóng qua interface chuẩn: Shell sẽ tự reset State %2 về 0!
        ret

    @b3
        %20 = call wg_mouse_x %1            # tọa độ client
        %21 = call wg_mouse_y %1
        %24 = call wg_hit %20 %21 ED_NEW_X ED_BTN_Y ED_NEW_W ED_BTN_H
        %25 = cmp ne %24 %12
        br %25 @b4 @b5

    @b4
        # Nút [NEW]: xóa văn bản, đóng file đang mở
        call std_mem_zero %212
        call std_mem_zero %211
        jmp @b36

    @b5
        %29 = call wg_hit %20 %21 ED_OPEN_X ED_BTN_Y ED_OPEN_W ED_BTN_H
        %30 = cmp ne %29 %12
        br %30 @b6 @b7

    @b6
        # Nút [BROWSE]: duyệt từ thư mục gốc, xin bảng file mới nhất
        call mem_set_q 64 %211 %200 %13
        call mem_set_q 64 %211 %202 %13
        call lfs_request %1 %13 %12 %12 %12
        ret

    @b7
        %33 = call wg_hit %20 %21 ED_SAVE_X ED_BTN_Y ED_SAVE_W ED_BTN_H
        %34 = cmp ne %33 %12
        br %34 @b8 @b10

    @b8
        %35 = call mem_get_q 64 %211 %201
        %38 = cmp ne %35 %12
        br %38 @b84 @b85

    @b84
        # [SAVE] file đang mở: WRITE toàn bộ văn bản (sector 0)
        %39 = call mem_get_q 64 %211 %201
        %40 = call std_str_len %212
        call mem_set_q 64 %211 %202 %218
        call lfs_request %1 %218 %39 %12 %40
        ret

    @b85
        # [SAVE] chưa có file: tạo data/noteN.txt (hoặc ở gốc nếu không có data/)
        %250 = const 0x61746164 bv64        # "data"
        call mem_set_q 64 %211 %220 %250
        %251 = const 17 bv64
        call mem_set_q 64 %211 %251 %12
        %252 = const 18 bv64
        call mem_set_q 64 %211 %252 %12
        %253 = const 19 bv64
        call mem_set_q 64 %211 %253 %12
        %254 = const 20 bv64
        call mem_set_q 64 %211 %254 %12
        %255 = const 21 bv64
        call mem_set_q 64 %211 %255 %12
        %256 = const 22 bv64
        call mem_set_q 64 %211 %256 %12
        %257 = const 23 bv64
        call mem_set_q 64 %211 %257 %12
        %258 = slice %211 %220 ptr<DiskQword,8>
        %259 = call lfs_find_child %214 %12 %258
        %260 = call lfs_is_dir %214 %259
        %261 = cmp ne %260 %12
        br %261 @b86 @b87

    @b86
        jmp @b88 %259

    @b87
        jmp @b88 %12

    @b88 %262:bv64
        @inv ult %262 256
        %263 = call editor_pick_name %214 %262 %216
        %264 = cmp ne %263 %12
        br %264 @b89 @b99

    @b89
        call mem_set_q 64 %211 %202 %219
        call lfs_request %1 %219 %262 %217 %12
        ret

    @b10
        %41 = call mem_get_q 64 %211 %200
        %42 = cmp ugt %41 %12
        br %42 @b11 @b99

    @b11
        %43 = sub %41 %13
        %44 = const 255 bv64
        %45 = call std_min %43 %44
        %51 = sub ED_CW 48
        %52 = call wg_fs_hit %214 %20 %21 ED_DOC_X 64 %51 %45

        %53 = const 32 bv64
        %54 = lshr %52 %53
        %55 = const 0xff bv64
        %105 = and %52 %55
        %106 = cmp eq %54 %13
        %107 = cmp eq %54 %217
        %108 = or %106 %107
        br %108 @b121 @b12

    @b121
        # BACK hoặc thư mục: đổi thư mục đang duyệt
        %109 = add %105 %13
        call mem_set_q 64 %211 %200 %109
        jmp @b36

    @b12
        %110 = cmp eq %54 %218
        br %110 @b122 @b99

    @b122
        # Click file: mở bằng READ vào sector 16
        call mem_set_q 64 %211 %200 %12
        call mem_set_q 64 %211 %201 %105
        call mem_set_q 64 %211 %202 %217
        call lfs_request %1 %217 %105 %220 %12
        ret

    @b30
        %56 = call mem_get_q 64 %211 %200
        %58 = cmp ugt %56 %12
        br %58 @b99 @b31

    @b31
        %61 = call ipc_key_pop %1
        %59 = const 0 bv8
        %60 = cmp ne %61 %59
        br %60 @b32 @b99

    @b32
        %62 = const 27 bv8
        %63 = cmp eq %61 %62
        br %63 @b321 @b33

    @b321
        call ui_win_close_app %1
        ret

    @b33
        # Kẹp chiều dài văn bản < 460 bytes
        %203 = call std_str_len %212
        %204 = const 460 bv64
        %205 = cmp ult %203 %204
        %206 = const 8 bv8
        %207 = cmp eq %61 %206
        %208 = or %205 %207
        br %208 @b331 @b99

    @b331
        call std_str_push_or_bs %212 %61
        jmp @b36

    @b35
        store %1 112 %13
        %73 = const ED_TITLE bv64
        %74 = const 0xffffff bv32
        call ui_win_open %0 %3 %1 %8 %9 %10 %11 %73 %74
        %75 = const 1086 bv64
        %76 = const 606 bv64
        call ui_invalidate_rect %1 %8 %9 %75 %76
        # Xin bảng file ngay khi mở cửa sổ (cần cho SAVE / BROWSE)
        call mem_set_q 64 %211 %202 %13
        call lfs_request %1 %13 %12 %12 %12
        jmp @b36

    @b36
        %77 = call mem_get_q 64 %211 %200
        %275 = call mem_get_q 64 %211 %201
        call editor_draw %0 %212 %214 %77 %275
        call wg_damage %1 0 0 ED_CW ED_CH
        ret

    @b99
        ret
}
