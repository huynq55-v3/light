        %13 = add %1 %11

        %14 = const 22 bv64
        %15 = const 26 bv64
        %16 = add %2 %14
        %17 = add %2 %15
        %18 = const 0x64748b bv32
        call gfx_fill_rect %0 %12 %16 %13 %17 %18

        %19 = const 32 bv64
        %20 = const 36 bv64
        %21 = add %2 %19
        %22 = add %2 %20
        call gfx_fill_rect %0 %12 %21 %13 %22 %18

