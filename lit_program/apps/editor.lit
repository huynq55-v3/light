# File: lit_program/apps/editor.lit
# App #1: GRAPHICAL TEXT EDITOR (Chạy trên Lô 1: 64GB = 0x10_0000_0000)

include ../lib/ui_window.lit
include ../lib/ui_file_browser.lit
include ../lib/std_lib.lit
include ../lib/ipc_bus.lit
include ../lib/ui_canvas.lit
include ../lib/cap_mem.lit
include ../lib/ui_text_view.lit
include ../lib/lightfs_api.lit

# 1. Render văn bản streaming đa dòng qua thư viện dùng chung ui_text_view
func editor_render_text void %0:ptr<VgaCell,1382400> %1:ptr<DiskQword,64> %2:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x10000000000

    @b0
        %3 = const 220 bv64
        %4 = const 148 bv64
        %5 = const 1020 bv64
        %6 = const 520 bv64
        %7 = const 0x0f172a bv32
        %8 = const 1 bv64
        call ui_text_view_render %0 %1 %2 %3 %4 %5 %6 %7 %8
        ret
}

# 2. Hàm bắt buộc của mọi App: Tự vẽ Icon 52x52 của App lên Thanh Dock
func app_draw_icon void %0:ptr<VgaCell,1382400> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ule %1 1200
    @req ule %2 650

    @b0
        %3 = const 52 bv64
        %4 = add %1 %3
        %5 = add %2 %3
        %6 = const 0xf8fafc bv32
        call gfx_fill_rect %0 %1 %2 %4 %5 %6

        %7 = const 14 bv64
        %8 = add %2 %7
        %9 = const 0x3b82f6 bv32
        call gfx_fill_rect %0 %1 %2 %4 %8 %9

        %10 = const 8 bv64
        %11 = const 44 bv64
        %12 = add %1 %10
        %13 = add %1 %11

        %14 = const 22 bv64
        %15 = const 26 bv64
        %16 = add %2 %14
        %17 = add %2 %15
        %18 = const 0x64748b bv32
        call gfx_fill_rect %0 %12 %16 %13 %17 %18

        %19 = const 32 bv64
        %20 = const 36 bv64
        %21 = add %2 %19
        %22 = add %2 %20
        call gfx_fill_rect %0 %12 %21 %13 %22 %18

        %23 = const 42 bv64
        %24 = const 46 bv64
        %25 = add %2 %23
        %26 = add %2 %24
        call gfx_fill_rect %0 %12 %25 %13 %26 %18

        ret
}

# 3. Tìm tên "noteN.txt" (N = 1..9) chưa có trong thư mục %1, ghi vào %2 (8 qword). Trả 1 nếu tìm được.
func editor_pick_name bv64 %0:ptr<DiskQword,4096> %1:bv64 %2:ptr<DiskQword,8> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req uge %2 0x10000
    @req ult %2 0x10000000000
    @ens ule %20 1

    @b0
        %3 = const 0 bv64
        %4 = const 1 bv64
        %5 = const 0x31 bv64
        jmp @b1 %5

    @b1 %6:bv64
        @inv uge %6 0x31
        @inv ule %6 0x3a
        %7 = const 0x3a bv64
        %8 = cmp ult %6 %7
        br %8 @b2 @b8

    @b2
        %9 = const 0x78742e0065746f6e bv64  # "note?.tx"
        %10 = const 32 bv64
        %11 = shl %6 %10
        %12 = or %9 %11
        %13 = slice %2 %3 ptr<DiskQword,1>
        store %13 0 %12
        %14 = slice %2 %4 ptr<DiskQword,1>
        %15 = const 0x74 bv64               # "t"
        store %14 0 %15
        jmp @b3 %4

    @b3 %16:bv64
        @inv uge %16 1
        @inv ule %16 7
        %17 = const 7 bv64
        %18 = cmp ult %16 %17
        br %18 @b4 @b5

    @b4
        %19 = add %16 %4
        %21 = slice %2 %19 ptr<DiskQword,1>
        store %21 0 %3
        jmp @b3 %19

    @b5
        %22 = call lfs_find_child %0 %1 %2
        %23 = cmp eq %22 %3
        br %23 @b6 @b7

    @b6
        jmp @b9 %4

    @b7
        %24 = add %6 %4
        jmp @b1 %24

    @b8
        jmp @b9 %3

    @b9 %20:bv64
        @inv ule %20 1
        ret %20
}

# 4. Hàm ứng dụng Soạn thảo chính. State:
#    - Sector 0 (qword 0..63): văn bản (< 460 byte, kết thúc bằng 0)
#    - Sector 1: slot 58 = duyệt file (0 = soạn thảo, > 0 = id thư mục + 1), 59 = id file đang mở, 60 = yêu cầu đang chờ
#    - Sector 2: tên file mới (CREATE)     Sector 16..: vùng đọc file (READ)
#    - Qword LFS_TAB_Q..: bản sao bảng LightFS do Kernel chép sau mỗi yêu cầu
func app_editor_main void %0:ptr<VgaCell,1382400> %1:ptr<IpcChannel,1> %2:ptr<DiskQword,3932160> %3:ptr<DiskQword,64> %4:ptr<DiskQword,64> %5:smp {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x10000000000
    @req uge %3 0x10000
    @req ult %3 0x80000000
    @req uge %4 0x10000
    @req ult %4 0x80000000

    @b0
        %500 = call ipc_mouse_get_x %1
        %6 = call ipc_mouse_get_y %1
        %7 = call ipc_mouse_get_click %1

        %8 = const 200 bv64
        %9 = const 60 bv64
        %10 = const 880 bv64
        %11 = const 540 bv64
        %12 = const 0 bv64
        %13 = const 1 bv64
        %200 = const 58 bv64                # slot 58: duyệt file
        %201 = const 59 bv64                # slot 59: id file đang mở
        %202 = const 60 bv64                # slot 60: yêu cầu LightFS đang chờ
        %210 = const 64 bv64
        %211 = slice %2 %210 ptr<DiskQword,64>
        %212 = slice %2 %12 ptr<DiskQword,64>   # văn bản
        %213 = const LFS_TAB_Q bv64
        %214 = slice %2 %213 ptr<DiskQword,4096>
        %215 = const 128 bv64
        %216 = slice %2 %215 ptr<DiskQword,8>   # tên file mới (sector 2)
        %217 = const 2 bv64
        %218 = const 3 bv64
        %219 = const 4 bv64
        %220 = const 16 bv64

        %14 = load %1 112 bv64
        %15 = cmp eq %14 %12
        br %15 @b35 @b100

    @b100
        # Kernel vừa phục vụ yêu cầu: xử lý kết quả, KHÔNG xử lý lại phím/chuột của lượt này
        %230 = call cap_state_get %211 %202
        %231 = cmp eq %230 %12
        br %231 @b1 @b101

    @b101
        call cap_state_set %211 %202 %12
        %232 = call lfs_result %1
        %233 = call lfs_is_err %232
        %234 = cmp ne %233 %12
        br %234 @b36 @b102

    @b102
        %235 = cmp eq %230 %217
        br %235 @b103 @b105

    @b103
        # READ xong: chép tối đa 456 byte đầu (57 qword) từ sector 16 vào văn bản, phần còn lại = 0
        %236 = const 1024 bv64
        %237 = slice %2 %236 ptr<DiskQword,64>
        jmp @b104 %12

    @b104 %238:bv64
        @inv ule %238 64
        %239 = const 64 bv64
        %240 = cmp ult %238 %239
        br %240 @b1041 @b36

    @b1041
        %241 = const 57 bv64
        %242 = cmp ult %238 %241
        %243 = call cap_state_get %237 %238
        %244 = slice %212 %238 ptr<DiskQword,1>
        br %242 @b1042 @b1043

    @b1042
        store %244 0 %243
        jmp @b1044

    @b1043
        store %244 0 %12
        jmp @b1044

    @b1044
        %245 = add %238 %13
        jmp @b104 %245

    @b105
        %246 = cmp eq %230 %219
        br %246 @b106 @b36

    @b106
        # CREATE xong: ghi văn bản vào file mới
        call cap_state_set %211 %201 %232
        jmp @b84

    @b1
        %16 = cmp ne %7 %12
        br %16 @b2 @b30

    @b2
        %17 = call ui_win_poll_close %1 %8 %9 %10
        %18 = cmp ne %17 %12
        br %18 @b21 @b3

    @b21
        # Đóng qua interface chuẩn: Shell sẽ tự reset State %2 về 0!
        ret

    @b3
        %20 = const 96 bv64
        %21 = const 28 bv64

        %22 = const 240 bv64
        %23 = const 80 bv64
        %24 = call ui_btn_hit %500 %6 %7 %22 %20 %23 %21
        %25 = cmp ne %24 %12
        br %25 @b4 @b5

    @b4
        # Nút [NEW]: xóa văn bản, đóng file đang mở
        call std_mem_zero %212
        call std_mem_zero %211
        jmp @b36

    @b5
        %27 = const 340 bv64
        %28 = const 110 bv64
        %29 = call ui_btn_hit %500 %6 %7 %27 %20 %28 %21
        %30 = cmp ne %29 %12
        br %30 @b6 @b7

    @b6
        # Nút [BROWSE]: duyệt từ thư mục gốc, xin bảng file mới nhất
        call cap_state_set %211 %200 %13
        call cap_state_set %211 %202 %13
        call lfs_request %1 %13 %12 %12 %12
        ret

    @b7
        %32 = const 470 bv64
        %33 = call ui_btn_hit %500 %6 %7 %32 %20 %23 %21
        %34 = cmp ne %33 %12
        br %34 @b8 @b10

    @b8
        %35 = call cap_state_get %211 %201
        %38 = cmp ne %35 %12
        br %38 @b84 @b85

    @b84
        # [SAVE] file đang mở: WRITE toàn bộ văn bản (sector 0)
        %39 = call cap_state_get %211 %201
        %40 = call std_str_len %212
        call cap_state_set %211 %202 %218
        call lfs_request %1 %218 %39 %12 %40
        ret

    @b85
        # [SAVE] chưa có file: tạo data/noteN.txt (hoặc ở gốc nếu không có data/)
        %250 = const 0x61746164 bv64        # "data"
        call cap_state_set %211 %220 %250
        %251 = const 17 bv64
        call cap_state_set %211 %251 %12
        %252 = const 18 bv64
        call cap_state_set %211 %252 %12
        %253 = const 19 bv64
        call cap_state_set %211 %253 %12
        %254 = const 20 bv64
        call cap_state_set %211 %254 %12
        %255 = const 21 bv64
        call cap_state_set %211 %255 %12
        %256 = const 22 bv64
        call cap_state_set %211 %256 %12
        %257 = const 23 bv64
        call cap_state_set %211 %257 %12
        %258 = slice %211 %220 ptr<DiskQword,8>
        %259 = call lfs_find_child %214 %12 %258
        %260 = call lfs_is_dir %214 %259
        %261 = cmp ne %260 %12
        br %261 @b86 @b87

    @b86
        jmp @b88 %259

    @b87
        jmp @b88 %12

    @b88 %262:bv64
        @inv ult %262 256
        %263 = call editor_pick_name %214 %262 %216
        %264 = cmp ne %263 %12
        br %264 @b89 @b99

    @b89
        call cap_state_set %211 %202 %219
        call lfs_request %1 %219 %262 %217 %12
        ret

    @b10
        %41 = call cap_state_get %211 %200
        %42 = cmp ugt %41 %12
        br %42 @b11 @b99

    @b11
        %43 = sub %41 %13
        %44 = const 255 bv64
        %45 = call std_min %43 %44
        %50 = const 230 bv64
        %51 = const 140 bv64
        %52 = call ui_fb_handle_click %214 %500 %6 %7 %50 %51 %45

        %53 = const 32 bv64
        %54 = lshr %52 %53
        %55 = const 0xff bv64
        %105 = and %52 %55
        %106 = cmp eq %54 %13
        %107 = cmp eq %54 %217
        %108 = or %106 %107
        br %108 @b121 @b12

    @b121
        # BACK hoặc thư mục: đổi thư mục đang duyệt
        %109 = add %105 %13
        call cap_state_set %211 %200 %109
        jmp @b36

    @b12
        %110 = cmp eq %54 %218
        br %110 @b122 @b99

    @b122
        # Click file: mở bằng READ vào sector 16
        call cap_state_set %211 %200 %12
        call cap_state_set %211 %201 %105
        call cap_state_set %211 %202 %217
        call lfs_request %1 %217 %105 %220 %12
        ret

    @b30
        %56 = call cap_state_get %211 %200
        %58 = cmp ugt %56 %12
        br %58 @b99 @b31

    @b31
        %61 = call ipc_key_pop %1
        %59 = const 0 bv8
        %60 = cmp ne %61 %59
        br %60 @b32 @b99

    @b32
        %62 = const 27 bv8
        %63 = cmp eq %61 %62
        br %63 @b321 @b33

    @b321
        call ui_win_close_app %1
        ret

    @b33
        # Kẹp chiều dài văn bản < 460 bytes
        %203 = call std_str_len %212
        %204 = const 460 bv64
        %205 = cmp ult %203 %204
        %206 = const 8 bv8
        %207 = cmp eq %61 %206
        %208 = or %205 %207
        br %208 @b331 @b99

    @b331
        call std_str_push_or_bs %212 %61
        %64 = const 14 bv64
        %65 = const 82 bv64
        %66 = const 862 bv64
        %67 = const 502 bv64
        %68 = const 0xffffff bv32
        call canvas_fill_rect %0 %64 %65 %66 %67 %68
        call editor_render_text %0 %3 %212
        call canvas_invalidate_rect %1 %64 %65 %66 %67
        ret

    @b35
        store %1 112 %13
        %73 = const 0x2020524f54494445 bv64
        %74 = const 0xffffff bv32
        call ui_win_open %0 %3 %1 %8 %9 %10 %11 %73 %74
        %75 = const 1086 bv64
        %76 = const 606 bv64
        call ui_invalidate_rect %1 %8 %9 %75 %76
        # Xin bảng file ngay khi mở cửa sổ (cần cho SAVE / BROWSE)
        call cap_state_set %211 %202 %13
        call lfs_request %1 %13 %12 %12 %12
        jmp @b36

    @b36
        %77 = call cap_state_get %211 %200
        %79 = cmp ugt %77 %12

        %80 = const 96 bv64
        %81 = const 28 bv64
        %82 = const 0x2563eb bv32
        %83 = const 0x334155 bv32
        %84 = const 0xffffff bv32
        %85 = const 3 bv64
        %86 = const 6 bv64
        %87 = const 4 bv64

        %88 = const 240 bv64
        %89 = const 80 bv64
        %90 = const 0x57454e bv64
        call ui_btn_draw_text %0 %3 %88 %80 %89 %81 %83 %84 %90 %85 %12

        %91 = const 340 bv64
        %92 = const 110 bv64
        %93 = const 0x4553574f5242 bv64
        br %79 @b361 @b362

    @b361
        call ui_btn_draw_text %0 %3 %91 %80 %92 %81 %82 %84 %93 %86 %12
        jmp @b37

    @b362
        call ui_btn_draw_text %0 %3 %91 %80 %92 %81 %83 %84 %93 %86 %12
        jmp @b37

    @b37
        %94 = const 470 bv64
        %95 = const 0x45564153 bv64
        call ui_btn_draw_text %0 %3 %94 %80 %89 %81 %83 %84 %95 %87 %12

        # Tên file đang mở bên phải nút SAVE
        %270 = const 570 bv64
        %271 = const 280 bv64
        %272 = const 900 bv64
        %273 = const 124 bv64
        %274 = const 0x0f172a bv32
        call gfx_fill_rect %0 %270 %80 %272 %273 %274
        %275 = call cap_state_get %211 %201
        %276 = const 256 bv64
        %277 = cmp ult %275 %276
        %278 = cmp ne %275 %12
        %279 = and %277 %278
        br %279 @b371 @b372

    @b371
        %280 = const 255 bv64
        %281 = call std_min %275 %280
        %282 = const 584 bv64
        %283 = const 102 bv64
        %284 = const 0x94a3b8 bv32
        call ui_fb_draw_name %0 %3 %214 %281 %282 %283 %284
        jmp @b372

    @b372
        %96 = const 0 bv64
        %97 = const 876 bv64
        %98 = const 70 bv64
        %99 = const 536 bv64
        %103 = const 34 bv64
        br %79 @b40 @b50

    @b40
        %100 = const 0x0f172a bv32
        call canvas_fill_rect %0 %96 %98 %97 %99 %100
        %101 = const 230 bv64
        %102 = const 140 bv64
        %290 = sub %77 %13
        %111 = const 255 bv64
        %116 = call std_min %290 %111
        call ui_fb_render %0 %3 %214 %101 %102 %116
        call canvas_invalidate_rect %1 %96 %103 %97 %99
        ret

    @b50
        call canvas_fill_rect %0 %96 %98 %97 %99 %84
        call editor_render_text %0 %3 %212
        call canvas_invalidate_rect %1 %96 %103 %97 %99
        ret

    @b99
        ret
}
