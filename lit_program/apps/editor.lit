}

# 2. Hàm bắt buộc của mọi App: Tự vẽ Icon 52x52 của App lên Thanh Dock
func app_draw_icon void %0:ptr<VgaCell,921600> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
