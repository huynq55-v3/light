# File: lit_program/apps/terminal.lit
# App: RETRO TERMINAL CLI SHELL (Lô 64GB riêng) - Hỗ trợ VFS Drill-Down & Thanh Cuộn (Scrollbar)

include ../lib/ui_window.lit
include ../lib/std_lib.lit
include ../lib/ipc_bus.lit
include ../lib/ui_canvas.lit
include ../lib/cap_mem.lit
include ../lib/vfs_api.lit
include ../lib/ui_file_browser.lit
include ../lib/ui_text_view.lit

# Định danh Hằng số & Offset có tên (Named Constants)
def COL_RETRO_BG 0x090d16
def COL_RETRO_FG 0x4ade80
def COL_SB_TRACK 0x0f172a
def COL_SB_BTN 0x1e293b
def COL_SB_DIM 0x1e3a2f
def IPC_WIN_DRAWN 112
def IPC_BG_MASK 152
def IPC_MEM_REQ 168
def IPC_MEM_FREE 176
def STATE_SCROLL 58
def STATE_INIT 59
def STATE_CWD 60
def TERM_VIS_LINES 17
def TERM_MAX_Y 516

# 1. Icon 52x52 Terminal Retro trên Thanh Dock
func app_draw_icon void %0:ptr<VgaCell,921600> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ule %1 1200
    @req ule %2 650

    @b0
        %3 = const 52 bv64
        %4 = add %1 %3
        %5 = add %2 %3
        %6 = const COL_RETRO_BG bv32
        call gfx_fill_rect %0 %1 %2 %4 %5 %6

        %7 = const 2 bv64
        %8 = add %1 %7
        %9 = add %2 %7
        %10 = const 50 bv64
        %11 = add %1 %10
        %12 = add %2 %10
        %13 = const COL_RETRO_FG bv32
        call gfx_fill_rect %0 %8 %9 %11 %12 %13

        %14 = const 4 bv64
        %15 = add %1 %14
        %16 = add %2 %14
        %17 = const 48 bv64
        %18 = add %1 %17
        %19 = add %2 %17
        call gfx_fill_rect %0 %15 %16 %18 %19 %6

        %20 = const 12 bv64
        %21 = const 20 bv64
        %22 = add %1 %20
        %23 = add %2 %21
        %24 = const 22 bv64
        %25 = add %1 %24
        %26 = const 24 bv64
        %27 = add %2 %26
        call gfx_fill_rect %0 %22 %23 %25 %27 %13

        %28 = const 26 bv64
        %29 = const 32 bv64
        %30 = add %1 %28
        %31 = add %2 %29
        %32 = const 40 bv64
        %33 = add %1 %32
        %34 = const 34 bv64
        %35 = add %2 %34
        call gfx_fill_rect %0 %30 %31 %33 %35 %13
        ret
}


# 3. Khởi tạo Banner khởi động bằng Qword String Literal ("...")
func term_init_banner void %0:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000

    @b0
        %1 = const 0 bv64
        %2 = const "LIGHT OS" bv64
        call cap_state_set %0 %1 %2

        %3 = const 1 bv64
        %4 = const " CLI v1." bv64
        call cap_state_set %0 %3 %4

        %5 = const 2 bv64
        %6 = const "0\nTYPE \"" bv64
        call cap_state_set %0 %5 %6

        %7 = const 3 bv64
        %8 = const "HELP\" FO" bv64
        call cap_state_set %0 %7 %8

        %9 = const 4 bv64
        %10 = const "R CMDS.\n" bv64
        call cap_state_set %0 %9 %10

        %11 = const 5 bv64
        %12 = const "light>" bv64
        call cap_state_set %0 %11 %12
        ret
}

# 4. Cuộn vùng Screen Buffer (chỉ dịch trong phạm vi 0..399, bảo toàn tuyệt đối Qwords 50..63)
func term_shift_screen_up void %0:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000

    @b0
        %1 = const 0 bv64
        jmp @b1 %1

    @b1 %2:bv64
        @inv ule %2 79
        %3 = const 79 bv64
        %4 = cmp ult %2 %3
        br %4 @b2 @b3

    @b2
        %5 = call std_mem_get_byte %0 %2
        %6 = const 10 bv64                  # '\n'
        %7 = cmp eq %5 %6
        br %7 @b21 @b22

    @b21
        %8 = const 1 bv64
        %9 = add %2 %8
        jmp @b4 %9

    @b22
        %10 = const 1 bv64
        %11 = add %2 %10
        jmp @b1 %11

    @b3
        %12 = const 40 bv64
        jmp @b4 %12

    @b4 %13:bv64
        @inv uge %13 1
        @inv ule %13 80
        %14 = const 400 bv64
        %15 = sub %14 %13                   # limit = 400 - shift (320..399)
        %16 = const 0 bv64
        jmp @b5 %16

    @b5 %17:bv64
        @inv ule %17 399
        %18 = cmp ult %17 %15
        br %18 @b6 @b7

    @b6
        %19 = add %17 %13                   # src = i + shift (< 400)
        %20 = call std_mem_get_byte %0 %19
        call std_mem_set_byte %0 %17 %20
        %21 = const 1 bv64
        %22 = add %17 %21
        jmp @b5 %22

    @b7
        jmp @b8 %15

    @b8 %23:bv64
        @inv ule %23 400
        %24 = cmp ult %23 %14
        br %24 @b9 @b10

    @b9
        %25 = const 0 bv64
        call std_mem_set_byte %0 %23 %25
        %26 = const 1 bv64
        %27 = add %23 %26
        jmp @b8 %27

    @b10
        ret
}

# 5. Đếm tổng số dòng trong Screen Buffer (0..399) để tính phạm vi thanh cuộn
func term_count_lines bv64 %0:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @ens uge %99 1
    @ens ule %99 401

    @b0
        %1 = const 0 bv64
        %2 = const 1 bv64
        jmp @b1 %1 %2

    @b1 %3:bv64 %4:bv64
        @inv ule %3 400
        @inv uge %4 1
        @inv ule %4 401
        %5 = const 400 bv64
        %6 = cmp ult %3 %5
        br %6 @b2 @b6

    @b2
        %7 = call std_mem_get_byte %0 %3
        %8 = const 0 bv64
        %9 = cmp eq %7 %8
        br %9 @b6 @b3

    @b3
        %10 = const 10 bv64                 # '\n'
        %11 = cmp eq %7 %10
        br %11 @b4 @b5

    @b4
        %12 = const 1 bv64
        %13 = const 401 bv64
        %14 = call std_sat_add %4 %12 %13
        jmp @b51 %14

    @b5
        jmp @b51 %4

    @b51 %15:bv64
        @inv uge %15 1
        @inv ule %15 401
        %16 = const 1 bv64
        %17 = add %3 %16
        jmp @b1 %17 %15

    @b6
        %99 = add %4 %1
        ret %99
}

# 6. Tự động đồng bộ vị trí cuộn (State[61]) xuống dòng cuối cùng khi có dữ liệu mới
func term_sync_scroll_bottom void %0:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000

    @b0
        %1 = call term_count_lines %0
        %2 = const TERM_VIS_LINES bv64
        %3 = call std_sat_sub %1 %2
        %4 = const STATE_SCROLL bv64
        call cap_state_set %0 %4 %3
        ret
}

# 7. Tìm byte offset bắt đầu của dòng thứ %1 (scroll_line) trong Screen Buffer (0..399)
func term_find_line_offset bv64 %0:ptr<DiskQword,64> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @ens ule %99 400

    @b0
        %2 = const 0 bv64
        %3 = cmp eq %1 %2
        br %3 @b11 @b10

    @b11
        jmp @b9 %2

    @b10
        jmp @b1 %2 %2

    @b1 %4:bv64 %5:bv64
        # %4: byte_idx (0..400), %5: lines_seen (0..400)
        @inv ule %4 400
        @inv ule %5 400
        %6 = const 400 bv64
        %7 = cmp ult %4 %6
        br %7 @b2 @b7

    @b2
        %8 = call std_mem_get_byte %0 %4
        %9 = const 0 bv64
        %10 = cmp eq %8 %9
        br %10 @b7 @b3

    @b3
        %11 = const 10 bv64                 # '\n'
        %12 = cmp eq %8 %11
        br %12 @b4 @b5

    @b4
        %13 = const 1 bv64
        %14 = const 400 bv64
        %15 = call std_sat_add %5 %13 %14
        %16 = add %4 %13
        %17 = cmp uge %15 %1
        br %17 @b8 @b81

    @b8
        jmp @b9 %16

    @b81
        jmp @b1 %16 %15

    @b5
        %19 = const 1 bv64
        %20 = add %4 %19
        jmp @b1 %20 %5

    @b7
        jmp @b9 %4

    @b9 %99:bv64
        @inv ule %99 400
        ret %99
}

# 8. Thêm 1 ký tự vào cuối Screen Buffer (0..399) và tự động cuộn xuống đáy
func term_append_char void %0:ptr<DiskQword,64> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req ult %1 256

    @b0
        %2 = call std_str_len %0
        %3 = const 390 bv64
        %4 = cmp uge %2 %3
        br %4 @b1 @b2

    @b1
        call term_shift_screen_up %0
        %6 = call std_str_len %0
        %7 = const 390 bv64
        %8 = call std_min %6 %7
        jmp @b3 %8

    @b2
        jmp @b3 %2

    @b3 %9:bv64
        @inv ult %9 398
        call std_mem_set_byte %0 %9 %1
        %10 = const 1 bv64
        %11 = add %9 %10
        %12 = const 0 bv64
        call std_mem_set_byte %0 %11 %12
        call term_sync_scroll_bottom %0
        ret
}

# 9. In tối đa 8 ký tự ASCII từ 1 hằng số Qword (Little-Endian) vào Screen Buffer
func term_append_qword void %0:ptr<DiskQword,64> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000

    @b0
        %2 = const 0 bv64
        jmp @b1 %2 %1

    @b1 %3:bv64 %4:bv64
        @inv ule %3 8
        %5 = const 8 bv64
        %6 = cmp ult %3 %5
        br %6 @b2 @b4

    @b2
        %7 = const 0xff bv64
        %8 = and %4 %7
        %9 = const 0 bv64
        %10 = cmp eq %8 %9
        br %10 @b4 @b3

    @b3
        call term_append_char %0 %8
        %11 = const 8 bv64
        %12 = lshr %4 %11
        %13 = const 1 bv64
        %14 = add %3 %13
        jmp @b1 %14 %12

    @b4
        ret
}

# 10. In chuỗi tên file/thư mục từ Path String Pool (%1) từ start_idx (%2) đến end_idx (%3)
func term_print_pool_str void %0:ptr<DiskQword,64> %1:ptr<DiskQword,64> %2:bv64 %3:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req ule %2 384
    @req ule %3 385
    @req ule %2 %3

    @b0
        jmp @b1 %2

    @b1 %4:bv64
        @inv uge %4 %2
        @inv ule %4 385
        %5 = cmp ult %4 %3
        br %5 @b2 @b3

    @b2
        %6 = const 511 bv64
        %7 = call std_min %4 %6
        %8 = call std_mem_get_byte %1 %7
        call term_append_char %0 %8
        %9 = const 1 bv64
        %10 = add %4 %9
        jmp @b1 %10

    @b3
        ret
}

# 11. In dấu nhắc \nlight> hoặc \nlight:folder> kèm CWD từ State[63]
func term_append_prompt void %0:ptr<DiskQword,64> %1:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req uge %1 0x10000
    @req ult %1 0x80000000

    @b0
        %2 = const "\nlight" bv64
        call term_append_qword %0 %2

        # Đọc CWD từ State[STATE_CWD]
        %8 = const STATE_CWD bv64
        %9 = call cap_state_get %0 %8
        %10 = const 0x7f bv64
        %11 = and %9 %10                    # pref_len (0..127)
        %12 = const 0 bv64
        %13 = cmp eq %11 %12
        br %13 @b2 @b1

    @b1
        %14 = const 58 bv64                 # ':'
        call term_append_char %0 %14
        %15 = const 8 bv64
        %16 = lshr %9 %15
        %17 = const 0xff bv64
        %18 = and %16 %17                   # pref_off (0..255)
        %19 = add %18 %11                   # pref_end (<= 384)
        %20 = const 384 bv64
        %21 = call std_min %18 %20
        %22 = const 385 bv64
        %23 = call std_min %19 %22
        %24 = call std_min %21 %23
        call term_print_pool_str %0 %1 %24 %23
        jmp @b2

    @b2
        %25 = const 62 bv64                 # '>'
        call term_append_char %0 %25
        ret
}

# 12. In số nguyên u64 (dạng thập phân) vào Screen Buffer
func term_append_dec void %0:ptr<DiskQword,64> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000

    @b0
        %2 = const 0 bv64
        %3 = cmp eq %1 %2
        br %3 @b1 @b2

    @b1
        %4 = const 48 bv64
        call term_append_char %0 %4
        ret

    @b2
        %5 = const 1000000000000000000 bv64
        jmp @b3 %1 %5 %2

    @b3 %6:bv64 %7:bv64 %8:bv64
        @inv ule %8 1
        %9 = const 0 bv64
        %10 = cmp ugt %7 %9
        br %10 @b4 @b6

    @b4
        %11 = udiv %6 %7
        %12 = cmp ugt %11 %9
        %13 = or %12 %8
        br %13 @b5 @b51

    @b5
        %14 = const 9 bv64
        %15 = call std_min %11 %14
        %16 = const 48 bv64
        %17 = add %15 %16
        call term_append_char %0 %17
        %18 = const 1 bv64
        jmp @b52 %18

    @b51
        jmp @b52 %8

    @b52 %19:bv64
        @inv ule %19 1
        %20 = urem %6 %7
        %21 = const 10 bv64
        %22 = udiv %7 %21
        jmp @b3 %20 %22 %19

    @b6
        ret
}

# 13. Thực thi lệnh 'ls': Duyệt danh sách tệp/thư mục ảo theo CWD
func term_cmd_ls void %0:ptr<DiskQword,64> %1:ptr<DiskQword,64> %2:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000

    @b0
        %3 = const STATE_CWD bv64
        %4 = call cap_state_get %0 %3
        %5 = const 0x7f bv64
        %6 = and %4 %5                      # pref_len (0..127)
        %7 = const 8 bv64
        %8 = lshr %4 %7
        %9 = const 0xff bv64
        %10 = and %8 %9                     # pref_off (0..255)

        %11 = const 0 bv64
        jmp @b1 %11 %11

    @b1 %12:bv64 %13:bv64
        @inv ule %12 16
        %14 = const 16 bv64
        %15 = cmp ult %12 %14
        br %15 @b2 @b99

    @b2
        %16 = call vfs_entry_get_path_off %2 %12
        %17 = call vfs_entry_get_path_len %2 %12
        %18 = const 0 bv64
        %19 = cmp eq %17 %18
        br %19 @b10 @b3

    @b3
        %20 = call ui_fb_match_prefix %1 %16 %17 %10 %6
        %21 = cmp ne %20 %18
        br %21 @b4 @b10

    @b4
        %22 = add %16 %6                    # seg_start (<= 384)
        %23 = add %16 %17                   # path_end (<= 384)
        %24 = call std_min %22 %23
        %25 = call ui_fb_find_seg_end %1 %24 %23
        %26 = sub %25 %24                   # seg_len

        %27 = call std_mem_get_byte %1 %24
        %28 = const 16 bv64
        %29 = shl %27 %28
        %30 = or %29 %26
        %31 = cmp eq %30 %13
        br %31 @b10 @b5

    @b5
        %32 = const "\n  " bv64
        call term_append_qword %0 %32
        call term_print_pool_str %0 %1 %24 %25

        %34 = const 1 bv64
        %35 = sub %25 %34
        %36 = const 511 bv64
        %37 = call std_min %35 %36
        %38 = call std_mem_get_byte %1 %37
        %39 = const 47 bv64                 # '/'
        %40 = cmp eq %38 %39
        br %40 @b6 @b7

    @b6
        %41 = const "  <DIR>" bv64
        call term_append_qword %0 %41
        jmp @b8

    @b7
        %42 = const "  " bv64
        call term_append_qword %0 %42
        %46 = const 2 bv64
        %47 = shl %12 %46
        %48 = const 3 bv64
        %49 = add %47 %48
        %50 = slice %2 %49 ptr<DiskQword,1>
        %51 = load %50 0 bv64
        %52 = const 0xffffffff bv64
        %53 = and %51 %52
        call term_append_dec %0 %53
        %54 = const 66 bv64                 # 'B'
        call term_append_char %0 %54
        jmp @b8

    @b8
        %55 = const 1 bv64
        %56 = add %12 %55
        jmp @b1 %56 %30

    @b10
        %57 = const 1 bv64
        %58 = add %12 %57
        jmp @b1 %58 %13

    @b99
        ret
}

# 14. So khớp chuỗi đối số từ Command Line (%0) với tên thư mục trong String Pool (%2)
func term_str_match_seg bv64 %0:ptr<DiskQword,64> %1:bv64 %2:ptr<DiskQword,64> %3:bv64 %4:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req ule %1 511
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req ule %3 384
    @req ule %4 64
    @ens ule %48 1

    @b0
        %5 = const 0 bv64
        jmp @b1 %5

    @b1 %6:bv64
        @inv ule %6 64
        %7 = cmp ult %6 %4
        br %7 @b2 @b5

    @b2
        %8 = add %1 %6
        %9 = const 511 bv64
        %10 = call std_min %8 %9
        %11 = call std_mem_get_byte %0 %10
        %12 = add %3 %6
        %13 = call std_min %12 %9
        %14 = call std_mem_get_byte %2 %13

        %22 = call std_char_to_lower %11
        %28 = call std_char_to_lower %14
        %29 = cmp eq %22 %28
        br %29 @b3 @b4

    @b3
        %30 = const 1 bv64
        %31 = add %6 %30
        jmp @b1 %31

    @b4
        %32 = const 0 bv64
        jmp @b100 %32

    @b5
        %33 = add %1 %4
        %34 = const 511 bv64
        %35 = call std_min %33 %34
        %36 = call std_mem_get_byte %0 %35

        %37 = const 0 bv64
        %38 = cmp eq %36 %37
        %39 = const 32 bv64
        %40 = cmp eq %36 %39
        %41 = or %38 %40
        %42 = const 10 bv64
        %43 = cmp eq %36 %42
        %44 = or %41 %43
        %45 = const 47 bv64
        %46 = cmp eq %36 %45
        %47 = or %44 %46
        br %47 @b6 @b4

    @b6
        %470 = const 1 bv64
        jmp @b100 %470

    @b100 %48:bv64
        @inv ule %48 1
        ret %48
}

# 15. Thực thi lệnh 'cd': Điều hướng cây thư mục ảo trong VFS
func term_cmd_cd void %0:ptr<DiskQword,64> %1:ptr<DiskQword,64> %2:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000

    @b0
        %3 = const 402 bv64
        %4 = call std_str_skip_spaces %0 %3
        %5 = call std_mem_get_byte %0 %4

        %6 = const 0 bv64
        %7 = cmp eq %5 %6
        %8 = const 10 bv64
        %9 = cmp eq %5 %8
        %10 = or %7 %9
        %11 = const 47 bv64                 # '/'
        %12 = cmp eq %5 %11
        %13 = or %10 %12
        br %13 @b1 @b2

    @b1
        %14 = const STATE_CWD bv64
        call cap_state_set %0 %14 %6
        ret

    @b2
        %15 = const 46 bv64                 # '.'
        %16 = cmp eq %5 %15
        br %16 @b21 @b3

    @b21
        %17 = const 1 bv64
        %18 = add %4 %17
        %19 = const 511 bv64
        %20 = call std_min %18 %19
        %21 = call std_mem_get_byte %0 %20
        %22 = cmp eq %21 %15
        br %22 @b22 @b3

    @b22
        %23 = const STATE_CWD bv64
        %24 = call cap_state_get %0 %23
        %25 = const 0x7f bv64
        %26 = and %24 %25                   # pref_len
        %27 = const 8 bv64
        %28 = lshr %24 %27
        %29 = const 0xff bv64
        %30 = and %28 %29                   # pref_off
        %31 = call ui_fb_parent_pref_len %1 %30 %26
        %32 = shl %30 %27
        %33 = or %32 %31
        call cap_state_set %0 %23 %33
        ret

    @b3
        %40 = const STATE_CWD bv64
        %41 = call cap_state_get %0 %40
        %42 = const 0x7f bv64
        %43 = and %41 %42                   # pref_len
        %44 = const 8 bv64
        %45 = lshr %41 %44
        %46 = const 0xff bv64
        %47 = and %45 %46                   # pref_off

        %48 = const 0 bv64
        jmp @b4 %48

    @b4 %49:bv64
        @inv ule %49 16
        %50 = const 16 bv64
        %51 = cmp ult %49 %50
        br %51 @b5 @b8

    @b5
        %52 = call vfs_entry_get_path_off %2 %49
        %53 = call vfs_entry_get_path_len %2 %49
        %54 = const 0 bv64
        %55 = cmp eq %53 %54
        br %55 @b7 @b51

    @b51
        %56 = call ui_fb_match_prefix %1 %52 %53 %47 %43
        %57 = cmp ne %56 %54
        br %57 @b52 @b7

    @b52
        %58 = add %52 %43                   # seg_start
        %59 = add %52 %53                   # path_end
        %60 = call std_min %58 %59
        %61 = call ui_fb_find_seg_end %1 %60 %59
        %62 = const 1 bv64
        %63 = sub %61 %62
        %64 = const 511 bv64
        %65 = call std_min %63 %64
        %66 = call std_mem_get_byte %1 %65
        %67 = const 47 bv64                 # '/'
        %68 = cmp eq %66 %67
        %680 = cmp ugt %63 %60
        %681 = and %68 %680
        br %681 @b53 @b7

    @b53
        %69 = sub %63 %60                   # seg_name_len
        %70 = const 64 bv64
        %71 = call std_min %69 %70
        %72 = call term_str_match_seg %0 %4 %1 %60 %71
        %73 = const 0 bv64
        %74 = cmp ne %72 %73
        br %74 @b6 @b7

    @b6
        %75 = sub %61 %52                   # new_pref_len
        %76 = const 8 bv64
        %77 = shl %52 %76
        %78 = or %77 %75
        call cap_state_set %0 %40 %78
        ret

    @b7
        %79 = const 1 bv64
        %80 = add %49 %79
        jmp @b4 %80

    @b8
        %81 = const "\n  NO SU" bv64
        call term_append_qword %0 %81
        %82 = const "CH DIR" bv64
        call term_append_qword %0 %82
        ret
}

# 16. Thực thi lệnh 'clear': Xóa màn hình, đặt lại scroll_line = 0 và đưa prompt lên đầu
func term_cmd_clear void %0:ptr<DiskQword,64> %1:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req uge %1 0x10000
    @req ult %1 0x80000000

    @b0
        %2 = const 0 bv64
        %4 = const 50 bv64
        call cap_mem_zero_range %0 %2 %4
        %10 = const STATE_SCROLL bv64
        call cap_state_set %0 %10 %2
        call term_append_prompt %0 %1
        ret
}

# 17. Thực thi lệnh 'sys': In số CPU worker, AP online, và trạng thái chạy ngầm
func term_cmd_sys void %0:ptr<DiskQword,64> %1:smp %2:ptr<IpcChannel,1> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req uge %2 0x10000
    @req ult %2 0x80000000

    @b0
        %3 = const "\n  WORKE" bv64
        call term_append_qword %0 %3
        %4 = const "RS: " bv64
        call term_append_qword %0 %4
        %12 = smp_workers %1
        call term_append_dec %0 %12

        %18 = const "  BG_MAS" bv64
        call term_append_qword %0 %18
        %19 = const "K: " bv64
        call term_append_qword %0 %19
        %23 = load %2 IPC_BG_MASK bv64
        call term_append_dec %0 %23
        ret
}

# 17b. Lệnh 'mem': kích thước heap hiện có và RAM còn trống của bể (MB)
func term_cmd_mem void %0:ptr<DiskQword,64> %1:ptr<IpcChannel,1> %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req uge %1 0x10000
    @req ult %1 0x80000000

    @b0
        %3 = const "\n  HEAP " bv64
        call term_append_qword %0 %3
        %4 = const "MB: " bv64
        call term_append_qword %0 %4
        %5 = const 17 bv64
        %6 = lshr %2 %5                     # Qword -> MB
        call term_append_dec %0 %6
        %7 = const "  FREE M" bv64
        call term_append_qword %0 %7
        %8 = const "B: " bv64
        call term_append_qword %0 %8
        %9 = load %1 IPC_MEM_FREE bv64
        %10 = const 1 bv64
        %11 = shl %9 %10                    # khung 2MB -> MB
        call term_append_dec %0 %11
        ret
}

# 17c. 'memup' xin thêm 512 chunk (1GB), 'memdown' trả hết về 15 chunk tĩnh. Kernel xử lý ngay sau tick này.
func term_cmd_mem_req void %0:ptr<DiskQword,64> %1:ptr<IpcChannel,1> %2:bv64 %3:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req uge %1 0x10000
    @req ult %1 0x80000000

    @b0
        %4 = const 0 bv64
        %5 = cmp ne %3 %4
        br %5 @b1 @b2

    @b1
        %6 = const 18 bv64
        %7 = lshr %2 %6                     # số chunk hiện có
        %8 = const 16383 bv64
        %9 = call std_min %7 %8
        %10 = const 512 bv64
        %11 = add %9 %10
        %12 = call std_min %11 %8
        jmp @b3 %12

    @b2
        %13 = const 15 bv64
        jmp @b3 %13

    @b3 %14:bv64
        @inv ule %14 16383
        store %1 IPC_MEM_REQ %14
        %15 = const "\n  MEM_R" bv64
        call term_append_qword %0 %15
        %16 = const "EQ: " bv64
        call term_append_qword %0 %16
        %17 = const 1 bv64
        %18 = shl %14 %17
        call term_append_dec %0 %18
        %19 = const " MB" bv64
        call term_append_qword %0 %19
        ret
}

# 17d. 'memtest': ghi rồi đọc lại 1 Qword ở MỖI trang 4KB của toàn bộ heap. Trang nào chưa map thật sẽ gây #PF
# (màn hình panic), nên chạy hết = mọi trang Kernel hứa trong độ dài heap đều có RAM thật.
func term_cmd_memtest void %0:ptr<DiskQword,64> %1:bv64 %2:ptr<DiskQword,%1> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000

    @b0
        %3 = const 9 bv64
        %4 = lshr %1 %3                     # số trang 4KB
        %5 = const 0 bv64
        %6 = const 0x5a5a5a5a00000000 bv64
        jmp @b1 %5

    @b1 %7:bv64
        @inv ule %7 %4
        %8 = cmp ult %7 %4
        br %8 @b2 @b3

    @b2
        %9 = shl %7 %3
        %10 = slice %2 %9 ptr<DiskQword,1>
        %11 = xor %7 %6
        store %10 0 %11
        %12 = const 1 bv64
        %13 = add %7 %12
        jmp @b1 %13

    @b3
        jmp @b4 %5 %5

    @b4 %14:bv64 %15:bv64
        @inv ule %14 %4
        @inv ule %15 %14
        %16 = cmp ult %14 %4
        br %16 @b5 @b6

    @b5
        %17 = shl %14 %3
        %18 = slice %2 %17 ptr<DiskQword,1>
        %19 = load %18 0 bv64
        %20 = xor %14 %6
        %21 = cmp ne %19 %20
        %22 = add %15 %21
        %23 = const 1 bv64
        %24 = add %14 %23
        jmp @b4 %24 %22

    @b6
        %25 = const "\n  PAGES" bv64
        call term_append_qword %0 %25
        %26 = const ": " bv64
        call term_append_qword %0 %26
        call term_append_dec %0 %4
        %27 = const "  ERR: " bv64
        call term_append_qword %0 %27
        call term_append_dec %0 %15
        ret
}

# 18. Thực thi lệnh 'help': Liệt kê các lệnh hỗ trợ
func term_cmd_help void %0:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000

    @b0
        %1 = const "\n  CMDS:" bv64
        call term_append_qword %0 %1
        %2 = const " LS CD S" bv64
        call term_append_qword %0 %2
        %3 = const "YS CLEAR" bv64
        call term_append_qword %0 %3
        %4 = const " HELP ME" bv64
        call term_append_qword %0 %4
        %5 = const "M MEMUP " bv64
        call term_append_qword %0 %5
        %6 = const "MEMDOWN " bv64
        call term_append_qword %0 %6
        %7 = const "MEMTEST" bv64
        call term_append_qword %0 %7
        ret
}

# 19. Dispatcher thông dịch lệnh từ Command Line (Qwords 50..60)
func term_dispatch_cmd void %0:ptr<DiskQword,64> %1:ptr<DiskQword,64> %2:ptr<DiskQword,64> %3:ptr<IpcChannel,1> %4:smp %5:bv64 %6:ptr<DiskQword,%5> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req uge %3 0x10000
    @req ult %3 0x80000000

    @b0
        %16 = const 400 bv64
        %17 = call std_str_skip_spaces %0 %16
        %18 = call std_str_read_cmd_qword %0 %17

        # Kiểm tra dòng lệnh rỗng
        %27 = const 0 bv64
        %28 = cmp eq %18 %27
        br %28 @b20 @b1

    @b1
        # std_str_read_cmd_qword đã tự động hạ chữ hoa xuống chữ thường!
        %19 = const "ls" bv64
        %20 = cmp eq %18 %19
        br %20 @b10 @b11

    @b10
        call term_cmd_ls %0 %1 %2
        jmp @b20

    @b11
        %21 = const "sys" bv64
        %22 = cmp eq %18 %21
        br %22 @b12 @b13

    @b12
        call term_cmd_sys %0 %4 %3
        jmp @b20

    @b13
        %23 = const "clear" bv64
        %24 = cmp eq %18 %23
        br %24 @b14 @b15

    @b14
        call term_cmd_clear %0 %1
        jmp @b21

    @b15
        %25 = const "cd" bv64
        %26 = cmp eq %18 %25
        br %26 @b16 @b17

    @b16
        call term_cmd_cd %0 %1 %2
        jmp @b20

    @b17
        %250 = const "help" bv64
        %260 = cmp eq %18 %250
        br %260 @b171 @b172

    @b171
        call term_cmd_help %0
        jmp @b20

    @b172
        %251 = const "mem" bv64
        %261 = cmp eq %18 %251
        br %261 @b173 @b174

    @b173
        call term_cmd_mem %0 %3 %5
        jmp @b20

    @b174
        %252 = const "memup" bv64
        %262 = cmp eq %18 %252
        br %262 @b175 @b176

    @b175
        %270 = const 1 bv64
        call term_cmd_mem_req %0 %3 %5 %270
        jmp @b20

    @b176
        %253 = const "memdown" bv64
        %263 = cmp eq %18 %253
        br %263 @b177 @b178

    @b177
        %271 = const 0 bv64
        call term_cmd_mem_req %0 %3 %5 %271
        jmp @b20

    @b178
        %254 = const "memtest" bv64
        %264 = cmp eq %18 %254
        br %264 @b179 @b18

    @b179
        call term_cmd_memtest %0 %5 %6
        jmp @b20

    @b18
        %29 = const "\n  UNKNO" bv64
        call term_append_qword %0 %29
        %30 = const "WN" bv64
        call term_append_qword %0 %30
        jmp @b20

    @b20
        call term_append_prompt %0 %1
        jmp @b21

    @b21
        # Xóa sạch Qwords 50..57 về 0 (giữ nguyên State[58..60] = scroll_line, init, cwd)
        %37 = const 50 bv64
        %39 = const 58 bv64
        call cap_mem_zero_range %0 %37 %39
        ret
}

# 20. Xử lý gõ phím vào Command Line (Qwords 50..57, offset 400..463)
func term_cmd_push_or_bs void %0:ptr<DiskQword,64> %1:bv8 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000

    @b0
        %2 = const 8 bv8
        %3 = cmp eq %1 %2
        br %3 @b1 @b2

    @b1
        # Backspace
        %4 = const 0 bv64
        jmp @b10 %4

    @b10 %6:bv64
        @inv ule %6 62
        %7 = const 400 bv64
        %8 = add %7 %6
        %9 = call std_mem_get_byte %0 %8
        %10 = const 0 bv64
        %11 = cmp eq %9 %10
        br %11 @b13 @b11

    @b11
        %12 = const 61 bv64
        %13 = cmp ult %6 %12
        br %13 @b12 @b13

    @b12
        %14 = const 1 bv64
        %15 = add %6 %14
        jmp @b10 %15

    @b13
        %17 = const 0 bv64
        %18 = cmp ugt %6 %17
        br %18 @b14 @b99

    @b14
        %19 = const 1 bv64
        %20 = sub %6 %19
        %21 = const 400 bv64
        %22 = add %21 %20
        call std_mem_set_byte %0 %22 %17

        # Đồng bộ xóa lùi ký tự trên Screen Buffer (0..399)
        %80 = call std_str_len %0
        %81 = cmp ugt %80 %17
        br %81 @b15 @b99

    @b15
        %82 = sub %80 %19
        %83 = const 398 bv64
        %84 = call std_min %82 %83
        call std_mem_set_byte %0 %84 %17
        call term_sync_scroll_bottom %0
        ret

    @b2
        # Push char
        %30 = const 0 bv64
        jmp @b20 %30

    @b20 %31:bv64
        @inv ule %31 61
        %32 = const 400 bv64
        %33 = add %32 %31
        %34 = call std_mem_get_byte %0 %33
        %35 = const 0 bv64
        %36 = cmp eq %34 %35
        br %36 @b23 @b21

    @b21
        %37 = const 60 bv64
        %38 = cmp ult %31 %37
        br %38 @b22 @b99

    @b22
        %39 = const 1 bv64
        %40 = add %31 %39
        jmp @b20 %40

    @b23
        %52 = call std_bv8_to_bv64 %1
        %61 = const 400 bv64
        %62 = add %61 %31
        call std_mem_set_byte %0 %62 %52
        %66 = const 1 bv64
        %67 = add %62 %66
        %68 = const 0 bv64
        call std_mem_set_byte %0 %67 %68

        # Xuất ngay lập tức lên Screen Buffer để hiển thị tức thời
        call term_append_char %0 %52
        ret

    @b99
        ret
}

# 21. Vẽ Thanh Cuộn Dọc (Scrollbar: Nút Lên [▲], Rãnh trượt Track, Con trượt Thumb, Nút Xuống [▼])
func term_draw_scrollbar void %0:ptr<VgaCell,921600> %1:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x10000000000

    @b0
        %2 = const 854 bv64
        %3 = const 872 bv64
        %4 = const COL_SB_BTN bv32
        %5 = const COL_RETRO_FG bv32

        # Nút cuộn Lên [▲] (rel_x = 854..872, rel_y = 38..62)
        %6 = const 38 bv64
        %7 = const 62 bv64
        call canvas_fill_rect %0 %2 %6 %3 %7 %4
        %8 = const 860 bv64
        %9 = const 866 bv64
        %10 = const 47 bv64
        %11 = const 53 bv64
        call canvas_fill_rect %0 %8 %10 %9 %11 %5

        # Nút cuộn Xuống [▼] (rel_x = 854..872, rel_y = 506..530)
        %12 = const 506 bv64
        %13 = const 530 bv64
        call canvas_fill_rect %0 %2 %12 %3 %13 %4
        %14 = const 515 bv64
        %15 = const 521 bv64
        call canvas_fill_rect %0 %8 %14 %9 %15 %5

        # Rãnh trượt Track (rel_x = 854..872, rel_y = 64..504, cao 440px)
        %16 = const 64 bv64
        %17 = const 504 bv64
        %18 = const COL_SB_TRACK bv32
        call canvas_fill_rect %0 %2 %16 %3 %17 %18

        # Tính toán vị trí và kích thước Con trượt (Thumb)
        %19 = call term_count_lines %1
        %20 = const TERM_VIS_LINES bv64
        %21 = call std_sat_sub %19 %20      # max_scroll (0..384)
        %22 = const 0 bv64
        %23 = cmp eq %21 %22
        br %23 @b1 @b2

    @b1
        # Chưa đầy màn hình: Con trượt phủ toàn bộ rãnh màu xanh mờ
        %24 = const 856 bv64
        %25 = const 870 bv64
        %26 = const 66 bv64
        %27 = const 502 bv64
        %28 = const COL_SB_DIM bv32
        call canvas_fill_rect %0 %24 %26 %25 %27 %28
        ret

    @b2
        # Đã đầy màn hình (max_scroll > 0): Tính chiều cao và tọa độ Y của Thumb
        %30 = const 7412 bv64               # 436 * 17
        %31 = udiv %30 %19
        %32 = const 36 bv64
        %33 = const 400 bv64
        %34 = call std_clamp %31 %32 %33    # thumb_h (36..400)
        %35 = const 436 bv64
        %36 = sub %35 %34                   # avail_travel (36..400)

        %37 = const STATE_SCROLL bv64
        %38 = call cap_state_get %1 %37
        %39 = call std_min %38 %21          # cur_scroll <= max_scroll (<= 384)

        %40 = mul %39 %36                   # cur_scroll * avail_travel (<= 384 * 400 = 153600)
        %41 = udiv %40 %21
        %42 = call std_min %41 %36          # thumb_off (0..avail_travel)

        %43 = const 66 bv64
        %44 = add %43 %42                   # thumb_y1 (66..466)
        %45 = add %44 %34                   # thumb_y2 (102..502)
        %46 = const 856 bv64
        %47 = const 870 bv64
        call canvas_fill_rect %0 %46 %44 %47 %45 %5
        ret
}

# 22. Bắt sự kiện Click chuột trên Thanh Cuộn (Nút Lên, Nút Xuống, hoặc Rãnh trượt)
func term_poll_scrollbar bv64 %0:ptr<IpcChannel,1> %1:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x10000000000
    @ens ule %99 1

    @b0
        %2 = call ipc_mouse_get_click %0
        %3 = const 0 bv64
        %4 = cmp eq %2 %3
        br %4 @b9 @b1

    @b1
        %5 = call ipc_mouse_get_x %0
        %6 = call ipc_mouse_get_y %0
        %7 = const 1052 bv64
        %8 = const 1078 bv64
        %9 = call std_in_range %5 %7 %8
        %10 = const 98 bv64
        %11 = const 594 bv64
        %12 = call std_in_range %6 %10 %11
        %13 = and %9 %12
        %14 = cmp ne %13 %3
        br %14 @b2 @b9

    @b2
        call ipc_mouse_clear_click %0
        %15 = call term_count_lines %1
        %16 = const TERM_VIS_LINES bv64
        %17 = call std_sat_sub %15 %16      # max_scroll (0..384)
        %18 = const STATE_SCROLL bv64
        %19 = call cap_state_get %1 %18
        %20 = call std_min %19 %17          # cur_scroll

        # Kiểm tra vùng Click: Nút Lên (< 126), Nút Xuống (>= 566), hay Rãnh Track (126..565)
        %21 = const 126 bv64
        %22 = cmp ult %6 %21
        br %22 @b3 @b4

    @b3
        # Click Nút Lên [▲]: Cuộn lên 2 dòng
        %23 = const 2 bv64
        %24 = call std_sat_sub %20 %23
        jmp @b8 %24

    @b4
        %25 = const 566 bv64
        %26 = cmp uge %6 %25
        br %26 @b5 @b6

    @b5
        # Click Nút Xuống [▼]: Cuộn xuống 2 dòng
        %27 = const 2 bv64
        %28 = call std_sat_add %20 %27 %17
        jmp @b8 %28

    @b6
        # Click trực tiếp trên Rãnh Track (126..565): Nhảy tỷ lệ tới vị trí tương ứng
        %29 = call std_sat_sub %6 %21
        %30 = const 440 bv64
        %31 = call std_min %29 %30          # rel_click (0..440)
        %32 = const 1 bv64
        %33 = add %17 %32                   # max_scroll + 1 (1..385)
        %34 = mul %31 %33
        %35 = udiv %34 %30
        %36 = call std_min %35 %17
        jmp @b8 %36

    @b8 %40:bv64
        call cap_state_set %1 %18 %40
        %41 = const 1 bv64
        jmp @b10 %41

    @b9
        jmp @b10 %3

    @b10 %99:bv64
        @inv ule %99 1
        ret %99
}

# 23. Render Terminal Retro UI lên Backbuffer (Văn bản theo scroll_line + Cursor + Scrollbar)
func term_render_retro_view void %0:ptr<VgaCell,921600> %1:ptr<DiskQword,64> %2:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x10000000000

    @b0
        %3 = call term_count_lines %2
        %4 = const TERM_VIS_LINES bv64
        %5 = call std_sat_sub %3 %4         # max_scroll (0..384)
        %6 = const STATE_SCROLL bv64
        %7 = call cap_state_get %2 %6
        %8 = call std_min %7 %5             # scroll_line (0..max_scroll)
        %9 = call term_find_line_offset %2 %8

        # Chỉ hiển thị con trỏ '_' khi đang ở đáy màn hình (scroll_line >= max_scroll)
        %10 = cmp uge %8 %5
        %11 = const 220 bv64
        %12 = const 100 bv64
        %13 = const 1036 bv64
        %14 = const TERM_MAX_Y bv64
        %15 = const COL_RETRO_FG bv32
        call ui_text_view_render_from %0 %1 %2 %11 %12 %13 %14 %15 %10 %9
        call term_draw_scrollbar %0 %2
        ret
}

# 24. Vòng lặp chính của Shell App (app_terminal_main)
func app_terminal_main void %0:ptr<VgaCell,921600> %1:ptr<IpcChannel,1> %2:ptr<DiskQword,64> %3:ptr<DiskQword,64> %4:ptr<DiskQword,64> %5:smp %900:bv64 %901:ptr<DiskQword,%900> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x10000000000
    @req uge %3 0x10000
    @req ult %3 0x80000000
    @req uge %4 0x10000
    @req ult %4 0x80000000

    @b0
        %6 = const 200 bv64
        %7 = const 60 bv64
        %8 = const 880 bv64
        %9 = const 540 bv64
        %10 = const 0 bv64
        %11 = const 1 bv64
        %12 = const STATE_INIT bv64

        # Kiểm tra cờ khởi tạo State[62]
        %13 = call cap_state_get %2 %12
        %14 = cmp eq %13 %10
        br %14 @b1 @b2

    @b1
        # Lần đầu mở App: Khởi tạo Banner, scroll_line = 0, CWD = 0 và bật State[62] = 1
        call term_init_banner %2
        %119 = const STATE_SCROLL bv64
        call cap_state_set %2 %119 %10
        %120 = const STATE_CWD bv64
        call cap_state_set %2 %120 %10
        call cap_state_set %2 %12 %11
        jmp @b2

    @b2
        %15 = load %1 IPC_WIN_DRAWN bv64
        %16 = cmp eq %15 %10
        br %16 @b3 @b4

    @b3
        # Vẽ toàn bộ cửa sổ lần đầu (Window frame + Title 'TERMINAL' + Client background)
        store %1 IPC_WIN_DRAWN %11
        %17 = const "TERMINAL" bv64
        %18 = const COL_RETRO_BG bv32
        call ui_win_draw %0 %3 %6 %7 %8 %9 %17 %18
        %19 = const 1086 bv64
        %20 = const 606 bv64
        call ui_invalidate_rect %1 %6 %7 %19 %20
        jmp @b7

    @b4
        # Kiểm tra đóng cửa sổ nút [X]
        %21 = call ui_win_poll_close %1 %6 %7 %8
        %22 = cmp ne %21 %10
        br %22 @b8 @b41

    @b41
        # Kiểm tra Click chuột trên Thanh Cuộn (Scrollbar)
        %220 = call term_poll_scrollbar %1 %2
        %221 = cmp ne %220 %10
        br %221 @b7 @b5

    @b5
        # Đọc phím bấm từ IPC
        %23 = call ipc_key_pop %1
        %24 = const 0 bv8
        %25 = cmp ne %23 %24
        br %25 @b6 @b8

    @b6
        # ESC = Đóng App
        %26 = const 27 bv8
        %27 = cmp eq %23 %26
        br %27 @b61 @b62

    @b61
        call ui_win_close_app %1
        ret

    @b62
        # Enter = 10 hoặc 13
        %28 = const 10 bv8
        %29 = cmp eq %23 %28
        %30 = const 13 bv8
        %31 = cmp eq %23 %30
        %32 = or %29 %31
        br %32 @b63 @b64

    @b63
        # Thực thi lệnh từ dòng lệnh
        call term_dispatch_cmd %2 %3 %4 %1 %5 %900 %901
        jmp @b7

    @b64
        # Phím thường hoặc Backspace: Cập nhật dòng lệnh
        call term_cmd_push_or_bs %2 %23
        jmp @b7

    @b7
        # Tô lại nền Client COL_RETRO_BG
        %67 = const 0 bv64
        %68 = const 876 bv64
        %69 = const 34 bv64
        %70 = const 536 bv64
        %71 = const COL_RETRO_BG bv32
        call canvas_fill_rect %0 %67 %69 %68 %70 %71

        # Render Screen Buffer (theo scroll_line) + Cursor + Thanh Cuộn
        call term_render_retro_view %0 %3 %2
        call canvas_invalidate_rect %1 %67 %69 %68 %70
        ret

    @b8
        ret
}
