# 1. Icon 52x52 Terminal Retro trên Thanh Dock
func app_draw_icon void %0:ptr<VgaCell,921600> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ule %1 1200
    @req ule %2 650

    @b0
        %3 = const 52 bv64
        %4 = add %1 %3
        %5 = add %2 %3
        %6 = const 0x090d16 bv32
        call gfx_fill_rect %0 %1 %2 %4 %5 %6

        %7 = const 2 bv64
        %8 = add %1 %7
        %9 = add %2 %7
        %10 = const 50 bv64
        %11 = add %1 %10
        %12 = add %2 %10
        %13 = const 0x4ade80 bv32
        call gfx_fill_rect %0 %8 %9 %11 %12 %13

        %14 = const 4 bv64
        %15 = add %1 %14
        %16 = add %2 %14
        %17 = const 48 bv64
        %18 = add %1 %17
        %19 = add %2 %17
        call gfx_fill_rect %0 %15 %16 %18 %19 %6

        %20 = const 12 bv64
        %21 = const 20 bv64
        %22 = add %1 %20
        %23 = add %2 %21
        %24 = const 22 bv64
        %25 = add %1 %24
        %26 = const 24 bv64
        %27 = add %2 %26
        call gfx_fill_rect %0 %22 %23 %25 %27 %13

        %28 = const 26 bv64
        %29 = const 32 bv64
        %30 = add %1 %28
        %31 = add %2 %29
        %32 = const 40 bv64
        %33 = add %1 %32
        %34 = const 34 bv64
        %35 = add %2 %34
        call gfx_fill_rect %0 %30 %31 %33 %35 %13
        ret
}

# 2. Worker dummy cho SMP scheduler
func app_smp_worker void %0:bv64 %1:bv64 %2:bv64 {
    @b0
        ret
}

