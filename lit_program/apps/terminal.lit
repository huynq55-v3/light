# File: lit_program/apps/terminal.lit
# App TERMINAL: mặt tiền cho người của lõi shell std/shell.lit (cùng bộ lệnh với kênh Agent của Claude).
#
# - Cửa sổ đổi kích thước được (std/widget), chữ xanh trên nền tối, tự xuống dòng, cuộn bằng nút ^ / v bên phải.
# - Bộ đệm cuộn 32KB là stdout của lõi shell (ShState.out_len = độ dài); trước mỗi lệnh, nếu đã dùng quá nửa thì bỏ
#   phần cũ (giữ ~8KB cuối, cắt ở đầu dòng).
# - Lệnh đụng đĩa: lõi lập kế hoạch, Terminal thực hiện bằng yêu cầu IPC LightFS (mỗi yêu cầu = một lượt Kernel gọi lại
#   App): TABLE -> [CREATE | READ] -> [WRITE] -> sh_fs_done. Trong lúc chờ không đọc phím.
# - Lệnh riêng của Terminal (cần IPC / smp / heap, nằm ngoài lõi): clear, sys, mem, memup, memdown, memtest.
#
# State của App (qword):  0 TermSt   16 ShState   64 dòng lệnh (512 byte)   128 bộ đệm cuộn (32KB)   4224 stderr (1KB)
#   sector 68 tên mục sẽ tạo   sector 128.. nội dung file (1MB)   LFS_TAB_Q bảng LightFS (Kernel chép sau mỗi yêu cầu)

include ../lib/ui_window.lit
include ../lib/std_lib.lit
include ../lib/ipc_bus.lit
include ../lib/cap_mem.lit
include ../std/sys.lit
include ../std/widget.lit
include ../std/shell.lit

def COL_RETRO_BG 0x090d16
def COL_RETRO_FG 0x4ade80
def COL_SB_TRACK 0x0f172a
def COL_SB_BTN 0x1e293b
def COL_SB_THUMB 0x1e3a2f
def TERM_TITLE 0x4c414e494d524554        # "TERMINAL"

def T_SH_Q 16
def T_LINE_Q 64
def T_LINE_CAP 512
def T_SB_Q 128
def T_SB_CAP 32768
def T_SB_KEEP 8192
def T_ERR_Q 4224
def T_ERR_CAP 1024
def T_NAME_SEC 68
def T_DATA_SEC 128
def T_DATA_B 1048576

def P_TABLE 1
def P_CAT 2
def P_WNEW 3
def P_WREAD 4
def P_FINAL 5

def T_LINE_H 18
def T_SBW 20

layout TermSt 128 {
    0: bv64 init                            # 1 = đã in lời chào
    8: bv64 phase                           # P_*: đang chờ Kernel phục vụ yêu cầu LightFS (0 = rảnh)
    16: bv64 ow                             # kích thước cửa sổ đã vẽ
    24: bv64 oh
    32: bv64 scroll                         # số dòng đang cuộn lên khỏi đáy
    40: bv64 line_len                       # độ dài dòng lệnh đang gõ
    48: bv64 spare0
    56: bv64 spare1
}

data T_BANNER Byte {
    "Light OS shell. Type help for commands (Terminal also has: clear sys mem memup memdown memtest).\n"
}
data T_P1 Byte {
    "light:"
}
data T_P2 Byte {
    "> "
}
data T_TRUNC Byte {
    "\n[output truncated]\n"
}
data T_C_CLEAR Byte {
    "clear"
}
data T_C_SYS Byte {
    "sys"
}
data T_C_MEM Byte {
    "mem"
}
data T_C_MEMUP Byte {
    "memup"
}
data T_C_MEMDOWN Byte {
    "memdown"
}
data T_C_MEMTEST Byte {
    "memtest"
}
data T_L_WORKERS Byte {
    "smp workers: "
}
data T_L_BG Byte {
    "\nbackground mask: "
}
data T_L_HEAP Byte {
    "heap MB: "
}
data T_L_FREE Byte {
    "\nfree MB: "
}
data T_L_MEMREQ Byte {
    "requested heap MB: "
}
data T_L_PAGES Byte {
    "pages: "
}
data T_L_ERRS Byte {
    "\nerrors: "
}
data T_NL Byte {
    "\n"
}

# 1. Icon 52x52 Terminal Retro trên Thanh Dock
func app_draw_icon void %0:ptr<VgaCell,1382400> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ule %1 1200
    @req ule %2 650

    @b0
        %3 = const 52 bv64
        %4 = add %1 %3
        %5 = add %2 %3
        %6 = const COL_RETRO_BG bv32
        call gfx_fill_rect %0 %1 %2 %4 %5 %6

        %7 = const 2 bv64
        %8 = add %1 %7
        %9 = add %2 %7
        %10 = const 50 bv64
        %11 = add %1 %10
        %12 = add %2 %10
        %13 = const COL_RETRO_FG bv32
        call gfx_fill_rect %0 %8 %9 %11 %12 %13

        %14 = const 4 bv64
        %15 = add %1 %14
        %16 = add %2 %14
        %17 = const 48 bv64
        %18 = add %1 %17
        %19 = add %2 %17
        call gfx_fill_rect %0 %15 %16 %18 %19 %6

        %20 = const 12 bv64
        %21 = const 20 bv64
        %22 = add %1 %20
        %23 = add %2 %21
        %24 = const 22 bv64
        %25 = add %1 %24
        %26 = const 24 bv64
        %27 = add %2 %26
        call gfx_fill_rect %0 %22 %23 %25 %27 %13

        %28 = const 26 bv64
        %29 = const 32 bv64
        %30 = add %1 %28
        %31 = add %2 %29
        %32 = const 40 bv64
        %33 = add %1 %32
        %34 = const 34 bv64
        %35 = add %2 %34
        call gfx_fill_rect %0 %30 %31 %33 %35 %13
        ret
}


# ---------------------------------------------------------------- vùng nhớ trong State

func t_ts ptr<TermSt,1> %st:ptr<DiskQword,3932160> {
    @b0
        %q = slice %st 0 ptr<DiskQword,16>
        %v = view %q ptr<TermSt,1>
        ret %v
}

func t_sh ptr<ShState,1> %st:ptr<DiskQword,3932160> {
    @b0
        %q = slice %st T_SH_Q ptr<DiskQword,16>
        %v = view %q ptr<ShState,1>
        ret %v
}

func t_line ptr<Byte,512> %st:ptr<DiskQword,3932160> {
    @b0
        %q = slice %st T_LINE_Q ptr<DiskQword,64>
        %v = view %q ptr<Byte,512>
        ret %v
}

func t_sb ptr<Byte,32768> %st:ptr<DiskQword,3932160> {
    @b0
        %q = slice %st T_SB_Q ptr<DiskQword,4096>
        %v = view %q ptr<Byte,32768>
        ret %v
}

func t_err ptr<Byte,1024> %st:ptr<DiskQword,3932160> {
    @b0
        %q = slice %st T_ERR_Q ptr<DiskQword,128>
        %v = view %q ptr<Byte,1024>
        ret %v
}

func t_data ptr<Byte,1048576> %st:ptr<DiskQword,3932160> {
    @b0
        %q0 = shl T_DATA_SEC 6
        %q = slice %st %q0 ptr<DiskQword,131072>
        %v = view %q ptr<Byte,1048576>
        ret %v
}

# ---------------------------------------------------------------- bộ đệm cuộn (= stdout của lõi shell)

func t_puts void %st:ptr<DiskQword,3932160> %n:bv64 %s:ptr<Byte,%n> {
    @b0
        %sh = call t_sh %st
        %sb = call t_sb %st
        call sh_out %sh T_SB_CAP %sb %n %s
        ret
}

# Dấu nhắc "light:/thư/mục> "
func t_prompt void %st:ptr<DiskQword,3932160> {
    @req uge %st 0x10000
    @req ult %st 0x10000000000
    @b0
        %sh = call t_sh %st
        %sb = call t_sb %st
        %p1 = addr T_P1
        call sh_out %sh T_SB_CAP %sb T_P1.len %p1
        %tab = slice %st LFS_TAB_Q ptr<DiskQword,4096>
        %cwd = call sh_cwd %sh
        call sh_out_path %sh T_SB_CAP %sb %tab %cwd
        %p2 = addr T_P2
        call sh_out %sh T_SB_CAP %sb T_P2.len %p2
        ret
}

# Đã dùng quá nửa bộ đệm cuộn -> chỉ giữ ~T_SB_KEEP byte cuối (bắt đầu ở đầu một dòng)
func t_make_room void %st:ptr<DiskQword,3932160> {
    @b0
        %sh = call t_sh %st
        %sb = call t_sb %st
        %l0 = load %sh ShState.out_len
        %len = call math_min %l0 T_SB_CAP
        %big = cmp ugt %len 16384
        br %big @cut @keep
    @keep
        ret
    @cut
        %from = sub %len T_SB_KEEP
        %nl = call str_find T_SB_CAP %sb %from 10
        %c0 = add_sat %nl 1
        %c1 = call math_min %c0 %len
        %c = call math_max %c1 %from
        %k = sub %len %c
        %src = slice %sb %c ptr<Byte,%k>
        call mem_copy_b T_SB_CAP %sb %k %src %k
        store %sh ShState.out_len %k
        ret
}

# ---------------------------------------------------------------- vẽ

# Đi qua bộ đệm cuộn (len byte), xuống dòng ở %cols cột. %draw != 0: vẽ các dòng [first, first + rows).
# Trả (số dòng - 1) << 8 | cột cuối.
func t_walk bv64 %px:ptr<VgaCell,1205558> %cw:bv64 %ch:bv64 %sb:ptr<Byte,32768> %len:bv64 %cols:bv64 %rows:bv64 %first:bv64 %draw:bv64 {
    @req ule %len 32768
    @req uge %cols 1
    @req ule %cols 200
    @req ule %rows 100
    @ens ule %r 0x8000ff
    @b0
        jmp @l 0 0 0
    @l %i:bv64 %line:bv64 %col:bv64
        @inv ule %i %len
        @inv ule %line %i
        @inv ule %col %cols
        %more = cmp ult %i %len
        br %more @body @end
    @body
        %p = slice %sb %i ptr<Byte,1>
        %c = load %p 0 bv8
        %i1 = add %i 1
        %isnl = cmp eq %c 10
        br %isnl @newline @t_tab
    @newline
        %ln1 = add %line 1
        jmp @l %i1 %ln1 0
    @t_tab
        %istab = cmp eq %c 9
        br %istab @tab @char
    @tab
        %c3 = or %col 3
        %nc = add %c3 1
        %wrap = cmp uge %nc %cols
        br %wrap @tabwrap @tabok
    @tabwrap
        %ln2 = add %line 1
        jmp @l %i1 %ln2 0
    @tabok
        jmp @l %i1 %line %nc
    @char
        %full = cmp uge %col %cols
        br %full @cwrap @cput0
    @cwrap
        %ln3 = add %line 1
        jmp @put %ln3 0
    @cput0
        jmp @put %line %col
    @put %pl:bv64 %pc:bv64
        @inv ule %pl %i1
        @inv ult %pc %cols
        %vis0 = cmp ne %draw 0
        %vis1 = cmp uge %pl %first
        %last = add_sat %first %rows
        %vis2 = cmp ult %pl %last
        %v01 = and %vis0 %vis1
        %vis = and %v01 %vis2
        br %vis @draw @next
    @draw
        %ge = cmp uge %c 32
        %le = cmp ule %c 126
        %pr = and %ge %le
        br %pr @glyph @dot
    @glyph
        %g = call byte_u64 %c
        jmp @paint %g
    @dot
        jmp @paint 46
    @paint %gl:bv64
        @inv ule %pl %i1
        @inv ult %pc %cols
        %row = sub %pl %first
        %ry = mul %row T_LINE_H
        %y = add %ry 4
        %cx = mul %pc 9
        %x = add %cx 8
        call surf_char 1205558 %px 1920 %cw %ch %x %y %gl COL_RETRO_FG
        jmp @next
    @next
        %nc2 = add %pc 1
        jmp @l %i1 %pl %nc2
    @end
        %hi = shl %line 8
        %r = or %hi %col
        ret %r
}

# Vẽ cả vùng client: chữ, con trỏ (khi ở đáy), thanh cuộn
func t_render void %fb:ptr<VgaCell,1382400> %ipc:ptr<IpcChannel,1> %st:ptr<DiskQword,3932160> %w:bv64 %h:bv64 {
    @req uge %w 400
    @req ule %w 1074
    @req uge %h 200
    @req ule %h 558
    @b0
        %px = call wg_client %fb
        %cw = sub %w 4
        %ch = sub %h 34
        call wg_box %px %cw %ch 0 0 %cw %ch COL_RETRO_BG
        %tw = sub %cw 36
        %cols0 = udiv %tw 9
        %cols = call math_min %cols0 200
        %th = sub %ch 8
        %rows0 = udiv %th T_LINE_H
        %rows = call math_max %rows0 1
        %ts = call t_ts %st
        %sh = call t_sh %st
        %sb = call t_sb %st
        %l0 = load %sh ShState.out_len
        %len = call math_min %l0 T_SB_CAP
        %r = call t_walk %px %cw %ch %sb %len %cols %rows 0 0
        %lastline = lshr %r 8
        %endcol = and %r 0xff
        %total = add %lastline 1
        %maxs = sub_sat %total %rows
        %s0 = load %ts TermSt.scroll
        %s = call math_min %s0 %maxs
        store %ts TermSt.scroll %s
        %first = sub %maxs %s
        %r2 = call t_walk %px %cw %ch %sb %len %cols %rows %first 1
        %bottom = cmp eq %s 0
        br %bottom @cursor @bar
    @cursor
        %crow = sub_sat %lastline %first
        %cy0 = mul %crow T_LINE_H
        %cy = add %cy0 4
        %ccol = call math_min %endcol 199
        %cx0 = mul %ccol 9
        %cx = add %cx0 8
        call surf_char 1205558 %px 1920 %cw %ch %cx %cy 95 COL_RETRO_FG
        jmp @bar
    @bar
        # thanh cuộn: rãnh, nút ^ / v, con trượt theo vị trí đang xem
        %bx = sub %cw T_SBW
        %bx1 = sub %cw 4
        call surf_fill_rect 1205558 %px 1920 %cw %ch %bx 4 %bx1 %th COL_SB_TRACK
        call surf_fill_rect 1205558 %px 1920 %cw %ch %bx 4 %bx1 24 COL_SB_BTN
        %dy = sub %ch 28
        call surf_fill_rect 1205558 %px 1920 %cw %ch %bx %dy %bx1 %th COL_SB_BTN
        %ax = add %bx 4
        call surf_char 1205558 %px 1920 %cw %ch %ax 6 94 COL_RETRO_FG
        %vy = sub %ch 26
        call surf_char 1205558 %px 1920 %cw %ch %ax %vy 118 COL_RETRO_FG
        # con trượt: rãnh trong [28, ch - 32), cao = rãnh * rows / total (>= 12), vị trí theo first
        %trk = sub %ch 60
        %tot = call math_max %total 1
        %th0 = mul %trk %rows
        %thh0 = udiv %th0 %tot
        %thh1 = call math_max %thh0 12
        %thh = call math_min %thh1 %trk
        %room = sub %trk %thh
        %den = call math_max %maxs 1
        %pos0 = mul %room %first
        %pos1 = udiv %pos0 %den
        %pos = call math_min %pos1 %room
        %ty0 = add %pos 28
        %ty1 = add %ty0 %thh
        %tx0 = add %bx 3
        %tx1 = sub %bx1 3
        call surf_fill_rect 1205558 %px 1920 %cw %ch %tx0 %ty0 %tx1 %ty1 COL_SB_THUMB
        call wg_damage %ipc 0 0 %cw %ch
        ret
}

# ---------------------------------------------------------------- chạy lệnh

# Bộ đệm cuộn không kết thúc bằng '\n' (vd cat file không có dòng trống cuối) -> thêm '\n'
func t_ensure_nl void %st:ptr<DiskQword,3932160> {
    @b0
        %sh = call t_sh %st
        %sb = call t_sb %st
        %l0 = load %sh ShState.out_len
        %len = call math_min %l0 T_SB_CAP
        %empty = cmp eq %len 0
        br %empty @out @chk
    @chk
        %i = sub %len 1
        %p = slice %sb %i ptr<Byte,1>
        %c = load %p 0 bv8
        %nl = cmp eq %c 10
        br %nl @out @add
    @add
        %m = addr T_NL
        call t_puts %st T_NL.len %m
        ret
    @out
        ret
}

# Kết thúc lệnh: nối stderr vào bộ đệm cuộn, đánh dấu nếu stdout bị cắt, in dấu nhắc mới, xóa dòng lệnh
func t_finish void %st:ptr<DiskQword,3932160> {
    @req uge %st 0x10000
    @req ult %st 0x10000000000
    @b0
        %ts = call t_ts %st
        %sh = call t_sh %st
        store %ts TermSt.phase 0
        store %ts TermSt.line_len 0
        store %ts TermSt.scroll 0
        %t = load %sh ShState.trunc
        %t1 = and %t 1
        %cut = cmp ne %t1 0
        call t_ensure_nl %st
        br %cut @mark @errs
    @mark
        # bộ đệm đầy: bỏ phần cũ để còn chỗ cho dấu hiệu và dấu nhắc
        call t_make_room %st
        %m = addr T_TRUNC
        call t_puts %st T_TRUNC.len %m
        jmp @errs
    @errs
        %e0 = load %sh ShState.err_len
        %el = call math_min %e0 T_ERR_CAP
        %eb = call t_err %st
        %es = slice %eb 0 ptr<Byte,%el>
        call t_puts %st %el %es
        call t_ensure_nl %st
        # luôn còn chỗ cho dấu nhắc và dòng lệnh sắp gõ
        call t_make_room %st
        call t_prompt %st
        ret
}

# 'memtest': ghi rồi đọc lại 1 qword ở MỖI trang 4KB của heap (trang chưa map thật -> #PF). Trả số qword sai.
func t_memtest bv64 %hn:bv64 %heap:ptr<DiskQword,%hn> {
    @b0
        %pages = lshr %hn 9
        jmp @w 0
    @w %i:bv64
        @inv ule %i %pages
        %more = cmp ult %i %pages
        br %more @wr @check
    @wr
        %o = shl %i 9
        %p = slice %heap %o ptr<DiskQword,1>
        %v = xor %i 0x5a5a5a5a00000000
        store %p 0 %v
        %i2 = add %i 1
        jmp @w %i2
    @check
        jmp @r 0 0
    @r %j:bv64 %bad:bv64
        @inv ule %j %pages
        @inv ule %bad %j
        %more2 = cmp ult %j %pages
        br %more2 @rd @end
    @rd
        %o2 = shl %j 9
        %q = slice %heap %o2 ptr<DiskQword,1>
        %got = load %q 0 bv64
        %want = xor %j 0x5a5a5a5a00000000
        %diff = cmp ne %got %want
        %bad2 = add %bad %diff
        %j2 = add %j 1
        jmp @r %j2 %bad2
    @end
        ret %bad
}

# Lệnh riêng của Terminal; trả 1 nếu (n, s) là một trong số đó (đã chạy xong)
func t_builtin bv64 %st:ptr<DiskQword,3932160> %ipc:ptr<IpcChannel,1> %smp:smp %hn:bv64 %heap:ptr<DiskQword,%hn> %n:bv64 %s:ptr<Byte,%n> {
    @req uge %ipc 0x10000
    @req ult %ipc 0x80000000
    @ens ule %r 1
    @b0
        %sh = call t_sh %st
        %sb = call t_sb %st
        %a = call str_skip_spaces %n %s 0
        %w = call str_find %n %s %a 32
        %cl = sub_sat %w %a
        %cmd = slice %s %a ptr<Byte,%cl>
        %k1 = addr T_C_CLEAR
        %is1 = call str_eq %cl %cmd T_C_CLEAR.len %k1
        %b1 = cmp ne %is1 0
        br %b1 @clear @t_sys
    @clear
        store %sh ShState.out_len 0
        ret 1
    @t_sys
        %k2 = addr T_C_SYS
        %is2 = call str_eq %cl %cmd T_C_SYS.len %k2
        %b2 = cmp ne %is2 0
        br %b2 @sys @t_mem
    @sys
        %l1 = addr T_L_WORKERS
        call t_puts %st T_L_WORKERS.len %l1
        %wk = smp_workers %smp
        call sh_out_dec %sh T_SB_CAP %sb %wk
        %l2 = addr T_L_BG
        call t_puts %st T_L_BG.len %l2
        %bg = load %ipc IpcChannel.bg_mask
        call sh_out_dec %sh T_SB_CAP %sb %bg
        jmp @nl
    @t_mem
        %k3 = addr T_C_MEM
        %is3 = call str_eq %cl %cmd T_C_MEM.len %k3
        %b3 = cmp ne %is3 0
        br %b3 @mem @t_up
    @mem
        %l3 = addr T_L_HEAP
        call t_puts %st T_L_HEAP.len %l3
        %mb = lshr %hn 17                   # qword -> MB
        call sh_out_dec %sh T_SB_CAP %sb %mb
        %l4 = addr T_L_FREE
        call t_puts %st T_L_FREE.len %l4
        %fr = call sys_mem_free %ipc
        %frm = shl %fr 1                    # khung 2MB -> MB
        call sh_out_dec %sh T_SB_CAP %sb %frm
        jmp @nl
    @t_up
        %k4 = addr T_C_MEMUP
        %is4 = call str_eq %cl %cmd T_C_MEMUP.len %k4
        %b4 = cmp ne %is4 0
        br %b4 @up @t_down
    @up
        # xin thêm 512 chunk 2MB (1GB)
        %have0 = lshr %hn 18
        %have = call math_min %have0 16383
        %have15 = call math_max %have 15
        %want0 = add %have15 512
        %want = call math_min %want0 16383
        jmp @memreq %want
    @t_down
        %k5 = addr T_C_MEMDOWN
        %is5 = call str_eq %cl %cmd T_C_MEMDOWN.len %k5
        %b5 = cmp ne %is5 0
        br %b5 @down @t_test
    @down
        jmp @memreq 15
    @memreq %chunks:bv64
        @inv ule %chunks 16383
        @inv uge %chunks 15
        call sys_mem_request %ipc %chunks
        %l5 = addr T_L_MEMREQ
        call t_puts %st T_L_MEMREQ.len %l5
        %rmb = shl %chunks 1
        call sh_out_dec %sh T_SB_CAP %sb %rmb
        jmp @nl
    @t_test
        %k6 = addr T_C_MEMTEST
        %is6 = call str_eq %cl %cmd T_C_MEMTEST.len %k6
        %b6 = cmp ne %is6 0
        br %b6 @test @no
    @test
        %errs = call t_memtest %hn %heap
        %pages = lshr %hn 9
        %l6 = addr T_L_PAGES
        call t_puts %st T_L_PAGES.len %l6
        call sh_out_dec %sh T_SB_CAP %sb %pages
        %l7 = addr T_L_ERRS
        call t_puts %st T_L_ERRS.len %l7
        call sh_out_dec %sh T_SB_CAP %sb %errs
        jmp @nl
    @nl
        %nl = addr T_NL
        call t_puts %st T_NL.len %nl
        ret 1
    @no
        ret 0
}

# Bước cuối: lõi ghi lỗi / mã thoát cho mã kết quả %code, rồi kết thúc lệnh
func t_fs_done void %st:ptr<DiskQword,3932160> %code:bv64 {
    @req uge %st 0x10000
    @req ult %st 0x10000000000
    @b0
        %ts = call t_ts %st
        %sh = call t_sh %st
        %ln0 = load %ts TermSt.line_len
        %ln = call math_min %ln0 T_LINE_CAP
        %lb = call t_line %st
        %line = slice %lb 0 ptr<Byte,%ln>
        %tab = slice %st LFS_TAB_Q ptr<DiskQword,4096>
        %eb = call t_err %st
        %rc = call sh_fs_done %sh %tab %ln %line %code T_ERR_CAP %eb
        call t_finish %st
        ret
}

# Ghi văn bản của write / append vào vùng dữ liệu từ %base rồi xin Kernel WRITE vào file %target
func t_do_write void %st:ptr<DiskQword,3932160> %ipc:ptr<IpcChannel,1> %target:bv64 %base:bv64 {
    @req uge %st 0x10000
    @req ult %st 0x10000000000
    @req uge %ipc 0x10000
    @req ult %ipc 0x80000000
    @b0
        %ts = call t_ts %st
        %sh = call t_sh %st
        %ln0 = load %ts TermSt.line_len
        %ln = call math_min %ln0 T_LINE_CAP
        %lb = call t_line %st
        %line = slice %lb 0 ptr<Byte,%ln>
        %data = call t_data %st
        %pos = call sh_fill_data %sh %ln %line T_DATA_B %data %base
        %e = lshr %pos 63
        %bad = cmp ne %e 0
        br %bad @fail @dowrite
    @fail
        call t_fs_done %st %pos
        ret
    @dowrite
        store %ts TermSt.phase P_FINAL
        call lfs_request %ipc 3 %target T_DATA_SEC %pos
        ret
}

# Kernel vừa phục vụ yêu cầu LightFS của bước %phase: chạy bước tiếp theo
func t_step void %st:ptr<DiskQword,3932160> %ipc:ptr<IpcChannel,1> {
    @req uge %st 0x10000
    @req ult %st 0x10000000000
    @req uge %ipc 0x10000
    @req ult %ipc 0x80000000
    @b0
        %ts = call t_ts %st
        %sh = call t_sh %st
        %phase = load %ts TermSt.phase
        %res = call lfs_result %ipc
        %err = call lfs_is_err %res
        %bad = cmp ne %err 0
        %ln0 = load %ts TermSt.line_len
        %ln = call math_min %ln0 T_LINE_CAP
        %lb = call t_line %st
        %line = slice %lb 0 ptr<Byte,%ln>
        %tab = slice %st LFS_TAB_Q ptr<DiskQword,4096>
        %is_t = cmp eq %phase P_TABLE
        br %is_t @exec @t_cat
    @exec
        # bảng đã mới (nếu chưa gắn hệ tệp thì bảng rỗng; help / echo vẫn chạy)
        %sb = call t_sb %st
        %eb = call t_err %st
        %rc = call sh_exec %sh %ln %line %tab T_SB_CAP %sb T_ERR_CAP %eb
        %op = load %sh ShState.op
        %none = cmp eq %op 0
        br %none @fin @plan
    @fin
        call t_finish %st
        ret
    @plan
        %id = load %sh ShState.op_id
        %new = load %sh ShState.op_new
        %isnew = cmp ne %new 0
        %name = slice %st 4352 ptr<DiskQword,8>
        %o_cat = cmp eq %op SH_OP_CAT
        br %o_cat @cat @p_mk
    @cat
        store %ts TermSt.phase P_CAT
        call lfs_request %ipc 2 %id T_DATA_SEC 0
        ret
    @p_mk
        %o_mk = cmp eq %op SH_OP_MKDIR
        br %o_mk @mkdir @p_touch
    @mkdir
        call sh_pack_name %sh %ln %line %name
        store %ts TermSt.phase P_FINAL
        call lfs_request %ipc 4 %id T_NAME_SEC 2
        ret
    @p_touch
        %o_t = cmp eq %op SH_OP_TOUCH
        br %o_t @touch @p_rm
    @touch
        call sh_pack_name %sh %ln %line %name
        store %ts TermSt.phase P_FINAL
        call lfs_request %ipc 4 %id T_NAME_SEC 0
        ret
    @p_rm
        %o_rm = cmp eq %op SH_OP_RM
        br %o_rm @rm @p_w
    @rm
        store %ts TermSt.phase P_FINAL
        call lfs_request %ipc 5 %id 0 0
        ret
    @p_w
        br %isnew @wnew @wold
    @wnew
        call sh_pack_name %sh %ln %line %name
        store %ts TermSt.phase P_WNEW
        call lfs_request %ipc 4 %id T_NAME_SEC 0
        ret
    @wold
        %o_a = cmp eq %op SH_OP_APPEND
        br %o_a @wread @wtrunc
    @wread
        store %ts TermSt.phase P_WREAD
        call lfs_request %ipc 2 %id T_DATA_SEC 0
        ret
    @wtrunc
        call t_do_write %st %ipc %id 0
        ret
    @t_cat
        br %bad @done_err @t_cat2
    @done_err
        call t_fs_done %st %res
        ret
    @t_cat2
        %is_c = cmp eq %phase P_CAT
        br %is_c @show @t_wnew
    @show
        %sz = call math_min %res T_DATA_B
        %data = call t_data %st
        %bytes = slice %data 0 ptr<Byte,%sz>
        call t_puts %st %sz %bytes
        call t_fs_done %st 0
        ret
    @t_wnew
        %is_wn = cmp eq %phase P_WNEW
        br %is_wn @created @t_wread
    @created
        call t_do_write %st %ipc %res 0
        ret
    @t_wread
        %is_wr = cmp eq %phase P_WREAD
        br %is_wr @readold @final
    @readold
        # file cũ lớn hơn vùng dữ liệu 1MB: không ghi lại (sẽ làm mất phần đuôi)
        %over = cmp ugt %res T_DATA_B
        br %over @toobig @appendok
    @toobig
        call t_fs_done %st SH_E_TOOBIG
        ret
    @appendok
        %tid = load %sh ShState.op_id
        call t_do_write %st %ipc %tid %res
        ret
    @final
        call t_fs_done %st %res
        ret
}

# Enter: xuống dòng, lệnh riêng của Terminal chạy ngay; lệnh shell xin bảng LightFS mới trước (chạy ở t_step)
func t_enter void %st:ptr<DiskQword,3932160> %ipc:ptr<IpcChannel,1> %smp:smp %hn:bv64 %heap:ptr<DiskQword,%hn> {
    @req uge %st 0x10000
    @req ult %st 0x10000000000
    @req uge %ipc 0x10000
    @req ult %ipc 0x80000000
    @b0
        %ts = call t_ts %st
        %sh = call t_sh %st
        %nl = addr T_NL
        call t_puts %st T_NL.len %nl
        call t_make_room %st
        store %sh ShState.err_len 0
        store %sh ShState.trunc 0
        %ln0 = load %ts TermSt.line_len
        %ln = call math_min %ln0 T_LINE_CAP
        %lb = call t_line %st
        %line = slice %lb 0 ptr<Byte,%ln>
        %bi = call t_builtin %st %ipc %smp %hn %heap %ln %line
        %done = cmp ne %bi 0
        br %done @fin @shell
    @fin
        call t_finish %st
        ret
    @shell
        store %ts TermSt.phase P_TABLE
        call lfs_request %ipc 1 0 0 0
        ret
}

# Một phím (không phải Enter / ESC): ký tự in được thêm vào dòng lệnh, Backspace xóa lùi
func t_key void %st:ptr<DiskQword,3932160> %k:bv8 {
    @b0
        %ts = call t_ts %st
        %sh = call t_sh %st
        %ln0 = load %ts TermSt.line_len
        %ln = call math_min %ln0 T_LINE_CAP
        %bs = cmp eq %k 8
        br %bs @back @t_pr
    @back
        %has = cmp ne %ln 0
        br %has @del @out
    @del
        %ln1 = sub %ln 1
        store %ts TermSt.line_len %ln1
        %o0 = load %sh ShState.out_len
        %o1 = sub_sat %o0 1
        store %sh ShState.out_len %o1
        ret
    @t_pr
        %ge = cmp uge %k 32
        %le = cmp ule %k 126
        %pr = and %ge %le
        br %pr @room @out
    @room
        %fit = cmp ult %ln 500
        br %fit @add @out
    @add
        %lb = call t_line %st
        %p = slice %lb %ln ptr<Byte,1>
        store %p 0 %k
        %ln2 = add %ln 1
        store %ts TermSt.line_len %ln2
        %one = slice %lb %ln ptr<Byte,1>
        call t_puts %st 1 %one
        ret
    @out
        ret
}

# Vòng chính (Kernel gọi khi có phím / chuột / kết quả LightFS / đề nghị kích thước mới)
func app_terminal_main void %0:ptr<VgaCell,1382400> %1:ptr<IpcChannel,1> %2:ptr<DiskQword,3932160> %3:ptr<DiskQword,64> %4:ptr<DiskQword,64> %5:smp %900:bv64 %901:ptr<DiskQword,%900> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x10000000000
    @req uge %3 0x10000
    @req ult %3 0x80000000
    @req uge %4 0x10000
    @req ult %4 0x80000000
    @b0
        %ts = call t_ts %2
        %w = call wg_pick_w %1 880 480 1074
        %h = call wg_pick_h %1 540 240 558
        %init = load %ts TermSt.init
        %fresh = cmp eq %init 0
        br %fresh @hello @phase
    @hello
        store %ts TermSt.init 1
        %b = addr T_BANNER
        call t_puts %2 T_BANNER.len %b
        call t_prompt %2
        jmp @phase
    @phase
        %ph = load %ts TermSt.phase
        %busy = cmp ne %ph 0
        br %busy @step @win
    @step
        call t_step %2 %1
        jmp @win
    @win
        %ow = load %ts TermSt.ow
        %oh = load %ts TermSt.oh
        %drawn = load %1 IpcChannel.win_drawn
        %c1 = cmp ne %w %ow
        %c2 = cmp ne %h %oh
        %c3 = cmp eq %drawn 0
        %c12 = or %c1 %c2
        %c123 = or %c12 %c3
        br %c123 @open @input
    @open
        store %1 IpcChannel.win_drawn 1
        store %ts TermSt.ow %w
        store %ts TermSt.oh %h
        call wg_window_open %0 %3 %1 %w %h TERM_TITLE COL_RETRO_BG
        call wg_damage_window %1 %w %h
        jmp @input
    @input
        # đang chờ Kernel: chưa đọc phím (phím nằm lại trong kênh)
        %ph2 = load %ts TermSt.phase
        %wait = cmp ne %ph2 0
        br %wait @click @key
    @key
        %k = call sys_key_pop %1
        %none = cmp eq %k 0
        br %none @click @gotkey
    @gotkey
        store %ts TermSt.scroll 0
        %esc = cmp eq %k 27
        br %esc @close @t_enter
    @close
        call sys_close %1
        ret
    @t_enter
        %e1 = cmp eq %k 10
        %e2 = cmp eq %k 13
        %ent = or %e1 %e2
        br %ent @enter @typed
    @enter
        call t_enter %2 %1 %5 %900 %901
        jmp @click
    @typed
        call t_key %2 %k
        jmp @click
    @click
        %cl = call sys_click_take %1
        %has = cmp ne %cl 0
        br %has @hit @draw
    @hit
        %mx = call wg_mouse_x %1
        %my = call wg_mouse_y %1
        %cw = sub %w 4
        %ch = sub %h 34
        %bx = sub %cw T_SBW
        %up = call wg_hit %mx %my %bx 4 T_SBW 24
        %isu = cmp ne %up 0
        br %isu @sup @t_down
    @sup
        %s0 = load %ts TermSt.scroll
        %s1 = add_sat %s0 3
        store %ts TermSt.scroll %s1
        jmp @draw
    @t_down
        %dy = sub %ch 28
        %dn = call wg_hit %mx %my %bx %dy T_SBW 24
        %isd = cmp ne %dn 0
        br %isd @sdown @draw
    @sdown
        %s2 = load %ts TermSt.scroll
        %s3 = sub_sat %s2 3
        store %ts TermSt.scroll %s3
        jmp @draw
    @draw
        call t_render %0 %1 %2 %w %h
        ret
}
