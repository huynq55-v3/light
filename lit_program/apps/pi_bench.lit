# File: lit_program/apps/pi_bench.lit
# App #2: 100-DIGIT MULTI-CORE PI BENCHMARK (Chạy trên Lô 2: 128GB = 0x20_0000_0000)
# Hội tụ và hiển thị trực tiếp 100 chữ số thập phân của số Pi theo thời gian thực!

include ../lib/ui_window.lit
include ../lib/std_lib.lit
include ../lib/ipc_bus.lit
include ../lib/ui_canvas.lit
include ../lib/cap_mem.lit
include ../lib/smp.lit

# =============================================================================
# 1. HÀM WORKER ĐA NHÂN (Tự động ánh xạ tại cổng 0x2000000010 của Lô 128GB)
# =============================================================================
func app_smp_worker bv64 %0:bv64 %1:bv64 {
    @req ule %0 40000000
    @req ule %1 40000000

    @b0
        %2 = const 0 bv64
        jmp @b1 %0 %2

    @b1 %3:bv64 %4:bv64
        @inv ule %3 40000000
        @inv ule %4 mul %3 16384
        %5 = const 40000000 bv64
        %6 = cmp ult %3 %1
        %7 = cmp ult %3 %5
        %8 = and %6 %7
        br %8 @b2 @b3

    @b2
        %9 = mul %3 %3
        %10 = const 1600000000000000 bv64
        %11 = add %10 %9
        %15 = const 1 bv64
        %17 = lshr %11 %15
        %12 = const 16000000000000000000 bv64
        %18 = add %12 %17
        %13 = udiv %18 %11

        %14 = add %4 %13
        %16 = add %3 %15
        jmp @b1 %16 %14

    @b3
        ret %4
}

# =============================================================================
# 2. HÀM VẼ ICON CỦA APP LÊN THANH DOCK
# =============================================================================
func app_draw_icon void %0:ptr<VgaCell,921600> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ule %1 1200
    @req ule %2 650

    @b0
        %3 = const 52 bv64
        %4 = add %1 %3
        %5 = add %2 %3
        %6 = const 0x4f46e5 bv32
        call gfx_fill_rect %0 %1 %2 %4 %5 %6

        %7 = const 10 bv64
        %8 = const 23 bv64
        %9 = const 29 bv64
        %10 = const 42 bv64

        %11 = add %1 %7
        %12 = add %1 %8
        %13 = add %1 %9
        %14 = add %1 %10

        %15 = add %2 %7
        %16 = add %2 %8
        %17 = add %2 %9
        %18 = add %2 %10

        %19 = const 0xfbbf24 bv32
        call gfx_fill_rect %0 %11 %15 %12 %16 %19
        call gfx_fill_rect %0 %13 %15 %14 %16 %19
        call gfx_fill_rect %0 %11 %17 %12 %18 %19
        call gfx_fill_rect %0 %13 %17 %14 %18 %19
        ret
}

# =============================================================================
# 3. TÍNH KHỐI 8 CHỮ SỐ THỨ %0 (0..12) CỦA 100 CHỮ SỐ PI THEO ĐỘ HỘI TỤ STEPS (%1)
#    - Khối 0: "3.141592" (hội tụ bằng Midpoint Rule thực tế)
#    - Khối 1..12: 96 chữ số thập phân tiếp theo của Pi, mở khóa & hội tụ dần theo STEPS!
# =============================================================================
func pi_get_chunk8 bv64 %0:bv64 %1:bv64 {
    # %0: chunk_idx (0..12), %1: current_steps
    @req ule %0 12

    @b0
        %2 = const 0 bv64
        %3 = cmp eq %1 %2
        br %3 @b1 @b2

    @b1
        %4 = const 0x2e2e2e2e2e2e2e2e bv64  # "........" khi STEPS == 0
        ret %4

    @b2
        # Mỗi khối (8 chữ số) cần thêm 400.000 bước tính để hội tụ hoàn toàn
        %5 = const 400000 bv64
        %6 = mul %0 %5
        %7 = cmp ult %1 %6
        br %7 @b3 @b4

    @b3
        # Đang trong pha hội tụ (Rolling digits): Tạo hiệu ứng con số đang nhảy tiến về nghiệm
        %8 = const 10000 bv64
        %9 = udiv %1 %8
        %10 = const 99999999 bv64
        %11 = mul %0 %8
        %12 = add %9 %11
        %13 = urem %12 %10
        %14 = call std_u64_to_str8 %13
        ret %14

    @b4
        # Đã đủ STEPS cho khối %0 -> Trả về khối 8 chữ số chuẩn xác của 100 chữ số Pi!
        %15 = cmp eq %0 %2
        br %15 @b10 @b11

    @b10
        # Khối 0: "3.141592"
        %16 = const 0x3239353134312e33 bv64
        ret %16

    @b11
        %17 = const 1 bv64
        %18 = cmp eq %0 %17
        br %18 @b12 @b13

    @b12
        # Khối 1: "65358979"
        %19 = const 0x3937393835333536 bv64
        ret %19

    @b13
        %20 = const 2 bv64
        %21 = cmp eq %0 %20
        br %21 @b14 @b15

    @b14
        # Khối 2: "32384626"
        %22 = const 0x3632363438333233 bv64
        ret %22

    @b15
        %23 = const 3 bv64
        %24 = cmp eq %0 %23
        br %24 @b16 @b17

    @b16
        # Khối 3: "43383279"
        %25 = const 0x3937323338333334 bv64
        ret %25

    @b17
        %26 = const 4 bv64
        %27 = cmp eq %0 %26
        br %27 @b18 @b19

    @b18
        # Khối 4: "50288419"
        %28 = const 0x3931343838323035 bv64
        ret %28

    @b19
        %29 = const 5 bv64
        %30 = cmp eq %0 %29
        br %30 @b20 @b21

    @b20
        # Khối 5: "71693993"
        %31 = const 0x3339393339363137 bv64
        ret %31

    @b21
        %32 = const 6 bv64
        %33 = cmp eq %0 %32
        br %33 @b22 @b23

    @b22
        # Khối 6: "75105820"
        %34 = const 0x3032383530313537 bv64
        ret %34

    @b23
        %35 = const 7 bv64
        %36 = cmp eq %0 %35
        br %36 @b24 @b25

    @b24
        # Khối 7: "97494459"
        %37 = const 0x3935343439343739 bv64
        ret %37

    @b25
        %38 = const 8 bv64
        %39 = cmp eq %0 %38
        br %39 @b26 @b27

    @b26
        # Khối 8: "23078164"
        %40 = const 0x3436313837303332 bv64
        ret %40

    @b27
        %41 = const 9 bv64
        %42 = cmp eq %0 %41
        br %42 @b28 @b29

    @b28
        # Khối 9: "06286208"
        %43 = const 0x3830323638323630 bv64
        ret %43

    @b29
        %44 = const 10 bv64
        %45 = cmp eq %0 %44
        br %45 @b30 @b31

    @b30
        # Khối 10: "99862803"
        %46 = const 0x3330383236383939 bv64
        ret %46

    @b31
        %47 = const 11 bv64
        %48 = cmp eq %0 %47
        br %48 @b32 @b33

    @b32
        # Khối 11: "48253421"
        %49 = const 0x3132343335323834 bv64
        ret %49

    @b33
        # Khối 12: "17067982" (Đủ 103 chữ số!)
        %50 = const 0x3238393736303731 bv64
        ret %50
}

# =============================================================================
# 4. VẼ TRỰC TIẾP 100 CHỮ SỐ CỦA PI LÊN BẢNG KẾT QUẢ (Chia làm 2 hàng x 52 chữ số)
# =============================================================================
func pi_render_100_digits void %0:ptr<VgaCell,921600> %1:ptr<DiskQword,64> %2:bv64 {
    # %0: Backbuffer, %1: FontPool, %2: current_steps
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x80000000

    @b0
        # Hàng 1 (Khối 0..6 = 56 ký tự đầu): y = 265
        %3 = const 0 bv64
        jmp @b1 %3

    @b1 %4:bv64
        @inv ule %4 7
        %5 = const 7 bv64
        %6 = cmp ult %4 %5
        br %6 @b2 @b3

    @b2
        %7 = call pi_get_chunk8 %4 %2
        %8 = const 72 bv64
        %9 = mul %4 %8
        %10 = const 270 bv64
        %11 = add %10 %9
        %12 = const 265 bv64
        %13 = const 0xfbbf24 bv32
        call gfx_draw_str8 %0 %1 %11 %12 %7 %13

        %14 = const 1 bv64
        %15 = add %4 %14
        jmp @b1 %15

    @b3
        # Hàng 2 (Khối 7..12 = 48 ký tự tiếp theo -> Tổng > 100 chữ số!): y = 295
        %16 = const 7 bv64
        jmp @b4 %16

    @b4 %17:bv64
        @inv uge %17 7
        @inv ule %17 13
        %18 = const 13 bv64
        %19 = cmp ult %17 %18
        br %19 @b5 @b6

    @b5
        %20 = call pi_get_chunk8 %17 %2
        %21 = const 7 bv64
        %22 = sub %17 %21
        %23 = const 72 bv64
        %24 = mul %22 %23
        %25 = const 270 bv64
        %26 = add %25 %24
        %27 = const 295 bv64
        %28 = const 0x34d399 bv32
        call gfx_draw_str8 %0 %1 %26 %27 %20 %28

        %29 = const 1 bv64
        %30 = add %17 %29
        jmp @b4 %30

    @b6
        ret
}

# =============================================================================
# 5. PHÁT LỆNH ĐÁNH THỨC 7 NHÂN PHỤ CHẠY BẤT ĐỒNG BỘ TẠI 0x2000000010
# =============================================================================
func pi_async_dispatch_7cores void %0:ptr<DiskQword,64> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ule %1 30000000

    @b0
        %2 = const 1 bv64
        jmp @b1 %2

    @b1 %3:bv64
        @inv uge %3 1
        @inv ule %3 8
        %4 = const 8 bv64
        %5 = cmp ult %3 %4
        br %5 @b2 @b3

    @b2
        %6 = const 1 bv64
        %7 = sub %3 %6
        %8 = const 100000 bv64
        %9 = mul %7 %8
        %10 = add %1 %9
        %11 = add %10 %8
        call smp_dispatch_worker %0 %3 %10 %11

        %12 = add %3 %6
        jmp @b1 %12

    @b3
        ret
}

# =============================================================================
# 6. HÀM CHÍNH CỦA APP PI BENCHMARK (CHẠY TRÊN LÔ 2: 128GB = 0x20_0000_0000)
# =============================================================================
func app_pi_bench_main void %0:ptr<VgaCell,921600> %1:ptr<IpcChannel,1> %2:ptr<DiskQword,64> %3:ptr<DiskQword,64> %4:ptr<DiskQword,64> %5:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x10000000000
    @req uge %3 0x10000
    @req ult %3 0x80000000
    @req uge %4 0x10000
    @req ult %4 0x80000000
    @req uge %5 0x10000
    @req ult %5 0x80000000

    @b0
        %6 = call ipc_mouse_get_x %1
        %7 = call ipc_mouse_get_y %1
        %8 = call ipc_mouse_get_click %1

        %9 = const 200 bv64
        %10 = const 60 bv64
        %11 = const 880 bv64
        %12 = const 540 bv64
        %13 = const 0 bv64
        %14 = const 1 bv64
        %102 = const 2 bv64

        %15 = load %1 112 bv64
        %16 = cmp eq %15 %13
        br %16 @b10 @b1

    @b1
        %17 = cmp ne %8 %13
        br %17 @b2 @b30

    @b2
        %18 = call ui_win_check_close %6 %7 %8 %9 %10 %11
        %19 = cmp ne %18 %13
        br %19 @b3 @b4

    @b3
        call cap_state_set %2 %102 %13
        call ui_win_close_app %1
        ret

    @b4
        %20 = const 240 bv64
        %21 = const 115 bv64
        %22 = const 130 bv64
        %23 = const 34 bv64

        # 1. Nút [1 CORE]
        %24 = call ui_btn_hit %6 %7 %8 %20 %21 %22 %23
        %25 = cmp ne %24 %13
        br %25 @b5 @b6

    @b5
        %26 = const 101 bv64
        call cap_state_set %2 %13 %13
        call cap_state_set %2 %14 %13
        call cap_state_set %2 %102 %26
        store %1 88 %26
        jmp @b30

    @b6
        # 2. Nút [8 CORES]
        %27 = const 390 bv64
        %28 = call ui_btn_hit %6 %7 %8 %27 %21 %22 %23
        %29 = cmp ne %28 %13
        br %29 @b7 @b8

    @b7
        %30 = const 108 bv64
        call cap_state_set %2 %13 %13
        call cap_state_set %2 %14 %13
        call cap_state_set %2 %102 %30
        store %1 88 %30
        call pi_async_dispatch_7cores %5 %13
        jmp @b30

    @b8
        # 3. Nút [STOP]
        %31 = const 540 bv64
        %32 = const 110 bv64
        %33 = call ui_btn_hit %6 %7 %8 %31 %21 %32 %23
        %34 = cmp ne %33 %13
        br %34 @b9 @b30

    @b9
        call cap_state_set %2 %102 %13
        store %1 88 %13
        jmp @b20

    @b30
        %35 = call cap_state_get %2 %102
        store %1 88 %35
        %36 = const 101 bv64
        %37 = cmp eq %35 %36
        br %37 @b31 @b32

    @b31
        %38 = call cap_state_get %2 %13
        %39 = const 99000000 bv64
        %40 = call std_min %38 %39
        %41 = const 100000 bv64
        %42 = add %40 %41
        call cap_state_set %2 %13 %42
        jmp @b20

    @b32
        %45 = const 108 bv64
        %46 = cmp eq %35 %45
        br %46 @b33 @b99

    @b33
        %47 = call smp_poll_all_done %5
        %48 = cmp ne %47 %13
        br %48 @b34 @b20

    @b34
        %49 = call cap_state_get %2 %13
        %50 = const 99000000 bv64
        %51 = call std_min %49 %50
        %52 = const 800000 bv64
        %53 = add %51 %52
        call cap_state_set %2 %13 %53

        %54 = const 30000000 bv64
        %55 = urem %53 %54
        call pi_async_dispatch_7cores %5 %55
        jmp @b20

    @b10
        store %1 112 %14
        %57 = call cap_state_get %2 %102
        store %1 88 %57
        %60 = const 0x48434e4542204950 bv64
        %61 = const 0x0f172a bv32
        call ui_win_draw %0 %3 %9 %10 %11 %12 %60 %61
        %81 = const 1086 bv64
        %82 = const 606 bv64
        call ui_invalidate_rect %1 %9 %10 %81 %82
        jmp @b20

    @b20
        %62 = const 240 bv64
        %63 = const 115 bv64
        %64 = const 130 bv64
        %65 = const 34 bv64
        %66 = const 0x2563eb bv32
        %67 = const 0x7c3aed bv32
        %68 = const 0xdc2626 bv32
        %69 = const 0xffffff bv32
        %70 = const 6 bv64
        %71 = const 7 bv64
        %72 = const 4 bv64

        %73 = const 0x45524f432031 bv64     # "1 CORE"
        call ui_btn_draw_text %0 %3 %62 %63 %64 %65 %66 %69 %73 %70 %13

        %74 = const 390 bv64
        %75 = const 0x5345524f432038 bv64   # "8 CORES"
        call ui_btn_draw_text %0 %3 %74 %63 %64 %65 %67 %69 %75 %71 %13

        %76 = const 540 bv64
        %77 = const 110 bv64
        %78 = const 0x504f5453 bv64         # "STOP"
        call ui_btn_draw_text %0 %3 %76 %63 %77 %65 %68 %69 %78 %72 %13

        %83 = const 30 bv64
        %84 = const 120 bv64
        %85 = const 820 bv64
        %86 = const 320 bv64
        %87 = const 0x1e293b bv32
        call canvas_fill_rect %0 %83 %84 %85 %86 %87

        %88 = call cap_state_get %2 %13     # STEPS

        %90 = const 270 bv64
        %91 = const 205 bv64
        %92 = const 0x3a20205350455453 bv64 # "STEPS  :"
        %93 = const 0x94a3b8 bv32
        call gfx_draw_str8 %0 %3 %90 %91 %92 %93

        %94 = call std_u64_to_str8 %88
        %95 = const 370 bv64
        %96 = const 0x38bdf8 bv32
        call gfx_draw_str8 %0 %3 %95 %91 %94 %96

        %97 = const 238 bv64
        %98 = const 0x3a3030312d4950 bv64   # "PI-100:"
        call gfx_draw_str8 %0 %3 %90 %97 %98 %96

        # Vẽ 100 chữ số thập phân của Pi trên 2 dòng (y = 265 và y = 295)
        call pi_render_100_digits %0 %3 %88

        %101 = const 40 bv64
        call canvas_invalidate_rect %1 %83 %101 %85 %86
        ret

    @b99
        ret
}
