# File: lit_program/apps/widgets.lit
# App mẫu cho lát 4 GUI: cửa sổ ĐỔI KÍCH THƯỚC được (kéo góc dưới-phải) + bộ widget std/widget.lit.
# App tự quyết kích thước: nhận đề nghị của compositor, kẹp trong [400,1074] x [200,558], vẽ lại bố cục theo
# kích thước đó rồi báo lại. Nút "+1" / "RESET" đổi bộ đếm; ESC đóng App.

include ../std/fmt.lit
include ../std/widget.lit

def WG_BG 0xf1f5f9
def WG_INK 0x0f172a
def WG_TITLE 0x2053544547444957             # "WIDGETS "

data WG_BUF Byte 48 {
}
data WG_L_SIZE Byte {
    "SIZE "
}
data WG_L_COUNT Byte {
    "COUNT "
}
data WG_L_PLUS Byte {
    "+1"
}
data WG_L_RESET Byte {
    "RESET"
}
data WG_L_HINT Byte {
    "KEO GOC DUOI-PHAI DE DOI KICH THUOC"
}

# Icon 52x52 trên Dock: 4 ô vuông màu
func app_draw_icon void %0:ptr<VgaCell,1382400> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ule %1 1200
    @req ule %2 650
    @b0
        %xe = add %1 52
        %ye = add %2 52
        call gfx_fill_rect %0 %1 %2 %xe %ye 0xf1f5f9
        %a = add %1 6
        %b = add %2 6
        %am = add %1 24
        %bm = add %2 24
        call gfx_fill_rect %0 %a %b %am %bm 0x3b82f6
        %c = add %1 28
        %cm = add %1 46
        call gfx_fill_rect %0 %c %b %cm %bm 0xef4444
        %d = add %2 28
        %dm = add %2 46
        call gfx_fill_rect %0 %a %d %am %dm 0x22c55e
        call gfx_fill_rect %0 %c %d %cm %dm 0xf59e0b
        ret
}

# Màu ô thứ i (xoay vòng 4 màu)
func wg_color bv32 %i:bv64 {
    @b0
        %k = and %i 3
        %z = cmp eq %k 0
        br %z @c0 @n1
    @n1
        %o = cmp eq %k 1
        br %o @c1 @n2
    @n2
        %t = cmp eq %k 2
        br %t @c2 @c3
    @c0
        ret 0x3b82f6:bv32
    @c1
        ret 0xef4444:bv32
    @c2
        ret 0x22c55e:bv32
    @c3
        ret 0xf59e0b:bv32
}

# Vẽ toàn bộ nội dung client theo kích thước cửa sổ w x h
func wg_draw void %fb:ptr<VgaCell,1382400> %w:bv64 %h:bv64 %count:bv64 {
    @req uge %w 400
    @req ule %w 1074
    @req uge %h 200
    @req ule %h 558
    @b0
        %px = call wg_client %fb
        %cw = sub %w 4
        %ch = sub %h 34
        call wg_box %px %cw %ch 0 0 %cw %ch WG_BG
        # "SIZE <w>x<h>"
        %buf = addr WG_BUF
        %ls = addr WG_L_SIZE
        %p1 = call fmt_str WG_BUF.len %buf 0 WG_L_SIZE.len %ls
        %p2 = call fmt_u64 WG_BUF.len %buf %p1 %w
        %p3 = call fmt_byte WG_BUF.len %buf %p2 120
        %p4 = call fmt_u64 WG_BUF.len %buf %p3 %h
        %sz = view %buf ptr<Byte,%p4>
        call wg_label %px %cw %ch 16 12 %p4 %sz WG_INK
        # nút
        %lp = addr WG_L_PLUS
        call wg_button %px %cw %ch 16 40 64 28 WG_L_PLUS.len %lp 0xdbeafe WG_INK
        %lr = addr WG_L_RESET
        call wg_button %px %cw %ch 96 40 80 28 WG_L_RESET.len %lr 0xfee2e2 WG_INK
        # "COUNT <n>"
        %lc = addr WG_L_COUNT
        %q1 = call fmt_str WG_BUF.len %buf 0 WG_L_COUNT.len %lc
        %q2 = call fmt_u64 WG_BUF.len %buf %q1 %count
        %ct = view %buf ptr<Byte,%q2>
        call wg_label %px %cw %ch 16 84 %q2 %ct WG_INK
        # hàng ô vuông trải theo chiều rộng: số ô phụ thuộc kích thước cửa sổ
        %right = sub %cw 16
        jmp @l 16 0
    @l %x:bv64 %i:bv64
        @inv ule %x 0x10000
        @inv ule %i %x
        %xe = add %x 32
        %fits = cmp ule %xe %right
        br %fits @box @bar
    @box
        %col = call wg_color %i
        call wg_box %px %cw %ch %x 120 32 32 %col
        %x2 = add %x 40
        %i2 = add %i 1
        jmp @l %x2 %i2
    @bar
        # thanh dưới cùng rộng đúng client - 32 + gợi ý
        %by = sub %ch 24
        %bw = sub %cw 32
        call wg_box %px %cw %ch 16 %by %bw 12 0x94a3b8
        %lh = addr WG_L_HINT
        %hy = sub %ch 48
        call wg_label %px %cw %ch 16 %hy WG_L_HINT.len %lh 0x475569
        ret
}

func app_widgets_main void %fb:ptr<VgaCell,1382400> %ipc:ptr<IpcChannel,1> %st:ptr<DiskQword,3932160> %font:ptr<DiskQword,64> %x4:ptr<DiskQword,64> %smp:smp {
    @req uge %fb 0x10000
    @req ult %fb 0x80000000
    @req uge %ipc 0x10000
    @req ult %ipc 0x80000000
    @req uge %font 0x10000
    @req ult %font 0x80000000
    @b0
        %w = call wg_pick_w %ipc 600 400 1074
        %h = call wg_pick_h %ipc 400 200 558
        # trạng thái: [0] = w đã vẽ, [1] = h đã vẽ, [2] = bộ đếm
        %s = slice %st 0 ptr<DiskQword,3>
        %s0 = slice %s 0 ptr<DiskQword,1>
        %s1 = slice %s 1 ptr<DiskQword,1>
        %s2 = slice %s 2 ptr<DiskQword,1>
        %ow = load %s0 0 bv64
        %oh = load %s1 0 bv64
        %count = load %s2 0 bv64
        %drawn = load %ipc IpcChannel.win_drawn
        %c1 = cmp ne %w %ow
        %c2 = cmp ne %h %oh
        %c3 = cmp eq %drawn 0
        %c12 = or %c1 %c2
        %c123 = or %c12 %c3
        %redraw = cmp ne %c123 0
        br %redraw @full @input
    @full
        store %ipc IpcChannel.win_drawn 1
        store %s0 0 %w
        store %s1 0 %h
        call wg_window_open %fb %font %ipc %w %h WG_TITLE WG_BG
        call wg_draw %fb %w %h %count
        call wg_damage_window %ipc %w %h
        jmp @input
    @input
        %k = call sys_key_pop %ipc
        %esc = cmp eq %k 27
        br %esc @close @click
    @close
        call sys_close %ipc
        ret
    @click
        %cl = call sys_click_take %ipc
        %has = cmp ne %cl 0
        br %has @hit @done
    @hit
        %mx = call wg_mouse_x %ipc
        %my = call wg_mouse_y %ipc
        %plus = call wg_hit %mx %my 16 40 64 28
        %isp = cmp ne %plus 0
        br %isp @inc @rst
    @inc
        %n1 = add_sat %count 1
        jmp @set %n1
    @rst
        %reset = call wg_hit %mx %my 96 40 80 28
        %isr = cmp ne %reset 0
        br %isr @zero @done
    @zero
        jmp @set 0
    @set %n:bv64
        store %s2 0 %n
        call wg_draw %fb %w %h %n
        %cw = sub %w 4
        %ch = sub %h 34
        call wg_damage %ipc 0 0 %cw %ch
        ret
    @done
        ret
}
