# File: lit_program/apps/simd_ai.lit
# App: MULTI-CORE SIMD AVX2 256-BIT & FIXED-POINT Q16.16 TENSOR BENCHMARK
# Kết hợp cả Nâng cấp 2 (spawn/sync + Z3 Disjoint Slice) và Nâng cấp 3 (AVX2 256-bit + Q16.16):
# - Core 0 điều phối UI 60 FPS (Slot 0..3)
# - (N - 1) Core Worker nhận các lát cắt 256-bit tách biệt (ptr<DiskQword,4> tại Slot core_id*4)
#   và trực tiếp thực thi vadd256, vmul256, vsub256, vxor256, vdot256, fxmul, fxdiv song song!

include ../lib/ui_window.lit
include ../lib/std_lib.lit
include ../lib/ipc_bus.lit
include ../lib/ui_canvas.lit
include ../lib/cap_mem.lit
include ../lib/smp.lit
include ../lib/tensor.lit

# =============================================================================
# 1. HÀM WORKER ĐA NHÂN (Chạy song song trên các nhân AP: Core 1..N-1)
#    Nhận trực tiếp lát cắt 256-bit (32 bytes) tách biệt %0:ptr<DiskQword,4>
#    Thực thi trực tiếp tập lệnh AVX2 256-bit (vadd256, vmul256, vsub256, vxor256, vdot256)
#    và Số thực Điểm cố định Q16.16 (fxmul, fxdiv) ngay trên từng nhân vật lý!
# =============================================================================
func app_smp_worker bv64 %0:ptr<DiskQword,4> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req ule %1 33554432

    @b0
        %2 = const 0 bv64
        %3 = const 2 bv64
        %4 = const 3 bv64
        %5 = const 4 bv64
        %6 = const 5 bv64
        store %0 0 %3
        store %0 8 %4
        store %0 16 %5
        store %0 24 %6
        jmp @b1 %2 %2

    @b1 %7:bv64 %8:bv64
        @inv ule %7 65536
        %9 = const 65536 bv64
        %10 = cmp ult %7 %9
        br %10 @b2 @b3

    @b2
        %11 = add %1 %7
        %12 = const 0xff bv64
        %13 = and %11 %12
        %14 = const 2 bv64
        %15 = add %13 %14
        store %0 0 %15

        # Thực thi chuỗi lệnh Vector SIMD 256-bit (AVX2 YMM0) trên lát cắt riêng %0:
        vadd256 %0 %0 %0
        vmul256 %0 %0 %0
        vsub256 %0 %0 %0
        vxor256 %0 %0 %0
        store %0 0 %15
        %16 = vdot256 %0 %0

        # Kết hợp tính toán Số thực Điểm cố định Q16.16 (fxmul * 1.75 / fxdiv 1.25)
        %17 = const 0xffff bv64
        %18 = and %16 %17
        %19 = const 16 bv64
        %20 = shl %18 %19
        %21 = const 114688 bv64             # 1.75 trong Q16.16
        %22 = fxmul %20 %21
        %23 = const 0xffffffff bv64
        %24 = and %22 %23
        %25 = const 81920 bv64              # 1.25 trong Q16.16
        %26 = fxdiv %24 %25
        %27 = lshr %26 %19
        %28 = xor %8 %27

        %29 = const 1 bv64
        %30 = add %7 %29
        jmp @b1 %30 %28

    @b3
        ret %8
}

# =============================================================================
# 2. HÀM VẼ ICON 52x52 LÊN THANH DOCK (Biểu tượng 4 Làn Vector SIMD Emerald)
# =============================================================================
func app_draw_icon void %0:ptr<VgaCell,921600> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ule %1 1200
    @req ule %2 650

    @b0
        %3 = const 52 bv64
        %4 = add %1 %3
        %5 = add %2 %3
        %6 = const 0x059669 bv32            # Emerald 600
        call gfx_fill_rect %0 %1 %2 %4 %5 %6

        %7 = const 4 bv64
        %8 = add %1 %7
        %9 = add %2 %7
        %10 = sub %4 %7
        %11 = sub %5 %7
        %12 = const 0x064e3b bv32           # Emerald 900
        call gfx_fill_rect %0 %8 %9 %10 %11 %12

        %13 = const 10 bv64
        %14 = const 15 bv64
        %15 = const 20 bv64
        %16 = const 25 bv64
        %17 = const 29 bv64
        %18 = const 34 bv64
        %19 = const 39 bv64
        %20 = const 44 bv64

        %21 = add %1 %13
        %22 = add %1 %14
        %23 = add %1 %15
        %24 = add %1 %16
        %25 = add %1 %17
        %26 = add %1 %18
        %27 = add %1 %19
        %28 = add %1 %20

        %29 = const 12 bv64
        %30 = const 40 bv64
        %31 = add %2 %29
        %32 = add %2 %30

        %33 = const 0x34d399 bv32           # Emerald 400
        %34 = const 0xfbbf24 bv32           # Amber 400
        call gfx_fill_rect %0 %21 %31 %22 %32 %33
        call gfx_fill_rect %0 %23 %31 %24 %32 %34
        call gfx_fill_rect %0 %25 %31 %26 %32 %33
        call gfx_fill_rect %0 %27 %31 %28 %32 %34
        ret
}

# =============================================================================
# 3. GIAO VIỆC ĐA NHÂN BẰNG CHỈ THỊ `spawn` VỚI DISJOINT SLICE 256-BIT
#    - %0: App State Arena (64 Qwords) -> Cắt lát riêng idx = core_id * 4 cho từng Core!
#    - %1: Bảng điều khiển SMP (0x7e000)
#    - %2: Base seed của nhịp hiện tại
# =============================================================================
func simd_async_dispatch_workers void %0:ptr<DiskQword,64> %1:ptr<DiskQword,64> %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req ule %2 33030144

    @b0
        %3 = call smp_get_worker_count %1
        %4 = const 1 bv64
        jmp @b1 %4

    @b1 %5:bv64
        @inv uge %5 1
        @inv ule %5 16
        %6 = cmp ule %5 %3
        br %6 @b2 @b3

    @b2
        # Cắt lát Vector 256-bit (32 bytes = 4 Qwords) tách biệt cho nhân %5: idx = %5 * 4
        # Z3 chứng minh không có bất kỳ 2 nhân nào có lát cắt chồng lấn!
        %7 = const 2 bv64
        %8 = shl %5 %7
        %9 = slice %0 %8 ptr<DiskQword,4>
        %10 = const 0x4000000010 bv64
        spawn %1 %5 %10 %9 %2

        %11 = const 1 bv64
        %12 = add %5 %11
        jmp @b1 %12

    @b3
        ret
}

# =============================================================================
# 4. THU THẬP KẾT QUẢ TENSOR HASH TỪ TẤT CẢ CÁC CORE WORKER HIỆN CÓ
# =============================================================================
func simd_collect_workers_result bv64 %0:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        %1 = call smp_get_worker_count %0
        %2 = const 1 bv64
        %3 = const 0 bv64
        jmp @b1 %2 %3

    @b1 %4:bv64 %5:bv64
        @inv uge %4 1
        @inv ule %4 16
        %6 = cmp ule %4 %1
        br %6 @b2 @b3

    @b2
        %7 = call smp_get_worker_result %0 %4
        %8 = xor %5 %7

        %9 = const 1 bv64
        %10 = add %4 %9
        jmp @b1 %10 %8

    @b3
        ret %5
}

# =============================================================================
# 5. TIẾN TRÌNH CẬP NHẬT NHỊP BENCHMARK SIMD (Dùng `smp_poll_all_done` chứa lệnh `sync`)
# =============================================================================
func simd_step_benchmark bv64 %0:ptr<DiskQword,64> %1:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @ens ule %40 1

    @b0
        %2 = const 0 bv64
        %3 = const 1 bv64
        %4 = const 2 bv64
        %5 = call cap_state_get %0 %4
        %6 = const 108 bv64
        %7 = cmp eq %5 %6
        br %7 @b1 @b9

    @b1
        %8 = call smp_get_worker_count %1
        %9 = cmp eq %8 %2
        br %9 @b2 @b3

    @b2
        # Fallback nếu máy ảo chạy -smp 1 (0 AP): cắt lát Slot 4..7 và chạy trên Core 0
        %10 = call cap_state_get %0 %2
        %11 = const 99000000 bv64
        %12 = call std_min %10 %11
        %13 = const 4 bv64
        %14 = add %12 %13
        call cap_state_set %0 %2 %14

        %15 = slice %0 %13 ptr<DiskQword,4>
        %16 = call app_smp_worker %15 %2
        %17 = call cap_state_get %0 %3
        %18 = xor %17 %16
        call cap_state_set %0 %3 %18
        jmp @b10 %3

    @b3
        # Máy ảo nhiều Core (-smp N): Đồng bộ kiểm tra các nhân AP bằng chỉ thị `sync`
        %19 = call smp_poll_all_done %1
        %20 = cmp ne %19 %2
        br %20 @b4 @b9

    @b4
        # 1. Cộng số triệu phép toán SIMD hoàn thành trong nhịp này = worker_count * 4
        %21 = const 2 bv64
        %22 = shl %8 %21
        %23 = call cap_state_get %0 %2
        %24 = const 99000000 bv64
        %25 = call std_min %23 %24
        %26 = add %25 %22
        call cap_state_set %0 %2 %26

        # 2. Gom kết quả vdot256 + Q16.16 từ tất cả Worker Cores
        %27 = call simd_collect_workers_result %1
        %28 = call cap_state_get %0 %3
        %29 = xor %28 %27
        call cap_state_set %0 %3 %29

        # 3. Giao việc nhịp tiếp theo bằng chỉ thị `spawn` với Disjoint Slice!
        %30 = const 65536 bv64
        %31 = mul %26 %30
        %32 = const 33030144 bv64
        %33 = urem %31 %32
        call simd_async_dispatch_workers %0 %1 %33
        jmp @b10 %3

    @b9
        jmp @b10 %2

    @b10 %40:bv64
        @inv ule %40 1
        ret %40
}

# =============================================================================
# 6. HÀM CHÍNH CỦA APP SIMD AVX2 & AI TENSOR LAB (ZERO-FLICKER CANVAS UI)
#    - State[0]: Tổng số triệu phép toán SIMD 256-bit (SIMD OPS)
#    - State[1]: Kết quả tổng hợp vdot256 & Q16.16 (DOT/Q16)
#    - State[2]: Cờ trạng thái chạy (0 = STOP, 108 = RUNNING)
#    - State[4..63]: 15 lát cắt Disjoint Slice 256-bit (mỗi lát 4 Qwords) cho Core 1..15
# =============================================================================
func app_simd_ai_main void %0:ptr<VgaCell,921600> %1:ptr<IpcChannel,1> %2:ptr<DiskQword,64> %3:ptr<DiskQword,64> %4:ptr<DiskQword,64> %5:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x10000000000
    @req uge %3 0x10000
    @req ult %3 0x80000000
    @req uge %4 0x10000
    @req ult %4 0x80000000
    @req uge %5 0x10000
    @req ult %5 0x80000000

    @b0
        # Nếu đang ở chế độ chạy ngầm (active_app != 4): chỉ cập nhật nhịp SIMD!
        %13 = const 0 bv64
        %14 = const 1 bv64
        %102 = const 2 bv64
        %200 = load %1 56 bv64
        %201 = const 4 bv64
        %202 = cmp ne %200 %201
        br %202 @b50 @b51

    @b50
        %203 = call simd_step_benchmark %2 %5
        ret

    @b51
        %6 = call ipc_mouse_get_x %1
        %7 = call ipc_mouse_get_y %1
        %8 = call ipc_mouse_get_click %1

        %9 = const 200 bv64
        %10 = const 60 bv64
        %11 = const 880 bv64
        %12 = const 540 bv64

        %15 = load %1 112 bv64
        %16 = cmp eq %15 %13
        br %16 @b10 @b1

    @b1
        %17 = cmp ne %8 %13
        br %17 @b2 @b30

    @b2
        %18 = call ui_win_poll_close %1 %9 %10 %11
        %19 = cmp ne %18 %13
        br %19 @b3 @b4

    @b3
        ret

    @b4
        %20 = const 240 bv64
        %21 = const 115 bv64
        %22 = const 160 bv64
        %23 = const 34 bv64

        # Nút [STRESS] (Phát lệnh `spawn` đánh thức tất cả Worker APs cày AVX2 256-bit!)
        %24 = call ui_btn_hit %6 %7 %8 %20 %21 %22 %23
        %25 = cmp ne %24 %13
        br %25 @b7 @b8

    @b7
        %30 = const 108 bv64
        call cap_state_set %2 %13 %13
        call cap_state_set %2 %14 %13
        call cap_state_set %2 %102 %30
        call ipc_app_set_bg_running %1 %14
        call simd_async_dispatch_workers %2 %5 %13
        jmp @b25

    @b8
        # Nút [STOP]
        %31 = const 430 bv64
        %32 = const 110 bv64
        %33 = call ui_btn_hit %6 %7 %8 %31 %21 %32 %23
        %34 = cmp ne %33 %13
        br %34 @b9 @b30

    @b9
        call cap_state_set %2 %102 %13
        call ipc_app_set_bg_running %1 %13
        call smp_stop_all_workers %5
        jmp @b25

    @b30
        %35 = call cap_state_get %2 %102
        %45 = const 108 bv64
        %46 = cmp eq %35 %45
        br %46 @b33 @b99

    @b33
        # Chỉ vẽ lại vùng số liệu khi các Worker VỪA HOÀN THÀNH 1 NHỊP (%47 != 0) -> Siêu mượt 60 FPS!
        %47 = call simd_step_benchmark %2 %5
        %48 = cmp ne %47 %13
        br %48 @b25 @b99

    @b10
        store %1 112 %14
        %71 = const 0x5856412d444d4953 bv64 # "SIMD-AVX"
        %72 = const 0x0f172a bv32
        call ui_win_draw %0 %3 %9 %10 %11 %12 %71 %72

        %62 = const 240 bv64
        %63 = const 115 bv64
        %64 = const 160 bv64
        %65 = const 34 bv64
        %67 = const 0x059669 bv32           # Emerald button
        %68 = const 0xdc2626 bv32           # Red stop button
        %69 = const 0xffffff bv32
        %80 = const 8 bv64
        %810 = const 4 bv64

        %73 = const 0x444d4953204e5552 bv64 # "RUN SIMD"
        call ui_btn_draw_text %0 %3 %62 %63 %64 %65 %67 %69 %73 %80 %13

        %76 = const 430 bv64
        %77 = const 110 bv64
        %78 = const 0x20202020504f5453 bv64 # "STOP    "
        call ui_btn_draw_text %0 %3 %76 %63 %77 %65 %68 %69 %78 %810 %13

        %83 = const 30 bv64
        %84 = const 120 bv64
        %85 = const 820 bv64
        %86 = const 340 bv64
        %87 = const 0x1e293b bv32
        call canvas_fill_rect %0 %83 %84 %85 %86 %87

        %81 = const 1086 bv64
        %82 = const 606 bv64
        call ui_invalidate_rect %1 %9 %10 %81 %82
        jmp @b25

    @b25
        # Chỉ xóa và vẽ lại đúng phần chữ số & thanh Progress Bar (x: 65..575, y: 110..280)
        %210 = const 65 bv64
        %211 = const 110 bv64
        %212 = const 575 bv64
        %213 = const 280 bv64
        %214 = const 0x1e293b bv32
        call canvas_fill_rect %0 %210 %211 %212 %213 %214

        %90 = const 270 bv64
        %93 = const 0x94a3b8 bv32
        %95 = const 370 bv64
        %130 = const 175 bv64
        %131 = const 0x4d4d592032585641 bv64  # "AVX2 YMM"
        %134 = const 0x34d399 bv32
        call gfx_draw_str8 %0 %3 %90 %130 %131 %93

        %132 = call smp_get_worker_count %5
        %133 = call std_u64_to_str8 %132
        call gfx_draw_str8 %0 %3 %95 %130 %133 %134

        %88 = call cap_state_get %2 %13     # SIMD OPS
        %89 = call cap_state_get %2 %14     # DOT/Q16 RESULT

        %91 = const 210 bv64
        %92 = const 0x53504f20444d4953 bv64 # "SIMD OPS"
        call gfx_draw_str8 %0 %3 %90 %91 %92 %93

        %94 = call std_u64_to_str8 %88
        %96 = const 0x38bdf8 bv32
        call gfx_draw_str8 %0 %3 %95 %91 %94 %96

        %97 = const 255 bv64
        %98 = const 0x3a3631512f544f44 bv64 # "DOT/Q16:"
        call gfx_draw_str8 %0 %3 %90 %97 %98 %93

        %99 = call std_u64_to_str8 %89
        %100 = const 0xfbbf24 bv32
        call gfx_draw_str8 %0 %3 %95 %97 %99 %100

        # Thanh tiến độ Progress Bar: Tổng mục tiêu = max(1, worker_count) * 256
        %135 = call std_max %132 %14
        %136 = const 8 bv64
        %110 = shl %135 %136
        %111 = call std_min %88 %110
        %112 = const 500 bv64
        %113 = mul %111 %112
        %114 = udiv %113 %110
        %115 = call std_min %114 %112

        %116 = const 70 bv64
        %117 = add %116 %115
        %118 = const 245 bv64
        %119 = const 275 bv64
        %120 = const 0x10b981 bv32
        call canvas_fill_rect %0 %116 %118 %117 %119 %120

        call canvas_invalidate_rect %1 %210 %211 %212 %213
        ret

    @b99
        ret
}
