# File: lit_program/apps/desktop_app.lit
# Chương trình Ứng dụng Desktop: Vẽ giao diện & Nhận sự kiện bàn phím qua IpcChannel

include ../lib/gfx.lit
include ../drivers/kbd_drv.lit

layout HeapSlot 8 {
    0: bv64
}

# 1. Khởi tạo giao diện ban đầu ("LIGHT OS" + Dấu nhắc gõ phím "> ")
func app_desktop_init void %0:ptr<VgaCell,2000> %1:ptr<HeapSlot,8> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x80000000

    @b0
        %2 = const 0 bv64
        %3 = slice %1 %2 ptr<HeapSlot,1>
        %4 = const 2026 bv64
        store %3 0 %4

        # Tô nền Xanh Dương (0x1F)
        %5 = const 0x1f bv8
        call gfx_clear_screen %0 %5

        # Vẽ tiêu đề "LIGHT OS" màu Vàng (0x1E) tại dòng y = 8
        %6 = const 8 bv64
        %7 = const 0x1e bv8

        %8 = const 35 bv64
        %9 = const 76 bv8               # 'L'
        call gfx_draw_char_xy %0 %8 %6 %9 %7

        %10 = const 36 bv64
        %11 = const 73 bv8              # 'I'
        call gfx_draw_char_xy %0 %10 %6 %11 %7

        %12 = const 37 bv64
        %13 = const 71 bv8              # 'G'
        call gfx_draw_char_xy %0 %12 %6 %13 %7

        %14 = const 38 bv64
        %15 = const 72 bv8              # 'H'
        call gfx_draw_char_xy %0 %14 %6 %15 %7

        %16 = const 39 bv64
        %17 = const 84 bv8              # 'T'
        call gfx_draw_char_xy %0 %16 %6 %17 %7

        %18 = const 41 bv64
        %19 = const 79 bv8              # 'O'
        call gfx_draw_char_xy %0 %18 %6 %19 %7

        %20 = const 42 bv64
        %21 = const 83 bv8              # 'S'
        call gfx_draw_char_xy %0 %20 %6 %21 %7

        # Vẽ dấu nhắc nhập liệu "> " màu Xanh Lá sáng (0x1A) tại dòng y = 13, cột x = 23
        %22 = const 13 bv64
        %23 = const 23 bv64
        %24 = const 62 bv8              # '>'
        %25 = const 0x1a bv8
        call gfx_draw_char_xy %0 %23 %22 %24 %25

        ret
}

# 2. Tác vụ xử lý sự kiện IPC của App (Được Bộ lập lịch Kernel gọi liên tục)
func app_desktop_ipc_task void %0:ptr<VgaCell,2000> %1:ptr<IpcChannel,1> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x80000000

    @b0
        # Kiểm tra có thông điệp mới (has_msg != 0) trong IpcChannel không
        %2 = load %1 0 bv64
        %3 = const 0 bv64
        %4 = cmp ne %2 %3
        br %4 @b1 @b2

    @b1
        # Đọc ký tự ASCII từ offset 8 và tọa độ con trỏ chữ từ offset 16
        %5 = load %1 8 bv8
        %6 = load %1 16 bv64

        # Vẽ ký tự vừa gõ lên dòng y = 13, cột x = %6 (Màu Trắng sáng 0x1F)
        %7 = const 13 bv64
        %8 = const 0x1f bv8
        call gfx_draw_char_xy %0 %6 %7 %5 %8

        # Tăng vị trí con trỏ sang phải 1 cột (Nếu chạm cột 65 thì vòng về cột 25)
        %9 = const 1 bv64
        %10 = add %6 %9
        %11 = const 65 bv64
        %12 = cmp ult %10 %11
        br %12 @b3 @b4

    @b3
        store %1 16 %10                 # Cập nhật cursor_x = %10 (< 65 < 70)
        store %1 0 %3                   # Xoá cờ has_msg = 0
        jmp @b2

    @b4
        %13 = const 25 bv64
        store %1 16 %13                 # Reset cursor_x = 25
        store %1 0 %3                   # Xoá cờ has_msg = 0
        jmp @b2

    @b2
        ret
}
