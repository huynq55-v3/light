# File: lit_program/lib/gfx.lit
# Thư viện Đồ họa 2D. Hàm thường vẽ trong khung nhìn 1280x720 (ptr<VgaCell,1382400>, bước dòng 1920);
# hàm *_scr vẽ trên cả màn hình 1920x1080 (ptr<VgaCell,2073600>, chỉ kernel dùng).

include ../drivers/vga_drv.lit
include font.lit
include os_layout.lit

# 1. Chấm 1 điểm ảnh RGB tại tọa độ (x = %1, y = %2)
func gfx_put_pixel void %0:ptr<VgaCell,1382400> %1:bv64 %2:bv64 %3:bv32 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ult %1 1280
    @req ult %2 720

    @b0
        %4 = const 1920 bv64
        %5 = mul %2 %4
        %6 = add %5 %1
        call drv_vga_set_cell %0 %6 %3
        ret
}

func gfx_put_pixel_scr void %0:ptr<VgaCell,2073600> %1:bv64 %2:bv64 %3:bv32 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ult %1 1920
    @req ult %2 1080

    @b0
        %4 = const 1920 bv64
        %5 = mul %2 %4
        %6 = add %5 %1
        call drv_vga_set_cell_scr %0 %6 %3
        ret
}

# 2. Tô màu Hình chữ nhật đặc từ cột x1 (%1)..x2 (%3), dòng y1 (%2)..y2 (%4)
func gfx_fill_rect void %0:ptr<VgaCell,1382400> %1:bv64 %2:bv64 %3:bv64 %4:bv64 %5:bv32 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ule %1 1280
    @req ule %2 720
    @req ule %3 1280
    @req ule %4 720

    @b0
        jmp @b1 %2

    @b1 %6:bv64
        @inv ule %6 720
        %7 = cmp ult %6 %4
        br %7 @b2 @b6

    @b2
        jmp @b3 %1

    @b3 %8:bv64
        @inv ult %6 720
        @inv ule %8 1280
        %9 = cmp ult %8 %3
        br %9 @b4 @b5

    @b4
        call gfx_put_pixel %0 %8 %6 %5
        %10 = const 1 bv64
        %11 = add %8 %10
        jmp @b3 %11

    @b5
        %12 = const 1 bv64
        %13 = add %6 %12
        jmp @b1 %13

    @b6
        ret
}

func gfx_fill_rect_scr void %0:ptr<VgaCell,2073600> %1:bv64 %2:bv64 %3:bv64 %4:bv64 %5:bv32 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ule %1 1920
    @req ule %2 1080
    @req ule %3 1920
    @req ule %4 1080

    @b0
        jmp @b1 %2

    @b1 %6:bv64
        @inv ule %6 1080
        %7 = cmp ult %6 %4
        br %7 @b2 @b6

    @b2
        jmp @b3 %1

    @b3 %8:bv64
        @inv ult %6 1080
        @inv ule %8 1920
        %9 = cmp ult %8 %3
        br %9 @b4 @b5

    @b4
        call gfx_put_pixel_scr %0 %8 %6 %5
        %10 = const 1 bv64
        %11 = add %8 %10
        jmp @b3 %11

    @b5
        %12 = const 1 bv64
        %13 = add %6 %12
        jmp @b1 %13

    @b6
        ret
}

# Thay thế hàm gfx_draw_char16 trong lit_program/lib/gfx.lit:
# Vẽ 1 ký tự Font Roboto 8x16 độ phân giải thực (16 dòng dọc thực sự thay vì phóng đại 2x2 bị răng cưa)
func gfx_draw_char16 void %0:ptr<VgaCell,1382400> %1:ptr<DiskQword,64> %2:bv64 %3:bv64 %4:bv64 %5:bv32 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req ule %2 1260
    @req ule %3 700

    @b0
        %6 = call font_get_glyph_top %4
        %7 = call font_get_glyph_bot %4
        %8 = const 0 bv64
        jmp @b1 %8

    @b1 %9:bv64                             # %9: dòng y từ 0..15 (16 dòng dọc thật!)
        @inv ule %9 16
        %10 = const 16 bv64
        %11 = cmp ult %9 %10
        br %11 @b2 @b11

    @b2
        # Nếu y < 8 thì lấy từ %6 (top), nếu y >= 8 thì lấy từ %7 (bot)
        %12 = const 8 bv64
        %13 = cmp ult %9 %12
        br %13 @b3 @b4

    @b3
        jmp @b5 %6 %9

    @b4
        %14 = sub %9 %12
        jmp @b5 %7 %14

    @b5 %15:bv64 %16:bv64
        @inv ult %9 16
        @inv ult %16 8
        %17 = const 0 bv64
        jmp @b6 %17

    @b6 %18:bv64                            # %18: cột x từ 0..7
        @inv ult %9 16
        @inv ult %16 8
        @inv ule %18 8
        %19 = const 8 bv64
        %20 = cmp ult %18 %19
        br %20 @b7 @b10

    @b7
        %21 = const 3 bv64
        %22 = shl %16 %21
        %23 = add %22 %18
        %24 = lshr %15 %23
        %25 = const 1 bv64
        %26 = and %24 %25
        %27 = const 0 bv64
        %28 = cmp ne %26 %27
        br %28 @b8 @b9

    @b8
        # Vẽ đúng tỷ lệ 1:1 sắc nét (8x16 chuẩn, không kéo dãn ngang 2x!)
        %29 = const 1 bv64
        %31 = add %2 %18
        %32 = add %3 %9
        call gfx_put_pixel %0 %31 %32 %5
        jmp @b9

    @b9
        %34 = const 1 bv64
        %35 = add %18 %34
        jmp @b6 %35

    @b10
        %36 = const 1 bv64
        %37 = add %9 %36
        jmp @b1 %37

    @b11
        ret
}

# 5. In chuỗi 8 ký tự (nén trong 1 Qword) bằng Font 8x16 (mỗi ký tự cách nhau 9px)
func gfx_draw_str8 void %0:ptr<VgaCell,1382400> %1:ptr<DiskQword,64> %2:bv64 %3:bv64 %4:bv64 %5:bv32 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req ule %2 1100
    @req ule %3 700

    @b0
        %6 = const 0 bv64
        jmp @b1 %6

    @b1 %7:bv64
        @inv ule %7 8
        %8 = const 8 bv64
        %9 = cmp ult %7 %8
        br %9 @b2 @b3

    @b2
        %10 = const 3 bv64
        %11 = shl %7 %10
        %12 = lshr %4 %11
        %13 = const 0xff bv64
        %14 = and %12 %13
        %15 = const 9 bv64                  # <-- Mỗi chữ cách nhau 9px
        %16 = mul %7 %15                    # <-- Đổi từ shl sang mul (offset_x = i * 9)
        %17 = add %2 %16
        call gfx_draw_char16 %0 %1 %17 %3 %14 %5
        %18 = const 1 bv64
        %19 = add %7 %18
        jmp @b1 %19

    @b3
        ret
}

# API Tổng quát: Đăng ký cập nhật 1 vùng hình chữ nhật (x1=%1, y1=%2, x2=%3, y2=%4) lên màn hình
func ui_invalidate_rect void %0:ptr<IpcChannel,1> %1:bv64 %2:bv64 %3:bv64 %4:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ule %1 1280
    @req ule %2 720
    @req ule %3 1280
    @req ule %4 720

    @b0
        %5 = load %0 80 bv64
        %6 = const 0 bv64
        %7 = cmp eq %5 %6
        br %7 @b1 @b2

    @b1
        # Nếu chưa có vùng bẩn nào trong frame này -> Gán trực tiếp (x1, y1, x2, y2)
        %8 = const 1 bv64
        store %0 80 %8
        store %0 120 %1
        store %0 128 %2
        store %0 136 %3
        store %0 144 %4
        ret

    @b2
        # Nếu đã có vùng bẩn -> Tự động gộp khung bao (Union: min(x1), min(y1), max(x2), max(y2))
        %9 = load %0 120 bv64
        %10 = cmp ult %1 %9
        br %10 @b3 @b4

    @b3
        store %0 120 %1
        jmp @b4

    @b4
        %11 = load %0 128 bv64
        %12 = cmp ult %2 %11
        br %12 @b5 @b6

    @b5
        store %0 128 %2
        jmp @b6

    @b6
        %13 = load %0 136 bv64
        %14 = cmp ugt %3 %13
        br %14 @b7 @b8

    @b7
        store %0 136 %3
        jmp @b8

    @b8
        %15 = load %0 144 bv64
        %16 = cmp ugt %4 %15
        br %16 @b9 @b10

    @b9
        store %0 144 %4
        jmp @b10

    @b10
        ret
}

# Chép đúng hình chữ nhật (x1=%2, y1=%3, x2=%4, y2=%5, tọa độ màn hình 1920x1080) từ Backbuffer (%1) ra VRAM (%0)
func gfx_blit_rect void %0:ptr<VgaCell,2073600> %1:ptr<VgaCell,2073600> %2:bv64 %3:bv64 %4:bv64 %5:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req ule %2 1920
    @req ule %3 1080
    @req ule %4 1920
    @req ule %5 1080

    @b0
        jmp @b1 %3

    @b1 %6:bv64
        @inv ule %6 1080
        %7 = cmp ult %6 %5
        br %7 @b2 @b6

    @b2
        jmp @b3 %2

    @b3 %8:bv64
        @inv ult %6 1080
        @inv ule %8 1920
        %9 = cmp ult %8 %4
        br %9 @b4 @b5

    @b4
        %10 = const 1920 bv64
        %11 = mul %6 %10
        %12 = add %11 %8
        %13 = call drv_vga_get_cell_scr %1 %12
        call drv_vga_set_cell_scr %0 %12 %13
        %14 = const 1 bv64
        %15 = add %8 %14
        jmp @b3 %15

    @b5
        %16 = const 1 bv64
        %17 = add %6 %16
        jmp @b1 %17

    @b6
        ret
}
