# File: lit_program/lib/ipc_bus.lit
# THƯ VIỆN GIAO TIẾP LIÊN TIẾN TRÌNH ZERO-COPY (VERIFIED IPC BUS LIBRARY)

include os_layout.lit
include std_ring.lit

func ipc_key_push void %0:ptr<IpcChannel,1> %1:bv8 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ult %1 128

    @b0
        %2 = const 1 bv64
        store %0 8 %1
        store %0 0 %2
        ret
}

func ipc_key_pop bv8 %0:ptr<IpcChannel,1> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @ens ult %7 128

    @b0
        %1 = load %0 0 bv64
        %2 = const 0 bv64
        %3 = cmp ne %1 %2
        br %3 @b1 @b2

    @b1
        store %0 0 %2
        %4 = load %0 8 bv8
        jmp @b3 %4

    @b2
        %5 = const 0 bv8
        jmp @b3 %5

    @b3 %7:bv8
        @inv ult %7 128
        ret %7
}

