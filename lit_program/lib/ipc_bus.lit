# Khởi tạo toàn bộ Hộp thư Giao tiếp IpcChannel về trạng thái chuẩn lúc Boot
func ipc_channel_init void %0:ptr<IpcChannel,1> {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        %1 = const 0 bv64
        %2 = const 0 bv8
        %3 = const 640 bv64                 # Tâm màn hình X = 640
        %4 = const 360 bv64                 # Tâm màn hình Y = 360

        store %0 0 %1
        store %0 8 %2
        store %0 16 %3
        store %0 24 %4
        store %0 32 %1
        store %0 40 %1
        store %0 48 %1
        store %0 56 %1
        store %0 64 %3
        store %0 72 %4
        store %0 80 %1
        store %0 88 %1
        store %0 96 %1
        store %0 104 %1
        store %0 112 %1
        store %0 120 %1
        store %0 128 %1
        store %0 136 %1
        store %0 144 %1
        store %0 152 %1
        store %0 160 %1
        ret
}

# Gửi tín hiệu yêu cầu Shell đóng và Reset App hiện tại (offset 88 = 1)
func ipc_win_request_close void %0:ptr<IpcChannel,1> {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        %1 = const 1 bv64
        store %0 88 %1
        ret
}

# Shell đọc và xóa tín hiệu đóng App (trả về 1 nếu App vừa bấm [X])
func ipc_win_take_close_req bv64 %0:ptr<IpcChannel,1> {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        %1 = load %0 88 bv64
        %2 = const 0 bv64
        store %0 88 %2
        ret %1
}

# App bật/tắt chế độ chạy nền (Background Task) trên Bitmask (offset 152) theo đúng active_app hiện tại
func ipc_app_set_bg_running void %0:ptr<IpcChannel,1> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        %2 = load %0 56 bv64                # active_app (1..7)
        %3 = const 1 bv64
        %4 = cmp uge %2 %3
        %5 = const 7 bv64
        %6 = cmp ule %2 %5
        %7 = and %4 %6
        br %7 @b1 @b4

    @b1
        %8 = sub %2 %3                      # slot = active_app - 1 (0..6)
        %9 = shl %3 %8                      # bit_mask = (1 << slot)
        %10 = load %0 152 bv64
        %11 = const 0 bv64
        %12 = cmp ne %1 %11
        br %12 @b2 @b3

    @b2
        %13 = or %10 %9
        store %0 152 %13
        ret

    @b3
        %14 = const 0xffffffffffffffff bv64
        %15 = xor %9 %14
        %16 = and %10 %15
        store %0 152 %16
        ret

    @b4
        ret
}

# Doc %2 Sectors tu LBA %1 nap thang vao bien Buffer tai Qword %3 cua Arena (dst_sec_off = dst_qword_off >> 6)
# Dong goi vao offset 96 (56-bit): [dst_sec_off (bit 40..55) | num_sectors (bit 24..39) | lba (bit 0..23)]
func ipc_disk_read_into void %0:ptr<IpcChannel,1> %1:bv64 %2:bv64 %3:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        %4 = const 0xffffff bv64
        %5 = and %1 %4                      # bits 0..23: start_lba
        %6 = const 0xffff bv64
        %7 = and %2 %6                      # bits 24..39: num_sectors (0..65535)
        %8 = const 24 bv64
        %9 = shl %7 %8

        %10 = const 6 bv64
        %11 = lshr %3 %10                   # dst_sec_off = dst_qword_off / 64
        %13 = and %11 %6                    # bits 40..55: dst_sec_off (0..65535)
        %14 = const 40 bv64
        %15 = shl %13 %14

        %16 = or %5 %9
        %17 = or %16 %15
        store %0 96 %17
        ret
}

# Xin tong cong %1 Chunk 2MB cho App hien tai (toi da 16383 = 16GB)
func ipc_chunk_req_post void %0:ptr<IpcChannel,1> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        %2 = load %0 168 bv64
        %3 = const 16383 bv64
        %4 = call std_min %1 %3
        %5 = call std_max %2 %4
        store %0 168 %5
        ret
}

# Dat truc tiep so Chunk 2MB mong muon (1..16383) vao IpcChannel.chunk_req
func ipc_chunk_req_set void %0:ptr<IpcChannel,1> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        %2 = const 1 bv64
        %3 = const 16383 bv64
        %4 = call std_clamp %1 %2 %3
        store %0 168 %4
        ret
}

# Lay so Chunk 2MB hien da duoc Kernel cap cho App (doc tu offset 176, bits 0..15: 1..16383)
func ipc_chunk_state_granted bv64 %0:ptr<IpcChannel,1> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @ens uge %6 1
    @ens ule %6 16383

    @b0
        %1 = load %0 176 bv64
        %2 = const 0xffff bv64
        %3 = and %1 %2
        %4 = const 1 bv64
        %5 = const 16383 bv64
        %6 = call std_clamp %3 %4 %5
        ret %6
}

# Lay so khung RAM 2MB con trong trong be chung cua Kernel (doc tu offset 176, bits 16..31: 0..16384)
func ipc_chunk_state_free bv64 %0:ptr<IpcChannel,1> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @ens ule %7 16384

    @b0
        %1 = load %0 176 bv64
        %2 = const 16 bv64
        %3 = lshr %1 %2
        %4 = const 0xffff bv64
        %5 = and %3 %4
        %6 = const 16384 bv64
        %7 = call std_min %5 %6
        ret %7
}


# Đọc "rộng" (cần Chunk đích đã cấp sẵn): %1 = LBA (< 2^26), %2 = số đơn vị (1..4095), %3 = Qword đích (bội của 512 = 4KB; tới 4.29e9),
# %4 = fine (1: mỗi đơn vị 8 sector = 4KB, tối đa 16MB; 0: mỗi đơn vị 128 sector = 64KB, tối đa 256MB)
# Đóng gói: [1<<63 | fine<<61 | dst_units (bit 38..60) | n_units (bit 26..37) | lba (bit 0..25)]
func ipc_disk_read_wide void %0:ptr<IpcChannel,1> %1:bv64 %2:bv64 %3:bv64 %4:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        %5 = const 0x3ffffff bv64
        %6 = and %1 %5
        %7 = const 0xfff bv64
        %8 = and %2 %7
        %9 = const 26 bv64
        %10 = shl %8 %9
        %11 = const 9 bv64
        %12 = lshr %3 %11
        %13 = const 0x7fffff bv64
        %14 = and %12 %13
        %15 = const 38 bv64
        %16 = shl %14 %15
        %17 = or %6 %10
        %18 = or %17 %16
        %19 = const 1 bv64
        %20 = and %4 %19
        %21 = const 61 bv64
        %22 = shl %20 %21
        %23 = or %18 %22
        %24 = const 63 bv64
        %25 = shl %19 %24
        %26 = or %23 %25
        store %0 96 %26
        ret
}

# Yêu cầu Kernel ánh xạ mô hình nạp sẵn (QEMU pc-dimm tại 0x400000000) vào Arena từ Chunk %1 (15..16000)
func ipc_model_map void %0:ptr<IpcChannel,1> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        %2 = const 0xffff bv64
        %3 = and %1 %2
        %4 = const 1 bv64
        %5 = const 62 bv64
        %6 = shl %4 %5
        %7 = const 63 bv64
        %8 = shl %4 %7
        %9 = or %6 %8
        %10 = or %9 %3
        store %0 96 %10
        ret
}
