# File: lit_program/lib/ipc_bus.lit
# THƯ VIỆN GIAO TIẾP LIÊN TIẾN TRÌNH ZERO-COPY (VERIFIED IPC BUS LIBRARY)

include os_layout.lit

func ipc_key_push void %0:ptr<IpcChannel,1> %1:bv8 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ult %1 128

    @b0
        %2 = const 1 bv64
        store %0 8 %1
        store %0 0 %2
        ret
}

func ipc_key_pop bv8 %0:ptr<IpcChannel,1> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @ens ult %7 128

    @b0
        %1 = load %0 0 bv64
        %2 = const 0 bv64
        %3 = cmp ne %1 %2
        br %3 @b1 @b2

    @b1
        store %0 0 %2
        %4 = load %0 8 bv8
        jmp @b3 %4

    @b2
        %5 = const 0 bv8
        jmp @b3 %5

    @b3 %7:bv8
        @inv ult %7 128
        ret %7
}

func ipc_mouse_get_x bv64 %0:ptr<IpcChannel,1> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @ens ult %1 1260

    @b0
        %1 = load %0 16 bv64
        ret %1
}

func ipc_mouse_get_y bv64 %0:ptr<IpcChannel,1> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @ens ult %1 700

    @b0
        %1 = load %0 24 bv64
        ret %1
}

func ipc_mouse_get_click bv64 %0:ptr<IpcChannel,1> {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        %1 = load %0 32 bv64
        ret %1
}

func ipc_mouse_clear_click void %0:ptr<IpcChannel,1> {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        %1 = const 0 bv64
        store %0 32 %1
        ret
}

# Khởi tạo toàn bộ Hộp thư Giao tiếp IpcChannel về trạng thái chuẩn lúc Boot
func ipc_channel_init void %0:ptr<IpcChannel,1> {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        %1 = const 0 bv64
        %2 = const 0 bv8
        %3 = const 640 bv64                 # chuột trong khung nhìn App = (960 - 320, 540 - 160)
        %4 = const 380 bv64
        %5 = const 960 bv64                 # tâm màn hình 1920x1080
        %6 = const 540 bv64

        store %0 0 %1
        store %0 8 %2
        store %0 16 %3
        store %0 24 %4
        store %0 32 %1
        store %0 40 %1
        store %0 48 %1
        store %0 56 %1
        store %0 64 %5
        store %0 72 %6
        store %0 80 %1
        store %0 88 %1
        store %0 96 %1
        store %0 104 %1
        store %0 112 %1
        store %0 120 %1
        store %0 128 %1
        store %0 136 %1
        store %0 144 %1
        store %0 152 %1
        store %0 160 %1
        store %0 168 %1
        store %0 176 %1
        store %0 184 %5
        store %0 192 %6
        store %0 IpcChannel.title 0
        store %0 IpcChannel.decor 0
        store %0 IpcChannel.cfg_w 0
        store %0 IpcChannel.cfg_h 0
        store %0 IpcChannel.win_w 0
        store %0 IpcChannel.win_h 0
        store %0 IpcChannel.configure 0
        ret
}

# Shell đọc và xóa tín hiệu đóng App (trả về 1 nếu App vừa bấm [X])
func ipc_win_take_close_req bv64 %0:ptr<IpcChannel,1> {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        %1 = load %0 88 bv64
        %2 = const 0 bv64
        store %0 88 %2
        ret %1
}

