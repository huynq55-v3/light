# File: lit_program/lib/std_ring.lit
# THƯ VIỆN HÀNG ĐỢI VÒNG FIFO 32 PHẦN TỬ KIỂM CHỨNG Z3 (VERIFIED RING BUFFER)
# Thiết kế trên lát cắt 64-byte (`ptr<DiskQword,8>`):
#   - Qword 0: head (chỉ số đọc tiếp theo, luôn thuộc 0..31)
#   - Qword 1: tail (chỉ số ghi tiếp theo, luôn thuộc 0..31)
#   - Qwords 2..5 (32 bytes = 4 Qwords): Mảng vòng 32 sự kiện (mỗi phần tử 1 byte)
#   - Qwords 6..7: Dự phòng / Thống kê số lượng sự kiện (dropped_count)

include os_layout.lit
include std_lib.lit

# 1. Khởi tạo Hàng đợi vòng 64-byte về trạng thái rỗng
func ring_init void %0:ptr<DiskQword,8> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000

    @b0
        %1 = const 0 bv64
        jmp @b1 %1

    @b1 %2:bv64
        @inv ule %2 8
        %3 = const 8 bv64
        %4 = cmp ult %2 %3
        br %4 @b2 @b3

    @b2
        %5 = slice %0 %2 ptr<DiskQword,1>
        %6 = const 0 bv64
        store %5 0 %6
        %7 = const 1 bv64
        %8 = add %2 %7
        jmp @b1 %8

    @b3
        ret
}

# 2. Kiểm tra số lượng phần tử hiện có trong Ring Buffer (0..31)
func ring_count bv64 %0:ptr<DiskQword,8> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @ens ult %13 32

    @b0
        %1 = const 0 bv64
        %2 = slice %0 %1 ptr<DiskQword,1>
        %3 = load %2 0 bv64                 # raw_head

        %4 = const 1 bv64
        %5 = slice %0 %4 ptr<DiskQword,1>
        %6 = load %5 0 bv64                 # raw_tail

        %7 = const 31 bv64
        %8 = and %3 %7                      # head in 0..31
        %9 = and %6 %7                      # tail in 0..31
        %10 = const 32 bv64
        %11 = add %9 %10                    # tail + 32 (32..63 >= head)
        %12 = sub %11 %8                    # (tail + 32) - head (1..63, không bao giờ underflow!)
        %13 = and %12 %7                    # ((tail + 32) - head) & 31 (< 32)
        ret %13
}

# 3. Đẩy 1 byte (%1 = 0..255) vào cuối hàng đợi (Trả về 1 nếu thành công, 0 nếu đầy)
func ring_push_byte bv64 %0:ptr<DiskQword,8> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req ult %1 256
    @ens ule %99 1

    @b0
        %2 = const 0 bv64
        %3 = slice %0 %2 ptr<DiskQword,1>
        %4 = load %3 0 bv64
        %5 = const 31 bv64
        %6 = and %4 %5                      # head = raw_head & 31 (0..31)

        %7 = const 1 bv64
        %8 = slice %0 %7 ptr<DiskQword,1>
        %9 = load %8 0 bv64
        %10 = and %9 %5                     # tail = raw_tail & 31 (0..31)

        %11 = add %10 %7
        %12 = and %11 %5                    # next_tail = (tail + 1) & 31 (0..31)
        %13 = cmp eq %12 %6
        br %13 @b1 @b2

    @b1
        # Hàng đợi đã đầy (next_tail == head)
        jmp @b3 %2

    @b2
        # Tính Qword lưu trữ: qword_idx = 2 + (tail >> 3) -> thuộc đoạn [2..5] (< 8)
        %14 = const 3 bv64
        %15 = lshr %10 %14                  # 0..3
        %16 = const 2 bv64
        %17 = add %16 %15                   # qword_idx in 2..5
        %18 = slice %0 %17 ptr<DiskQword,1>

        # Tính byte_offset trong Qword: (tail & 7) -> thuộc đoạn [0..7]
        %19 = const 7 bv64
        %20 = and %10 %19
        call std_qword_set_byte %18 %20 %1

        # Cập nhật tail = next_tail
        store %8 0 %12
        jmp @b3 %7

    @b3 %99:bv64
        @inv ule %99 1
        ret %99
}

# 4. Lấy 1 byte ra khỏi đầu hàng đợi (Trả về 0..255, hoặc 0 nếu hàng đợi rỗng)
func ring_pop_byte bv64 %0:ptr<DiskQword,8> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @ens ult %99 256

    @b0
        %1 = const 0 bv64
        %2 = slice %0 %1 ptr<DiskQword,1>
        %3 = load %2 0 bv64
        %4 = const 31 bv64
        %5 = and %3 %4                      # head = raw_head & 31 (0..31)

        %6 = const 1 bv64
        %7 = slice %0 %6 ptr<DiskQword,1>
        %8 = load %7 0 bv64
        %9 = and %8 %4                      # tail = raw_tail & 31 (0..31)

        %10 = cmp eq %5 %9
        br %10 @b1 @b2

    @b1
        # Hàng đợi rỗng (head == tail)
        jmp @b3 %1

    @b2
        # Đọc byte tại head: qword_idx = 2 + (head >> 3) thuộc [2..5]
        %11 = const 3 bv64
        %12 = lshr %5 %11                   # 0..3
        %13 = const 2 bv64
        %14 = add %13 %12                   # qword_idx in 2..5
        %15 = slice %0 %14 ptr<DiskQword,1>

        %16 = const 7 bv64
        %17 = and %5 %16                    # byte_idx in 0..7
        %18 = call std_qword_get_byte %15 %17

        # Cập nhật head = (head + 1) & 31
        %19 = add %5 %6
        %20 = and %19 %4
        store %2 0 %20
        jmp @b3 %18

    @b3 %99:bv64
        @inv ult %99 256
        ret %99
}
