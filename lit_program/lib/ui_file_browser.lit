# File: lit_program/lib/ui_file_browser.lit
# Thư viện LightGUI: duyệt thư mục LightFS theo id (bảng file do Kernel chép vào State của App, xem lightfs_api.lit)
# Dòng thứ r (tối đa 9) nằm ở y = start_y + 48 + r * 38; nút [<.. BACK] ở dòng đầu khi không phải thư mục gốc.

include ui_button.lit
include std_lib.lit
include lightfs_api.lit

def UI_FB_ROWS 9

# Vẽ tên của mục %3 (tối đa 24 ký tự đầu) tại (%4, %5)
func ui_fb_draw_name void %0:ptr<VgaCell,1382400> %1:ptr<DiskQword,64> %2:ptr<DiskQword,4096> %3:bv64 %4:bv64 %5:bv64 %6:bv32 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x10000000000
    @req ult %3 256
    @req ule %4 900
    @req ule %5 700

    @b0
        %7 = const 8 bv64
        %8 = call lfs_tget %2 %3 %7
        call gfx_draw_str8 %0 %1 %4 %5 %8 %6
        %9 = const 9 bv64
        %10 = call lfs_tget %2 %3 %9
        %11 = const 72 bv64
        %12 = add %4 %11
        call gfx_draw_str8 %0 %1 %12 %5 %10 %6
        %13 = const 10 bv64
        %14 = call lfs_tget %2 %3 %13
        %15 = const 144 bv64
        %16 = add %4 %15
        call gfx_draw_str8 %0 %1 %16 %5 %14 %6
        ret
}

# Hiển thị các mục con của thư mục %5
func ui_fb_render void %0:ptr<VgaCell,1382400> %1:ptr<DiskQword,64> %2:ptr<DiskQword,4096> %3:bv64 %4:bv64 %5:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x10000000000
    @req uge %3 40
    @req ule %3 360
    @req uge %4 30
    @req ule %4 300
    @req ult %5 256

    @b0
        %6 = const 0 bv64
        %7 = const 1 bv64
        %8 = cmp ne %5 %6
        br %8 @b1 @b2

    @b1
        %9 = const 24 bv64
        %10 = add %3 %9
        %11 = const 10 bv64
        %12 = add %4 %11
        %13 = const 180 bv64
        %14 = add %3 %13
        %15 = const 38 bv64
        %16 = add %4 %15
        %17 = const 0x334155 bv32
        call gfx_fill_rect %0 %10 %12 %14 %16 %17
        %18 = const 32 bv64
        %19 = add %3 %18
        %20 = const 16 bv64
        %21 = add %4 %20
        %22 = const 0x4b434142202e2e3c bv64 # "<.. BACK"
        %23 = const 0xf8fafc bv32
        call gfx_draw_str8 %0 %1 %19 %21 %22 %23
        # Tên thư mục đang mở bên cạnh nút BACK
        %24 = const 200 bv64
        %25 = add %3 %24
        %26 = const 0x94a3b8 bv32
        call ui_fb_draw_name %0 %1 %2 %5 %25 %21 %26
        jmp @b2

    @b2
        jmp @b3 %6

    @b3 %27:bv64
        @inv ule %27 UI_FB_ROWS
        %28 = const UI_FB_ROWS bv64
        %29 = cmp ult %27 %28
        br %29 @b4 @b9

    @b4
        %30 = call lfs_nth_child %2 %5 %27
        %31 = cmp eq %30 %6
        br %31 @b9 @b5

    @b5
        %32 = const 38 bv64
        %33 = mul %27 %32
        %34 = const 48 bv64
        %35 = add %4 %34
        %36 = add %35 %33                   # y dòng
        %37 = const 30 bv64
        %38 = add %36 %37
        %39 = const 24 bv64
        %40 = add %3 %39
        %41 = const 520 bv64
        %42 = add %3 %41
        %43 = const 0x1e293b bv32
        call gfx_fill_rect %0 %40 %36 %42 %38 %43
        %44 = const 36 bv64
        %45 = add %3 %44
        %46 = const 7 bv64
        %47 = add %36 %46
        %48 = call lfs_is_dir %2 %30
        %49 = cmp ne %48 %6
        br %49 @b6 @b7

    @b6
        %50 = const 0xfbbf24 bv32           # thư mục: vàng amber
        call ui_fb_draw_name %0 %1 %2 %30 %45 %47 %50
        jmp @b8

    @b7
        %51 = const 0x38bdf8 bv32           # file: xanh cyan
        call ui_fb_draw_name %0 %1 %2 %30 %45 %47 %51
        jmp @b8

    @b8
        %52 = add %27 %7
        jmp @b3 %52

    @b9
        ret
}

# Bắt click trong Browser đang hiển thị thư mục %6:
#   [<.. BACK] -> (1 << 32) | thư mục cha    thư mục -> (2 << 32) | id    file -> (3 << 32) | id    trượt -> 0
func ui_fb_handle_click bv64 %0:ptr<DiskQword,4096> %1:bv64 %2:bv64 %3:bv64 %4:bv64 %5:bv64 %6:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req uge %4 40
    @req ule %4 360
    @req uge %5 30
    @req ule %5 300
    @req ult %6 256
    @req ule %1 1280
    @req ule %2 720

    @b0
        %7 = const 0 bv64
        %8 = const 1 bv64
        %9 = const 32 bv64
        %10 = cmp eq %3 %7
        br %10 @b90 @b1

    @b1
        %11 = cmp ne %6 %7
        br %11 @b2 @b3

    @b2
        %12 = const 24 bv64
        %13 = add %4 %12
        %14 = const 10 bv64
        %15 = add %5 %14
        %16 = const 156 bv64
        %17 = const 28 bv64
        %18 = call ui_btn_hit %1 %2 %3 %13 %15 %16 %17
        %19 = cmp ne %18 %7
        br %19 @b21 @b3

    @b21
        %20 = call lfs_parent %0 %6
        %21 = shl %8 %9
        %22 = or %21 %20
        ret %22

    @b3
        # Dòng được click: (my - start_y - 48) / 38, phải nằm trong 30px đầu của dòng
        %23 = const 48 bv64
        %24 = add %5 %23
        %25 = const 24 bv64
        %26 = add %4 %25
        %27 = const 520 bv64
        %28 = add %4 %27
        %29 = cmp uge %2 %24
        %30 = cmp uge %1 %26
        %31 = cmp ult %1 %28
        %32 = and %29 %30
        %33 = and %32 %31
        br %33 @b4 @b90

    @b4
        %34 = sub %2 %24
        %35 = const 38 bv64
        %36 = udiv %34 %35
        %37 = urem %34 %35
        %38 = const 30 bv64
        %39 = cmp ult %37 %38
        %40 = const UI_FB_ROWS bv64
        %41 = cmp ult %36 %40
        %42 = and %39 %41
        br %42 @b5 @b90

    @b5
        %43 = call lfs_nth_child %0 %6 %36
        %44 = cmp eq %43 %7
        br %44 @b90 @b6

    @b6
        %45 = call lfs_is_dir %0 %43
        %46 = cmp ne %45 %7
        br %46 @b7 @b8

    @b7
        %47 = const 2 bv64
        %48 = shl %47 %9
        %49 = or %48 %43
        ret %49

    @b8
        %50 = const 3 bv64
        %51 = shl %50 %9
        %52 = or %51 %43
        ret %52

    @b90
        ret %7
}
