# File: lit_program/lib/smp.lit
# THƯ VIỆN ĐA NHÂN ĐỐI XỨNG KIỂM CHỨNG HÌNH THỨC (Z3-VERIFIED DISJOINT SLICE SMP LIBRARY)
# Sử dụng trực tiếp chỉ thị `spawn` và `sync` với chứng minh tách biệt vùng nhớ Disjoint Slice

include os_layout.lit
include std_lib.lit

# 1. Lấy số lượng nhân Worker AP thực tế đã khởi chạy (Tổng số Core - 1 Core điều phối)
#    Hỗ trợ linh hoạt từ 0 đến 15 nhân Worker (tương ứng -smp 1 đến -smp 16)
func smp_get_worker_count bv64 %0:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @ens ule %5 15

    @b0
        %1 = const 0 bv64
        %2 = slice %0 %1 ptr<DiskQword,1>
        %3 = load %2 0 bv64
        %4 = const 15 bv64
        %5 = call std_min %3 %4
        ret %5
}

# Giữ lại smp_get_ap_count tương thích ngược
func smp_get_ap_count bv64 %0:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @ens ule %1 15

    @b0
        %1 = call smp_get_worker_count %0
        ret %1
}

# 1b. Lấy địa chỉ hàm `app_smp_worker` của App đang chạy (được Kernel ghi sẵn tại `0x7e000[2]`)
func smp_get_app_worker_fn bv64 %0:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        %1 = const 2 bv64
        %2 = slice %0 %1 ptr<DiskQword,1>
        %3 = load %2 0 bv64
        ret %3
}

# 2. Kiểm tra Nhân Worker thứ %1 (1..15) đã hoàn thành công việc chưa bằng chỉ thị `sync`
func smp_is_worker_done bv64 %0:ptr<DiskQword,64> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 1
    @req ule %1 15
    @ens ule %2 1

    @b0
        %2 = sync %0 %1
        ret %2
}

# 2b. Chờ Nhân Worker thứ %1 (1..15) hoàn thành công việc (Spin-wait bounded 10.000.000 chu kỳ)
func smp_wait_worker void %0:ptr<DiskQword,64> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 1
    @req ule %1 15

    @b0
        %2 = const 0 bv64
        jmp @b1 %2

    @b1 %3:bv64
        @inv ule %3 10000000
        %4 = const 10000000 bv64
        %5 = cmp ult %3 %4
        br %5 @b2 @b4

    @b2
        %6 = sync %0 %1
        %7 = cmp ne %6 %2
        br %7 @b4 @b3

    @b3
        %8 = const 1 bv64
        %9 = add %3 %8
        jmp @b1 %9

    @b4
        ret
}

# 3. Đọc kết quả trả về (64-bit) của Nhân Worker thứ %1 (1..15)
func smp_get_worker_result bv64 %0:ptr<DiskQword,64> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 1
    @req ule %1 15

    @b0
        %2 = const 2 bv64
        %3 = shl %1 %2
        %4 = const 3 bv64
        %5 = add %3 %4
        %6 = slice %0 %5 ptr<DiskQword,1>
        %7 = load %6 0 bv64
        ret %7
}

# 4. Đồng bộ kiểm tra TẤT CẢ các Nhân Worker hiện có (1..worker_count) bằng chỉ thị `sync`
func smp_poll_all_done bv64 %0:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @ens ule %10 1

    @b0
        %1 = call smp_get_worker_count %0
        %2 = const 0 bv64
        %3 = cmp eq %1 %2
        br %3 @b5 @b7

    @b7
        %4 = const 1 bv64
        jmp @b1 %4

    @b1 %5:bv64
        @inv uge %5 1
        @inv ule %5 16
        %6 = cmp ule %5 %1
        br %6 @b2 @b4

    @b2
        %7 = sync %0 %5
        %8 = cmp eq %7 %2
        br %8 @b8 @b3

    @b3
        %9 = const 1 bv64
        %11 = add %5 %9
        jmp @b1 %11

    @b4
        %12 = const 1 bv64
        jmp @b6 %12

    @b8
        %13 = const 0 bv64
        jmp @b6 %13

    @b5
        %14 = const 1 bv64
        jmp @b6 %14

    @b6 %10:bv64
        @inv ule %10 1
        ret %10
}

# 5. Dừng và xóa sạch trạng thái của tất cả các Nhân Worker bằng chỉ thị `spawn` (fn_addr = 0)
func smp_stop_all_workers void %0:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        %1 = call smp_get_worker_count %0
        %2 = const 1 bv64
        jmp @b1 %2

    @b1 %3:bv64
        @inv uge %3 1
        @inv ule %3 16
        %4 = cmp ule %3 %1
        br %4 @b2 @b3

    @b2
        %5 = const 0 bv64
        %6 = const 2 bv64
        %7 = shl %3 %6
        %8 = slice %0 %7 ptr<DiskQword,4>
        spawn %0 %3 %5 %8 %5

        %9 = const 1 bv64
        %10 = add %3 %9
        jmp @b1 %10

    @b3
        ret
}
