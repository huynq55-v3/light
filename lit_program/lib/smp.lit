# File: lit_program/lib/smp.lit
# THƯ VIỆN ĐA NHÂN ĐỐI XỨNG TỔNG QUÁT (GENERIC DYNAMIC SMP LIBRARY)
# Tự động nhận diện số nhân CPU thực tế từ phần cứng (QEMU -smp N), hoàn toàn độc lập với App

include os_layout.lit
include std_lib.lit

# 1. Lấy số lượng nhân Worker AP thực tế đã khởi chạy (Tổng số Core - 1 Core điều phối)
#    Hỗ trợ linh hoạt từ 0 đến 15 nhân Worker (tương ứng -smp 1 đến -smp 16)
func smp_get_worker_count bv64 %0:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @ens ule %5 15

    @b0
        %1 = const 0 bv64
        %2 = slice %0 %1 ptr<DiskQword,1>
        %3 = load %2 0 bv64
        %4 = const 15 bv64
        %5 = call std_min %3 %4
        ret %5
}

# Giữ lại smp_get_ap_count tương thích ngược
func smp_get_ap_count bv64 %0:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @ens ule %1 15

    @b0
        %1 = call smp_get_worker_count %0
        ret %1
}

# 2. Giao việc BẤT ĐỒNG BỘ cho Nhân Worker thứ %1 (1..15)
#    - %0: Bảng điều khiển SMP (0x7e000)
#    - %1: Chỉ số nhân AP (1..15)
#    - %2: Địa chỉ hàm Worker cần chạy (worker_fn_addr)
#    - %3: Tham số thứ 1 (arg0)
#    - %4: Tham số thứ 2 (arg1)
func smp_dispatch_worker void %0:ptr<DiskQword,64> %1:bv64 %2:bv64 %3:bv64 %4:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 1
    @req ule %1 15

    @b0
        %5 = const 2 bv64
        %6 = shl %1 %5
        %7 = const 1 bv64
        %8 = const 2 bv64
        %9 = const 3 bv64

        %10 = add %6 %7
        %11 = add %6 %8
        %12 = add %6 %9

        %13 = slice %0 %10 ptr<DiskQword,1>
        %14 = slice %0 %11 ptr<DiskQword,1>
        %15 = slice %0 %12 ptr<DiskQword,1>
        %16 = slice %0 %6 ptr<DiskQword,1>

        %17 = const 0 bv64
        store %13 0 %3
        store %14 0 %4
        store %15 0 %17
        store %16 0 %2
        ret
}

# 3. Kiểm tra Nhân Worker thứ %1 (1..15) đã hoàn thành công việc chưa
func smp_is_worker_done bv64 %0:ptr<DiskQword,64> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 1
    @req ule %1 15
    @ens ule %7 1

    @b0
        %2 = const 2 bv64
        %3 = shl %1 %2
        %4 = slice %0 %3 ptr<DiskQword,1>
        %5 = load %4 0 bv64
        %6 = const 0 bv64
        %7 = cmp eq %5 %6
        ret %7
}

# 4. Đọc kết quả trả về (64-bit) của Nhân Worker thứ %1 (1..15)
func smp_get_worker_result bv64 %0:ptr<DiskQword,64> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 1
    @req ule %1 15

    @b0
        %2 = const 2 bv64
        %3 = shl %1 %2
        %4 = const 3 bv64
        %5 = add %3 %4
        %6 = slice %0 %5 ptr<DiskQword,1>
        %7 = load %6 0 bv64
        ret %7
}

# 5. Kiểm tra TẤT CẢ các Nhân Worker hiện có của máy ảo (1..worker_count) đã làm xong chưa
func smp_poll_all_done bv64 %0:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @ens ule %10 1

    @b0
        %1 = call smp_get_worker_count %0
        %2 = const 0 bv64
        %3 = cmp eq %1 %2
        br %3 @b5 @b7

    @b7
        %4 = const 1 bv64
        jmp @b1 %4

    @b1 %5:bv64
        @inv uge %5 1
        @inv ule %5 16
        %6 = cmp ule %5 %1
        br %6 @b2 @b4

    @b2
        %7 = call smp_is_worker_done %0 %5
        %8 = cmp eq %7 %2
        br %8 @b8 @b3

    @b3
        %9 = const 1 bv64
        %11 = add %5 %9
        jmp @b1 %11

    @b4
        %12 = const 1 bv64
        jmp @b6 %12

    @b8
        %13 = const 0 bv64
        jmp @b6 %13

    @b5
        %14 = const 1 bv64
        jmp @b6 %14

    @b6 %10:bv64
        @inv ule %10 1
        ret %10
}

# 6. Dừng và xóa sạch trạng thái của tất cả các Nhân Worker (Dùng khi đóng App bằng nút [X])
func smp_stop_all_workers void %0:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        %1 = call smp_get_worker_count %0
        %2 = const 1 bv64
        jmp @b1 %2

    @b1 %3:bv64
        @inv uge %3 1
        @inv ule %3 16
        %4 = cmp ule %3 %1
        br %4 @b2 @b3

    @b2
        %5 = const 0 bv64
        call smp_dispatch_worker %0 %3 %5 %5 %5
        %6 = const 1 bv64
        %7 = add %3 %6
        jmp @b1 %7

    @b3
        ret
}
