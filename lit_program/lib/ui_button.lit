# File: lit_program/lib/ui_button.lit
# Thư viện UI Component: Button (Vẽ nút, nhận diện Hover, Hit-test Click)

include gfx.lit

# 1. Kiểm tra chuột có click vào vùng hình chữ nhật (x, y, w, h) không
func ui_btn_hit bv64 %0:bv64 %1:bv64 %2:bv64 %3:bv64 %4:bv64 %5:bv64 %6:bv64 {
    # %0: mouse_x, %1: mouse_y, %2: mouse_click
    # %3: btn_x, %4: btn_y, %5: btn_w, %6: btn_h
    @req ule %0 1280
    @req ule %1 720
    @req ule %3 1280
    @req ule %4 720
    @req ule %5 1280
    @req ule %6 720

    @b0
        %7 = const 0 bv64
        %8 = cmp ne %2 %7
        %9 = add %3 %5
        %10 = add %4 %6
        %11 = cmp uge %0 %3
        %12 = cmp ult %0 %9
        %13 = cmp uge %1 %4
        %14 = cmp ult %1 %10
        %15 = and %11 %12
        %16 = and %13 %14
        %17 = and %15 %16
        %18 = and %8 %17
        ret %18
}

# 2. Vẽ nút bấm dạng phẳng / 3D kèm hiệu ứng Hover
func ui_btn_draw void %0:ptr<VgaCell,1382400> %1:bv64 %2:bv64 %3:bv64 %4:bv64 %5:bv32 %6:bv64 {
    # %0: fb, %1: btn_x, %2: btn_y, %3: btn_w, %4: btn_h, %5: bg_color, %6: is_hover
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ule %1 1000
    @req ule %2 660
    @req uge %3 10
    @req ule %3 280
    @req uge %4 10
    @req ule %4 60
    @req ule %6 1

    @b0
        %7 = add %1 %3
        %8 = add %2 %4
        call gfx_fill_rect %0 %1 %2 %7 %8 %5

        %9 = const 0 bv64
        %10 = cmp ne %6 %9
        br %10 @b1 @b2

    @b1
        # Hover: viền sáng trắng trên & trái
        %11 = const 1 bv64
        %12 = add %2 %11
        %13 = const 0xffffff bv32
        call gfx_fill_rect %0 %1 %2 %7 %12 %13
        %14 = add %1 %11
        call gfx_fill_rect %0 %1 %2 %14 %8 %13
        jmp @b3

    @b2
        # Normal: viền đổ bóng tối dưới & phải
        %15 = const 1 bv64
        %16 = sub %8 %15
        %17 = const 0x0f172a bv32
        call gfx_fill_rect %0 %1 %16 %7 %8 %17
        %18 = sub %7 %15
        call gfx_fill_rect %0 %18 %2 %7 %8 %17
        jmp @b3

    @b3
        ret
}

# 3. Vẽ nút bấm hoàn chỉnh có chữ căn lề chính giữa tuyệt đối (Font 8x16, rộng 9px/chữ)
func ui_btn_draw_text void %0:ptr<VgaCell,1382400> %1:ptr<DiskQword,64> %2:bv64 %3:bv64 %4:bv64 %5:bv64 %6:bv32 %7:bv32 %8:bv64 %9:bv64 %10:bv64 {
    # %0: fb, %1: font_buf, %2: btn_x, %3: btn_y, %4: btn_w, %5: btn_h
    # %6: bg_color, %7: text_color, %8: title_qword, %9: char_count, %10: is_hover
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req ule %2 1000
    @req ule %3 660
    @req uge %4 10
    @req ule %4 260
    @req uge %5 16
    @req ule %5 40
    @req ule %9 8
    @req ule %10 1

    @b0
        call ui_btn_draw %0 %2 %3 %4 %5 %6 %10

        # Chỗ 1: Tính bề rộng text = char_count * 9 (thay vì shl 4)
        %11 = const 9 bv64
        %12 = mul %9 %11

        # Căn lề ngang: pad_x = (btn_w - text_w) / 2 nếu btn_w >= text_w
        %13 = const 1 bv64
        %14 = cmp uge %4 %12
        br %14 @b1 @b2

    @b1
        %15 = sub %4 %12
        %16 = lshr %15 %13
        %17 = add %2 %16
        jmp @b3 %17

    @b2
        jmp @b3 %2

    @b3 %18:bv64
        @inv ule %18 1130
        # Căn lề dọc: pad_y = (btn_h - 16) / 2
        %19 = const 16 bv64
        %20 = sub %5 %19
        %21 = lshr %20 %13
        %22 = add %3 %21

        # Vòng lặp vẽ đúng char_count ký tự
        %23 = const 0 bv64
        jmp @b4 %23

    @b4 %24:bv64
        @inv ule %24 8
        %25 = cmp ult %24 %9
        br %25 @b5 @b6

    @b5
        %26 = const 3 bv64
        %27 = shl %24 %26
        %28 = lshr %8 %27
        %29 = const 0xff bv64
        %30 = and %28 %29

        # Chỗ 2: Tọa độ X của chữ thứ %24 = %18 + (%24 * 9)
        %31 = mul %24 %11
        %32 = add %18 %31
        call gfx_draw_char16 %0 %1 %32 %22 %30 %7

        %33 = const 1 bv64
        %34 = add %24 %33
        jmp @b4 %34

    @b6
        ret
}
