# File: lit_program/lib/os_layout.lit
# Định nghĩa các cấu trúc dữ liệu phẳng (Layout) dùng chung cho toàn hệ thống Light OS

# File: lit_program/lib/os_layout.lit
layout DiskQword 8 {
    0: bv64
}

layout IpcChannel 240 {
    0: bv64
    8: bv8 @inv ult val 128
    16: bv64 @inv ult val 1260              # chuột X trong khung nhìn App (kernel quy đổi từ 184 mỗi nhịp)
    24: bv64 @inv ult val 700               # chuột Y trong khung nhìn App (từ 192)
    32: bv64
    40: bv64 @inv ult val 4
    48: bv64
    56: bv64 @inv ult val 8
    64: bv64 @inv ult val 1900              # vị trí con trỏ đã vẽ (tọa độ màn hình, kernel)
    72: bv64 @inv ult val 1060
    80: bv64
    88: bv64                                # ipc_win_cmd: 0 = Normal, 1 = App requested Shell to close & reset
    96: bv64 @inv ule val 0xffffffffffffffff   # disk_read_req: lba[0..23]|n[24..39]|dst[40..55] (xem app_dispatch_disk_io_old)
    104: bv64 @inv ult val 268435456
    112: bv64 @inv ule val 1
    120: bv64 @inv ule val 1280
    128: bv64 @inv ule val 720
    136: bv64 @inv ule val 1280
    144: bv64 @inv ule val 720
    152: bv64                               # ipc_bg_mask: Bitmask of apps running in background (bit i = 1 << slot)
    160: bv64                               # Trạng thái giữ phím Shift (1 = đang giữ Shift, 0 = nhả)
    168: bv64 @inv ule val 16383             # dự trữ (chunk_req của allocator cũ đã gỡ; sẽ thay bằng sys_mem_commit)
    176: bv64 @inv ule val 0xffffffff       # dự trữ (chunk_state của allocator cũ đã gỡ)
    184: bv64 @inv ult val 1900             # chuột X trên màn hình 1920x1080 (driver chuột / phím F ghi)
    192: bv64 @inv ult val 1060             # chuột Y trên màn hình
    200: bv64                               # LightFS: mã lệnh (0 = không có yêu cầu), xem lib/lightfs_api.lit
    208: bv64                               # LightFS: id mục
    216: bv64                               # LightFS: sector trong vùng State của App
    224: bv64                               # LightFS: độ dài byte / cờ
    232: bv64                               # LightFS: kết quả (bit 63 = lỗi)
}

