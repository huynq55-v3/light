# File: lit_program/lib/cap_mem.lit
include os_layout.lit
include std_lib.lit
include ipc_bus.lit

func cap_state_get bv64 %0:ptr<DiskQword,64> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req ult %1 64

    @b0
        %2 = slice %0 %1 ptr<DiskQword,1>
        %3 = load %2 0 bv64
        ret %3
}

func cap_state_set void %0:ptr<DiskQword,64> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req ult %1 64

    @b0
        %3 = slice %0 %1 ptr<DiskQword,1>
        store %3 0 %2
        ret
}

func cap_mem_copy void %0:ptr<DiskQword,64> %1:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req uge %1 0x10000
    @req ult %1 0x10000000000

    @b0
        %2 = const 0 bv64
        jmp @b1 %2

    @b1 %3:bv64
        @inv ule %3 64
        %4 = const 64 bv64
        %5 = cmp ult %3 %4
        br %5 @b2 @b3

    @b2
        %6 = slice %1 %3 ptr<DiskQword,1>
        %7 = load %6 0 bv64
        %8 = slice %0 %3 ptr<DiskQword,1>
        store %8 0 %7
        %9 = const 1 bv64
        %10 = add %3 %9
        jmp @b1 %10

    @b3
        ret
}

func cap_mem_fill void %0:ptr<DiskQword,64> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req ule %2 64

    @b0
        %3 = const 0 bv64
        jmp @b1 %3

    @b1 %4:bv64
        @inv ule %4 64
        %5 = cmp ult %4 %2
        br %5 @b2 @b3

    @b2
        %6 = slice %0 %4 ptr<DiskQword,1>
        store %6 0 %1
        %7 = const 1 bv64
        %8 = add %4 %7
        jmp @b1 %8

    @b3
        ret
}

# Xóa các Qword trong nửa khoảng [%1 .. %2) của bộ đệm %0 về 0
func cap_mem_zero_range void %0:ptr<DiskQword,64> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req ule %1 64
    @req ule %2 64
    @req ule %1 %2

    @b0
        jmp @b1 %1

    @b1 %3:bv64
        @inv uge %3 %1
        @inv ule %3 64
        %4 = cmp ult %3 %2
        br %4 @b2 @b3

    @b2
        %5 = slice %0 %3 ptr<DiskQword,1>
        %6 = const 0 bv64
        store %5 0 %6
        %7 = const 1 bv64
        %8 = add %3 %7
        jmp @b1 %8

    @b3
        ret
}

# Đọc/Ghi Qword tại vị trí bất kỳ trên toàn bộ RAM Arena (0 .. 4294705151 = 16GB = 16383 Chunk 2MB, Chunk nào đã được Kernel cấp mới truy cập được)
func cap_arena_get bv64 %0:ptr<DiskQword,4294705152> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req ult %1 4294705152

    @b0
        %2 = slice %0 %1 ptr<DiskQword,1>
        %3 = load %2 0 bv64
        ret %3
}

func cap_arena_set void %0:ptr<DiskQword,4294705152> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req ult %1 4294705152

    @b0
        %3 = slice %0 %1 ptr<DiskQword,1>
        store %3 0 %2
        ret
}

# Cấp phát động %2 Qwords trên RAM Arena cho một biến mới (Kernel cấp thêm khung RAM thật khi vùng mới vượt qua Chunk đã có)
# - Arena = 16383 Chunk 2MB liên tục trong không gian ảo (~16GB, Chunk 0 chứa State[0..63]); mỗi Chunk được Kernel gắn 1 khung RAM vật lý riêng khi cần
# - Slot 63 của Arena lưu con trỏ đỉnh Heap (`heap_top`, bắt đầu từ Qword 64 ngay sau State[0..63])
# - Căn chỉnh (align) theo khối 64 Qwords để mọi biến đều có thể dùng cho cả tính toán lẫn đọc đĩa
# - Trả về offset Qword bắt đầu của biến vừa cấp phát (64 .. 4294705088)
# - Trả về 0 nếu THẤT BẠI (hết Arena 16GB hoặc bể khung RAM của Kernel không đủ); khi đó heap_top KHÔNG đổi
#   và Caller bắt buộc phải kiểm tra kết quả khác 0 trước khi dùng
func cap_heap_alloc bv64 %0:ptr<IpcChannel,1> %1:ptr<DiskQword,4294705152> %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x10000000000
    @req uge %2 1
    @req ule %2 4294000000
    @ens ule %30 4294705088

    @b0
        %3 = const 63 bv64
        %4 = call cap_arena_get %1 %3
        %5 = const 64 bv64
        %6 = const 4294705152 bv64
        %7 = call std_clamp %4 %5 %6        # base_off thuộc [64 .. 4294705152]

        # Làm tròn %2 lên bội số của 64 Qwords (1 Sector)
        %8 = const 63 bv64
        %9 = add %2 %8
        %10 = const 0xffffffffffffffc0 bv64
        %11 = and %9 %10                    # aligned_qwords (64 .. 4294000000)

        %12 = add %7 %11                    # new_top (không thể tràn bv64)
        %14 = cmp ule %12 %6
        br %14 @b1 @b3                      # Hết Arena -> thất bại, không cắt cụt âm thầm

    @b1
        # Số Chunk 2MB cần có = ceil(new_top / 262144) (1..16383)
        %15 = const 262143 bv64
        %16 = add %12 %15
        %17 = const 18 bv64
        %18 = lshr %16 %17
        %19 = call ipc_chunk_state_granted %0
        %20 = call ipc_chunk_state_free %0
        %21 = cmp ugt %18 %19
        br %21 @b4 @b2

    @b4
        # Thiếu Chunk: kiểm tra bể khung RAM của Kernel còn đủ không
        %22 = sub %18 %19
        %23 = cmp ule %22 %20
        br %23 @b5 @b3

    @b5
        call ipc_chunk_req_post %0 %18      # Xin Kernel cấp thêm Chunk
        jmp @b2

    @b2
        call cap_arena_set %1 %3 %12        # Chỉ commit heap_top khi yêu cầu cấp RAM đã được chấp nhận
        jmp @b99 %7

    @b3
        %31 = const 0 bv64
        jmp @b99 %31

    @b99 %30:bv64
        @inv ule %30 4294705088
        ret %30
}

# Đồng bộ số Chunk 2MB cần dùng (1..16383) từ đỉnh bộ nhớ hiện tại %1 và gửi cho Kernel
func cap_sync_needed_chunks void %0:ptr<IpcChannel,1> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ule %1 4294705152

    @b0
        %2 = const 262143 bv64
        %3 = add %1 %2
        %4 = const 18 bv64
        %5 = lshr %3 %4                     # needed_chunks = ceil(top_qword / 262144)
        %6 = const 1 bv64
        %7 = const 16383 bv64
        %8 = call std_clamp %5 %6 %7
        call ipc_chunk_req_set %0 %8
        ret
}

# Lấy mốc đỉnh Heap hiện tại (64..4294705152)
func cap_heap_mark bv64 %0:ptr<DiskQword,4294705152> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @ens uge %5 64
    @ens ule %5 4294705152

    @b0
        %1 = const 63 bv64
        %2 = call cap_arena_get %0 %1
        %3 = const 64 bv64
        %4 = const 4294705152 bv64
        %5 = call std_clamp %2 %3 %4
        ret %5
}

# Thu hồi bộ nhớ Heap về mốc %2 (64..heap_top) và báo Kernel rút các Chunk 2MB dư thừa
func cap_heap_free_to void %0:ptr<IpcChannel,1> %1:ptr<DiskQword,4294705152> %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x10000000000
    @req uge %2 64
    @req ule %2 4294705152

    @b0
        %3 = const 63 bv64
        %4 = call cap_heap_mark %1          # old_top
        %5 = call std_min %2 %4             # new_top <= old_top
        call cap_arena_set %1 %3 %5
        call cap_sync_needed_chunks %0 %5
        ret
}

# Giải phóng biến tại offset %2 với kích thước %3 Qwords:
# - Nếu biến nằm ở đỉnh Heap (var_off + aligned_size >= heap_top): lùi heap_top về var_off và trả Chunk 2MB dư về Kernel!
# - Nếu biến nằm ở giữa Heap (phía trên vẫn còn biến khác đang dùng): giữ nguyên các biến phía trên, không bao giờ xóa nhầm!
func cap_heap_free void %0:ptr<IpcChannel,1> %1:ptr<DiskQword,4294705152> %2:bv64 %3:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x10000000000
    @req uge %2 64
    @req ule %2 4294705088
    @req uge %3 1
    @req ule %3 4294000000

    @b0
        %4 = const 63 bv64
        %5 = add %3 %4
        %6 = const 0xffffffffffffffc0 bv64
        %7 = and %5 %6                      # aligned_size
        %8 = add %2 %7                      # var_end
        %9 = call cap_heap_mark %1          # cur_top
        %10 = cmp uge %8 %9
        br %10 @b1 @b2

    @b1
        call cap_heap_free_to %0 %1 %2
        ret

    @b2
        ret
}

# Thu hồi toàn bộ Heap của App về trạng thái ban đầu (chỉ giữ lại State[0..63] ở Chunk 0)
func cap_heap_reset void %0:ptr<IpcChannel,1> %1:ptr<DiskQword,4294705152> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x10000000000

    @b0
        %2 = const 64 bv64
        call cap_heap_free_to %0 %1 %2
        ret
}
