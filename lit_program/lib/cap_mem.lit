# File: lit_program/lib/cap_mem.lit
include os_layout.lit
include std_lib.lit
include ipc_bus.lit

# Xóa các Qword trong nửa khoảng [%1 .. %2) của bộ đệm %0 về 0
func cap_mem_zero_range void %0:ptr<DiskQword,64> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req ule %1 64
    @req ule %2 64
    @req ule %1 %2

    @b0
        jmp @b1 %1

    @b1 %3:bv64
        @inv uge %3 %1
        @inv ule %3 64
        %4 = cmp ult %3 %2
        br %4 @b2 @b3

    @b2
        %5 = slice %0 %3 ptr<DiskQword,1>
        %6 = const 0 bv64
        store %5 0 %6
        %7 = const 1 bv64
        %8 = add %3 %7
        jmp @b1 %8

    @b3
        ret
}
