# File: lit_program/lib/ui_nuklear.lit
# Thư viện Immediate Mode GUI (Lấy cảm hứng từ Nuklear) cho Light OS
# Triết lý Nuklear:
# 1. Immediate Mode Widget (nk_button, nk_label)
# 2. Dynamic Row Grid Layout (nk_layout_row_dynamic)
# 3. Quản lý trạng thái Context trên DiskQword[64] không cấp phát động

include gfx.lit
include os_layout.lit

# Bố cục Nuklear Context (dùng DiskQword[64] phẳng):
# Slot 0:  win_x
# Slot 1:  win_y
# Slot 2:  win_w
# Slot 3:  win_h
# Slot 4:  cur_x (vị trí X hiện tại của layout cursor)
# Slot 5:  cur_y (vị trí Y hiện tại của layout cursor)
# Slot 6:  row_h (chiều cao của hàng hiện tại)
# Slot 7:  item_w (chiều rộng widget hiện tại)
# Slot 8:  mouse_x
# Slot 9:  mouse_y
# Slot 10: mouse_click
# Slot 11: theme_bg
# Slot 12: theme_btn
# Slot 13: theme_hover
# Slot 14: theme_active
# Slot 15: theme_text

# 1. Khởi tạo Context và nạp Input từ IpcChannel
func nk_init void %0:ptr<DiskQword,64> %1:ptr<IpcChannel,1> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req uge %1 0x10000
    @req ult %1 0x80000000

    @b0
        %2 = load %1 16 bv64                # mouse_x
        %3 = load %1 24 bv64                # mouse_y
        %4 = load %1 32 bv64                # mouse_click

        %5 = const 8 bv64
        %6 = slice %0 %5 ptr<DiskQword,1>
        store %6 0 %2

        %7 = const 9 bv64
        %8 = slice %0 %7 ptr<DiskQword,1>
        store %8 0 %3

        %9 = const 10 bv64
        %10 = slice %0 %9 ptr<DiskQword,1>
        store %10 0 %4

        # Theme Dark sang trọng
        %11 = const 11 bv64
        %12 = slice %0 %11 ptr<DiskQword,1>
        %13 = const 0x1e293b bv64
        store %12 0 %13

        %14 = const 12 bv64
        %15 = slice %0 %14 ptr<DiskQword,1>
        %16 = const 0x334155 bv64
        store %15 0 %16

        %17 = const 13 bv64
        %18 = slice %0 %17 ptr<DiskQword,1>
        %19 = const 0x475569 bv64
        store %18 0 %19

        %20 = const 14 bv64
        %21 = slice %0 %20 ptr<DiskQword,1>
        %22 = const 0x0284c7 bv64
        store %21 0 %22

        %23 = const 15 bv64
        %24 = slice %0 %23 ptr<DiskQword,1>
        %25 = const 0xf8fafc bv64
        store %24 0 %25
        ret
}

# 2. Bắt đầu Window Frame
func nk_begin void %0:ptr<VgaCell,921600> %1:ptr<DiskQword,64> %2:ptr<DiskQword,64> %3:bv64 %4:bv64 %5:bv64 %6:bv64 %7:bv64 {
    # %0: fb, %1: ctx, %2: font_buf, %3: x, %4: y, %5: w, %6: h, %7: title_qword
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x10000000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req uge %3 40
    @req ule %3 400
    @req uge %4 40
    @req ule %4 200
    @req uge %5 200
    @req ule %5 800
    @req uge %6 150
    @req ule %6 500

    @b0
        # Lưu bounds vào context
        %8 = const 0 bv64
        %9 = slice %1 %8 ptr<DiskQword,1>
        store %9 0 %3

        %10 = const 1 bv64
        %11 = slice %1 %10 ptr<DiskQword,1>
        store %11 0 %4

        %12 = const 2 bv64
        %13 = slice %1 %12 ptr<DiskQword,1>
        store %13 0 %5

        %14 = const 3 bv64
        %15 = slice %1 %14 ptr<DiskQword,1>
        store %15 0 %6

        # Reset layout cursor (cur_x = win_x + 16, cur_y = win_y + 42)
        %16 = const 16 bv64
        %17 = add %3 %16
        %18 = const 4 bv64
        %19 = slice %1 %18 ptr<DiskQword,1>
        store %19 0 %17

        %20 = const 42 bv64
        %21 = add %4 %20
        %22 = const 5 bv64
        %23 = slice %1 %22 ptr<DiskQword,1>
        store %23 0 %21

        # Lưu mặc định row_h (slot 6) và item_w (slot 7)
        %24 = const 28 bv64
        %25 = const 6 bv64
        %26 = slice %1 %25 ptr<DiskQword,1>
        store %26 0 %24

        %27 = const 32 bv64
        %28 = sub %5 %27
        %29 = const 7 bv64
        %30 = slice %1 %29 ptr<DiskQword,1>
        store %30 0 %28

        # Vẽ Window Background & Titlebar
        %31 = add %3 %5                     # x2
        %32 = add %4 %6                     # y2
        %33 = const 0x0f172a bv32           # Deep dark slate
        call gfx_fill_rect %0 %3 %4 %31 %32 %33

        # Title bar (cao 30px)
        %34 = const 30 bv64
        %35 = add %4 %34
        %36 = const 0x1e293b bv32
        call gfx_fill_rect %0 %3 %4 %31 %35 %36

        # Title bar bottom border
        %37 = const 1 bv64
        %38 = add %35 %37
        %39 = const 0x334155 bv32
        call gfx_fill_rect %0 %3 %35 %31 %38 %39

        # Title text
        %40 = const 12 bv64
        %41 = add %3 %40
        %42 = const 7 bv64
        %43 = add %4 %42
        %44 = const 0x38bdf8 bv32           # Light sky blue
        call gfx_draw_str8 %0 %2 %41 %43 %7 %44

        # Nút Đóng [X] màu đỏ góc trên bên phải thanh tiêu đề: (x2 - 38 .. x2 - 6, y + 4 .. y + 26)
        %45 = const 38 bv64
        %46 = sub %31 %45
        %47 = const 4 bv64
        %48 = add %4 %47
        %49 = const 6 bv64
        %50 = sub %31 %49
        %51 = const 26 bv64
        %52 = add %4 %51
        %53 = const 0xef4444 bv32           # Red close button
        call gfx_fill_rect %0 %46 %48 %50 %52 %53

        # Dấu X màu trắng bên trong nút
        %54 = const 10 bv64
        %55 = add %46 %54
        %56 = const 7 bv64
        %57 = add %48 %56
        %58 = const 22 bv64
        %59 = add %46 %58
        %60 = const 15 bv64
        %61 = add %48 %60
        %62 = const 0xffffff bv32
        call gfx_fill_rect %0 %55 %57 %59 %61 %62
        ret
}

# 3. Layout Row Engine (Dynamic: chia cột theo tỷ lệ)
func nk_layout_row_dynamic void %0:ptr<DiskQword,64> %1:bv64 %2:bv64 {
    # %0: ctx, %1: row_height, %2: columns (1 hoặc 2)
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req uge %1 16
    @req ule %1 60
    @req uge %2 1
    @req ule %2 2

    @b0
        # Lưu row_h (slot 6)
        %3 = const 6 bv64
        %4 = slice %0 %3 ptr<DiskQword,1>
        store %4 0 %1

        # Lấy win_x và win_w
        %5 = const 0 bv64
        %6 = slice %0 %5 ptr<DiskQword,1>
        %7 = load %6 0 bv64                 # win_x

        %8 = const 2 bv64
        %9 = slice %0 %8 ptr<DiskQword,1>
        %10 = load %9 0 bv64                # win_w

        # Reset cur_x về win_x + 16 (lề trái)
        %11 = const 1000 bv64
        %12 = cmp ult %7 %11
        br %12 @b101 @b102

    @b101
        %13 = const 16 bv64
        %14 = add %7 %13
        %15 = const 4 bv64
        %16 = slice %0 %15 ptr<DiskQword,1>
        store %16 0 %14
        jmp @b103

    @b102
        %17 = const 1000 bv64
        %18 = const 4 bv64
        %19 = slice %0 %18 ptr<DiskQword,1>
        store %19 0 %17
        jmp @b103

    @b103
        # Tính item_w
        %20 = const 32 bv64
        %21 = cmp uge %10 %20
        br %21 @b104 @b105

    @b104
        %22 = sub %10 %20
        jmp @b106 %22

    @b105
        %23 = const 40 bv64
        jmp @b106 %23

    @b106 %24:bv64
        %25 = const 7 bv64
        %26 = slice %0 %25 ptr<DiskQword,1>

        %27 = const 1 bv64
        %28 = cmp eq %2 %27
        br %28 @b1 @b2

    @b1
        store %26 0 %24
        ret

    @b2
        %29 = const 10 bv64
        %30 = cmp uge %24 %29
        br %30 @b21 @b22

    @b21
        %31 = sub %24 %29
        %32 = const 1 bv64
        %33 = lshr %31 %32
        store %26 0 %33
        ret

    @b22
        %34 = const 20 bv64
        store %26 0 %34
        ret
}

# 4. Xuống hàng (Row newline)
func nk_layout_row_end void %0:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000

    @b0
        %1 = const 5 bv64
        %2 = slice %0 %1 ptr<DiskQword,1>
        %3 = load %2 0 bv64                 # cur_y

        %4 = const 6 bv64
        %5 = slice %0 %4 ptr<DiskQword,1>
        %6 = load %5 0 bv64                 # row_h

        # Kiểm tra an toàn cho row_h
        %7 = const 100 bv64
        %8 = cmp ult %6 %7
        br %8 @b111 @b112

    @b111
        %9 = const 8 bv64
        %10 = add %6 %9
        jmp @b113 %10

    @b112
        %11 = const 36 bv64
        jmp @b113 %11

    @b113 %12:bv64
        @inv ule %12 108
        %13 = const 480 bv64
        %14 = cmp ult %3 %13
        br %14 @b101 @b102

    @b101
        %15 = add %3 %12
        store %2 0 %15
        jmp @b103

    @b102
        %16 = const 660 bv64
        store %2 0 %16
        jmp @b103

    @b103
        # cur_x = win_x + 16
        %17 = const 0 bv64
        %18 = slice %0 %17 ptr<DiskQword,1>
        %19 = load %18 0 bv64               # win_x
        %20 = const 1000 bv64
        %21 = cmp ult %19 %20
        br %21 @b104 @b105

    @b104
        %22 = const 16 bv64
        %23 = add %19 %22
        %24 = const 4 bv64
        %25 = slice %0 %24 ptr<DiskQword,1>
        store %25 0 %23
        ret

    @b105
        %26 = const 1000 bv64
        %27 = const 4 bv64
        %28 = slice %0 %27 ptr<DiskQword,1>
        store %28 0 %26
        ret
}

# 5. Widget Button (Immediate Click Check + Rendering)
func nk_button bv64 %0:ptr<VgaCell,921600> %1:ptr<DiskQword,64> %2:ptr<DiskQword,64> %3:bv64 {
    # %0: fb, %1: ctx, %2: font_buf, %3: label_qword
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x10000000000
    @req uge %2 0x10000
    @req ult %2 0x80000000

    @b0
        # Lấy thông số từ context
        %4 = const 4 bv64
        %5 = slice %1 %4 ptr<DiskQword,1>
        %6 = load %5 0 bv64                 # cur_x

        %7 = const 5 bv64
        %8 = slice %1 %7 ptr<DiskQword,1>
        %9 = load %8 0 bv64                 # cur_y

        %10 = const 7 bv64
        %11 = slice %1 %10 ptr<DiskQword,1>
        %12 = load %11 0 bv64               # item_w

        %13 = const 6 bv64
        %14 = slice %1 %13 ptr<DiskQword,1>
        %15 = load %14 0 bv64               # row_h

        # Lấy mouse input
        %16 = const 8 bv64
        %17 = slice %1 %16 ptr<DiskQword,1>
        %18 = load %17 0 bv64               # mouse_x

        %19 = const 9 bv64
        %20 = slice %1 %19 ptr<DiskQword,1>
        %21 = load %20 0 bv64               # mouse_y

        %22 = const 10 bv64
        %23 = slice %1 %22 ptr<DiskQword,1>
        %24 = load %23 0 bv64               # mouse_click

        # Kẹp an toàn để Z3 chứng minh không tràn số
        %25 = const 1000 bv64
        %26 = cmp ult %6 %25
        br %26 @b101 @b109

    @b101
        %27 = const 660 bv64
        %28 = cmp ult %9 %27
        br %28 @b102 @b109

    @b102
        %29 = const 600 bv64
        %30 = cmp ult %12 %29
        br %30 @b1021 @b109

    @b1021
        %68 = const 100 bv64
        %69 = cmp ult %15 %68
        br %69 @b103 @b109

    @b103
        %31 = add %6 %12                    # x2
        %32 = add %9 %15                    # y2

        # Hit test
        %33 = cmp uge %18 %6
        %34 = cmp ult %18 %31
        %35 = cmp uge %21 %9
        %36 = cmp ult %21 %32
        %37 = and %33 %34
        %38 = and %35 %36
        %39 = and %37 %38                   # is_hover

        # Màu sắc
        %40 = const 0 bv64
        %41 = cmp ne %39 %40
        br %41 @b1 @b2

    @b1
        %42 = cmp ne %24 %40
        br %42 @b10 @b11

    @b10
        %43 = const 0x0284c7 bv32           # Active Sky Blue
        jmp @b3 %43

    @b11
        %44 = const 0x475569 bv32           # Hover Slate
        jmp @b3 %44

    @b2
        %45 = const 0x334155 bv32           # Normal Slate
        jmp @b3 %45

    @b3 %46:bv32
        # Giới hạn an toàn trước khi vẽ
        %47 = const 1080 bv64
        %48 = cmp ult %31 %47
        br %48 @b4 @b104

    @b4
        %49 = const 680 bv64
        %50 = cmp ult %32 %49
        br %50 @b5 @b104

    @b5
        # Vẽ nền nút
        call gfx_fill_rect %0 %6 %9 %31 %32 %46

        # Viền trên 1px sáng
        %51 = const 0x64748b bv32
        %52 = const 1 bv64
        %53 = add %9 %52
        call gfx_fill_rect %0 %6 %9 %31 %53 %51

        # Chữ căn giữa tương đối
        %54 = const 8 bv64
        %55 = add %6 %54
        %56 = const 6 bv64
        %57 = add %9 %56
        %58 = const 0xffffff bv32
        call gfx_draw_str8 %0 %2 %55 %57 %3 %58
        jmp @b104

    @b104
        # Dời sang cột tiếp theo
        %59 = const 10 bv64
        %60 = add %12 %59
        %61 = const 1000 bv64
        %62 = cmp ult %6 %61
        br %62 @b105 @b109

    @b105
        %63 = add %6 %60
        store %5 0 %63

        # Click = is_hover && mouse_click != 0
        %64 = const 0 bv64
        %65 = cmp ne %24 %64
        %66 = and %39 %65
        ret %66

    @b109
        %67 = const 0 bv64
        ret %67
}

# 6. Widget Label (Hiển thị văn bản tức thời)
func nk_label void %0:ptr<VgaCell,921600> %1:ptr<DiskQword,64> %2:ptr<DiskQword,64> %3:bv64 %4:bv32 {
    # %0: fb, %1: ctx, %2: font_buf, %3: text_qword, %4: color
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x10000000000
    @req uge %2 0x10000
    @req ult %2 0x80000000

    @b0
        %5 = const 4 bv64
        %6 = slice %1 %5 ptr<DiskQword,1>
        %7 = load %6 0 bv64                 # cur_x

        %8 = const 5 bv64
        %9 = slice %1 %8 ptr<DiskQword,1>
        %10 = load %9 0 bv64                # cur_y

        %11 = const 7 bv64
        %12 = slice %1 %11 ptr<DiskQword,1>
        %13 = load %12 0 bv64               # item_w

        %14 = const 1100 bv64
        %15 = cmp ult %7 %14
        br %15 @b1 @b3

    @b1
        %16 = const 700 bv64
        %17 = cmp ult %10 %16
        br %17 @b2 @b3

    @b2
        call gfx_draw_str8 %0 %2 %7 %10 %3 %4
        jmp @b3

    @b3
        # Dời sang cột tiếp theo nếu item_w và cur_x an toàn
        %18 = const 600 bv64
        %19 = cmp ult %13 %18
        br %19 @b1001 @b104

    @b1001
        %20 = const 10 bv64
        %21 = add %13 %20
        %22 = const 1000 bv64
        %23 = cmp ult %7 %22
        br %23 @b101 @b104

    @b101
        %24 = add %7 %21
        store %6 0 %24
        ret

    @b104
        ret
}
