# File: lit_program/lib/std_lib.lit
# LIGHT STANDARD LIBRARY: Toán học (Math), Bộ nhớ Byte (Memory), và Chuỗi (String/Format)

include os_layout.lit

# =============================================================================
# PHẦN 1: TOÁN HỌC AN TOÀN VỚI HỢP ĐỒNG HẬU ĐIỀU KIỆN (@ens) CHO Z3
# =============================================================================

func std_min bv64 %0:bv64 %1:bv64 {
    @ens ule %4 %0
    @ens ule %4 %1
    @ens or eq %4 %0 eq %4 %1

    @b0
        %2 = cmp ult %0 %1
        br %2 @b1 @b2

    @b1
        jmp @b3 %0

    @b2
        jmp @b3 %1

    @b3 %4:bv64
        @inv ule %4 %0
        @inv ule %4 %1
        @inv or eq %4 %0 eq %4 %1
        ret %4
}

func std_max bv64 %0:bv64 %1:bv64 {
    @ens uge %4 %0
    @ens uge %4 %1
    @ens or eq %4 %0 eq %4 %1

    @b0
        %2 = cmp ugt %0 %1
        br %2 @b1 @b2

    @b1
        jmp @b3 %0

    @b2
        jmp @b3 %1

    @b3 %4:bv64
        @inv uge %4 %0
        @inv uge %4 %1
        @inv or eq %4 %0 eq %4 %1
        ret %4
}

# =============================================================================
# PHẦN 2: TRUY CẬP MẢNG BYTE TRÊN BỘ ĐỆM 64-BIT (BYTE-ADDRESSABLE MEMORY API)
# =============================================================================

# Đọc/ghi qword %1 của bảng 512 qword (dùng chung cho bảng HW, bảng VMM, thông tin bộ nhớ)
func q512 bv64 %0:ptr<DiskQword,512> %1:bv64 {
    @req ult %1 512

    @b0
        %2 = slice %0 %1 ptr<DiskQword,1>
        %3 = load %2 0 bv64
        ret %3
}

func q512_set void %0:ptr<DiskQword,512> %1:bv64 %2:bv64 {
    @req ult %1 512

    @b0
        %3 = slice %0 %1 ptr<DiskQword,1>
        store %3 0 %2
        ret
}

# 1. Đọc 1 byte (0..255) tại vị trí byte_idx (%1 = 0..511) từ bộ đệm 512-byte (%0)
func std_mem_get_byte bv64 %0:ptr<DiskQword,64> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req ult %1 512
    @ens ult %11 256

    @b0
        %2 = const 3 bv64
        %3 = lshr %1 %2                     # qword_idx = byte_idx >> 3 (< 64)
        %4 = slice %0 %3 ptr<DiskQword,1>
        %5 = load %4 0 bv64

        %6 = const 7 bv64
        %7 = and %1 %6
        %8 = shl %7 %2                      # bit_shift = (byte_idx & 7) * 8 (< 64)
        %9 = lshr %5 %8
        %10 = const 0xff bv64
        %11 = and %9 %10
        ret %11
}

# 2. Ghi 1 byte (%2 = 0..255) vào vị trí byte_idx (%1 = 0..511) trong bộ đệm 512-byte (%0)
func std_mem_set_byte void %0:ptr<DiskQword,64> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req ult %1 512

    @b0
        %3 = const 3 bv64
        %4 = lshr %1 %3                     # qword_idx = byte_idx >> 3 (< 64)
        %5 = slice %0 %4 ptr<DiskQword,1>
        %6 = load %5 0 bv64

        %7 = const 7 bv64
        %8 = and %1 %7
        %9 = shl %8 %3                      # bit_shift = (byte_idx & 7) * 8 (< 64)

        # Xóa byte cũ tại vị trí bit_shift và ghép byte mới vào
        %10 = const 0xff bv64
        %11 = shl %10 %9
        %12 = const 0xffffffffffffffff bv64
        %13 = xor %11 %12                   # mask = ~(0xFF << bit_shift)
        %14 = and %6 %13

        %15 = and %2 %10
        %16 = shl %15 %9
        %17 = or %14 %16
        store %5 0 %17
        ret
}

# 3. Xóa trắng toàn bộ bộ đệm 512-byte (64 Qwords) về 0
func std_mem_zero void %0:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000

    @b0
        %1 = const 0 bv64
        jmp @b1 %1

    @b1 %2:bv64
        @inv ule %2 64
        %3 = const 64 bv64
        %4 = cmp ult %2 %3
        br %4 @b2 @b3

    @b2
        %5 = slice %0 %2 ptr<DiskQword,1>
        %6 = const 0 bv64
        store %5 0 %6
        %7 = const 1 bv64
        %8 = add %2 %7
        jmp @b1 %8

    @b3
        ret
}

# =============================================================================
# PHẦN 3: THƯ VIỆN CHUỖI KÝ TỰ & ĐỊNH DẠNG SỐ (STRING & NUMBER FORMATTING API)
# =============================================================================

# 1. Tính độ dài chuỗi kết thúc bằng byte 0 (Trả về 0..511, được Z3 bảo chứng < 512!)
func std_str_len bv64 %0:ptr<DiskQword,64> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @ens ult %3 511

    @b0
        %1 = const 0 bv64
        jmp @b1 %1

    @b1 %2:bv64
        @inv ule %2 510
        %4 = const 510 bv64
        %5 = cmp ult %2 %4
        br %5 @b2 @b4

    @b2
        %6 = call std_mem_get_byte %0 %2
        %7 = const 0 bv64
        %8 = cmp eq %6 %7
        br %8 @b4 @b3

    @b3
        %9 = const 1 bv64
        %10 = add %2 %9
        jmp @b1 %10

    @b4
        %3 = add %2 %1
        ret %3
}

# 2. Xử lý phím gõ vào bộ đệm chuỗi (Hỗ trợ cả Nối ký tự vào cuối + Phím Backspace = 8 xóa lùi!)
func std_str_push_or_bs void %0:ptr<DiskQword,64> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000

    @b0
        %2 = call std_str_len %0
        %3 = const 8 bv64                   # Mã phím Backspace (ASCII 8)
        %4 = cmp eq %1 %3
        br %4 @b1 @b4

    @b1
        # Nếu là phím Backspace và độ dài chuỗi > 0 -> Xóa ký tự tại (len - 1) về 0!
        %5 = const 0 bv64
        %6 = cmp ugt %2 %5
        br %6 @b2 @b3

    @b2
        %7 = const 1 bv64
        %8 = sub %2 %7
        call std_mem_set_byte %0 %8 %5
        ret

    @b3
        ret

    @b4
        # Nếu là ký tự thường (len < 510) -> Ghi ký tự vào vị trí len và đặt '\0' tại (len + 1)!
        call std_mem_set_byte %0 %2 %1
        %9 = const 1 bv64
        %10 = add %2 %9
        %11 = const 0 bv64
        call std_mem_set_byte %0 %10 %11
        ret
}

# =============================================================================
# PHẦN 4: PARSER LỆNH VÀ THAO TÁC TERMINAL BUFFER CHO CLI SHELL
# =============================================================================

# 1. Bỏ qua khoảng trắng (' ' = 32, '\t' = 9) bắt đầu từ vị trí %1 (< 512)
func std_str_skip_spaces bv64 %0:ptr<DiskQword,64> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req ult %1 512
    @ens ule %99 511

    @b0
        jmp @b1 %1

    @b1 %2:bv64
        @inv ule %2 511
        %3 = const 511 bv64
        %4 = cmp ult %2 %3
        br %4 @b2 @b5

    @b2
        %5 = call std_mem_get_byte %0 %2
        %6 = const 32 bv64                  # ' ' (ASCII 32)
        %7 = cmp eq %5 %6
        %8 = const 9 bv64                   # '\t' (ASCII 9)
        %9 = cmp eq %5 %8
        %10 = or %7 %9
        br %10 @b3 @b4

    @b3
        %11 = const 1 bv64
        %12 = add %2 %11
        jmp @b1 %12

    @b4
        jmp @b6 %2

    @b5
        jmp @b6 %3

    @b6 %99:bv64
        @inv ule %99 511
        ret %99
}

# 1b. Chuyển ký tự ASCII hoa ('A'..'Z') thành chữ thường ('a'..'z')
func std_char_to_lower bv64 %0:bv64 {
    @req ult %0 256
    @ens ult %9 256

    @b0
        %1 = const 65 bv64                  # 'A'
        %2 = const 90 bv64                  # 'Z'
        %3 = cmp uge %0 %1
        %4 = cmp ule %0 %2
        %5 = and %3 %4
        br %5 @b1 @b2

    @b1
        %6 = const 32 bv64
        %7 = add %0 %6
        jmp @b3 %7

    @b2
        jmp @b3 %0

    @b3 %9:bv64
        @inv ult %9 256
        ret %9
}

# 2. Đọc từ đầu tiên từ vị trí %1 (tối đa 8 ký tự, dừng tại ' ', '\0', '\n') thành Qword chữ thường
func std_str_read_cmd_qword bv64 %0:ptr<DiskQword,64> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req ule %1 511

    @b0
        %2 = const 0 bv64                   # i = 0 (0..8)
        %3 = const 0 bv64                   # acc = 0
        jmp @b1 %1 %2 %3

    @b1 %4:bv64 %5:bv64 %6:bv64
        @inv ule %4 511
        @inv ule %5 8
        %7 = const 8 bv64
        %8 = cmp ult %5 %7
        %9 = const 511 bv64
        %10 = cmp ult %4 %9
        %11 = and %8 %10
        br %11 @b2 @b5

    @b2
        %12 = call std_mem_get_byte %0 %4
        %13 = const 0 bv64                  # '\0'
        %14 = cmp eq %12 %13
        %15 = const 32 bv64                 # ' '
        %16 = cmp eq %12 %15
        %17 = or %14 %16
        %18 = const 10 bv64                 # '\n'
        %19 = cmp eq %12 %18
        %20 = or %17 %19
        br %20 @b5 @b3

    @b3
        %200 = call std_char_to_lower %12
        %21 = const 3 bv64
        %22 = shl %5 %21                    # bit_shift = i * 8
        %23 = shl %200 %22                  # char_shifted = lower_byte << (i * 8)
        %24 = or %6 %23                     # acc = acc | char_shifted
        %25 = const 1 bv64
        %26 = add %4 %25
        %27 = add %5 %25
        jmp @b1 %26 %27 %24

    @b5
        ret %6
}

# =============================================================================
# PHẦN 5: TOÁN HỌC & KIỂM CHỨNG BIÊN NÂNG CAO (Z3 MODULAR CONTRACTS)
# =============================================================================

# 1. Kẹp giá trị %0 vào đoạn [%1 .. %2] - Đập tan Path Explosion của Z3!
func std_clamp bv64 %0:bv64 %1:bv64 %2:bv64 {
    @req ule %1 %2
    @ens uge %4 %1
    @ens ule %4 %2

    @b0
        %3 = call std_max %0 %1
        %4 = call std_min %3 %2
        ret %4
}

# 2. Kiểm tra %0 có thuộc nửa khoảng [%1, %2) (Trả về 0 hoặc 1 dưới dạng bv64)
func std_in_range bv64 %0:bv64 %1:bv64 %2:bv64 {
    @ens ule %5 1

    @b0
        %3 = cmp uge %0 %1
        %4 = cmp ult %0 %2
        %5 = and %3 %4
        ret %5
}

# 3. Bộ ép kiểu an toàn Zero-cost Casts từ bv8 / bv16 / bv32 sang bv64
func std_bv8_to_bv64 bv64 %0:bv8 {
    @ens ult %r 256

    @b0
        ret %0
}

# 4. Cộng bão hòa (Saturating Add) chặn trên bởi %2 không bao giờ tràn số
func std_sat_add bv64 %0:bv64 %1:bv64 %2:bv64 {
    @req ule %0 %2
    @ens uge %8 %0
    @ens ule %8 %2

    @b0
        %3 = sub %2 %0
        %4 = cmp ule %1 %3
        br %4 @b1 @b2

    @b1
        %5 = add %0 %1
        jmp @b3 %5

    @b2
        jmp @b3 %2

    @b3 %8:bv64
        @inv uge %8 %0
        @inv ule %8 %2
        ret %8
}

# 5. Trừ bão hòa (Saturating Sub) chặn dưới bởi 0 không bao giờ underflow
func std_sat_sub bv64 %0:bv64 %1:bv64 {
    @ens ule %6 %0

    @b0
        %2 = cmp uge %0 %1
        br %2 @b1 @b2

    @b1
        %3 = sub %0 %1
        jmp @b3 %3

    @b2
        %4 = const 0 bv64
        jmp @b3 %4

    @b3 %6:bv64
        @inv ule %6 %0
        ret %6
}

