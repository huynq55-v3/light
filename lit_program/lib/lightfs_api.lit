# File: lit_program/lib/lightfs_api.lit
# LightFS — phần dùng chung cho Kernel và App: truy cập bảng file, tên file, checksum, gửi yêu cầu tới Kernel.
# Định dạng đĩa: xem src/lightfs.rs. Bảng = 256 mục x 16 qword:
#   q0 cờ (1 dùng, 2 thư mục, 4 App)  q1 thư mục cha  q2 kích thước byte  q3 khối đầu  q4 số khối
#   q5 checksum dữ liệu  q6 thế hệ ghi  q7 dự trữ  q8..q15 tên (<= 63 byte, kết thúc bằng 0). Mục 0 = thư mục gốc.
#
# App gọi Kernel qua IpcChannel (Kernel phục vụ ngay sau lượt chạy của App rồi gọi App lại):
#   IPC 200 = mã lệnh, 208 = id, 216 = sector trong vùng State của App, 224 = độ dài/cờ, 232 = kết quả.
#   1 TABLE   chỉ làm mới bản sao bảng
#   2 READ    id -> dữ liệu file vào State từ sector `off`; kết quả = kích thước
#   3 WRITE   id <- `len` byte trong State từ sector `off` (ghi đè cả file, copy-on-write)
#   4 CREATE  thư mục cha = id, tên = 8 qword tại sector `off`, len bit 1 = thư mục; kết quả = id mới
#   5 DELETE  id (thư mục phải rỗng)
#   Kết quả lỗi có bit 63: 1 chưa gắn hệ tệp, 2 id sai, 3 sai loại (file/thư mục), 4 vượt vùng State,
#   5 hết chỗ, 6 bảng đầy, 7 tên sai/trùng, 8 dữ liệu hỏng (extent/checksum), 9 thư mục chưa rỗng, 10 lệnh lạ,
#   11 quá nhiều yêu cầu trong một nhịp.
#   Sau MỌI yêu cầu, Kernel chép bảng hiện hành vào State tại qword LFS_TAB_Q (sector 61376..61439).

include os_layout.lit
include std_lib.lit

def LFS_FNV 0x811c9dc5
def LFS_TAB_Q 3928064
def LFS_ARENA_SEC 61376
def IPC_FS_OP 200
def IPC_FS_ID 208
def IPC_FS_OFF 216
def IPC_FS_LEN 224
def IPC_FS_RES 232

# Qword k của mục i
func lfs_tget bv64 %0:ptr<DiskQword,4096> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req ult %1 256
    @req ult %2 16

    @b0
        %3 = const 4 bv64
        %4 = shl %1 %3
        %5 = add %4 %2
        %6 = slice %0 %5 ptr<DiskQword,1>
        %7 = load %6 0 bv64
        ret %7
}

func lfs_tset void %0:ptr<DiskQword,4096> %1:bv64 %2:bv64 %3:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req ult %1 256
    @req ult %2 16

    @b0
        %4 = const 4 bv64
        %5 = shl %1 %4
        %6 = add %5 %2
        %7 = slice %0 %6 ptr<DiskQword,1>
        store %7 0 %3
        ret
}

# 1 nếu mục i đang dùng và là thư mục
func lfs_is_dir bv64 %0:ptr<DiskQword,4096> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req ult %1 256
    @ens ule %6 1

    @b0
        %2 = const 0 bv64
        %3 = call lfs_tget %0 %1 %2
        %4 = const 3 bv64
        %5 = and %3 %4
        %7 = cmp eq %5 %4
        br %7 @b1 @b2

    @b1
        %8 = const 1 bv64
        jmp @b3 %8

    @b2
        jmp @b3 %2

    @b3 %6:bv64
        @inv ule %6 1
        ret %6
}

# 1 nếu mục i đang dùng và là file
func lfs_is_file bv64 %0:ptr<DiskQword,4096> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req ult %1 256
    @ens ule %6 1

    @b0
        %2 = const 0 bv64
        %3 = call lfs_tget %0 %1 %2
        %4 = const 3 bv64
        %5 = and %3 %4
        %9 = const 1 bv64
        %7 = cmp eq %5 %9
        br %7 @b1 @b2

    @b1
        jmp @b3 %9

    @b2
        jmp @b3 %2

    @b3 %6:bv64
        @inv ule %6 1
        ret %6
}

# 1 nếu tên của mục i trùng 8 qword %2
func lfs_name_eq bv64 %0:ptr<DiskQword,4096> %1:bv64 %2:ptr<DiskQword,8> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req uge %2 0x10000
    @req ult %2 0x10000000000
    @req ult %1 256
    @ens ule %20 1

    @b0
        %3 = const 0 bv64
        jmp @b1 %3

    @b1 %4:bv64
        @inv ule %4 8
        %5 = const 8 bv64
        %6 = cmp ult %4 %5
        br %6 @b2 @b4

    @b2
        %7 = add %4 %5
        %8 = call lfs_tget %0 %1 %7
        %9 = slice %2 %4 ptr<DiskQword,1>
        %10 = load %9 0 bv64
        %11 = cmp eq %8 %10
        br %11 @b3 @b5

    @b3
        %12 = const 1 bv64
        %13 = add %4 %12
        jmp @b1 %13

    @b4
        %14 = const 1 bv64
        jmp @b6 %14

    @b5
        jmp @b6 %3

    @b6 %20:bv64
        @inv ule %20 1
        ret %20
}

# Mục con đang dùng của thư mục %1 có tên %2: trả chỉ số 1..255, hoặc 0 nếu không có
func lfs_find_child bv64 %0:ptr<DiskQword,4096> %1:bv64 %2:ptr<DiskQword,8> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req uge %2 0x10000
    @req ult %2 0x10000000000
    @ens ult %20 256

    @b0
        %3 = const 1 bv64
        %4 = const 0 bv64
        jmp @b1 %3

    @b1 %5:bv64
        @inv uge %5 1
        @inv ule %5 256
        %6 = const 256 bv64
        %7 = cmp ult %5 %6
        br %7 @b2 @b5

    @b2
        %8 = call lfs_tget %0 %5 %4
        %9 = and %8 %3
        %10 = call lfs_tget %0 %5 %3
        %11 = cmp ne %9 %4
        %12 = cmp eq %10 %1
        %13 = and %11 %12
        br %13 @b3 @b4

    @b3
        %14 = call lfs_name_eq %0 %5 %2
        %15 = cmp ne %14 %4
        br %15 @b6 @b4

    @b4
        %16 = add %5 %3
        jmp @b1 %16

    @b5
        jmp @b7 %4

    @b6
        jmp @b7 %5

    @b7 %20:bv64
        @inv ult %20 256
        ret %20
}

# Tên hợp lệ: 1..63 byte in được (0x21..0x7e), không có '/', không phải "." hay "..", sau byte 0 đầu tiên toàn 0
func lfs_name_ok bv64 %0:ptr<DiskQword,8> {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @ens ule %30 1

    @b0
        %1 = const 0 bv64
        %2 = const 1 bv64
        %3 = slice %0 %1 ptr<DiskQword,1>
        %4 = load %3 0 bv64
        %5 = const 0x2e bv64
        %6 = const 0x2e2e bv64
        %7 = cmp eq %4 %5
        %8 = cmp eq %4 %6
        %9 = or %7 %8
        br %9 @b9 @b10

    @b10
        jmp @b1 %1 %1

    @b1 %10:bv64 %11:bv64
        # %10: vị trí byte (0..64), %11: 1 nếu đã gặp byte 0
        @inv ule %10 64
        @inv ule %11 1
        %12 = const 64 bv64
        %13 = cmp ult %10 %12
        br %13 @b2 @b8

    @b2
        %14 = const 3 bv64
        %15 = lshr %10 %14
        %16 = slice %0 %15 ptr<DiskQword,1>
        %17 = load %16 0 bv64
        %18 = const 7 bv64
        %19 = and %10 %18
        %20 = shl %19 %14
        %21 = lshr %17 %20
        %22 = const 0xff bv64
        %23 = and %21 %22
        %24 = cmp ne %11 %1
        br %24 @b3 @b4

    @b3
        # Sau byte 0: phải toàn 0
        %25 = cmp eq %23 %1
        br %25 @b7 @b9

    @b4
        %26 = cmp eq %23 %1
        br %26 @b5 @b6

    @b5
        # Byte 0 ở vị trí đầu = tên rỗng
        %27 = cmp eq %10 %1
        br %27 @b9 @b51

    @b51
        %28 = add %10 %2
        jmp @b1 %28 %2

    @b6
        %31 = const 0x21 bv64
        %32 = const 0x7f bv64
        %33 = const 0x2f bv64
        %34 = cmp ult %23 %31
        %35 = cmp uge %23 %32
        %36 = cmp eq %23 %33
        %37 = or %34 %35
        %38 = or %37 %36
        br %38 @b9 @b7

    @b7
        %39 = add %10 %2
        jmp @b1 %39 %11

    @b8
        # Hết 64 byte: hợp lệ chỉ khi đã gặp byte kết thúc (tên <= 63 byte)
        jmp @b11 %11

    @b9
        jmp @b11 %1

    @b11 %30:bv64
        @inv ule %30 1
        ret %30
}

# Một bước checksum (FNV-1a 32-bit trên hai nửa của qword %1). Trạng thái %0 < 2^32.
func lfs_cks_step bv64 %0:bv64 %1:bv64 {
    @req ult %0 0x100000000
    @ens ult %12 0x100000000

    @b0
        %2 = const 0xffffffff bv64
        %3 = const 0x01000193 bv64
        %4 = and %1 %2
        %5 = xor %0 %4
        %6 = mul %5 %3
        %7 = and %6 %2
        %8 = const 32 bv64
        %9 = lshr %1 %8
        %10 = xor %7 %9
        %11 = mul %10 %3
        %12 = and %11 %2
        ret %12
}

# Checksum %0 qword đầu của %1, tiếp từ trạng thái %2
func lfs_cks bv64 %0:bv64 %1:ptr<DiskQword,%0> %2:bv64 {
    @req uge %1 0x10000
    @req ult %1 0x10000000000
    @req ult %2 0x100000000
    @ens ult %20 0x100000000

    @b0
        %3 = const 0 bv64
        jmp @b1 %3 %2

    @b1 %4:bv64 %5:bv64
        @inv ult %5 0x100000000
        %6 = cmp ult %4 %0
        br %6 @b2 @b3

    @b2
        %7 = slice %1 %4 ptr<DiskQword,1>
        %8 = load %7 0 bv64
        %9 = call lfs_cks_step %5 %8
        %10 = const 1 bv64
        %11 = add %4 %10
        jmp @b1 %11 %9

    @b3
        jmp @b4 %5

    @b4 %20:bv64
        @inv ult %20 0x100000000
        ret %20
}

# Gửi yêu cầu tới Kernel (ghi mã lệnh sau cùng)
func lfs_request void %0:ptr<IpcChannel,1> %1:bv64 %2:bv64 %3:bv64 %4:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        store %0 IPC_FS_ID %2
        store %0 IPC_FS_OFF %3
        store %0 IPC_FS_LEN %4
        %5 = const 0 bv64
        store %0 IPC_FS_RES %5
        store %0 IPC_FS_OP %1
        ret
}

func lfs_result bv64 %0:ptr<IpcChannel,1> {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        %1 = load %0 IPC_FS_RES bv64
        ret %1
}

# 1 nếu kết quả là lỗi (bit 63)
func lfs_is_err bv64 %0:bv64 {
    @ens ule %3 1

    @b0
        %1 = const 63 bv64
        %3 = lshr %0 %1
        ret %3
}

# Mục con thứ %2 (0-based, theo thứ tự bảng) của thư mục %1: trả id 1..255, hoặc 0 nếu không có
func lfs_nth_child bv64 %0:ptr<DiskQword,4096> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @ens ult %20 256

    @b0
        %3 = const 0 bv64
        %4 = const 1 bv64
        jmp @b1 %4 %3

    @b1 %5:bv64 %6:bv64
        # %5: mục đang xét, %6: số mục con đã gặp
        @inv uge %5 1
        @inv ule %5 256
        @inv ult %6 %5
        %7 = const 256 bv64
        %8 = cmp ult %5 %7
        br %8 @b2 @b8

    @b2
        %9 = call lfs_tget %0 %5 %3
        %10 = and %9 %4
        %11 = call lfs_tget %0 %5 %4
        %12 = cmp ne %10 %3
        %13 = cmp eq %11 %1
        %14 = and %12 %13
        %15 = add %5 %4
        br %14 @b3 @b4

    @b3
        %16 = cmp eq %6 %2
        br %16 @b5 @b6

    @b5
        jmp @b9 %5

    @b6
        %17 = add %6 %4
        jmp @b1 %15 %17

    @b4
        jmp @b1 %15 %6

    @b8
        jmp @b9 %3

    @b9 %20:bv64
        @inv ult %20 256
        ret %20
}

# Thư mục cha của %1 (gốc -> 0); kết quả luôn < 256
func lfs_parent bv64 %0:ptr<DiskQword,4096> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x10000000000
    @req ult %1 256
    @ens ult %5 256

    @b0
        %2 = const 1 bv64
        %3 = call lfs_tget %0 %1 %2
        %4 = const 255 bv64
        %5 = call std_min %3 %4
        ret %5
}
