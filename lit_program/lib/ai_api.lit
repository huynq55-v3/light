# File: lit_program/lib/ai_api.lit
# ENGINE SUY LUẬN TRANSFORMER TRỰC TIẾP TRÊN VÙNG NHỚ 0x40000000 (weights.bin)

include std_tensor.lit

func ai_append_qword void %0:ptr<DiskQword,64> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ule %2 8

    @b0
        %3 = const 0 bv64
        jmp @b1 %3

    @b1 %4:bv64
        @inv ule %4 8
        %5 = cmp ult %4 %2
        br %5 @b2 @b3

    @b2
        %6 = const 3 bv64
        %7 = shl %4 %6
        %8 = lshr %1 %7
        %9 = const 0xff bv64
        %10 = and %8 %9
        %13 = cmp ne %10 %3
        br %13 @b21 @b3

    @b21
        call std_str_push_or_bs %0 %10
        %11 = const 1 bv64
        %12 = add %4 %11
        jmp @b1 %12

    @b3
        ret
}

# Chạy 1 bước Transformer Forward Pass hoàn chỉnh trên Trọng số ở 0x40000000 (%1)
func ai_transformer_step bv64 %0:ptr<DiskQword,64> %1:ptr<DiskQword,2048> %2:bv64 {
    # %0: scratch_buf, %1: weights_0x40000000, %2: input_token_id (0..63)
    @req uge %0 0x10000
    @req ult %0 0x70000000
    @req uge %1 0x10000
    @req ult %1 0x60000000
    @req ult %2 64
    @ens ult %26 64

    @b0
        # 1. Token Embedding Lookup: Đọc vector 8 chiều tại Qword (72 + token_id * 8) từ weights.bin
        %3 = const 3 bv64
        %4 = shl %2 %3
        %5 = const 72 bv64
        %6 = add %5 %4
        %7 = slice %1 %6 ptr<DiskQword,8>

        # Chép Embedding vào thanh ghi trạng thái ẩn x (%8) trong scratch_buf
        %8 = const 16 bv64
        %9 = slice %0 %8 ptr<DiskQword,8>   # Vector trạng thái ẩn x (8 chiều)
        %10 = const 24 bv64
        %11 = slice %0 %10 ptr<DiskQword,8> # Vector trung gian h (8 chiều)

        %12 = const 0 bv64
        jmp @b1 %12

    @b1 %13:bv64
        @inv ule %13 8
        %14 = const 8 bv64
        %15 = cmp ult %13 %14
        br %15 @b2 @b3

    @b2
        %16 = slice %7 %13 ptr<DiskQword,1>
        %17 = load %16 0 bv64
        %18 = slice %9 %13 ptr<DiskQword,1>
        store %18 0 %17
        %19 = const 1 bv64
        %20 = add %13 %19
        jmp @b1 %20

    @b3
        # 2. Tầng Attention: RMSNorm(x) -> MatMul(W_attn, x) -> Residual Add
        call tensor_rmsnorm8 %9
        %21 = const 584 bv64
        %22 = slice %1 %21 ptr<DiskQword,64>  # Ma trận W_attn tại Qword 584 của weights.bin
        call tensor_matmul8x8 %22 %9 %11
        call tensor_residual_add8 %9 %11

        # 3. Tầng FFN (Feed-Forward GeGLU): RMSNorm(x) -> MatMul(W_ffn, x) -> Residual Add
        call tensor_rmsnorm8 %9
        %23 = const 648 bv64
        %24 = slice %1 %23 ptr<DiskQword,64>  # Ma trận W_ffn tại Qword 648 của weights.bin
        call tensor_matmul8x8 %24 %9 %11
        call tensor_residual_add8 %9 %11

        # 4. Tầng Classifier: RMSNorm(x) -> Chọn Token tiếp theo từ W_cls tại Qword 712
        call tensor_rmsnorm8 %9
        %25 = const 712 bv64
        %27 = slice %1 %25 ptr<DiskQword,512>
        %26 = call tensor_classify_token %27 %9
        ret %26
}

func ai_chat_reply void %0:ptr<DiskQword,64> %1:ptr<DiskQword,2048> %2:io<0x3f8,0x3ff> {
    @req uge %0 0x10000
    @req ult %0 0x70000000
    @req uge %1 0x10000
    @req ult %1 0x60000000

    @b0
        # 1. Gửi câu hỏi vừa gõ trong AI CHAT ra cổng 0x3f8 sang Gemma
        %3 = call std_str_len %0
        %4 = const 0 bv64
        jmp @b1 %4

    @b1 %5:bv64
        @inv ule %5 512
        %6 = cmp ult %5 %3
        br %6 @b2 @b3

    @b2
        %7 = call std_mem_get_byte %0 %5
        hwio_w %2 0x3f8 %7
        %8 = const 1 bv64
        %9 = add %5 %8
        jmp @b1 %9

    @b3
        # Gửi byte 0x04 báo hiệu kết thúc câu hỏi
        %10 = const 4 bv8
        hwio_w %2 0x3f8 %10

        # In "\nGEMMA: " lên màn hình AI CHAT
        %11 = const 8 bv64
        %12 = const 0x203a414d4d45470a bv64 # "\nGEMMA: "
        call ai_append_qword %0 %12 %11

        # 2. Đợi Gemma trên CPU suy nghĩ và nhận toàn bộ câu trả lời (Thoát ngay khi gặp byte 0x04)
        jmp @b4 %4

    @b4 %13:bv64
        @inv ule %13 500000000
        %15 = const 500000000 bv64
        %16 = cmp ult %13 %15
        br %16 @b5 @b12

    @b5
        %17 = hwio_r %2 0x3fd
        %18 = const 1 bv64
        %19 = and %17 %18
        %20 = cmp ne %19 %4
        br %20 @b6 @b8

    @b6
        %21 = hwio_r %2 0x3f8
        %22 = const 0x7f bv64
        %23 = and %21 %22
        # Gặp byte 0x04 (Gemma đã trả lời xong) -> Thoát ngay ra @b12 để hiển thị lên màn hình!
        %24 = const 4 bv64
        %25 = cmp eq %23 %24
        br %25 @b12 @b7

    @b7
        call std_str_push_or_bs %0 %23
        jmp @b4 %4

    @b8
        %30 = const 1 bv64
        %31 = add %13 %30
        jmp @b4 %31

    @b12
        %46 = const 0x203e0a bv64           # "\n> "
        %47 = const 3 bv64
        call ai_append_qword %0 %46 %47
        ret
}

func ai_assist_buffer void %0:ptr<DiskQword,64> %1:ptr<DiskQword,2048> %2:io<0x3f8,0x3ff> {
    @req uge %0 0x10000
    @req ult %0 0x70000000
    @req uge %1 0x10000
    @req ult %1 0x60000000

    @b0
        call ai_chat_reply %0 %1 %2
        ret
}
