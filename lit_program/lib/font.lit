func font_get_glyph_top bv64 %c:bv64 {
    @b0
        %ok = cmp ult %c 128
        br %ok @hit @miss
    @hit
        %t = addr FONT_TOP
        %p = slice %t %c ptr<FontGlyph,1>
        %v = load %p 0 bv64
        ret %v
    @miss
        ret 0
}

func font_get_glyph_bot bv64 %c:bv64 {
    @b0
        %ok = cmp ult %c 128
        br %ok @hit @miss
    @hit
        %t = addr FONT_BOT
        %p = slice %t %c ptr<FontGlyph,1>
        %v = load %p 0 bv64
        ret %v
    @miss
        ret 0
}
