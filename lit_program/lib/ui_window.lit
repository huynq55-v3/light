# File: lit_program/lib/ui_window.lit
# Thư viện Quản lý Khung Cửa sổ (Window Frame, Title Bar, Close Button, Exit App)

include ui_button.lit
include os_layout.lit

# 1. Vẽ khung Cửa sổ Chuẩn (Bóng đổ, Thanh Tiêu đề Title Bar, Nút Đóng [X], Vùng nội dung Client)
func ui_win_draw void %0:ptr<VgaCell,921600> %1:ptr<DiskQword,64> %2:bv64 %3:bv64 %4:bv64 %5:bv64 %6:bv64 %7:bv32 {
    # %0: fb, %1: font_buf, %2: win_x, %3: win_y, %4: win_w, %5: win_h, %6: title_qword, %7: client_bg
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 40
    @req ule %2 380
    @req uge %3 30
    @req ule %3 160
    @req uge %4 400
    @req ule %4 890
    @req uge %5 200
    @req ule %5 550

    @b0
        # a. Vẽ bóng đổ ngoài cửa sổ (Chỉ vẽ 2 dải 6px bên phải và bên dưới, KHÔNG vẽ đè trong cửa sổ để chống nháy chớp đen!)
        %8 = const 6 bv64
        %9 = add %2 %8                      # win_x + 6
        %10 = add %3 %8                     # win_y + 6
        %11 = add %2 %4                     # win_x + win_w
        %12 = add %11 %8                    # win_x + win_w + 6
        %13 = add %3 %5                     # win_y + win_h
        %14 = add %13 %8                    # win_y + win_h + 6
        %15 = const 0x05070a bv32           # Màu bóng đổ tối

        # Dải bóng đổ bên phải (x = win_x + win_w .. win_x + win_w + 6, y = win_y + 6 .. win_y + win_h + 6)
        call gfx_fill_rect %0 %11 %10 %12 %14 %15
        # Dải bóng đổ bên dưới (x = win_x + 6 .. win_x + win_w, y = win_y + win_h .. win_y + win_h + 6)
        call gfx_fill_rect %0 %9 %13 %11 %14 %15

        # b. Vẽ 4 đường viền ngoài cửa sổ (Border 2px: 0x334155 - chỉ vẽ viền, KHÔNG tô ruột để chống nháy chớp!)
        %16 = const 0x334155 bv32
        %17 = const 2 bv64
        %18 = add %2 %17                    # win_x + 2
        %19 = add %3 %17                    # win_y + 2
        %20 = sub %11 %17                   # win_x + win_w - 2
        %46 = sub %13 %17                   # win_y + win_h - 2

        # Viền trên & dưới
        call gfx_fill_rect %0 %2 %3 %11 %19 %16
        call gfx_fill_rect %0 %2 %46 %11 %13 %16
        # Viền trái & phải
        call gfx_fill_rect %0 %2 %19 %18 %46 %16
        call gfx_fill_rect %0 %20 %19 %11 %46 %16

        # c. Vẽ Thanh Tiêu đề (Title Bar cao 32px: 0x0f172a)
        %21 = const 32 bv64
        %22 = add %3 %21
        %23 = const 0x0f172a bv32
        call gfx_fill_rect %0 %18 %19 %20 %22 %23

        # d. In tiêu đề cửa sổ (Font 16x16 trắng, căn lề trái)
        %24 = const 14 bv64
        %25 = add %2 %24
        %26 = const 8 bv64
        %27 = add %3 %26
        %28 = const 0xffffff bv32
        call gfx_draw_str8 %0 %1 %25 %27 %6 %28

        # e. Vẽ Nút Đóng [X] góc trên bên phải thanh tiêu đề (32x22 pixel, màu đỏ: 0xef4444)
        %29 = const 38 bv64
        %30 = sub %11 %29
        %31 = const 4 bv64
        %32 = add %3 %31
        %33 = const 6 bv64
        %34 = sub %11 %33
        %35 = const 28 bv64
        %36 = add %3 %35
        %37 = const 0xef4444 bv32
        call gfx_fill_rect %0 %30 %32 %34 %36 %37

        # Thêm vệt trắng ký hiệu nút đóng
        %38 = const 12 bv64
        %39 = add %30 %38
        %40 = const 8 bv64
        %41 = add %32 %40
        %42 = const 20 bv64
        %43 = add %30 %42
        %44 = const 16 bv64
        %45 = add %32 %44
        call gfx_fill_rect %0 %39 %41 %43 %45 %28

        # f. Vẽ Vùng làm việc Client Area (Tô đúng 1 lần duy nhất bằng màu client_bg)
        call gfx_fill_rect %0 %18 %22 %20 %46 %7
        ret
}

# 3. Kiểm tra người dùng có bấm vào nút Đóng [X] của cửa sổ không
func ui_win_check_close bv64 %0:bv64 %1:bv64 %2:bv64 %3:bv64 %4:bv64 %5:bv64 {
    # %0: mouse_x, %1: mouse_y, %2: mouse_click, %3: win_x, %4: win_y, %5: win_w
    @req ule %0 1280
    @req ule %1 720
    @req uge %3 40
    @req ule %3 380
    @req uge %4 30
    @req ule %4 160
    @req uge %5 400
    @req ule %5 890

    @b0
        # Vị trí nút X: bắt toàn bộ góc trên bên phải thanh tiêu đề (rộng 48px, cao 32px)
        %6 = add %3 %5
        %7 = const 48 bv64
        %8 = sub %6 %7
        %11 = const 48 bv64
        %12 = const 32 bv64
        %13 = call ui_btn_hit %0 %1 %2 %8 %4 %11 %12
        ret %13
}

# 4. Phát tín hiệu đóng App (offset 88 = 1) để Shell thu hồi tài nguyên và Reset App về như mới
func ui_win_close_app void %0:ptr<IpcChannel,1> {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        %1 = const 0 bv64
        %2 = const 1 bv64
        store %0 0 %1
        store %0 32 %1
        store %0 88 %2                      # Bật cờ ipc_win_cmd = 1 báo cho Shell biết App vừa bấm [X]!
        ret
}

# 5. Giao diện chuẩn dùng chung cho mọi App: Kiểm tra click nút [X] và tự động báo về Shell để đóng + Reset App
func ui_win_poll_close bv64 %0:ptr<IpcChannel,1> %1:bv64 %2:bv64 %3:bv64 {
    # %0: ipc, %1: win_x, %2: win_y, %3: win_w
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 40
    @req ule %1 380
    @req uge %2 30
    @req ule %2 160
    @req uge %3 400
    @req ule %3 890
    @ens ule %11 1

    @b0
        %4 = load %0 16 bv64                # mouse_x (< 1260)
        %5 = load %0 24 bv64                # mouse_y (< 700)
        %6 = load %0 32 bv64                # mouse_click
        %7 = call ui_win_check_close %4 %5 %6 %1 %2 %3
        %8 = const 0 bv64
        %9 = cmp ne %7 %8
        br %9 @b1 @b2

    @b1
        call ui_win_close_app %0
        %10 = const 1 bv64
        jmp @b3 %10

    @b2
        jmp @b3 %8

    @b3 %11:bv64
        @inv ule %11 1
        ret %11
}
