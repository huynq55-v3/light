# File: lit_program/drivers/backlight.lit
# Độ sáng màn hình laptop qua PWM đèn nền của GPU Intel (Tiger Lake / PCH >= CNP, đường "cnp" của driver i915 Linux).
#
# Firmware (GOP) đã bật đèn nền và đặt chu kỳ PWM; driver này CHỈ đổi độ rộng xung (DUTY), không đụng CTL / FREQ:
#   bộ điều khiển 0: CTL 0xC8250, FREQ 0xC8254, DUTY 0xC8258    bộ điều khiển 1: CTL 0xC8350, FREQ 0xC8354, DUTY 0xC8358
#   CTL bit 31 = đang bật (BXT_BLC_PWM_ENABLE), bit 29 = đảo cực (cực tính do phần cứng lo, DUTY ghi thẳng 0..FREQ)
# Chọn bộ điều khiển đang bật và có FREQ != 0 (i915 lấy số này từ VBT; ở đây suy từ trạng thái firmware để lại).
# Độ sáng kẹp trong [FREQ/16, FREQ] -> màn hình không bao giờ tắt hẳn. Không có GPU Intel (QEMU) -> không làm gì.
#
# BAR0 (GTTMMADR) của GPU 00:02.0 ánh xạ UC vào PD_MMIO[6] = ảo 0x80_40C0_0000 (2MB đầu, đủ chứa 0xC8xxx).
# Bảng HW: 310 = offset CTL của bộ điều khiển dùng được (0 = không có)   311 = FREQ
#          312 = dòng chẩn đoán BL: trạng thái << 56 | FREQ << 28 | DUTY
#                (trạng thái: 1/2 = dùng bộ điều khiển 0/1, 0xE0 không có GPU Intel, 0xE1 BAR lạ, 0xE2 không có PWM đang bật)
# Phím: F8 tối đi, F9 sáng lên (driver bàn phím ghi IpcChannel.hotkey = 2 / 3; Kernel gọi bl_tick mỗi nhịp).

include ../os/hw.lit

def BL_PD_IDX 6
def BL_STEPS 16

# Thanh ghi 32-bit tại offset %1 (< 2MB) của BAR0 GPU
func bl_reg ptr<Mmio32,1> %0:io<0,0xffff> %1:bv64 {
    @req ult %1 0x200000
    @b0
        %i = lshr %1 2
        %base = const 0x8040C00000 ptr<Mmio32,524288>
        %r = slice %base %i ptr<Mmio32,1>
        ret %r
}

func bl_rd bv64 %0:io<0,0xffff> %1:bv64 {
    @req ult %1 0x200000
    @ens ule %r 0xffffffff
    @b0
        %p = call bl_reg %0 %1
        %v = load %p 0 bv32
        %w = or %v 0
        ret %w
}

func bl_wr void %0:io<0,0xffff> %1:bv64 %2:bv64 {
    @req ult %1 0x200000
    @req ule %2 0xffffffff
    @b0
        %p = call bl_reg %0 %1
        %v = narrow %2 bv32
        store %p 0 %v
        ret
}

# 1 nếu bộ điều khiển có CTL ở offset %1 đang bật và có chu kỳ
func bl_ctl_ok bv64 %0:io<0,0xffff> %1:bv64 {
    @req ult %1 0x1ffff0
    @ens ule %r 1
    @b0
        %c = call bl_rd %0 %1
        %en = and %c 0x80000000
        %on = cmp ne %en 0
        br %on @freq @no
    @freq
        %fo = add %1 4
        %f = call bl_rd %0 %fo
        %has = cmp ne %f 0
        br %has @yes @no
    @yes
        ret 1
    @no
        ret 0
}

func bl_note void %0:io<0,0xffff> %1:bv64 {
    @b0
        %s = shl %1 56
        call hw_set %0 312 %s
        ret
}

# Ghi dòng chẩn đoán BL theo trạng thái hiện tại (bộ điều khiển đã chọn)
func bl_report void %0:io<0,0xffff> {
    @b0
        %ctl = call hw_get %0 310
        %c1 = call std_min %ctl 0xc8350
        %none = cmp eq %c1 0
        br %none @out @go
    @go
        %is1 = cmp eq %c1 0xc8350
        br %is1 @k1 @k0
    @k1
        jmp @pack 2
    @k0
        jmp @pack 1
    @pack %st:bv64
        @inv ule %st 2
        %fo = add %c1 4
        %f = call bl_rd %0 %fo
        %dof = add %c1 8
        %d = call bl_rd %0 %dof
        %f28 = and %f 0xfffffff
        %d28 = and %d 0xfffffff
        %s = shl %st 56
        %fs = shl %f28 28
        %a = or %s %fs
        %v = or %a %d28
        call hw_set %0 312 %v
        ret
    @out
        ret
}

# Tìm GPU Intel 00:02.0, ánh xạ BAR0, chọn bộ điều khiển PWM đang bật
func bl_init void %0:io<0,0xffff> {
    @b0
        call hw_set %0 310 0
        call hw_set %0 311 0
        %id = call pci_cfg_rd %0 0 2 0 0
        %ven = and %id 0xffff
        %cls = call pci_cfg_rd %0 0 2 0 8
        %cc = lshr %cls 24
        %intel = cmp eq %ven 0x8086
        %disp = cmp eq %cc 3
        %ok = and %intel %disp
        br %ok @bar @nogpu
    @nogpu
        call bl_note %0 0xe0
        ret
    @bar
        %b0 = call pci_cfg_rd %0 0 2 0 0x10
        %b1 = call pci_cfg_rd %0 0 2 0 0x14
        %lo = and %b0 0xfffffff0
        %t = and %b0 6
        %is64 = cmp eq %t 4
        br %is64 @hi @lo32
    @hi
        %h = shl %b1 32
        %a64 = or %lo %h
        jmp @chk %a64
    @lo32
        jmp @chk %lo
    @chk %phys:bv64
        # BAR phải khác 0, căn 2MB (GTTMMADR căn 16MB) và nằm dưới 64TB
        %al = and %phys 0x1fffff
        %aligned = cmp eq %al 0
        %nz = cmp ne %phys 0
        %low = cmp ult %phys 0x400000000000
        %g1 = and %aligned %nz
        %g = and %g1 %low
        br %g @map @badbar
    @badbar
        call bl_note %0 0xe1
        ret
    @map
        # bật giải mã bộ nhớ (MEM) nếu firmware chưa bật — GOP thường đã bật
        %cmd = call pci_cfg_rd %0 0 2 0 4
        %c16 = and %cmd 0xffff
        %cm = or %c16 2
        call pci_cfg_wr %0 0 2 0 4 %cm
        call mmio_map_2m %0 BL_PD_IDX %phys
        call mmu_flush %0
        %k0 = call bl_ctl_ok %0 0xc8250
        %u0 = cmp ne %k0 0
        br %u0 @use0 @try1
    @try1
        %k1 = call bl_ctl_ok %0 0xc8350
        %u1 = cmp ne %k1 0
        br %u1 @use1 @nopwm
    @use0
        jmp @use 0xc8250
    @use1
        jmp @use 0xc8350
    @use %ctl:bv64
        @inv ule %ctl 0xc8350
        call hw_set %0 310 %ctl
        %fo = add %ctl 4
        %f = call bl_rd %0 %fo
        call hw_set %0 311 %f
        call bl_report %0
        ret
    @nopwm
        call bl_note %0 0xe2
        ret
}

# Mức mới khi đổi 1 bậc (%up = 1 sáng lên, 0 tối đi), kẹp trong [freq/16, freq]
func bl_next bv64 %freq:bv64 %duty:bv64 %up:bv64 {
    @ens ule %r %freq
    @b0
        %step0 = udiv %freq BL_STEPS
        %step = call std_max %step0 1
        %lo0 = udiv %freq BL_STEPS
        %lo = call std_min %lo0 %freq
        %d = call std_min %duty %freq
        %u = cmp ne %up 0
        br %u @brighter @dimmer
    @brighter
        %n1 = add_sat %d %step
        %r1 = call std_min %n1 %freq
        ret %r1
    @dimmer
        %n2 = sub_sat %d %step
        %n3 = call std_max %n2 %lo
        %r2 = call std_min %n3 %freq
        ret %r2
}

# Mỗi nhịp WM: hotkey 2 (F8) tối đi, 3 (F9) sáng lên. Hotkey khác (1 = F10) để diag_tick xử lý.
func bl_tick void %0:io<0,0xffff> %g:ptr<IpcChannel,1> {
    @b0
        %h = load %g IpcChannel.hotkey
        %dn = cmp eq %h 2
        %upk = cmp eq %h 3
        %any = or %dn %upk
        br %any @take @out
    @take
        store %g IpcChannel.hotkey 0
        %ctl0 = call hw_get %0 310
        %ctl = call std_min %ctl0 0xc8350
        %has = cmp ne %ctl 0
        br %has @go @out
    @go
        %freq0 = call hw_get %0 311
        %freq = call std_min %freq0 0xffffffff
        %dof = add %ctl 8
        %duty = call bl_rd %0 %dof
        br %upk @u1 @u0
    @u1
        jmp @set 1
    @u0
        jmp @set 0
    @set %up:bv64
        @inv ule %up 1
        %nv = call bl_next %freq %duty %up
        call bl_wr %0 %dof %nv
        call bl_report %0
        ret
    @out
        ret
}
