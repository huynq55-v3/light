# File: lit_program/drivers/ata_disk.lit
include ../lib/os_layout.lit

# 1. Đọc 1 sector (512 bytes = 64 Qwords) từ ổ đĩa ATA Primary Master (LBA 28-bit)
func drv_ata_read_sector void %0:io<0x1f0,0x1f7> %1:ptr<DiskQword,64> %2:bv64 {
    @req uge %1 0x10000
    @req ult %1 0x10000000000
    @req ult %2 268435456

    @b0
        %3 = const 0xff bv64
        %4 = const 0xe0 bv64
        %5 = const 24 bv64
        %6 = lshr %2 %5
        %7 = and %2 %3
        %8 = const 8 bv64
        %9 = lshr %2 %8
        %10 = and %9 %3
        %11 = const 16 bv64
        %12 = lshr %2 %11
        %13 = and %12 %3
        %14 = and %6 %3
        %15 = or %4 %14
        %16 = const 1 bv64
        %17 = const 0x20 bv64

        hwio_w %0 0x1f6 %15
        hwio_w %0 0x1f2 %16
        hwio_w %0 0x1f3 %7
        hwio_w %0 0x1f4 %10
        hwio_w %0 0x1f5 %13
        hwio_w %0 0x1f7 %17

        %18 = const 0 bv64
        jmp @b1 %18

    @b1 %19:bv64
        @inv ule %19 10000
        %20 = const 10000 bv64
        %21 = cmp ult %19 %20
        br %21 @b2 @b4

    @b2
        %22 = hwio_r %0 0x1f7
        %23 = const 0x88 bv64
        %24 = and %22 %23
        %25 = const 0x08 bv64
        %26 = cmp eq %24 %25
        br %26 @b4 @b3

    @b3
        %27 = const 1 bv64
        %28 = add %19 %27
        jmp @b1 %28

    @b4
        %29 = const 0 bv64
        jmp @b5 %29

    @b5 %30:bv64
        @inv ule %30 64
        %31 = const 64 bv64
        %32 = cmp ult %30 %31
        br %32 @b6 @b7

    @b6
        %33 = const 0xffff bv64
        %34 = hwio_r %0 0x1f0
        %35 = and %34 %33
        %36 = hwio_r %0 0x1f0
        %37 = and %36 %33
        %38 = hwio_r %0 0x1f0
        %39 = and %38 %33
        %40 = hwio_r %0 0x1f0
        %41 = and %40 %33

        %42 = const 16 bv64
        %43 = const 32 bv64
        %44 = const 48 bv64
        %45 = shl %37 %42
        %46 = shl %39 %43
        %47 = shl %41 %44

        %48 = or %35 %45
        %49 = or %48 %46
        %50 = or %49 %47

        %51 = slice %1 %30 ptr<DiskQword,1>
        store %51 0 %50

        %52 = const 1 bv64
        %53 = add %30 %52
        jmp @b5 %53

    @b7
        ret
}

# 2. Ghi 1 sector (512 bytes = 64 Qwords) vào ổ đĩa ATA Primary Master
func drv_ata_write_sector void %0:io<0x1f0,0x1f7> %1:ptr<DiskQword,64> %2:bv64 {
    @req uge %1 0x10000
    @req ult %1 0x10000000000
    @req ult %2 268435456

    @b0
        %3 = const 0xff bv64
        %4 = const 0xe0 bv64
        %5 = const 24 bv64
        %6 = lshr %2 %5
        %7 = and %2 %3
        %8 = const 8 bv64
        %9 = lshr %2 %8
        %10 = and %9 %3
        %11 = const 16 bv64
        %12 = lshr %2 %11
        %13 = and %12 %3
        %14 = and %6 %3
        %15 = or %4 %14
        %16 = const 1 bv64
        %17 = const 0x30 bv64

        hwio_w %0 0x1f6 %15
        hwio_w %0 0x1f2 %16
        hwio_w %0 0x1f3 %7
        hwio_w %0 0x1f4 %10
        hwio_w %0 0x1f5 %13
        hwio_w %0 0x1f7 %17

        %18 = const 0 bv64
        jmp @b1 %18

    @b1 %19:bv64
        @inv ule %19 10000
        %20 = const 10000 bv64
        %21 = cmp ult %19 %20
        br %21 @b2 @b4

    @b2
        %22 = hwio_r %0 0x1f7
        %23 = const 0x88 bv64
        %24 = and %22 %23
        %25 = const 0x08 bv64
        %26 = cmp eq %24 %25
        br %26 @b4 @b3

    @b3
        %27 = const 1 bv64
        %28 = add %19 %27
        jmp @b1 %28

    @b4
        %29 = const 0 bv64
        jmp @b5 %29

    @b5 %30:bv64
        @inv ule %30 64
        %31 = const 64 bv64
        %32 = cmp ult %30 %31
        br %32 @b6 @b7

    @b6
        %33 = slice %1 %30 ptr<DiskQword,1>
        %34 = load %33 0 bv64

        %35 = const 0xffff bv64
        %36 = and %34 %35

        %37 = const 16 bv64
        %38 = const 32 bv64
        %39 = const 48 bv64

        %40 = lshr %34 %37
        %41 = and %40 %35

        %42 = lshr %34 %38
        %43 = and %42 %35

        %44 = lshr %34 %39
        %45 = and %44 %35

        hwio_w %0 0x1f0 %36
        hwio_w %0 0x1f0 %41
        hwio_w %0 0x1f0 %43
        hwio_w %0 0x1f0 %45

        %46 = const 1 bv64
        %47 = add %30 %46
        jmp @b5 %47

    @b7
        %48 = const 0xe7 bv64
        hwio_w %0 0x1f7 %48
        ret
}

# 3. Nạp 256 Sector (131.072 bytes = 16384 Qwords) mã máy của App từ đĩa vào Lô 64GB riêng biệt
func drv_ata_load_app void %0:io<0x1f0,0x1f7> %1:ptr<DiskQword,16384> %2:bv64 {
    @req uge %1 0x10000
    @req ult %1 0x10000000000
    @req ult %2 268435000

    @b0
        %3 = const 0 bv64
        jmp @b1 %3

    @b1 %4:bv64
        @inv ule %4 256
        %5 = const 256 bv64
        %6 = cmp ult %4 %5
        br %6 @b2 @b3

    @b2
        %7 = const 6 bv64
        %8 = shl %4 %7
        %9 = slice %1 %8 ptr<DiskQword,64>
        %10 = add %2 %4
        call drv_ata_read_sector %0 %9 %10
        %11 = const 1 bv64
        %12 = add %4 %11
        jmp @b1 %12

    @b3
        ret
}
