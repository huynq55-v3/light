# File: lit_program/drivers/blk.lit
# Tầng thiết bị khối: NVMe nếu có (máy thật, QEMU -device nvme), ngược lại ATA PIO (QEMU IDE), không có gì thì
# đọc ra 0 và bỏ qua ghi. LBA ở đây là LBA của "đĩa Light" (với NVMe: tương đối với phân vùng lightos).

include ata_disk.lit
include nvme.lit

# Chọn backend lúc boot, ghi HW[16] (0 không có, 1 ATA, 2 NVMe) và HW[20] (mã giai đoạn NVMe, 0 = OK)
func blk_init void %0:io<0,0xffff> {
    @b0
        %1 = const 16 bv64
        %2 = const 20 bv64
        %3 = const 0 bv64
        call hw_set %0 %1 %3
        %4 = call nvme_init_ctrl %0
        call hw_set %0 %2 %4
        %5 = cmp eq %4 %3
        br %5 @b9 @b1

    @b1
        # Có thể NVMe đã được chọn nhưng thiếu phân vùng: không rơi về ATA nếu có NVMe trên máy (HW[30] != 0)
        %6 = const 1 bv64
        %7 = cmp eq %4 %6
        br %7 @b2 @b9

    @b2
        # Không có NVMe: ATA chỉ khi cổng trạng thái có thiết bị (bus trôi đọc ra 0xff)
        %8 = hwio_r %0 0x1f7
        %9 = const 0xff bv64
        %10 = cmp ne %8 %9
        br %10 @b3 @b9

    @b3
        %11 = const 1 bv64
        call hw_set %0 %1 %11
        jmp @b9

    @b9
        ret
}

func blk_backend bv64 %0:io<0,0xffff> {
    @b0
        %1 = const 16 bv64
        %2 = call hw_get %0 %1
        ret %2
}

func blk_read_sector void %0:io<0,0xffff> %1:ptr<DiskQword,64> %2:bv64 {
    @b0
        %3 = call blk_backend %0
        %4 = const 2 bv64
        %5 = cmp eq %3 %4
        br %5 @b1 @b2

    @b1
        %6 = const 64 bv64
        %7 = const 1 bv64
        %8 = call nvme_read_into %0 %6 %1 %2 %7
        ret

    @b2
        %9 = const 1 bv64
        %10 = cmp eq %3 %9
        %11 = const 268435456 bv64
        %12 = cmp ult %2 %11
        %13 = and %10 %12
        br %13 @b3 @b4

    @b3
        call drv_ata_read_sector %0 %1 %2
        ret

    @b4
        call std_mem_zero %1
        ret
}

func blk_write_sector void %0:io<0,0xffff> %1:ptr<DiskQword,64> %2:bv64 {
    @b0
        %3 = call blk_backend %0
        %4 = const 2 bv64
        %5 = cmp eq %3 %4
        br %5 @b1 @b2

    @b1
        %6 = const 64 bv64
        %7 = const 1 bv64
        %8 = call nvme_write_from %0 %6 %1 %2 %7
        ret

    @b2
        %9 = const 1 bv64
        %10 = cmp eq %3 %9
        %11 = const 268435456 bv64
        %12 = cmp ult %2 %11
        %13 = and %10 %12
        br %13 @b3 @b4

    @b3
        call drv_ata_write_sector %0 %1 %2
        ret

    @b4
        ret
}

# Đọc %3 sector liên tiếp (1..256) từ LBA %2 vào %1
func blk_read_batch void %0:io<0,0xffff> %1:ptr<DiskQword,16384> %2:bv64 %3:bv64 {
    @req uge %3 1
    @req ule %3 256

    @b0
        %4 = call blk_backend %0
        %5 = const 2 bv64
        %6 = cmp eq %4 %5
        br %6 @b1 @b5

    @b1
        %7 = const 128 bv64
        %8 = call std_min %3 %7
        %9 = const 16384 bv64
        %10 = call nvme_read_into %0 %9 %1 %2 %8
        %11 = cmp ugt %3 %7
        br %11 @b2 @b9

    @b2
        %12 = const 8192 bv64
        %13 = slice %1 %12 ptr<DiskQword,8192>
        %14 = sub %3 %7
        %15 = const 0xffffffffffffff7f bv64
        %16 = call std_min %2 %15
        %17 = add %16 %7
        %18 = call nvme_read_into %0 %12 %13 %17 %14
        jmp @b9

    @b5
        %19 = const 1 bv64
        %20 = cmp eq %4 %19
        %21 = const 268435456 bv64
        %22 = cmp ult %2 %21
        %23 = and %20 %22
        br %23 @b6 @b9

    @b6
        call drv_ata_read_sectors_batch %0 %1 %2 %3
        jmp @b9

    @b9
        ret
}

# Nạp 2048 sector (1MB mã App) từ LBA %2 vào %1
func blk_load_app void %0:io<0,0xffff> %1:ptr<DiskQword,131072> %2:bv64 {
    @b0
        %3 = call blk_backend %0
        %4 = const 2 bv64
        %5 = cmp eq %3 %4
        br %5 @b1 @b5

    @b1
        %6 = const 0 bv64
        %7 = const 0xfffffffffffff7ff bv64
        %8 = call std_min %2 %7
        jmp @b2 %6

    @b2 %9:bv64
        @inv ule %9 16
        %10 = const 16 bv64
        %11 = cmp ult %9 %10
        br %11 @b3 @b9

    @b3
        %12 = const 13 bv64
        %13 = shl %9 %12                    # j * 8192 qword
        %14 = slice %1 %13 ptr<DiskQword,8192>
        %15 = const 7 bv64
        %16 = shl %9 %15                    # j * 128 sector
        %17 = add %8 %16
        %18 = const 8192 bv64
        %19 = const 128 bv64
        %20 = call nvme_read_into %0 %18 %14 %17 %19
        %21 = const 1 bv64
        %22 = add %9 %21
        jmp @b2 %22

    @b5
        %23 = const 1 bv64
        %24 = cmp eq %3 %23
        %25 = const 268430000 bv64
        %26 = cmp ult %2 %25
        %27 = and %24 %26
        br %27 @b6 @b9

    @b6
        call drv_ata_load_app %0 %1 %2
        jmp @b9

    @b9
        ret
}
