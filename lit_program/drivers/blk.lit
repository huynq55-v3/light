# File: lit_program/drivers/blk.lit
# Tầng thiết bị khối: NVMe nếu có (máy thật, QEMU -device nvme), ngược lại ATA PIO (QEMU IDE), không có gì thì
# đọc ra 0 và bỏ qua ghi. LBA ở đây là LBA của "đĩa Light" (với NVMe: tương đối với phân vùng lightos).

include ata_disk.lit
include nvme.lit

# Chọn backend lúc boot, ghi HW[16] (0 không có, 1 ATA, 2 NVMe) và HW[20] (mã giai đoạn NVMe, 0 = OK)
func blk_init void %0:io<0,0xffff> {
    @b0
        %1 = const 16 bv64
        %2 = const 20 bv64
        %3 = const 0 bv64
        call hw_set %0 %1 %3
        %4 = call nvme_init_ctrl %0
        call hw_set %0 %2 %4
        %5 = cmp eq %4 %3
        br %5 @b9 @b1

    @b1
        # Có thể NVMe đã được chọn nhưng thiếu phân vùng: không rơi về ATA nếu có NVMe trên máy (HW[30] != 0)
        %6 = const 1 bv64
        %7 = cmp eq %4 %6
        br %7 @b2 @b9

    @b2
        # Không có NVMe: ATA chỉ khi cổng trạng thái có thiết bị (bus trôi đọc ra 0xff)
        %8 = hwio_r %0 0x1f7
        %9 = const 0xff bv64
        %10 = cmp ne %8 %9
        br %10 @b3 @b9

    @b3
        %11 = const 1 bv64
        call hw_set %0 %1 %11
        jmp @b9

    @b9
        ret
}

func blk_backend bv64 %0:io<0,0xffff> {
    @b0
        %1 = const 16 bv64
        %2 = call hw_get %0 %1
        ret %2
}

func blk_read_sector void %0:io<0,0xffff> %1:ptr<DiskQword,64> %2:bv64 {
    @b0
        %3 = call blk_backend %0
        %4 = const 2 bv64
        %5 = cmp eq %3 %4
        br %5 @b1 @b2

    @b1
        %6 = const 64 bv64
        %7 = const 1 bv64
        %8 = call nvme_read_into %0 %6 %1 %2 %7
        ret

    @b2
        %9 = const 1 bv64
        %10 = cmp eq %3 %9
        %11 = const 268435456 bv64
        %12 = cmp ult %2 %11
        %13 = and %10 %12
        br %13 @b3 @b4

    @b3
        call drv_ata_read_sector %0 %1 %2
        ret

    @b4
        call std_mem_zero %1
        ret
}

func blk_write_sector void %0:io<0,0xffff> %1:ptr<DiskQword,64> %2:bv64 {
    @b0
        %3 = call blk_backend %0
        %4 = const 2 bv64
        %5 = cmp eq %3 %4
        br %5 @b1 @b2

    @b1
        %6 = const 64 bv64
        %7 = const 1 bv64
        %8 = call nvme_write_from %0 %6 %1 %2 %7
        ret

    @b2
        %9 = const 1 bv64
        %10 = cmp eq %3 %9
        %11 = const 268435456 bv64
        %12 = cmp ult %2 %11
        %13 = and %10 %12
        br %13 @b3 @b4

    @b3
        call drv_ata_write_sector %0 %1 %2
        ret

    @b4
        ret
}

# Đợi mọi lần ghi trước nằm trên vật lý (rào chắn cho copy-on-write của LightFS)
func blk_flush void %0:io<0,0xffff> {
    @b0
        %1 = call blk_backend %0
        %2 = const 2 bv64
        %3 = cmp eq %1 %2
        br %3 @b1 @b2

    @b1
        %4 = call nvme_flush %0
        ret

    @b2
        %5 = const 1 bv64
        %6 = cmp eq %1 %5
        br %6 @b3 @b4

    @b3
        call drv_ata_flush %0
        ret

    @b4
        ret
}

# Đọc (%5 = 0) hoặc ghi (%5 = 1) %4 sector từ/đến LBA %3, vùng nhớ %2 có độ dài động %1 qword (>= %4 * 64)
func blk_rw_dyn void %0:io<0,0xffff> %1:bv64 %2:ptr<DiskQword,%1> %3:bv64 %4:bv64 %5:bv64 {
    @req ule %4 0x100000
    @req ule mul %4 64 %1
    @req ult %3 0x100000000
    @req uge %2 0x10000
    @req ult %2 0x10000000000

    @b0
        %6 = call blk_backend %0
        %7 = const 2 bv64
        %8 = cmp eq %6 %7
        %9 = const 0 bv64
        br %8 @b80 @b5

    @b80
        jmp @b1 %9

    @b1 %10:bv64
        # NVMe: từng khúc tối đa 128 sector
        @inv ule %10 %4
        %11 = cmp ult %10 %4
        br %11 @b2 @b9

    @b2
        %12 = sub %4 %10
        %13 = const 128 bv64
        %14 = call std_min %12 %13
        %15 = const 6 bv64
        %16 = shl %10 %15
        %17 = sub %1 %16
        %18 = slice %2 %16 ptr<DiskQword,%17>
        %19 = add %3 %10
        %20 = cmp eq %5 %9
        br %20 @b3 @b4

    @b3
        %21 = call nvme_read_into %0 %17 %18 %19 %14
        jmp @b31

    @b4
        %22 = call nvme_write_from %0 %17 %18 %19 %14
        jmp @b31

    @b31
        %23 = add %10 %14
        jmp @b1 %23

    @b5
        jmp @b6 %9

    @b6 %30:bv64
        # ATA / không có đĩa: từng sector
        @inv ule %30 %4
        %31 = cmp ult %30 %4
        br %31 @b7 @b9

    @b7
        %32 = const 6 bv64
        %33 = shl %30 %32
        %34 = slice %2 %33 ptr<DiskQword,64>
        %35 = add %3 %30
        %36 = cmp eq %5 %9
        br %36 @b71 @b72

    @b71
        call blk_read_sector %0 %34 %35
        jmp @b73

    @b72
        call blk_write_sector %0 %34 %35
        jmp @b73

    @b73
        %37 = const 1 bv64
        %38 = add %30 %37
        jmp @b6 %38

    @b9
        ret
}

