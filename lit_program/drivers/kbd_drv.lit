# File: lit_program/drivers/kbd_drv.lit
# Driver Chuột + Bàn phím PS/2
include ../lib/os_layout.lit
include ../lib/ipc_bus.lit

layout KeyMap 8 {
    0: bv64
}

func drv_kbd_init void %0:io<0x60,0x64> %1:ptr<KeyMap,8> {
    @req uge %1 0x10000
    @req ult %1 0x80000000

    @b0
        %2 = const 0 bv64
        %3 = slice %1 %2 ptr<KeyMap,1>
        %4 = const 0x3635343332311b00 bv64
        store %3 0 %4

        %5 = const 1 bv64
        %6 = slice %1 %5 ptr<KeyMap,1>
        %7 = const 0x20083d2d30393837 bv64
        store %6 0 %7

        %8 = const 2 bv64
        %9 = slice %1 %8 ptr<KeyMap,1>
        %10 = const 0x6975797472657771 bv64
        store %9 0 %10

        %11 = const 3 bv64
        %12 = slice %1 %11 ptr<KeyMap,1>
        %13 = const 0x7361000a5d5b706f bv64
        store %12 0 %13

        %14 = const 4 bv64
        %15 = slice %1 %14 ptr<KeyMap,1>
        %16 = const 0x3b6c6b6a68676664 bv64
        store %15 0 %16

        %17 = const 5 bv64
        %18 = slice %1 %17 ptr<KeyMap,1>
        %19 = const 0x7663787a00000000 bv64
        store %18 0 %19

        %20 = const 6 bv64
        %21 = slice %1 %20 ptr<KeyMap,1>
        %22 = const 0x00002f2e2c6d6e62 bv64
        store %21 0 %22

        %23 = const 7 bv64
        %24 = slice %1 %23 ptr<KeyMap,1>
        %25 = const 0x0000000000002000 bv64
        store %24 0 %25

        %26 = const 0xa8 bv8
        hwio_w %0 0x64 %26
        %27 = const 0xd4 bv8
        hwio_w %0 0x64 %27
        %28 = const 0xf4 bv8
        hwio_w %0 0x60 %28
        %29 = hwio_r %0 0x60
        ret
}

# Xử lý gói tin 3-byte của Chuột với phát hiện Sườn Lên (Rising-Edge Click)
func drv_mouse_handle_byte void %0:ptr<IpcChannel,1> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        %2 = load %0 40 bv64
        %3 = const 0 bv64
        %4 = cmp eq %2 %3
        br %4 @b1 @b2

    @b1
        %5 = const 8 bv64
        %6 = and %1 %5
        %7 = cmp ne %6 %3
        br %7 @b3 @b12

    @b3
        # Chỉ kích hoạt mouse_click = 1 khi nút trái chuyển từ Nhả (0) sang Nhấn (1)!
        %8 = const 1 bv64
        %9 = load %0 48 bv64
        %50 = and %9 %8
        %51 = and %1 %8
        %52 = xor %50 %8
        %53 = and %51 %52
        store %0 48 %1
        store %0 40 %8
        %54 = cmp ne %53 %3
        br %54 @b19 @b12

    @b19
        store %0 32 %8
        jmp @b12

    @b2
        %10 = const 1 bv64
        %11 = cmp eq %2 %10
        br %11 @b4 @b5

    @b4
        # Byte 1: Quãng đường ngang dx thực tế (%1 = 0..255)
        %12 = load %0 48 bv64
        %13 = load %0 16 bv64
        %14 = const 2 bv64
        store %0 40 %14
        %15 = const 0xff bv64
        %16 = and %1 %15
        %17 = const 16 bv64
        %18 = and %12 %17
        %19 = cmp eq %18 %3
        br %19 @b6 @b7

    @b6
        %20 = shl %16 %10
        %21 = add %13 %20
        %22 = const 1259 bv64
        %23 = cmp ult %21 %22
        br %23 @b8 @b9

    @b8
        store %0 16 %21
        jmp @b12

    @b9
        store %0 16 %22
        jmp @b12

    @b7
        %24 = const 256 bv64
        %25 = sub %24 %16
        %26 = shl %25 %10
        %27 = cmp ugt %13 %26
        br %27 @b10 @b11

    @b10
        %28 = sub %13 %26
        store %0 16 %28
        jmp @b12

    @b11
        store %0 16 %3
        jmp @b12

    @b5
        # Byte 2: Quãng đường dọc dy thực tế (%1 = 0..255)
        %29 = load %0 48 bv64
        %30 = load %0 24 bv64
        store %0 40 %3
        %31 = const 0xff bv64
        %32 = and %1 %31
        %33 = const 32 bv64
        %34 = and %29 %33
        %35 = cmp eq %34 %3
        br %35 @b13 @b14

    @b13
        %36 = shl %32 %10
        %37 = cmp ugt %30 %36
        br %37 @b15 @b16

    @b15
        %38 = sub %30 %36
        store %0 24 %38
        jmp @b12

    @b16
        store %0 24 %3
        jmp @b12

    @b14
        %39 = const 256 bv64
        %40 = sub %39 %32
        %41 = shl %40 %10
        %42 = add %30 %41
        %43 = const 699 bv64
        %44 = cmp ult %42 %43
        br %44 @b17 @b18

    @b17
        store %0 24 %42
        jmp @b12

    @b18
        store %0 24 %43
        jmp @b12

    @b12
        ret
}
func kbd_apply_shift bv8 %0:bv64 %1:bv64 {
    # %0: ascii_char, %1: shift_mask (bit 0 = shift_down, bit 1 = caps_lock)
    @ens ult %40 128

    @b0
        %2 = const 0x7f bv64
        %3 = and %0 %2
        %4 = const 0 bv64

        # Trích xuất shift_bit và caps_bit
        %201 = const 1 bv64
        %202 = and %1 %201
        %203 = lshr %1 %201
        %204 = and %203 %201
        %205 = xor %202 %204

        # Kiểm tra nếu là chữ cái 'a' (97) .. 'z' (122)
        %210 = const 97 bv64
        %211 = cmp uge %3 %210
        %212 = const 122 bv64
        %213 = cmp ule %3 %212
        %214 = and %211 %213
        br %214 @b900 @b901

    @b900
        # Chữ cái: nếu xor(shift, caps) == 1 -> chuyển thành chữ hoa ('A'..'Z')
        %215 = cmp ne %205 %4
        br %215 @b902 @b99

    @b902
        %216 = const 32 bv64
        %217 = sub %3 %216
        jmp @b100 %217

    @b901
        # Ký tự đặc biệt hoặc số: chỉ phụ thuộc shift_bit
        %220 = cmp eq %202 %4
        br %220 @b99 @b1

    @b1
        # '=' (61) -> '+' (43)
        %6 = const 61 bv64
        %7 = cmp eq %3 %6
        br %7 @b10 @b2

    @b10
        %8 = const 43 bv64
        jmp @b100 %8

    @b2
        # '/' (47) -> '?' (63)
        %9 = const 47 bv64
        %10 = cmp eq %3 %9
        br %10 @b20 @b3

    @b20
        %11 = const 63 bv64
        jmp @b100 %11

    @b3
        # '1' (49) -> '!' (33)
        %12 = const 49 bv64
        %13 = cmp eq %3 %12
        br %13 @b30 @b4

    @b30
        %14 = const 33 bv64
        jmp @b100 %14

    @b4
        # '3' (51) -> '#' (35)
        %15 = const 51 bv64
        %16 = cmp eq %3 %15
        br %16 @b40 @b5

    @b40
        %17 = const 35 bv64
        jmp @b100 %17

    @b5
        # '5' (53) -> '%' (37)
        %18 = const 53 bv64
        %19 = cmp eq %3 %18
        br %19 @b50 @b6

    @b50
        %20 = const 37 bv64
        jmp @b100 %20

    @b6
        # '7' (55) -> '&' (38)
        %21 = const 55 bv64
        %22 = cmp eq %3 %21
        br %22 @b60 @b7

    @b60
        %23 = const 38 bv64
        jmp @b100 %23

    @b7
        # '8' (56) -> '*' (42)
        %24 = const 56 bv64
        %25 = cmp eq %3 %24
        br %25 @b70 @b8

    @b70
        %26 = const 42 bv64
        jmp @b100 %26

    @b8
        # '9' (57) -> '(' (40)
        %27 = const 57 bv64
        %28 = cmp eq %3 %27
        br %28 @b80 @b9

    @b80
        %29 = const 40 bv64
        jmp @b100 %29

    @b9
        # '0' (48) -> ')' (41)
        %30 = const 48 bv64
        %31 = cmp eq %3 %30
        br %31 @b90 @b11

    @b90
        %32 = const 41 bv64
        jmp @b100 %32

    @b11
        # '-' (45) -> '_' (95)
        %33 = const 45 bv64
        %34 = cmp eq %3 %33
        br %34 @b110 @b12

    @b110
        %35 = const 95 bv64
        jmp @b100 %35

    @b12
        # ';' (59) -> ':' (58)
        %36 = const 59 bv64
        %37 = cmp eq %3 %36
        br %37 @b120 @b13

    @b120
        %38 = const 58 bv64
        jmp @b100 %38

    @b13
        # '[' (91) -> '{' (123)
        %41 = const 91 bv64
        %42 = cmp eq %3 %41
        br %42 @b130 @b14

    @b130
        %43 = const 123 bv64
        jmp @b100 %43

    @b14
        # ']' (93) -> '}' (125)
        %44 = const 93 bv64
        %45 = cmp eq %3 %44
        br %45 @b140 @b15

    @b140
        %46 = const 125 bv64
        jmp @b100 %46

    @b15
        # '.' (46) -> '>' (62)
        %47 = const 46 bv64
        %48 = cmp eq %3 %47
        br %48 @b150 @b99

    @b150
        %49 = const 62 bv64
        jmp @b100 %49

    @b99
        jmp @b100 %3

    @b100 %40:bv64
        @inv ult %40 128
        ret %40
}

# 3. Lắng nghe và đọc gói tin Bàn phím (Hỗ trợ giữ/nhả Shift) & Chuột
func drv_kbd_poll_task void %0:io<0x60,0x64> %1:ptr<KeyMap,8> %2:ptr<IpcChannel,1> {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000

    @b0
        %3 = const 0 bv64
        jmp @b1 %3

    @b1 %4:bv64
        @inv ule %4 24
        %5 = const 24 bv64
        %6 = cmp ult %4 %5
        br %6 @b2 @b9

    @b2
        %7 = hwio_r %0 0x64
        %8 = const 1 bv64
        %9 = and %7 %8
        %10 = const 0 bv64
        %11 = cmp ne %9 %10
        br %11 @b3 @b9

    @b3
        %12 = hwio_r %0 0x60
        %13 = const 32 bv64
        %14 = and %7 %13
        %15 = cmp ne %14 %10
        br %15 @b4 @b5

    @b4
        call drv_mouse_handle_byte %2 %12
        jmp @b8

    @b5
        # Kiểm tra Nhấn phím Shift: Left Shift (42) hoặc Right Shift (54)
        %30 = const 42 bv64
        %31 = const 54 bv64
        %32 = cmp eq %12 %30
        %33 = cmp eq %12 %31
        %34 = or %32 %33
        br %34 @b51 @b52

    @b51
        %300 = load %2 160 bv64
        %301 = const 1 bv64
        %302 = or %300 %301
        store %2 160 %302                   # shift_bit = 1
        jmp @b8

    @b52
        # Kiểm tra Nhả phím Shift: Left Shift Release (170) hoặc Right Shift Release (182)
        %35 = const 170 bv64
        %36 = const 182 bv64
        %37 = cmp eq %12 %35
        %38 = cmp eq %12 %36
        %39 = or %37 %38
        br %39 @b53 @b520

    @b53
        %303 = load %2 160 bv64
        %304 = const 0xfffffffffffffffe bv64
        %305 = and %303 %304
        store %2 160 %305                   # shift_bit = 0
        jmp @b8

    @b520
        # Kiểm tra Phím Caps Lock (58)
        %310 = const 58 bv64
        %311 = cmp eq %12 %310
        br %311 @b521 @b54

    @b521
        %312 = load %2 160 bv64
        %313 = const 2 bv64
        %314 = xor %312 %313
        store %2 160 %314                   # đảo trạng thái caps_lock
        jmp @b8

    @b54
        %16 = const 64 bv64
        %17 = cmp ult %12 %16
        br %17 @b6 @b8

    @b6
        %18 = const 3 bv64
        %19 = lshr %12 %18
        %20 = slice %1 %19 ptr<KeyMap,1>
        %21 = load %20 0 bv64

        %22 = const 7 bv64
        %23 = and %12 %22
        %24 = shl %23 %18
        %25 = lshr %21 %24
        %26 = const 0x7f bv64
        %27 = and %25 %26

        %28 = cmp ugt %27 %10
        br %28 @b7 @b8

    @b7
        %40 = load %2 160 bv64              # Đọc trạng thái shift_down
        %41 = call kbd_apply_shift %27 %40
        call ipc_key_push %2 %41
        jmp @b8

    @b8
        %29 = add %4 %8
        jmp @b1 %29

    @b9
        ret
}
