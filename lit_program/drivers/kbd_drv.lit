# File: lit_program/drivers/kbd_drv.lit
# Chương trình Driver Bàn phím PS/2 (Cổng 0x60..0x64) + Hộp thư Zero-Copy IPC

layout KeyMap 8 {
    0: bv64                             # Mỗi phần tử 64-bit nén 8 mã ASCII của 8 Scancode liên tiếp
}

layout IpcChannel 24 {
    0: bv64                             # Offset 0: has_msg (0 = trống, 1 = có phím mới)
    8: bv8 @inv ult val 128             # Offset 8: msg_char (Mã ASCII chuẩn < 128)
    16: bv64 @inv ult val 70            # Offset 16: cursor_x (Vị trí cột con trỏ gõ chữ < 70)
}

# 1. Khởi tạo bảng mã bàn phím US QWERTY (64 Scancode nằm gọn trong 8 phần tử KeyMap)
func drv_kbd_init void %0:ptr<KeyMap,8> {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        # Nhóm 0 (Scancode 0..7): ESC, '1', '2', '3', '4', '5', '6'
        %1 = const 0 bv64
        %2 = slice %0 %1 ptr<KeyMap,1>
        %3 = const 0x3635343332310000 bv64
        store %2 0 %3

        # Nhóm 1 (Scancode 8..15): '7', '8', '9', '0', '-', '=', Backspace, Tab
        %4 = const 1 bv64
        %5 = slice %0 %4 ptr<KeyMap,1>
        %6 = const 0x20003d2d30393837 bv64
        store %5 0 %6

        # Nhóm 2 (Scancode 16..23): 'Q', 'W', 'E', 'R', 'T', 'Y', 'U', 'I'
        %7 = const 2 bv64
        %8 = slice %0 %7 ptr<KeyMap,1>
        %9 = const 0x4955595452455751 bv64
        store %8 0 %9

        # Nhóm 3 (Scancode 24..31): 'O', 'P', '[', ']', Enter, Ctrl, 'A', 'S'
        %10 = const 3 bv64
        %11 = slice %0 %10 ptr<KeyMap,1>
        %12 = const 0x534100005d5b504f bv64
        store %11 0 %12

        # Nhóm 4 (Scancode 32..39): 'D', 'F', 'G', 'H', 'J', 'K', 'L', ';'
        %13 = const 4 bv64
        %14 = slice %0 %13 ptr<KeyMap,1>
        %15 = const 0x3b4c4b4a48474644 bv64
        store %14 0 %15

        # Nhóm 5 (Scancode 40..47): ..., 'Z', 'X', 'C', 'V'
        %16 = const 5 bv64
        %17 = slice %0 %16 ptr<KeyMap,1>
        %18 = const 0x5643585a00000000 bv64
        store %17 0 %18

        # Nhóm 6 (Scancode 48..55): 'B', 'N', 'M', ',', '.', '/'
        %19 = const 6 bv64
        %20 = slice %0 %19 ptr<KeyMap,1>
        %21 = const 0x00002f2e2c4d4e42 bv64
        store %20 0 %21

        # Nhóm 7 (Scancode 56..63): Alt, Space (Scancode 57 = 0x20)
        %22 = const 7 bv64
        %23 = slice %0 %22 ptr<KeyMap,1>
        %24 = const 0x0000000000002000 bv64
        store %23 0 %24

        ret
}

# 2. Tác vụ kiểm tra bàn phím và đẩy ký tự vào hộp thư IpcChannel
func drv_kbd_poll_task void %0:io<0x60,0x64> %1:ptr<KeyMap,8> %2:ptr<IpcChannel,1> {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000

    @b0
        # Đọc cổng trạng thái 0x64: Nếu bit 0 == 1 nghĩa là có phím vừa được nhấn/nhả
        %3 = hwio_r %0 0x64
        %4 = const 1 bv64
        %5 = and %3 %4
        %6 = const 0 bv64
        %7 = cmp ne %5 %6
        br %7 @b1 @b4

    @b1
        # Đọc Scancode từ cổng dữ liệu 0x60 (Chỉ lấy mã nhấn phím < 64, bỏ qua mã nhả phím >= 0x80)
        %8 = hwio_r %0 0x60
        %9 = const 64 bv64
        %10 = cmp ult %8 %9
        br %10 @b2 @b4

    @b2
        # Dùng SLICE tra nhóm 8 phím: group = scancode >> 3 (Z3 tự chứng minh < 8!)
        %11 = const 3 bv64
        %12 = lshr %8 %11
        %13 = slice %1 %12 ptr<KeyMap,1>
        %14 = load %13 0 bv64

        # Dịch bit lấy đúng mã ASCII: bit_shift = (scancode & 7) * 8 (Z3 tự chứng minh < 64!)
        %15 = const 7 bv64
        %16 = and %8 %15
        %17 = shl %16 %11
        %18 = lshr %14 %17
        %19 = const 0x7f bv64
        %20 = and %18 %19               # Ký tự ASCII (< 128)

        %21 = cmp ugt %20 %6
        br %21 @b3 @b4

    @b3
        # Đẩy ký tự vào IpcChannel (Zero-Copy) để đánh thức Ứng dụng!
        store %2 8 %20                  # Lưu ký tự vào offset 8 (Z3 chứng minh %20 < 128)
        store %2 0 %4                   # Bật cờ has_msg = 1 tại offset 0
        jmp @b4

    @b4
        ret
}
