# File: lit_program/drivers/kbd_drv.lit
# Driver Chuột + Bàn phím PS/2
include ../lib/os_layout.lit
include ../lib/ipc_bus.lit

layout KeyMap 8 {
    0: bv64
}

# ---------------------------------------------------------------------------------------------------------------
# i8042 (bàn phím trong của laptop đi qua EC giả lập i8042). Máy ảo QEMU để sẵn mọi thứ (dịch mã bật, quét phím bật)
# nên ghi bừa cũng chạy; máy thật sau UEFI thì firmware có thể đã TẮT cổng bàn phím / tắt dịch mã / tắt quét phím
# -> phải khởi tạo đủ bước, và CHỜ bộ điều khiển sẵn sàng trước mỗi lần ghi / đọc.
# Chờ có giới hạn (~200k lần đọc cổng, cỡ 0.2s) để không treo khi thiết bị không trả lời.
# ---------------------------------------------------------------------------------------------------------------

# 1 nếu bộ đệm vào trống (được ghi), 0 nếu hết giờ
func i8042_wait_write bv64 %0:io<0x60,0x64> {
    @ens ule %r 1
    @b0
        jmp @l 0
    @l %i:bv64
        @inv ule %i 200000
        %more = cmp ult %i 200000
        br %more @poll @timeout
    @poll
        %st = hwio_r %0 0x64
        %full = and %st 2
        %busy = cmp ne %full 0
        br %busy @next @ok
    @next
        %i1 = add %i 1
        jmp @l %i1
    @ok
        ret 1
    @timeout
        ret 0
}

# Byte đọc được từ 0x60, hoặc 0x100 nếu hết giờ
func i8042_read bv64 %0:io<0x60,0x64> {
    @ens ule %r 0x100
    @b0
        jmp @l 0
    @l %i:bv64
        @inv ule %i 200000
        %more = cmp ult %i 200000
        br %more @poll @timeout
    @poll
        %st = hwio_r %0 0x64
        %has = and %st 1
        %ready = cmp ne %has 0
        br %ready @get @next
    @next
        %i1 = add %i 1
        jmp @l %i1
    @get
        %v = hwio_r %0 0x60
        %b = and %v 0xff
        ret %b
    @timeout
        ret 0x100
}

func i8042_cmd void %0:io<0x60,0x64> %c:bv8 {
    @b0
        %ok = call i8042_wait_write %0
        hwio_w %0 0x64 %c
        ret
}

func i8042_data void %0:io<0x60,0x64> %d:bv8 {
    @b0
        %ok = call i8042_wait_write %0
        hwio_w %0 0x60 %d
        ret
}

# Gửi 1 byte cho bàn phím, trả byte trả lời (0xFA = ACK; 0x100 = hết giờ)
func i8042_kbd_send bv64 %0:io<0x60,0x64> %d:bv8 {
    @ens ule %r 0x100
    @b0
        call i8042_data %0 %d
        %r1 = call i8042_read %0
        ret %r1
}

# Gửi 1 byte cho chuột PS/2 (qua lệnh 0xD4), trả byte trả lời
func i8042_aux_send bv64 %0:io<0x60,0x64> %d:bv8 {
    @ens ule %r 0x100
    @b0
        call i8042_cmd %0 0xd4:bv8
        call i8042_data %0 %d
        %r1 = call i8042_read %0
        ret %r1
}

# Đọc bỏ dữ liệu cũ còn trong bộ đệm ra (tối đa 32 byte)
func i8042_flush void %0:io<0x60,0x64> {
    @b0
        jmp @l 0
    @l %i:bv64
        @inv ule %i 32
        %more = cmp ult %i 32
        br %more @poll @done
    @poll
        %st = hwio_r %0 0x64
        %has = and %st 1
        %ready = cmp ne %has 0
        br %ready @drop @done
    @drop
        %v = hwio_r %0 0x60
        %i1 = add %i 1
        jmp @l %i1
    @done
        ret
}

# Byte thấp của trả lời (0xEE nếu hết giờ) để đóng gói chẩn đoán
func i8042_b8 bv64 %v:bv64 {
    @ens ule %r 0xff
    @b0
        %t = cmp eq %v 0x100
        br %t @to @val
    @to
        ret 0xee
    @val
        %b = and %v 0xff
        ret %b
}

# Khởi tạo đủ bước. Trả mã chẩn đoán (HW[300], dòng KBD):
#   cấu hình cũ << 56 | cấu hình mới << 48 | trả lời F6 << 40 | F0 << 32 | 02 << 24 | F4 << 16 | chuột F4 << 8 | cờ
#   cờ: 0x01 = không có i8042 (trạng thái 0xFF); trả lời 0xFA = ACK, 0xEE = hết giờ.
func i8042_setup bv64 %0:io<0x60,0x64> {
    @b0
        %st = hwio_r %0 0x64
        %none = cmp eq %st 0xff
        br %none @absent @go
    @absent
        ret 1
    @go
        # tắt cả hai cổng trong lúc cấu hình, bỏ dữ liệu cũ
        call i8042_cmd %0 0xad:bv8
        call i8042_cmd %0 0xa7:bv8
        call i8042_flush %0
        # cấu hình: bật dịch mã set 2 -> set 1 (bit 6), bật xung clock 2 cổng (xóa bit 4, 5), tắt IRQ1/IRQ12 (bit 0, 1)
        call i8042_cmd %0 0x20:bv8
        %c0 = call i8042_read %0
        %c0b = call i8042_b8 %c0
        %c1 = or %c0b 0x40
        %c2 = and %c1 0xcc
        %c2b = narrow %c2 bv8
        call i8042_cmd %0 0x60:bv8
        call i8042_data %0 %c2b
        # bật lại cổng bàn phím; bàn phím: mặc định, scancode set 2 (bộ điều khiển dịch ra set 1), bật quét phím
        call i8042_cmd %0 0xae:bv8
        call i8042_flush %0
        %a1 = call i8042_kbd_send %0 0xf6:bv8
        %a2 = call i8042_kbd_send %0 0xf0:bv8
        %a3 = call i8042_kbd_send %0 0x02:bv8
        %a4 = call i8042_kbd_send %0 0xf4:bv8
        # cổng chuột PS/2 (máy ảo / máy có chuột PS/2; laptop touchpad I2C thì hết giờ, không sao)
        call i8042_cmd %0 0xa8:bv8
        %m1 = call i8042_aux_send %0 0xf4:bv8
        call i8042_flush %0
        # đọc lại cấu hình để kiểm
        call i8042_cmd %0 0x20:bv8
        %c3 = call i8042_read %0
        %c3b = call i8042_b8 %c3
        %b1 = call i8042_b8 %a1
        %b2 = call i8042_b8 %a2
        %b3 = call i8042_b8 %a3
        %b4 = call i8042_b8 %a4
        %b5 = call i8042_b8 %m1
        %x0 = shl %c0b 56
        %x1 = shl %c3b 48
        %x2 = shl %b1 40
        %x3 = shl %b2 32
        %x4 = shl %b3 24
        %x5 = shl %b4 16
        %x6 = shl %b5 8
        %y0 = or %x0 %x1
        %y1 = or %y0 %x2
        %y2 = or %y1 %x3
        %y3 = or %y2 %x4
        %y4 = or %y3 %x5
        %y5 = or %y4 %x6
        ret %y5
}

func drv_kbd_init bv64 %0:io<0x60,0x64> %1:ptr<KeyMap,8> {
    @req uge %1 0x10000
    @req ult %1 0x80000000

    @b0
        %2 = const 0 bv64
        %3 = slice %1 %2 ptr<KeyMap,1>
        %4 = const 0x3635343332311b00 bv64
        store %3 0 %4

        %5 = const 1 bv64
        %6 = slice %1 %5 ptr<KeyMap,1>
        %7 = const 0x20083d2d30393837 bv64
        store %6 0 %7

        %8 = const 2 bv64
        %9 = slice %1 %8 ptr<KeyMap,1>
        %10 = const 0x6975797472657771 bv64
        store %9 0 %10

        %11 = const 3 bv64
        %12 = slice %1 %11 ptr<KeyMap,1>
        %13 = const 0x7361000a5d5b706f bv64
        store %12 0 %13

        %14 = const 4 bv64
        %15 = slice %1 %14 ptr<KeyMap,1>
        %16 = const 0x3b6c6b6a68676664 bv64
        store %15 0 %16

        %17 = const 5 bv64
        %18 = slice %1 %17 ptr<KeyMap,1>
        %19 = const 0x7663787a00000000 bv64
        store %18 0 %19

        %20 = const 6 bv64
        %21 = slice %1 %20 ptr<KeyMap,1>
        %22 = const 0x00002f2e2c6d6e62 bv64
        store %21 0 %22

        %23 = const 7 bv64
        %24 = slice %1 %23 ptr<KeyMap,1>
        %25 = const 0x0000000000002000 bv64
        store %24 0 %25

        %r = call i8042_setup %0
        ret %r
}

# Xử lý gói tin 3-byte của Chuột với phát hiện Sườn Lên (Rising-Edge Click)
func drv_mouse_handle_byte void %0:ptr<IpcChannel,1> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        %2 = load %0 40 bv64
        %3 = const 0 bv64
        %4 = cmp eq %2 %3
        br %4 @b1 @b2

    @b1
        %5 = const 8 bv64
        %6 = and %1 %5
        %7 = cmp ne %6 %3
        br %7 @b3 @b12

    @b3
        # Chỉ kích hoạt mouse_click = 1 khi nút trái chuyển từ Nhả (0) sang Nhấn (1)!
        %8 = const 1 bv64
        %9 = load %0 48 bv64
        %50 = and %9 %8
        %51 = and %1 %8
        %52 = xor %50 %8
        %53 = and %51 %52
        store %0 48 %1
        store %0 40 %8
        %54 = cmp ne %53 %3
        br %54 @b19 @b12

    @b19
        store %0 32 %8
        jmp @b12

    @b2
        %10 = const 1 bv64
        %11 = cmp eq %2 %10
        br %11 @b4 @b5

    @b4
        # Byte 1: Quãng đường ngang dx thực tế (%1 = 0..255)
        %12 = load %0 48 bv64
        %13 = load %0 184 bv64
        %14 = const 2 bv64
        store %0 40 %14
        %15 = const 0xff bv64
        %16 = and %1 %15
        %17 = const 16 bv64
        %18 = and %12 %17
        %19 = cmp eq %18 %3
        br %19 @b6 @b7

    @b6
        %20 = shl %16 %10
        %21 = add %13 %20
        %22 = const 1899 bv64
        %23 = cmp ult %21 %22
        br %23 @b8 @b9

    @b8
        store %0 184 %21
        jmp @b12

    @b9
        store %0 184 %22
        jmp @b12

    @b7
        %24 = const 256 bv64
        %25 = sub %24 %16
        %26 = shl %25 %10
        %27 = cmp ugt %13 %26
        br %27 @b10 @b11

    @b10
        %28 = sub %13 %26
        store %0 184 %28
        jmp @b12

    @b11
        store %0 184 %3
        jmp @b12

    @b5
        # Byte 2: Quãng đường dọc dy thực tế (%1 = 0..255)
        %29 = load %0 48 bv64
        %30 = load %0 192 bv64
        store %0 40 %3
        %31 = const 0xff bv64
        %32 = and %1 %31
        %33 = const 32 bv64
        %34 = and %29 %33
        %35 = cmp eq %34 %3
        br %35 @b13 @b14

    @b13
        %36 = shl %32 %10
        %37 = cmp ugt %30 %36
        br %37 @b15 @b16

    @b15
        %38 = sub %30 %36
        store %0 192 %38
        jmp @b12

    @b16
        store %0 192 %3
        jmp @b12

    @b14
        %39 = const 256 bv64
        %40 = sub %39 %32
        %41 = shl %40 %10
        %42 = add %30 %41
        %43 = const 1059 bv64
        %44 = cmp ult %42 %43
        br %44 @b17 @b18

    @b17
        store %0 192 %42
        jmp @b12

    @b18
        store %0 192 %43
        jmp @b12

    @b12
        ret
}
func kbd_apply_shift bv8 %0:bv64 %1:bv64 {
    # %0: ascii_char, %1: shift_mask (bit 0 = shift_down, bit 1 = caps_lock)
    @ens ult %40 128

    @b0
        %2 = const 0x7f bv64
        %3 = and %0 %2
        %4 = const 0 bv64

        # Trích xuất shift_bit và caps_bit
        %201 = const 1 bv64
        %202 = and %1 %201
        %203 = lshr %1 %201
        %204 = and %203 %201
        %205 = xor %202 %204

        # Kiểm tra nếu là chữ cái 'a' (97) .. 'z' (122)
        %210 = const 97 bv64
        %211 = cmp uge %3 %210
        %212 = const 122 bv64
        %213 = cmp ule %3 %212
        %214 = and %211 %213
        br %214 @b900 @b901

    @b900
        # Chữ cái: nếu xor(shift, caps) == 1 -> chuyển thành chữ hoa ('A'..'Z')
        %215 = cmp ne %205 %4
        br %215 @b902 @b99

    @b902
        %216 = const 32 bv64
        %217 = sub %3 %216
        jmp @b100 %217

    @b901
        # Ký tự đặc biệt hoặc số: chỉ phụ thuộc shift_bit
        %220 = cmp eq %202 %4
        br %220 @b99 @b1

    @b1
        # '=' (61) -> '+' (43)
        %6 = const 61 bv64
        %7 = cmp eq %3 %6
        br %7 @b10 @b2

    @b10
        %8 = const 43 bv64
        jmp @b100 %8

    @b2
        # '/' (47) -> '?' (63)
        %9 = const 47 bv64
        %10 = cmp eq %3 %9
        br %10 @b20 @b3

    @b20
        %11 = const 63 bv64
        jmp @b100 %11

    @b3
        # '1' (49) -> '!' (33)
        %12 = const 49 bv64
        %13 = cmp eq %3 %12
        br %13 @b30 @b4

    @b30
        %14 = const 33 bv64
        jmp @b100 %14

    @b4
        # '3' (51) -> '#' (35)
        %15 = const 51 bv64
        %16 = cmp eq %3 %15
        br %16 @b40 @b5

    @b40
        %17 = const 35 bv64
        jmp @b100 %17

    @b5
        # '5' (53) -> '%' (37)
        %18 = const 53 bv64
        %19 = cmp eq %3 %18
        br %19 @b50 @b6

    @b50
        %20 = const 37 bv64
        jmp @b100 %20

    @b6
        # '7' (55) -> '&' (38)
        %21 = const 55 bv64
        %22 = cmp eq %3 %21
        br %22 @b60 @b7

    @b60
        %23 = const 38 bv64
        jmp @b100 %23

    @b7
        # '8' (56) -> '*' (42)
        %24 = const 56 bv64
        %25 = cmp eq %3 %24
        br %25 @b70 @b8

    @b70
        %26 = const 42 bv64
        jmp @b100 %26

    @b8
        # '9' (57) -> '(' (40)
        %27 = const 57 bv64
        %28 = cmp eq %3 %27
        br %28 @b80 @b9

    @b80
        %29 = const 40 bv64
        jmp @b100 %29

    @b9
        # '0' (48) -> ')' (41)
        %30 = const 48 bv64
        %31 = cmp eq %3 %30
        br %31 @b90 @b11

    @b90
        %32 = const 41 bv64
        jmp @b100 %32

    @b11
        # '-' (45) -> '_' (95)
        %33 = const 45 bv64
        %34 = cmp eq %3 %33
        br %34 @b110 @b12

    @b110
        %35 = const 95 bv64
        jmp @b100 %35

    @b12
        # ';' (59) -> ':' (58)
        %36 = const 59 bv64
        %37 = cmp eq %3 %36
        br %37 @b120 @b13

    @b120
        %38 = const 58 bv64
        jmp @b100 %38

    @b13
        # '[' (91) -> '{' (123)
        %41 = const 91 bv64
        %42 = cmp eq %3 %41
        br %42 @b130 @b14

    @b130
        %43 = const 123 bv64
        jmp @b100 %43

    @b14
        # ']' (93) -> '}' (125)
        %44 = const 93 bv64
        %45 = cmp eq %3 %44
        br %45 @b140 @b15

    @b140
        %46 = const 125 bv64
        jmp @b100 %46

    @b15
        # '.' (46) -> '>' (62)
        %47 = const 46 bv64
        %48 = cmp eq %3 %47
        br %48 @b150 @b99

    @b150
        %49 = const 62 bv64
        jmp @b100 %49

    @b99
        jmp @b100 %3

    @b100 %40:bv64
        @inv ult %40 128
        ret %40
}

# 3. Lắng nghe và đọc gói tin Bàn phím (Hỗ trợ giữ/nhả Shift) & Chuột
# Xử lý 1 scancode PS/2 (set 1): Shift/Caps, F1..F7 = bấm ô Dock, F12 = khởi động lại, phím thường -> hàng đợi phím.
# Dùng chung cho bàn phím PS/2 và bàn phím USB (driver USB đổi mã HID sang scancode set 1).
func kbd_handle_scancode void %0:io<0x60,0x64> %1:ptr<KeyMap,8> %2:ptr<IpcChannel,1> %12:bv64 {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000

    @b0
        %10 = const 0 bv64
        jmp @b5

    @b5
        # Kiểm tra Nhấn phím Shift: Left Shift (42) hoặc Right Shift (54)
        %30 = const 42 bv64
        %31 = const 54 bv64
        %32 = cmp eq %12 %30
        %33 = cmp eq %12 %31
        %34 = or %32 %33
        br %34 @b51 @b52

    @b51
        %300 = load %2 160 bv64
        %301 = const 1 bv64
        %302 = or %300 %301
        store %2 160 %302                   # shift_bit = 1
        ret

    @b52
        # Kiểm tra Nhả phím Shift: Left Shift Release (170) hoặc Right Shift Release (182)
        %35 = const 170 bv64
        %36 = const 182 bv64
        %37 = cmp eq %12 %35
        %38 = cmp eq %12 %36
        %39 = or %37 %38
        br %39 @b53 @b520

    @b53
        %303 = load %2 160 bv64
        %304 = const 0xfffffffffffffffe bv64
        %305 = and %303 %304
        store %2 160 %305                   # shift_bit = 0
        ret

    @b520
        # Kiểm tra Phím Caps Lock (58)
        %310 = const 58 bv64
        %311 = cmp eq %12 %310
        br %311 @b521 @b54

    @b521
        %312 = load %2 160 bv64
        %313 = const 2 bv64
        %314 = xor %312 %313
        store %2 160 %314                   # đảo trạng thái caps_lock
        ret

    @b54
        # F1..F7 (scancode 59..65) = bấm ô Dock 0..6: máy không có chuột PS/2 (touchpad I2C) vẫn mở được App.
        # Giả lập một cú click: đặt chuột vào giữa ô Dock rồi bật cờ click (WM xử lý như click thật).
        %320 = const 59 bv64
        %321 = const 65 bv64
        %322 = cmp uge %12 %320
        %323 = cmp ule %12 %321
        %324 = and %322 %323
        br %324 @b55 @b56

    @b55
        %325 = sub %12 %320
        %326 = const 68 bv64
        %327 = mul %325 %326
        %328 = load %2 IpcChannel.dock_x0
        %329 = add %327 %328                # x màn hình = tâm ô 0 (Kernel ghi theo bố cục Dock) + 68 * ô
        %330 = const 1025 bv64              # tâm hàng icon Dock (359 + 640 + 26)
        %331 = const 1 bv64
        store %2 184 %329
        store %2 192 %330
        store %2 32 %331
        store %2 IpcChannel.kbd_pick 1
        ret

    @b56
        # F10 (scancode 0x44) = hiện / ẩn dòng chẩn đoán phần cứng (Kernel xử lý trong nhịp WM)
        %f10 = cmp eq %12 0x44
        br %f10 @bf10 @bf8

    @bf10
        store %2 IpcChannel.hotkey 1
        ret

    @bf8
        # F8 (0x42) / F9 (0x43) = giảm / tăng độ sáng màn hình (Kernel ghi PWM đèn nền trong nhịp WM, bl_tick)
        %f8 = cmp eq %12 0x42
        br %f8 @bdim @bf9
    @bdim
        store %2 IpcChannel.hotkey 2
        ret
    @bf9
        %f9 = cmp eq %12 0x43
        br %f9 @bbri @b56a
    @bbri
        store %2 IpcChannel.hotkey 3
        ret

    @b56a
        # F12 (scancode 0x58) = khởi động lại: lệnh 0xFE của bộ điều khiển i8042 kéo chân RESET của CPU
        %332 = const 0x58 bv64
        %333 = cmp eq %12 %332
        br %333 @b57 @b58

    @b57
        %334 = const 0xfe bv8
        hwio_w %0 0x64 %334
        ret

    @b58
        %16 = const 64 bv64
        %17 = cmp ult %12 %16
        br %17 @b6 @b8

    @b6
        %18 = const 3 bv64
        %19 = lshr %12 %18
        %20 = slice %1 %19 ptr<KeyMap,1>
        %21 = load %20 0 bv64

        %22 = const 7 bv64
        %23 = and %12 %22
        %24 = shl %23 %18
        %25 = lshr %21 %24
        %26 = const 0x7f bv64
        %27 = and %25 %26

        %28 = cmp ugt %27 %10
        br %28 @b7 @b8

    @b7
        %40 = load %2 160 bv64              # Đọc trạng thái shift_down
        %41 = call kbd_apply_shift %27 %40
        call ipc_key_push %2 %41
        ret

    @b8
        ret
}

func drv_kbd_poll_task void %0:io<0x60,0x64> %1:ptr<KeyMap,8> %2:ptr<IpcChannel,1> {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000

    @b0
        %3 = const 0 bv64
        jmp @b1 %3

    @b1 %4:bv64
        @inv ule %4 24
        %5 = const 24 bv64
        %6 = cmp ult %4 %5
        br %6 @b2 @b9

    @b2
        %7 = hwio_r %0 0x64
        %8 = const 1 bv64
        %9 = and %7 %8
        %10 = const 0 bv64
        %11 = cmp ne %9 %10
        %90 = const 0xff bv64
        %91 = cmp ne %7 %90                 # không có i8042 (bus trôi) -> trạng thái 0xff: bỏ qua
        %92 = and %11 %91
        br %92 @b3 @b9

    @b3
        %12 = hwio_r %0 0x60
        %13 = const 32 bv64
        %14 = and %7 %13
        %15 = cmp ne %14 %10
        br %15 @b4 @b5

    @b4
        call drv_mouse_handle_byte %2 %12
        jmp @b8

    @b5
        call kbd_handle_scancode %0 %1 %2 %12
        jmp @b8

    @b8
        %29 = add %4 %8
        jmp @b1 %29

    @b9
        ret
}
