# File: lit_program/drivers/vga_drv.lit
# Chương trình Driver phần cứng VGA (80x25 ô = 2000 ô, mỗi ô 2 byte)

layout VgaCell 2 {
    0: bv8 @inv ult val 128             # Offset 0: Mã chữ ASCII (1 byte)
    1: bv8                              # Offset 1: Mã màu Background/Foreground (1 byte)
}

# 1. Khởi tạo phần cứng VGA (Ẩn con trỏ nhấp nháy qua cổng 0x3d4/0x3d5)
func drv_vga_init void %0:io<0x3d4,0x3d5> {
    @b0
        %1 = const 0x0a bv8
        %2 = const 0x20 bv8
        hwio_w %0 0x3d4 %1
        hwio_w %0 0x3d5 %2
        ret
}

# 2. Ghi trực tiếp 1 ô (chữ + màu) vào vị trí phẳng %1 (0..1999) trong bộ nhớ VGA
func drv_vga_set_cell void %0:ptr<VgaCell,2000> %1:bv64 %2:bv8 %3:bv8 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ult %1 2000                    # Z3 bắt buộc: index %1 < 2000
    @req ult %2 128                     # Z3 bắt buộc: ký tự %2 là ASCII chuẩn

    @b0
        %4 = slice %0 %1 ptr<VgaCell,1> # Cắt đúng ô thứ %1 (Z3 tự chứng minh %1 + 1 <= 2000)
        store %4 0 %2                   # Ghi 1 byte chữ vào offset 0
        store %4 1 %3                   # Ghi 1 byte màu vào offset 1
        ret
}
