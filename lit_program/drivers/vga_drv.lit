# File: lit_program/drivers/vga_drv.lit
# Driver Đồ họa Pixel HD 1280x720 32-bit TrueColor (921.600 pixels, mỗi pixel 4 byte RGB)

layout VgaCell 4 {
    0: bv32                                 # Mã màu 32-bit TrueColor (0x00RRGGBB)
}

# 1. Bật chế độ đồ họa HD 1280x720x32bpp qua cổng Bochs VBE (0x1ce, 0x1cf)
func drv_vga_init void %0:io<0x1ce,0x1cf> {

    @b0
        # Tắt VBE tạm thời (Index 4 = 0)
        %1 = const 4 bv16
        %2 = const 0 bv16
        hwio_w %0 0x1ce %1
        hwio_w %0 0x1cf %2

        # Đặt chiều rộng XRES = 1280 (Index 1 = 1280)
        %3 = const 1 bv16
        %4 = const 1280 bv16
        hwio_w %0 0x1ce %3
        hwio_w %0 0x1cf %4

        # Đặt chiều cao YRES = 720 (Index 2 = 720)
        %5 = const 2 bv16
        %6 = const 720 bv16
        hwio_w %0 0x1ce %5
        hwio_w %0 0x1cf %6

        # Đặt độ sâu màu BPP = 32-bit RGB (Index 3 = 32)
        %7 = const 3 bv16
        %8 = const 32 bv16
        hwio_w %0 0x1ce %7
        hwio_w %0 0x1cf %8

        # Bật VBE + Linear Framebuffer (Index 4 = 0x0041)
        %9 = const 0x41 bv16
        hwio_w %0 0x1ce %1
        hwio_w %0 0x1cf %9
        ret
}

# 2. Vẽ 1 điểm ảnh 32-bit RGB vào vị trí phẳng %1 (0..921599)
func drv_vga_set_cell void %0:ptr<VgaCell,921600> %1:bv64 %2:bv32 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ult %1 921600                      # Z3 chứng minh: Không bao giờ vượt quá 1280x720!

    @b0
        %3 = slice %0 %1 ptr<VgaCell,1>
        store %3 0 %2
        ret
}

# 3. Đọc 1 điểm ảnh 32-bit RGB từ vị trí phẳng %1 (Dùng cho Save-Under Cursor)
func drv_vga_get_cell bv32 %0:ptr<VgaCell,921600> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ult %1 921600

    @b0
        %2 = slice %0 %1 ptr<VgaCell,1>
        %3 = load %2 0 bv32
        ret %3
}
