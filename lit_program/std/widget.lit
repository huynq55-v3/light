# File: lit_program/std/widget.lit
# LIGHT STD — bộ widget tối thiểu cho App có cửa sổ ĐỔI KÍCH THƯỚC được (lát 4 GUI).
#
# Mô hình (kiểu Wayland, client quyết kích thước):
#   1. Compositor đề nghị kích thước qua IpcChannel.cfg_w/cfg_h (configure) khi người dùng kéo góc dưới-phải.
#   2. App chọn kích thước (wg_pick_size: kẹp theo min/max của App), vẽ lại và BÁO kích thước đã vẽ (wg_window_open
#      ghi IpcChannel.win_w/win_h). Compositor chỉ dùng kích thước App báo.
#   3. Compositor tắt (IpcChannel.decor = 0) -> không đổi kích thước: App dùng kích thước mặc định, tự vẽ khung.
#
# Vùng nội dung (client) của cửa sổ cỡ w x h: góc trên-trái (202, 92) trong khung nhìn App, cỡ (w-4) x (h-34).
# wg_client trả surface của vùng đó: mọi tọa độ widget tính từ góc client, mọi điểm vẽ bị cắt trong client.

include surface.lit
include sys.lit
include ../lib/ui_window.lit
include ../lib/std_lib.lit

def WG_CLIENT_OFF 176842                    # 92 * 1920 + 202
def WG_CLIENT_N 1205558                     # 1382400 - WG_CLIENT_OFF
def WG_STRIDE 1920

# Surface của vùng client (cùng bộ nhớ khung nhìn App, gốc dời tới (202, 92))
func wg_client ptr<VgaCell,1205558> %fb:ptr<VgaCell,1382400> {
    @b0
        %c = slice %fb WG_CLIENT_OFF ptr<VgaCell,1205558>
        ret %c
}

# Kích thước cửa sổ App sẽ dùng: đề nghị của compositor (nếu có) kẹp trong [minw,maxw] x [minh,maxh]; chưa có đề
# nghị -> (dw, dh); compositor tắt -> (dw, dh) cố định.
func wg_pick_w bv64 %ipc:ptr<IpcChannel,1> %dw:bv64 %minw:bv64 %maxw:bv64 {
    @req uge %minw 300
    @req ule %maxw 1074
    @req ule %minw %maxw
    @req uge %dw %minw
    @req ule %dw %maxw
    @ens uge %r %minw
    @ens ule %r %maxw
    @b0
        %dec = load %ipc IpcChannel.decor
        %srv = cmp ne %dec 0
        br %srv @cfg @dflt
    @cfg
        %q = load %ipc IpcChannel.cfg_w
        %none = cmp eq %q 0
        br %none @dflt @clamp
    @clamp
        %a = call math_max %q %minw
        %b = call math_min %a %maxw
        ret %b
    @dflt
        ret %dw
}

func wg_pick_h bv64 %ipc:ptr<IpcChannel,1> %dh:bv64 %minh:bv64 %maxh:bv64 {
    @req uge %minh 150
    @req ule %maxh 558
    @req ule %minh %maxh
    @req uge %dh %minh
    @req ule %dh %maxh
    @ens uge %r %minh
    @ens ule %r %maxh
    @b0
        %dec = load %ipc IpcChannel.decor
        %srv = cmp ne %dec 0
        br %srv @cfg @dflt
    @cfg
        %q = load %ipc IpcChannel.cfg_h
        %none = cmp eq %q 0
        br %none @dflt @clamp
    @clamp
        %a = call math_max %q %minh
        %b = call math_min %a %maxh
        ret %b
    @dflt
        ret %dh
}

# Mở / vẽ lại cửa sổ cỡ w x h ở (200, 60): ghi tên + kích thước đã vẽ cho compositor, tô nền client.
# Compositor tắt: tự vẽ đủ khung bằng ui_win_open (khi đó w x h phải nằm trong giới hạn của ui_win_draw).
func wg_window_open void %fb:ptr<VgaCell,1382400> %font:ptr<DiskQword,64> %ipc:ptr<IpcChannel,1> %w:bv64 %h:bv64 %title:bv64 %bg:bv32 {
    @req uge %fb 0x10000
    @req ult %fb 0x80000000
    @req uge %font 0x10000
    @req ult %font 0x80000000
    @req uge %w 400
    @req ule %w 1074
    @req uge %h 200
    @req ule %h 558
    @b0
        %dec = load %ipc IpcChannel.decor
        %srv = cmp ne %dec 0
        br %srv @server @client
    @server
        store %ipc IpcChannel.title %title
        store %ipc IpcChannel.win_w %w
        store %ipc IpcChannel.win_h %h
        %xe = add %w 198
        %ye = add %h 58
        call gfx_fill_rect %fb 202 92 %xe %ye %bg
        ret
    @client
        %fw = call math_min %w 890
        %fh = call math_min %h 550
        call ui_win_open %fb %font %ipc 200 60 %fw %fh %title %bg
        ret
}

# Báo cả cửa sổ cần đưa lên màn hình
func wg_damage_window void %ipc:ptr<IpcChannel,1> %w:bv64 %h:bv64 {
    @req ule %w 1074
    @req ule %h 558
    @b0
        %xe = add %w 206
        %ye = add %h 66
        call sys_damage %ipc 200 60 %xe %ye
        ret
}

# Báo vùng client [x1,x2) x [y1,y2) (tọa độ client) cần đưa lên màn hình
func wg_damage void %ipc:ptr<IpcChannel,1> %x1:bv64 %y1:bv64 %x2:bv64 %y2:bv64 {
    @b0
        %a = add_sat %x1 202
        %b = add_sat %y1 92
        %c = add_sat %x2 202
        %d = add_sat %y2 92
        %a1 = call math_min %a 1280
        %b1 = call math_min %b 720
        %c1 = call math_min %c 1280
        %d1 = call math_min %d 720
        call sys_damage %ipc %a1 %b1 %c1 %d1
        ret
}

# Chuột theo tọa độ client (bão hòa ở 0 khi nằm trái / trên client)
func wg_mouse_x bv64 %ipc:ptr<IpcChannel,1> {
    @ens ult %r 1260
    @b0
        %x = call sys_mouse_x %ipc
        %c = sub_sat %x 202
        ret %c
}

func wg_mouse_y bv64 %ipc:ptr<IpcChannel,1> {
    @ens ult %r 700
    @b0
        %y = call sys_mouse_y %ipc
        %c = sub_sat %y 92
        ret %c
}

# Nhãn: chuỗi (len, s) tại (x, y) của client
func wg_label void %px:ptr<VgaCell,1205558> %cw:bv64 %ch:bv64 %x:bv64 %y:bv64 %len:bv64 %s:ptr<Byte,%len> %fg:bv32 {
    @req ule %cw 0x10000
    @b0
        call surf_text WG_CLIENT_N %px WG_STRIDE %cw %ch %x %y %len %s %fg
        ret
}

# Hình chữ nhật đặc [x, x+w) x [y, y+h) của client
func wg_box void %px:ptr<VgaCell,1205558> %cw:bv64 %ch:bv64 %x:bv64 %y:bv64 %w:bv64 %h:bv64 %c:bv32 {
    @req ule %cw 0x10000
    @b0
        %xe = add_sat %x %w
        %ye = add_sat %y %h
        call surf_fill_rect WG_CLIENT_N %px WG_STRIDE %cw %ch %x %y %xe %ye %c
        ret
}

# 1 nếu (mx, my) nằm trong [x, x+w) x [y, y+h)
func wg_hit bv64 %mx:bv64 %my:bv64 %x:bv64 %y:bv64 %w:bv64 %h:bv64 {
    @ens ule %r 1
    @b0
        %xe = add_sat %x %w
        %ye = add_sat %y %h
        %a = cmp uge %mx %x
        %b = cmp ult %mx %xe
        %c = cmp uge %my %y
        %d = cmp ult %my %ye
        %ab = and %a %b
        %cd = and %c %d
        %r1 = and %ab %cd
        ret %r1
}

# ===============================================================================================================
# Bộ component kiểu macOS (sáng, bo góc, viền mảnh, màu nhấn xanh). Tất cả THUẦN (không io), vẽ lên surface client
# (px, cw, ch) như các widget trên; tọa độ tính từ góc client, mọi điểm bị cắt trong client.
# ===============================================================================================================

def WG_ACCENT 0x007aff                      # màu nhấn (nút chọn, con trỏ soạn thảo)
def WG_INK 0x1d1d1f                         # chữ chính
def WG_INK2 0x6e6e73                        # chữ phụ
def WG_PAPER 0xffffff                       # nền tài liệu
def WG_BAR 0xf6f6f6                         # nền thanh công cụ / thanh trạng thái
def WG_HAIR 0xdcdcdc                        # đường kẻ mảnh
def WG_CTRL_LINE 0xc8c8cc                   # viền nút / ô nhập
def WG_CTRL_SHADOW 0xe2e2e6                 # bóng 1 điểm dưới nút
def WG_ROW_ALT 0xf4f5f7                     # hàng chẵn của danh sách
def WG_LINE_H 22                            # chiều cao dòng văn bản

# Ô bo góc đặc [x, x+w) x [y, y+h), bán kính r (tự giảm khi ô nhỏ)
func wg_rbox void %px:ptr<VgaCell,1205558> %cw:bv64 %ch:bv64 %x:bv64 %y:bv64 %w:bv64 %h:bv64 %r:bv64 %c:bv32 {
    @req ule %cw 0x10000
    @req ule %r 32
    @b0
        %xe0 = add_sat %x %w
        %ye0 = add_sat %y %h
        %xe = call math_min %xe0 0x10000
        %ye = call math_min %ye0 0x10000
        call surf_round_rect WG_CLIENT_N %px WG_STRIDE %cw %ch %x %y %xe %ye %r %c
        ret
}

# Ô bo góc có viền 1 điểm: viền %line, ruột %fill
func wg_rframe void %px:ptr<VgaCell,1205558> %cw:bv64 %ch:bv64 %x:bv64 %y:bv64 %w:bv64 %h:bv64 %r:bv64 %line:bv32 %fill:bv32 {
    @req ule %cw 0x10000
    @req ule %r 32
    @b0
        call wg_rbox %px %cw %ch %x %y %w %h %r %line
        %x1 = add_sat %x 1
        %y1 = add_sat %y 1
        %w1 = sub_sat %w 2
        %h1 = sub_sat %h 2
        %r1 = sub_sat %r 1
        call wg_rbox %px %cw %ch %x1 %y1 %w1 %h1 %r1 %fill
        ret
}

# Chuỗi (len, s) căn giữa trong ô [x, x+w) x [y, y+h) (chữ 8x16, bước 9)
func wg_text_center void %px:ptr<VgaCell,1205558> %cw:bv64 %ch:bv64 %x:bv64 %y:bv64 %w:bv64 %h:bv64 %len:bv64 %s:ptr<Byte,%len> %fg:bv32 {
    @req ule %cw 0x10000
    @b0
        %tw0 = mul_sat %len 9
        %tw = sub_sat %tw0 1
        %padx = sub_sat %w %tw
        %hx = lshr %padx 1
        %tx = add_sat %x %hx
        %pady = sub_sat %h 16
        %hy = lshr %pady 1
        %ty = add_sat %y %hy
        call wg_label %px %cw %ch %tx %ty %len %s %fg
        ret
}

# Nút bấm kiểu macOS: trắng, viền mảnh, bóng 1 điểm; %on = 1 -> nền màu nhấn, chữ trắng (nút đang chọn)
func wg_pbutton void %px:ptr<VgaCell,1205558> %cw:bv64 %ch:bv64 %x:bv64 %y:bv64 %w:bv64 %h:bv64 %len:bv64 %s:ptr<Byte,%len> %on:bv64 {
    @req ule %cw 0x10000
    @b0
        %y1 = add_sat %y 1
        call wg_rbox %px %cw %ch %x %y1 %w %h 6 WG_CTRL_SHADOW
        %sel = cmp ne %on 0
        br %sel @hi @lo
    @hi
        call wg_rbox %px %cw %ch %x %y %w %h 6 WG_ACCENT
        call wg_text_center %px %cw %ch %x %y %w %h %len %s WG_PAPER
        ret
    @lo
        call wg_rframe %px %cw %ch %x %y %w %h 6 WG_CTRL_LINE WG_PAPER
        call wg_text_center %px %cw %ch %x %y %w %h %len %s WG_INK
        ret
}

# Ô nhập / ô hiển thị: trắng, viền mảnh, bo góc 6
func wg_field void %px:ptr<VgaCell,1205558> %cw:bv64 %ch:bv64 %x:bv64 %y:bv64 %w:bv64 %h:bv64 {
    @req ule %cw 0x10000
    @b0
        call wg_rframe %px %cw %ch %x %y %w %h 6 WG_CTRL_LINE WG_PAPER
        ret
}

# Thanh công cụ trên cùng của client: cao h, nền WG_BAR, đường kẻ mảnh ở đáy
func wg_toolbar void %px:ptr<VgaCell,1205558> %cw:bv64 %ch:bv64 %h:bv64 {
    @req ule %cw 0x10000
    @b0
        %hl = sub_sat %h 1
        call wg_box %px %cw %ch 0 0 %cw %hl WG_BAR
        call wg_box %px %cw %ch 0 %hl %cw 1 WG_HAIR
        ret
}

# Thanh trạng thái dưới cùng: cao h, đường kẻ mảnh ở đỉnh. Trả y đỉnh của thanh.
func wg_statusbar bv64 %px:ptr<VgaCell,1205558> %cw:bv64 %ch:bv64 %h:bv64 {
    @req ule %cw 0x10000
    @b0
        %y = sub_sat %ch %h
        call wg_box %px %cw %ch 0 %y %cw 1 WG_HAIR
        %y1 = add_sat %y 1
        call wg_box %px %cw %ch 0 %y1 %cw %h WG_BAR
        ret %y
}

# Chuỗi 8 byte đóng gói (byte thấp = ký tự đầu, dừng ở byte 0) tại (x, y). Trả x sau ký tự cuối.
func wg_qtext bv64 %px:ptr<VgaCell,1205558> %cw:bv64 %ch:bv64 %x:bv64 %y:bv64 %q:bv64 %fg:bv32 {
    @req ule %cw 0x10000
    @b0
        jmp @l 0 %x
    @l %i:bv64 %cx:bv64
        @inv ule %i 8
        %more = cmp ult %i 8
        br %more @ch @done
    @ch
        %sh = shl %i 3
        %b = lshr %q %sh
        %c = and %b 0xff
        %end = cmp eq %c 0
        br %end @done @draw
    @draw
        call surf_char WG_CLIENT_N %px WG_STRIDE %cw %ch %cx %y %c %fg
        %i1 = add %i 1
        %x1 = add_sat %cx 9
        jmp @l %i1 %x1
    @done
        ret %cx
}

# Số thập phân v tại (x, y). Trả x sau chữ số cuối.
func wg_number bv64 %px:ptr<VgaCell,1205558> %cw:bv64 %ch:bv64 %x:bv64 %y:bv64 %v:bv64 %fg:bv32 {
    @req ule %cw 0x10000
    @b0
        %v10 = udiv %v 10
        jmp @p 1 0
    @p %pw:bv64 %k:bv64
        @inv ule %k 19
        %lim = cmp ult %k 19
        br %lim @pchk @emit0
    @pchk
        %big = cmp ule %pw %v10
        br %big @pmul @emit0
    @pmul
        %pw1 = mul_sat %pw 10
        %k1 = add %k 1
        jmp @p %pw1 %k1
    @emit0
        jmp @e %pw %x 0
    @e %d:bv64 %cx:bv64 %j:bv64
        @inv ule %j 20
        %go0 = cmp ne %d 0
        %go1 = cmp ult %j 20
        %go = and %go0 %go1
        br %go @dig @done
    @dig
        %q = udiv %v %d
        %u = urem %q 10
        %c = add %u 48
        call surf_char WG_CLIENT_N %px WG_STRIDE %cw %ch %cx %y %c %fg
        %d1 = udiv %d 10
        %x1 = add_sat %cx 9
        %j1 = add %j 1
        jmp @e %d1 %x1 %j1
    @done
        ret %cx
}

# Vùng văn bản: chuỗi kết thúc bằng 0 trong bộ đệm 512 byte, tự xuống dòng ở mép phải, '\n' sang dòng mới,
# dòng cao WG_LINE_H; con trỏ soạn thảo (vạch dọc 2 điểm màu nhấn) sau ký tự cuối khi %caret = 1.
func wg_textarea void %px:ptr<VgaCell,1205558> %cw:bv64 %ch:bv64 %x:bv64 %y:bv64 %w:bv64 %h:bv64 %text:ptr<DiskQword,64> %fg:bv32 %caret:bv64 {
    @req ule %cw 0x10000
    @req uge %text 0x10000
    @req ult %text 0x10000000000
    @b0
        %xr = add_sat %x %w
        %yb = add_sat %y %h
        jmp @l 0 %x %y
    @l %i:bv64 %cx:bv64 %cy:bv64
        @inv ule %i 511
        %more = cmp ult %i 511
        br %more @get @tail
    @get
        %b = call std_mem_get_byte %text %i
        %end = cmp eq %b 0
        br %end @tail @kind
    @kind
        %i1 = add %i 1
        %nl = cmp eq %b 10
        br %nl @newline @cr
    @newline
        %ny = add_sat %cy WG_LINE_H
        jmp @l %i1 %x %ny
    @cr
        %isr = cmp eq %b 13
        br %isr @skip @wrapchk
    @skip
        jmp @l %i1 %cx %cy
    @wrapchk
        %ce = add_sat %cx 8
        %over = cmp ugt %ce %xr
        br %over @wrap @nowrap
    @wrap
        %wy = add_sat %cy WG_LINE_H
        jmp @put %x %wy
    @nowrap
        jmp @put %cx %cy
    @put %px0:bv64 %py0:bv64
        %pb = add_sat %py0 16
        %fits = cmp ule %pb %yb
        br %fits @draw @stop
    @draw
        call surf_char WG_CLIENT_N %px WG_STRIDE %cw %ch %px0 %py0 %b %fg
        %nx = add_sat %px0 9
        jmp @l %i1 %nx %py0
    @stop
        ret
    @tail
        %want = cmp ne %caret 0
        br %want @cwrap @out
    @cwrap
        %ke = add_sat %cx 2
        %kover = cmp ugt %ke %xr
        br %kover @cnext @cput0
    @cnext
        %ky = add_sat %cy WG_LINE_H
        jmp @cput %x %ky
    @cput0
        jmp @cput %cx %cy
    @cput %kx:bv64 %ky0:bv64
        %kb = add_sat %ky0 18
        %kfit = cmp ule %kb %yb
        br %kfit @kdraw @out
    @kdraw
        %kt = sub_sat %ky0 1
        call wg_box %px %cw %ch %kx %kt 2 18 WG_ACCENT
        ret
    @out
        ret
}

# Hàng thứ i của danh sách: nền xen kẽ trắng / xám rất nhạt, bo góc 6
func wg_list_row void %px:ptr<VgaCell,1205558> %cw:bv64 %ch:bv64 %x:bv64 %y:bv64 %w:bv64 %h:bv64 %i:bv64 {
    @req ule %cw 0x10000
    @b0
        %odd = and %i 1
        %alt = cmp ne %odd 0
        br %alt @a @b
    @a
        call wg_rbox %px %cw %ch %x %y %w %h 6 WG_ROW_ALT
        ret
    @b
        call wg_rbox %px %cw %ch %x %y %w %h 6 WG_PAPER
        ret
}

# Biểu tượng tài liệu 14x18 tại (x, y): trang trắng viền xám, góc gấp, 3 dòng chữ
func wg_icon_doc void %px:ptr<VgaCell,1205558> %cw:bv64 %ch:bv64 %x:bv64 %y:bv64 {
    @req ule %cw 0x10000
    @b0
        call wg_rframe %px %cw %ch %x %y 14 18 2 0xa8a8ad WG_PAPER
        %fx = add_sat %x 9
        call wg_box %px %cw %ch %fx %y 5 5 0xd6d6db
        %lx = add_sat %x 3
        %l1 = add_sat %y 7
        %l2 = add_sat %y 10
        %l3 = add_sat %y 13
        call wg_box %px %cw %ch %lx %l1 8 1 0xc4c4c9
        call wg_box %px %cw %ch %lx %l2 8 1 0xc4c4c9
        call wg_box %px %cw %ch %lx %l3 5 1 0xc4c4c9
        ret
}

# Biểu tượng thư mục 20x16 tại (x, y): tai thư mục + thân xanh nhạt
func wg_icon_folder void %px:ptr<VgaCell,1205558> %cw:bv64 %ch:bv64 %x:bv64 %y:bv64 {
    @req ule %cw 0x10000
    @b0
        call wg_rbox %px %cw %ch %x %y 9 6 2 0x4f9fe3
        %by = add_sat %y 3
        call wg_rbox %px %cw %ch %x %by 20 13 2 0x67b1ee
        %ty = add_sat %y 5
        %tx = add_sat %x 1
        call wg_box %px %cw %ch %tx %ty 18 1 0x8cc6f5
        ret
}

# Nút (kiểu cũ, giữ chữ ký): ô bo góc nền %bg, viền mảnh WG_CTRL_LINE, nhãn màu %fg căn giữa
func wg_button void %px:ptr<VgaCell,1205558> %cw:bv64 %ch:bv64 %x:bv64 %y:bv64 %w:bv64 %h:bv64 %len:bv64 %s:ptr<Byte,%len> %bg:bv32 %fg:bv32 {
    @req ule %cw 0x10000
    @req uge %w 2
    @req uge %h 2
    @req ule %w 0x10000
    @req ule %h 0x10000
    @req ule %x 0x10000
    @req ule %y 0x10000
    @b0
        call wg_rframe %px %cw %ch %x %y %w %h 6 WG_CTRL_LINE %bg
        call wg_text_center %px %cw %ch %x %y %w %h %len %s %fg
        ret
}
