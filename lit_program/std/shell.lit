# File: lit_program/std/shell.lit
# LIGHT STD — LÕI SHELL dùng chung (thuần, không io, không IPC): một dòng lệnh -> stdout, stderr, mã thoát.
#
# Lõi là bộ thông dịch CHẠY TỪNG BƯỚC; mọi thao tác đĩa do mặt tiền (Terminal / kênh Agent) làm hộ:
#
#   call sh_begin %st                               # bắt đầu một dòng lệnh
#   lặp: %r = call sh_step %st %ws %n %line %tab %fc %fb %oc %out %ec %err
#        %r = 0  xong: mã thoát ở ShState.exit, stdout đã nối vào %out từ ShState.so_len, stderr vào %err
#        %r = 1  lõi cần một thao tác LightFS (ShState.op, xem SH_OP_*): mặt tiền làm rồi gọi sh_op_done %st %kết_quả
#        %r = 2  chưa xong, gọi tiếp (lõi tự chia việc dài thành nhiều bước)
#
# - %line (n byte, ASCII) phải GIỮ NGUYÊN giữa các lần gọi sh_step của cùng một dòng.
# - %ws: vùng làm việc SH_WS byte của mặt tiền (đối số, biến, bộ đệm ống). Đầu tiên phải toàn 0; giữ qua các dòng.
# - %tab: bảng LightFS (256 mục x 16 qword) — Kernel đưa bảng hiện hành, App đưa bản sao làm mới SAU MỖI thao tác.
# - %fb (fc byte): bộ đệm file của mặt tiền. READ đọc file vào %fb (kết quả = số byte), WRITE ghi %fb[0, op_len),
#   CREATE tạo mục tên = sh_op_name trong thư mục op_id (op_len = cờ, bit 1 = thư mục), DELETE xóa op_id.
#   Kết quả theo quy ước LightFS: bit 63 = lỗi, mã lỗi ở 8 bit thấp (lib/lightfs_api.lit).
# - stdout nối vào %out (dung lượng %oc) từ ShState.so_len, stderr vào %err (%ec) từ ShState.err_len; hết chỗ thì
#   cắt bớt và bật ShState.trunc (bit 0 stdout, bit 1 stderr). sh_begin xóa err_len và trunc; so_len do mặt tiền đặt.
# - ShState.cwd = id thư mục hiện tại, giữ qua các dòng (giống một phiên shell).
#
# Mã thoát: 0 thành công, 1 lỗi (không tìm thấy, sai loại...), 2 sai cú pháp, 127 không có lệnh.
# Đường dẫn: "/a/b" tuyệt đối, "a/b" tương đối với cwd, "." và ".." như Unix.

include fmt.lit
include ../lib/lightfs_api.lit

def SH_NONE 256
def SH_MAX_DEPTH 32

# Không có @inv để đặt được trong `data` tĩnh; lõi tự kẹp mọi trường khi đọc.
layout ShState 384 {
    0: bv64 cwd                             # thư mục hiện tại (0 = gốc)
    8: bv64 out_len                         # số byte trong bộ đệm OUT của lệnh đang chạy
    16: bv64 err_len                        # số byte đã ghi vào stderr
    24: bv64 trunc                          # bit 0 stdout bị cắt, bit 1 stderr bị cắt, bit 2 OUT tràn, bit 3 ống đã tràn
    32: bv64 exit                           # mã thoát của dòng vừa chạy (0..255) = $?
    40: bv64 op                             # thao tác LightFS chờ mặt tiền: SH_OP_* (0 = không có)
    48: bv64 op_id                          # id mục (CREATE: thư mục cha)
    56: bv64 op_len                         # WRITE: số byte; CREATE: cờ
    64: bv64 op_res                         # kết quả mặt tiền trả (sh_op_done)
    72: bv64 so_len                         # số byte đã ghi vào stdout của mặt tiền
    80: bv64 phase                          # SH_PH_*
    88: bv64 pos                            # vị trí lệnh kế tiếp trong dòng
    96: bv64 status                         # mã thoát của lệnh / ống vừa chạy
    104: bv64 skip                          # 1 = bỏ qua ống hiện tại (&& / ||)
    112: bv64 term                          # dấu kết thúc lệnh hiện tại: SH_T_*
    120: bv64 in_sel                        # bộ đệm nào là IN (0 = A, 1 = B); OUT là bộ kia
    128: bv64 in_len                        # số byte trong IN (stdin của lệnh)
    136: bv64 argc
    144: bv64 rmode                         # chuyển hướng stdout: 0 không, 1 '>' (ghi đè), 2 '>>' (nối)
    152: bv64 rarg                          # đối số là file đích
    160: bv64 iarg                          # đối số là file '<' (0 = không có)
    168: bv64 sub                           # bước con trong lệnh / pha
    176: bv64 fi                            # chỉ số đối số file đang xử lý
    184: bv64 cmd                           # mã lệnh SH_K_*
    192: bv64 v0                            # biến tạm của lệnh
    200: bv64 v1
    208: bv64 v2
    216: bv64 v3
    224: bv64 tid                           # id file đích của chuyển hướng
    232: bv64 opts                          # cờ tùy chọn của lệnh
    240: bv64 nassign                       # số từ NAME=giá_trị đứng đầu lệnh
    248: bv64 lexerr                        # lỗi tách từ: bit 0 quá dài, bit 1 quá nhiều đối số, bit 2 sai cú pháp
    256: bv64 checked                       # 1 = đã kiểm tra cú pháp cả dòng
    264: bv64 ffirst                        # đối số file đầu tiên của lệnh văn bản
    272: bv64 pat                           # grep: đối số mẫu
    280: bv64 num                           # head / tail: số dòng
    288: bv64 c1                            # bộ đếm của lệnh (wc: dòng; grep: đã khớp)
    296: bv64 c2
    304: bv64 c3
    312: bv64 piped                         # 1 = lệnh vừa xong đã đưa OUT sang lệnh sau ('|')
}

data SH_NUM Byte 24 {
}
data SH_NAME Byte 64 {
}
data SH_CH Byte 4 {
}

data SH_C_HELP Byte {
    "help"
}
data SH_C_ECHO Byte {
    "echo"
}
data SH_C_PWD Byte {
    "pwd"
}
data SH_C_LS Byte {
    "ls"
}
data SH_C_CD Byte {
    "cd"
}
data SH_C_STAT Byte {
    "stat"
}
data SH_M_HELP Byte {
    "commands:\n  help                      this list\n  echo [-n] [-e] ARG...     print arguments (-n: no newline, -e: TEXT escapes)\n  pwd | cd [PATH] | ls [PATH] | stat PATH\n  cat [FILE...]             print files (no FILE or -: stdin)\n  write PATH TEXT...        replace file content with TEXT (creates the file)\n  append PATH TEXT...       add TEXT at the end of a file (creates the file)\n  mkdir PATH | touch PATH | rm PATH (file or empty directory)\n  grep [-v] [-i] [-n] [-c] PATTERN [FILE...]   lines containing PATTERN\n                            (fixed string; ^ at start / $ at end anchor it)\n  wc [-l] [-w] [-c] [FILE...]   lines, words, bytes\n  head [-n N] [FILE...] | tail [-n N] [FILE...]   first / last N lines (10)\n  sort [-r] [-n] [-u] [FILE] | uniq [-c] [FILE]\n  find [PATH] [-name GLOB] [-type f|d]   paths below PATH (GLOB: * ?)\n  env | unset NAME... | NAME=VALUE | true | false\nsyntax: a | b   a > FILE   a >> FILE   a < FILE   a ; b   a && b   a || b\n  'literal'  \"with $VAR\"  \\ before a special character  $VAR ${VAR} $? (exit code)\nTEXT escapes: \\n newline, \\t tab, \\\\ backslash, \\xHH any byte\nlimits: 128 KiB output per command (pipes, > >>), files up to 1 MiB\n"
}
