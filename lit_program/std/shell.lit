# File: lit_program/std/shell.lit
# LIGHT STD — LÕI SHELL dùng chung (thuần, không io, không IPC): một dòng lệnh -> stdout, stderr, mã thoát.
#
#   %rc = call sh_exec %st %n %line %tab %oc %out %ec %err
#
# - %line (n byte, ASCII) là MỘT lệnh: từ đầu là tên lệnh, các từ sau cách nhau bằng dấu cách.
# - %tab là bảng LightFS (256 mục x 16 qword, xem lib/lightfs_api.lit) — Kernel đưa bảng hiện hành, App đưa bản sao.
#   Lõi CHỈ ĐỌC bảng; lệnh cần nội dung file / ghi đĩa sẽ do mặt tiền (Terminal / kênh Agent) thực hiện ở bước sau.
# - Lệnh đụng nội dung file / ghi đĩa (cat write append mkdir touch rm): sh_exec chỉ LẬP KẾ HOẠCH vào ShState.op (đã tìm
#   đường dẫn, kiểm tên, báo lỗi cú pháp). Mặt tiền thấy ShState.op != 0 thì thực hiện thao tác LightFS rồi gọi
#   sh_fs_done với mã kết quả (bit 63 = lỗi) để lõi ghi thông báo lỗi và mã thoát. Văn bản của write / append được giải
#   thoát ký tự bằng sh_unescape: \n \t \\ \xHH.
# - Kết quả ghi NỐI vào %out (dung lượng %oc) và %err (dung lượng %ec) từ ShState.out_len / err_len; hết chỗ thì
#   cắt bớt và bật ShState.trunc (bit 0 stdout, bit 1 stderr). Mặt tiền đặt out_len = err_len = trunc = 0 trước mỗi lệnh.
# - ShState.cwd = id thư mục hiện tại, giữ qua các lệnh (giống một phiên shell). Mã thoát cũng ghi vào ShState.exit.
#
# Mã thoát: 0 thành công, 1 lỗi (không tìm thấy, sai loại...), 2 sai cú pháp, 127 không có lệnh.
# Đường dẫn: "/a/b" tuyệt đối, "a/b" tương đối với cwd, "." và ".." như Unix.

include fmt.lit
include ../lib/lightfs_api.lit

def SH_NONE 256
def SH_MAX_DEPTH 32

# Không có @inv để đặt được trong `data` tĩnh; lõi tự kẹp cwd khi đọc (sh_cwd).
layout ShState 128 {
    0: bv64 cwd                             # thư mục hiện tại (0 = gốc)
    8: bv64 out_len                         # số byte đã ghi vào stdout
    16: bv64 err_len                        # số byte đã ghi vào stderr
    24: bv64 trunc                          # bit 0: stdout bị cắt, bit 1: stderr bị cắt
    32: bv64 exit                           # mã thoát của lệnh vừa chạy (0..255)
    40: bv64 op                             # kế hoạch đang chờ mặt tiền thực hiện: SH_OP_* (0 = không có)
    48: bv64 op_id                          # mục đích; khi op_new = 1 thì là thư mục cha của mục sẽ tạo
    56: bv64 op_new                         # 1 = mục chưa có, tạo trước (tên = name_off / name_len trong dòng lệnh)
    64: bv64 name_off
    72: bv64 name_len
    80: bv64 data_off                       # văn bản (đã thoát ký tự) của write / append trong dòng lệnh
    88: bv64 data_len
    96: bv64 path_off                       # đường dẫn như người dùng gõ (cho thông báo lỗi)
    104: bv64 path_len
    112: bv64 cmd_off                       # tên lệnh như người dùng gõ
    120: bv64 cmd_len
}

def SH_OP_CAT 1
def SH_OP_WRITE 2
def SH_OP_APPEND 3
def SH_OP_MKDIR 4
def SH_OP_TOUCH 5
def SH_OP_RM 6

data SH_NUM Byte 24 {
}
data SH_NAME Byte 64 {
}
data SH_CH Byte 4 {
}

data SH_C_HELP Byte {
    "help"
}
data SH_C_ECHO Byte {
    "echo"
}
data SH_C_PWD Byte {
    "pwd"
}
data SH_C_LS Byte {
    "ls"
}
data SH_C_CD Byte {
    "cd"
}
data SH_C_STAT Byte {
    "stat"
}
data SH_M_HELP Byte {
    "commands:\n  help           this list\n  echo TEXT      print TEXT\n  pwd            current directory\n  ls [PATH]      list a directory (dirs end with /)\n  cd [PATH]      change directory (no PATH = /)\n  stat PATH      type, size and id of an entry\n  cat PATH       print a file\n  write PATH TEXT   replace file content with TEXT (creates the file)\n  append PATH TEXT  add TEXT at the end of a file (creates the file)\n  mkdir PATH     create a directory\n  touch PATH     create an empty file if missing\n  rm PATH        remove a file or an empty directory\nTEXT escapes: \\\\n newline, \\\\t tab, \\\\\\\\ backslash, \\\\xHH any byte\n"
}
data SH_C_CAT Byte {
    "cat"
}
data SH_C_WRITE Byte {
    "write"
}
data SH_C_APPEND Byte {
    "append"
}
data SH_C_MKDIR Byte {
    "mkdir"
}
data SH_C_TOUCH Byte {
    "touch"
}
data SH_C_RM Byte {
    "rm"
}
data SH_M_ISDIR Byte {
    ": is a directory: "
}
data SH_M_EXISTS Byte {
    ": file exists: "
}
data SH_M_BADNAME Byte {
    ": invalid name (1..63 bytes, no '/'): "
}
data SH_M_ROOT Byte {
    ": cannot remove the root directory\n"
}
data SH_M_SEP Byte {
    ": "
}
data SH_E_1 Byte {
    "file system not mounted"
}
data SH_E_2 Byte {
    "no such entry"
}
data SH_E_3 Byte {
    "wrong type (apps are read-only)"
}
data SH_E_4 Byte {
    "file too large"
}
data SH_E_5 Byte {
    "no space left on disk"
}
data SH_E_6 Byte {
    "file table full (256 entries)"
}
data SH_E_7 Byte {
    "invalid or duplicate name"
}
data SH_E_8 Byte {
    "data corrupt (checksum)"
}
data SH_E_9 Byte {
    "directory not empty"
}
data SH_E_X Byte {
    "file system error"
}
data SH_M_NOTFOUND Byte {
    ": command not found\n"
}
data SH_M_NOENT Byte {
    ": no such file or directory: "
}
data SH_M_NOTDIR Byte {
    ": not a directory: "
}
data SH_M_NEEDARG Byte {
    ": missing operand\n"
}
data SH_M_TYPE Byte {
    "type: "
}
data SH_M_DIR Byte {
    "dir"
}
data SH_M_FILE Byte {
    "file"
}
data SH_M_APP Byte {
    "app"
}
data SH_M_SIZE Byte {
    "\nsize: "
}
data SH_M_ID Byte {
    "\nid: "
}
data SH_M_NAME Byte {
    "\nname: "
}

# ---------------------------------------------------------------- ghi kết quả

# Thư mục hiện tại (kẹp < 256; giá trị hỏng -> gốc)
func sh_cwd bv64 %st:ptr<ShState,1> {
    @ens ult %r 256
    @b0
        %c = load %st ShState.cwd
        %ok = cmp ult %c 256
        br %ok @y @n
    @y
        ret %c
    @n
        ret 0
}

# Nối (n, s) vào stdout; không đủ chỗ thì cắt và bật trunc bit 0
func sh_out void %st:ptr<ShState,1> %oc:bv64 %out:ptr<Byte,%oc> %n:bv64 %s:ptr<Byte,%n> {
    @b0
        %p0 = load %st ShState.out_len
        %p = call math_min %p0 %oc
        %np = call fmt_str %oc %out %p %n %s
        store %st ShState.out_len %np
        %w = sub %np %p
        %short = cmp ult %w %n
        br %short @cut @ok
    @cut
        %t = load %st ShState.trunc
        %t1 = or %t 1
        store %st ShState.trunc %t1
        ret
    @ok
        ret
}

# Nối (n, s) vào stderr; không đủ chỗ thì cắt và bật trunc bit 1
func sh_err void %st:ptr<ShState,1> %ec:bv64 %err:ptr<Byte,%ec> %n:bv64 %s:ptr<Byte,%n> {
    @b0
        %p0 = load %st ShState.err_len
        %p = call math_min %p0 %ec
        %np = call fmt_str %ec %err %p %n %s
        store %st ShState.err_len %np
        %w = sub %np %p
        %short = cmp ult %w %n
        br %short @cut @ok
    @cut
        %t = load %st ShState.trunc
        %t1 = or %t 2
        store %st ShState.trunc %t1
        ret
    @ok
        ret
}

# Một byte vào stdout
func sh_out_byte void %st:ptr<ShState,1> %oc:bv64 %out:ptr<Byte,%oc> %b:bv8 {
    @b0
        %c = addr SH_CH
        %p = slice %c 0 ptr<Byte,1>
        store %p 0 %b
        %one = slice %c 0 ptr<Byte,1>
        call sh_out %st %oc %out 1 %one
        ret
}

# Số thập phân vào stdout
func sh_out_dec void %st:ptr<ShState,1> %oc:bv64 %out:ptr<Byte,%oc> %v:bv64 {
    @b0
        %buf = addr SH_NUM
        %k = call fmt_u64 SH_NUM.len %buf 0 %v
        %s = slice %buf 0 ptr<Byte,%k>
        call sh_out %st %oc %out %k %s
        ret
}

# ---------------------------------------------------------------- tên mục trong bảng LightFS

# Byte thứ %i (0..63) trong tên của mục %id
func sh_name_byte bv64 %tab:ptr<DiskQword,4096> %id:bv64 %i:bv64 {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @req ult %id 256
    @req ult %i 64
    @ens ule %r 255
    @b0
        %q = lshr %i 3
        %qi = add %q 8
        %w = call lfs_tget %tab %id %qi
        %k = and %i 7
        %sh = shl %k 3
        %v = lshr %w %sh
        %b = and %v 0xff
        ret %b
}

# Chép tên của mục %id vào SH_NAME; trả độ dài (0..63)
func sh_name_load bv64 %tab:ptr<DiskQword,4096> %id:bv64 {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @req ult %id 256
    @ens ule %r 63
    @b0
        %buf = addr SH_NAME
        jmp @l 0
    @l %i:bv64
        @inv ule %i 63
        %more = cmp ult %i 63
        br %more @body @end
    @body
        %b = call sh_name_byte %tab %id %i
        %z = cmp eq %b 0
        br %z @end @put
    @put
        %p = slice %buf %i ptr<Byte,1>
        %b8 = narrow %b bv8
        store %p 0 %b8
        %i2 = add %i 1
        jmp @l %i2
    @end
        ret %i
}

# Tên của mục %id vào stdout
func sh_out_name void %st:ptr<ShState,1> %oc:bv64 %out:ptr<Byte,%oc> %tab:ptr<DiskQword,4096> %id:bv64 {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @req ult %id 256
    @b0
        %k = call sh_name_load %tab %id
        %buf = addr SH_NAME
        %s = slice %buf 0 ptr<Byte,%k>
        call sh_out %st %oc %out %k %s
        ret
}

# 1 nếu tên của mục %id đúng bằng (k, c) (1..63 byte)
func sh_name_is bv64 %tab:ptr<DiskQword,4096> %id:bv64 %k:bv64 %c:ptr<Byte,%k> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @req ult %id 256
    @ens ule %r 1
    @b0
        %e = cmp eq %k 0
        %big = cmp ugt %k 63
        %bad = or %e %big
        br %bad @no @start
    @start
        jmp @l 0
    @l %i:bv64
        @inv ule %i %k
        @inv ule %k 63
        %more = cmp ult %i %k
        br %more @body @tail
    @body
        %nb = call sh_name_byte %tab %id %i
        %p = slice %c %i ptr<Byte,1>
        %cb = load %p 0 bv8
        %cv = call byte_u64 %cb
        %eq = cmp eq %nb %cv
        br %eq @next @no
    @next
        %i2 = add %i 1
        jmp @l %i2
    @tail
        %end = call sh_name_byte %tab %id %k
        %z = cmp eq %end 0
        br %z @yes @no
    @yes
        ret 1
    @no
        ret 0
}

# 1 nếu mục %id đang dùng và nằm trong thư mục %dir
func sh_in_dir bv64 %tab:ptr<DiskQword,4096> %id:bv64 %dir:bv64 {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @req ult %id 256
    @ens ule %r 1
    @b0
        %f = call lfs_tget %tab %id 0
        %used = and %f 1
        %u = cmp ne %used 0
        br %u @par @no
    @par
        %pa = call lfs_tget %tab %id 1
        %same = cmp eq %pa %dir
        br %same @yes @no
    @yes
        ret 1
    @no
        ret 0
}

# Mục con tên (k, c) của thư mục %dir: id 1..255, hoặc 0 nếu không có
func sh_child bv64 %tab:ptr<DiskQword,4096> %dir:bv64 %k:bv64 %c:ptr<Byte,%k> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @ens ult %r 256
    @b0
        jmp @l 1
    @l %i:bv64
        @inv ule %i 256
        %more = cmp ult %i 256
        br %more @body @none
    @body
        %in = call sh_in_dir %tab %i %dir
        %hit = cmp ne %in 0
        br %hit @name @next
    @name
        %eq = call sh_name_is %tab %i %k %c
        %found = cmp ne %eq 0
        br %found @yes @next
    @next
        %i2 = add %i 1
        jmp @l %i2
    @yes
        ret %i
    @none
        ret 0
}

# ---------------------------------------------------------------- đường dẫn

# Đường dẫn (k, p) tính từ thư mục %cwd -> id mục (< 256), hoặc SH_NONE nếu không có. Đường dẫn rỗng = %cwd.
func sh_resolve bv64 %tab:ptr<DiskQword,4096> %cwd:bv64 %k:bv64 %p:ptr<Byte,%k> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @req ult %cwd 256
    @ens ule %r SH_NONE
    @b0
        %empty = cmp eq %k 0
        br %empty @here @first
    @here
        ret %cwd
    @first
        %p0 = slice %p 0 ptr<Byte,1>
        %c0 = load %p0 0 bv8
        %abs = cmp eq %c0 47
        br %abs @root @rel
    @root
        jmp @seg 0 0
    @rel
        jmp @seg 0 %cwd
    @seg %i:bv64 %cur:bv64
        @inv ule %i %k
        @inv ult %cur 256
        @dec sub %k %i
        %more = cmp ult %i %k
        br %more @cut @done
    @cut
        %j0 = call str_find %k %p %i 47
        %j = call math_max %j0 %i
        %len = sub %j %i
        %comp = slice %p %i ptr<Byte,%len>
        %j1 = add %j 1
        %ni = call math_min %j1 %k
        %z = cmp eq %len 0
        br %z @skip @word
    @skip
        jmp @seg %ni %cur
    @word
        %c1p = slice %comp 0 ptr<Byte,1>
        %c1 = load %c1p 0 bv8
        %d1 = cmp eq %c1 46
        br %d1 @dot @name
    @dot
        %one = cmp eq %len 1
        br %one @skip @dot2
    @dot2
        %two = cmp eq %len 2
        br %two @dot3 @name
    @dot3
        %c2p = slice %comp 1 ptr<Byte,1>
        %c2 = load %c2p 0 bv8
        %d2 = cmp eq %c2 46
        br %d2 @up @name
    @up
        %par = call lfs_parent %tab %cur
        jmp @seg %ni %par
    @name
        %ch = call sh_child %tab %cur %len %comp
        %miss = cmp eq %ch 0
        br %miss @fail @step
    @step
        jmp @seg %ni %ch
    @done
        ret %cur
    @fail
        ret SH_NONE
}

# Số cấp từ gốc tới %id (gốc = 0), tối đa SH_MAX_DEPTH
func sh_depth bv64 %tab:ptr<DiskQword,4096> %id:bv64 {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @req ult %id 256
    @ens ule %r SH_MAX_DEPTH
    @b0
        jmp @l %id 0
    @l %cur:bv64 %d:bv64
        @inv ult %cur 256
        @inv ule %d SH_MAX_DEPTH
        %top = cmp eq %cur 0
        %deep = cmp eq %d SH_MAX_DEPTH
        %stop = or %top %deep
        br %stop @end @up
    @up
        %par = call lfs_parent %tab %cur
        %d2 = add %d 1
        jmp @l %par %d2
    @end
        ret %d
}

# Tổ tiên cách %id đúng %n cấp (dừng ở gốc)
func sh_ancestor bv64 %tab:ptr<DiskQword,4096> %id:bv64 %n:bv64 {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @req ult %id 256
    @ens ult %r 256
    @b0
        jmp @l %id 0
    @l %cur:bv64 %i:bv64
        @inv ult %cur 256
        %more = cmp ult %i %n
        br %more @up @end
    @up
        %par = call lfs_parent %tab %cur
        %i2 = add_sat %i 1
        jmp @l %par %i2
    @end
        ret %cur
}

# Đường dẫn tuyệt đối của %id vào stdout ("/" cho gốc)
func sh_out_path void %st:ptr<ShState,1> %oc:bv64 %out:ptr<Byte,%oc> %tab:ptr<DiskQword,4096> %id:bv64 {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @req ult %id 256
    @b0
        %d = call sh_depth %tab %id
        %top = cmp eq %d 0
        br %top @root @start
    @root
        call sh_out_byte %st %oc %out 47
        ret
    @start
        jmp @l %d
    @l %i:bv64
        @inv ule %i SH_MAX_DEPTH
        %more = cmp ne %i 0
        br %more @part @end
    @part
        %i1 = sub %i 1
        %a = call sh_ancestor %tab %id %i1
        call sh_out_byte %st %oc %out 47
        call sh_out_name %st %oc %out %tab %a
        jmp @l %i1
    @end
        ret
}

# ---------------------------------------------------------------- lệnh

# "<cmd><msg><arg>\n" vào stderr
func sh_fail3 void %st:ptr<ShState,1> %ec:bv64 %err:ptr<Byte,%ec> %cn:bv64 %cmd:ptr<Byte,%cn> %mn:bv64 %msg:ptr<Byte,%mn> %an:bv64 %arg:ptr<Byte,%an> {
    @b0
        call sh_err %st %ec %err %cn %cmd
        call sh_err %st %ec %err %mn %msg
        call sh_err %st %ec %err %an %arg
        %nl = addr SH_CH
        %p = slice %nl 0 ptr<Byte,1>
        %c10 = const 10 bv8
        store %p 0 %c10
        %one = slice %nl 0 ptr<Byte,1>
        call sh_err %st %ec %err 1 %one
        ret
}

func sh_cmd_ls bv64 %st:ptr<ShState,1> %tab:ptr<DiskQword,4096> %an:bv64 %arg:ptr<Byte,%an> %cn:bv64 %cmd:ptr<Byte,%cn> %oc:bv64 %out:ptr<Byte,%oc> %ec:bv64 %err:ptr<Byte,%ec> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @ens ule %r 255
    @b0
        %cwd = call sh_cwd %st
        %id = call sh_resolve %tab %cwd %an %arg
        %none = cmp eq %id SH_NONE
        br %none @noent @found
    @noent
        %m = addr SH_M_NOENT
        call sh_fail3 %st %ec %err %cn %cmd SH_M_NOENT.len %m %an %arg
        ret 1
    @found
        %dir = call lfs_is_dir %tab %id
        %isd = cmp ne %dir 0
        br %isd @list @one
    @one
        call sh_out_name %st %oc %out %tab %id
        call sh_out_byte %st %oc %out 10
        ret 0
    @list
        jmp @l 1
    @l %i:bv64
        @inv ule %i 256
        @inv ult %id 256
        %more = cmp ult %i 256
        br %more @body @end
    @body
        %in = call sh_in_dir %tab %i %id
        %hit = cmp ne %in 0
        br %hit @show @next
    @show
        call sh_out_name %st %oc %out %tab %i
        %sd = call lfs_is_dir %tab %i
        %sub = cmp ne %sd 0
        br %sub @slash @eol
    @slash
        call sh_out_byte %st %oc %out 47
        jmp @eol
    @eol
        call sh_out_byte %st %oc %out 10
        jmp @next
    @next
        %i2 = add %i 1
        jmp @l %i2
    @end
        ret 0
}

func sh_cmd_cd bv64 %st:ptr<ShState,1> %tab:ptr<DiskQword,4096> %an:bv64 %arg:ptr<Byte,%an> %cn:bv64 %cmd:ptr<Byte,%cn> %ec:bv64 %err:ptr<Byte,%ec> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @ens ule %r 255
    @b0
        %e = cmp eq %an 0
        br %e @home @go
    @home
        store %st ShState.cwd 0
        ret 0
    @go
        %cwd = call sh_cwd %st
        %id = call sh_resolve %tab %cwd %an %arg
        %none = cmp eq %id SH_NONE
        br %none @noent @found
    @noent
        %m = addr SH_M_NOENT
        call sh_fail3 %st %ec %err %cn %cmd SH_M_NOENT.len %m %an %arg
        ret 1
    @found
        %dir = call lfs_is_dir %tab %id
        %root = cmp eq %id 0
        %isd = cmp ne %dir 0
        %ok = or %isd %root
        br %ok @set @notdir
    @set
        store %st ShState.cwd %id
        ret 0
    @notdir
        %m2 = addr SH_M_NOTDIR
        call sh_fail3 %st %ec %err %cn %cmd SH_M_NOTDIR.len %m2 %an %arg
        ret 1
}

func sh_cmd_stat bv64 %st:ptr<ShState,1> %tab:ptr<DiskQword,4096> %an:bv64 %arg:ptr<Byte,%an> %cn:bv64 %cmd:ptr<Byte,%cn> %oc:bv64 %out:ptr<Byte,%oc> %ec:bv64 %err:ptr<Byte,%ec> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @ens ule %r 255
    @b0
        %e = cmp eq %an 0
        br %e @need @go
    @need
        call sh_err %st %ec %err %cn %cmd
        %mn = addr SH_M_NEEDARG
        call sh_err %st %ec %err SH_M_NEEDARG.len %mn
        ret 2
    @go
        %cwd = call sh_cwd %st
        %id = call sh_resolve %tab %cwd %an %arg
        %none = cmp eq %id SH_NONE
        br %none @noent @found
    @noent
        %m = addr SH_M_NOENT
        call sh_fail3 %st %ec %err %cn %cmd SH_M_NOENT.len %m %an %arg
        ret 1
    @found
        %mt = addr SH_M_TYPE
        call sh_out %st %oc %out SH_M_TYPE.len %mt
        %f = call lfs_tget %tab %id 0
        %dbit = and %f 2
        %abit = and %f 4
        %root = cmp eq %id 0
        %isd0 = cmp ne %dbit 0
        %isd = or %isd0 %root
        br %isd @tdir @tf
    @tdir
        %md = addr SH_M_DIR
        call sh_out %st %oc %out SH_M_DIR.len %md
        jmp @size
    @tf
        %isa = cmp ne %abit 0
        br %isa @tapp @tfile
    @tapp
        %ma = addr SH_M_APP
        call sh_out %st %oc %out SH_M_APP.len %ma
        jmp @size
    @tfile
        %mf = addr SH_M_FILE
        call sh_out %st %oc %out SH_M_FILE.len %mf
        jmp @size
    @size
        %ms = addr SH_M_SIZE
        call sh_out %st %oc %out SH_M_SIZE.len %ms
        %sz = call lfs_tget %tab %id 2
        call sh_out_dec %st %oc %out %sz
        %mi = addr SH_M_ID
        call sh_out %st %oc %out SH_M_ID.len %mi
        call sh_out_dec %st %oc %out %id
        %mnm = addr SH_M_NAME
        call sh_out %st %oc %out SH_M_NAME.len %mnm
        call sh_out_path %st %oc %out %tab %id
        call sh_out_byte %st %oc %out 10
        ret 0
}

# ---------------------------------------------------------------- lệnh đụng đĩa: lập kế hoạch, mặt tiền thực hiện

# Vị trí '/' cuối cùng trong (k, p), hoặc %k nếu không có
func sh_last_slash bv64 %k:bv64 %p:ptr<Byte,%k> {
    @ens ule %r %k
    @b0
        jmp @l 0 %k
    @l %i:bv64 %last:bv64
        @inv ule %i %k
        @inv ule %last %k
        %more = cmp ult %i %k
        br %more @body @end
    @body
        %q = slice %p %i ptr<Byte,1>
        %c = load %q 0 bv8
        %sl = cmp eq %c 47
        %i2 = add %i 1
        br %sl @hit @l2
    @hit
        %here = or %i 0
        jmp @l %i2 %here
    @l2
        jmp @l %i2 %last
    @end
        ret %last
}

# Thư mục cha của mục cuối trong đường dẫn (k, p): id (< 256) hoặc SH_NONE nếu không có / không phải thư mục
func sh_parent_of bv64 %tab:ptr<DiskQword,4096> %cwd:bv64 %k:bv64 %p:ptr<Byte,%k> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @req ult %cwd 256
    @ens ule %r SH_NONE
    @b0
        %l = call sh_last_slash %k %p
        %none = cmp eq %l %k
        br %none @here @pre
    @here
        ret %cwd
    @pre
        %pl = call math_max %l 1
        %pre = slice %p 0 ptr<Byte,%pl>
        %d = call sh_resolve %tab %cwd %pl %pre
        %miss = cmp eq %d SH_NONE
        br %miss @no @chk
    @chk
        %isd = call lfs_is_dir %tab %d
        %root = cmp eq %d 0
        %okd = cmp ne %isd 0
        %ok = or %okd %root
        br %ok @yes @no
    @yes
        ret %d
    @no
        ret SH_NONE
}

# Ghi kế hoạch vào ShState
func sh_plan void %st:ptr<ShState,1> %op:bv64 %id:bv64 %new:bv64 %no:bv64 %nl:bv64 %do:bv64 %dl:bv64 %po:bv64 %pl:bv64 %co:bv64 %cl:bv64 {
    @b0
        store %st ShState.op %op
        store %st ShState.op_id %id
        store %st ShState.op_new %new
        store %st ShState.name_off %no
        store %st ShState.name_len %nl
        store %st ShState.data_off %do
        store %st ShState.data_len %dl
        store %st ShState.path_off %po
        store %st ShState.path_len %pl
        store %st ShState.cmd_off %co
        store %st ShState.cmd_len %cl
        ret
}

# Lập kế hoạch cho lệnh %op với đường dẫn s[b, e) và văn bản s[d, n). Trả mã thoát (0 = đã lập kế hoạch).
func sh_cmd_fs bv64 %st:ptr<ShState,1> %tab:ptr<DiskQword,4096> %op:bv64 %n:bv64 %s:ptr<Byte,%n> %a:bv64 %w:bv64 %b:bv64 %e:bv64 %d:bv64 %ec:bv64 %err:ptr<Byte,%ec> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @req ule %a %w
    @req ule %w %n
    @req ule %b %e
    @req ule %e %n
    @req ule %d %n
    @ens ule %r 255
    @b0
        %cl = sub %w %a
        %cmd = slice %s %a ptr<Byte,%cl>
        %an = sub %e %b
        %arg = slice %s %b ptr<Byte,%an>
        %dl = sub %n %d
        %cwd = call sh_cwd %st
        %empty = cmp eq %an 0
        br %empty @usage @look
    @usage
        call sh_err %st %ec %err %cl %cmd
        %mn = addr SH_M_NEEDARG
        call sh_err %st %ec %err SH_M_NEEDARG.len %mn
        ret 2
    @look
        %id = call sh_resolve %tab %cwd %an %arg
        %miss = cmp eq %id SH_NONE
        br %miss @absent @present
    @present
        %isd0 = call lfs_is_dir %tab %id
        %root = cmp eq %id 0
        %isd1 = cmp ne %isd0 0
        %isd = or %isd1 %root
        %is_rm = cmp eq %op SH_OP_RM
        br %is_rm @rm @p_mk
    @rm
        br %root @rmroot @plan_old
    @rmroot
        call sh_err %st %ec %err %cl %cmd
        %mr = addr SH_M_ROOT
        call sh_err %st %ec %err SH_M_ROOT.len %mr
        ret 1
    @p_mk
        %is_mk = cmp eq %op SH_OP_MKDIR
        br %is_mk @exists @p_touch
    @exists
        %mx = addr SH_M_EXISTS
        call sh_fail3 %st %ec %err %cl %cmd SH_M_EXISTS.len %mx %an %arg
        ret 1
    @p_touch
        %is_t = cmp eq %op SH_OP_TOUCH
        br %is_t @nothing @p_file
    @nothing
        ret 0
    @p_file
        # cat / write / append: phải là file
        br %isd @isdir @plan_old
    @isdir
        %md = addr SH_M_ISDIR
        call sh_fail3 %st %ec %err %cl %cmd SH_M_ISDIR.len %md %an %arg
        ret 1
    @plan_old
        call sh_plan %st %op %id 0 0 0 %d %dl %b %an %a %cl
        ret 0
    @absent
        %is_cat = cmp eq %op SH_OP_CAT
        %is_rm2 = cmp eq %op SH_OP_RM
        %need = or %is_cat %is_rm2
        br %need @noent @mkparent
    @noent
        %m = addr SH_M_NOENT
        call sh_fail3 %st %ec %err %cl %cmd SH_M_NOENT.len %m %an %arg
        ret 1
    @mkparent
        %par = call sh_parent_of %tab %cwd %an %arg
        %nopar = cmp eq %par SH_NONE
        br %nopar @noent @name
    @name
        %ls = call sh_last_slash %an %arg
        %top = cmp eq %ls %an
        br %top @n0 @n1
    @n0
        jmp @nm 0
    @n1
        %ls1 = add %ls 1
        jmp @nm %ls1
    @nm %ns:bv64
        @inv ule %ns %an
        %nl = sub %an %ns
        %z = cmp eq %nl 0
        %big = cmp ugt %nl 63
        %bad = or %z %big
        br %bad @badname @plan_new
    @badname
        %mb = addr SH_M_BADNAME
        call sh_fail3 %st %ec %err %cl %cmd SH_M_BADNAME.len %mb %an %arg
        ret 1
    @plan_new
        %no = add %b %ns
        call sh_plan %st %op %par 1 %no %nl %d %dl %b %an %a %cl
        ret 0
}

# Đoạn s[off, off+len) (kẹp trong n) vào stderr
func sh_err_seg void %st:ptr<ShState,1> %ec:bv64 %err:ptr<Byte,%ec> %n:bv64 %s:ptr<Byte,%n> %off:bv64 %len:bv64 {
    @b0
        %o = call math_min %off %n
        %room = sub %n %o
        %l = call math_min %len %room
        %seg = slice %s %o ptr<Byte,%l>
        call sh_err %st %ec %err %l %seg
        ret
}

# Thông báo cho mã lỗi LightFS %k (xem lib/lightfs_api.lit)
func sh_err_code void %st:ptr<ShState,1> %ec:bv64 %err:ptr<Byte,%ec> %k:bv64 {
    @b0
        %c1 = cmp eq %k 1
        br %c1 @e1 @t2
    @e1
        %m1 = addr SH_E_1
        call sh_err %st %ec %err SH_E_1.len %m1
        ret
    @t2
        %c2 = cmp eq %k 2
        br %c2 @e2 @t3
    @e2
        %m2 = addr SH_E_2
        call sh_err %st %ec %err SH_E_2.len %m2
        ret
    @t3
        %c3 = cmp eq %k 3
        br %c3 @e3 @t4
    @e3
        %m3 = addr SH_E_3
        call sh_err %st %ec %err SH_E_3.len %m3
        ret
    @t4
        %c4 = cmp eq %k 4
        br %c4 @e4 @t5
    @e4
        %m4 = addr SH_E_4
        call sh_err %st %ec %err SH_E_4.len %m4
        ret
    @t5
        %c5 = cmp eq %k 5
        br %c5 @e5 @t6
    @e5
        %m5 = addr SH_E_5
        call sh_err %st %ec %err SH_E_5.len %m5
        ret
    @t6
        %c6 = cmp eq %k 6
        br %c6 @e6 @t7
    @e6
        %m6 = addr SH_E_6
        call sh_err %st %ec %err SH_E_6.len %m6
        ret
    @t7
        %c7 = cmp eq %k 7
        br %c7 @e7 @t8
    @e7
        %m7 = addr SH_E_7
        call sh_err %st %ec %err SH_E_7.len %m7
        ret
    @t8
        %c8 = cmp eq %k 8
        br %c8 @e8 @t9
    @e8
        %m8 = addr SH_E_8
        call sh_err %st %ec %err SH_E_8.len %m8
        ret
    @t9
        %c9 = cmp eq %k 9
        br %c9 @e9 @ex
    @e9
        %m9 = addr SH_E_9
        call sh_err %st %ec %err SH_E_9.len %m9
        ret
    @ex
        %mx = addr SH_E_X
        call sh_err %st %ec %err SH_E_X.len %mx
        ret
}

# Mặt tiền đã thực hiện kế hoạch: %code = kết quả LightFS của bước cuối (bit 63 = lỗi, mã ở 8 bit thấp).
# %n, %s = CÙNG dòng lệnh đã đưa cho sh_exec. Ghi thông báo lỗi, sửa cwd nếu thư mục hiện tại vừa bị xóa, trả mã thoát.
func sh_fs_done bv64 %st:ptr<ShState,1> %tab:ptr<DiskQword,4096> %n:bv64 %s:ptr<Byte,%n> %code:bv64 %ec:bv64 %err:ptr<Byte,%ec> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @ens ule %r 255
    @b0
        store %st ShState.op 0
        %cwd = call sh_cwd %st
        %f = call lfs_tget %tab %cwd 0
        %used = and %f 1
        %gone0 = cmp eq %used 0
        %notroot = cmp ne %cwd 0
        %gone = and %gone0 %notroot
        br %gone @reset @chk
    @reset
        store %st ShState.cwd 0
        jmp @chk
    @chk
        %e = lshr %code 63
        %bad = cmp ne %e 0
        br %bad @fail @ok
    @ok
        store %st ShState.exit 0
        ret 0
    @fail
        %co = load %st ShState.cmd_off
        %cl = load %st ShState.cmd_len
        call sh_err_seg %st %ec %err %n %s %co %cl
        %sep = addr SH_M_SEP
        call sh_err %st %ec %err SH_M_SEP.len %sep
        %k = and %code 0xff
        call sh_err_code %st %ec %err %k
        call sh_err %st %ec %err SH_M_SEP.len %sep
        %po = load %st ShState.path_off
        %pl = load %st ShState.path_len
        call sh_err_seg %st %ec %err %n %s %po %pl
        %nl = addr SH_CH
        %p = slice %nl 0 ptr<Byte,1>
        %c10 = const 10 bv8
        store %p 0 %c10
        %one = slice %nl 0 ptr<Byte,1>
        call sh_err %st %ec %err 1 %one
        store %st ShState.exit 1
        ret 1
}

# Giá trị chữ số hex của byte %b (0..15), hoặc 16 nếu không phải chữ số hex
func sh_hexval bv64 %b:bv8 {
    @ens ule %r 16
    @b0
        %v = call byte_u64 %b
        %d0 = cmp uge %v 48
        %d1 = cmp ule %v 57
        %isd = and %d0 %d1
        br %isd @dig @lo
    @dig
        %r0 = sub %v 48
        ret %r0
    @lo
        %l0 = cmp uge %v 97
        %l1 = cmp ule %v 102
        %isl = and %l0 %l1
        br %isl @low @up
    @low
        %r1 = sub %v 87
        ret %r1
    @up
        %u0 = cmp uge %v 65
        %u1 = cmp ule %v 70
        %isu = and %u0 %u1
        br %isu @upper @none
    @upper
        %r2 = sub %v 55
        ret %r2
    @none
        ret 16
}

# Giải thoát ký tự (n, src) vào %dst từ %pos: \n \t \\ \xHH; dấu '\' khác giữ nguyên. Trả vị trí mới (<= cap).
func sh_unescape bv64 %n:bv64 %src:ptr<Byte,%n> %cap:bv64 %dst:ptr<Byte,%cap> %pos:bv64 {
    @req ule %pos %cap
    @ens ule %r %cap
    @b0
        jmp @l 0 %pos
    @l %i:bv64 %at:bv64
        @inv ule %i %n
        @inv ule %at %cap
        @dec sub %n %i
        %more = cmp ult %i %n
        br %more @body @end
    @body
        %p = slice %src %i ptr<Byte,1>
        %c = load %p 0 bv8
        %i1 = add %i 1
        %bs = cmp eq %c 92
        %has2 = cmp ult %i1 %n
        %esc = and %bs %has2
        br %esc @escape @plain
    @plain
        %a1 = call fmt_byte %cap %dst %at %c
        jmp @l %i1 %a1
    @escape
        %p2 = slice %src %i1 ptr<Byte,1>
        %c2 = load %p2 0 bv8
        %i2 = add %i 2
        %isn = cmp eq %c2 110
        br %isn @nl @t_t
    @nl
        %a2 = call fmt_byte %cap %dst %at 10
        jmp @l %i2 %a2
    @t_t
        %ist = cmp eq %c2 116
        br %ist @tab @t_b
    @tab
        %a3 = call fmt_byte %cap %dst %at 9
        jmp @l %i2 %a3
    @t_b
        %isb = cmp eq %c2 92
        br %isb @bsl @t_x
    @bsl
        %a4 = call fmt_byte %cap %dst %at 92
        jmp @l %i2 %a4
    @t_x
        %isx = cmp eq %c2 120
        %i4 = add %i 4
        %fit = cmp ule %i4 %n
        %hx = and %isx %fit
        br %hx @hex @plain
    @hex
        %i3 = add %i 3
        %p3 = slice %src %i2 ptr<Byte,1>
        %h1 = load %p3 0 bv8
        %p4 = slice %src %i3 ptr<Byte,1>
        %h2 = load %p4 0 bv8
        %v1 = call sh_hexval %h1
        %v2 = call sh_hexval %h2
        %ok1 = cmp ult %v1 16
        %ok2 = cmp ult %v2 16
        %ok = and %ok1 %ok2
        br %ok @hexok @plain
    @hexok
        %hi = shl %v1 4
        %v = or %hi %v2
        %b = narrow %v bv8
        %a5 = call fmt_byte %cap %dst %at %b
        jmp @l %i4 %a5
    @end
        ret %at
}


# Chạy một dòng lệnh; trả mã thoát (cũng ghi vào ShState.exit)
func sh_exec bv64 %st:ptr<ShState,1> %n:bv64 %s:ptr<Byte,%n> %tab:ptr<DiskQword,4096> %oc:bv64 %out:ptr<Byte,%oc> %ec:bv64 %err:ptr<Byte,%ec> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @ens ule %r 255
    @b0
        # tên lệnh = [a, w), phần còn lại = [b, n), đối số đầu = [b, e)
        %a = call str_skip_spaces %n %s 0
        %w = call str_find %n %s %a 32
        %cl = sub_sat %w %a
        %cmd = slice %s %a ptr<Byte,%cl>
        %b = call str_skip_spaces %n %s %w
        %rl = sub %n %b
        %rest = slice %s %b ptr<Byte,%rl>
        %e = call str_find %n %s %b 32
        %al = sub_sat %e %b
        %arg = slice %s %b ptr<Byte,%al>
        # văn bản của write / append: sau đường dẫn và đúng một dấu cách
        %e1 = add_sat %e 1
        %d = call math_min %e1 %n
        store %st ShState.op 0
        %empty = cmp eq %cl 0
        br %empty @ok0 @t_help
    @t_help
        %ch = addr SH_C_HELP
        %ih = call str_eq %cl %cmd SH_C_HELP.len %ch
        %bh = cmp ne %ih 0
        br %bh @help @t_echo
    @help
        %mh = addr SH_M_HELP
        call sh_out %st %oc %out SH_M_HELP.len %mh
        jmp @fin 0
    @t_echo
        %ce = addr SH_C_ECHO
        %ie = call str_eq %cl %cmd SH_C_ECHO.len %ce
        %be = cmp ne %ie 0
        br %be @echo @t_pwd
    @echo
        call sh_out %st %oc %out %rl %rest
        call sh_out_byte %st %oc %out 10
        jmp @fin 0
    @t_pwd
        %cp = addr SH_C_PWD
        %ip = call str_eq %cl %cmd SH_C_PWD.len %cp
        %bp = cmp ne %ip 0
        br %bp @pwd @t_ls
    @pwd
        %cwd = call sh_cwd %st
        call sh_out_path %st %oc %out %tab %cwd
        call sh_out_byte %st %oc %out 10
        jmp @fin 0
    @t_ls
        %cs = addr SH_C_LS
        %il = call str_eq %cl %cmd SH_C_LS.len %cs
        %bl = cmp ne %il 0
        br %bl @ls @t_cd
    @ls
        %r1 = call sh_cmd_ls %st %tab %al %arg %cl %cmd %oc %out %ec %err
        jmp @fin %r1
    @t_cd
        %cc = addr SH_C_CD
        %ic = call str_eq %cl %cmd SH_C_CD.len %cc
        %bc = cmp ne %ic 0
        br %bc @cd @t_stat
    @cd
        %r2 = call sh_cmd_cd %st %tab %al %arg %cl %cmd %ec %err
        jmp @fin %r2
    @t_stat
        %ct = addr SH_C_STAT
        %it = call str_eq %cl %cmd SH_C_STAT.len %ct
        %bt = cmp ne %it 0
        br %bt @stat @t_cat
    @stat
        %r3 = call sh_cmd_stat %st %tab %al %arg %cl %cmd %oc %out %ec %err
        jmp @fin %r3
    @t_cat
        %cc1 = addr SH_C_CAT
        %i1 = call str_eq %cl %cmd SH_C_CAT.len %cc1
        %b1 = cmp ne %i1 0
        br %b1 @o_cat @t_write
    @o_cat
        jmp @fsop SH_OP_CAT
    @t_write
        %cc2 = addr SH_C_WRITE
        %i2 = call str_eq %cl %cmd SH_C_WRITE.len %cc2
        %b2 = cmp ne %i2 0
        br %b2 @o_write @t_append
    @o_write
        jmp @fsop SH_OP_WRITE
    @t_append
        %cc3 = addr SH_C_APPEND
        %i3 = call str_eq %cl %cmd SH_C_APPEND.len %cc3
        %b3 = cmp ne %i3 0
        br %b3 @o_append @t_mkdir
    @o_append
        jmp @fsop SH_OP_APPEND
    @t_mkdir
        %cc4 = addr SH_C_MKDIR
        %i4 = call str_eq %cl %cmd SH_C_MKDIR.len %cc4
        %b4 = cmp ne %i4 0
        br %b4 @o_mkdir @t_touch
    @o_mkdir
        jmp @fsop SH_OP_MKDIR
    @t_touch
        %cc5 = addr SH_C_TOUCH
        %i5 = call str_eq %cl %cmd SH_C_TOUCH.len %cc5
        %b5 = cmp ne %i5 0
        br %b5 @o_touch @t_rm
    @o_touch
        jmp @fsop SH_OP_TOUCH
    @t_rm
        %cc6 = addr SH_C_RM
        %i6 = call str_eq %cl %cmd SH_C_RM.len %cc6
        %b6 = cmp ne %i6 0
        br %b6 @o_rm @unknown
    @o_rm
        jmp @fsop SH_OP_RM
    @fsop %op:bv64
        @inv ule %op SH_OP_RM
        %wa = call math_max %w %a
        %eb = call math_max %e %b
        %r4 = call sh_cmd_fs %st %tab %op %n %s %a %wa %b %eb %d %ec %err
        jmp @fin %r4
    @unknown
        call sh_err %st %ec %err %cl %cmd
        %mu = addr SH_M_NOTFOUND
        call sh_err %st %ec %err SH_M_NOTFOUND.len %mu
        jmp @fin 127
    @ok0
        jmp @fin 0
    @fin %rc:bv64
        @inv ule %rc 255
        store %st ShState.exit %rc
        ret %rc
}
