# ---------------------------------------------------------------- ghi kết quả

# Thư mục hiện tại (kẹp < 256; giá trị hỏng -> gốc)
func sh_cwd bv64 %st:ptr<ShState,1> {
    @ens ult %r 256
    @b0
        %c = load %st ShState.cwd
        %ok = cmp ult %c 256
        br %ok @y @n
    @y
        ret %c
    @n
        ret 0
}

# Nối (n, s) vào bộ đệm OUT của lệnh đang chạy; không đủ chỗ thì cắt và bật trunc bit 2
func sh_out void %st:ptr<ShState,1> %oc:bv64 %out:ptr<Byte,%oc> %n:bv64 %s:ptr<Byte,%n> {
    @b0
        %p0 = load %st ShState.out_len
        %p = call math_min %p0 %oc
        %np = call fmt_str %oc %out %p %n %s
        store %st ShState.out_len %np
        %w = sub %np %p
        %short = cmp ult %w %n
        br %short @cut @ok
    @cut
        %t = load %st ShState.trunc
        %t1 = or %t 4
        store %st ShState.trunc %t1
        ret
    @ok
        ret
}

# Nối (n, s) vào stdout của mặt tiền (từ ShState.so_len); không đủ chỗ thì cắt và bật trunc bit 0
func sh_so_put void %st:ptr<ShState,1> %oc:bv64 %out:ptr<Byte,%oc> %n:bv64 %s:ptr<Byte,%n> {
    @b0
        %p0 = load %st ShState.so_len
        %p = call math_min %p0 %oc
        %np = call fmt_str %oc %out %p %n %s
        store %st ShState.so_len %np
        %w = sub %np %p
        %short = cmp ult %w %n
        br %short @cut @ok
    @cut
        %t = load %st ShState.trunc
        %t1 = or %t 1
        store %st ShState.trunc %t1
        ret
    @ok
        ret
}

# Số thập phân vào stdout của mặt tiền
func sh_so_dec void %st:ptr<ShState,1> %oc:bv64 %out:ptr<Byte,%oc> %v:bv64 {
    @b0
        %buf = addr SH_NUM
        %k = call fmt_u64 SH_NUM.len %buf 0 %v
        %s = slice %buf 0 ptr<Byte,%k>
        call sh_so_put %st %oc %out %k %s
        ret
}

# Nối (n, s) vào stderr; không đủ chỗ thì cắt và bật trunc bit 1
func sh_err void %st:ptr<ShState,1> %ec:bv64 %err:ptr<Byte,%ec> %n:bv64 %s:ptr<Byte,%n> {
    @b0
        %p0 = load %st ShState.err_len
        %p = call math_min %p0 %ec
        %np = call fmt_str %ec %err %p %n %s
        store %st ShState.err_len %np
        %w = sub %np %p
        %short = cmp ult %w %n
        br %short @cut @ok
    @cut
        %t = load %st ShState.trunc
        %t1 = or %t 2
        store %st ShState.trunc %t1
        ret
    @ok
        ret
}

# Một byte vào stdout
func sh_out_byte void %st:ptr<ShState,1> %oc:bv64 %out:ptr<Byte,%oc> %b:bv8 {
    @b0
        %c = addr SH_CH
        %p = slice %c 0 ptr<Byte,1>
        store %p 0 %b
        %one = slice %c 0 ptr<Byte,1>
        call sh_out %st %oc %out 1 %one
        ret
}

# Số thập phân vào stdout
func sh_out_dec void %st:ptr<ShState,1> %oc:bv64 %out:ptr<Byte,%oc> %v:bv64 {
    @b0
        %buf = addr SH_NUM
        %k = call fmt_u64 SH_NUM.len %buf 0 %v
        %s = slice %buf 0 ptr<Byte,%k>
        call sh_out %st %oc %out %k %s
        ret
}

# ---------------------------------------------------------------- tên mục trong bảng LightFS

# Byte thứ %i (0..63) trong tên của mục %id
func sh_name_byte bv64 %tab:ptr<DiskQword,4096> %id:bv64 %i:bv64 {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @req ult %id 256
    @req ult %i 64
    @ens ule %r 255
    @b0
        %q = lshr %i 3
        %qi = add %q 8
        %w = call lfs_tget %tab %id %qi
        %k = and %i 7
        %sh = shl %k 3
        %v = lshr %w %sh
        %b = and %v 0xff
        ret %b
}

# Chép tên của mục %id vào SH_NAME; trả độ dài (0..63)
func sh_name_load bv64 %tab:ptr<DiskQword,4096> %id:bv64 {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @req ult %id 256
    @ens ule %r 63
    @b0
        %buf = addr SH_NAME
        jmp @l 0
    @l %i:bv64
        @inv ule %i 63
        %more = cmp ult %i 63
        br %more @body @end
    @body
        %b = call sh_name_byte %tab %id %i
        %z = cmp eq %b 0
        br %z @end @put
    @put
        %p = slice %buf %i ptr<Byte,1>
        %b8 = narrow %b bv8
        store %p 0 %b8
        %i2 = add %i 1
        jmp @l %i2
    @end
        ret %i
}

# Tên của mục %id vào stdout
func sh_out_name void %st:ptr<ShState,1> %oc:bv64 %out:ptr<Byte,%oc> %tab:ptr<DiskQword,4096> %id:bv64 {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @req ult %id 256
    @b0
        %k = call sh_name_load %tab %id
        %buf = addr SH_NAME
        %s = slice %buf 0 ptr<Byte,%k>
        call sh_out %st %oc %out %k %s
        ret
}

# 1 nếu tên của mục %id đúng bằng (k, c) (1..63 byte)
func sh_name_is bv64 %tab:ptr<DiskQword,4096> %id:bv64 %k:bv64 %c:ptr<Byte,%k> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @req ult %id 256
    @ens ule %r 1
    @b0
        %e = cmp eq %k 0
        %big = cmp ugt %k 63
        %bad = or %e %big
        br %bad @no @start
    @start
        jmp @l 0
    @l %i:bv64
        @inv ule %i %k
        @inv ule %k 63
        %more = cmp ult %i %k
        br %more @body @tail
    @body
        %nb = call sh_name_byte %tab %id %i
        %p = slice %c %i ptr<Byte,1>
        %cb = load %p 0 bv8
        %cv = call byte_u64 %cb
        %eq = cmp eq %nb %cv
        br %eq @next @no
    @next
        %i2 = add %i 1
        jmp @l %i2
    @tail
        %end = call sh_name_byte %tab %id %k
        %z = cmp eq %end 0
        br %z @yes @no
    @yes
        ret 1
    @no
        ret 0
}

# 1 nếu mục %id đang dùng và nằm trong thư mục %dir
func sh_in_dir bv64 %tab:ptr<DiskQword,4096> %id:bv64 %dir:bv64 {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @req ult %id 256
    @ens ule %r 1
    @b0
        %f = call lfs_tget %tab %id 0
        %used = and %f 1
        %u = cmp ne %used 0
        br %u @par @no
    @par
        %pa = call lfs_tget %tab %id 1
        %same = cmp eq %pa %dir
        br %same @yes @no
    @yes
        ret 1
    @no
        ret 0
}

# Mục con tên (k, c) của thư mục %dir: id 1..255, hoặc 0 nếu không có
func sh_child bv64 %tab:ptr<DiskQword,4096> %dir:bv64 %k:bv64 %c:ptr<Byte,%k> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @ens ult %r 256
    @b0
        jmp @l 1
    @l %i:bv64
        @inv ule %i 256
        %more = cmp ult %i 256
        br %more @body @none
    @body
        %in = call sh_in_dir %tab %i %dir
        %hit = cmp ne %in 0
        br %hit @name @next
    @name
        %eq = call sh_name_is %tab %i %k %c
        %found = cmp ne %eq 0
        br %found @yes @next
    @next
        %i2 = add %i 1
        jmp @l %i2
    @yes
        ret %i
    @none
        ret 0
}

# ---------------------------------------------------------------- đường dẫn

# Đường dẫn (k, p) tính từ thư mục %cwd -> id mục (< 256), hoặc SH_NONE nếu không có. Đường dẫn rỗng = %cwd.
func sh_resolve bv64 %tab:ptr<DiskQword,4096> %cwd:bv64 %k:bv64 %p:ptr<Byte,%k> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @req ult %cwd 256
    @ens ule %r SH_NONE
    @b0
        %empty = cmp eq %k 0
        br %empty @here @first
    @here
        ret %cwd
    @first
        %p0 = slice %p 0 ptr<Byte,1>
        %c0 = load %p0 0 bv8
        %abs = cmp eq %c0 47
        br %abs @root @rel
    @root
        jmp @seg 0 0
    @rel
        jmp @seg 0 %cwd
    @seg %i:bv64 %cur:bv64
        @inv ule %i %k
        @inv ult %cur 256
        @dec sub %k %i
        %more = cmp ult %i %k
        br %more @cut @done
    @cut
        %j0 = call str_find %k %p %i 47
        %j = call math_max %j0 %i
        %len = sub %j %i
        %comp = slice %p %i ptr<Byte,%len>
        %j1 = add %j 1
        %ni = call math_min %j1 %k
        %z = cmp eq %len 0
        br %z @skip @word
    @skip
        jmp @seg %ni %cur
    @word
        %c1p = slice %comp 0 ptr<Byte,1>
        %c1 = load %c1p 0 bv8
        %d1 = cmp eq %c1 46
        br %d1 @dot @name
    @dot
        %one = cmp eq %len 1
        br %one @skip @dot2
    @dot2
        %two = cmp eq %len 2
        br %two @dot3 @name
    @dot3
        %c2p = slice %comp 1 ptr<Byte,1>
        %c2 = load %c2p 0 bv8
        %d2 = cmp eq %c2 46
        br %d2 @up @name
    @up
        %par = call lfs_parent %tab %cur
        jmp @seg %ni %par
    @name
        %ch = call sh_child %tab %cur %len %comp
        %miss = cmp eq %ch 0
        br %miss @fail @step
    @step
        jmp @seg %ni %ch
    @done
        ret %cur
    @fail
        ret SH_NONE
}

# Số cấp từ gốc tới %id (gốc = 0), tối đa SH_MAX_DEPTH
func sh_depth bv64 %tab:ptr<DiskQword,4096> %id:bv64 {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @req ult %id 256
    @ens ule %r SH_MAX_DEPTH
    @b0
        jmp @l %id 0
    @l %cur:bv64 %d:bv64
        @inv ult %cur 256
        @inv ule %d SH_MAX_DEPTH
        %top = cmp eq %cur 0
        %deep = cmp eq %d SH_MAX_DEPTH
        %stop = or %top %deep
        br %stop @end @up
    @up
        %par = call lfs_parent %tab %cur
        %d2 = add %d 1
        jmp @l %par %d2
    @end
        ret %d
}

# Tổ tiên cách %id đúng %n cấp (dừng ở gốc)
func sh_ancestor bv64 %tab:ptr<DiskQword,4096> %id:bv64 %n:bv64 {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @req ult %id 256
    @ens ult %r 256
    @b0
        jmp @l %id 0
    @l %cur:bv64 %i:bv64
        @inv ult %cur 256
        %more = cmp ult %i %n
        br %more @up @end
    @up
        %par = call lfs_parent %tab %cur
        %i2 = add_sat %i 1
        jmp @l %par %i2
    @end
        ret %cur
}

# Đường dẫn tuyệt đối của %id vào stdout ("/" cho gốc)
func sh_out_path void %st:ptr<ShState,1> %oc:bv64 %out:ptr<Byte,%oc> %tab:ptr<DiskQword,4096> %id:bv64 {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @req ult %id 256
    @b0
        %d = call sh_depth %tab %id
        %top = cmp eq %d 0
        br %top @root @start
    @root
        call sh_out_byte %st %oc %out 47
        ret
    @start
        jmp @l %d
    @l %i:bv64
        @inv ule %i SH_MAX_DEPTH
        %more = cmp ne %i 0
        br %more @part @end
    @part
        %i1 = sub %i 1
        %a = call sh_ancestor %tab %id %i1
        call sh_out_byte %st %oc %out 47
        call sh_out_name %st %oc %out %tab %a
        jmp @l %i1
    @end
        ret
}

# ---------------------------------------------------------------- lệnh

# "<cmd><msg><arg>\n" vào stderr
func sh_fail3 void %st:ptr<ShState,1> %ec:bv64 %err:ptr<Byte,%ec> %cn:bv64 %cmd:ptr<Byte,%cn> %mn:bv64 %msg:ptr<Byte,%mn> %an:bv64 %arg:ptr<Byte,%an> {
    @b0
        call sh_err %st %ec %err %cn %cmd
        call sh_err %st %ec %err %mn %msg
        call sh_err %st %ec %err %an %arg
        %nl = addr SH_CH
        %p = slice %nl 0 ptr<Byte,1>
        %c10 = const 10 bv8
        store %p 0 %c10
        %one = slice %nl 0 ptr<Byte,1>
        call sh_err %st %ec %err 1 %one
        ret
}

func sh_cmd_ls bv64 %st:ptr<ShState,1> %tab:ptr<DiskQword,4096> %an:bv64 %arg:ptr<Byte,%an> %cn:bv64 %cmd:ptr<Byte,%cn> %oc:bv64 %out:ptr<Byte,%oc> %ec:bv64 %err:ptr<Byte,%ec> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @ens ule %r 255
    @b0
        %cwd = call sh_cwd %st
        %id = call sh_resolve %tab %cwd %an %arg
        %none = cmp eq %id SH_NONE
        br %none @noent @found
    @noent
        %m = addr SH_M_NOENT
        call sh_fail3 %st %ec %err %cn %cmd SH_M_NOENT.len %m %an %arg
        ret 1
    @found
        %dir = call lfs_is_dir %tab %id
        %isd0 = cmp ne %dir 0
        %root = cmp eq %id 0
        %isd = or %isd0 %root
        br %isd @list @one
    @one
        call sh_out_name %st %oc %out %tab %id
        call sh_out_byte %st %oc %out 10
        ret 0
    @list
        jmp @l 1
    @l %i:bv64
        @inv ule %i 256
        @inv ult %id 256
        %more = cmp ult %i 256
        br %more @body @end
    @body
        %in = call sh_in_dir %tab %i %id
        %hit = cmp ne %in 0
        br %hit @show @next
    @show
        call sh_out_name %st %oc %out %tab %i
        %sd = call lfs_is_dir %tab %i
        %sub = cmp ne %sd 0
        br %sub @slash @eol
    @slash
        call sh_out_byte %st %oc %out 47
        jmp @eol
    @eol
        call sh_out_byte %st %oc %out 10
        jmp @next
    @next
        %i2 = add %i 1
        jmp @l %i2
    @end
        ret 0
}

func sh_cmd_cd bv64 %st:ptr<ShState,1> %tab:ptr<DiskQword,4096> %an:bv64 %arg:ptr<Byte,%an> %cn:bv64 %cmd:ptr<Byte,%cn> %ec:bv64 %err:ptr<Byte,%ec> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @ens ule %r 255
    @b0
        %e = cmp eq %an 0
        br %e @home @go
    @home
        store %st ShState.cwd 0
        ret 0
    @go
        %cwd = call sh_cwd %st
        %id = call sh_resolve %tab %cwd %an %arg
        %none = cmp eq %id SH_NONE
        br %none @noent @found
    @noent
        %m = addr SH_M_NOENT
        call sh_fail3 %st %ec %err %cn %cmd SH_M_NOENT.len %m %an %arg
        ret 1
    @found
        %dir = call lfs_is_dir %tab %id
        %root = cmp eq %id 0
        %isd = cmp ne %dir 0
        %ok = or %isd %root
        br %ok @set @notdir
    @set
        store %st ShState.cwd %id
        ret 0
    @notdir
        %m2 = addr SH_M_NOTDIR
        call sh_fail3 %st %ec %err %cn %cmd SH_M_NOTDIR.len %m2 %an %arg
        ret 1
}

func sh_cmd_stat bv64 %st:ptr<ShState,1> %tab:ptr<DiskQword,4096> %an:bv64 %arg:ptr<Byte,%an> %cn:bv64 %cmd:ptr<Byte,%cn> %oc:bv64 %out:ptr<Byte,%oc> %ec:bv64 %err:ptr<Byte,%ec> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @ens ule %r 255
    @b0
        %e = cmp eq %an 0
        br %e @need @go
    @need
        call sh_err %st %ec %err %cn %cmd
        %mn = addr SH_M_NEEDARG
        call sh_err %st %ec %err SH_M_NEEDARG.len %mn
        ret 2
    @go
        %cwd = call sh_cwd %st
        %id = call sh_resolve %tab %cwd %an %arg
        %none = cmp eq %id SH_NONE
        br %none @noent @found
    @noent
        %m = addr SH_M_NOENT
        call sh_fail3 %st %ec %err %cn %cmd SH_M_NOENT.len %m %an %arg
        ret 1
    @found
        %mt = addr SH_M_TYPE
        call sh_out %st %oc %out SH_M_TYPE.len %mt
        %f = call lfs_tget %tab %id 0
        %dbit = and %f 2
        %abit = and %f 4
        %root = cmp eq %id 0
        %isd0 = cmp ne %dbit 0
        %isd = or %isd0 %root
        br %isd @tdir @tf
    @tdir
        %md = addr SH_M_DIR
        call sh_out %st %oc %out SH_M_DIR.len %md
        jmp @size
    @tf
        %isa = cmp ne %abit 0
        br %isa @tapp @tfile
    @tapp
        %ma = addr SH_M_APP
        call sh_out %st %oc %out SH_M_APP.len %ma
        jmp @size
    @tfile
        %mf = addr SH_M_FILE
        call sh_out %st %oc %out SH_M_FILE.len %mf
        jmp @size
    @size
        %ms = addr SH_M_SIZE
        call sh_out %st %oc %out SH_M_SIZE.len %ms
        %sz = call lfs_tget %tab %id 2
        call sh_out_dec %st %oc %out %sz
        %mi = addr SH_M_ID
        call sh_out %st %oc %out SH_M_ID.len %mi
        call sh_out_dec %st %oc %out %id
        %mnm = addr SH_M_NAME
        call sh_out %st %oc %out SH_M_NAME.len %mnm
        call sh_out_path %st %oc %out %tab %id
        call sh_out_byte %st %oc %out 10
        ret 0
}

# ---------------------------------------------------------------- lệnh đụng đĩa: lập kế hoạch, mặt tiền thực hiện

# Vị trí '/' cuối cùng trong (k, p), hoặc %k nếu không có
func sh_last_slash bv64 %k:bv64 %p:ptr<Byte,%k> {
    @ens ule %r %k
    @b0
        jmp @l 0 %k
    @l %i:bv64 %last:bv64
        @inv ule %i %k
        @inv ule %last %k
        %more = cmp ult %i %k
        br %more @body @end
    @body
        %q = slice %p %i ptr<Byte,1>
        %c = load %q 0 bv8
        %sl = cmp eq %c 47
        %i2 = add %i 1
        br %sl @hit @l2
    @hit
        %here = or %i 0
        jmp @l %i2 %here
    @l2
        jmp @l %i2 %last
    @end
        ret %last
}

# Thư mục cha của mục cuối trong đường dẫn (k, p): id (< 256) hoặc SH_NONE nếu không có / không phải thư mục
func sh_parent_of bv64 %tab:ptr<DiskQword,4096> %cwd:bv64 %k:bv64 %p:ptr<Byte,%k> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @req ult %cwd 256
    @ens ule %r SH_NONE
    @b0
        %l = call sh_last_slash %k %p
        %none = cmp eq %l %k
        br %none @here @pre
    @here
        ret %cwd
    @pre
        %pl = call math_max %l 1
        %pre = slice %p 0 ptr<Byte,%pl>
        %d = call sh_resolve %tab %cwd %pl %pre
        %miss = cmp eq %d SH_NONE
        br %miss @no @chk
    @chk
        %isd = call lfs_is_dir %tab %d
        %root = cmp eq %d 0
        %okd = cmp ne %isd 0
        %ok = or %okd %root
        br %ok @yes @no
    @yes
        ret %d
    @no
        ret SH_NONE
}

# Thông báo cho mã lỗi LightFS %k (xem lib/lightfs_api.lit)
func sh_err_code void %st:ptr<ShState,1> %ec:bv64 %err:ptr<Byte,%ec> %k:bv64 {
    @b0
        %c1 = cmp eq %k 1
        br %c1 @e1 @t2
    @e1
        %m1 = addr SH_E_1
        call sh_err %st %ec %err SH_E_1.len %m1
        ret
    @t2
        %c2 = cmp eq %k 2
        br %c2 @e2 @t3
    @e2
        %m2 = addr SH_E_2
        call sh_err %st %ec %err SH_E_2.len %m2
        ret
    @t3
        %c3 = cmp eq %k 3
        br %c3 @e3 @t4
    @e3
        %m3 = addr SH_E_3
        call sh_err %st %ec %err SH_E_3.len %m3
        ret
    @t4
        %c4 = cmp eq %k 4
        br %c4 @e4 @t5
    @e4
        %m4 = addr SH_E_4
        call sh_err %st %ec %err SH_E_4.len %m4
        ret
    @t5
        %c5 = cmp eq %k 5
        br %c5 @e5 @t6
    @e5
        %m5 = addr SH_E_5
        call sh_err %st %ec %err SH_E_5.len %m5
        ret
    @t6
        %c6 = cmp eq %k 6
        br %c6 @e6 @t7
    @e6
        %m6 = addr SH_E_6
        call sh_err %st %ec %err SH_E_6.len %m6
        ret
    @t7
        %c7 = cmp eq %k 7
        br %c7 @e7 @t8
    @e7
        %m7 = addr SH_E_7
        call sh_err %st %ec %err SH_E_7.len %m7
        ret
    @t8
        %c8 = cmp eq %k 8
        br %c8 @e8 @t9
    @e8
        %m8 = addr SH_E_8
        call sh_err %st %ec %err SH_E_8.len %m8
        ret
    @t9
        %c9 = cmp eq %k 9
        br %c9 @e9 @ex
    @e9
        %m9 = addr SH_E_9
        call sh_err %st %ec %err SH_E_9.len %m9
        ret
    @ex
        %mx = addr SH_E_X
        call sh_err %st %ec %err SH_E_X.len %mx
        ret
}

# Giá trị chữ số hex của byte %b (0..15), hoặc 16 nếu không phải chữ số hex
func sh_hexval bv64 %b:bv8 {
    @ens ule %r 16
    @b0
        %v = call byte_u64 %b
        %d0 = cmp uge %v 48
        %d1 = cmp ule %v 57
        %isd = and %d0 %d1
        br %isd @dig @lo
    @dig
        %r0 = sub %v 48
        ret %r0
    @lo
        %l0 = cmp uge %v 97
        %l1 = cmp ule %v 102
        %isl = and %l0 %l1
        br %isl @low @up
    @low
        %r1 = sub %v 87
        ret %r1
    @up
        %u0 = cmp uge %v 65
        %u1 = cmp ule %v 70
        %isu = and %u0 %u1
        br %isu @upper @none
    @upper
        %r2 = sub %v 55
        ret %r2
    @none
        ret 16
}

# Giải thoát ký tự (n, src) vào %dst từ %pos: \n \t \\ \xHH; dấu '\' khác giữ nguyên. Trả vị trí mới (<= cap).
func sh_unescape bv64 %n:bv64 %src:ptr<Byte,%n> %cap:bv64 %dst:ptr<Byte,%cap> %pos:bv64 {
    @req ule %pos %cap
    @ens ule %r %cap
    @b0
        jmp @l 0 %pos
    @l %i:bv64 %at:bv64
        @inv ule %i %n
        @inv ule %at %cap
        @dec sub %n %i
        %more = cmp ult %i %n
        br %more @body @end
    @body
        %p = slice %src %i ptr<Byte,1>
        %c = load %p 0 bv8
        %i1 = add %i 1
        %bs = cmp eq %c 92
        %has2 = cmp ult %i1 %n
        %esc = and %bs %has2
        br %esc @escape @plain
    @plain
        %a1 = call fmt_byte %cap %dst %at %c
        jmp @l %i1 %a1
    @escape
        %p2 = slice %src %i1 ptr<Byte,1>
        %c2 = load %p2 0 bv8
        %i2 = add %i 2
        %isn = cmp eq %c2 110
        br %isn @nl @t_t
    @nl
        %a2 = call fmt_byte %cap %dst %at 10
        jmp @l %i2 %a2
    @t_t
        %ist = cmp eq %c2 116
        br %ist @tab @t_b
    @tab
        %a3 = call fmt_byte %cap %dst %at 9
        jmp @l %i2 %a3
    @t_b
        %isb = cmp eq %c2 92
        br %isb @bsl @t_x
    @bsl
        %a4 = call fmt_byte %cap %dst %at 92
        jmp @l %i2 %a4
    @t_x
        %isx = cmp eq %c2 120
        %i4 = add %i 4
        %fit = cmp ule %i4 %n
        %hx = and %isx %fit
        br %hx @hex @plain
    @hex
        %i3 = add %i 3
        %p3 = slice %src %i2 ptr<Byte,1>
        %h1 = load %p3 0 bv8
        %p4 = slice %src %i3 ptr<Byte,1>
        %h2 = load %p4 0 bv8
        %v1 = call sh_hexval %h1
        %v2 = call sh_hexval %h2
        %ok1 = cmp ult %v1 16
        %ok2 = cmp ult %v2 16
        %ok = and %ok1 %ok2
        br %ok @hexok @plain
    @hexok
        %hi = shl %v1 4
        %v = or %hi %v2
        %b = narrow %v bv8
        %a5 = call fmt_byte %cap %dst %at %b
        jmp @l %i4 %a5
    @end
        ret %at
}



# ================================================================ bộ thông dịch chạy từng bước

def SH_WS 458752                           # vùng làm việc của mặt tiền (byte)
def SH_W_VARS 0                            # biến shell (4KB, giữ qua các dòng)
def SH_W_ARGO 4096                         # 64 cặp qword (vị trí, độ dài) của đối số trong ARGB
def SH_MAX_ARGS 64
def SH_A_OUT 62                            # ô đối số giữ file đích của '>' / '>>'
def SH_A_IN 63                             # ô đối số giữ file nguồn của '<'
def SH_MAX_WORDS 62
def SH_W_NAME 5120                         # tên mục sẽ tạo (64 byte, đệm 0) cho CREATE
def SH_W_ARGB 8192                         # byte của các đối số (139264)
def SH_ARGB_N 139264
def SH_W_BUFA 147456                       # bộ đệm ống A (131072)
def SH_W_BUFB 278528                       # bộ đệm ống B (131072)
def SH_BUF_N 131072
def SH_W_IDX 409600                        # chỉ mục dòng cho sort (49152 byte = 6144 dòng)

def SH_OP_READ 1
def SH_OP_WRITE 2
def SH_OP_CREATE 3
def SH_OP_DELETE 4
def SH_NEED 256                            # lệnh trả: đang chờ thao tác LightFS
def SH_E_TOOBIG 0x8000000000000004         # cùng mã lỗi 4 của LightFS ("file too large")

def SH_PH_PARSE 1
def SH_PH_IN 2
def SH_PH_RUN 3
def SH_PH_ROUTE 4
def SH_PH_NEXT 5
def SH_PH_END 6

def SH_T_END 0
def SH_T_SEMI 1
def SH_T_AND 2
def SH_T_OR 3
def SH_T_PIPE 4

def SH_K_HELP 1
def SH_K_ECHO 2
def SH_K_PWD 3
def SH_K_LS 4
def SH_K_CD 5
def SH_K_STAT 6
def SH_K_CAT 7
def SH_K_WRITE 8
def SH_K_APPEND 9
def SH_K_MKDIR 10
def SH_K_TOUCH 11
def SH_K_RM 12
def SH_K_ENV 13
def SH_K_UNSET 14
def SH_K_TRUE 15
def SH_K_FALSE 16
def SH_K_GREP 17
def SH_K_WC 18
def SH_K_HEAD 19
def SH_K_TAIL 20
def SH_K_SORT 21
def SH_K_UNIQ 22
def SH_K_FIND 23
def SH_K_LAST 23
def SH_K_UNRESOLVED 0xffff

data SH_M_VARFULL Byte {
    "sh: no space for variables (4 KiB, name <= 64, value <= 4000 bytes)\n"
}
data SH_M_NOREDIR Byte {
    ": cannot be combined with > or >>\n"
}
data SH_C_ENV Byte {
    "env"
}
data SH_C_UNSET Byte {
    "unset"
}
data SH_C_TRUE Byte {
    "true"
}
data SH_C_FALSE Byte {
    "false"
}
data SH_O_N Byte {
    "-n"
}
data SH_O_E Byte {
    "-e"
}
data SH_O_NE Byte {
    "-ne"
}
data SH_O_EN Byte {
    "-en"
}

# ---------------------------------------------------------------- vùng làm việc

func sh_argo ptr<DiskQword,128> %ws:ptr<Byte,458752> {
    @b0
        %a = slice %ws SH_W_ARGO ptr<Byte,1024>
        %q = view %a ptr<DiskQword,128>
        ret %q
}

func sh_argb ptr<Byte,139264> %ws:ptr<Byte,458752> {
    @b0
        %a = slice %ws SH_W_ARGB ptr<Byte,139264>
        ret %a
}

func sh_wname ptr<Byte,64> %ws:ptr<Byte,458752> {
    @b0
        %a = slice %ws SH_W_NAME ptr<Byte,64>
        ret %a
}

# Bộ đệm IN (stdin của lệnh) và OUT (stdout của lệnh) — hai bộ A / B đổi vai qua mỗi '|'
func sh_bin ptr<Byte,131072> %st:ptr<ShState,1> %ws:ptr<Byte,458752> {
    @b0
        %sel = load %st ShState.in_sel
        %b = and %sel 1
        %isb = cmp ne %b 0
        br %isb @bb @ba
    @ba
        %a = slice %ws SH_W_BUFA ptr<Byte,131072>
        ret %a
    @bb
        %c = slice %ws SH_W_BUFB ptr<Byte,131072>
        ret %c
}

func sh_bout ptr<Byte,131072> %st:ptr<ShState,1> %ws:ptr<Byte,458752> {
    @b0
        %sel = load %st ShState.in_sel
        %b = and %sel 1
        %isb = cmp ne %b 0
        br %isb @ba @bb
    @ba
        %a = slice %ws SH_W_BUFA ptr<Byte,131072>
        ret %a
    @bb
        %c = slice %ws SH_W_BUFB ptr<Byte,131072>
        ret %c
}

func sh_inlen bv64 %st:ptr<ShState,1> {
    @ens ule %r SH_BUF_N
    @b0
        %l = load %st ShState.in_len
        %r = call math_min %l SH_BUF_N
        ret %r
}

func sh_outlen bv64 %st:ptr<ShState,1> {
    @ens ule %r SH_BUF_N
    @b0
        %l = load %st ShState.out_len
        %r = call math_min %l SH_BUF_N
        ret %r
}

# (n, s) vào OUT của lệnh đang chạy
func sh_put void %st:ptr<ShState,1> %ws:ptr<Byte,458752> %n:bv64 %s:ptr<Byte,%n> {
    @b0
        %o = call sh_bout %st %ws
        call sh_out %st SH_BUF_N %o %n %s
        ret
}

func sh_put_byte void %st:ptr<ShState,1> %ws:ptr<Byte,458752> %b:bv8 {
    @b0
        %o = call sh_bout %st %ws
        call sh_out_byte %st SH_BUF_N %o %b
        ret
}

func sh_put_dec void %st:ptr<ShState,1> %ws:ptr<Byte,458752> %v:bv64 {
    @b0
        %o = call sh_bout %st %ws
        call sh_out_dec %st SH_BUF_N %o %v
        ret
}

# Một byte vào stderr
func sh_err_byte void %st:ptr<ShState,1> %ec:bv64 %err:ptr<Byte,%ec> %b:bv8 {
    @b0
        %c = addr SH_CH
        %p = slice %c 0 ptr<Byte,1>
        store %p 0 %b
        %one = slice %c 0 ptr<Byte,1>
        call sh_err %st %ec %err 1 %one
        ret
}

# ---------------------------------------------------------------- đối số

func sh_argc bv64 %st:ptr<ShState,1> {
    @ens ule %r SH_MAX_ARGS
    @b0
        %c = load %st ShState.argc
        %r = call math_min %c SH_MAX_ARGS
        ret %r
}

func sh_arg_set void %ws:ptr<Byte,458752> %i:bv64 %o:bv64 %l:bv64 {
    @req ult %i SH_MAX_ARGS
    @b0
        %q = call sh_argo %ws
        %j = shl %i 1
        %p = slice %q %j ptr<DiskQword,2>
        store %p 0 %o
        store %p 8 %l
        ret
}

# Vị trí đối số %i trong ARGB
func sh_arg_off bv64 %ws:ptr<Byte,458752> %i:bv64 {
    @req ult %i SH_MAX_ARGS
    @ens ule %r SH_ARGB_N
    @b0
        %q = call sh_argo %ws
        %j = shl %i 1
        %p = slice %q %j ptr<DiskQword,2>
        %o = load %p 0 bv64
        %r = call math_min %o SH_ARGB_N
        ret %r
}

# Độ dài đối số %i (0 nếu %i >= argc), kẹp trong %room
func sh_arg_len bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> %i:bv64 %room:bv64 {
    @req ult %i SH_MAX_ARGS
    @ens ule %r %room
    @b0
        %c = call sh_argc %st
        %in0 = cmp ult %i %c
        %slot = cmp uge %i SH_A_OUT
        %in = or %in0 %slot
        br %in @y @n
    @y
        %q = call sh_argo %ws
        %j = shl %i 1
        %p = slice %q %j ptr<DiskQword,2>
        %l = load %p 8 bv64
        %r = call math_min %l %room
        ret %r
    @n
        ret 0
}

# Đối số %i vào stderr
func sh_err_arg void %st:ptr<ShState,1> %ws:ptr<Byte,458752> %ec:bv64 %err:ptr<Byte,%ec> %i:bv64 {
    @req ult %i SH_MAX_ARGS
    @b0
        %argb = call sh_argb %ws
        %o = call sh_arg_off %ws %i
        %room = sub SH_ARGB_N %o
        %l = call sh_arg_len %st %ws %i %room
        %a = slice %argb %o ptr<Byte,%l>
        call sh_err %st %ec %err %l %a
        ret
}

# Đối số %i có bằng chuỗi (k, c) không
func sh_arg_is bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> %i:bv64 %k:bv64 %c:ptr<Byte,%k> {
    @req ult %i SH_MAX_ARGS
    @ens ule %r 1
    @b0
        %argb = call sh_argb %ws
        %o = call sh_arg_off %ws %i
        %room = sub SH_ARGB_N %o
        %l = call sh_arg_len %st %ws %i %room
        %a = slice %argb %o ptr<Byte,%l>
        %r = call str_eq %l %a %k %c
        ret %r
}

# "<argv0><msg><argv i>\n" vào stderr
func sh_fail_a void %st:ptr<ShState,1> %ws:ptr<Byte,458752> %ec:bv64 %err:ptr<Byte,%ec> %mn:bv64 %msg:ptr<Byte,%mn> %i:bv64 {
    @req ult %i SH_MAX_ARGS
    @b0
        call sh_err_arg %st %ws %ec %err 0
        call sh_err %st %ec %err %mn %msg
        call sh_err_arg %st %ws %ec %err %i
        call sh_err_byte %st %ec %err 10
        ret
}

# "<argv0>: <thông báo mã LightFS %code>: <argv i>\n" vào stderr
func sh_fail_c void %st:ptr<ShState,1> %ws:ptr<Byte,458752> %ec:bv64 %err:ptr<Byte,%ec> %code:bv64 %i:bv64 {
    @req ult %i SH_MAX_ARGS
    @b0
        call sh_err_arg %st %ws %ec %err 0
        %sep = addr SH_M_SEP
        call sh_err %st %ec %err SH_M_SEP.len %sep
        %k = and %code 0xff
        call sh_err_code %st %ec %err %k
        call sh_err %st %ec %err SH_M_SEP.len %sep
        call sh_err_arg %st %ws %ec %err %i
        call sh_err_byte %st %ec %err 10
        ret
}

# "<argv0>: missing operand\n"
func sh_usage void %st:ptr<ShState,1> %ws:ptr<Byte,458752> %ec:bv64 %err:ptr<Byte,%ec> {
    @b0
        call sh_err_arg %st %ws %ec %err 0
        %mn = addr SH_M_NEEDARG
        call sh_err %st %ec %err SH_M_NEEDARG.len %mn
        ret
}

# Tìm đường dẫn ở đối số %i: id hoặc SH_NONE
func sh_resolve_arg bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> %tab:ptr<DiskQword,4096> %i:bv64 {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @req ult %i SH_MAX_ARGS
    @ens ule %r SH_NONE
    @b0
        %argb = call sh_argb %ws
        %o = call sh_arg_off %ws %i
        %room = sub SH_ARGB_N %o
        %l = call sh_arg_len %st %ws %i %room
        %a = slice %argb %o ptr<Byte,%l>
        %cwd = call sh_cwd %st
        %id = call sh_resolve %tab %cwd %l %a
        %r = call math_min %id SH_NONE
        ret %r
}

# Thư mục cha của mục cuối trong đối số %i: id hoặc SH_NONE
func sh_parent_arg bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> %tab:ptr<DiskQword,4096> %i:bv64 {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @req ult %i SH_MAX_ARGS
    @ens ule %r SH_NONE
    @b0
        %argb = call sh_argb %ws
        %o = call sh_arg_off %ws %i
        %room = sub SH_ARGB_N %o
        %l = call sh_arg_len %st %ws %i %room
        %a = slice %argb %o ptr<Byte,%l>
        %cwd = call sh_cwd %st
        %r = call sh_parent_of %tab %cwd %l %a
        ret %r
}

# Tên mục cuối của đối số %i -> vùng NAME (đệm 0); trả 1 nếu tên hợp lệ (1..63 byte)
func sh_name_arg bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> %i:bv64 {
    @req ult %i SH_MAX_ARGS
    @ens ule %r 1
    @b0
        %argb = call sh_argb %ws
        %o = call sh_arg_off %ws %i
        %room = sub SH_ARGB_N %o
        %l = call sh_arg_len %st %ws %i %room
        %a = slice %argb %o ptr<Byte,%l>
        %ls = call sh_last_slash %l %a
        %top = cmp eq %ls %l
        br %top @n0 @n1
    @n0
        jmp @nm 0
    @n1
        %ls1 = add %ls 1
        jmp @nm %ls1
    @nm %ns:bv64
        @inv ule %ns %l
        %nl = sub %l %ns
        %z = cmp eq %nl 0
        %big = cmp ugt %nl 63
        %bad = or %z %big
        br %bad @no @yes
    @no
        ret 0
    @yes
        %nm = call sh_wname %ws
        call mem_fill_b 64 %nm 0
        %src = slice %a %ns ptr<Byte,%nl>
        call mem_copy_b 64 %nm %nl %src %nl
        ret 1
}

# Mục %id là thư mục (kể cả gốc)?
func sh_isdir bv64 %tab:ptr<DiskQword,4096> %id:bv64 {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @ens ule %r 1
    @b0
        %root = cmp eq %id 0
        br %root @y @chk
    @chk
        %big = cmp uge %id 256
        br %big @n @t
    @t
        %d = call lfs_is_dir %tab %id
        %isd = cmp ne %d 0
        br %isd @y @n
    @y
        ret 1
    @n
        ret 0
}

# ---------------------------------------------------------------- giao tiếp với mặt tiền

# Bắt đầu một dòng lệnh mới (cwd, so_len và vùng biến giữ nguyên)
func sh_begin void %st:ptr<ShState,1> {
    @b0
        store %st ShState.out_len 0
        store %st ShState.err_len 0
        store %st ShState.trunc 0
        store %st ShState.op 0
        store %st ShState.op_res 0
        store %st ShState.phase SH_PH_PARSE
        store %st ShState.pos 0
        %ex = load %st ShState.exit
        %st0 = and %ex 0xff
        store %st ShState.status %st0
        store %st ShState.skip 0
        store %st ShState.term 0
        store %st ShState.in_sel 0
        store %st ShState.in_len 0
        store %st ShState.argc 0
        store %st ShState.rmode 0
        store %st ShState.iarg 0
        store %st ShState.sub 0
        store %st ShState.checked 0
        store %st ShState.lexerr 0
        ret
}

# Mặt tiền đã làm thao tác ShState.op: kết quả %res (bit 63 = lỗi)
func sh_op_done void %st:ptr<ShState,1> %res:bv64 {
    @b0
        store %st ShState.op_res %res
        store %st ShState.op 0
        ret
}

# Tên mục cho thao tác CREATE -> 8 qword %q (đệm 0)
func sh_op_name void %ws:ptr<Byte,458752> %q:ptr<DiskQword,8> {
    @b0
        %nm = call sh_wname %ws
        %qb = view %q ptr<Byte,64>
        call mem_copy_b 64 %qb 64 %nm 64
        ret
}

# Lệnh xin một thao tác LightFS
func sh_req void %st:ptr<ShState,1> %op:bv64 %id:bv64 %len:bv64 {
    @b0
        store %st ShState.op_id %id
        store %st ShState.op_len %len
        store %st ShState.op %op
        ret
}

func sh_res bv64 %st:ptr<ShState,1> {
    @b0
        %r = load %st ShState.op_res
        ret %r
}

func sh_is_err bv64 %res:bv64 {
    @ens ule %r 1
    @b0
        %e = lshr %res 63
        ret %e
}

# ---------------------------------------------------------------- tách lệnh

# ---------------------------------------------------------------- biến shell
# Vùng VARS (4096 byte): qword 0 = số byte đã dùng (kể cả 8 byte đầu); sau đó các mục
#   [độ dài tên: 1 byte][độ dài giá trị: 2 byte LE][tên][giá trị]

def SH_VARS_N 4096

func sh_vars ptr<Byte,4096> %ws:ptr<Byte,458752> {
    @b0
        %a = slice %ws SH_W_VARS ptr<Byte,4096>
        ret %a
}

func sh_vused bv64 %ws:ptr<Byte,458752> {
    @ens uge %r 8
    @ens ule %r SH_VARS_N
    @b0
        %v = call sh_vars %ws
        %h = slice %v 0 ptr<Byte,8>
        %q = view %h ptr<DiskQword,1>
        %u = load %q 0 bv64
        %u1 = call math_max %u 8
        %u2 = call math_min %u1 SH_VARS_N
        ret %u2
}

func sh_vset_used void %ws:ptr<Byte,458752> %u:bv64 {
    @b0
        %v = call sh_vars %ws
        %h = slice %v 0 ptr<Byte,8>
        %q = view %h ptr<DiskQword,1>
        store %q 0 %u
        ret
}

func sh_vbyte bv64 %ws:ptr<Byte,458752> %p:bv64 {
    @ens ult %r 256
    @b0
        %v = call sh_vars %ws
        %in = cmp ult %p SH_VARS_N
        br %in @y @n
    @y
        %q = slice %v %p ptr<Byte,1>
        %b = load %q 0 bv8
        %r = call byte_u64 %b
        ret %r
    @n
        ret 0
}

# Cuối mục bắt đầu ở %p (vị trí mục kế tiếp); trả 0 nếu mục hỏng / vượt %used
func sh_vend bv64 %ws:ptr<Byte,458752> %p:bv64 %used:bv64 {
    @req ule %used SH_VARS_N
    @ens ule %r %used
    @b0
        %kl = call sh_vbyte %ws %p
        %p1 = add_sat %p 1
        %lo = call sh_vbyte %ws %p1
        %p2 = add_sat %p 2
        %hi = call sh_vbyte %ws %p2
        %hs = shl %hi 8
        %vl = or %hs %lo
        %e0 = add_sat %p 3
        %e1 = add_sat %e0 %kl
        %e = add_sat %e1 %vl
        %z = cmp eq %kl 0
        %over = cmp ugt %e %used
        %bad = or %z %over
        br %bad @no @yes
    @no
        ret 0
    @yes
        ret %e
}

# Vị trí mục có tên (k, name), hoặc 0 nếu không có
func sh_var_find bv64 %ws:ptr<Byte,458752> %k:bv64 %name:ptr<Byte,%k> {
    @ens ult %r SH_VARS_N
    @b0
        %used = call sh_vused %ws
        %v = call sh_vars %ws
        jmp @l 8
    @l %p:bv64
        @inv ule %p SH_VARS_N
        @dec sub SH_VARS_N %p
        %more = cmp ult %p %used
        br %more @body @none
    @body
        %e = call sh_vend %ws %p %used
        %ok = cmp ugt %e %p
        br %ok @cmp @none
    @cmp
        %kl = call sh_vbyte %ws %p
        %same = cmp eq %kl %k
        br %same @name @next
    @name
        %no0 = add %p 3
        %no = call math_min %no0 SH_VARS_N
        %room = sub SH_VARS_N %no
        %fit = cmp ule %k %room
        br %fit @eq @next
    @eq
        %nm = slice %v %no ptr<Byte,%k>
        %hit = call str_eq %k %nm %k %name
        %h = cmp ne %hit 0
        br %h @found @next
    @found
        %r = call math_min %p 4095
        ret %r
    @next
        jmp @l %e
    @none
        ret 0
}

# Vị trí và độ dài giá trị của mục ở %p (mục đã kiểm bằng sh_var_find)
func sh_var_voff bv64 %ws:ptr<Byte,458752> %p:bv64 {
    @ens ule %r SH_VARS_N
    @b0
        %kl = call sh_vbyte %ws %p
        %o0 = add_sat %p 3
        %o1 = add_sat %o0 %kl
        %r = call math_min %o1 SH_VARS_N
        ret %r
}

func sh_var_vlen bv64 %ws:ptr<Byte,458752> %p:bv64 %room:bv64 {
    @ens ule %r %room
    @b0
        %p1 = add_sat %p 1
        %lo = call sh_vbyte %ws %p1
        %p2 = add_sat %p 2
        %hi = call sh_vbyte %ws %p2
        %hs = shl %hi 8
        %vl = or %hs %lo
        %r = call math_min %vl %room
        ret %r
}

# Xóa mục ở %p (dồn các mục sau lên)
func sh_var_del void %ws:ptr<Byte,458752> %p:bv64 {
    @b0
        %used = call sh_vused %ws
        %e = call sh_vend %ws %p %used
        %ok = cmp ugt %e %p
        br %ok @go @out
    @go
        %v = call sh_vars %ws
        %pp = call math_min %p %e
        %k = sub %used %e
        %room = sub SH_VARS_N %pp
        %dst = slice %v %pp ptr<Byte,%room>
        %src = slice %v %e ptr<Byte,%k>
        %fit = cmp ule %k %room
        br %fit @move @out
    @move
        call mem_copy_b %room %dst %k %src %k
        %d = sub %e %pp
        %u2 = sub %used %d
        call sh_vset_used %ws %u2
        ret
    @out
        ret
}

# Đặt biến (k, name) = (m, val). Trả 1, hoặc 0 nếu không đủ chỗ / tên quá dài
func sh_var_set bv64 %ws:ptr<Byte,458752> %k:bv64 %name:ptr<Byte,%k> %m:bv64 %val:ptr<Byte,%m> {
    @ens ule %r 1
    @b0
        %p = call sh_var_find %ws %k %name
        %has = cmp ne %p 0
        br %has @del @add
    @del
        call sh_var_del %ws %p
        jmp @add
    @add
        %kbad = cmp ugt %k 64
        %mbad = cmp ugt %m 4000
        %bad = or %kbad %mbad
        br %bad @no @room
    @room
        %used = call sh_vused %ws
        %need0 = add %k %m
        %need = add %need0 3
        %free = sub SH_VARS_N %used
        %fit = cmp ule %need %free
        br %fit @put @no
    @put
        %v = call sh_vars %ws
        %e = slice %v %used ptr<Byte,%free>
        %kb = narrow %k bv8
        %h0 = slice %e 0 ptr<Byte,1>
        store %h0 0 %kb
        %lo = and %m 0xff
        %lob = narrow %lo bv8
        %h1 = slice %e 1 ptr<Byte,1>
        store %h1 0 %lob
        %hi = lshr %m 8
        %hib = narrow %hi bv8
        %h2 = slice %e 2 ptr<Byte,1>
        store %h2 0 %hib
        %r1 = sub %free 3
        %nm = slice %e 3 ptr<Byte,%r1>
        call mem_copy_b %r1 %nm %k %name %k
        %vo = add %k 3
        %r2 = sub %free %vo
        %vd = slice %e %vo ptr<Byte,%r2>
        call mem_copy_b %r2 %vd %m %val %m
        %u2 = add %used %need
        call sh_vset_used %ws %u2
        ret 1
    @no
        ret 0
}

# ---------------------------------------------------------------- tách từ


data SH_M_SYNTAX Byte {
    "sh: syntax error\n"
}
data SH_M_LONG Byte {
    "sh: command line too long\n"
}
data SH_M_MANY Byte {
    "sh: too many arguments (max 62)\n"
}

# Byte đặc biệt với shell: dấu cách, tab, ' " | ; & < > $
func sh_is_meta bv64 %c:bv8 {
    @ens ule %r 1
    @b0
        %v = call byte_u64 %c
        %a = cmp eq %v 32
        %b = cmp eq %v 9
        %d = cmp eq %v 39
        %e = cmp eq %v 34
        %f = cmp eq %v 124
        %g = cmp eq %v 59
        %h = cmp eq %v 38
        %i = cmp eq %v 60
        %j = cmp eq %v 62
        %k = cmp eq %v 36
        %x1 = or %a %b
        %x2 = or %x1 %d
        %x3 = or %x2 %e
        %x4 = or %x3 %f
        %x5 = or %x4 %g
        %x6 = or %x5 %h
        %x7 = or %x6 %i
        %x8 = or %x7 %j
        %x9 = or %x8 %k
        br %x9 @y @n
    @y
        ret 1
    @n
        ret 0
}

# Ký tự tên biến: chữ, '_' và (nếu %first = 0) chữ số
func sh_is_namec bv64 %c:bv8 %first:bv64 {
    @ens ule %r 1
    @b0
        %v = call byte_u64 %c
        %u0 = cmp uge %v 65
        %u1 = cmp ule %v 90
        %up = and %u0 %u1
        %l0 = cmp uge %v 97
        %l1 = cmp ule %v 122
        %lo = and %l0 %l1
        %us = cmp eq %v 95
        %d0 = cmp uge %v 48
        %d1 = cmp ule %v 57
        %dg = and %d0 %d1
        %nf = cmp eq %first 0
        %dok = and %dg %nf
        %x1 = or %up %lo
        %x2 = or %x1 %us
        %x3 = or %x2 %dok
        br %x3 @y @n
    @y
        ret 1
    @n
        ret 0
}

func sh_lexflag void %st:ptr<ShState,1> %f:bv64 {
    @b0
        %e = load %st ShState.lexerr
        %e1 = or %e %f
        store %st ShState.lexerr %e1
        ret
}

# Một byte vào ARGB ở %bp; hết chỗ thì bật lexerr bit 0
func sh_emit bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> %bp:bv64 %c:bv8 {
    @req ule %bp SH_ARGB_N
    @ens ule %r SH_ARGB_N
    @ens uge %r %bp
    @b0
        %fit = cmp ult %bp SH_ARGB_N
        br %fit @put @full
    @put
        %argb = call sh_argb %ws
        %p = slice %argb %bp ptr<Byte,1>
        store %p 0 %c
        %r = add %bp 1
        ret %r
    @full
        call sh_lexflag %st 1
        ret %bp
}

func sh_emit_str bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> %bp:bv64 %k:bv64 %src:ptr<Byte,%k> {
    @req ule %bp SH_ARGB_N
    @ens ule %r SH_ARGB_N
    @ens uge %r %bp
    @b0
        %argb = call sh_argb %ws
        %room = sub SH_ARGB_N %bp
        %fit = cmp ule %k %room
        br %fit @put @full
    @put
        %dst = slice %argb %bp ptr<Byte,%room>
        call mem_copy_b %room %dst %k %src %k
        %r = add %bp %k
        ret %r
    @full
        call sh_lexflag %st 1
        ret %bp
}

# Giá trị biến (k, name) vào ARGB ở %bp
func sh_emit_var bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> %bp:bv64 %k:bv64 %name:ptr<Byte,%k> {
    @req ule %bp SH_ARGB_N
    @ens ule %r SH_ARGB_N
    @ens uge %r %bp
    @b0
        %p = call sh_var_find %ws %k %name
        %has = cmp ne %p 0
        br %has @val @none
    @none
        ret %bp
    @val
        %v = call sh_vars %ws
        %vo = call sh_var_voff %ws %p
        %room = sub SH_VARS_N %vo
        %vl = call sh_var_vlen %ws %p %room
        %src = slice %v %vo ptr<Byte,%vl>
        %r = call sh_emit_str %st %ws %bp %vl %src
        ret %r
}

# s[i] = '$': $? / ${TÊN} / $TÊN (không có -> rỗng); khác -> '$'. Trả vị trí mới; ARGB mới ở ShState.v3
func sh_expand bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> %n:bv64 %s:ptr<Byte,%n> %i:bv64 %bp:bv64 {
    @req ult %i %n
    @req ule %bp SH_ARGB_N
    @ens ugt %r %i
    @ens ule %r %n
    @b0
        %i1 = add %i 1
        %end = cmp uge %i1 %n
        br %end @dollar @look
    @dollar
        %b1 = call sh_emit %st %ws %bp 36
        store %st ShState.v3 %b1
        ret %i1
    @look
        %p = slice %s %i1 ptr<Byte,1>
        %c = load %p 0 bv8
        %q = cmp eq %c 63
        br %q @status @t_brace
    @status
        %rc = load %st ShState.status
        %buf = addr SH_NUM
        %kd = call fmt_u64 SH_NUM.len %buf 0 %rc
        %ds = slice %buf 0 ptr<Byte,%kd>
        %b2 = call sh_emit_str %st %ws %bp %kd %ds
        store %st ShState.v3 %b2
        %i2 = add %i 2
        ret %i2
    @t_brace
        %br = cmp eq %c 123
        br %br @brace @t_name
    @brace
        %i2b = add %i 2
        %j = call str_find %n %s %i2b 125
        %miss0 = cmp uge %j %n
        %miss1 = cmp uge %i2b %n
        %miss = or %miss0 %miss1
        br %miss @unclosed @bname
    @unclosed
        call sh_lexflag %st 4
        store %st ShState.v3 %bp
        ret %n
    @bname
        %ja = call math_max %j %i2b
        %kl = sub %ja %i2b
        %nm = slice %s %i2b ptr<Byte,%kl>
        %b3 = call sh_emit_var %st %ws %bp %kl %nm
        store %st ShState.v3 %b3
        %j1 = add %ja 1
        ret %j1
    @t_name
        %nc = call sh_is_namec %c 1
        %isn = cmp ne %nc 0
        br %isn @scan @dollar
    @scan
        jmp @l %i1
    @l %k:bv64
        @inv ugt %k %i
        @inv ule %k %n
        %more = cmp ult %k %n
        br %more @ch @done
    @ch
        %pk = slice %s %k ptr<Byte,1>
        %ck = load %pk 0 bv8
        %ok = call sh_is_namec %ck 0
        %isk = cmp ne %ok 0
        br %isk @adv @done
    @adv
        %k2 = add %k 1
        jmp @l %k2
    @done
        %kl2 = sub %k %i1
        %nm2 = slice %s %i1 ptr<Byte,%kl2>
        %b4 = call sh_emit_var %st %ws %bp %kl2 %nm2
        store %st ShState.v3 %b4
        ret %k
}

# Từ ARGB[w, bp) có dạng TÊN=... ?
func sh_is_assign bv64 %k:bv64 %w:ptr<Byte,%k> {
    @ens ule %r 1
    @b0
        %eq = call str_find %k %w 0 61
        %none = cmp uge %eq %k
        %zero = cmp eq %eq 0
        %bad = or %none %zero
        br %bad @n @scan
    @scan
        jmp @l 0
    @l %i:bv64
        @inv ule %i %eq
        @inv ult %eq %k
        %more = cmp ult %i %eq
        br %more @ch @y
    @ch
        %p = slice %w %i ptr<Byte,1>
        %c = load %p 0 bv8
        %fv = sub_sat 1 %i
        %okc = call sh_is_namec %c %fv
        %ok = cmp ne %okc 0
        %i2 = add %i 1
        br %ok @next @n
    @next
        jmp @l %i2
    @y
        ret 1
    @n
        ret 0
}

# Hết một từ ARGB[w, bp): đối số thường, hoặc file đích của chuyển hướng %tgt (1 '>', 2 '>>', 3 '<')
func sh_word_end void %st:ptr<ShState,1> %ws:ptr<Byte,458752> %w:bv64 %bp:bv64 %tgt:bv64 {
    @req ule %w %bp
    @req ule %bp SH_ARGB_N
    @b0
        %len = sub %bp %w
        %is_in = cmp eq %tgt 3
        br %is_in @tin @t_out
    @tin
        call sh_arg_set %ws SH_A_IN %w %len
        store %st ShState.iarg SH_A_IN
        ret
    @t_out
        %is_out = cmp ne %tgt 0
        br %is_out @tout @word
    @tout
        call sh_arg_set %ws SH_A_OUT %w %len
        store %st ShState.rarg SH_A_OUT
        store %st ShState.rmode %tgt
        ret
    @word
        %c0 = load %st ShState.argc
        %c = call math_min %c0 SH_MAX_WORDS
        %full = cmp uge %c SH_MAX_WORDS
        br %full @many @put
    @many
        call sh_lexflag %st 2
        ret
    @put
        call sh_arg_set %ws %c %w %len
        %c1 = add %c 1
        store %st ShState.argc %c1
        %na = load %st ShState.nassign
        %lead = cmp eq %na %c
        br %lead @chk @out
    @chk
        %argb = call sh_argb %ws
        %wd = slice %argb %w ptr<Byte,%len>
        %as = call sh_is_assign %len %wd
        %isa = cmp ne %as 0
        br %isa @assign @out
    @assign
        store %st ShState.nassign %c1
        ret
    @out
        ret
}

# Đóng từ đang dở trước một toán tử; '>' / '<' chưa có file đích -> lỗi cú pháp
func sh_lex_close void %st:ptr<ShState,1> %ws:ptr<Byte,458752> %w:bv64 %bp:bv64 %inw:bv64 %tgt:bv64 {
    @req ule %w %bp
    @req ule %bp SH_ARGB_N
    @b0
        %has = cmp ne %inw 0
        br %has @end @chk
    @end
        call sh_word_end %st %ws %w %bp %tgt
        ret
    @chk
        %pend = cmp ne %tgt 0
        br %pend @bad @ok
    @bad
        call sh_lexflag %st 4
        ret
    @ok
        ret
}

# Tách MỘT lệnh từ ShState.pos: đối số (đã bỏ nháy, thay biến) vào ARGB / ARGO, chuyển hướng, dấu kết thúc.
# Trả vị trí sau lệnh (sau toán tử). Lỗi ở ShState.lexerr.
func sh_lex bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> %n:bv64 %s:ptr<Byte,%n> {
    @ens ule %r %n
    @b0
        store %st ShState.argc 0
        store %st ShState.nassign 0
        store %st ShState.lexerr 0
        store %st ShState.rmode 0
        store %st ShState.iarg 0
        store %st ShState.term SH_T_END
        %p0 = load %st ShState.pos
        %p = call math_min %p0 %n
        jmp @l %p 0 0 0 0 0
    @l %i:bv64 %bp:bv64 %mode:bv64 %inw:bv64 %tgt:bv64 %w:bv64
        @inv ule %i %n
        @inv ule %bp SH_ARGB_N
        @inv ule %w %bp
        @dec sub %n %i
        %more = cmp ult %i %n
        br %more @ch @eol
    @eol
        %open = cmp ne %mode 0
        br %open @unterminated @eol2
    @unterminated
        call sh_lexflag %st 4
        ret %n
    @eol2
        call sh_lex_close %st %ws %w %bp %inw %tgt
        ret %n
    @ch
        %pc = slice %s %i ptr<Byte,1>
        %c = load %pc 0 bv8
        %i1 = add %i 1
        %m1 = cmp eq %mode 1
        br %m1 @sq @t_dq
    @sq
        %sq_end = cmp eq %c 39
        br %sq_end @sq_close @sq_put
    @sq_close
        jmp @l %i1 %bp 0 1 %tgt %w
    @sq_put
        %b1 = call sh_emit %st %ws %bp %c
        jmp @l %i1 %b1 1 1 %tgt %w
    @t_dq
        %m2 = cmp eq %mode 2
        br %m2 @dq @nq
    @dq
        %dq_end = cmp eq %c 34
        br %dq_end @dq_close @dq_t_bs
    @dq_close
        jmp @l %i1 %bp 0 1 %tgt %w
    @dq_t_bs
        %dbs = cmp eq %c 92
        %dhas = cmp ult %i1 %n
        %desc = and %dbs %dhas
        br %desc @dq_bs @dq_t_dol
    @dq_bs
        %pn = slice %s %i1 ptr<Byte,1>
        %cn = load %pn 0 bv8
        %e1 = cmp eq %cn 34
        %e2 = cmp eq %cn 36
        %e12 = or %e1 %e2
        br %e12 @dq_esc @dq_put
    @dq_esc
        %b2 = call sh_emit %st %ws %bp %cn
        %i2 = add %i 2
        jmp @l %i2 %b2 2 1 %tgt %w
    @dq_t_dol
        %ddol = cmp eq %c 36
        br %ddol @dq_dol @dq_put
    @dq_dol
        %ie = call sh_expand %st %ws %n %s %i %bp
        %v3 = load %st ShState.v3
        %b3a = call math_min %v3 SH_ARGB_N
        %b3 = call math_max %b3a %bp
        jmp @l %ie %b3 2 1 %tgt %w
    @dq_put
        %b4 = call sh_emit %st %ws %bp %c
        jmp @l %i1 %b4 2 1 %tgt %w
    @nq
        %sp = cmp eq %c 32
        %tb = cmp eq %c 9
        %blank = or %sp %tb
        br %blank @blank @t_semi
    @blank
        %hasw = cmp ne %inw 0
        br %hasw @blank_end @blank_skip
    @blank_end
        call sh_word_end %st %ws %w %bp %tgt
        %wa = or %bp 0
        jmp @l %i1 %bp 0 0 0 %wa
    @blank_skip
        %wb = or %bp 0
        jmp @l %i1 %bp 0 0 %tgt %wb
    @t_semi
        %semi = cmp eq %c 59
        br %semi @semi @t_pipe
    @semi
        call sh_lex_close %st %ws %w %bp %inw %tgt
        store %st ShState.term SH_T_SEMI
        ret %i1
    @t_pipe
        %bar = cmp eq %c 124
        br %bar @pipe @t_amp
    @pipe
        call sh_lex_close %st %ws %w %bp %inw %tgt
        %has2 = cmp ult %i1 %n
        br %has2 @pipe2 @single
    @pipe2
        %pb = slice %s %i1 ptr<Byte,1>
        %cb = load %pb 0 bv8
        %oror = cmp eq %cb 124
        br %oror @or @single
    @or
        store %st ShState.term SH_T_OR
        %io = add %i 2
        ret %io
    @single
        store %st ShState.term SH_T_PIPE
        ret %i1
    @t_amp
        %amp = cmp eq %c 38
        br %amp @amp @t_gt
    @amp
        call sh_lex_close %st %ws %w %bp %inw %tgt
        %has3 = cmp ult %i1 %n
        br %has3 @amp2 @lone
    @amp2
        %pa = slice %s %i1 ptr<Byte,1>
        %ca = load %pa 0 bv8
        %andand = cmp eq %ca 38
        br %andand @and @lone
    @and
        store %st ShState.term SH_T_AND
        %ia = add %i 2
        ret %ia
    @lone
        call sh_lexflag %st 4
        ret %i1
    @t_gt
        %gt = cmp eq %c 62
        %lt = cmp eq %c 60
        %redir = or %gt %lt
        br %redir @redir @t_q1
    @redir
        call sh_lex_close %st %ws %w %bp %inw %tgt
        br %lt @rin @rout
    @rin
        %wc = or %bp 0
        jmp @l %i1 %bp 0 0 3 %wc
    @rout
        %has4 = cmp ult %i1 %n
        br %has4 @rout2 @rtrunc
    @rout2
        %pg = slice %s %i1 ptr<Byte,1>
        %cg = load %pg 0 bv8
        %gtgt = cmp eq %cg 62
        br %gtgt @rapp @rtrunc
    @rapp
        %ig = add %i 2
        %wd = or %bp 0
        jmp @l %ig %bp 0 0 2 %wd
    @rtrunc
        %we = or %bp 0
        jmp @l %i1 %bp 0 0 1 %we
    @t_q1
        %q1 = cmp eq %c 39
        br %q1 @open1 @t_q2
    @open1
        jmp @l %i1 %bp 1 1 %tgt %w
    @t_q2
        %q2 = cmp eq %c 34
        br %q2 @open2 @t_bs
    @open2
        jmp @l %i1 %bp 2 1 %tgt %w
    @t_bs
        %bs = cmp eq %c 92
        %hasn = cmp ult %i1 %n
        %bsn = and %bs %hasn
        br %bsn @bs @t_dol
    @bs
        %pm = slice %s %i1 ptr<Byte,1>
        %cm = load %pm 0 bv8
        %meta = call sh_is_meta %cm
        %ism = cmp ne %meta 0
        br %ism @bs_esc @put
    @bs_esc
        %b5 = call sh_emit %st %ws %bp %cm
        %i3 = add %i 2
        jmp @l %i3 %b5 0 1 %tgt %w
    @t_dol
        %dol = cmp eq %c 36
        br %dol @dol @put
    @dol
        %ie2 = call sh_expand %st %ws %n %s %i %bp
        %v32 = load %st ShState.v3
        %b6a = call math_min %v32 SH_ARGB_N
        %b6 = call math_max %b6a %bp
        # $X rỗng ngoài nháy không tạo từ
        %grew = cmp ugt %b6 %bp
        %was = cmp ne %inw 0
        %inw2 = or %grew %was
        br %inw2 @dol_w @dol_nw
    @dol_w
        jmp @l %ie2 %b6 0 1 %tgt %w
    @dol_nw
        jmp @l %ie2 %b6 0 0 %tgt %w
    @put
        %b7 = call sh_emit %st %ws %bp %c
        jmp @l %i1 %b7 0 1 %tgt %w
}

# Mã lệnh của argv[0] (0 = không có lệnh này)
func sh_lookup bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> {
    @ens ule %r SH_K_LAST
    @b0
        %c1 = addr SH_C_HELP
        %i1 = call sh_arg_is %st %ws 0 SH_C_HELP.len %c1
        %b1 = cmp ne %i1 0
        br %b1 @k1 @t2
    @k1
        ret SH_K_HELP
    @t2
        %c2 = addr SH_C_ECHO
        %i2 = call sh_arg_is %st %ws 0 SH_C_ECHO.len %c2
        %b2 = cmp ne %i2 0
        br %b2 @k2 @t3
    @k2
        ret SH_K_ECHO
    @t3
        %c3 = addr SH_C_PWD
        %i3 = call sh_arg_is %st %ws 0 SH_C_PWD.len %c3
        %b3 = cmp ne %i3 0
        br %b3 @k3 @t4
    @k3
        ret SH_K_PWD
    @t4
        %c4 = addr SH_C_LS
        %i4 = call sh_arg_is %st %ws 0 SH_C_LS.len %c4
        %b4 = cmp ne %i4 0
        br %b4 @k4 @t5
    @k4
        ret SH_K_LS
    @t5
        %c5 = addr SH_C_CD
        %i5 = call sh_arg_is %st %ws 0 SH_C_CD.len %c5
        %b5 = cmp ne %i5 0
        br %b5 @k5 @t6
    @k5
        ret SH_K_CD
    @t6
        %c6 = addr SH_C_STAT
        %i6 = call sh_arg_is %st %ws 0 SH_C_STAT.len %c6
        %b6 = cmp ne %i6 0
        br %b6 @k6 @t7
    @k6
        ret SH_K_STAT
    @t7
        %c7 = addr SH_C_CAT
        %i7 = call sh_arg_is %st %ws 0 SH_C_CAT.len %c7
        %b7 = cmp ne %i7 0
        br %b7 @k7 @t8
    @k7
        ret SH_K_CAT
    @t8
        %c8 = addr SH_C_WRITE
        %i8 = call sh_arg_is %st %ws 0 SH_C_WRITE.len %c8
        %b8 = cmp ne %i8 0
        br %b8 @k8 @t9
    @k8
        ret SH_K_WRITE
    @t9
        %c9 = addr SH_C_APPEND
        %i9 = call sh_arg_is %st %ws 0 SH_C_APPEND.len %c9
        %b9 = cmp ne %i9 0
        br %b9 @k9 @t10
    @k9
        ret SH_K_APPEND
    @t10
        %c10 = addr SH_C_MKDIR
        %i10 = call sh_arg_is %st %ws 0 SH_C_MKDIR.len %c10
        %b10 = cmp ne %i10 0
        br %b10 @k10 @t11
    @k10
        ret SH_K_MKDIR
    @t11
        %c11 = addr SH_C_TOUCH
        %i11 = call sh_arg_is %st %ws 0 SH_C_TOUCH.len %c11
        %b11 = cmp ne %i11 0
        br %b11 @k11 @t12
    @k11
        ret SH_K_TOUCH
    @t12
        %c12 = addr SH_C_RM
        %i12 = call sh_arg_is %st %ws 0 SH_C_RM.len %c12
        %b12 = cmp ne %i12 0
        br %b12 @k12 @t13
    @k12
        ret SH_K_RM
    @t13
        %c13 = addr SH_C_ENV
        %i13 = call sh_arg_is %st %ws 0 SH_C_ENV.len %c13
        %b13 = cmp ne %i13 0
        br %b13 @k13 @t14
    @k13
        ret SH_K_ENV
    @t14
        %c14 = addr SH_C_UNSET
        %i14 = call sh_arg_is %st %ws 0 SH_C_UNSET.len %c14
        %b14 = cmp ne %i14 0
        br %b14 @k14 @t15
    @k14
        ret SH_K_UNSET
    @t15
        %c15 = addr SH_C_TRUE
        %i15 = call sh_arg_is %st %ws 0 SH_C_TRUE.len %c15
        %b15 = cmp ne %i15 0
        br %b15 @k15 @t16
    @k15
        ret SH_K_TRUE
    @t16
        %c16 = addr SH_C_FALSE
        %i16 = call sh_arg_is %st %ws 0 SH_C_FALSE.len %c16
        %b16 = cmp ne %i16 0
        br %b16 @k16 @t17
    @k16
        ret SH_K_FALSE
    @t17
        %c17 = addr SH_C_GREP
        %i17 = call sh_arg_is %st %ws 0 SH_C_GREP.len %c17
        %b17 = cmp ne %i17 0
        br %b17 @k17 @t18
    @k17
        ret SH_K_GREP
    @t18
        %c18 = addr SH_C_WC
        %i18 = call sh_arg_is %st %ws 0 SH_C_WC.len %c18
        %b18 = cmp ne %i18 0
        br %b18 @k18 @t19
    @k18
        ret SH_K_WC
    @t19
        %c19 = addr SH_C_HEAD
        %i19 = call sh_arg_is %st %ws 0 SH_C_HEAD.len %c19
        %b19 = cmp ne %i19 0
        br %b19 @k19 @t20
    @k19
        ret SH_K_HEAD
    @t20
        %c20 = addr SH_C_TAIL
        %i20 = call sh_arg_is %st %ws 0 SH_C_TAIL.len %c20
        %b20 = cmp ne %i20 0
        br %b20 @k20 @t21
    @k20
        ret SH_K_TAIL
    @t21
        %c21 = addr SH_C_SORT
        %i21 = call sh_arg_is %st %ws 0 SH_C_SORT.len %c21
        %b21 = cmp ne %i21 0
        br %b21 @k21 @t22
    @k21
        ret SH_K_SORT
    @t22
        %c22 = addr SH_C_UNIQ
        %i22 = call sh_arg_is %st %ws 0 SH_C_UNIQ.len %c22
        %b22 = cmp ne %i22 0
        br %b22 @k22 @t23
    @k22
        ret SH_K_UNIQ
    @t23
        %c23 = addr SH_C_FIND
        %i23 = call sh_arg_is %st %ws 0 SH_C_FIND.len %c23
        %b23 = cmp ne %i23 0
        br %b23 @k23 @none
    @k23
        ret SH_K_FIND
    @none
        ret 0
}

# ---------------------------------------------------------------- lệnh đụng đĩa

# mkdir / touch / rm PATH
func sh_c_fs bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> %tab:ptr<DiskQword,4096> %k:bv64 %ec:bv64 %err:ptr<Byte,%ec> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @ens ule %r SH_NEED
    @b0
        %sub = load %st ShState.sub
        %got = cmp eq %sub 1
        br %got @result @start
    @result
        store %st ShState.sub 0
        %res = call sh_res %st
        %bad = call sh_is_err %res
        %isbad = cmp ne %bad 0
        br %isbad @rfail @ok
    @rfail
        call sh_fail_c %st %ws %ec %err %res 1
        ret 1
    @ok
        ret 0
    @start
        %argc = call sh_argc %st
        %no = cmp ult %argc 2
        br %no @usage @look
    @usage
        call sh_usage %st %ws %ec %err
        ret 2
    @look
        %is_rm = cmp eq %k SH_K_RM
        %id = call sh_resolve_arg %st %ws %tab 1
        %miss = cmp eq %id SH_NONE
        br %miss @absent @present
    @present
        br %is_rm @rm @p_mk
    @rm
        %root = cmp eq %id 0
        br %root @rmroot @del
    @rmroot
        call sh_err_arg %st %ws %ec %err 0
        %mr = addr SH_M_ROOT
        call sh_err %st %ec %err SH_M_ROOT.len %mr
        ret 1
    @del
        store %st ShState.sub 1
        call sh_req %st SH_OP_DELETE %id 0
        ret SH_NEED
    @p_mk
        %is_mk = cmp eq %k SH_K_MKDIR
        br %is_mk @exists @nothing
    @exists
        %mx = addr SH_M_EXISTS
        call sh_fail_a %st %ws %ec %err SH_M_EXISTS.len %mx 1
        ret 1
    @nothing
        ret 0
    @absent
        br %is_rm @noent @mkparent
    @noent
        %m = addr SH_M_NOENT
        call sh_fail_a %st %ws %ec %err SH_M_NOENT.len %m 1
        ret 1
    @mkparent
        %par = call sh_parent_arg %st %ws %tab 1
        %nopar = cmp eq %par SH_NONE
        br %nopar @noent @name
    @name
        %okn = call sh_name_arg %st %ws 1
        %good = cmp ne %okn 0
        br %good @create @badname
    @badname
        %mb = addr SH_M_BADNAME
        call sh_fail_a %st %ws %ec %err SH_M_BADNAME.len %mb 1
        ret 1
    @create
        store %st ShState.sub 1
        %mk = cmp eq %k SH_K_MKDIR
        br %mk @cdir @cfile
    @cdir
        call sh_req %st SH_OP_CREATE %par 2
        ret SH_NEED
    @cfile
        call sh_req %st SH_OP_CREATE %par 0
        ret SH_NEED
}

# Đối số [from, argc) vào OUT, cách nhau một dấu cách; %esc != 0: giải thoát ký tự (\n \t \\ \xHH)
func sh_put_args void %st:ptr<ShState,1> %ws:ptr<Byte,458752> %from:bv64 %esc:bv64 {
    @req ule %from SH_MAX_ARGS
    @b0
        %argc = call sh_argc %st
        %argb = call sh_argb %ws
        %o = call sh_bout %st %ws
        jmp @l %from
    @l %j:bv64
        @inv ule %j SH_MAX_ARGS
        @dec sub SH_MAX_ARGS %j
        %more = cmp ult %j %argc
        br %more @one @end
    @one
        %j1 = add %j 1
        %first = cmp eq %j %from
        br %first @arg @sep
    @sep
        call sh_put_byte %st %ws 32
        jmp @arg
    @arg
        %ao = call sh_arg_off %ws %j
        %ar = sub SH_ARGB_N %ao
        %al = call sh_arg_len %st %ws %j %ar
        %a = slice %argb %ao ptr<Byte,%al>
        %e = cmp ne %esc 0
        br %e @unesc @raw
    @raw
        call sh_put %st %ws %al %a
        jmp @l %j1
    @unesc
        %ol = call sh_outlen %st
        %room = sub SH_BUF_N %ol
        %fits = cmp ule %al %room
        br %fits @fill @over
    @fill
        %pos = call sh_unescape %al %a SH_BUF_N %o %ol
        store %st ShState.out_len %pos
        jmp @l %j1
    @over
        %t = load %st ShState.trunc
        %t1 = or %t 4
        store %st ShState.trunc %t1
        ret
    @end
        ret
}

# echo [-n] [-e] ARG...
func sh_c_echo bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> {
    @ens ule %r 0
    @b0
        jmp @l 1 0 0
    @l %j:bv64 %nonl:bv64 %esc:bv64
        @inv ule %j SH_MAX_ARGS
        @dec sub SH_MAX_ARGS %j
        %argc = call sh_argc %st
        %more = cmp ult %j %argc
        br %more @opt @go
    @opt
        %j1 = add %j 1
        %cn = addr SH_O_N
        %isn = call sh_arg_is %st %ws %j SH_O_N.len %cn
        %bn = cmp ne %isn 0
        br %bn @on @t_e
    @on
        jmp @l %j1 1 %esc
    @t_e
        %ce = addr SH_O_E
        %ise = call sh_arg_is %st %ws %j SH_O_E.len %ce
        %be = cmp ne %ise 0
        br %be @oe @t_ne
    @oe
        jmp @l %j1 %nonl 1
    @t_ne
        %c1 = addr SH_O_NE
        %i1 = call sh_arg_is %st %ws %j SH_O_NE.len %c1
        %c2 = addr SH_O_EN
        %i2 = call sh_arg_is %st %ws %j SH_O_EN.len %c2
        %both = or %i1 %i2
        %bb = cmp ne %both 0
        br %bb @oboth @go
    @oboth
        jmp @l %j1 1 1
    @go
        call sh_put_args %st %ws %j %esc
        %nl = cmp eq %nonl 0
        br %nl @eol @done
    @eol
        call sh_put_byte %st %ws 10
        ret 0
    @done
        ret 0
}

# write / append PATH [TEXT...]: OUT = TEXT (đối số nối bằng dấu cách, đã giải thoát ký tự), chuyển hướng vào PATH
func sh_c_write bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> %k:bv64 %ec:bv64 %err:ptr<Byte,%ec> {
    @ens ule %r 2
    @b0
        %argc = call sh_argc %st
        %no = cmp ult %argc 2
        br %no @usage @t_redir
    @usage
        call sh_usage %st %ws %ec %err
        ret 2
    @t_redir
        %rm = load %st ShState.rmode
        %has = cmp ne %rm 0
        br %has @conflict @go
    @conflict
        store %st ShState.rmode 0
        call sh_err_arg %st %ws %ec %err 0
        %m = addr SH_M_NOREDIR
        call sh_err %st %ec %err SH_M_NOREDIR.len %m
        ret 2
    @go
        call sh_put_args %st %ws 2 1
        store %st ShState.rarg 1
        %ap = cmp eq %k SH_K_APPEND
        br %ap @mapp @mwr
    @mapp
        store %st ShState.rmode 2
        ret 0
    @mwr
        store %st ShState.rmode 1
        ret 0
}

# env: mọi biến dạng TÊN=giá_trị
func sh_c_env bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> {
    @ens ule %r 0
    @b0
        %used = call sh_vused %ws
        %v = call sh_vars %ws
        jmp @l 8
    @l %p:bv64
        @inv ule %p SH_VARS_N
        @dec sub SH_VARS_N %p
        %more = cmp ult %p %used
        br %more @body @end
    @body
        %e = call sh_vend %ws %p %used
        %ok = cmp ugt %e %p
        br %ok @show @end
    @show
        %kl = call sh_vbyte %ws %p
        %no0 = add %p 3
        %no = call math_min %no0 SH_VARS_N
        %r1 = sub SH_VARS_N %no
        %k = call math_min %kl %r1
        %nm = slice %v %no ptr<Byte,%k>
        call sh_put %st %ws %k %nm
        call sh_put_byte %st %ws 61
        %vo = call sh_var_voff %ws %p
        %r2 = sub SH_VARS_N %vo
        %vl = call sh_var_vlen %ws %p %r2
        %val = slice %v %vo ptr<Byte,%vl>
        call sh_put %st %ws %vl %val
        call sh_put_byte %st %ws 10
        jmp @l %e
    @end
        ret 0
}

# unset TÊN...
func sh_c_unset bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> {
    @ens ule %r 0
    @b0
        %argb = call sh_argb %ws
        jmp @l 1
    @l %j:bv64
        @inv ule %j SH_MAX_ARGS
        @dec sub SH_MAX_ARGS %j
        %argc = call sh_argc %st
        %more = cmp ult %j %argc
        br %more @one @end
    @one
        %j1 = add %j 1
        %ao = call sh_arg_off %ws %j
        %ar = sub SH_ARGB_N %ao
        %al = call sh_arg_len %st %ws %j %ar
        %a = slice %argb %ao ptr<Byte,%al>
        %p = call sh_var_find %ws %al %a
        %has = cmp ne %p 0
        br %has @del @next
    @del
        call sh_var_del %ws %p
        jmp @next
    @next
        jmp @l %j1
    @end
        ret 0
}

# Các từ TÊN=giá_trị đầu lệnh: đặt biến, rồi dồn đối số còn lại về đầu
func sh_assign void %st:ptr<ShState,1> %ws:ptr<Byte,458752> %ec:bv64 %err:ptr<Byte,%ec> {
    @b0
        %argc = call sh_argc %st
        %na0 = load %st ShState.nassign
        %na = call math_min %na0 %argc
        %argb = call sh_argb %ws
        jmp @l 0
    @l %j:bv64
        @inv ule %j SH_MAX_ARGS
        @dec sub SH_MAX_ARGS %j
        %more = cmp ult %j %na
        br %more @one @shift
    @one
        %j1 = add %j 1
        %ao = call sh_arg_off %ws %j
        %ar = sub SH_ARGB_N %ao
        %al = call sh_arg_len %st %ws %j %ar
        %a = slice %argb %ao ptr<Byte,%al>
        %eq = call str_find %al %a 0 61
        %nm = slice %a 0 ptr<Byte,%eq>
        %v0 = add_sat %eq 1
        %vs = call math_min %v0 %al
        %vl = sub %al %vs
        %val = slice %a %vs ptr<Byte,%vl>
        %ok = call sh_var_set %ws %eq %nm %vl %val
        %good = cmp ne %ok 0
        br %good @next @full
    @full
        %m = addr SH_M_VARFULL
        call sh_err %st %ec %err SH_M_VARFULL.len %m
        jmp @next
    @next
        jmp @l %j1
    @shift
        %left = sub %argc %na
        jmp @s 0
    @s %d:bv64
        @inv ule %d SH_MAX_ARGS
        @dec sub SH_MAX_ARGS %d
        %m2 = cmp ult %d %left
        br %m2 @mv @done
    @mv
        %src = add %d %na
        %srcc = call math_min %src 63
        %so = call sh_arg_off %ws %srcc
        %sr = sub SH_ARGB_N %so
        %sl = call sh_arg_len %st %ws %srcc %sr
        %dc = call math_min %d 63
        call sh_arg_set %ws %dc %so %sl
        %d1 = add %d 1
        jmp @s %d1
    @done
        store %st ShState.argc %left
        store %st ShState.nassign 0
        ret
}

# ---------------------------------------------------------------- công cụ văn bản (đọc file đối số hoặc stdin)

# Đối số %i vào OUT
func sh_put_arg void %st:ptr<ShState,1> %ws:ptr<Byte,458752> %i:bv64 {
    @req ult %i SH_MAX_ARGS
    @b0
        %argb = call sh_argb %ws
        %o = call sh_arg_off %ws %i
        %room = sub SH_ARGB_N %o
        %l = call sh_arg_len %st %ws %i %room
        %a = slice %argb %o ptr<Byte,%l>
        call sh_put %st %ws %l %a
        ret
}

# Số %v canh phải trong %width cột
func sh_put_pad void %st:ptr<ShState,1> %ws:ptr<Byte,458752> %v:bv64 %width:bv64 {
    @b0
        %buf = addr SH_NUM
        %k = call fmt_u64 SH_NUM.len %buf 0 %v
        %pad0 = sub_sat %width %k
        %pad = call math_min %pad0 16
        jmp @l 0
    @l %i:bv64
        @inv ule %i 16
        %more = cmp ult %i %pad
        br %more @sp @num
    @sp
        call sh_put_byte %st %ws 32
        %i2 = add %i 1
        jmp @l %i2
    @num
        %s = slice %buf 0 ptr<Byte,%k>
        call sh_put %st %ws %k %s
        ret
}

# Chuỗi toàn chữ số -> giá trị, hoặc 0xffffffffffffffff nếu rỗng / có ký tự khác / quá lớn
func sh_digits bv64 %k:bv64 %s:ptr<Byte,%k> {
    @b0
        %empty = cmp eq %k 0
        %big = cmp ugt %k 18
        %bad = or %empty %big
        br %bad @no @go
    @go
        jmp @l 0 0
    @l %i:bv64 %v:bv64
        @inv ule %i %k
        @inv ule %i 18
        %more = cmp ult %i %k
        br %more @ch @end
    @ch
        %p = slice %s %i ptr<Byte,1>
        %c = load %p 0 bv8
        %d = call byte_is_digit %c
        %isd = cmp ne %d 0
        br %isd @acc @no
    @acc
        %cv = call byte_u64 %c
        %dv = sub_sat %cv 48
        %v10 = mul_sat %v 10
        %v2 = add_sat %v10 %dv
        %i2 = add %i 1
        jmp @l %i2 %v2
    @end
        ret %v
    @no
        ret 0xffffffffffffffff
}

# Tùy chọn dạng -xyz (chữ trong (ln, letters) -> bit theo vị trí), "--" kết thúc.
# Trả chỉ số đối số đầu tiên không phải tùy chọn, hoặc 0 nếu có tùy chọn lạ (đã báo lỗi).
func sh_opts bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> %ln:bv64 %letters:ptr<Byte,%ln> %ec:bv64 %err:ptr<Byte,%ec> {
    @ens ule %r SH_MAX_ARGS
    @b0
        %argb = call sh_argb %ws
        %argc = call sh_argc %st
        jmp @l 1
    @l %j:bv64
        @inv ule %j SH_MAX_ARGS
        @dec sub SH_MAX_ARGS %j
        %more = cmp ult %j %argc
        br %more @arg @stop
    @stop
        ret %j
    @arg
        %j1 = add %j 1
        %ao = call sh_arg_off %ws %j
        %ar = sub SH_ARGB_N %ao
        %al = call sh_arg_len %st %ws %j %ar
        %a = slice %argb %ao ptr<Byte,%al>
        %short = cmp ult %al 2
        br %short @stop @dash
    @dash
        %p0 = slice %a 0 ptr<Byte,1>
        %c0 = load %p0 0 bv8
        %isd = cmp eq %c0 45
        br %isd @t_dd @stop
    @t_dd
        %dd = addr SH_O_DD
        %isdd = call str_eq %al %a SH_O_DD.len %dd
        %bdd = cmp ne %isdd 0
        br %bdd @after @letters
    @after
        ret %j1
    @letters
        jmp @c 1
    @c %i:bv64
        @inv ule %i %al
        @inv uge %i 1
        %mc = cmp ult %i %al
        br %mc @one @next
    @next
        jmp @l %j1
    @one
        %pc = slice %a %i ptr<Byte,1>
        %ch = load %pc 0 bv8
        %pos = call str_find %ln %letters 0 %ch
        %known = cmp ult %pos %ln
        %bit0 = call math_min %pos 63
        br %known @set @bad
    @set
        %o = load %st ShState.opts
        %bit = shl 1 %bit0
        %o2 = or %o %bit
        store %st ShState.opts %o2
        %i2 = add %i 1
        jmp @c %i2
    @bad
        %m = addr SH_M_BADOPT
        call sh_fail_a %st %ws %ec %err SH_M_BADOPT.len %m %j
        ret 0
}

# head / tail: -n N hoặc -N (mặc định 10) vào ShState.num. Trả đối số file đầu tiên, 0 nếu lỗi.
func sh_opts_n bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> %ec:bv64 %err:ptr<Byte,%ec> {
    @ens ule %r SH_MAX_ARGS
    @b0
        store %st ShState.num 10
        %argb = call sh_argb %ws
        %argc = call sh_argc %st
        jmp @l 1
    @l %j:bv64
        @inv ule %j SH_MAX_ARGS
        @dec sub SH_MAX_ARGS %j
        %more = cmp ult %j %argc
        br %more @arg @stop
    @stop
        ret %j
    @arg
        %j1 = add %j 1
        %ao = call sh_arg_off %ws %j
        %ar = sub SH_ARGB_N %ao
        %al = call sh_arg_len %st %ws %j %ar
        %a = slice %argb %ao ptr<Byte,%al>
        %short = cmp ult %al 2
        br %short @stop @dash
    @dash
        %p0 = slice %a 0 ptr<Byte,1>
        %c0 = load %p0 0 bv8
        %isd = cmp eq %c0 45
        br %isd @t_n @stop
    @t_n
        %cn = addr SH_O_N
        %isn = call str_eq %al %a SH_O_N.len %cn
        %bn = cmp ne %isn 0
        br %bn @nval @t_dd
    @nval
        %has = cmp ult %j1 %argc
        %j1c = call math_min %j1 63
        br %has @nparse @badn
    @nparse
        %vo = call sh_arg_off %ws %j1c
        %vr = sub SH_ARGB_N %vo
        %vl = call sh_arg_len %st %ws %j1c %vr
        %va = slice %argb %vo ptr<Byte,%vl>
        %v = call sh_digits %vl %va
        %vbad = cmp eq %v 0xffffffffffffffff
        br %vbad @badv @nset
    @nset
        store %st ShState.num %v
        %j2 = add %j1c 1
        jmp @l %j2
    @badv
        %mv = addr SH_M_BADNUM
        call sh_fail_a %st %ws %ec %err SH_M_BADNUM.len %mv %j1c
        ret 0
    @badn
        call sh_usage %st %ws %ec %err
        ret 0
    @t_dd
        %dd = addr SH_O_DD
        %isdd = call str_eq %al %a SH_O_DD.len %dd
        %bdd = cmp ne %isdd 0
        br %bdd @after @num
    @after
        ret %j1
    @num
        %rest = sub %al 1
        %ds = slice %a 1 ptr<Byte,%rest>
        %v2 = call sh_digits %rest %ds
        %bad2 = cmp eq %v2 0xffffffffffffffff
        br %bad2 @badopt @nset2
    @nset2
        store %st ShState.num %v2
        jmp @l %j1
    @badopt
        %mo = addr SH_M_BADOPT
        call sh_fail_a %st %ws %ec %err SH_M_BADOPT.len %mo %j
        ret 0
}

# a[0..k) == b[0..k) (không phân biệt hoa thường nếu %ic != 0)
func sh_eq_ci bv64 %an:bv64 %a:ptr<Byte,%an> %bn:bv64 %b:ptr<Byte,%bn> %k:bv64 %ic:bv64 {
    @req ule %k %an
    @req ule %k %bn
    @ens ule %r 1
    @b0
        jmp @l 0
    @l %i:bv64
        @inv ule %i %k
        %more = cmp ult %i %k
        br %more @ch @yes
    @ch
        %pa = slice %a %i ptr<Byte,1>
        %ca0 = load %pa 0 bv8
        %pb = slice %b %i ptr<Byte,1>
        %cb0 = load %pb 0 bv8
        %lc = cmp ne %ic 0
        br %lc @low @raw
    @low
        %ca = call byte_lower %ca0
        %cb = call byte_lower %cb0
        %same = cmp eq %ca %cb
        %i2 = add %i 1
        br %same @l2 @no
    @l2
        jmp @l %i2
    @raw
        %same2 = cmp eq %ca0 %cb0
        %i3 = add %i 1
        br %same2 @l3 @no
    @l3
        jmp @l %i3
    @yes
        ret 1
    @no
        ret 0
}

# Dòng (hn, h) có chứa (pn, p)? %as: phải ở đầu dòng, %ae: phải ở cuối dòng
func sh_match bv64 %hn:bv64 %h:ptr<Byte,%hn> %pn:bv64 %p:ptr<Byte,%pn> %ic:bv64 %as:bv64 %ae:bv64 {
    @ens ule %r 1
    @b0
        %long = cmp ugt %pn %hn
        br %long @no @t_both
    @t_both
        %ba = cmp ne %as 0
        %be = cmp ne %ae 0
        %both = and %ba %be
        br %both @exact @t_start
    @exact
        %same = cmp eq %pn %hn
        br %same @eqall @no
    @eqall
        %r0 = call sh_eq_ci %hn %h %pn %p %pn %ic
        ret %r0
    @t_start
        br %ba @start @t_end
    @start
        %r1 = call sh_eq_ci %hn %h %pn %p %pn %ic
        ret %r1
    @t_end
        %last = sub %hn %pn
        br %be @end @scan
    @end
        %tl = slice %h %last ptr<Byte,%pn>
        %r2 = call sh_eq_ci %pn %tl %pn %p %pn %ic
        ret %r2
    @scan
        jmp @l 0
    @l %s:bv64
        @inv ule %s %last
        %more = cmp ule %s %last
        br %more @try @no
    @try
        %rem = sub %hn %s
        %sub = slice %h %s ptr<Byte,%rem>
        %hit = call sh_eq_ci %rem %sub %pn %p %pn %ic
        %ok = cmp ne %hit 0
        br %ok @yes @adv
    @adv
        %fin = cmp eq %s %last
        br %fin @no @adv2
    @adv2
        %s2 = add %s 1
        jmp @l %s2
    @yes
        ret 1
    @no
        ret 0
}

# Vị trí ngay sau dấu xuống dòng thứ %k trong (dn, data) (hoặc dn)
func sh_after_lines bv64 %dn:bv64 %data:ptr<Byte,%dn> %k:bv64 {
    @ens ule %r %dn
    @b0
        jmp @l 0 0
    @l %i:bv64 %c:bv64
        @inv ule %i %dn
        @dec sub %dn %i
        %more = cmp ult %i %dn
        %need = cmp ult %c %k
        %go = and %more %need
        br %go @ch @end
    @ch
        %p = slice %data %i ptr<Byte,1>
        %b = load %p 0 bv8
        %nl = cmp eq %b 10
        %i2 = add %i 1
        br %nl @cnt @l2
    @cnt
        %c2 = add_sat %c 1
        jmp @l %i2 %c2
    @l2
        jmp @l %i2 %c
    @end
        ret %i
}

# Số dòng của (dn, data): số '\n', cộng 1 nếu byte cuối không phải '\n'
func sh_count_lines bv64 %dn:bv64 %data:ptr<Byte,%dn> {
    @b0
        jmp @l 0 0
    @l %i:bv64 %c:bv64
        @inv ule %i %dn
        @inv ule %c %i
        %more = cmp ult %i %dn
        br %more @ch @end
    @ch
        %p = slice %data %i ptr<Byte,1>
        %b = load %p 0 bv8
        %nl = cmp eq %b 10
        %i2 = add %i 1
        br %nl @cnt @l2
    @cnt
        %c2 = add %c 1
        jmp @l %i2 %c2
    @l2
        jmp @l %i2 %c
    @end
        %empty = cmp eq %dn 0
        br %empty @ret @last
    @last
        %li = sub %dn 1
        %pl = slice %data %li ptr<Byte,1>
        %lb = load %pl 0 bv8
        %endnl = cmp eq %lb 10
        br %endnl @ret @plus
    @plus
        %c3 = add_sat %c 1
        ret %c3
    @ret
        ret %c
}

# "==> tên <==" trước mỗi file khi head / tail nhiều file (dòng trống giữa các file)
func sh_header void %st:ptr<ShState,1> %ws:ptr<Byte,458752> %fi:bv64 {
    @req ult %fi SH_MAX_ARGS
    @b0
        %ff = load %st ShState.ffirst
        %later = cmp ugt %fi %ff
        br %later @gap @hdr
    @gap
        call sh_put_byte %st %ws 10
        jmp @hdr
    @hdr
        %h1 = addr SH_M_HDR1
        call sh_put %st %ws SH_M_HDR1.len %h1
        call sh_put_arg %st %ws %fi
        %h2 = addr SH_M_HDR2
        call sh_put %st %ws SH_M_HDR2.len %h2
        ret
}

# grep: các dòng khớp mẫu (chuỗi cố định; '^' đầu mẫu = đầu dòng, '$' cuối mẫu = cuối dòng)
func sh_grep_feed void %st:ptr<ShState,1> %ws:ptr<Byte,458752> %dn:bv64 %data:ptr<Byte,%dn> %fi:bv64 %multi:bv64 {
    @req ult %fi SH_MAX_ARGS
    @b0
        %argb = call sh_argb %ws
        %pi0 = load %st ShState.pat
        %pi = call math_min %pi0 63
        %po = call sh_arg_off %ws %pi
        %pr = sub SH_ARGB_N %po
        %pl = call sh_arg_len %st %ws %pi %pr
        %pat = slice %argb %po ptr<Byte,%pl>
        %o = load %st ShState.opts
        %inv = and %o 1
        %ic = and %o 2
        %num = and %o 4
        %cnt = and %o 8
        # '^' đầu mẫu
        %has1 = cmp ugt %pl 0
        br %has1 @c0 @noa
    @c0
        %p0 = slice %pat 0 ptr<Byte,1>
        %b0 = load %p0 0 bv8
        %caret = cmp eq %b0 94
        br %caret @sa @noa
    @sa
        jmp @a1 1
    @noa
        jmp @a1 0
    @a1 %as:bv64
        @inv ule %as 1
        @inv ule %as %pl
        %rest = sub %pl %as
        %has2 = cmp ugt %rest 0
        br %has2 @c1 @noe
    @c1
        %li = sub %pl 1
        %p1 = slice %pat %li ptr<Byte,1>
        %b1 = load %p1 0 bv8
        %dollar = cmp eq %b1 36
        br %dollar @se @noe
    @se
        jmp @a2 1
    @noe
        jmp @a2 0
    @a2 %ae:bv64
        @inv ule %ae 1
        @inv ule %ae %rest
        %cl = sub %rest %ae
        %core = slice %pat %as ptr<Byte,%cl>
        jmp @l 0 0 0
    @l %ls:bv64 %no:bv64 %hits:bv64
        @inv ule %ls %dn
        @dec sub %dn %ls
        %more = cmp ult %ls %dn
        br %more @line @end
    @line
        %le0 = call str_find %dn %data %ls 10
        %le = call math_max %le0 %ls
        %ll = sub %le %ls
        %ln = slice %data %ls ptr<Byte,%ll>
        %no2 = add_sat %no 1
        %nx0 = add_sat %le 1
        %nx = call math_min %nx0 %dn
        %m0 = call sh_match %ll %ln %cl %core %ic %as %ae
        %m = xor %m0 %inv
        %hit = cmp ne %m 0
        br %hit @hit @skip
    @skip
        jmp @l %nx %no2 %hits
    @hit
        %h2 = add_sat %hits 1
        store %st ShState.c1 1
        %co = cmp ne %cnt 0
        br %co @counted @show
    @counted
        jmp @l %nx %no2 %h2
    @show
        %mf = cmp ne %multi 0
        br %mf @name @t_num
    @name
        call sh_put_arg %st %ws %fi
        call sh_put_byte %st %ws 58
        jmp @t_num
    @t_num
        %nf = cmp ne %num 0
        br %nf @lineno @text
    @lineno
        call sh_put_dec %st %ws %no2
        call sh_put_byte %st %ws 58
        jmp @text
    @text
        call sh_put %st %ws %ll %ln
        call sh_put_byte %st %ws 10
        jmp @l %nx %no2 %h2
    @end
        %co2 = cmp ne %cnt 0
        br %co2 @total @out
    @total
        %mf2 = cmp ne %multi 0
        br %mf2 @name2 @tc
    @name2
        call sh_put_arg %st %ws %fi
        call sh_put_byte %st %ws 58
        jmp @tc
    @tc
        call sh_put_dec %st %ws %hits
        call sh_put_byte %st %ws 10
        ret
    @out
        ret
}

# Một dòng của wc: các cột được chọn (-l -w -c; không chọn = cả ba), rồi nhãn (0 không, 1 tên đối số %fi, 2 "total")
func sh_wc_row void %st:ptr<ShState,1> %ws:ptr<Byte,458752> %l:bv64 %w:bv64 %b:bv64 %label:bv64 %fi:bv64 {
    @req ult %fi SH_MAX_ARGS
    @b0
        %o0 = load %st ShState.opts
        %o1 = and %o0 7
        %none = cmp eq %o1 0
        br %none @all @some
    @all
        jmp @go 7
    @some
        jmp @go %o1
    @go %o:bv64
        %fl = and %o 1
        %hl = cmp ne %fl 0
        br %hl @pl @t_w
    @pl
        call sh_put_dec %st %ws %l
        jmp @t_w
    @t_w
        %fw = and %o 2
        %hw = cmp ne %fw 0
        br %hw @pw @t_c
    @pw
        br %hl @sw @pw2
    @sw
        call sh_put_byte %st %ws 32
        jmp @pw2
    @pw2
        call sh_put_dec %st %ws %w
        jmp @t_c
    @t_c
        %fc = and %o 4
        %hc = cmp ne %fc 0
        br %hc @pc @lab
    @pc
        %lw = or %fl %fw
        %before = cmp ne %lw 0
        br %before @sc @pc2
    @sc
        call sh_put_byte %st %ws 32
        jmp @pc2
    @pc2
        call sh_put_dec %st %ws %b
        jmp @lab
    @lab
        %is1 = cmp eq %label 1
        br %is1 @lname @t_tot
    @lname
        call sh_put_byte %st %ws 32
        call sh_put_arg %st %ws %fi
        jmp @eol
    @t_tot
        %is2 = cmp eq %label 2
        br %is2 @ltot @eol
    @ltot
        %mt = addr SH_M_TOTAL
        call sh_put %st %ws SH_M_TOTAL.len %mt
        jmp @eol
    @eol
        call sh_put_byte %st %ws 10
        ret
}

# wc: đếm dòng ('\n'), từ, byte; cộng dồn vào c1 c2 c3
func sh_wc_feed void %st:ptr<ShState,1> %ws:ptr<Byte,458752> %dn:bv64 %data:ptr<Byte,%dn> %fi:bv64 {
    @req ult %fi SH_MAX_ARGS
    @b0
        jmp @l 0 0 0 0
    @l %i:bv64 %nl:bv64 %wd:bv64 %inw:bv64
        @inv ule %i %dn
        @inv ule %nl %i
        @inv ule %wd %i
        %more = cmp ult %i %dn
        br %more @ch @end
    @ch
        %p = slice %data %i ptr<Byte,1>
        %b = load %p 0 bv8
        %i2 = add %i 1
        %isnl = cmp eq %b 10
        %sp = cmp eq %b 32
        %tb = cmp eq %b 9
        %cr = cmp eq %b 13
        %s1 = or %sp %tb
        %s2 = or %s1 %cr
        %blank = or %s2 %isnl
        br %isnl @cnl @nonl
    @cnl
        %nl2 = add %nl 1
        br %blank @gap @word
    @nonl
        %nl3 = or %nl 0
        br %blank @gap2 @word2
    @gap
        jmp @l %i2 %nl2 %wd 0
    @gap2
        jmp @l %i2 %nl3 %wd 0
    @word
        jmp @l %i2 %nl2 %wd 1
    @word2
        %was = cmp ne %inw 0
        br %was @cont @new
    @cont
        jmp @l %i2 %nl3 %wd 1
    @new
        %wd2 = add %wd 1
        jmp @l %i2 %nl3 %wd2 1
    @end
        %c1 = load %st ShState.c1
        %c1b = add_sat %c1 %nl
        store %st ShState.c1 %c1b
        %c2 = load %st ShState.c2
        %c2b = add_sat %c2 %wd
        store %st ShState.c2 %c2b
        %c3 = load %st ShState.c3
        %c3b = add_sat %c3 %dn
        store %st ShState.c3 %c3b
        %named = cmp ne %fi 0
        br %named @row1 @row0
    @row1
        call sh_wc_row %st %ws %nl %wd %dn 1 %fi
        ret
    @row0
        call sh_wc_row %st %ws %nl %wd %dn 0 0
        ret
}

# head: N dòng đầu; tail: N dòng cuối (nguyên văn)
func sh_headtail_feed void %st:ptr<ShState,1> %ws:ptr<Byte,458752> %dn:bv64 %data:ptr<Byte,%dn> %tail:bv64 {
    @b0
        %n = load %st ShState.num
        %t = cmp ne %tail 0
        br %t @tl @hd
    @hd
        %e = call sh_after_lines %dn %data %n
        %part = slice %data 0 ptr<Byte,%e>
        call sh_put %st %ws %e %part
        ret
    @tl
        %all = call sh_count_lines %dn %data
        %skip = sub_sat %all %n
        %s = call sh_after_lines %dn %data %skip
        %k = sub %dn %s
        %part2 = slice %data %s ptr<Byte,%k>
        call sh_put %st %ws %k %part2
        ret
}

# Dòng của mục chỉ mục %e (vị trí << 32 | độ dài): vị trí và độ dài kẹp trong dn
func sh_ent_off bv64 %dn:bv64 %e:bv64 {
    @ens ule %r %dn
    @b0
        %o = lshr %e 32
        %r = call math_min %o %dn
        ret %r
}

func sh_ent_len bv64 %e:bv64 %room:bv64 {
    @ens ule %r %room
    @b0
        %l = and %e 0xffffffff
        %r = call math_min %l %room
        ret %r
}

# So sánh byte (an, a) với (bn, b): 0 nhỏ hơn, 1 bằng, 2 lớn hơn
func sh_lcmp bv64 %an:bv64 %a:ptr<Byte,%an> %bn:bv64 %b:ptr<Byte,%bn> {
    @ens ule %r 2
    @b0
        %k = call math_min %an %bn
        jmp @l 0
    @l %i:bv64
        @inv ule %i %k
        %more = cmp ult %i %k
        br %more @ch @len
    @ch
        %pa = slice %a %i ptr<Byte,1>
        %ca = load %pa 0 bv8
        %pb = slice %b %i ptr<Byte,1>
        %cb = load %pb 0 bv8
        %lt = cmp ult %ca %cb
        br %lt @less @t_gt
    @t_gt
        %gt = cmp ugt %ca %cb
        %i2 = add %i 1
        br %gt @greater @next
    @next
        jmp @l %i2
    @len
        %lt2 = cmp ult %an %bn
        br %lt2 @less @t_gt2
    @t_gt2
        %gt2 = cmp ugt %an %bn
        br %gt2 @greater @equal
    @less
        ret 0
    @equal
        ret 1
    @greater
        ret 2
}

# Số nguyên đầu dòng (bỏ dấu cách đầu); không có chữ số -> 0
func sh_lnum bv64 %k:bv64 %s:ptr<Byte,%k> {
    @b0
        %a = call str_skip_spaces %k %s 0
        jmp @l %a 0
    @l %i:bv64 %v:bv64
        @inv ule %i %k
        %more = cmp ult %i %k
        br %more @ch @end
    @ch
        %p = slice %s %i ptr<Byte,1>
        %c = load %p 0 bv8
        %d = call byte_is_digit %c
        %isd = cmp ne %d 0
        br %isd @acc @end
    @acc
        %cv = call byte_u64 %c
        %dv = sub_sat %cv 48
        %v10 = mul_sat %v 10
        %v2 = add_sat %v10 %dv
        %i2 = add %i 1
        jmp @l %i2 %v2
    @end
        ret %v
}

# So sánh hai mục chỉ mục theo cờ sort (bit 1 -n): 0 / 1 / 2
func sh_ecmp bv64 %dn:bv64 %data:ptr<Byte,%dn> %ea:bv64 %eb:bv64 %numeric:bv64 {
    @ens ule %r 2
    @b0
        %ao = call sh_ent_off %dn %ea
        %ar = sub %dn %ao
        %al = call sh_ent_len %ea %ar
        %a = slice %data %ao ptr<Byte,%al>
        %bo = call sh_ent_off %dn %eb
        %br = sub %dn %bo
        %bl = call sh_ent_len %eb %br
        %b = slice %data %bo ptr<Byte,%bl>
        %nm = cmp ne %numeric 0
        br %nm @num @lex
    @num
        %va = call sh_lnum %al %a
        %vb = call sh_lnum %bl %b
        %lt = cmp ult %va %vb
        br %lt @less @t_gt
    @t_gt
        %gt = cmp ugt %va %vb
        br %gt @greater @lex
    @less
        ret 0
    @greater
        ret 2
    @lex
        %r = call sh_lcmp %al %a %bl %b
        ret %r
}

# ea "đứng sau" eb trong thứ tự sort (cờ: bit 0 -r, bit 1 -n)?
func sh_after bv64 %dn:bv64 %data:ptr<Byte,%dn> %ea:bv64 %eb:bv64 %fl:bv64 {
    @ens ule %r 1
    @b0
        %num = and %fl 2
        %c = call sh_ecmp %dn %data %ea %eb %num
        %rev = and %fl 1
        %r0 = cmp ne %rev 0
        br %r0 @rv @fw
    @fw
        %g = cmp eq %c 2
        br %g @y @n
    @rv
        %l = cmp eq %c 0
        br %l @y @n
    @y
        ret 1
    @n
        ret 0
}

func sh_idx ptr<DiskQword,6144> %ws:ptr<Byte,458752> {
    @b0
        %a = slice %ws SH_W_IDX ptr<Byte,49152>
        %q = view %a ptr<DiskQword,6144>
        ret %q
}

# Vun đống tại %i trong idx[0, cnt)
func sh_sift void %idx:ptr<DiskQword,6144> %cnt:bv64 %i0:bv64 %dn:bv64 %data:ptr<Byte,%dn> %fl:bv64 {
    @req ule %cnt 6144
    @req ult %i0 %cnt
    @b0
        jmp @l %i0
    @l %i:bv64
        @inv ult %i %cnt
        @dec sub %cnt %i
        %l0 = shl %i 1
        %lc = add %l0 1
        %has = cmp ult %lc %cnt
        br %has @kids @done
    @kids
        %rc = add %lc 1
        %pl = slice %idx %lc ptr<DiskQword,1>
        %el = load %pl 0 bv64
        %hasr = cmp ult %rc %cnt
        br %hasr @cmpr @pickl
    @cmpr
        %pr = slice %idx %rc ptr<DiskQword,1>
        %er = load %pr 0 bv64
        %rbig = call sh_after %dn %data %er %el %fl
        %rb = cmp ne %rbig 0
        br %rb @pickr @pickl
    @pickr
        jmp @big %rc
    @pickl
        jmp @big %lc
    @big %b:bv64
        @inv ult %b %cnt
        @inv ugt %b %i
        %pb = slice %idx %b ptr<DiskQword,1>
        %eb = load %pb 0 bv64
        %pi = slice %idx %i ptr<DiskQword,1>
        %ei = load %pi 0 bv64
        %up = call sh_after %dn %data %eb %ei %fl
        %u = cmp ne %up 0
        br %u @swap @done
    @swap
        store %pi 0 %eb
        store %pb 0 %ei
        jmp @l %b
    @done
        ret
}

# sort [-r] [-n] [-u]: dòng của (dn, data) theo thứ tự byte (hoặc số đầu dòng); tối đa 6144 dòng
func sh_sort_feed void %st:ptr<ShState,1> %ws:ptr<Byte,458752> %dn:bv64 %data:ptr<Byte,%dn> %ec:bv64 %err:ptr<Byte,%ec> {
    @b0
        %idx = call sh_idx %ws
        %fl = load %st ShState.opts
        jmp @l 0 0
    @l %ls:bv64 %cnt:bv64
        @inv ule %ls %dn
        @inv ule %cnt 6144
        @dec sub %dn %ls
        %more = cmp ult %ls %dn
        br %more @line @sort
    @line
        %full = cmp uge %cnt 6144
        br %full @many @add
    @many
        call sh_err_arg %st %ws %ec %err 0
        %mm = addr SH_M_MANYLINES
        call sh_err %st %ec %err SH_M_MANYLINES.len %mm
        store %st ShState.v0 1
        ret
    @add
        %le0 = call str_find %dn %data %ls 10
        %le = call math_max %le0 %ls
        %ll = sub %le %ls
        %hi = shl %ls 32
        %e = or %hi %ll
        %pe = slice %idx %cnt ptr<DiskQword,1>
        store %pe 0 %e
        %cnt1 = add %cnt 1
        %nx0 = add_sat %le 1
        %nx = call math_min %nx0 %dn
        jmp @l %nx %cnt1
    @sort
        %half = lshr %cnt 1
        jmp @h 0
    @h %t:bv64
        @inv ule %t %half
        %hm = cmp ult %t %half
        br %hm @heap @pop
    @heap
        %t1 = add %t 1
        %hi0 = sub %half %t1
        %hic = call math_min %hi0 %cnt
        %ok = cmp ult %hic %cnt
        br %ok @sift @hn
    @sift
        call sh_sift %idx %cnt %hic %dn %data %fl
        jmp @hn
    @hn
        jmp @h %t1
    @pop
        %z = cmp eq %cnt 0
        br %z @emit @pop1
    @pop1
        jmp @p 1
    @p %k:bv64
        @inv ule %k %cnt
        @inv uge %k 1
        %pm = cmp ult %k %cnt
        br %pm @swap @emit
    @swap
        %end = sub %cnt %k
        %p0 = slice %idx 0 ptr<DiskQword,1>
        %e0 = load %p0 0 bv64
        %pn = slice %idx %end ptr<DiskQword,1>
        %en = load %pn 0 bv64
        store %p0 0 %en
        store %pn 0 %e0
        %k1 = add %k 1
        %pos = cmp ugt %end 0
        br %pos @s2 @pn2
    @s2
        call sh_sift %idx %end 0 %dn %data %fl
        jmp @pn2
    @pn2
        jmp @p %k1
    @emit
        %uq = and %fl 4
        jmp @o 0 0
    @o %j:bv64 %prev:bv64
        @inv ule %j %cnt
        %om = cmp ult %j %cnt
        br %om @out1 @done
    @out1
        %pj = slice %idx %j ptr<DiskQword,1>
        %ej = load %pj 0 bv64
        %j1 = add %j 1
        %u = cmp ne %uq 0
        %notfirst = cmp ne %j 0
        %chk = and %u %notfirst
        br %chk @dup @put
    @dup
        %c = call sh_ecmp %dn %data %ej %prev 0
        %same = cmp eq %c 1
        br %same @skip @put
    @skip
        jmp @o %j1 %prev
    @put
        %jo = call sh_ent_off %dn %ej
        %jr = sub %dn %jo
        %jl = call sh_ent_len %ej %jr
        %ln = slice %data %jo ptr<Byte,%jl>
        call sh_put %st %ws %jl %ln
        call sh_put_byte %st %ws 10
        jmp @o %j1 %ej
    @done
        ret
}

func sh_uniq_out void %st:ptr<ShState,1> %ws:ptr<Byte,458752> %k:bv64 %line:ptr<Byte,%k> %n:bv64 %cnt:bv64 {
    @b0
        %c = cmp ne %cnt 0
        br %c @num @text
    @num
        call sh_put_pad %st %ws %n 7
        call sh_put_byte %st %ws 32
        jmp @text
    @text
        call sh_put %st %ws %k %line
        call sh_put_byte %st %ws 10
        ret
}

# uniq [-c]: gộp các dòng liền nhau giống nhau
func sh_uniq_feed void %st:ptr<ShState,1> %ws:ptr<Byte,458752> %dn:bv64 %data:ptr<Byte,%dn> {
    @b0
        %o = load %st ShState.opts
        %cnt = and %o 1
        jmp @l 0 0 0 0
    @l %ls:bv64 %ps:bv64 %pl:bv64 %n:bv64
        @inv ule %ls %dn
        @inv ule %ps %dn
        @dec sub %dn %ls
        %more = cmp ult %ls %dn
        br %more @line @end
    @line
        %le0 = call str_find %dn %data %ls 10
        %le = call math_max %le0 %ls
        %ll = sub %le %ls
        %ln = slice %data %ls ptr<Byte,%ll>
        %nx0 = add_sat %le 1
        %nx = call math_min %nx0 %dn
        %have = cmp ne %n 0
        br %have @cmp @first
    @first
        %lsc = or %ls 0
        jmp @l %nx %lsc %ll 1
    @cmp
        %proom = sub %dn %ps
        %plc = call math_min %pl %proom
        %prev = slice %data %ps ptr<Byte,%plc>
        %c = call sh_lcmp %plc %prev %ll %ln
        %same = cmp eq %c 1
        br %same @dup @emit
    @dup
        %n2 = add_sat %n 1
        %psc = or %ps 0
        %plk = or %pl 0
        jmp @l %nx %psc %plk %n2
    @emit
        call sh_uniq_out %st %ws %plc %prev %n %cnt
        %lsd = or %ls 0
        jmp @l %nx %lsd %ll 1
    @end
        %have2 = cmp ne %n 0
        br %have2 @last @out
    @last
        %proom2 = sub %dn %ps
        %plc2 = call math_min %pl %proom2
        %prev2 = slice %data %ps ptr<Byte,%plc2>
        call sh_uniq_out %st %ws %plc2 %prev2 %n %cnt
        ret
    @out
        ret
}


# Đưa một đầu vào (file %fi, hoặc stdin khi %fi = 0) cho lệnh văn bản %k
func sh_feed void %st:ptr<ShState,1> %ws:ptr<Byte,458752> %k:bv64 %dn:bv64 %data:ptr<Byte,%dn> %fi:bv64 %ec:bv64 %err:ptr<Byte,%ec> {
    @req ult %fi SH_MAX_ARGS
    @b0
        %argc = call sh_argc %st
        %ff = load %st ShState.ffirst
        %nf = sub_sat %argc %ff
        %multi = cmp ugt %nf 1
        %named = cmp ne %fi 0
        %hdr = and %multi %named
        %is_cat = cmp eq %k SH_K_CAT
        br %is_cat @cat @t_grep
    @cat
        call sh_put %st %ws %dn %data
        ret
    @t_grep
        %is_g = cmp eq %k SH_K_GREP
        br %is_g @grep @t_wc
    @grep
        br %multi @gm @g1
    @gm
        call sh_grep_feed %st %ws %dn %data %fi 1
        ret
    @g1
        call sh_grep_feed %st %ws %dn %data %fi 0
        ret
    @t_wc
        %is_w = cmp eq %k SH_K_WC
        br %is_w @wc @t_ht
    @wc
        call sh_wc_feed %st %ws %dn %data %fi
        ret
    @t_ht
        %is_h = cmp eq %k SH_K_HEAD
        %is_t = cmp eq %k SH_K_TAIL
        %ht = or %is_h %is_t
        br %ht @ht @t_sort
    @ht
        br %hdr @header @htbody
    @header
        call sh_header %st %ws %fi
        jmp @htbody
    @htbody
        br %is_t @tail @head
    @tail
        call sh_headtail_feed %st %ws %dn %data 1
        ret
    @head
        call sh_headtail_feed %st %ws %dn %data 0
        ret
    @t_sort
        %is_s = cmp eq %k SH_K_SORT
        br %is_s @sort @t_uniq
    @sort
        call sh_sort_feed %st %ws %dn %data %ec %err
        ret
    @t_uniq
        %is_u = cmp eq %k SH_K_UNIQ
        br %is_u @uniq @out
    @uniq
        call sh_uniq_feed %st %ws %dn %data
        ret
    @out
        ret
}

# Lệnh văn bản cat grep wc head tail sort uniq: tùy chọn, rồi từng file đối số (hoặc stdin nếu không có file)
func sh_c_text bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> %tab:ptr<DiskQword,4096> %fc:bv64 %fb:ptr<Byte,%fc> %k:bv64 %ec:bv64 %err:ptr<Byte,%ec> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @ens ule %r SH_NEED
    @b0
        %argc = call sh_argc %st
        %sub = load %st ShState.sub
        %got = cmp eq %sub 1
        br %got @result @start
    @start
        store %st ShState.v0 0
        store %st ShState.c1 0
        store %st ShState.c2 0
        store %st ShState.c3 0
        %is_g = cmp eq %k SH_K_GREP
        br %is_g @og @t_w
    @og
        %lg = addr SH_L_GREP
        %fg = call sh_opts %st %ws SH_L_GREP.len %lg %ec %err
        %bad = cmp eq %fg 0
        br %bad @usage2 @gpat
    @gpat
        %nopat = cmp uge %fg %argc
        br %nopat @usage @gp
    @gp
        store %st ShState.pat %fg
        %fg1 = add %fg 1
        jmp @first %fg1
    @t_w
        %is_w = cmp eq %k SH_K_WC
        br %is_w @ow @t_ht
    @ow
        %lw = addr SH_L_WC
        %fw = call sh_opts %st %ws SH_L_WC.len %lw %ec %err
        jmp @chk %fw
    @t_ht
        %is_h = cmp eq %k SH_K_HEAD
        %is_t = cmp eq %k SH_K_TAIL
        %ht = or %is_h %is_t
        br %ht @oht @t_s
    @oht
        %fh = call sh_opts_n %st %ws %ec %err
        jmp @chk %fh
    @t_s
        %is_s = cmp eq %k SH_K_SORT
        br %is_s @os @t_u
    @os
        %ls = addr SH_L_SORT
        %fs = call sh_opts %st %ws SH_L_SORT.len %ls %ec %err
        jmp @chk %fs
    @t_u
        %is_u = cmp eq %k SH_K_UNIQ
        br %is_u @ou @cat
    @ou
        %lu = addr SH_L_UNIQ
        %fu = call sh_opts %st %ws SH_L_UNIQ.len %lu %ec %err
        jmp @chk %fu
    @cat
        jmp @first 1
    @chk %f0:bv64
        @inv ule %f0 SH_MAX_ARGS
        %bad2 = cmp eq %f0 0
        br %bad2 @usage2 @first0
    @first0
        jmp @first %f0
    @usage
        call sh_usage %st %ws %ec %err
        ret 2
    @usage2
        ret 2
    @first %f:bv64
        @inv ule %f SH_MAX_ARGS
        store %st ShState.ffirst %f
        %nf = sub_sat %argc %f
        %su0 = cmp eq %k SH_K_SORT
        %su1 = cmp eq %k SH_K_UNIQ
        %su = or %su0 %su1
        %many = cmp ugt %nf 1
        %one = and %su %many
        br %one @onefile @t_stdin
    @onefile
        call sh_err_arg %st %ws %ec %err 0
        %mo = addr SH_M_ONEFILE
        call sh_err %st %ec %err SH_M_ONEFILE.len %mo
        ret 2
    @t_stdin
        %none = cmp eq %nf 0
        br %none @stdin @files
    @stdin
        %bi = call sh_bin %st %ws
        %il = call sh_inlen %st
        %in = slice %bi 0 ptr<Byte,%il>
        call sh_feed %st %ws %k %il %in 0 %ec %err
        jmp @finish
    @files
        jmp @file %f
    @result
        store %st ShState.sub 0
        %fi0 = load %st ShState.fi
        %fi = call math_min %fi0 63
        %fi1 = add %fi 1
        %res = call sh_res %st
        %rbad = call sh_is_err %res
        %isbad = cmp ne %rbad 0
        br %isbad @rfail @rfeed
    @rfail
        call sh_fail_c %st %ws %ec %err %res %fi
        store %st ShState.v0 1
        jmp @file %fi1
    @rfeed
        %sz = call math_min %res %fc
        %data = slice %fb 0 ptr<Byte,%sz>
        call sh_feed %st %ws %k %sz %data %fi %ec %err
        jmp @file %fi1
    @file %g:bv64
        @inv ule %g SH_MAX_ARGS
        @dec sub SH_MAX_ARGS %g
        %more = cmp ult %g %argc
        br %more @one1 @finish
    @one1
        %g1 = add %g 1
        %dash = addr SH_O_DASH
        %isdash = call sh_arg_is %st %ws %g 1 %dash
        %bdash = cmp ne %isdash 0
        br %bdash @dstdin @lookf
    @dstdin
        # '-' = stdin
        %bi2 = call sh_bin %st %ws
        %il2 = call sh_inlen %st
        %in2 = slice %bi2 0 ptr<Byte,%il2>
        call sh_feed %st %ws %k %il2 %in2 %g %ec %err
        jmp @file %g1
    @lookf
        %id = call sh_resolve_arg %st %ws %tab %g
        %miss = cmp eq %id SH_NONE
        br %miss @noent @isdir
    @noent
        %m = addr SH_M_NOENT
        call sh_fail_a %st %ws %ec %err SH_M_NOENT.len %m %g
        store %st ShState.v0 1
        jmp @file %g1
    @isdir
        %d = call sh_isdir %tab %id
        %dd = cmp ne %d 0
        br %dd @dir @size
    @dir
        %md = addr SH_M_ISDIR
        call sh_fail_a %st %ws %ec %err SH_M_ISDIR.len %md %g
        store %st ShState.v0 1
        jmp @file %g1
    @size
        %sz0 = call lfs_tget %tab %id 2
        %big = cmp ugt %sz0 %fc
        br %big @toobig @read
    @toobig
        call sh_fail_c %st %ws %ec %err SH_E_TOOBIG %g
        store %st ShState.v0 1
        jmp @file %g1
    @read
        store %st ShState.fi %g
        store %st ShState.sub 1
        call sh_req %st SH_OP_READ %id 0
        ret SH_NEED
    @finish
        %v0 = load %st ShState.v0
        %err1 = cmp ne %v0 0
        %is_g2 = cmp eq %k SH_K_GREP
        br %is_g2 @gfin @t_wfin
    @gfin
        # grep: 0 có dòng khớp, 1 không có, 2 lỗi
        br %err1 @r2 @gm
    @gm
        %hit = load %st ShState.c1
        %h = cmp ne %hit 0
        br %h @r0 @r1
    @t_wfin
        %is_w2 = cmp eq %k SH_K_WC
        %nf2 = load %st ShState.ffirst
        %nfc = sub_sat %argc %nf2
        %tot = cmp ugt %nfc 1
        %wt = and %is_w2 %tot
        br %wt @wtotal @plain
    @wtotal
        %c1 = load %st ShState.c1
        %c2 = load %st ShState.c2
        %c3 = load %st ShState.c3
        call sh_wc_row %st %ws %c1 %c2 %c3 2 0
        jmp @plain
    @plain
        br %err1 @r1 @r0
    @r0
        ret 0
    @r1
        ret 1
    @r2
        ret 2
}

# Tên (k, t) khớp mẫu (pn, p) có * và ? ?
func sh_glob bv64 %tn:bv64 %t:ptr<Byte,%tn> %pn:bv64 %p:ptr<Byte,%pn> {
    @ens ule %r 1
    @b0
        jmp @l 0 0 0 0 0
    @l %k:bv64 %i:bv64 %j:bv64 %star:bv64 %mark:bv64
        @inv ule %k 100000
        @inv ule %i %tn
        @inv ule %j %pn
        @inv ule %mark %tn
        @dec sub 100000 %k
        %more = cmp ult %k 100000
        br %more @step @no
    @step
        %k1 = add %k 1
        %tm = cmp ult %i %tn
        br %tm @ch @tail
    @ch
        %pt = slice %t %i ptr<Byte,1>
        %ct = load %pt 0 bv8
        %pm = cmp ult %j %pn
        br %pm @pc @back
    @pc
        %pp = slice %p %j ptr<Byte,1>
        %cp = load %pp 0 bv8
        %q = cmp eq %cp 63
        %same = cmp eq %cp %ct
        %one = or %q %same
        br %one @adv @t_star
    @adv
        %i1 = add %i 1
        %j1 = add %j 1
        jmp @l %k1 %i1 %j1 %star %mark
    @t_star
        %isstar = cmp eq %cp 42
        br %isstar @setstar @back
    @setstar
        %j2 = add %j 1
        %ic = or %i 0
        jmp @l %k1 %i %j2 %j2 %ic
    @back
        %has = cmp ne %star 0
        br %has @retry @no
    @retry
        %m1 = add %mark 1
        %mc = call math_min %m1 %tn
        %sc = call math_min %star %pn
        jmp @l %k1 %mc %sc %star %mc
    @tail
        %pm2 = cmp ult %j %pn
        br %pm2 @tc @end
    @tc
        %pp2 = slice %p %j ptr<Byte,1>
        %cp2 = load %pp2 0 bv8
        %st2 = cmp eq %cp2 42
        %j3 = add %j 1
        br %st2 @skipstar @no
    @skipstar
        jmp @l %k1 %i %j3 %star %mark
    @end
        ret 1
    @no
        ret 0
}

# find [PATH] [-name MẪU] [-type f|d]: đường dẫn (tuyệt đối) của PATH và mọi mục bên dưới
func sh_c_find bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> %tab:ptr<DiskQword,4096> %ec:bv64 %err:ptr<Byte,%ec> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @ens ule %r 2
    @b0
        %argc = call sh_argc %st
        %argb = call sh_argb %ws
        jmp @a 1 0 0 0
    @a %j:bv64 %path:bv64 %nm:bv64 %ty:bv64
        @inv ule %j SH_MAX_ARGS
        @dec sub SH_MAX_ARGS %j
        %more = cmp ult %j %argc
        br %more @arg @start
    @arg
        %j1 = add %j 1
        %j1c = call math_min %j1 63
        %has1 = cmp ult %j1 %argc
        %cn = addr SH_O_NAME
        %isn = call sh_arg_is %st %ws %j SH_O_NAME.len %cn
        %bn = cmp ne %isn 0
        br %bn @oname @t_type
    @oname
        br %has1 @setn @usage
    @setn
        %j2 = add %j1c 1
        jmp @a %j2 %path %j1c %ty
    @t_type
        %ct = addr SH_O_TYPE
        %ist = call sh_arg_is %st %ws %j SH_O_TYPE.len %ct
        %bt = cmp ne %ist 0
        br %bt @otype @t_path
    @otype
        br %has1 @sett @usage
    @sett
        %j3 = add %j1c 1
        jmp @a %j3 %path %nm %j1c
    @t_path
        %nop = cmp eq %path 0
        %first = cmp eq %j 1
        %canp = and %nop %first
        br %canp @setp @bad
    @setp
        %jc = or %j 0
        jmp @a %j1 %jc %nm %ty
    @bad
        %mb = addr SH_M_BADOPT
        call sh_fail_a %st %ws %ec %err SH_M_BADOPT.len %mb %j
        ret 2
    @usage
        call sh_usage %st %ws %ec %err
        ret 2
    @start
        %pc = call math_min %path 63
        %hp = cmp ne %path 0
        br %hp @look @cwd
    @cwd
        %c = call sh_cwd %st
        jmp @root %c
    @look
        %id = call sh_resolve_arg %st %ws %tab %pc
        %miss = cmp eq %id SH_NONE
        br %miss @noent @found
    @noent
        %mn = addr SH_M_NOENT
        call sh_fail_a %st %ws %ec %err SH_M_NOENT.len %mn %pc
        ret 1
    @found
        %idc = call math_min %id 255
        jmp @root %idc
    @root %s:bv64
        @inv ult %s 256
        %ds = call sh_depth %tab %s
        # mẫu -name và loại -type
        %nmc = call math_min %nm 63
        %no = call sh_arg_off %ws %nmc
        %nr = sub SH_ARGB_N %no
        %nl = call sh_arg_len %st %ws %nmc %nr
        %pat = slice %argb %no ptr<Byte,%nl>
        %tyc = call math_min %ty 63
        %tf = addr SH_M_FILE
        %isf0 = call sh_arg_is %st %ws %tyc 1 %tf
        %isf = and %isf0 1
        %hasty = cmp ne %ty 0
        %hasnm = cmp ne %nm 0
        jmp @l 0
    @l %id2:bv64
        @inv ule %id2 256
        %m2 = cmp ult %id2 256
        br %m2 @ent @done
    @ent
        %nx = add %id2 1
        %self = cmp eq %id2 %s
        br %self @chk_type @t_used
    @t_used
        %f = call lfs_tget %tab %id2 0
        %used = and %f 1
        %u = cmp ne %used 0
        %nr0 = cmp ne %id2 0
        %u2 = and %u %nr0
        br %u2 @t_under @skip
    @t_under
        %d = call sh_depth %tab %id2
        %deeper = cmp ugt %d %ds
        br %deeper @anc @skip
    @anc
        %up = sub %d %ds
        %a = call sh_ancestor %tab %id2 %up
        %under = cmp eq %a %s
        br %under @chk_type @skip
    @chk_type
        br %hasty @ty1 @chk_name
    @ty1
        %isd = call sh_isdir %tab %id2
        %wantf = cmp ne %isf 0
        %dirb = cmp ne %isd 0
        %isfile = cmp eq %isd 0
        %okf = and %wantf %isfile
        %wantd = cmp eq %isf 0
        %okd = and %wantd %dirb
        %okt = or %okf %okd
        br %okt @chk_name @skip
    @chk_name
        br %hasnm @nm1 @show
    @nm1
        %ln = call sh_name_load %tab %id2
        %nb = addr SH_NAME
        %name = slice %nb 0 ptr<Byte,%ln>
        %g = call sh_glob %ln %name %nl %pat
        %gm = cmp ne %g 0
        br %gm @show @skip
    @show
        %o = call sh_bout %st %ws
        call sh_out_path %st SH_BUF_N %o %tab %id2
        call sh_put_byte %st %ws 10
        jmp @l %nx
    @skip
        jmp @l %nx
    @done
        ret 0
}

# ---------------------------------------------------------------- các pha

# Thông báo cho lỗi tách từ ShState.lexerr
func sh_lex_msg void %st:ptr<ShState,1> %ec:bv64 %err:ptr<Byte,%ec> {
    @b0
        %e = load %st ShState.lexerr
        %syn = and %e 4
        %b2 = cmp ne %syn 0
        br %b2 @syntax @t_long
    @syntax
        %m1 = addr SH_M_SYNTAX
        call sh_err %st %ec %err SH_M_SYNTAX.len %m1
        ret
    @t_long
        %lng = and %e 1
        %b0 = cmp ne %lng 0
        br %b0 @long @many
    @long
        %m2 = addr SH_M_LONG
        call sh_err %st %ec %err SH_M_LONG.len %m2
        ret
    @many
        %m3 = addr SH_M_MANY
        call sh_err %st %ec %err SH_M_MANY.len %m3
        ret
}

# Tách thử cả dòng (không chạy) để báo lỗi cú pháp trước khi lệnh nào chạy. Trả 1 nếu có lỗi.
func sh_check_line bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> %n:bv64 %s:ptr<Byte,%n> {
    @ens ule %r 1
    @b0
        jmp @l 0 SH_T_END
    @l %p:bv64 %prev:bv64
        @inv ule %p %n
        @dec sub %n %p
        store %st ShState.pos %p
        %np = call sh_lex %st %ws %n %s
        %e = load %st ShState.lexerr
        %bad = cmp ne %e 0
        br %bad @fail @chk
    @chk
        %t = load %st ShState.term
        %argc = load %st ShState.argc
        %rm = load %st ShState.rmode
        %ia = load %st ShState.iarg
        %w0 = or %argc %rm
        %w1 = or %w0 %ia
        %empty = cmp eq %w1 0
        %end = cmp eq %t SH_T_END
        br %empty @e1 @next
    @e1
        br %end @e2 @syntax
    @e2
        # lệnh rỗng cuối dòng chỉ hợp lệ sau ';' hoặc khi cả dòng rỗng
        %pa = cmp eq %prev SH_T_AND
        %po = cmp eq %prev SH_T_OR
        %pp = cmp eq %prev SH_T_PIPE
        %x = or %pa %po
        %y = or %x %pp
        br %y @syntax @ok
    @next
        br %end @ok @adv
    @adv
        %more = cmp ult %p %n
        br %more @go @ok
    @go
        %p1 = add %p 1
        %np1 = call math_max %np %p1
        %np2 = call math_min %np1 %n
        jmp @l %np2 %t
    @syntax
        call sh_lexflag %st 4
        ret 1
    @fail
        ret 1
    @ok
        ret 0
}

# Tách lệnh kế tiếp; bỏ qua (&& / ||) thì sang NEXT ngay
func sh_ph_parse void %st:ptr<ShState,1> %ws:ptr<Byte,458752> %n:bv64 %s:ptr<Byte,%n> %ec:bv64 %err:ptr<Byte,%ec> {
    @b0
        store %st ShState.sub 0
        store %st ShState.fi 0
        store %st ShState.v0 0
        store %st ShState.opts 0
        %ck = load %st ShState.checked
        %done = cmp ne %ck 0
        br %done @lex @check
    @check
        store %st ShState.checked 1
        %bad = call sh_check_line %st %ws %n %s
        store %st ShState.pos 0
        store %st ShState.term SH_T_END
        %isbad = cmp ne %bad 0
        br %isbad @fail @lex
    @lex
        %np = call sh_lex %st %ws %n %s
        store %st ShState.pos %np
        %e = load %st ShState.lexerr
        %le = cmp ne %e 0
        br %le @fail @ok
    @fail
        call sh_lex_msg %st %ec %err
        store %st ShState.status 2
        store %st ShState.term SH_T_END
        store %st ShState.phase SH_PH_END
        ret
    @ok
        store %st ShState.piped 0
        %sk = load %st ShState.skip
        %skip = cmp ne %sk 0
        # lệnh rỗng (vd sau ';' cuối dòng): không chạy, không đổi $?
        %ac = load %st ShState.argc
        %rm = load %st ShState.rmode
        %ia0 = load %st ShState.iarg
        %w0 = or %ac %rm
        %w1 = or %w0 %ia0
        %empty = cmp eq %w1 0
        %pass = or %skip %empty
        br %pass @next @run
    @next
        store %st ShState.phase SH_PH_NEXT
        ret
    @run
        store %st ShState.cmd SH_K_UNRESOLVED
        %ia = load %st ShState.iarg
        %hasin = cmp ne %ia 0
        br %hasin @in @torun
    @in
        store %st ShState.phase SH_PH_IN
        ret
    @torun
        store %st ShState.phase SH_PH_RUN
        ret
}

# '<' FILE: đọc FILE làm stdin của lệnh. Trả 1 nếu chờ thao tác LightFS.
func sh_ph_in bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> %tab:ptr<DiskQword,4096> %fc:bv64 %fb:ptr<Byte,%fc> %ec:bv64 %err:ptr<Byte,%ec> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @ens ule %r 1
    @b0
        %sub = load %st ShState.sub
        %got = cmp eq %sub 1
        br %got @result @look
    @look
        %id = call sh_resolve_arg %st %ws %tab SH_A_IN
        %miss = cmp eq %id SH_NONE
        br %miss @noent @chk
    @noent
        %m = addr SH_M_NOENT
        call sh_fail_a %st %ws %ec %err SH_M_NOENT.len %m SH_A_IN
        jmp @fail
    @chk
        %d = call sh_isdir %tab %id
        %isd = cmp ne %d 0
        br %isd @dir @size
    @dir
        %md = addr SH_M_ISDIR
        call sh_fail_a %st %ws %ec %err SH_M_ISDIR.len %md SH_A_IN
        jmp @fail
    @size
        %sz = call lfs_tget %tab %id 2
        %b1 = cmp ugt %sz %fc
        %b2 = cmp ugt %sz SH_BUF_N
        %big = or %b1 %b2
        br %big @toobig @read
    @toobig
        call sh_fail_c %st %ws %ec %err SH_E_TOOBIG SH_A_IN
        jmp @fail
    @read
        store %st ShState.sub 1
        call sh_req %st SH_OP_READ %id 0
        ret 1
    @result
        store %st ShState.sub 0
        %res = call sh_res %st
        %e = call sh_is_err %res
        %bad = cmp ne %e 0
        br %bad @rfail @copy
    @rfail
        call sh_fail_c %st %ws %ec %err %res SH_A_IN
        jmp @fail
    @copy
        %l0 = call math_min %res %fc
        %l = call math_min %l0 SH_BUF_N
        %src = slice %fb 0 ptr<Byte,%l>
        %bi = call sh_bin %st %ws
        call mem_copy_b SH_BUF_N %bi %l %src %l
        store %st ShState.in_len %l
        store %st ShState.phase SH_PH_RUN
        ret 0
    @fail
        store %st ShState.status 1
        store %st ShState.phase SH_PH_NEXT
        ret 0
}

# Chạy (tiếp) lệnh hiện tại. Trả 1 nếu chờ thao tác LightFS.
func sh_ph_run bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> %n:bv64 %s:ptr<Byte,%n> %tab:ptr<DiskQword,4096> %fc:bv64 %fb:ptr<Byte,%fc> %ec:bv64 %err:ptr<Byte,%ec> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @ens ule %r 1
    @b0
        %k0 = load %st ShState.cmd
        %fresh = cmp eq %k0 SH_K_UNRESOLVED
        br %fresh @resolve @t_empty
    @resolve
        # lần đầu vào lệnh: gán biến TÊN=giá_trị đứng đầu, rồi tìm lệnh
        call sh_assign %st %ws %ec %err
        %kr = call sh_lookup %st %ws
        store %st ShState.cmd %kr
        jmp @t_empty
    @t_empty
        %argc = call sh_argc %st
        %empty = cmp eq %argc 0
        br %empty @zero @go
    @zero
        jmp @fin 0
    @go
        # argv[0] và argv[1] cho các lệnh cũ (ls / cd / stat)
        %argb = call sh_argb %ws
        %o0 = call sh_arg_off %ws 0
        %r0 = sub SH_ARGB_N %o0
        %l0 = call sh_arg_len %st %ws 0 %r0
        %cmd = slice %argb %o0 ptr<Byte,%l0>
        %o1 = call sh_arg_off %ws 1
        %r1 = sub SH_ARGB_N %o1
        %l1 = call sh_arg_len %st %ws 1 %r1
        %a1 = slice %argb %o1 ptr<Byte,%l1>
        %out = call sh_bout %st %ws
        %k = load %st ShState.cmd
        %is1 = cmp eq %k SH_K_HELP
        br %is1 @help @t2
    @help
        %mh = addr SH_M_HELP
        call sh_put %st %ws SH_M_HELP.len %mh
        jmp @fin 0
    @t2
        %is2 = cmp eq %k SH_K_ECHO
        br %is2 @echo @t3
    @echo
        %rec = call sh_c_echo %st %ws
        jmp @fin %rec
    @t3
        %is3 = cmp eq %k SH_K_PWD
        br %is3 @pwd @t4
    @pwd
        %cwd = call sh_cwd %st
        call sh_out_path %st SH_BUF_N %out %tab %cwd
        call sh_put_byte %st %ws 10
        jmp @fin 0
    @t4
        %is4 = cmp eq %k SH_K_LS
        br %is4 @ls @t5
    @ls
        %rls = call sh_cmd_ls %st %tab %l1 %a1 %l0 %cmd SH_BUF_N %out %ec %err
        jmp @fin %rls
    @t5
        %is5 = cmp eq %k SH_K_CD
        br %is5 @cd @t6
    @cd
        %rcd = call sh_cmd_cd %st %tab %l1 %a1 %l0 %cmd %ec %err
        jmp @fin %rcd
    @t6
        %is6 = cmp eq %k SH_K_STAT
        br %is6 @stat @t7
    @stat
        %rst = call sh_cmd_stat %st %tab %l1 %a1 %l0 %cmd SH_BUF_N %out %ec %err
        jmp @fin %rst
    @t7
        %is7 = cmp eq %k SH_K_CAT
        br %is7 @cat @t8
    @cat
        %rca = call sh_c_text %st %ws %tab %fc %fb %k %ec %err
        jmp @fin %rca
    @t8
        %w1 = cmp eq %k SH_K_WRITE
        %w2 = cmp eq %k SH_K_APPEND
        %is8 = or %w1 %w2
        br %is8 @write @t10
    @write
        %rw = call sh_c_write %st %ws %k %ec %err
        jmp @fin %rw
    @t10
        %f1 = cmp eq %k SH_K_MKDIR
        %f2 = cmp eq %k SH_K_TOUCH
        %f3 = cmp eq %k SH_K_RM
        %f12 = or %f1 %f2
        %is10 = or %f12 %f3
        br %is10 @fs @t13
    @fs
        %rfs = call sh_c_fs %st %ws %tab %k %ec %err
        jmp @fin %rfs
    @t13
        %is13 = cmp eq %k SH_K_ENV
        br %is13 @env @t14
    @env
        %ren = call sh_c_env %st %ws
        jmp @fin %ren
    @t14
        %is14 = cmp eq %k SH_K_UNSET
        br %is14 @unset @t15
    @unset
        %run = call sh_c_unset %st %ws
        jmp @fin %run
    @t15
        %is15 = cmp eq %k SH_K_TRUE
        br %is15 @true @t16
    @true
        jmp @fin 0
    @t16
        %is16 = cmp eq %k SH_K_FALSE
        br %is16 @false @t17
    @false
        jmp @fin 1
    @t17
        %tx0 = cmp uge %k SH_K_GREP
        %tx1 = cmp ule %k SH_K_UNIQ
        %istx = and %tx0 %tx1
        br %istx @text @t23
    @text
        %rtx = call sh_c_text %st %ws %tab %fc %fb %k %ec %err
        jmp @fin %rtx
    @t23
        %is23 = cmp eq %k SH_K_FIND
        br %is23 @find @unknown
    @find
        %rfd = call sh_c_find %st %ws %tab %ec %err
        jmp @fin %rfd
    @unknown
        call sh_err_arg %st %ws %ec %err 0
        %mu = addr SH_M_NOTFOUND
        call sh_err %st %ec %err SH_M_NOTFOUND.len %mu
        jmp @fin 127
    @fin %rc:bv64
        @inv ule %rc SH_NEED
        %wait = cmp eq %rc SH_NEED
        br %wait @need @done
    @need
        ret 1
    @done
        %r8 = and %rc 0xff
        store %st ShState.status %r8
        store %st ShState.phase SH_PH_ROUTE
        store %st ShState.sub 0
        ret 0
}

# Chuyển hướng thất bại: thông báo đã ghi, lệnh coi như lỗi
func sh_route_fail void %st:ptr<ShState,1> {
    @b0
        store %st ShState.status 1
        store %st ShState.phase SH_PH_NEXT
        ret
}

# OUT của lệnh vừa chạy -> file (chuyển hướng), lệnh sau ('|') hoặc stdout. Trả 1 nếu chờ thao tác LightFS.
func sh_ph_route bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> %tab:ptr<DiskQword,4096> %fc:bv64 %fb:ptr<Byte,%fc> %oc:bv64 %out:ptr<Byte,%oc> %ec:bv64 %err:ptr<Byte,%ec> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @ens ule %r 1
    @b0
        %bo = call sh_bout %st %ws
        %ol = call sh_outlen %st
        %rm = load %st ShState.rmode
        %r0 = load %st ShState.rarg
        %ri = call math_min %r0 63
        %redir = cmp ne %rm 0
        br %redir @file @plain
    @plain
        %tm = load %st ShState.term
        %pipe = cmp eq %tm SH_T_PIPE
        br %pipe @topipe @tostdout
    @topipe
        %tp = load %st ShState.trunc
        %ovp = and %tp 4
        %cutp = cmp ne %ovp 0
        br %cutp @pmsg @pswap
    @pmsg
        %mp = addr SH_M_PIPEFULL
        call sh_err %st %ec %err SH_M_PIPEFULL.len %mp
        jmp @pswap
    @pswap
        %sel = load %st ShState.in_sel
        %sel1 = xor %sel 1
        %sel2 = and %sel1 1
        store %st ShState.in_sel %sel2
        store %st ShState.in_len %ol
        store %st ShState.piped 1
        %t = load %st ShState.trunc
        %ov = and %t 4
        %ov2 = shl %ov 1
        %t2 = or %t %ov2
        store %st ShState.trunc %t2
        store %st ShState.phase SH_PH_NEXT
        ret 0
    @tostdout
        %data = slice %bo 0 ptr<Byte,%ol>
        call sh_so_put %st %oc %out %ol %data
        %t3 = load %st ShState.trunc
        %ov3 = and %t3 12
        %cut = cmp ne %ov3 0
        br %cut @mark @pdone
    @mark
        %t4 = or %t3 1
        store %st ShState.trunc %t4
        jmp @pdone
    @pdone
        store %st ShState.phase SH_PH_NEXT
        ret 0
    @file
        %sub = load %st ShState.sub
        %s1 = cmp eq %sub 1
        br %s1 @created @t_s2
    @t_s2
        %s2 = cmp eq %sub 2
        br %s2 @readold @t_s3
    @t_s3
        %s3 = cmp eq %sub 3
        br %s3 @written @start
    @start
        # dữ liệu đã bị cắt (OUT tràn ở lệnh này hoặc ở lệnh trước trong ống): không ghi
        %tf = load %st ShState.trunc
        %ovf = and %tf 12
        %lost = cmp ne %ovf 0
        br %lost @toobig @look
    @toobig
        call sh_fail_c %st %ws %ec %err SH_E_TOOBIG %ri
        call sh_route_fail %st
        ret 0
    @look
        %id = call sh_resolve_arg %st %ws %tab %ri
        %miss = cmp eq %id SH_NONE
        br %miss @absent @present
    @present
        %d = call sh_isdir %tab %id
        %isd = cmp ne %d 0
        br %isd @isdir @old
    @isdir
        %md = addr SH_M_ISDIR
        call sh_fail_a %st %ws %ec %err SH_M_ISDIR.len %md %ri
        call sh_route_fail %st
        ret 0
    @old
        store %st ShState.tid %id
        %app = cmp eq %rm 2
        br %app @rdold @trunc
    @trunc
        jmp @fill 0
    @rdold
        %sz = call lfs_tget %tab %id 2
        %big = cmp ugt %sz %fc
        br %big @toobig @rq
    @rq
        store %st ShState.sub 2
        call sh_req %st SH_OP_READ %id 0
        ret 1
    @absent
        %par = call sh_parent_arg %st %ws %tab %ri
        %nopar = cmp eq %par SH_NONE
        br %nopar @noent @name
    @noent
        %mn = addr SH_M_NOENT
        call sh_fail_a %st %ws %ec %err SH_M_NOENT.len %mn %ri
        call sh_route_fail %st
        ret 0
    @name
        %okn = call sh_name_arg %st %ws %ri
        %good = cmp ne %okn 0
        br %good @create @badname
    @badname
        %mb = addr SH_M_BADNAME
        call sh_fail_a %st %ws %ec %err SH_M_BADNAME.len %mb %ri
        call sh_route_fail %st
        ret 0
    @create
        store %st ShState.sub 1
        call sh_req %st SH_OP_CREATE %par 0
        ret 1
    @created
        %rc = call sh_res %st
        %ec1 = call sh_is_err %rc
        %bc = cmp ne %ec1 0
        br %bc @opfail @newid
    @newid
        store %st ShState.tid %rc
        jmp @fill 0
    @readold
        %rr = call sh_res %st
        %er = call sh_is_err %rr
        %br = cmp ne %er 0
        br %br @opfailr @have
    @opfailr
        call sh_fail_c %st %ws %ec %err %rr %ri
        call sh_route_fail %st
        ret 0
    @have
        %fits0 = cmp ule %rr %fc
        br %fits0 @fillold @toobig
    @fillold
        jmp @fill %rr
    @fill %base:bv64
        @inv ule %base %fc
        %room = sub %fc %base
        %fits = cmp ule %ol %room
        br %fits @copy @toobig
    @copy
        %dst = slice %fb %base ptr<Byte,%room>
        call mem_copy_b %room %dst SH_BUF_N %bo %ol
        %len = add %base %ol
        %tid = load %st ShState.tid
        store %st ShState.sub 3
        call sh_req %st SH_OP_WRITE %tid %len
        ret 1
    @written
        %rw = call sh_res %st
        %ew = call sh_is_err %rw
        %bw = cmp ne %ew 0
        br %bw @opfailw @wok
    @opfailw
        call sh_fail_c %st %ws %ec %err %rw %ri
        call sh_route_fail %st
        ret 0
    @wok
        store %st ShState.phase SH_PH_NEXT
        ret 0
    @opfail
        call sh_fail_c %st %ws %ec %err %rc %ri
        call sh_route_fail %st
        ret 0
}

# Xong một lệnh: dọn OUT, xét dấu kết thúc (; && || |), sửa cwd nếu thư mục hiện tại vừa bị xóa
func sh_ph_next void %st:ptr<ShState,1> %tab:ptr<DiskQword,4096> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @b0
        store %st ShState.out_len 0
        store %st ShState.rmode 0
        store %st ShState.sub 0
        %t = load %st ShState.trunc
        %t1 = and %t 0xb
        store %st ShState.trunc %t1
        %cwd = call sh_cwd %st
        %f = call lfs_tget %tab %cwd 0
        %used = and %f 1
        %gone0 = cmp eq %used 0
        %notroot = cmp ne %cwd 0
        %gone = and %gone0 %notroot
        br %gone @reset @term
    @reset
        store %st ShState.cwd 0
        jmp @term
    @term
        %tm = load %st ShState.term
        %pipe = cmp eq %tm SH_T_PIPE
        br %pipe @t_piped @endpipe
    @t_piped
        # lệnh trước '|' không đưa gì sang (ghi vào file, lỗi, bị bỏ qua): stdin của lệnh sau rỗng
        %pd = load %st ShState.piped
        %didp = cmp ne %pd 0
        br %didp @parse @nopipe
    @nopipe
        store %st ShState.in_len 0
        jmp @parse
    @endpipe
        # hết một ống: stdin của lệnh sau rỗng
        store %st ShState.in_len 0
        %t2 = load %st ShState.trunc
        %t3 = and %t2 3
        store %st ShState.trunc %t3
        %end = cmp eq %tm SH_T_END
        br %end @fin @t_and
    @fin
        store %st ShState.phase SH_PH_END
        ret
    @t_and
        %rc = load %st ShState.status
        %ok = cmp eq %rc 0
        %is_and = cmp eq %tm SH_T_AND
        br %is_and @and @t_or
    @and
        br %ok @run @skip
    @t_or
        %is_or = cmp eq %tm SH_T_OR
        br %is_or @or @run
    @or
        br %ok @skip @run
    @run
        store %st ShState.skip 0
        jmp @parse
    @skip
        store %st ShState.skip 1
        jmp @parse
    @parse
        store %st ShState.phase SH_PH_PARSE
        ret
}

# Chạy tiếp dòng lệnh đã sh_begin. Trả 0 xong, 1 chờ thao tác LightFS (ShState.op), 2 gọi tiếp.
func sh_step bv64 %st:ptr<ShState,1> %ws:ptr<Byte,458752> %n:bv64 %s:ptr<Byte,%n> %tab:ptr<DiskQword,4096> %fc:bv64 %fb:ptr<Byte,%fc> %oc:bv64 %out:ptr<Byte,%oc> %ec:bv64 %err:ptr<Byte,%ec> {
    @req uge %tab 0x10000
    @req ult %tab 0x10000000000
    @ens ule %r 2
    @b0
        %op = load %st ShState.op
        %pend = cmp ne %op 0
        br %pend @need @go
    @go
        jmp @l 0
    @l %k:bv64
        @inv ule %k 64
        @dec sub 64 %k
        %more = cmp ult %k 64
        br %more @one @yield
    @one
        %k1 = add %k 1
        %ph = load %st ShState.phase
        %p1 = cmp eq %ph SH_PH_PARSE
        br %p1 @parse @t_run
    @parse
        call sh_ph_parse %st %ws %n %s %ec %err
        jmp @l %k1
    @t_run
        %p2 = cmp eq %ph SH_PH_IN
        br %p2 @in @t_run3
    @in
        %ri = call sh_ph_in %st %ws %tab %fc %fb %ec %err
        %wi = cmp ne %ri 0
        br %wi @need @again
    @t_run3
        %p3 = cmp eq %ph SH_PH_RUN
        br %p3 @run @t_route
    @run
        %rr = call sh_ph_run %st %ws %n %s %tab %fc %fb %ec %err
        %wr = cmp ne %rr 0
        br %wr @need @again
    @again
        jmp @l %k1
    @t_route
        %p4 = cmp eq %ph SH_PH_ROUTE
        br %p4 @route @t_next
    @route
        %ro = call sh_ph_route %st %ws %tab %fc %fb %oc %out %ec %err
        %wo = cmp ne %ro 0
        br %wo @need @again
    @t_next
        %p5 = cmp eq %ph SH_PH_NEXT
        br %p5 @next @end
    @next
        call sh_ph_next %st %tab
        jmp @l %k1
    @end
        %rc = load %st ShState.status
        %rc8 = and %rc 0xff
        store %st ShState.exit %rc8
        store %st ShState.phase 0
        %t = load %st ShState.trunc
        %t3 = and %t 3
        store %st ShState.trunc %t3
        ret 0
    @need
        ret 1
    @yield
        ret 2
}
