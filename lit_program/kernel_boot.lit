# File: lit_program/kernel_boot.lit
# Hàm chính của Kernel khi vừa boot lên 64-bit Ring 0

func kernel_main void {
    @b0
        # 1. Xuất ký tự 'O' (ASCII 0x4F = 79) ra cổng Serial COM1 (0x3F8)
        %0 = const 0x4f bv8
        assert ult %0 128
        hwio_w 0x3f8 %0

        # 2. Xuất ký tự 'K' (ASCII 0x4B = 75) ra cổng Serial COM1 (0x3F8)
        %1 = const 0x4b bv8
        assert ult %1 128
        hwio_w 0x3f8 %1

        # 3. Xuất ký tự xuống dòng '\n' (ASCII 0x0A = 10)
        %2 = const 0x0a bv8
        hwio_w 0x3f8 %2

        # 4. Trả về (Sẽ nhảy về lệnh cli; hlt của bộ nạp để nghỉ)
        ret
}
