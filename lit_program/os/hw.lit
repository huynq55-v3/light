# File: lit_program/os/hw.lit
# Bảng phần cứng của Kernel + cửa sổ ánh xạ MMIO + framebuffer thật.
#
# Bộ nhớ vật lý cố định (RAM thấp, dưới vùng EBDA 0x9f000 — khả dụng trên cả QEMU lẫn máy thật):
#   0x80000..0x8ffff  bộ đệm bounce 64KB cho DMA NVMe          0x95000  danh sách PRP (15 trang của bounce)
#   0x90000 Admin SQ, 0x91000 Admin CQ, 0x92000 I/O SQ, 0x93000 I/O CQ, 0x94000 Identify / sector tạm
#   0x96000  bảng HW (ptr<DiskQword,512>, chỉ số qword ở dưới)
#   0x97000  PD_FB   : 512 trang 2MB, ảo 0x80_0000_0000 (512GB) -> framebuffer (PAT WC)
#   0x98000  PDPT_HI : PML4[1] (ảo 512GB..1TB). [0] -> PD_FB, [1] -> PD_MMIO
#   0x99000  PD_MMIO : ảo 0x80_4000_0000 + k*2MB -> MMIO thiết bị (UC). k=0,1: BAR NVMe; k=16..31: CFGBAR của VMD
# Light không cho ép số nguyên thành ptr, nên MMIO có địa chỉ chỉ biết lúc chạy (BAR, framebuffer) được ánh xạ
# vào một địa chỉ ảo CỐ ĐỊNH rồi truy cập qua `const ... ptr` + `slice` có kiểm tra biên.
#
# Chỉ số bảng HW:
#   0 fb_ok  1 fb_pitch_px  2 fb_w  3 fb_h  4 fb_origin (chỉ số ô VgaCell của pixel (0,0) logic)  5 fb_len (giới hạn chỉ số)
#   6 vis_w  7 vis_h  8 fb_phys
#   16 blk_backend (0 không có, 1 ATA, 2 NVMe)  17 part_base  18 part_len  19 nsze  20 nvme_stage (chẩn đoán)
#   21 io_sq_tail  22 io_cq_head  23 io_phase  24 adm_sq_tail  25 adm_cq_head  26 adm_phase  27 cid  28 last_status
#   29 qua VMD?  30 nvme_bar_phys  31 nvme_bar_idx (đơn vị Mmio32)  32 gpt (0 không có GPT, 1 thấy lightos, 2 GPT không có lightos)

include ../lib/std_lib.lit
include ../drivers/pci.lit
include ../drivers/vga_drv.lit

layout Mmio32 4 {
    0: bv32
}

func page_zero void %0:ptr<DiskQword,512> {
    @b0
        %1 = const 0 bv64
        jmp @b1 %1

    @b1 %2:bv64
        @inv ule %2 512
        %3 = const 512 bv64
        %4 = cmp ult %2 %3
        br %4 @b2 @b3

    @b2
        %5 = slice %0 %2 ptr<DiskQword,1>
        store %5 0 %1
        %6 = const 1 bv64
        %7 = add %2 %6
        jmp @b1 %7

    @b3
        ret
}

func hw_get bv64 %0:io<0,0xffff> %1:bv64 {
    @req ult %1 512

    @b0
        %2 = const 0x96000 ptr<DiskQword,512>
        %3 = call q512 %2 %1
        ret %3
}

func hw_set void %0:io<0,0xffff> %1:bv64 %2:bv64 {
    @req ult %1 512

    @b0
        %3 = const 0x96000 ptr<DiskQword,512>
        call q512_set %3 %1 %2
        ret
}

# Nạp lại CR3 = xả TLB sau khi đổi bảng trang
func mmu_flush void %0:io<0,0xffff> {
    @b0
        %1 = const 0x10000 bv64
        hwio_w %0 3 %1
        ret
}

# Xóa bảng HW và dựng PML4[1] -> PDPT_HI -> {PD_FB, PD_MMIO} (tất cả trang 2MB đều chưa có = not present)
func mmio_map_init void %0:io<0,0xffff> {
    @b0
        %1 = const 0x96000 ptr<DiskQword,512>
        %2 = const 0x97000 ptr<DiskQword,512>
        %3 = const 0x98000 ptr<DiskQword,512>
        %4 = const 0x99000 ptr<DiskQword,512>
        call page_zero %1
        call page_zero %2
        call page_zero %3
        call page_zero %4
        %5 = const 0 bv64
        %6 = const 1 bv64
        %7 = const 0x97003 bv64
        %8 = const 0x99003 bv64
        call q512_set %3 %5 %7
        call q512_set %3 %6 %8
        %9 = const 0x10000 ptr<DiskQword,512>
        %10 = const 0x98003 bv64
        call q512_set %9 %6 %10
        call mmu_flush %0
        ret
}

# PD_MMIO[k] = trang 2MB chứa phys, thuộc tính UC (P|RW|PWT|PCD|PS). Người gọi tự mmu_flush.
func mmio_map_2m void %0:io<0,0xffff> %1:bv64 %2:bv64 {
    @req ult %1 512

    @b0
        %3 = const 0xffffffffffe00000 bv64
        %4 = and %2 %3
        %5 = const 0x9b bv64
        %6 = or %4 %5
        %7 = const 0x99000 ptr<DiskQword,512>
        call q512_set %7 %1 %6
        ret
}

# Tìm framebuffer: Multiboot Info bit 12 (GRUB EFI = GOP thật) -> nếu không có thì Bochs VGA của QEMU (PCI 1234:1111,
# chế độ 1920x1080 bật qua cổng VBE). Ánh xạ vào ảo 0x80_0000_0000 bằng trang 2MB Write-Combining.
func fb_init void %0:io<0,0xffff> {
    @b0
        %1 = const 0x7d000 ptr<DiskQword,512>
        %2 = const 0 bv64
        %3 = call q512 %1 %2
        %4 = const 0x1000 bv64
        %5 = and %3 %4
        %6 = cmp ne %5 %2
        br %6 @b1 @b10

    @b1
        %7 = const 11 bv64
        %8 = call q512 %1 %7                # framebuffer_addr (offset 88)
        %9 = const 12 bv64
        %10 = call q512 %1 %9               # pitch | width << 32
        %11 = const 13 bv64
        %12 = call q512 %1 %11              # height | bpp << 32 | type << 40
        %13 = const 0xffffffff bv64
        %14 = and %10 %13
        %15 = const 32 bv64
        %16 = lshr %10 %15
        %17 = and %12 %13
        %18 = lshr %12 %15
        %19 = const 0xff bv64
        %20 = and %18 %19                   # bpp
        %21 = const 8 bv64
        %22 = lshr %18 %21
        %23 = and %22 %19                   # type (1 = RGB trực tiếp)
        %24 = const 2 bv64
        %25 = lshr %14 %24                  # pitch tính theo pixel
        %26 = cmp eq %20 %15
        %27 = const 1 bv64
        %28 = cmp eq %23 %27
        %29 = and %26 %28
        br %29 @b2 @b20

    @b2
        jmp @b3 %8 %25 %16 %17

    @b10
        %30 = const 0 bv64
        %31 = const 2 bv64
        %32 = call pci_cfg_rd %0 %30 %31 %30 %30
        %33 = const 0x11111234 bv64
        %34 = cmp eq %32 %33
        br %34 @b11 @b20

    @b11
        %35 = const 0x10 bv64
        %36 = call pci_cfg_rd %0 %30 %31 %30 %35
        %37 = const 0xfffffff0 bv64
        %38 = and %36 %37
        call drv_vga_init %0
        %39 = const 1920 bv64
        %40 = const 1080 bv64
        jmp @b3 %38 %39 %39 %40

    @b3 %41:bv64 %42:bv64 %43:bv64 %44:bv64
        # %41 phys, %42 pitch_px, %43 width, %44 height
        %45 = const 1 bv64
        %46 = const 16384 bv64
        %47 = const 0x400000000000 bv64
        %48 = cmp uge %43 %45
        %49 = cmp uge %44 %45
        %50 = cmp ule %43 %42
        %51 = cmp ule %42 %46
        %52 = cmp ule %44 %46
        %53 = cmp ult %41 %47
        %54 = and %48 %49
        %55 = and %54 %50
        %56 = and %55 %51
        %57 = and %56 %52
        %58 = and %57 %53
        br %58 @b4 @b20

    @b4
        %59 = mul %42 %44                   # số ô của framebuffer (pitch_px * h)
        %60 = const 0x1000000 bv64
        %61 = cmp ule %59 %60
        br %61 @b5 @b20

    @b5
        %62 = const 0x1fffff bv64
        %63 = and %41 %62                   # offset trong trang 2MB đầu
        %64 = sub %41 %63                   # gốc 2MB
        %65 = const 2 bv64
        %66 = lshr %63 %65
        %67 = add %66 %59                   # giới hạn chỉ số ô (tính từ ảo 512GB)
        %68 = shl %59 %65
        %69 = add %63 %68
        %70 = add %69 %62
        %71 = const 21 bv64
        %72 = lshr %70 %71                  # số trang 2MB cần ánh xạ (<= 34)
        %73 = const 1920 bv64
        %74 = const 1080 bv64
        %75 = call std_min %43 %73          # vis_w
        %76 = call std_min %44 %74          # vis_h
        %77 = sub %43 %75
        %78 = const 1 bv64
        %79 = lshr %77 %78                  # ox (căn giữa)
        %80 = sub %44 %76
        %81 = lshr %80 %78                  # oy
        %82 = mul %81 %42
        %83 = add %66 %82
        %84 = add %83 %79                   # origin
        %85 = const 0x97000 ptr<DiskQword,512>
        %86 = const 0 bv64
        jmp @b6 %86

    @b6 %87:bv64
        @inv ule %87 64
        %88 = cmp ult %87 %72
        br %88 @b7 @b8

    @b7
        %89 = shl %87 %71
        %90 = add %64 %89
        %91 = const 0x8b bv64               # P|RW|PWT|PS -> PAT1 = WC
        %92 = or %90 %91
        call q512_set %85 %87 %92
        %93 = add %87 %78
        jmp @b6 %93

    @b8
        call mmu_flush %0
        %94 = const 1 bv64
        %95 = const 2 bv64
        %96 = const 3 bv64
        %97 = const 4 bv64
        %98 = const 5 bv64
        %99 = const 6 bv64
        %100 = const 7 bv64
        %101 = const 8 bv64
        call hw_set %0 %94 %42
        call hw_set %0 %95 %43
        call hw_set %0 %96 %44
        call hw_set %0 %97 %84
        call hw_set %0 %98 %67
        call hw_set %0 %99 %75
        call hw_set %0 %100 %76
        call hw_set %0 %101 %41
        %102 = const 0 bv64
        call hw_set %0 %102 %94             # fb_ok = 1
        ret

    @b20
        %103 = const 0 bv64
        call hw_set %0 %103 %103
        ret
}

# Chép hình chữ nhật [x1,x2) x [y1,y2) của VRAM logic 1920x1080 (%1, nằm trong RAM) ra framebuffer thật
# (pitch bất kỳ, căn giữa; vùng ngoài màn hình thật bị cắt). Mọi chỉ số đều kiểm tra lúc chạy với fb_len.
func fb_present_rect void %0:io<0,0xffff> %1:ptr<VgaCell,2073600> %2:bv64 %3:bv64 %4:bv64 %5:bv64 {
    @req ule %2 1920
    @req ule %3 1080
    @req ule %4 1920
    @req ule %5 1080

    @b0
        %6 = const 0x96000 ptr<DiskQword,512>
        %7 = const 0 bv64
        %8 = call q512 %6 %7
        %9 = cmp ne %8 %7
        br %9 @b1 @b9

    @b1
        %10 = const 1 bv64
        %11 = const 4 bv64
        %12 = const 5 bv64
        %13 = const 6 bv64
        %14 = const 7 bv64
        %15 = call q512 %6 %10
        %16 = call q512 %6 %11
        %17 = call q512 %6 %12
        %18 = call q512 %6 %13
        %19 = call q512 %6 %14
        %20 = const 16384 bv64
        %21 = const 0x1000000 bv64
        %22 = const 25165824 bv64
        %23 = const 1920 bv64
        %24 = const 1080 bv64
        %25 = call std_min %15 %20          # pitch_px
        %26 = call std_min %16 %21          # origin
        %27 = call std_min %17 %22          # len
        %28 = call std_min %18 %23
        %29 = call std_min %19 %24
        %30 = call std_min %4 %28           # x_end
        %31 = call std_min %5 %29           # y_end
        %32 = const 0x8000000000 ptr<VgaCell,25165824>
        %33 = mul %3 %25
        %34 = add %33 %26
        jmp @b2 %3 %34

    @b2 %35:bv64 %36:bv64
        @inv ule %36 0x4000000
        %37 = cmp ult %35 %31
        br %37 @b3 @b9

    @b3
        %38 = add %36 %30
        %39 = cmp ule %38 %27
        br %39 @b4 @b9

    @b4
        %40 = mul %35 %23
        jmp @b5 %2

    @b5 %41:bv64
        %42 = cmp ult %41 %30
        br %42 @b6 @b7

    @b6
        %43 = add %40 %41
        %44 = slice %1 %43 ptr<VgaCell,1>
        %45 = load %44 0 bv32
        %46 = add %36 %41
        %47 = slice %32 %46 ptr<VgaCell,1>
        store %47 0 %45
        %48 = add %41 %10
        jmp @b5 %48

    @b7
        %49 = add %35 %10
        %50 = add %36 %25
        jmp @b2 %49 %50

    @b9
        ret
}
