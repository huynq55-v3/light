func gfx_draw_cursor void %0:ptr<VgaCell,921600> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ult %1 1260
    @req ult %2 700

    @b0
        %3 = const 0x22d3ee bv32
        %4 = const 0x0f172a bv32

        %5 = const 1 bv64
        %6 = add %1 %5
        %7 = add %2 %5
        call gfx_put_pixel %0 %1 %2 %3
        call gfx_put_pixel %0 %6 %2 %3
        call gfx_put_pixel %0 %1 %7 %3

        %8 = const 2 bv64
        %9 = add %1 %8
        %10 = add %2 %8
        call gfx_put_pixel %0 %9 %2 %3
        call gfx_put_pixel %0 %6 %7 %3
        call gfx_put_pixel %0 %1 %10 %3

        %11 = const 3 bv64
        %12 = const 4 bv64
        %13 = add %1 %11
        %14 = add %2 %11
        %15 = add %1 %12
        %16 = add %2 %12
        call gfx_put_pixel %0 %13 %2 %3
        call gfx_put_pixel %0 %9 %7 %3
        call gfx_put_pixel %0 %6 %10 %3
        call gfx_put_pixel %0 %1 %14 %3

        call gfx_put_pixel %0 %15 %2 %3
        call gfx_put_pixel %0 %13 %7 %3
        call gfx_put_pixel %0 %9 %10 %3
        call gfx_put_pixel %0 %6 %14 %3
        call gfx_put_pixel %0 %1 %16 %3

        %17 = const 5 bv64
        %18 = const 6 bv64
        %19 = add %1 %17
        %20 = add %2 %17
        %21 = add %1 %18
        %22 = add %2 %18
        call gfx_put_pixel %0 %19 %2 %3
        call gfx_put_pixel %0 %15 %7 %3
        call gfx_put_pixel %0 %13 %10 %3
        call gfx_put_pixel %0 %9 %14 %3
        call gfx_put_pixel %0 %6 %16 %3
        call gfx_put_pixel %0 %1 %20 %3

        call gfx_put_pixel %0 %21 %2 %3
        call gfx_put_pixel %0 %19 %7 %3
        call gfx_put_pixel %0 %15 %10 %3
        call gfx_put_pixel %0 %13 %14 %3
        call gfx_put_pixel %0 %9 %16 %3
        call gfx_put_pixel %0 %6 %20 %3
        call gfx_put_pixel %0 %1 %22 %3

        %23 = const 7 bv64
        %24 = const 8 bv64
        %25 = add %1 %23
        %26 = add %2 %23
        %27 = add %1 %24
        %28 = add %2 %24
        call gfx_put_pixel %0 %25 %2 %3
        call gfx_put_pixel %0 %21 %7 %3
        call gfx_put_pixel %0 %19 %10 %3
        call gfx_put_pixel %0 %15 %14 %3
        call gfx_put_pixel %0 %13 %16 %3
        call gfx_put_pixel %0 %9 %20 %3
        call gfx_put_pixel %0 %6 %22 %3
        call gfx_put_pixel %0 %1 %26 %3

        call gfx_put_pixel %0 %27 %2 %3
        call gfx_put_pixel %0 %25 %7 %3
        call gfx_put_pixel %0 %21 %10 %3
        call gfx_put_pixel %0 %19 %14 %3
        call gfx_put_pixel %0 %15 %16 %3
        call gfx_put_pixel %0 %13 %20 %3
        call gfx_put_pixel %0 %9 %22 %3
        call gfx_put_pixel %0 %6 %26 %3
        call gfx_put_pixel %0 %1 %28 %3

        %29 = const 9 bv64
        %30 = const 10 bv64
        %31 = add %1 %29
        %32 = add %2 %29
        %33 = add %1 %30
        %34 = add %2 %30
        call gfx_put_pixel %0 %25 %10 %4
        call gfx_put_pixel %0 %21 %14 %4
        call gfx_put_pixel %0 %19 %16 %4
        call gfx_put_pixel %0 %15 %20 %4
        call gfx_put_pixel %0 %13 %22 %4
        call gfx_put_pixel %0 %9 %26 %4
        call gfx_put_pixel %0 %6 %28 %4
        call gfx_put_pixel %0 %1 %32 %3

        %35 = const 11 bv64
        %36 = const 12 bv64
        %37 = add %1 %35
        %38 = add %2 %35
        %39 = add %1 %36
        %40 = add %2 %36
        call gfx_put_pixel %0 %19 %20 %4
        call gfx_put_pixel %0 %15 %22 %4
        call gfx_put_pixel %0 %13 %26 %4
        call gfx_put_pixel %0 %9 %28 %4
        call gfx_put_pixel %0 %6 %32 %3
        call gfx_put_pixel %0 %1 %38 %3

        %41 = const 13 bv64
        %42 = const 14 bv64
        %43 = add %1 %41
        %44 = add %2 %41
        %45 = add %1 %42
        %46 = add %2 %42
        call gfx_put_pixel %0 %13 %28 %4
        call gfx_put_pixel %0 %9 %32 %4
