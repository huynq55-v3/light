        call gfx_put_pixel %0 %1 %44 %3

        %47 = const 15 bv64
        %48 = const 16 bv64
        %49 = add %1 %47
        %50 = add %2 %47
        %51 = add %1 %48
        %52 = add %2 %48
        call gfx_put_pixel %0 %9 %38 %4
