}

# Cấp phát ĐỘNG 1 Lô 64GB mới trong Page Table cho App thứ %3 (Có bao nhiêu App thì tạo bấy nhiêu Lô!)
func vmm_alloc_app_arena void %0:io<0,0xffff> %1:ptr<DiskQword,512> %2:ptr<DiskQword,4096> %3:bv64 {
    # %0: Root IO (để flush CR3), %1: Bảng PDPT (0x11000), %2: Bể bảng trang PD_Pool (0x20000), %3: app_idx
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req ult %3 7

    @b0
        # 1. Tính địa chỉ vật lý của bảng PD riêng cho App thứ %3: pd_phys = 0x20000 + app_idx * 4096
        %4 = const 12 bv64
        %5 = shl %3 %4
        %6 = const 0x20003 bv64             # 0x20000 | Present | RW (0x03)
        %7 = add %6 %5

        # 2. Ghi vào ô PDPT[(app_idx + 1) * 64] -> Mở khóa Lô 64GB tại địa chỉ ảo (app_idx + 1) * 64GB!
        %8 = const 1 bv64
        %9 = add %3 %8
        %10 = const 6 bv64
        %11 = shl %9 %10                    # pdpt_idx = (app_idx + 1) * 64
        %12 = slice %1 %11 ptr<DiskQword,1>
        store %12 0 %7

        # 3. Cấp phát 2 trang 2MB HugePage (Code + Heap) từ RAM vật lý (16MB + app_idx * 8MB) vào PD_Pool
        %13 = const 9 bv64
        %14 = shl %3 %13                    # pd_pool_qword_idx = app_idx * 512
        %15 = const 2 bv64
        %16 = add %3 %15
        %17 = const 23 bv64
        %18 = shl %16 %17                   # phys_base = (app_idx + 2) * 8MB
        %19 = const 0x83 bv64               # Present | RW | 2MB HugePage
        %20 = or %18 %19

        # Ghi trang Code (0..2MB của Lô 64GB)
        %21 = slice %2 %14 ptr<DiskQword,1>
        store %21 0 %20

        # Ghi trang Heap/Data (2..4MB của Lô 64GB)
        %22 = add %14 %8
        %23 = const 0x200000 bv64
        %24 = add %20 %23
        %25 = slice %2 %22 ptr<DiskQword,1>
        store %25 0 %24

        # 4. Làm mới thanh ghi CR3 (0x10000) để CPU kích hoạt ngay Lô 64GB vừa tạo!
        %26 = const 0x10000 bv64
        hwio_w %0 3 %26
        ret
}

# =============================================================================
# CÁC HÀM ĐIỀU PHỐI TỔNG QUÁT THEO SLOT (0..6) ĐẾN TỪNG LÔ 64GB
# =============================================================================
func app_dispatch_entry void %0:io<0,0xffff> %1:ptr<VgaCell,921600> %2:ptr<IpcChannel,1> %3:ptr<DiskQword,64> %4:ptr<DiskQword,64> %5:ptr<DiskQword,64> %6:bv64 {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req uge %3 0x10000
    @req ult %3 0x80000000
    @req uge %4 0x10000
    @req ult %4 0x80000000
    @req uge %5 0x10000
    @req ult %5 0x80000000
    @req ult %6 7

    @b0
        %7 = const 0 bv64
        %8 = cmp eq %6 %7
        br %8 @b1 @b2

    @b1
        %20 = const 0x1000000000 ptr<DiskQword,1>
        %30 = const 0x1000200000 ptr<DiskQword,64>
        call %20 %1 %2 %30 %3 %4 %5
        ret

    @b2
        %9 = const 1 bv64
        %10 = cmp eq %6 %9
        br %10 @b3 @b4

    @b3
        %21 = const 0x2000000000 ptr<DiskQword,1>
        %31 = const 0x2000200000 ptr<DiskQword,64>
        call %21 %1 %2 %31 %3 %4 %5
        ret

    @b4
        %11 = const 2 bv64
        %12 = cmp eq %6 %11
        br %12 @b5 @b6

    @b5
        %22 = const 0x3000000000 ptr<DiskQword,1>
        %32 = const 0x3000200000 ptr<DiskQword,64>
        call %22 %1 %2 %32 %3 %4 %5
        ret

    @b6
        %13 = const 3 bv64
        %14 = cmp eq %6 %13
        br %14 @b7 @b8

    @b7
        %23 = const 0x4000000000 ptr<DiskQword,1>
        %33 = const 0x4000200000 ptr<DiskQword,64>
        call %23 %1 %2 %33 %3 %4 %5
        ret

    @b8
        %15 = const 4 bv64
        %16 = cmp eq %6 %15
        br %16 @b9 @b10

    @b9
        %24 = const 0x5000000000 ptr<DiskQword,1>
        %34 = const 0x5000200000 ptr<DiskQword,64>
        call %24 %1 %2 %34 %3 %4 %5
        ret

    @b10
        %17 = const 5 bv64
        %18 = cmp eq %6 %17
        br %18 @b11 @b12

    @b11
        %25 = const 0x6000000000 ptr<DiskQword,1>
        %35 = const 0x6000200000 ptr<DiskQword,64>
        call %25 %1 %2 %35 %3 %4 %5
        ret

    @b12
        %26 = const 0x7000000000 ptr<DiskQword,1>
        %36 = const 0x7000200000 ptr<DiskQword,64>
        call %26 %1 %2 %36 %3 %4 %5
        ret
}

func app_dispatch_draw_icon void %0:io<0,0xffff> %1:ptr<VgaCell,921600> %2:bv64 %3:bv64 %4:bv64 {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req ule %2 1200
    @req ule %3 650
    @req ult %4 7

    @b0
        %5 = const 0 bv64
        %6 = cmp eq %4 %5
        br %6 @b1 @b2

    @b1
        %20 = const 0x1000000008 ptr<DiskQword,1>
        call %20 %1 %2 %3
        ret

    @b2
        %7 = const 1 bv64
        %8 = cmp eq %4 %7
        br %8 @b3 @b4

    @b3
        %21 = const 0x2000000008 ptr<DiskQword,1>
        call %21 %1 %2 %3
        ret

    @b4
        %9 = const 2 bv64
        %10 = cmp eq %4 %9
        br %10 @b5 @b6

    @b5
        %22 = const 0x3000000008 ptr<DiskQword,1>
        call %22 %1 %2 %3
        ret

    @b6
        %11 = const 3 bv64
        %12 = cmp eq %4 %11
        br %12 @b7 @b8

    @b7
        %23 = const 0x4000000008 ptr<DiskQword,1>
        call %23 %1 %2 %3
        ret

    @b8
        %13 = const 4 bv64
        %14 = cmp eq %4 %13
        br %14 @b9 @b10

    @b9
        %24 = const 0x5000000008 ptr<DiskQword,1>
        call %24 %1 %2 %3
        ret

    @b10
        %15 = const 5 bv64
        %16 = cmp eq %4 %15
        br %16 @b11 @b12

    @b11
        %25 = const 0x6000000008 ptr<DiskQword,1>
        call %25 %1 %2 %3
        ret

    @b12
        %26 = const 0x7000000008 ptr<DiskQword,1>
        call %26 %1 %2 %3
        ret
}

func app_dispatch_load_app void %0:io<0,0xffff> %1:bv64 %2:bv64 {
    @req ult %1 7
    @req ult %2 16777216

    @b0
        %3 = const 0 bv64
        %4 = cmp eq %1 %3
        br %4 @b1 @b2

    @b1
        %20 = const 0x1000000000 ptr<DiskQword,16384>
        call drv_ata_load_app %0 %20 %2
        ret

    @b2
        %5 = const 1 bv64
        %6 = cmp eq %1 %5
        br %6 @b3 @b4

    @b3
        %21 = const 0x2000000000 ptr<DiskQword,16384>
        call drv_ata_load_app %0 %21 %2
        ret

    @b4
        %7 = const 2 bv64
        %8 = cmp eq %1 %7
        br %8 @b5 @b6

    @b5
        %22 = const 0x3000000000 ptr<DiskQword,16384>
        call drv_ata_load_app %0 %22 %2
        ret

    @b6
        %9 = const 3 bv64
        %10 = cmp eq %1 %9
        br %10 @b7 @b8

    @b7
        %23 = const 0x4000000000 ptr<DiskQword,16384>
        call drv_ata_load_app %0 %23 %2
        ret

    @b8
        %11 = const 4 bv64
        %12 = cmp eq %1 %11
        br %12 @b9 @b10

    @b9
        %24 = const 0x5000000000 ptr<DiskQword,16384>
        call drv_ata_load_app %0 %24 %2
        ret

    @b10
        %13 = const 5 bv64
        %14 = cmp eq %1 %13
        br %14 @b11 @b12

    @b11
        %25 = const 0x6000000000 ptr<DiskQword,16384>
        call drv_ata_load_app %0 %25 %2
        ret

    @b12
        %26 = const 0x7000000000 ptr<DiskQword,16384>
        call drv_ata_load_app %0 %26 %2
        ret
}

func app_dispatch_zero_state void %0:io<0,0xffff> %1:bv64 {
    @req ult %1 7

    @b0
        %2 = const 0 bv64
        %3 = cmp eq %1 %2
        br %3 @b1 @b2

    @b1
        %20 = const 0x1000200000 ptr<DiskQword,64>
        call std_mem_zero %20
        ret

    @b2
        %4 = const 1 bv64
        %5 = cmp eq %1 %4
        br %5 @b3 @b4

    @b3
        %21 = const 0x2000200000 ptr<DiskQword,64>
        call std_mem_zero %21
        ret

    @b4
        %6 = const 2 bv64
        %7 = cmp eq %1 %6
        br %7 @b5 @b6

    @b5
        %22 = const 0x3000200000 ptr<DiskQword,64>
        call std_mem_zero %22
        ret

    @b6
        %8 = const 3 bv64
        %9 = cmp eq %1 %8
        br %9 @b7 @b8

    @b7
        %23 = const 0x4000200000 ptr<DiskQword,64>
        call std_mem_zero %23
        ret

    @b8
        %10 = const 4 bv64
        %11 = cmp eq %1 %10
        br %11 @b9 @b10

    @b9
        %24 = const 0x5000200000 ptr<DiskQword,64>
        call std_mem_zero %24
        ret

    @b10
        %12 = const 5 bv64
        %13 = cmp eq %1 %12
        br %13 @b11 @b12

    @b11
        %25 = const 0x6000200000 ptr<DiskQword,64>
        call std_mem_zero %25
        ret

    @b12
        %26 = const 0x7000200000 ptr<DiskQword,64>
        call std_mem_zero %26
        ret
}

func app_dispatch_get_state bv64 %0:io<0,0xffff> %1:bv64 %2:bv64 {
    @req ult %1 7
    @req ult %2 64

    @b0
        %3 = const 0 bv64
        %4 = cmp eq %1 %3
        br %4 @b1 @b2

    @b1
        %20 = const 0x1000200000 ptr<DiskQword,64>
        %30 = call cap_state_get %20 %2
        ret %30

    @b2
        %5 = const 1 bv64
        %6 = cmp eq %1 %5
        br %6 @b3 @b4

    @b3
        %21 = const 0x2000200000 ptr<DiskQword,64>
        %31 = call cap_state_get %21 %2
        ret %31

    @b4
        %7 = const 2 bv64
        %8 = cmp eq %1 %7
        br %8 @b5 @b6

    @b5
        %22 = const 0x3000200000 ptr<DiskQword,64>
        %32 = call cap_state_get %22 %2
        ret %32

    @b6
        %9 = const 3 bv64
        %10 = cmp eq %1 %9
        br %10 @b7 @b8

    @b7
        %23 = const 0x4000200000 ptr<DiskQword,64>
        %33 = call cap_state_get %23 %2
        ret %33

    @b8
        %11 = const 4 bv64
        %12 = cmp eq %1 %11
        br %12 @b9 @b10

    @b9
        %24 = const 0x5000200000 ptr<DiskQword,64>
        %34 = call cap_state_get %24 %2
        ret %34

    @b10
        %13 = const 5 bv64
        %14 = cmp eq %1 %13
        br %14 @b11 @b12

    @b11
        %25 = const 0x6000200000 ptr<DiskQword,64>
        %35 = call cap_state_get %25 %2
        ret %35

    @b12
        %26 = const 0x7000200000 ptr<DiskQword,64>
        %36 = call cap_state_get %26 %2
        ret %36
}

# =============================================================================
# THANH DOCK TỰ ĐỘNG QUÉT VFS VÀ CẤP PHÁT LÔ 64GB CHO TỐI ĐA 7 APPS
# =============================================================================
func dock_render_bar void %0:io<0,0xffff> %1:ptr<VgaCell,921600> %2:ptr<IpcChannel,1> %3:ptr<DiskQword,64> {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req uge %3 0x10000
    @req ult %3 0x80000000

    @b0
        # Nền thanh Dock động căn giữa màn hình (rộng 510px, x: 385..895)
        %6 = const 385 bv64
        %7 = const 895 bv64
        %8 = const 630 bv64
        %9 = const 712 bv64
        %10 = const 0x0b0e14 bv32
        call gfx_fill_rect %1 %6 %8 %7 %9 %10

        %11 = const 381 bv64
        %12 = const 891 bv64
        %13 = const 624 bv64
        %14 = const 706 bv64
        %15 = const 0x262f45 bv32
        call gfx_fill_rect %1 %11 %13 %12 %14 %15

        %16 = const 626 bv64
        %17 = const 0x566991 bv32
        call gfx_fill_rect %1 %11 %13 %12 %16 %17

        # Vòng lặp duyệt tất cả các App slot 0..6 trong VFS
        %18 = const 0 bv64
        jmp @b1 %18

    @b1 %19:bv64
        @inv ule %19 7
        %20 = const 7 bv64
        %21 = cmp ult %19 %20
        br %21 @b2 @b5

    @b2
        %22 = call vfs_entry_is_app %3 %19
        %23 = const 0 bv64
        %24 = cmp ne %22 %23
        br %24 @b3 @b4

    @b3
        # Tự động cấp phát Lô 64GB độc lập cho App thứ %19
        %31 = const 0x11000 ptr<DiskQword,512>
        %32 = const 0x20000 ptr<DiskQword,4096>
        call vmm_alloc_app_arena %0 %31 %32 %19
        call app_dispatch_zero_state %0 %19

        # Nạp binary của App từ VFS vào Lô Code tương ứng
        %33 = call vfs_entry_get_lba %3 %19
        call app_dispatch_load_app %0 %19 %33

        # Tự động tính tọa độ hiển thị icon của từng App trên Dock
        %34 = const 70 bv64
        %35 = mul %19 %34
        %36 = const 395 bv64
        %37 = add %36 %35
        %38 = const 634 bv64
        call app_dispatch_draw_icon %0 %1 %37 %38 %19
        jmp @b4

    @b4
        %39 = const 1 bv64
        %40 = add %19 %39
        jmp @b1 %40

    @b5
        call ui_invalidate_rect %2 %11 %13 %7 %9
        ret
}

# =============================================================================
# IPC VÀ ĐIỀU PHỐI CỬA SỔ DESKTOP KHÔNG CÒN HARDCODE APP
# =============================================================================
func app_desktop_ipc_task void %0:io<0,0xffff> %1:ptr<VgaCell,921600> %2:ptr<VgaCell,921600> %3:ptr<IpcChannel,1> %4:ptr<DiskQword,64> {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req uge %3 0x10000
    @req ult %3 0x80000000
    @req uge %4 0x10000
    @req ult %4 0x80000000

    @b0
        %9 = const 0x7c000 ptr<DiskQword,64>
        %10 = load %3 16 bv64
        %11 = load %3 24 bv64
        %12 = load %3 32 bv64
        %13 = const 0 bv64
        %14 = const 1 bv64
        %15 = const 2 bv64
        %44 = load %3 64 bv64
        %45 = load %3 72 bv64
        %95 = const 0x7e000 ptr<DiskQword,64>

        %16 = cmp ne %12 %13
        br %16 @b1 @b20

    @b1
        %17 = const 624 bv64
        %18 = cmp uge %11 %17
        br %18 @b2 @b18

    @b18
        %65 = load %3 56 bv64
        %66 = cmp ne %65 %13
        br %66 @b8 @b19

    @b19
        store %3 32 %13
        jmp @b6

    @b2
        # Vùng click Dock: x trong [390..880]
        %19 = const 390 bv64
        %20 = const 880 bv64
        %21 = cmp uge %10 %19
        %22 = cmp ult %10 %20
        %23 = and %21 %22
        br %23 @b3 @b19

    @b3
        # Tự động tính slot được click: clicked_slot = (mouse_x - 390) / 70
        %24 = sub %10 %19
        %25 = const 70 bv64
        %26 = udiv %24 %25
        %27 = call vfs_entry_is_app %4 %26
        %28 = cmp ne %27 %13
        br %28 @b4 @b19

    @b4
        # Lấy State[2] của chính App được click để khôi phục trạng thái
        %29 = call app_dispatch_get_state %0 %26 %15
        %30 = add %26 %14
        store %3 0 %13
        store %3 56 %30
        store %3 32 %13
        store %3 88 %29
        store %3 112 %13
        jmp @b8

    @b20
        %71 = load %3 0 bv64
        %72 = load %3 56 bv64
        %73 = cmp ne %71 %13
        %74 = cmp ne %72 %13

        %96 = load %3 88 bv64
        %97 = const 100 bv64
        %98 = cmp uge %96 %97
        %99 = or %73 %98
        %75 = and %99 %74
        br %75 @b8 @b6

    @b8
        %50 = load %3 56 bv64
        %51 = cmp ne %50 %13
        br %51 @b81 @b6

    @b81
        %52 = sub %50 %14
        call app_dispatch_entry %0 %2 %3 %9 %4 %95 %52
        store %3 32 %13

        %53 = load %3 56 bv64
        %54 = cmp eq %53 %13
        br %54 @b14 @b15

    @b15
        %55 = call ipc_disk_take_read_req %3
        %56 = cmp ne %55 %13
        br %56 @b13 @b16

    @b13
        %67 = const 0x1000200000 ptr<DiskQword,64>
        call drv_ata_read_sector %0 %67 %55
        call app_dispatch_entry %0 %2 %3 %9 %4 %95 %52
        jmp @b6

    @b16
        %60 = call ipc_disk_take_write_req %3
        %61 = cmp ne %60 %13
        br %61 @b17 @b6

    @b17
        %68 = const 0x1000200000 ptr<DiskQword,64>
        call drv_ata_write_sector %0 %68 %60
        call app_dispatch_entry %0 %2 %3 %9 %4 %95 %52
        jmp @b6

    @b14
        %57 = const 180 bv64
        %58 = const 50 bv64
        %59 = const 1100 bv64
        %62 = const 615 bv64
        %63 = const 0x161b26 bv32
        call gfx_fill_rect %2 %57 %58 %59 %62 %63
        call ui_invalidate_rect %3 %57 %58 %59 %62
        jmp @b6

    @b6
        %37 = load %3 80 bv64
        %38 = cmp ne %37 %13
        br %38 @b7 @b10

    @b7
        store %3 80 %13

        %80 = const 12 bv64
        %81 = const 18 bv64
        %82 = add %44 %80
        %83 = add %45 %81
        call gfx_blit_rect %1 %2 %44 %45 %82 %83

        %84 = load %3 120 bv64
        %85 = load %3 128 bv64
        %86 = load %3 136 bv64
        %87 = load %3 144 bv64
        call gfx_blit_rect %1 %2 %84 %85 %86 %87

        call gfx_draw_cursor %1 %10 %11
        store %3 64 %10
        store %3 72 %11
        jmp @b12

    @b10
        %46 = cmp ne %10 %44
        %47 = cmp ne %11 %45
        %48 = or %46 %47
        br %48 @b11 @b12

    @b11
        %88 = const 12 bv64
        %89 = const 18 bv64
        %90 = add %44 %88
        %91 = add %45 %89
        call gfx_blit_rect %1 %2 %44 %45 %90 %91
        call gfx_draw_cursor %1 %10 %11
        store %3 64 %10
        store %3 72 %11
        jmp @b12

    @b12
        ret
}
