        %26 = const 7 bv64
        %27 = const 12 bv64
        %28 = const 17 bv64
        %29 = add %1 %25
        %30 = add %1 %26
        %31 = add %2 %27
        %32 = add %2 %28
        %33 = const 0xffffff bv32
        call gfx_fill_rect %0 %29 %31 %30 %32 %33
