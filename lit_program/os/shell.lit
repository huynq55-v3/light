# File: lit_program/os/shell.lit
include ../lib/gfx.lit
include ../drivers/ata_disk.lit
include ../drivers/kbd_drv.lit
include ../lib/vfs_api.lit
include ../lib/cap_mem.lit
include ../lib/ipc_bus.lit
include ../lib/smp.lit
include ../lib/std_lib.lit

func gfx_draw_cursor void %0:ptr<VgaCell,921600> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ult %1 1260
    @req ult %2 700

    @b0
        %3 = const 0 bv64
        jmp @b1 %3

    @b1 %4:bv64
        @inv ule %4 12
        %5 = const 12 bv64
        %6 = cmp ult %4 %5
        br %6 @b2 @b7

    @b2
        %7 = const 0 bv64
        jmp @b3 %7

    @b3 %8:bv64
        @inv ult %4 12
        @inv ule %8 12
        %9 = cmp ule %8 %4
        br %9 @b4 @b6

    @b4
        %10 = add %1 %8
        %11 = add %2 %4
        %12 = const 0xffffff bv32
        call gfx_put_pixel %0 %10 %11 %12
        %13 = cmp eq %8 %4
        %14 = const 0 bv64
        %15 = cmp eq %8 %14
        %16 = const 11 bv64
        %17 = cmp eq %4 %16
        %18 = or %13 %15
        %19 = or %18 %17
        br %19 @b5 @b8

    @b5
        %20 = const 0x0f172a bv32
        call gfx_put_pixel %0 %10 %11 %20
        jmp @b8

    @b8
        %21 = const 1 bv64
        %22 = add %8 %21
        jmp @b3 %22

    @b6
        %23 = const 1 bv64
        %24 = add %4 %23
        jmp @b1 %24

    @b7
        %25 = const 4 bv64
        %26 = const 7 bv64
        %27 = const 12 bv64
        %28 = const 17 bv64
        %29 = add %1 %25
        %30 = add %1 %26
        %31 = add %2 %27
        %32 = add %2 %28
        %33 = const 0xffffff bv32
        call gfx_fill_rect %0 %29 %31 %30 %32 %33
        ret
}

# Cấp phát ĐỘNG 1 Lô 64GB mới trong Page Table cho App thứ %3 (Có bao nhiêu App thì tạo bấy nhiêu Lô!)
func vmm_alloc_app_arena void %0:io<0,0xffff> %1:ptr<DiskQword,512> %2:ptr<DiskQword,4096> %3:bv64 {
    # %0: Root IO (để flush CR3), %1: Bảng PDPT (0x11000), %2: Bể bảng trang PD_Pool (0x20000), %3: app_idx
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req ult %3 7

    @b0
        # 1. Tính địa chỉ vật lý của bảng PD riêng cho App thứ %3: pd_phys = 0x20000 + app_idx * 4096
        %4 = const 12 bv64
        %5 = shl %3 %4
        %6 = const 0x20003 bv64             # 0x20000 | Present | RW (0x03)
        %7 = add %6 %5

        # 2. Ghi vào ô PDPT[(app_idx + 1) * 64] -> Mở khóa Lô 64GB tại địa chỉ ảo (app_idx + 1) * 64GB!
        %8 = const 1 bv64
        %9 = add %3 %8
        %10 = const 6 bv64
        %11 = shl %9 %10                    # pdpt_idx = (app_idx + 1) * 64
        %12 = slice %1 %11 ptr<DiskQword,1>
        store %12 0 %7

        # 3. Cấp phát 2 trang 2MB HugePage (Code + Heap) từ RAM vật lý (16MB + app_idx * 8MB) vào PD_Pool
        %13 = const 9 bv64
        %14 = shl %3 %13                    # pd_pool_qword_idx = app_idx * 512
        %15 = const 2 bv64
        %16 = add %3 %15
        %17 = const 23 bv64
        %18 = shl %16 %17                   # phys_base = (app_idx + 2) * 8MB
        %19 = const 0x83 bv64               # Present | RW | 2MB HugePage
        %20 = or %18 %19

        # Ghi trang Code (0..2MB của Lô 64GB)
        %21 = slice %2 %14 ptr<DiskQword,1>
        store %21 0 %20

        # Ghi trang Heap/Data (2..4MB của Lô 64GB)
        %22 = add %14 %8
        %23 = const 0x200000 bv64
        %24 = add %20 %23
        %25 = slice %2 %22 ptr<DiskQword,1>
        store %25 0 %24

        # 4. Làm mới thanh ghi CR3 (0x10000) để CPU kích hoạt ngay Lô 64GB vừa tạo!
        %26 = const 0x10000 bv64
        hwio_w %0 3 %26
        ret
}

func dock_render_bar void %0:io<0,0xffff> %1:ptr<VgaCell,921600> %2:ptr<IpcChannel,1> %3:ptr<DiskQword,64> %4:ptr<DiskQword,16384> %5:ptr<DiskQword,16384> {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req uge %3 0x10000
    @req ult %3 0x80000000
    @req uge %4 0x10000
    @req ult %4 0x10000000000
    @req uge %5 0x10000
    @req ult %5 0x10000000000

    @b0
        %6 = const 464 bv64
        %7 = const 824 bv64
        %8 = const 630 bv64
        %9 = const 712 bv64
        %10 = const 0x0b0e14 bv32
        call gfx_fill_rect %1 %6 %8 %7 %9 %10

        %11 = const 460 bv64
        %12 = const 820 bv64
        %13 = const 624 bv64
        %14 = const 706 bv64
        %15 = const 0x262f45 bv32
        call gfx_fill_rect %1 %11 %13 %12 %14 %15

        %16 = const 626 bv64
        %17 = const 0x566991 bv32
        call gfx_fill_rect %1 %11 %13 %12 %16 %17

        %18 = const 0 bv64
        %19 = const 1 bv64
        %20 = const 634 bv64

        %21 = call vfs_entry_is_app %3 %18
        %22 = cmp ne %21 %18
        br %22 @b1 @b2

    @b1
        # Phát hiện App thứ %18 trong VFS -> Tự động tạo Lô 64GB mới trong Page Table ngay lúc chạy!
        %31 = const 0x11000 ptr<DiskQword,512>
        %32 = const 0x20000 ptr<DiskQword,4096>
        call vmm_alloc_app_arena %0 %31 %32 %18
        %35 = const 0x1000200000 ptr<DiskQword,64>
        call std_mem_zero %35

        %23 = call vfs_entry_get_lba %3 %18
        call drv_ata_load_app %0 %4 %23
        %24 = const 530 bv64
        %25 = slice %4 %19 ptr<DiskQword,1>
        call %25 %1 %24 %20
        jmp @b2

    @b2
        %26 = call vfs_entry_is_app %3 %19
        %27 = cmp ne %26 %18
        br %27 @b3 @b4

    @b3
        # Phát hiện App thứ %19 trong VFS -> Tự động tạo Lô 64GB mới trong Page Table ngay lúc chạy!
        %36 = const 0x11000 ptr<DiskQword,512>
        %37 = const 0x20000 ptr<DiskQword,4096>
        call vmm_alloc_app_arena %0 %36 %37 %19
        %38 = const 0x2000200000 ptr<DiskQword,64>
        call std_mem_zero %38

        %28 = call vfs_entry_get_lba %3 %19
        call drv_ata_load_app %0 %5 %28
        %29 = const 698 bv64
        %30 = slice %5 %19 ptr<DiskQword,1>
        call %30 %1 %29 %20
        jmp @b4

    @b4
        call ui_invalidate_rect %2 %11 %13 %7 %9
        ret
}

func app_desktop_ipc_task void %0:io<0,0xffff> %1:ptr<VgaCell,921600> %2:ptr<VgaCell,921600> %3:ptr<IpcChannel,1> %4:ptr<DiskQword,64> %5:ptr<DiskQword,16384> %6:ptr<DiskQword,64> %7:ptr<DiskQword,16384> %8:ptr<DiskQword,64> {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req uge %3 0x10000
    @req ult %3 0x80000000
    @req uge %4 0x10000
    @req ult %4 0x80000000
    @req uge %5 0x10000
    @req ult %5 0x10000000000
    @req uge %6 0x10000
    @req ult %6 0x10000000000
    @req uge %7 0x10000
    @req ult %7 0x10000000000
    @req uge %8 0x10000
    @req ult %8 0x10000000000

    @b0
        %9 = const 0x7c000 ptr<DiskQword,64>
        %10 = load %3 16 bv64
        %11 = load %3 24 bv64
        %12 = load %3 32 bv64
        %13 = const 0 bv64
        %14 = const 1 bv64
        %15 = const 2 bv64
        %44 = load %3 64 bv64
        %45 = load %3 72 bv64
        %95 = const 0x7e000 ptr<DiskQword,64>

        %16 = cmp ne %12 %13
        br %16 @b1 @b20

    @b1
        %17 = const 624 bv64
        %18 = cmp uge %11 %17
        br %18 @b2 @b18

    @b18
        %65 = load %3 56 bv64
        %66 = cmp ne %65 %13
        br %66 @b8 @b19

    @b19
        store %3 32 %13
        jmp @b6

    @b2
        %19 = const 510 bv64
        %20 = const 600 bv64
        %21 = cmp uge %10 %19
        %22 = cmp ult %10 %20
        %23 = and %21 %22
        br %23 @b3 @b4

    @b3
        store %3 0 %13
        store %3 56 %14
        store %3 32 %13
        store %3 88 %13
        store %3 112 %13
        jmp @b8

    @b4
        %26 = const 680 bv64
        %27 = const 770 bv64
        %28 = cmp uge %10 %26
        %29 = cmp ult %10 %27
        %30 = and %28 %29
        br %30 @b5 @b19

    @b5
        %31 = call cap_state_get %8 %15
        store %3 0 %13
        store %3 56 %15
        store %3 32 %13
        store %3 88 %31
        store %3 112 %13
        jmp @b8

    @b20
        %71 = load %3 0 bv64
        %72 = load %3 56 bv64
        %73 = cmp ne %71 %13
        %74 = cmp ne %72 %13

        %96 = load %3 88 bv64
        %97 = const 100 bv64
        %98 = cmp uge %96 %97
        %99 = or %73 %98
        %75 = and %99 %74
        br %75 @b8 @b6

    @b8
        %50 = load %3 56 bv64
        %51 = cmp eq %50 %14
        br %51 @b81 @b82

    @b81
        call %5 %2 %3 %6 %9 %4 %95
        jmp @b83

    @b82
        call %7 %2 %3 %8 %9 %4 %95
        jmp @b83

    @b83
        store %3 32 %13

        %53 = load %3 56 bv64
        %54 = cmp eq %53 %13
        br %54 @b14 @b15

    @b15
        %55 = call ipc_disk_take_read_req %3
        %56 = cmp ne %55 %13
        br %56 @b13 @b16

    @b13
        call drv_ata_read_sector %0 %6 %55
        call %5 %2 %3 %6 %9 %4 %95
        jmp @b6

    @b16
        %60 = call ipc_disk_take_write_req %3
        %61 = cmp ne %60 %13
        br %61 @b17 @b6

    @b17
        call drv_ata_write_sector %0 %6 %60
        call %5 %2 %3 %6 %9 %4 %95
        jmp @b6

    @b14
        %57 = const 180 bv64
        %58 = const 50 bv64
        %59 = const 1100 bv64
        %62 = const 615 bv64
        %63 = const 0x161b26 bv32
        call gfx_fill_rect %2 %57 %58 %59 %62 %63
        call ui_invalidate_rect %3 %57 %58 %59 %62
        jmp @b6

    @b6
        %37 = load %3 80 bv64
        %38 = cmp ne %37 %13
        br %38 @b7 @b10

    @b7
        store %3 80 %13

        %80 = const 12 bv64
        %81 = const 18 bv64
        %82 = add %44 %80
        %83 = add %45 %81
        call gfx_blit_rect %1 %2 %44 %45 %82 %83

        %84 = load %3 120 bv64
        %85 = load %3 128 bv64
        %86 = load %3 136 bv64
        %87 = load %3 144 bv64
        call gfx_blit_rect %1 %2 %84 %85 %86 %87

        call gfx_draw_cursor %1 %10 %11
        store %3 64 %10
        store %3 72 %11
        jmp @b12

    @b10
        %46 = cmp ne %10 %44
        %47 = cmp ne %11 %45
        %48 = or %46 %47
        br %48 @b11 @b12

    @b11
        %88 = const 12 bv64
        %89 = const 18 bv64
        %90 = add %44 %88
        %91 = add %45 %89
        call gfx_blit_rect %1 %2 %44 %45 %90 %91
        call gfx_draw_cursor %1 %10 %11
        store %3 64 %10
        store %3 72 %11
        jmp @b12

    @b12
        ret
}
