        %12 = const 0xffffff bv32
        call gfx_put_pixel %0 %10 %11 %12
        %13 = cmp eq %8 %4
        %14 = const 0 bv64
        %15 = cmp eq %8 %14
        %16 = const 11 bv64
        %17 = cmp eq %4 %16
        %18 = or %13 %15
        %19 = or %18 %17
        br %19 @b5 @b8

    @b5
        %20 = const 0x0f172a bv32
