        %14 = const 30000000 bv64
        %15 = urem %13 %14
        %16 = const 1 bv64
        jmp @b3 %16

    @b3 %17:bv64
        @inv uge %17 1
        @inv ule %17 8
        %18 = const 8 bv64
        %19 = cmp ult %17 %18
        br %19 @b4 @b6

    @b4
