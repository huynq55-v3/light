# File: lit_program/os/diag.lit
# CHẨN ĐOÁN KERNEL: màn hình panic khi CPU exception + tự kiểm tra `parallel` lúc boot
#
# kernel_panic được gọi bởi stub exception (src/rt/rt_exc.s) — chữ ký cố định, không có @req
# (elf64.rs kiểm tra). Stub chỉ gọi một lần: panic lồng nhau sẽ dừng máy ngay.

# Đổi 32 bit thấp của %0 thành 8 ký tự hex ASCII (ký tự đầu = nibble cao nhất), nén Little-Endian trong 1 Qword
func diag_hex8 bv64 %0:bv64 {
    @b0
        %1 = const 0 bv64
        jmp @b1 %1 %1

    @b1 %2:bv64 %3:bv64
        @inv ule %2 8
        %4 = const 8 bv64
        %5 = cmp ult %2 %4
        br %5 @b2 @b5

    @b2
        %6 = const 28 bv64
        %7 = const 2 bv64
        %8 = shl %2 %7                      # 4*i
        %9 = sub %6 %8                      # 28 - 4*i
        %10 = lshr %0 %9
        %11 = const 15 bv64
        %12 = and %10 %11                   # nibble
        %13 = const 10 bv64
        %14 = cmp ult %12 %13
        br %14 @b3 @b4

    @b3
        %15 = const 48 bv64                 # '0'
        %16 = add %12 %15
        jmp @b6 %16

    @b4
        %17 = const 55 bv64                 # 'A' - 10
        %18 = add %12 %17
        jmp @b6 %18

    @b6 %19:bv64
        @inv ult %2 8
        @inv ule %19 70
        %20 = const 3 bv64
        %21 = shl %2 %20                    # 8*i
        %22 = shl %19 %21
        %23 = or %3 %22
        %24 = const 1 bv64
        %25 = add %2 %24
        jmp @b1 %25 %23

    @b5
        ret %3
}

# Gửi tối đa 8 ký tự (Qword nén) ra COM1, bỏ qua byte 0
func diag_serial_str8 void %0:io<0x3f8,0x3ff> %1:bv64 {
    @b0
        %2 = const 0 bv64
        jmp @b1 %2

    @b1 %3:bv64
        @inv ule %3 8
        %4 = const 8 bv64
        %5 = cmp ult %3 %4
        br %5 @b2 @b9

    @b2
        %6 = const 3 bv64
        %7 = shl %3 %6
        %8 = lshr %1 %7
        %9 = const 0x7f bv64
        %10 = and %8 %9
        %11 = const 0 bv64
        %12 = cmp ne %10 %11
        br %12 @b3 @b5

    @b3
        jmp @b4 %10

    @b4 %13:bv8
        @inv ult %3 8
        @inv ult %13 128
        call drv_serial_putc %0 %13
        jmp @b5

    @b5
        @inv ult %3 8
        %14 = const 1 bv64
        %15 = add %3 %14
        jmp @b1 %15

    @b9
        ret
}

# Một dòng "NHÃN" + giá trị 64-bit dạng hex: lên màn hình (y) và ra serial
func diag_line void %0:io<0,0xffff> %1:ptr<VgaCell,1382400> %2:ptr<DiskQword,64> %3:bv64 %4:bv64 %5:bv64 {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req ule %3 700

    @b0
        %6 = const 0x00ffffff bv32
        %7 = const 40 bv64
        call gfx_draw_str8 %1 %2 %7 %3 %4 %6
        %8 = const 32 bv64
        %9 = lshr %5 %8
        %10 = call diag_hex8 %9
        %11 = const 112 bv64
        call gfx_draw_str8 %1 %2 %11 %3 %10 %6
        %12 = call diag_hex8 %5
        %13 = const 184 bv64
        call gfx_draw_str8 %1 %2 %13 %3 %12 %6
        call diag_serial_str8 %0 %4
        call diag_serial_str8 %0 %10
        call diag_serial_str8 %0 %12
        %14 = const "\n" bv64
        call diag_serial_str8 %0 %14
        ret
}

# Màn hình panic: nền đỏ, in vector / mã lỗi / RIP / CR2 / APIC ID. Ghi thẳng vào VRAM (0x200000), không qua WM.
func kernel_panic void %0:io<0,0xffff> %1:bv64 %2:bv64 %3:bv64 %4:bv64 %5:bv64 {
    @b0
        %60 = const 0x200000 ptr<VgaCell,2073600>
        %6 = const 0x200000 ptr<VgaCell,1382400>   # khung nhìn gốc (0,0) để in chữ
        %7 = const 0x7c000 ptr<DiskQword,64>
        %8 = const 0 bv64
        %9 = const 1920 bv64
        %10 = const 1080 bv64
        %11 = const 0x00a01010 bv32
        call gfx_fill_rect_scr %60 %8 %8 %9 %10 %11
        %12 = const 0x00ffffff bv32
        %13 = const 40 bv64
        %14 = const "!! KERNE" bv64
        call gfx_draw_str8 %6 %7 %13 %13 %14 %12
        %15 = const 112 bv64
        %16 = const "L PANIC " bv64
        call gfx_draw_str8 %6 %7 %15 %13 %16 %12
        %17 = const "\n!! PANI" bv64
        call diag_serial_str8 %0 %17
        %18 = const "C\n" bv64
        call diag_serial_str8 %0 %18

        %20 = const 90 bv64
        %21 = const "VECTOR  " bv64
        call diag_line %0 %6 %7 %20 %21 %1
        %22 = const 120 bv64
        %23 = const "ERRCODE " bv64
        call diag_line %0 %6 %7 %22 %23 %2
        %24 = const 150 bv64
        %25 = const "RIP     " bv64
        call diag_line %0 %6 %7 %24 %25 %3
        %26 = const 180 bv64
        %27 = const "CR2     " bv64
        call diag_line %0 %6 %7 %26 %27 %4
        %28 = const 210 bv64
        %29 = const "APIC ID " bv64
        call diag_line %0 %6 %7 %28 %29 %5
        call fb_present_rect %0 %60 %8 %8 %9 %10
        ret
}

# Worker tự kiểm tra: phần i (8 Qword) được ghi part[j] = arg * i + j
func diag_par_worker void %0:ptr<DiskQword,8> %1:bv64 %2:bv64 {
    @req ule %1 1000
    @req ult %2 16

    @b0
        %3 = const 0 bv64
        jmp @b1 %3

    @b1 %4:bv64
        @inv ule %4 8
        %5 = const 8 bv64
        %6 = cmp ult %4 %5
        br %6 @b2 @b3

    @b2
        %7 = mul %1 %2
        %8 = add %7 %4
        %9 = slice %0 %4 ptr<DiskQword,1>
        store %9 0 %8
        %10 = const 1 bv64
        %11 = add %4 %10
        jmp @b1 %11

    @b3
        ret
}

# Đếm số Qword sai so với mẫu của diag_par_worker (part i, ô j = arg * i + j) trên vùng dài ĐỘNG %0
func diag_count_mismatch bv64 %0:bv64 %1:ptr<DiskQword,%0> %2:bv64 {
    @req ule %2 1000
    @b0
        %3 = const 0 bv64
        jmp @b1 %3 %3

    @b1 %4:bv64 %5:bv64
        @inv ule %4 %0
        @inv ule %5 %4
        %6 = cmp ult %4 %0
        br %6 @b2 @b3

    @b2
        %7 = slice %1 %4 ptr<DiskQword,1>
        %8 = load %7 0 bv64
        %9 = const 3 bv64
        %10 = lshr %4 %9                    # i = q / 8
        %11 = mul %2 %10
        %12 = const 7 bv64
        %13 = and %4 %12                    # j = q % 8
        %14 = add %11 %13
        %15 = cmp ne %8 %14
        %16 = add %5 %15
        %17 = const 1 bv64
        %18 = add %4 %17
        jmp @b1 %18 %16

    @b3
        ret %5
}

# Tự kiểm tra `parallel` lúc boot: chờ AP online (có giới hạn), chạy 8 phần trên bộ đệm 0x7c000 (64 Qword),
# đối chiếu kết quả và in "SMP WORKERS ... ERRORS ..." ra serial. Bộ đệm sau đó được driver dùng lại bình thường.
func smp_selftest void %0:io<0,0xffff> %1:smp {
    @b0
        %2 = const 0 bv64
        jmp @b1 %2

    @b1 %3:bv64
        @inv ule %3 50000000
        %4 = smp_workers %1
        %5 = const 0 bv64
        %6 = cmp ne %4 %5
        br %6 @b3 @b2

    @b2
        %7 = const 50000000 bv64
        %8 = cmp ult %3 %7
        br %8 @b20 @b3

    @b20
        %9 = const 1 bv64
        %10 = add %3 %9
        jmp @b1 %10

    @b3
        %11 = smp_workers %1
        %12 = const 0x7c000 ptr<DiskQword,64>
        %13 = const 8 bv64
        %14 = const 7 bv64
        parallel %1 %13 diag_par_worker %12 %14
        %15 = const 64 bv64                 # 8 phần x 8 Qword
        %16 = call diag_count_mismatch %15 %12 %14
        jmp @b9

    @b9
        %31 = const "SMP WORK" bv64
        call diag_serial_str8 %0 %31
        %32 = const "ERS=" bv64
        call diag_serial_str8 %0 %32
        %33 = call diag_hex8 %11
        call diag_serial_str8 %0 %33
        %34 = const " PAR_ERR" bv64
        call diag_serial_str8 %0 %34
        %35 = const "=" bv64
        call diag_serial_str8 %0 %35
        %36 = call diag_hex8 %16
        call diag_serial_str8 %0 %36
        %37 = const "\n" bv64
        call diag_serial_str8 %0 %37
        ret
}

# Dòng trạng thái lúc boot (góc trên trái màn hình + serial):
#   BLK  = backend (0 không có, 1 ATA, 2 NVMe) << 48 | GPT (0 không có, 1 thấy lightos, 2 GPT thiếu lightos) << 40
#          | mã nvme_init_ctrl (0 = OK, xem drivers/nvme.lit) << 32 | rộng << 16 | cao của framebuffer thật
#   PART = LBA đầu phân vùng ; PLEN = số sector (0 = I/O bị chặn)
#   KBD  = i8042: cấu hình cũ << 56 | cấu hình mới << 48 | trả lời F6/F0/02/F4 của bàn phím << 40..16 | chuột F4 << 8 | cờ
#          (0xFA = ACK, 0xEE = hết giờ, cờ 1 = không có i8042). Xem drivers/kbd_drv.lit (i8042_setup).
#   USBD = mỗi byte 1 slot USB (slot 1 = byte thấp): tốc độ << 4 | kết quả: 1 bàn phím, 2 chuột, 3 hub (chưa hỗ trợ),
#          4 không có interface HID boot, 8 + bước = hỏng ở bước dò. USBD2 = controller thứ hai.
#   USBC = mỗi byte 1 slot: mã hoàn thành xHCI của bước dò hỏng (4 lỗi đường truyền, 3 babble, 6 STALL, 0xFF hết giờ;
#          bước 3 đã thử lại 3 lần, lần cuối chỉ 64 byte) — chỉ controller đang chạy HID (HW[46]).
#   USB2 = như USB nhưng cho controller xHCI thứ hai (HW[41]; 0 = không có)
#   USB  = giai đoạn << 56 | dev PCI << 48 | số cổng << 40 | số slot << 32 | mã hoàn thành << 24 | bàn phím << 16
#          | chuột << 8 | bước dò cuối (xem drivers/usb_xhci.lit)
#          (giai đoạn: 0 OK, 1 không có xHCI, 2 BAR/thanh ghi, 4 không dừng, 5 không reset, 6 scratchpad, 7 không chạy, 8 không có HID)
func diag_boot_report void %0:io<0,0xffff> %1:ptr<VgaCell,2073600> %2:ptr<VgaCell,2073600> %3:ptr<DiskQword,64> {
    @req uge %1 0x10000
    @req ult %1 0x40000000
    @req uge %2 0x10000
    @req ult %2 0x40000000
    @req uge %3 0x10000
    @req ult %3 0x80000000

    @b0
        %4 = const 0xff bv64
        %5 = const 0xffff bv64
        %6 = const 16 bv64
        %7 = call hw_get %0 %6
        %8 = and %7 %4
        %9 = const 48 bv64
        %10 = shl %8 %9
        %11 = const 32 bv64
        %12 = call hw_get %0 %11
        %13 = and %12 %4
        %14 = const 40 bv64
        %15 = shl %13 %14
        %16 = const 20 bv64
        %17 = call hw_get %0 %16
        %18 = and %17 %4
        %19 = shl %18 %11
        %20 = const 2 bv64
        %21 = call hw_get %0 %20
        %22 = and %21 %5
        %23 = shl %22 %6
        %24 = const 3 bv64
        %25 = call hw_get %0 %24
        %26 = and %25 %5
        %27 = or %10 %15
        %28 = or %27 %19
        %29 = or %28 %23
        %30 = or %29 %26
        %31 = const 42 bv64
        %32 = const "BLK     " bv64
        %50 = const 0 bv64
        %51 = slice %2 %50 ptr<VgaCell,1382400>
        call diag_line %0 %51 %3 %31 %32 %30

        %33 = const 17 bv64
        %34 = call hw_get %0 %33
        %35 = const 60 bv64
        %36 = const "PART    " bv64
        call diag_line %0 %51 %3 %35 %36 %34

        %37 = const 18 bv64
        %38 = call hw_get %0 %37
        %39 = const 78 bv64
        %40 = const "PLEN    " bv64
        call diag_line %0 %51 %3 %39 %40 %38

        %52 = const 40 bv64
        %53 = call hw_get %0 %52
        %54 = const 96 bv64
        %55 = const "USB     " bv64
        call diag_line %0 %51 %3 %54 %55 %53

        %60 = const 41 bv64
        %61 = call hw_get %0 %60
        %62 = const 114 bv64
        %63 = const "USB2    " bv64
        call diag_line %0 %51 %3 %62 %63 %61

        %kd = call hw_get %0 300
        %kdl = const "KBD     " bv64
        call diag_line %0 %51 %3 132 %kdl %kd
        %ud = call hw_get %0 44
        %udl = const "USBD    " bv64
        call diag_line %0 %51 %3 150 %udl %ud
        %ud2 = call hw_get %0 45
        %udl2 = const "USBD2   " bv64
        call diag_line %0 %51 %3 168 %udl2 %ud2
        %uc = call hw_get %0 46
        %ucl = const "USBC    " bv64
        call diag_line %0 %51 %3 186 %ucl %uc

        %42 = const 0 bv64
        %43 = const 320 bv64
        %44 = const 206 bv64
        %45 = const 34 bv64
        call gfx_blit_rect %1 %2 %42 %45 %43 %44
        call fb_present_rect %0 %1 %42 %45 %43 %44
        ret
}

# Xóa vùng dòng chẩn đoán (góc trên-trái) về màu nền desktop
func diag_hide void %0:io<0,0xffff> %1:ptr<VgaCell,2073600> %2:ptr<VgaCell,2073600> {
    @req uge %1 0x10000
    @req ult %1 0x40000000
    @req uge %2 0x10000
    @req ult %2 0x40000000
    @b0
        call gfx_fill_rect_scr %2 0 34 320 206 0x161b26:bv32
        call gfx_blit_rect %1 %2 0 34 320 206
        call fb_present_rect %0 %1 0 34 320 206
        ret
}

# 1 nếu nên tự hiện chẩn đoán lúc boot: có i8042 nhưng bàn phím không ACK lệnh bật quét phím (F4)
func diag_kbd_bad bv64 %0:io<0,0xffff> {
    @ens ule %r 1
    @b0
        %kd = call hw_get %0 300
        %flag = and %kd 0xff
        %absent = cmp eq %flag 1
        br %absent @no @chk
    @chk
        %a = lshr %kd 16
        %ack = and %a 0xff
        %bad = cmp ne %ack 0xfa
        br %bad @yes @no
    @yes
        ret 1
    @no
        ret 0
}

# Mỗi nhịp WM: F10 -> đảo hiện / ẩn (trạng thái ở HW[301])
func diag_tick void %0:io<0,0xffff> %1:ptr<VgaCell,2073600> %2:ptr<VgaCell,2073600> %g:ptr<IpcChannel,1> {
    @req uge %1 0x10000
    @req ult %1 0x40000000
    @req uge %2 0x10000
    @req ult %2 0x40000000
    @b0
        %3 = const 0x7c000 ptr<DiskQword,64>
        %t = load %g IpcChannel.diag_toggle
        %req = cmp ne %t 0
        br %req @flip @out
    @flip
        store %g IpcChannel.diag_toggle 0
        %v = call hw_get %0 301
        %on = cmp ne %v 0
        br %on @hide @show
    @hide
        call hw_set %0 301 0
        call diag_hide %0 %1 %2
        ret
    @show
        call hw_set %0 301 1
        call diag_boot_report %0 %1 %2 %3
        ret
    @out
        ret
}
