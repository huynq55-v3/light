# File: lit_program/os/agent.lit
# KÊNH AGENT qua COM1: máy host (MCP server tools/light_mcp.py) gửi lệnh, Kernel chạy bằng lõi shell std/shell.lit.
#
# Yêu cầu (host -> Light OS), một dòng ASCII:   <id> <lệnh>\n          (id thập phân, \r bị bỏ qua)
# Trả lời (Light OS -> host), một dòng:         \n@@LR|<id>|<exit>|<trunc>|<stdout>|<stderr>\n
#   stdout / stderr được thoát ký tự: \\ = '\'   \n = xuống dòng   \t = tab   \xHH = byte khác (kể cả '|')
#   trunc: bit 0 stdout bị cắt (> 64KB), bit 1 stderr bị cắt (> 1KB). Dòng yêu cầu dài quá AG_RX_CAP -> exit 2.
# Khởi động xong Kernel in "\n@@LREADY\n". Các dòng khác trên serial (chẩn đoán, SMP...) host bỏ qua.
# Phiên shell (thư mục hiện tại) giữ qua các lệnh. Mỗi nhịp lịch Kernel đọc tối đa AG_RX_TICK byte và chạy tối đa 1 lệnh.
# Lõi chạy từng bước; mỗi thao tác LightFS lõi xin (READ / WRITE / CREATE / DELETE) được ag_op làm ĐỒNG BỘ bằng
# LightFS của Kernel, nên cả dòng lệnh chạy xong trong một nhịp.
#
# Bộ nhớ (vùng Kernel PD_0[11], phần LightFS không dùng — xem os/lightfs.lit):
#   0x1650200  tên mục sẽ tạo (8 qword)     0x1660000  stdout (64KB)     0x1670000  dòng yêu cầu (128KB)
#   0x1690000  vùng làm việc của lõi shell (448KB: biến, đối số, bộ đệm ống)
#   0x1700000  nội dung file (1MB = file lớn nhất)

include ../std/shell.lit
include ../drivers/serial.lit
include lightfs.lit

layout AgState 24 {
    0: bv64 rx_len                          # số byte đã nhận của dòng hiện tại
    8: bv64 over                            # 1 = dòng hiện tại dài quá AG_RX_CAP
    16: bv64 present                        # 1 = có UART ở COM1 (ag_init dò); 0 -> ag_tick không làm gì
}

data AG_ERR Byte 1024 {
}
data AG_ST ShState 1 {
}
data AG_RS AgState 1 {
}
data AG_NUM Byte 24 {
}
def AG_RX_CAP 131072
def AG_STEPS 1000000
def AG_RX_TICK 8192
def AG_OUT_CAP 65536
def AG_FILE_Q 131072
def AG_FILE_B 1048576

func ag_out ptr<Byte,65536> %io:io<0,0xffff> {
    @b0
        %p = const 0x1660000 ptr<Byte,65536>
        ret %p
}

func ag_rx ptr<Byte,131072> %io:io<0,0xffff> {
    @b0
        %p = const 0x1670000 ptr<Byte,131072>
        ret %p
}

func ag_ws ptr<Byte,458752> %io:io<0,0xffff> {
    @b0
        %p = const 0x1690000 ptr<Byte,458752>
        ret %p
}

func ag_fbuf ptr<DiskQword,131072> %io:io<0,0xffff> {
    @ens uge %r 0x10000
    @ens ult %r 0x10000000000
    @b0
        %p = const 0x1700000 ptr<DiskQword,131072>
        ret %p
}

func ag_nbuf ptr<DiskQword,8> %io:io<0,0xffff> {
    @ens uge %r 0x10000
    @ens ult %r 0x10000000000
    @b0
        %p = const 0x1650200 ptr<DiskQword,8>
        ret %p
}

data AG_HDR Byte {
    "\n@@LR|"
}
data AG_READY Byte {
    "\n@@LREADY\n"
}
data AG_M_LONG Byte {
    "agent: line too long\n"
}
data AG_M_STEPS Byte {
    "agent: command did not finish (step limit)\n"
}
data AG_HEX Byte {
    "0123456789abcdef"
}
data AG_C_INST Byte {
    "appinstall"
}
data AG_M_IUSE Byte {
    "appinstall: usage: appinstall SRC APP  (SRC = new .elf, APP = installed app file under /apps)\n"
}
data AG_M_ISRC Byte {
    "appinstall: SRC must be an existing regular file\n"
}
data AG_M_IDST Byte {
    "appinstall: APP must be an app file loaded in a Dock slot (new apps need a reboot)\n"
}
data AG_M_ISIZE Byte {
    "appinstall: SRC size must be 24 B .. 1 MiB\n"
}
data AG_M_IREAD Byte {
    "appinstall: cannot read SRC\n"
}
data AG_M_IHDR Byte {
    "appinstall: SRC is not a Light app binary (bad entry stubs)\n"
}
data AG_M_IWRITE Byte {
    "appinstall: write failed (disk full?); old app kept\n"
}
data AG_M_ILOAD Byte {
    "appinstall: load failed; app removed from its slot\n"
}
data AG_M_IOK1 Byte {
    "installed into slot "
}
data AG_M_IOK2 Byte {
    ", "
}
data AG_M_IOK3 Byte {
    " bytes; app restarted\n"
}

# Gửi (n, s) nguyên văn (byte >= 128 -> '?')
func ag_raw void %io:io<0x3f8,0x3ff> %n:bv64 %s:ptr<Byte,%n> {
    @b0
        jmp @l 0
    @l %i:bv64
        @inv ule %i %n
        %more = cmp ult %i %n
        br %more @body @end
    @body
        %p = slice %s %i ptr<Byte,1>
        %b = load %p 0 bv8
        %ok = cmp ult %b 128
        br %ok @send @q
    @send
        call drv_serial_putc_wait %io %b
        jmp @next
    @q
        call drv_serial_putc_wait %io 63
        jmp @next
    @next
        %i2 = add %i 1
        jmp @l %i2
    @end
        ret
}

func ag_dec void %io:io<0x3f8,0x3ff> %v:bv64 {
    @b0
        %buf = addr AG_NUM
        %k = call fmt_u64 AG_NUM.len %buf 0 %v
        %s = slice %buf 0 ptr<Byte,%k>
        call ag_raw %io %k %s
        ret
}

func ag_bar void %io:io<0x3f8,0x3ff> {
    @b0
        call drv_serial_putc_wait %io 124
        ret
}

# "\xHH"
func ag_hexbyte void %io:io<0x3f8,0x3ff> %b:bv8 {
    @b0
        call drv_serial_putc_wait %io 92
        call drv_serial_putc_wait %io 120
        %v = call byte_u64 %b
        %hi = lshr %v 4
        %lo = and %v 15
        %hx = addr AG_HEX
        %ph = slice %hx %hi ptr<Byte,1>
        %ch = load %ph 0 bv8
        %pl = slice %hx %lo ptr<Byte,1>
        %cl = load %pl 0 bv8
        %okh = cmp ult %ch 128
        %okl = cmp ult %cl 128
        %ok = and %okh %okl
        br %ok @send @end
    @send
        call drv_serial_putc_wait %io %ch
        call drv_serial_putc_wait %io %cl
        ret
    @end
        ret
}

# Gửi (n, s) có thoát ký tự
func ag_esc void %io:io<0x3f8,0x3ff> %n:bv64 %s:ptr<Byte,%n> {
    @b0
        jmp @l 0
    @l %i:bv64
        @inv ule %i %n
        %more = cmp ult %i %n
        br %more @body @end
    @body
        %p = slice %s %i ptr<Byte,1>
        %b = load %p 0 bv8
        %bs = cmp eq %b 92
        br %bs @slash @t_nl
    @slash
        call drv_serial_putc_wait %io 92
        call drv_serial_putc_wait %io 92
        jmp @next
    @t_nl
        %nl = cmp eq %b 10
        br %nl @newline @t_tab
    @newline
        call drv_serial_putc_wait %io 92
        call drv_serial_putc_wait %io 110
        jmp @next
    @t_tab
        %tb = cmp eq %b 9
        br %tb @tab @t_print
    @tab
        call drv_serial_putc_wait %io 92
        call drv_serial_putc_wait %io 116
        jmp @next
    @t_print
        %ge = cmp uge %b 32
        %le = cmp ule %b 126
        %bar = cmp eq %b 124
        %pr0 = and %ge %le
        %nbar = cmp eq %bar 0
        %pr = and %pr0 %nbar
        %prn = cmp ne %pr 0
        br %prn @plain @hex
    @plain
        call drv_serial_putc_wait %io %b
        jmp @next
    @hex
        call ag_hexbyte %io %b
        jmp @next
    @next
        %i2 = add %i 1
        jmp @l %i2
    @end
        ret
}

# Khung trả lời cho yêu cầu %id
func ag_reply void %io:io<0,0xffff> %id:bv64 {
    @b0
        %st = addr AG_ST
        %h = addr AG_HDR
        call ag_raw %io AG_HDR.len %h
        call ag_dec %io %id
        call ag_bar %io
        %rc = load %st ShState.exit
        call ag_dec %io %rc
        call ag_bar %io
        %t = load %st ShState.trunc
        call ag_dec %io %t
        call ag_bar %io
        %ol0 = load %st ShState.so_len
        %ol = call math_min %ol0 AG_OUT_CAP
        %ob = call ag_out %io
        %os = slice %ob 0 ptr<Byte,%ol>
        call ag_esc %io %ol %os
        call ag_bar %io
        %el0 = load %st ShState.err_len
        %el = call math_min %el0 AG_ERR.len
        %eb = addr AG_ERR
        %es = slice %eb 0 ptr<Byte,%el>
        call ag_esc %io %el %es
        call drv_serial_putc_wait %io 10
        ret
}

# Làm thao tác LightFS lõi shell xin (ShState.op), trả kết quả theo quy ước LightFS
func ag_op bv64 %io:io<0,0xffff> {
    @b0
        %st = addr AG_ST
        %op = load %st ShState.op
        %id = load %st ShState.op_id
        %len = load %st ShState.op_len
        # hệ tệp chưa gắn được (không có đĩa / bảng hỏng): không đụng bảng, báo lỗi 1
        %m = call lfs_sget %io 0
        %mounted = cmp ne %m 0
        br %mounted @go @unmounted
    @unmounted
        %e1 = call lfs_err 1
        ret %e1
    @go
        %fb = call ag_fbuf %io
        %is_r = cmp eq %op SH_OP_READ
        br %is_r @read @t_w
    @read
        %rr = call lfs_read_buf %io AG_FILE_Q %fb %id
        ret %rr
    @t_w
        %is_w = cmp eq %op SH_OP_WRITE
        br %is_w @write @t_c
    @write
        %rw = call lfs_write_buf %io AG_FILE_Q %fb %id %len
        ret %rw
    @t_c
        %is_c = cmp eq %op SH_OP_CREATE
        br %is_c @create @t_d
    @create
        %q = call ag_nbuf %io
        %ws = call ag_ws %io
        call sh_op_name %ws %q
        %rc = call lfs_create_name %io %id %q %len
        ret %rc
    @t_d
        %is_d = cmp eq %op SH_OP_DELETE
        br %is_d @delete @unknown
    @delete
        %rd = call lfs_op_delete %io %id
        ret %rd
    @unknown
        %ex = call lfs_err 10
        ret %ex
}

# Lỗi của appinstall: thông báo (n, s) vào stderr, mã thoát %rc
func ag_ifail void %n:bv64 %s:ptr<Byte,%n> %rc:bv64 {
    @b0
        %st = addr AG_ST
        %err = addr AG_ERR
        call sh_err %st AG_ERR.len %err %n %s
        store %st ShState.exit %rc
        ret
}

# 1 nếu byte %at của %b bằng %v
func ag_byte_is bv64 %n:bv64 %b:ptr<Byte,%n> %at:bv64 %v:bv8 {
    @ens ule %r 1
    @b0
        %in = cmp ult %at %n
        br %in @get @no
    @get
        %p = slice %b %at ptr<Byte,1>
        %x = load %p 0 bv8
        %eq = cmp eq %x %v
        br %eq @yes @no
    @yes
        ret 1
    @no
        ret 0
}

# Slot (0..6) đang nạp App từ mục %id, hoặc 7 nếu không có
func ag_slot_of bv64 %io:io<0,0xffff> %id:bv64 {
    @ens ule %r 7
    @b0
        %want = add_sat %id 1
        jmp @l 0
    @l %s:bv64
        @inv ule %s 7
        %more = cmp ult %s 7
        br %more @body @none
    @body
        %si = add %s 24
        %v = call lfs_sget %io %si
        %hit = cmp eq %v %want
        br %hit @yes @next
    @next
        %s2 = add %s 1
        jmp @l %s2
    @yes
        ret %s
    @none
        ret 7
}

# CÀI APP NÓNG (chỉ kênh Agent):  appinstall SRC APP
#   SRC: file thường chứa mã App mới (host biên dịch + kiểm chứng: `light build-app`), APP: file App đang nạp ở một slot.
#   Kiểm tra hết TRƯỚC khi ghi (ghi là bước không quay lại): SRC là file thường 24 B .. 1 MiB, đọc được, đúng 3 lệnh nhảy
#   đầu (E9 .. 90 90 90 ở 0 / 8 / 16); APP có cờ App và đang ở slot s. Rồi: ghi SRC vào CÙNG mục APP (giữ id -> slot và
#   thứ tự nạp lúc boot không đổi), đóng + reset App như nút [X], nạp lại mã, mở lại cửa sổ ở foreground.
#   Mã App chạy trực tiếp bởi Kernel: lệnh này cho host quyền chạy mã tùy ý, như quyền ghi disk.img.
func ag_install void %io:io<0,0xffff> %view:ptr<VgaCell,1382400> %g:ptr<IpcChannel,1> %n:bv64 %cmd:ptr<Byte,%n> {
    @req uge %view 0x10000
    @req ult %view 0x80000000
    @req uge %g 0x10000
    @req ult %g 0x80000000
    @b0
        %st = addr AG_ST
        store %st ShState.exit 0
        %a = call str_skip_spaces %n %cmd AG_C_INST.len
        %e1 = call str_find %n %cmd %a 32
        %k1 = sub_sat %e1 %a
        %b = call str_skip_spaces %n %cmd %e1
        %e2 = call str_find %n %cmd %b 32
        %k2 = sub_sat %e2 %b
        %z = call str_skip_spaces %n %cmd %e2
        %ne1 = cmp ne %k1 0
        %ne2 = cmp ne %k2 0
        %end = cmp eq %z %n
        %ok0 = and %ne1 %ne2
        %ok = and %ok0 %end
        %a1 = call math_min %a %n
        %b1 = call math_min %b %n
        br %ok @args @usage
    @usage
        %mu = addr AG_M_IUSE
        call ag_ifail AG_M_IUSE.len %mu 2
        ret
    @args
        %m = call lfs_sget %io 0
        %mounted = cmp ne %m 0
        br %mounted @resolve @nosrc
    @resolve
        %tab = call lfs_tab %io
        %cw0 = load %st ShState.cwd
        %cw = call math_min %cw0 255
        %r1 = sub %n %a1
        %l1 = call math_min %k1 %r1
        %p1 = slice %cmd %a1 ptr<Byte,%l1>
        %src = call sh_resolve %tab %cw %l1 %p1
        %r2 = sub %n %b1
        %l2 = call math_min %k2 %r2
        %p2 = slice %cmd %b1 ptr<Byte,%l2>
        %dst = call sh_resolve %tab %cw %l2 %p2
        %sok = cmp ult %src 256
        br %sok @srcf @nosrc
    @srcf
        %sf = call lfs_tget %tab %src 0
        %s7 = and %sf 7
        %plain = cmp eq %s7 1               # đang dùng, không thư mục, không App
        br %plain @dstok @nosrc
    @dstok
        %dok = cmp ult %dst 256
        br %dok @dstf @nodst
    @dstf
        %df = call lfs_tget %tab %dst 0
        %d7 = and %df 7
        %isapp = cmp eq %d7 5
        br %isapp @slot @nodst
    @slot
        %s = call ag_slot_of %io %dst
        %loaded = cmp ult %s 7
        br %loaded @size @nodst
    @size
        %sz = call lfs_tget %tab %src 2
        %big = cmp uge %sz 24
        %fit = cmp ule %sz AG_FILE_B
        %szok = and %big %fit
        br %szok @read @badsize
    @read
        %fb = call ag_fbuf %io
        %rr = call lfs_read_buf %io AG_FILE_Q %fb %src
        %rerr = lshr %rr 63
        %rok = cmp eq %rerr 0
        br %rok @hdr @noread
    @hdr
        %bb = view %fb ptr<Byte,1048576>
        %h0 = call ag_byte_is AG_FILE_B %bb 0 0xe9
        %h1 = call ag_byte_is AG_FILE_B %bb 8 0xe9
        %h2 = call ag_byte_is AG_FILE_B %bb 16 0xe9
        %h3 = call ag_byte_is AG_FILE_B %bb 7 0x90
        %h4 = call ag_byte_is AG_FILE_B %bb 15 0x90
        %h5 = call ag_byte_is AG_FILE_B %bb 23 0x90
        %ha = and %h0 %h1
        %hb = and %h2 %h3
        %hc = and %h4 %h5
        %hab = and %ha %hb
        %hh = and %hab %hc
        %hok = cmp ne %hh 0
        br %hok @write @badhdr
    @write
        %wr = call lfs_write_mode %io AG_FILE_Q %fb %dst %rr 1
        %werr = lshr %wr 63
        %wok = cmp eq %werr 0
        br %wok @reload @nowrite
    @reload
        # Như nút [X]: reset State + kênh + surface, trả chunk RAM, gỡ cửa sổ; rồi nạp mã mới vào bộ đệm mã của slot
        %smp = const 0x7e000 smp
        call shell_close_and_reset_app %io %view %g %smp %s
        %ld = call app_dispatch_load_app %io %s
        %ds = call dock_ds %io
        store %ds DockState.drawn 0         # Dock vẽ lại icon bằng mã mới
        %ldok = cmp ne %ld 0
        br %ldok @open @noload
    @open
        # Như bấm icon trên Dock: cửa sổ lên foreground; bit chạy ngầm = gọi App một lần ở nhịp tới để nó tự vẽ
        call comp_focus %io %view %g %s
        %s1 = add %s 1
        store %g IpcChannel.key_ready 0
        store %g IpcChannel.active_app %s1
        store %g IpcChannel.click 0
        store %g IpcChannel.win_cmd 0
        store %g IpcChannel.win_drawn 0
        %chn = call app_chan %io %s
        store %chn IpcChannel.win_drawn 0
        %bm = load %g IpcChannel.bg_mask
        %bit = shl 1 %s
        %bm1 = or %bm %bit
        store %g IpcChannel.bg_mask %bm1
        %out = call ag_out %io
        %q1 = addr AG_M_IOK1
        %o1 = call fmt_str AG_OUT_CAP %out 0 AG_M_IOK1.len %q1
        %o2 = call fmt_u64 AG_OUT_CAP %out %o1 %s
        %q2 = addr AG_M_IOK2
        %o3 = call fmt_str AG_OUT_CAP %out %o2 AG_M_IOK2.len %q2
        %o4 = call fmt_u64 AG_OUT_CAP %out %o3 %rr
        %q3 = addr AG_M_IOK3
        %o5 = call fmt_str AG_OUT_CAP %out %o4 AG_M_IOK3.len %q3
        store %st ShState.so_len %o5
        ret
    @nosrc
        %ms = addr AG_M_ISRC
        call ag_ifail AG_M_ISRC.len %ms 1
        ret
    @nodst
        %md = addr AG_M_IDST
        call ag_ifail AG_M_IDST.len %md 1
        ret
    @badsize
        %mz = addr AG_M_ISIZE
        call ag_ifail AG_M_ISIZE.len %mz 1
        ret
    @noread
        %mr = addr AG_M_IREAD
        call ag_ifail AG_M_IREAD.len %mr 1
        ret
    @badhdr
        %mh = addr AG_M_IHDR
        call ag_ifail AG_M_IHDR.len %mh 1
        ret
    @nowrite
        %mw = addr AG_M_IWRITE
        call ag_ifail AG_M_IWRITE.len %mw 1
        ret
    @noload
        %ml = addr AG_M_ILOAD
        call ag_ifail AG_M_ILOAD.len %ml 1
        ret
}

# Một dòng yêu cầu đã nhận đủ trong ag_rx: tách id, chạy lệnh đến hết, trả lời
func ag_line void %io:io<0,0xffff> %view:ptr<VgaCell,1382400> %g:ptr<IpcChannel,1> {
    @req uge %view 0x10000
    @req ult %view 0x80000000
    @req uge %g 0x10000
    @req ult %g 0x80000000
    @b0
        %rs = addr AG_RS
        %len0 = load %rs AgState.rx_len
        %over = load %rs AgState.over
        store %rs AgState.rx_len 0
        store %rs AgState.over 0
        %rx = call ag_rx %io
        %len = call math_min %len0 AG_RX_CAP
        %line = slice %rx 0 ptr<Byte,%len>
        %a = call str_skip_spaces %len %line 0
        %id = call str_parse_u64 %len %line %a
        %sp = call str_find %len %line %a 32
        %c0 = add_sat %sp 1
        %c = call math_min %c0 %len
        %cn = sub %len %c
        %cmd = slice %line %c ptr<Byte,%cn>
        %st = addr AG_ST
        call sh_begin %st
        store %st ShState.so_len 0
        %out = call ag_out %io
        %err = addr AG_ERR
        %long = cmp ne %over 0
        br %long @toolong @run
    @run
        %ip = addr AG_C_INST
        %isi = call str_starts_with %cn %cmd AG_C_INST.len %ip
        %isp = call ag_byte_is %cn %cmd AG_C_INST.len 32
        %iex = cmp eq %cn AG_C_INST.len
        %ispb = cmp ne %isp 0
        %iend = or %ispb %iex
        %isib = cmp ne %isi 0
        %inst = and %isib %iend
        br %inst @install @shell
    @install
        call ag_install %io %view %g %cn %cmd
        call ag_reply %io %id
        ret
    @shell
        %tab = call lfs_tab %io
        %ws = call ag_ws %io
        %fbq = call ag_fbuf %io
        %fb = view %fbq ptr<Byte,1048576>
        jmp @l 0
    @l %k:bv64
        @inv ule %k AG_STEPS
        @dec sub AG_STEPS %k
        %more = cmp ult %k AG_STEPS
        br %more @step @limit
    @step
        %k1 = add %k 1
        %r = call sh_step %st %ws %cn %cmd %tab AG_FILE_B %fb AG_OUT_CAP %out AG_ERR.len %err
        %done = cmp eq %r 0
        br %done @reply @t_op
    @t_op
        %isop = cmp eq %r 1
        br %isop @op @again
    @op
        %res = call ag_op %io
        call sh_op_done %st %res
        jmp @l %k1
    @again
        jmp @l %k1
    @limit
        %ml = addr AG_M_STEPS
        call sh_err %st AG_ERR.len %err AG_M_STEPS.len %ml
        store %st ShState.exit 1
        jmp @reply
    @reply
        call ag_reply %io %id
        ret
    @toolong
        %m = addr AG_M_LONG
        call sh_err %st AG_ERR.len %err AG_M_LONG.len %m
        store %st ShState.exit 2
        call ag_reply %io %id
        ret
}

# Dò UART ở COM1 (máy thật thường không có: cổng trống đọc ra 0xFF), bật FIFO và báo sẵn sàng
func ag_init void %io:io<0,0xffff> {
    @b0
        %rs = addr AG_RS
        store %rs AgState.present 0
        # vùng nhớ này không được xóa lúc boot: vùng biến / bảng đối số của lõi shell phải bắt đầu bằng 0
        %ws = call ag_ws %io
        %hd = slice %ws 0 ptr<Byte,8192>
        call mem_fill_b 8192 %hd 0
        %st = addr AG_ST
        store %st ShState.cwd 0
        store %st ShState.exit 0
        %lsr = hwio_r %io 0x3fd
        %dead = cmp eq %lsr 0xff
        br %dead @absent @scratch
    @scratch
        # thanh ghi nháp 0x3ff: ghi rồi đọc lại phải khớp
        %t = const 0x5a bv8
        hwio_w %io 0x3ff %t
        %back = hwio_r %io 0x3ff
        %same = cmp eq %back 0x5a
        br %same @found @absent
    @absent
        ret
    @found
        store %rs AgState.present 1
        %f = const 0xc7 bv8
        hwio_w %io 0x3fa %f
        %r = addr AG_READY
        call ag_raw %io AG_READY.len %r
        ret
}

# Mỗi nhịp lịch: nhận tối đa AG_RX_TICK byte; gặp '\n' thì chạy lệnh (tối đa 1 lệnh / nhịp)
func ag_tick void %io:io<0,0xffff> %back:ptr<VgaCell,2073600> %g:ptr<IpcChannel,1> {
    @req uge %back 0x10000
    @req ult %back 0x40000000
    @req uge %g 0x10000
    @req ult %g 0x80000000
    @b0
        %rs = addr AG_RS
        %pr = load %rs AgState.present
        %on = cmp ne %pr 0
        br %on @start @out
    @start
        jmp @l 0
    @l %k:bv64
        @inv ule %k AG_RX_TICK
        %more = cmp ult %k AG_RX_TICK
        br %more @poll @out
    @poll
        %v = call drv_serial_getc %io
        %none = cmp eq %v 0x100
        br %none @out @got
    @got
        %nl = cmp eq %v 10
        br %nl @line @t_cr
    @line
        # khung nhìn App trên Backbuffer: gốc (320, 160), như app_desktop_ipc_task
        %view = slice %back 307520 ptr<VgaCell,1382400>
        call ag_line %io %view %g
        ret
    @t_cr
        %cr = cmp eq %v 13
        br %cr @next @app
    @app
        %len = load %rs AgState.rx_len
        %full = cmp uge %len AG_RX_CAP
        br %full @ovf @store
    @store
        %rx = call ag_rx %io
        %p = slice %rx %len ptr<Byte,1>
        %b = narrow %v bv8
        store %p 0 %b
        %l2 = add %len 1
        store %rs AgState.rx_len %l2
        jmp @next
    @ovf
        store %rs AgState.over 1
        jmp @next
    @next
        %k2 = add %k 1
        jmp @l %k2
    @out
        ret
}
