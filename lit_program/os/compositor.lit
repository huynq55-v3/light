# File: lit_program/os/compositor.lit
# COMPOSITOR (lát 2): mỗi slot App vẽ vào SURFACE RIÊNG, Kernel ghép vùng bẩn của App foreground vào Backbuffer.
#
#   Surface slot s: vật lý 0x12000000 + s*6MB (6MB >= 1920*720*4 = 5.53MB), cùng hình học với khung nhìn App cũ
#   (ptr<VgaCell,1382400>, stride 1920) -> ABI App không đổi. 7 surface = 21 khung 2MB ĐẦU của bể VMM
#   (288MB..330MB): comp_init đánh dấu đã cấp trong bitmap rồi ánh xạ đồng nhất vào PD_0[144..164] (0..1GB của
#   PD_0 chưa có gì ở đó). Phải ở dưới 2GB vì App và thư viện gfx đòi `@req ult %fb 0x80000000`.
#
#   Bật/tắt: CompCtl.enabled = 1 do comp_init ghi sau khi giữ khung + ánh xạ xong (trước đây đọc PD_0[144]). Không có đủ 21 khung trống
#   (máy < ~330MB RAM khả dụng) -> không ghi gì, App vẽ thẳng vào Backbuffer như trước.
#
#   Chỉ ghép trong VÙNG CỬA SỔ [180,1100) x [50,615) (tọa độ khung nhìn) — vùng WM vẫn xóa khi đổi/đóng App;
#   Dock và nền Desktop ngoài vùng này không bao giờ bị surface đè.

include ../lib/gfx.lit
include ../lib/std_lib.lit
include ../std/surface.lit

def COMP_X1 180
def COMP_Y1 50
def COMP_X2 1100
def COMP_Y2 615
def COMP_BG 0x161b26

layout CompSlot 6291456 {
    0: bv32
}

# =============================================================================
# CẢNH (lát 3): thứ tự chồng (z-order) + vị trí từng cửa sổ, nhấn để đưa lên trên, kéo bằng thanh tiêu đề.
#   App vẫn vẽ cửa sổ ở vị trí CỐ ĐỊNH (200,60) cỡ 880x540 (+6 bóng đổ) trong surface của nó; compositor đặt cửa sổ
#   ở (wx, wy) của khung nhìn: điểm (200+u, 60+v) của surface -> (wx+u, wy+v). Chuột gửi cho App được quy đổi ngược
#   lại nên App không biết cửa sổ đã bị dời -> ABI không đổi.
#   Trang IPC 0x79000: kênh toàn cục 0x79000 (320 byte), kênh riêng 7 slot 0x79200..0x79ac0, bảng cảnh 0x79c00 CompCtl,
#   0x79c80 CompWin x7 (trường z của bản ghi i = phần tử i của thứ tự chồng, dưới -> trên).
#   Bất biến: IpcChannel.active_app = cửa sổ trên cùng (0 nếu không còn cửa sổ nào).
# =============================================================================

def WIN_X0 200
def WIN_Y0 60
def WIN_W 880                               # kích thước mặc định (App chưa báo kích thước)
def WIN_H 540
def WIN_MIN_W 300                           # kích thước App được báo: [300,1074] x [150,558]
def WIN_MIN_H 150
def WIN_MAX_W 1074                          # 200 + 1074 + 6 = 1280 (gfx/khung nhìn)
def WIN_MAX_H 558                           # 60 + 558 + 6 = 624 (vị trí mở mặc định)
def WIN_TITLE_H 32
def WIN_XBTN 28                             # nút đóng (đèn đỏ kiểu macOS, u 12..23) = 28 điểm đầu thanh tiêu đề
def WIN_GRIP 16                             # góc kéo đổi kích thước = ô 16x16 góc dưới-phải
def WIN_MAX_X 974                           # 1280 - (300 + 6)
def WIN_MAX_Y 590
def VIEW_W 1280
def VIEW_H 720                              # cả khung nhìn (màn hình y 160..880; Dock nổi ở y 987+ nằm ngoài)
def VIEW_SX 320
def VIEW_SY 160

layout CompCtl 64 {
    0: bv64 count @inv ule val 7            # số cửa sổ đang mở (số phần tử z hợp lệ)
    8: bv64 drag @inv ult val 8             # slot+1 của cửa sổ đang kéo, 0 = không kéo
    16: bv64 gx @inv ule val 1074           # chỗ nắm trong cửa sổ lúc bắt đầu kéo
    24: bv64 gy @inv ule val 32
    32: bv64 mode @inv ule val 1            # 0 = dời cửa sổ, 1 = đổi kích thước (góc dưới-phải)
    40: bv64 enabled @inv ule val 1         # 1 = compositor bật (comp_init giữ được 21 khung + ánh xạ xong)
}

layout CompWin 48 {
    0: bv64 x @inv ule val 974              # góc trên-trái cửa sổ trong khung nhìn (x + w + 6 <= 1280 do comp giữ)
    8: bv64 y @inv ule val 590
    16: bv64 title                          # tên cửa sổ đã vẽ trên khung (so với IpcChannel.title để biết khi đổi)
    24: bv64 w @inv ule val 1074            # kích thước cửa sổ (không kể bóng đổ 6 điểm) mà App đã báo
    32: bv64 h @inv ule val 558
    40: bv64 z @inv ult val 8               # phần tử thứ i của thứ tự chồng (dưới -> trên): slot+1
}

# 1 nếu compositor đã được bật lúc boot
func cs_enabled bv64 %k:ptr<CompCtl,1> {
    @ens ule %r 1
    @b0
        %e = load %k CompCtl.enabled
        ret %e
}

# Surface của slot (0..6). Chỉ hợp lệ để chạm vào khi compositor bật.
func cs_surface ptr<VgaCell,1382400> %sf:ptr<CompSlot,7> %slot:bv64 {
    @req uge %sf 0x10000
    @req ult %sf 0x40000000
    @req ult %slot 7
    @ens uge %r 0x10000
    @ens ult %r 0x80000000
    @b0
        %one = slice %sf %slot ptr<CompSlot,1>
        %px = view %one ptr<VgaCell,1382400>
        ret %px
}

# Đích vẽ của App slot: surface riêng nếu compositor bật, ngược lại khung nhìn Backbuffer %fb
func cs_target ptr<VgaCell,1382400> %k:ptr<CompCtl,1> %ws:ptr<CompWin,7> %chs:ptr<IpcChannel,7> %sf:ptr<CompSlot,7> %fb:ptr<VgaCell,1382400> %slot:bv64 {
    @req uge %fb 0x10000
    @req ult %fb 0x80000000
    @req ult %slot 7
    @ens uge %r 0x10000
    @ens ult %r 0x80000000
    @req uge %sf 0x10000
    @req ult %sf 0x40000000
    @b0
        %on = call cs_enabled %k
        %yes = cmp ne %on 0
        br %yes @surf @direct
    @surf
        %s = call cs_surface %sf %slot
        ret %s
    @direct
        ret %fb
}
# Xóa vùng cửa sổ của surface slot về màu nền (lúc boot và khi đóng App: không rò điểm ảnh sang App kế tiếp)
func cs_clear_slot void %k:ptr<CompCtl,1> %ws:ptr<CompWin,7> %chs:ptr<IpcChannel,7> %sf:ptr<CompSlot,7> %slot:bv64 {
    @req ult %slot 7
    @req uge %sf 0x10000
    @req ult %sf 0x40000000
    @b0
        %on = call cs_enabled %k
        %yes = cmp ne %on 0
        br %yes @clr @done
    @clr
        %s = call cs_surface %sf %slot
        call gfx_fill_rect %s COMP_X1 COMP_Y1 1280 720 COMP_BG
        ret
    @done
        ret
}
# Chép một hàng %n điểm
func comp_copy_row void %n:bv64 %dst:ptr<VgaCell,%n> %src:ptr<VgaCell,%n> {
    @b0
        jmp @l 0
    @l %i:bv64
        @inv ule %i %n
        %more = cmp ult %i %n
        br %more @body @done
    @body
        %s = slice %src %i ptr<VgaCell,1>
        %d = slice %dst %i ptr<VgaCell,1>
        %v = load %s 0 bv32
        store %d 0 %v
        %i2 = add %i 1
        jmp @l %i2
    @done
        ret
}
func cs_ctl ptr<CompCtl,1> %k:ptr<CompCtl,1> {
    @b0
        ret %k
}

# Phần tử thứ i của thứ tự chồng (trường z của bản ghi thứ i)
func cs_z ptr<CompWin,1> %ws:ptr<CompWin,7> %i:bv64 {
    @req ult %i 7
    @b0
        %e = slice %ws %i ptr<CompWin,1>
        ret %e
}

func cs_win ptr<CompWin,1> %ws:ptr<CompWin,7> %slot:bv64 {
    @req ult %slot 7
    @b0
        %e = slice %ws %slot ptr<CompWin,1>
        ret %e
}

func cs_chan ptr<IpcChannel,1> %chs:ptr<IpcChannel,7> %slot:bv64 {
    @req ult %slot 7
    @b0
        %c = slice %chs %slot ptr<IpcChannel,1>
        ret %c
}

# Cảnh rỗng, mọi cửa sổ về vị trí mặc định
func cs_scene_init void %k:ptr<CompCtl,1> %ws:ptr<CompWin,7> %chs:ptr<IpcChannel,7> %sf:ptr<CompSlot,7> {
    @req uge %sf 0x10000
    @req ult %sf 0x40000000
    @b0
        %c = call cs_ctl %k
        store %c CompCtl.count 0
        store %c CompCtl.drag 0
        store %c CompCtl.gx 0
        store %c CompCtl.gy 0
        store %c CompCtl.mode 0
        jmp @l 0
    @l %i:bv64
        @inv ule %i 7
        %more = cmp ult %i 7
        br %more @body @done
    @body
        %z = call cs_z %ws %i
        store %z CompWin.z 0
        %w = call cs_win %ws %i
        store %w CompWin.x WIN_X0
        store %w CompWin.y WIN_Y0
        store %w CompWin.title 0
        store %w CompWin.w WIN_W
        store %w CompWin.h WIN_H
        %i2 = add %i 1
        jmp @l %i2
    @done
        ret
}
# slot+1 của cửa sổ trên cùng, 0 nếu cảnh rỗng
func cs_top bv64 %k:ptr<CompCtl,1> %ws:ptr<CompWin,7> %chs:ptr<IpcChannel,7> %sf:ptr<CompSlot,7> {
    @ens ult %r 8
    @req uge %sf 0x10000
    @req ult %sf 0x40000000
    @b0
        %c = call cs_ctl %k
        %n = load %c CompCtl.count
        %empty = cmp eq %n 0
        br %empty @none @get
    @get
        %i = sub %n 1
        %z = call cs_z %ws %i
        %s = load %z CompWin.z
        ret %s
    @none
        ret 0
}
# 1 nếu slot đang có cửa sổ trong cảnh
func cs_has bv64 %k:ptr<CompCtl,1> %ws:ptr<CompWin,7> %chs:ptr<IpcChannel,7> %sf:ptr<CompSlot,7> %slot:bv64 {
    @req ult %slot 7
    @ens ule %r 1
    @req uge %sf 0x10000
    @req ult %sf 0x40000000
    @b0
        %me = add %slot 1
        %c = call cs_ctl %k
        %n = load %c CompCtl.count
        jmp @l 0
    @l %i:bv64
        @inv ule %i 7
        %more = cmp ult %i 7
        br %more @in @no
    @in
        %live = cmp ult %i %n
        br %live @body @no
    @body
        %z = call cs_z %ws %i
        %s = load %z CompWin.z
        %hit = cmp eq %s %me
        br %hit @yes @next
    @next
        %i2 = add %i 1
        jmp @l %i2
    @yes
        ret 1
    @no
        ret 0
}
# Tên cửa sổ: 8 ký tự ASCII trong một qword (byte thấp = ký tự đầu), cách nhau 9 điểm, tại (214, 68) của surface.
# Dùng bảng font `data` (std/surface) nên không cần con trỏ font của Kernel.
# Khoảng lõm của hàng j (0..7, tính từ mép) ở góc bo bán kính 8 của cửa sổ (hàm chung của std/surface.lit)
func comp_inset8 bv64 %j:bv64 {
    @req ult %j 8
    @ens ule %r 8
    @b0
        %v = call surf_round_inset 8 %j
        ret %v
}

func cs_title void %s:ptr<VgaCell,1382400> %title:bv64 %fg:bv32 %ww:bv64 {
    @req ule %ww 1074
    @b0
        # độ dài bỏ khoảng trắng / 0 ở cuối
        jmp @n 0 0
    @n %i:bv64 %len:bv64
        @inv ule %i 8
        @inv ule %len %i
        %more = cmp ult %i 8
        br %more @nb @start
    @nb
        %sh = shl %i 3
        %b = lshr %title %sh
        %c = and %b 0xff
        %i1 = add %i 1
        %sp = cmp ule %c 32
        br %sp @nskip @nset
    @nskip
        jmp @n %i1 %len
    @nset
        jmp @n %i1 %i1
    @start
        # căn giữa thanh tiêu đề: x = 200 + ww/2 - len*9/2
        %tw = mul %len 9
        %htw = lshr %tw 1
        %hw = lshr %ww 1
        %mid = add %hw 200
        %x0 = sub_sat %mid %htw
        jmp @l 0 %x0
    @l %j:bv64 %x:bv64
        @inv ule %j %len
        %go = cmp ult %j %len
        br %go @ch @done
    @ch
        %sh2 = shl %j 3
        %b2 = lshr %title %sh2
        %c2 = and %b2 0xff
        # chữ đầu hoa, còn lại thường (kiểu tiêu đề macOS)
        %first = cmp eq %j 0
        %up = cmp uge %c2 65
        %upz = cmp ule %c2 90
        %isup = and %up %upz
        %lowr = cmp eq %first 0
        %mk = and %isup %lowr
        br %mk @lower @put
    @lower
        %cl = add %c2 32
        jmp @draw %cl
    @put
        jmp @draw %c2
    @draw %cc:bv64
        call surf_char 1382400 %s 1920 1280 720 %x 68 %cc %fg
        %j1 = add %j 1
        %x1 = add_sat %x 9
        jmp @l %j1 %x1
    @done
        ret
}

# Đèn tín hiệu tròn đường kính 12 tại (x, 70) trên thanh tiêu đề
func cs_light void %s:ptr<VgaCell,1382400> %x:bv64 %c:bv32 {
    @req ule %x 1280
    @b0
        %xe = add %x 12
        call surf_round_rect 1382400 %s 1920 1280 720 %x 71 %xe 83 6 %c
        ret
}

# Khung cửa sổ do compositor vẽ (trang trí phía server) thẳng vào surface của slot, quanh cửa sổ (200,60) cỡ CompWin.w x h:
# viền, thanh tiêu đề sáng + tên căn giữa (IpcChannel.title), 3 đèn đỏ / vàng / xanh (đèn đỏ = đóng). Cửa sổ không focus:
# đèn xám, chữ nhạt (nền thanh giữ nguyên để phần App tự vẽ trên thanh, như dòng trạng thái Terminal, luôn khớp màu).
# Vẽ vào surface nên thứ tự chồng / cắt vùng do comp_draw_window lo như mọi điểm ảnh khác.
func cs_frame void %k:ptr<CompCtl,1> %ws:ptr<CompWin,7> %chs:ptr<IpcChannel,7> %sf:ptr<CompSlot,7> %slot:bv64 %active:bv64 {
    @req ult %slot 7
    @req uge %sf 0x10000
    @req ult %sf 0x40000000
    @b0
        %on = call cs_enabled %k
        %yes = cmp ne %on 0
        br %yes @go @done
    @go
        %s = call cs_surface %sf %slot
        %ch = call cs_chan %chs %slot
        %title = load %ch IpcChannel.title
        %w = call cs_win %ws %slot
        store %w CompWin.title %title
        %act = cmp ne %active 0
        br %act @hot @cold
    @hot
        jmp @draw 0xb4b4b8:bv32 0xe9e9eb:bv32 0x3a3a3c:bv32 0xff5f57:bv32 0xfebc2e:bv32 0x28c840:bv32
    @cold
        jmp @draw 0xc8c8cc:bv32 0xe9e9eb:bv32 0xa1a1a6:bv32 0xd0d0d3:bv32 0xd0d0d3:bv32 0xd0d0d3:bv32
    @draw %border:bv32 %bar:bv32 %text:bv32 %xbtn:bv32 %ybtn:bv32 %gbtn:bv32
        %ww = load %w CompWin.w
        %wh = load %w CompWin.h
        %r = add %ww 200                    # mép phải (không kể bóng)
        %bt = add %wh 60                    # mép dưới
        %rs = add %r 6
        %bs = add %bt 6
        # bóng đổ: compositor làm tối cảnh bên dưới lúc vẽ (comp_draw_window), không vẽ vào surface
        # viền 2 điểm
        %r2 = sub %r 2
        %bt2 = sub %bt 2
        call gfx_fill_rect %s 200 60 %r 62 %border
        call gfx_fill_rect %s 200 %bt2 %r %bt %border
        call gfx_fill_rect %s 200 62 202 %bt2 %border
        call gfx_fill_rect %s %r2 62 %r %bt2 %border
        # thanh tiêu đề sáng kiểu macOS + đường kẻ mảnh dưới + tên căn giữa
        call gfx_fill_rect %s 202 62 %r2 91 %bar
        call gfx_fill_rect %s 202 91 %r2 92 0xd4d4d6
        call cs_title %s %title %text %ww
        # 3 đèn tín hiệu: đóng (đỏ, bấm được) / thu nhỏ / phóng to
        call cs_light %s 212 %xbtn
        call cs_light %s 232 %ybtn
        call cs_light %s 252 %gbtn
        # cung viền ở 4 góc bo (bán kính 8): mỗi hàng góc tô 2 điểm viền ngay trong mép bo
        jmp @arc 2
    @arc %j:bv64
        @inv ule %j 8
        %am = cmp ult %j 8
        br %am @arc1 @fin
    @arc1
        %in = call comp_inset8 %j
        %ty = add %j 60
        %ty1 = add %ty 1
        %by = sub %bt %j
        %by0 = sub %by 1
        %lx0 = add %in 200
        %lx1 = add %lx0 2
        %rx1 = sub %r %in
        %rx0 = sub %rx1 2
        call gfx_fill_rect %s %lx0 %ty %lx1 %ty1 %border
        call gfx_fill_rect %s %rx0 %ty %rx1 %ty1 %border
        call gfx_fill_rect %s %lx0 %by0 %lx1 %by %border
        call gfx_fill_rect %s %rx0 %by0 %rx1 %by %border
        %j1 = add %j 1
        jmp @arc %j1
    @fin
        ret
    @done
        ret
}
# Gỡ slot khỏi cảnh (dồn các phần tử còn lại xuống, giữ thứ tự)
func cs_remove void %k:ptr<CompCtl,1> %ws:ptr<CompWin,7> %chs:ptr<IpcChannel,7> %sf:ptr<CompSlot,7> %slot:bv64 {
    @req ult %slot 7
    @req uge %sf 0x10000
    @req ult %sf 0x40000000
    @b0
        %me = add %slot 1
        %c = call cs_ctl %k
        %n = load %c CompCtl.count
        jmp @l 0 0
    @l %i:bv64 %j:bv64
        @inv ule %i 7
        @inv ule %j %i
        %more = cmp ult %i 7
        br %more @in @fin
    @in
        %live = cmp ult %i %n
        br %live @body @fin
    @body
        %zi = call cs_z %ws %i
        %s = load %zi CompWin.z
        %i2 = add %i 1
        %drop = cmp eq %s %me
        br %drop @skip @keep
    @skip
        jmp @l %i2 %j
    @keep
        %zj = call cs_z %ws %j
        store %zj CompWin.z %s
        %j2 = add %j 1
        jmp @l %i2 %j2
    @fin
        store %c CompCtl.count %j
        jmp @clr %j
    @clr %q:bv64
        @inv ule %q 7
        %km = cmp ult %q 7
        br %km @clr1 @done
    @clr1
        %zk = call cs_z %ws %q
        store %zk CompWin.z 0
        %k2 = add %q 1
        jmp @clr %k2
    @done
        %d = load %c CompCtl.drag
        %dragging = cmp eq %d %me
        br %dragging @nodrag @ret
    @nodrag
        store %c CompCtl.drag 0
        ret
    @ret
        ret
}
# Đưa slot lên trên cùng. Cửa sổ MỚI mở được đặt lệch (+40, +16) so với cửa sổ đang trên cùng (xếp tầng).
func cs_raise void %k:ptr<CompCtl,1> %ws:ptr<CompWin,7> %chs:ptr<IpcChannel,7> %sf:ptr<CompSlot,7> %slot:bv64 {
    @req ult %slot 7
    @req uge %sf 0x10000
    @req ult %sf 0x40000000
    @b0
        %was = call cs_has %k %ws %chs %sf %slot
        %top = call cs_top %k %ws %chs %sf
        %fresh = cmp eq %was 0
        br %fresh @place @move
    @place
        %w = call cs_win %ws %slot
        %hastop = cmp ne %top 0
        br %hastop @cascade @dflt
    @cascade
        %ts = sub %top 1
        %tw = call cs_win %ws %ts
        %tx = load %tw CompWin.x
        %ty = load %tw CompWin.y
        %nx = add %tx 40
        %ny = add %ty 16
        %mw = load %w CompWin.w
        %mh = load %w CompWin.h
        %xmax = sub 1274 %mw                    # x + w + 6 <= 1280
        %ymax = sub 714 %mh                     # y + h + 6 <= 720: cửa sổ mới nằm trọn trong khung nhìn
        %cx0 = call std_min %nx %xmax
        %cx = call std_min %cx0 WIN_MAX_X
        %cy0 = call std_min %ny %ymax
        %cy = call std_min %cy0 WIN_MAX_Y
        store %w CompWin.x %cx
        store %w CompWin.y %cy
        jmp @move
    @dflt
        store %w CompWin.x WIN_X0
        store %w CompWin.y WIN_Y0
        jmp @move
    @move
        call cs_remove %k %ws %chs %sf %slot
        %c = call cs_ctl %k
        %n = load %c CompCtl.count
        %room = cmp ult %n 7
        br %room @push @done
    @push
        %z = call cs_z %ws %n
        %me = add %slot 1
        store %z CompWin.z %me
        %n2 = add %n 1
        store %c CompCtl.count %n2
        ret
    @done
        ret
}
# Chép %span điểm từ src[so..] sang dst[do..]; bỏ qua nếu ra ngoài (kiểm lúc chạy, không cần chứng minh hình học)
func comp_row void %src:ptr<VgaCell,1382400> %dst:ptr<VgaCell,1382400> %so:bv64 %do:bv64 %span:bv64 {
    @b0
        %a = cmp ule %so 1382400
        %b = cmp ule %do 1382400
        %c = cmp ule %span 1382400
        %ab = and %a %b
        %abc = and %ab %c
        %ok = cmp ne %abc 0
        br %ok @chk @done
    @chk
        %se = add %so %span
        %de = add %do %span
        %s1 = cmp ule %se 1382400
        %d1 = cmp ule %de 1382400
        %sd = and %s1 %d1
        %fits = cmp ne %sd 0
        br %fits @copy @done
    @copy
        %s = slice %src %so ptr<VgaCell,%span>
        %d = slice %dst %do ptr<VgaCell,%span>
        call comp_copy_row %span %d %s
        ret
    @done
        ret
}
# Chép đoạn [xs, xe) của hàng y khung nhìn (cắt theo [cx1, cx2)) từ surface cửa sổ đặt tại (wx, wy)
func comp_seg void %surf:ptr<VgaCell,1382400> %view:ptr<VgaCell,1382400> %wx:bv64 %wy:bv64 %y:bv64 %xs:bv64 %xe:bv64 %cx1:bv64 %cx2:bv64 {
    @req ule %wx 974
    @req ule %wy %y
    @req ule %y 720
    @b0
        %a = call std_max %xs %cx1
        %b = call std_min %xe %cx2
        %ok = cmp ult %a %b
        br %ok @go @done
    @go
        %ok2 = cmp uge %a %wx
        br %ok2 @copy @done
    @copy
        %ux = sub %a %wx
        %sx = add_sat %ux WIN_X0
        %vy = sub %y %wy
        %sy = add %vy WIN_Y0
        %srow = mul_sat %sy 1920
        %so = add_sat %srow %sx
        %drow = mul %y 1920
        %do = add_sat %drow %a
        %span = sub %b %a
        call comp_row %surf %view %so %do %span
        ret
    @done
        ret
}

# Làm tối đoạn [xs, xe) của hàng y khung nhìn (cắt theo [cx1, cx2)): p - (p >> sh) mỗi kênh màu (sh 2: 25%, 3: 12%, 4: 6%)
func comp_shade void %view:ptr<VgaCell,1382400> %y:bv64 %xs:bv64 %xe:bv64 %cx1:bv64 %cx2:bv64 %sh:bv64 {
    @req ule %y 720
    @req uge %sh 2
    @req ule %sh 4
    @b0
        %a = call std_max %xs %cx1
        %b0 = call std_min %xe %cx2
        %b = call std_min %b0 1280
        %ok = cmp ult %a %b
        br %ok @go @done
    @go
        %row = mul %y 1920
        %o0 = add %row %a
        %span = sub %b %a
        %end = add %o0 %span
        %fits = cmp ule %end 1382400
        br %fits @mask @done
    @mask
        %m2 = cmp eq %sh 2
        br %m2 @k2 @n3
    @n3
        %m3 = cmp eq %sh 3
        br %m3 @k3 @k4
    @k2
        jmp @px 0x3f3f3f:bv32 2:bv32
    @k3
        jmp @px 0x1f1f1f:bv32 3:bv32
    @k4
        jmp @px 0x0f0f0f:bv32 4:bv32
    @px %mk:bv32 %sh32:bv32
        @inv ule %sh32 4
        %seg = slice %view %o0 ptr<VgaCell,%span>
        jmp @l 0
    @l %i:bv64
        @inv ule %i %span
        @inv ule %sh32 4
        %more = cmp ult %i %span
        br %more @one @done
    @one
        %cell = slice %seg %i ptr<VgaCell,1>
        %p = load %cell 0 bv32
        %q = lshr %p %sh32
        %d = and %q %mk
        %n64 = sub %p %d
        %n = narrow %n64 bv32
        store %cell 0 %n
        %i1 = add %i 1
        jmp @l %i1
    @done
        ret
}

# Vẽ cửa sổ của surface %surf đặt tại (wx, wy), phủ ew x eh (kể 6 điểm bóng đổ), vào khung nhìn %view, chỉ trong
# [x1,x2) x [y1,y2) (cắt thêm theo khung nhìn 1280 x 720).
# 4 góc bo tròn (bán kính 8): điểm ngoài góc KHÔNG vẽ -> lộ cảnh bên dưới. %shade = 1 (chỉ khi vẽ lại cảnh từ nền):
# bóng mềm phải + dưới (lệch 4 điểm) = làm tối cảnh bên dưới 3 mức; vẽ vùng bẩn của App (shade = 0) không đụng bóng
# để không làm tối dồn nhiều lần.
func comp_draw_window void %surf:ptr<VgaCell,1382400> %view:ptr<VgaCell,1382400> %wx:bv64 %wy:bv64 %ew:bv64 %eh:bv64 %x1:bv64 %y1:bv64 %x2:bv64 %y2:bv64 %shade:bv64 {
    @req ule %wx 974
    @req ule %wy 590
    @req ule %ew 1080
    @req ule %eh 564
    @req uge %ew 6
    @req uge %eh 6
    @b0
        %wxe = add %wx %ew
        %wye = add %wy %eh
        %w = sub %ew 6
        %h = sub %eh 6
        %bx = add %wx %w                    # mép phải thân cửa sổ
        %xa0 = call std_max %x1 %wx
        %ya0 = call std_max %y1 %wy
        %xb0 = call std_min %x2 %wxe
        %yb0 = call std_min %y2 %wye
        %xb = call std_min %xb0 VIEW_W
        %yb = call std_min %yb0 VIEW_H
        %okx = cmp ult %xa0 %xb
        br %okx @chky @done
    @chky
        %oky = cmp ult %ya0 %yb
        br %oky @start @done
    @start
        jmp @l %ya0
    @l %y:bv64
        @inv ule %y %yb
        @inv ule %wy %y
        %more = cmp ult %y %yb
        br %more @row @done
    @row
        %ry = sub %y %wy
        %body = cmp ult %ry %h
        br %body @brow @srow
    @brow
        # góc trên (ry < 8) / góc dưới (h - 1 - ry < 8)
        %top = cmp ult %ry 8
        br %top @ctop @cbot
    @ctop
        %it = call comp_inset8 %ry
        jmp @copy %it
    @cbot
        %hl = sub %h 1
        %fb = sub %hl %ry
        %nb = cmp ult %fb 8
        br %nb @cbot2 @flat
    @cbot2
        %ib = call comp_inset8 %fb
        jmp @copy %ib
    @flat
        jmp @copy 0
    @copy %in:bv64
        @inv ule %in 8
        %cs = add %wx %in
        %ce = sub_sat %bx %in
        call comp_seg %surf %view %wx %wy %y %cs %ce %xa0 %xb
        %sh = cmp ne %shade 0
        %low = cmp uge %ry 4
        %rs = and %sh %low
        br %rs @rshadow @next
    @rshadow
        # bóng phải: 3 dải 2 điểm, nhạt dần
        %r1 = add %bx 2
        %r2 = add %bx 4
        %r3 = add %bx 6
        call comp_shade %view %y %bx %r1 %xa0 %xb 2
        call comp_shade %view %y %r1 %r2 %xa0 %xb 3
        call comp_shade %view %y %r2 %r3 %xa0 %xb 4
        jmp @next
    @srow
        %sh2 = cmp ne %shade 0
        br %sh2 @bshadow @next
    @bshadow
        # bóng dưới: hàng cách đáy d = ry - h (0..5) -> mức 2 + d/2; góc phải-dưới lấy mức nhạt hơn
        %dd = sub %ry %h
        %dh = lshr %dd 1
        %lv0 = add %dh 2
        %lv = call std_min %lv0 4
        %bs = add %wx 4
        call comp_shade %view %y %bs %bx %xa0 %xb %lv
        %q1 = add %bx 2
        %q2 = add %bx 4
        %q3 = add %bx 6
        %l3 = call std_max %lv 3
        call comp_shade %view %y %bx %q1 %xa0 %xb %lv
        call comp_shade %view %y %q1 %q2 %xa0 %xb %l3
        call comp_shade %view %y %q2 %q3 %xa0 %xb 4
        jmp @next
    @next
        %yn = add %y 1
        jmp @l %yn
    @done
        ret
}
# Vẽ lại cảnh trong [x1,x2) x [y1,y2) của khung nhìn: nền, rồi mọi cửa sổ từ dưới lên; báo vùng bẩn cho WM.
# Compositor tắt: chỉ xóa vùng cửa sổ cố định như trước.
func cs_repaint void %k:ptr<CompCtl,1> %ws:ptr<CompWin,7> %chs:ptr<IpcChannel,7> %sf:ptr<CompSlot,7> %view:ptr<VgaCell,1382400> %g:ptr<IpcChannel,1> %x1:bv64 %y1:bv64 %x2:bv64 %y2:bv64 {
    @req uge %view 0x10000
    @req ult %view 0x80000000
    @req uge %g 0x10000
    @req ult %g 0x80000000
    @req uge %sf 0x10000
    @req ult %sf 0x40000000
    @b0
        %on = call cs_enabled %k
        %yes = cmp ne %on 0
        br %yes @clip @legacy
    @legacy
        call gfx_fill_rect %view COMP_X1 COMP_Y1 COMP_X2 COMP_Y2 COMP_BG
        call ui_invalidate_rect %g COMP_X1 COMP_Y1 COMP_X2 COMP_Y2
        ret
    @clip
        %xa = call std_min %x1 VIEW_W
        %ya = call std_min %y1 VIEW_H
        %xb = call std_min %x2 VIEW_W
        %yb = call std_min %y2 VIEW_H
        %okx = cmp ult %xa %xb
        br %okx @chky @done
    @chky
        %oky = cmp ult %ya %yb
        br %oky @bg @done
    @bg
        call gfx_fill_rect %view %xa %ya %xb %yb COMP_BG
        %c = call cs_ctl %k
        %n = load %c CompCtl.count
        jmp @l 0
    @l %i:bv64
        @inv ule %i 7
        %more = cmp ult %i 7
        br %more @in @inval
    @in
        %live = cmp ult %i %n
        br %live @body @inval
    @body
        %z = call cs_z %ws %i
        %s = load %z CompWin.z
        %i2 = add %i 1
        %valid = cmp ne %s 0
        br %valid @draw @skip
    @draw
        %slot = sub %s 1
        %w = call cs_win %ws %slot
        %wx = load %w CompWin.x
        %wy = load %w CompWin.y
        %ww = load %w CompWin.w
        %wh = load %w CompWin.h
        %ew = add %ww 6
        %eh = add %wh 6
        %surf = call cs_surface %sf %slot
        call comp_draw_window %surf %view %wx %wy %ew %eh %xa %ya %xb %yb 1
        jmp @l %i2
    @skip
        jmp @l %i2
    @inval
        call ui_invalidate_rect %g %xa %ya %xb %yb
        ret
    @done
        ret
}
# Vẽ lại toàn bộ khung nhìn (trên Dock)
func cs_repaint_all void %k:ptr<CompCtl,1> %ws:ptr<CompWin,7> %chs:ptr<IpcChannel,7> %sf:ptr<CompSlot,7> %view:ptr<VgaCell,1382400> %g:ptr<IpcChannel,1> {
    @req uge %view 0x10000
    @req ult %view 0x80000000
    @req uge %g 0x10000
    @req ult %g 0x80000000
    @req uge %sf 0x10000
    @req ult %sf 0x40000000
    @b0
        call cs_repaint %k %ws %chs %sf %view %g 0 0 VIEW_W VIEW_H
        ret
}
# Focus đổi từ cửa sổ %old sang %new (slot+1, 0 = không có): vẽ lại khung của hai cửa sổ theo màu tương ứng
func cs_refocus void %k:ptr<CompCtl,1> %ws:ptr<CompWin,7> %chs:ptr<IpcChannel,7> %sf:ptr<CompSlot,7> %old:bv64 %new:bv64 {
    @req ult %old 8
    @req ult %new 8
    @req uge %sf 0x10000
    @req ult %sf 0x40000000
    @b0
        %hasold = cmp ne %old 0
        %diff = cmp ne %old %new
        %both = and %hasold %diff
        %dim = cmp ne %both 0
        br %dim @off @on0
    @off
        %os = sub %old 1
        call cs_frame %k %ws %chs %sf %os 0
        jmp @on0
    @on0
        %hasnew = cmp ne %new 0
        br %hasnew @on @done
    @on
        %ns = sub %new 1
        call cs_frame %k %ws %chs %sf %ns 1
        ret
    @done
        ret
}
# Dock chọn App slot: đưa cửa sổ lên trên (mở nếu chưa có) và vẽ lại cảnh. Đã ở trên cùng -> không làm gì.
func cs_focus void %k:ptr<CompCtl,1> %ws:ptr<CompWin,7> %chs:ptr<IpcChannel,7> %sf:ptr<CompSlot,7> %view:ptr<VgaCell,1382400> %g:ptr<IpcChannel,1> %slot:bv64 {
    @req uge %view 0x10000
    @req ult %view 0x80000000
    @req uge %g 0x10000
    @req ult %g 0x80000000
    @req ult %slot 7
    @req uge %sf 0x10000
    @req ult %sf 0x40000000
    @b0
        %top = call cs_top %k %ws %chs %sf
        %me = add %slot 1
        %same = cmp eq %top %me
        br %same @done @raise
    @raise
        call cs_raise %k %ws %chs %sf %slot
        call cs_refocus %k %ws %chs %sf %top %me
        call cs_repaint_all %k %ws %chs %sf %view %g
        ret
    @done
        ret
}
# App slot vừa đóng: gỡ khỏi cảnh, cửa sổ kế tiếp lên foreground (phải vẽ lại khung: xóa win_drawn của nó).
# Compositor tắt: cảnh chỉ có một cửa sổ hiện -> về desktop như trước.
func cs_close void %k:ptr<CompCtl,1> %ws:ptr<CompWin,7> %chs:ptr<IpcChannel,7> %sf:ptr<CompSlot,7> %view:ptr<VgaCell,1382400> %g:ptr<IpcChannel,1> %slot:bv64 {
    @req uge %view 0x10000
    @req ult %view 0x80000000
    @req uge %g 0x10000
    @req ult %g 0x80000000
    @req ult %slot 7
    @req uge %sf 0x10000
    @req ult %sf 0x40000000
    @b0
        call cs_remove %k %ws %chs %sf %slot
        # mở lại -> kích thước mặc định cho tới khi App báo kích thước
        %cw = call cs_win %ws %slot
        store %cw CompWin.w WIN_W
        store %cw CompWin.h WIN_H
        %on = call cs_enabled %k
        %yes = cmp ne %on 0
        br %yes @next @legacy
    @legacy
        call cs_scene_init %k %ws %chs %sf
        store %g IpcChannel.active_app 0
        call cs_repaint_all %k %ws %chs %sf %view %g
        ret
    @next
        %top = call cs_top %k %ws %chs %sf
        call cs_refocus %k %ws %chs %sf 0 %top
        store %g IpcChannel.active_app %top
        %has = cmp ne %top 0
        br %has @redraw @paint
    @redraw
        %ts = sub %top 1
        %ch = call cs_chan %chs %ts
        store %ch IpcChannel.win_drawn 0
        jmp @paint
    @paint
        call cs_repaint_all %k %ws %chs %sf %view %g
        ret
}
# Chuột cho App slot: tọa độ màn hình -> tọa độ surface của App (cửa sổ App ở (200,60) trong surface)
func cs_mouse_in void %k:ptr<CompCtl,1> %ws:ptr<CompWin,7> %chs:ptr<IpcChannel,7> %sf:ptr<CompSlot,7> %g:ptr<IpcChannel,1> %c:ptr<IpcChannel,1> %slot:bv64 {
    @req ult %slot 7
    @req uge %sf 0x10000
    @req ult %sf 0x40000000
    @b0
        %w = call cs_win %ws %slot
        %wx = load %w CompWin.x
        %wy = load %w CompWin.y
        %sx = load %g IpcChannel.scr_x
        %sy = load %g IpcChannel.scr_y
        # mx = sx - 320 - wx + 200, kẹp [0, 1259]
        %ox = add %wx VIEW_SX
        %ax = add %sx WIN_X0
        %bx = call std_max %ax %ox
        %mx0 = sub %bx %ox
        %mx = call std_min %mx0 1259
        store %c IpcChannel.mouse_x %mx
        %oy = add %wy VIEW_SY
        %ay = add %sy WIN_Y0
        %by = call std_max %ay %oy
        %my0 = sub %by %oy
        %my = call std_min %my0 699
        store %c IpcChannel.mouse_y %my
        ret
}
# Sau khi App foreground chạy: vùng bẩn của nó (tọa độ surface) -> vẽ cửa sổ tại (wx, wy) trong vùng tương ứng
# của khung nhìn, báo vùng bẩn đã quy đổi cho WM, xóa cờ bẩn của kênh App (app_sync_out không gộp lần nữa).
func cs_present void %k:ptr<CompCtl,1> %ws:ptr<CompWin,7> %chs:ptr<IpcChannel,7> %sf:ptr<CompSlot,7> %fb:ptr<VgaCell,1382400> %g:ptr<IpcChannel,1> %c:ptr<IpcChannel,1> %slot:bv64 {
    @req uge %fb 0x10000
    @req ult %fb 0x80000000
    @req uge %g 0x10000
    @req ult %g 0x80000000
    @req ult %slot 7
    @req uge %sf 0x10000
    @req ult %sf 0x40000000
    @b0
        # App vừa chạy -> đề nghị kích thước (nếu có) đã được giao
        store %c IpcChannel.configure 0
        %on = call cs_enabled %k
        %yes = cmp ne %on 0
        br %yes @fg @done
    @fg
        %act = load %g IpcChannel.active_app
        %me = add %slot 1
        %isfg = cmp eq %act %me
        br %isfg @dirty @done
    @dirty
        # Kích thước App ĐÃ vẽ (do App quyết, kiểu Wayland): hợp lệ và khác -> nhận, vẽ khung mới, vẽ lại hợp hai vùng
        %wt = call cs_win %ws %slot
        %rw = load %c IpcChannel.win_w
        %rh = load %c IpcChannel.win_h
        %cw = load %wt CompWin.w
        %chh = load %wt CompWin.h
        %v1 = cmp uge %rw WIN_MIN_W
        %v2 = cmp uge %rh WIN_MIN_H
        %vv = and %v1 %v2
        %d1 = cmp ne %rw %cw
        %d2 = cmp ne %rh %chh
        %dd = or %d1 %d2
        %vd = and %vv %dd
        %resize = cmp ne %vd 0
        br %resize @adopt @title
    @adopt
        %ox = load %wt CompWin.x
        %oy = load %wt CompWin.y
        # giữ x + w + 6 <= 1280: dời sang trái nếu cần
        %xlim = sub 1274 %rw
        %nx0 = call std_min %ox %xlim
        %nx = call std_min %nx0 WIN_MAX_X
        store %wt CompWin.x %nx
        store %wt CompWin.w %rw
        store %wt CompWin.h %rh
        call cs_frame %k %ws %chs %sf %slot 1
        store %c IpcChannel.dirty 0
        %oxe = add %ox %cw
        %nxe = add %nx %rw
        %uxe0 = call std_max %oxe %nxe
        %uxe = add %uxe0 6
        %mh = call std_max %chh %rh
        %uye0 = add %oy %mh
        %uye = add %uye0 6
        call cs_repaint %k %ws %chs %sf %fb %g %nx %oy %uxe %uye
        ret
    @title
        # App vừa đặt/đổi tên cửa sổ -> vẽ lại khung (đang focus) và đưa cả cửa sổ ra màn hình
        %nt = load %c IpcChannel.title
        %ot = load %wt CompWin.title
        %retitle = cmp ne %nt %ot
        br %retitle @reframe @chkd
    @reframe
        call cs_frame %k %ws %chs %sf %slot 1
        store %c IpcChannel.dirty 0
        %fx = add %cw 206
        %fy = add %chh 66
        jmp @blit 200 60 %fx %fy
    @chkd
        %d = load %c IpcChannel.dirty
        %has = cmp ne %d 0
        br %has @rect @done
    @rect
        store %c IpcChannel.dirty 0
        %rx1 = load %c IpcChannel.dirty_x1
        %ry1 = load %c IpcChannel.dirty_y1
        %rx2 = load %c IpcChannel.dirty_x2
        %ry2 = load %c IpcChannel.dirty_y2
        jmp @blit %rx1 %ry1 %rx2 %ry2
    @blit %x1:bv64 %y1:bv64 %x2:bv64 %y2:bv64
        @inv ule %x1 1280
        @inv ule %y1 720
        @inv ule %x2 1280
        @inv ule %y2 720
        %w = call cs_win %ws %slot
        %wx = load %w CompWin.x
        %wy = load %w CompWin.y
        # surface -> khung nhìn: x' = max(x, 200) - 200 + wx (tương tự y)
        %ax1 = call std_max %x1 WIN_X0
        %ux1 = sub %ax1 WIN_X0
        %dx1 = add %ux1 %wx
        %ax2 = call std_max %x2 WIN_X0
        %ux2 = sub %ax2 WIN_X0
        %dx2 = add %ux2 %wx
        %ay1 = call std_max %y1 WIN_Y0
        %uy1 = sub %ay1 WIN_Y0
        %dy1 = add %uy1 %wy
        %ay2 = call std_max %y2 WIN_Y0
        %uy2 = sub %ay2 WIN_Y0
        %dy2 = add %uy2 %wy
        %pw = load %w CompWin.w
        %ph = load %w CompWin.h
        %pew = add %pw 6
        %peh = add %ph 6
        %s = call cs_surface %sf %slot
        call comp_draw_window %s %fb %wx %wy %pew %peh %dx1 %dy1 %dx2 %dy2 0
        %cx1 = call std_min %dx1 VIEW_W
        %cy1 = call std_min %dy1 VIEW_H
        %cx2 = call std_min %dx2 VIEW_W
        %cy2 = call std_min %dy2 VIEW_H
        call ui_invalidate_rect %g %cx1 %cy1 %cx2 %cy2
        ret
    @done
        ret
}
# Nhấn chuột (không phải Dock): trúng cửa sổ dưới -> đưa lên trên; trúng thanh tiêu đề cửa sổ trên cùng (trừ nút
# đèn đỏ) -> bắt đầu kéo; trúng đèn đỏ (WIN_XBTN điểm đầu thanh) -> trả 2 (WM đóng App trên cùng). Trả 1 nếu compositor đã dùng cú nhấn (App
# không nhận), 0 để chuyển cho App trên cùng.
func cs_click bv64 %k:ptr<CompCtl,1> %ws:ptr<CompWin,7> %chs:ptr<IpcChannel,7> %sf:ptr<CompSlot,7> %view:ptr<VgaCell,1382400> %g:ptr<IpcChannel,1> {
    @req uge %view 0x10000
    @req ult %view 0x80000000
    @req uge %g 0x10000
    @req ult %g 0x80000000
    @ens ule %r 2
    @req uge %sf 0x10000
    @req ult %sf 0x40000000
    @b0
        %on = call cs_enabled %k
        %yes = cmp ne %on 0
        br %yes @pos @pass
    @pos
        %sx = load %g IpcChannel.scr_x
        %sy = load %g IpcChannel.scr_y
        %inx = cmp uge %sx VIEW_SX
        %iny = cmp uge %sy VIEW_SY
        %inv = and %inx %iny
        %inview = cmp ne %inv 0
        br %inview @scan0 @pass
    @scan0
        %vx = sub %sx VIEW_SX
        %vy = sub %sy VIEW_SY
        %c = call cs_ctl %k
        %n = load %c CompCtl.count
        jmp @l %n
    # duyệt từ trên xuống: k = n .. 1, phần tử k-1
    @l %q:bv64
        @inv ule %q 7
        %more = cmp ne %q 0
        br %more @body @pass
    @body
        %i = sub %q 1
        %z = call cs_z %ws %i
        %s = load %z CompWin.z
        %valid = cmp ne %s 0
        br %valid @hit @next
    @hit
        %slot = sub %s 1
        %w = call cs_win %ws %slot
        %wx = load %w CompWin.x
        %wy = load %w CompWin.y
        %hw = load %w CompWin.w
        %hh0 = load %w CompWin.h
        %wxe = add %wx %hw
        %wye = add %wy %hh0
        %h1 = cmp uge %vx %wx
        %h2 = cmp ult %vx %wxe
        %h3 = cmp uge %vy %wy
        %h4 = cmp ult %vy %wye
        %h12 = and %h1 %h2
        %h34 = and %h3 %h4
        %hh = and %h12 %h34
        %inside = cmp ne %hh 0
        br %inside @which @next
    @next
        jmp @l %i
    @which
        %istop = cmp eq %q %n
        br %istop @title @raise
    @raise
        %oldtop = call cs_top %k %ws %chs %sf
        call cs_raise %k %ws %chs %sf %slot
        call cs_refocus %k %ws %chs %sf %oldtop %s
        store %g IpcChannel.active_app %s
        %ch = call cs_chan %chs %slot
        store %ch IpcChannel.win_drawn 0
        call cs_repaint_all %k %ws %chs %sf %view %g
        store %g IpcChannel.click 0
        ret 1
    @title
        %u = sub %vx %wx
        %v = sub %vy %wy
        # góc dưới-phải 16x16 -> đổi kích thước
        %gxl = sub_sat %hw WIN_GRIP
        %gyl = sub_sat %hh0 WIN_GRIP
        %g1 = cmp uge %u %gxl
        %g2 = cmp uge %v %gyl
        %g12 = and %g1 %g2
        %ongrip = cmp ne %g12 0
        br %ongrip @grip @title2
    @grip
        store %c CompCtl.drag %s
        store %c CompCtl.mode 1
        store %g IpcChannel.click 0
        ret 1
    @title2
        %t1 = cmp ult %v WIN_TITLE_H
        %t2 = cmp uge %u WIN_XBTN
        %t12 = and %t1 %t2
        %ontitle = cmp ne %t12 0
        br %ontitle @grab @xbtn
    @xbtn
        # Nút đóng do compositor vẽ (đèn đỏ, 28 điểm đầu thanh tiêu đề) -> trả 2 (WM đóng App trên cùng)
        %onx = cmp ult %v WIN_TITLE_H
        br %onx @close @pass
    @close
        store %g IpcChannel.click 0
        ret 2
    @grab
        store %c CompCtl.drag %s
        store %c CompCtl.mode 0
        store %c CompCtl.gx %u
        store %c CompCtl.gy %v
        store %g IpcChannel.click 0
        ret 1
    @pass
        ret 0
}
# Mỗi nhịp WM: đang kéo và còn giữ nút trái -> dời cửa sổ theo chuột, vẽ lại vùng cũ và vùng mới
func cs_drag_tick void %k:ptr<CompCtl,1> %ws:ptr<CompWin,7> %chs:ptr<IpcChannel,7> %sf:ptr<CompSlot,7> %view:ptr<VgaCell,1382400> %g:ptr<IpcChannel,1> {
    @req uge %view 0x10000
    @req ult %view 0x80000000
    @req uge %g 0x10000
    @req ult %g 0x80000000
    @req uge %sf 0x10000
    @req ult %sf 0x40000000
    @b0
        %c = call cs_ctl %k
        %d = load %c CompCtl.drag
        %dragging = cmp ne %d 0
        br %dragging @btn @done
    @btn
        %b = load %g IpcChannel.mouse_btn
        %left = and %b 1
        %held = cmp ne %left 0
        br %held @move @stop
    @stop
        store %c CompCtl.drag 0
        ret
    @move
        %slot = sub %d 1
        %w = call cs_win %ws %slot
        %wx = load %w CompWin.x
        %wy = load %w CompWin.y
        %ww = load %w CompWin.w
        %wh = load %w CompWin.h
        %mode = load %c CompCtl.mode
        %rs = cmp ne %mode 0
        br %rs @resize @pos
    @resize
        # đề nghị kích thước = chuột - góc trên-trái, kẹp [300, 1274-x] x [150, min(558, 714-y)]; App quyết định có nhận không
        %rsx = load %g IpcChannel.scr_x
        %rsy = load %g IpcChannel.scr_y
        %rox = add %wx VIEW_SX
        %rbx = call std_max %rsx %rox
        %pw0 = sub %rbx %rox
        %pwmax = sub 1274 %wx
        %pw2 = call std_min %pw0 %pwmax
        %pw1 = call std_min %pw2 WIN_MAX_W
        %pw = call std_max %pw1 WIN_MIN_W
        %roy = add %wy VIEW_SY
        %rby = call std_max %rsy %roy
        %ph0 = sub %rby %roy
        %ph2 = call std_min %ph0 WIN_MAX_H
        %phmax = sub 714 %wy                    # y + h + 6 <= 720: phóng to không tràn mép dưới khung nhìn
        %ph1 = call std_min %ph2 %phmax
        %ph = call std_max %ph1 WIN_MIN_H
        %ch = call cs_chan %chs %slot
        %qw = load %ch IpcChannel.cfg_w
        %qh = load %ch IpcChannel.cfg_h
        %e1 = cmp eq %qw %pw
        %e2 = cmp eq %qh %ph
        %ee = and %e1 %e2
        %same0 = cmp ne %ee 0
        br %same0 @done @propose
    @propose
        store %ch IpcChannel.cfg_w %pw
        store %ch IpcChannel.cfg_h %ph
        store %ch IpcChannel.configure 1
        ret
    @pos
        %gx = load %c CompCtl.gx
        %gy = load %c CompCtl.gy
        %sx = load %g IpcChannel.scr_x
        %sy = load %g IpcChannel.scr_y
        # vị trí mới = (chuột trên khung nhìn - chỗ nắm), kẹp trong [0, 1274-w] x [0, 714-h]: cả cửa sổ + bóng luôn
        # nằm trong khung nhìn (kéo xuống quá thì dừng ở mép, không bị cắt ngang)
        %ox = add %gx VIEW_SX
        %bx = call std_max %sx %ox
        %nx0 = sub %bx %ox
        %xmax = sub 1274 %ww
        %nx1 = call std_min %nx0 %xmax
        %nx = call std_min %nx1 WIN_MAX_X
        %oy = add %gy VIEW_SY
        %by = call std_max %sy %oy
        %ny0 = sub %by %oy
        %ymax = sub 714 %wh
        %ny1 = call std_min %ny0 %ymax
        %ny = call std_min %ny1 WIN_MAX_Y
        %sx_ = cmp eq %nx %wx
        %sy_ = cmp eq %ny %wy
        %same = and %sx_ %sy_
        %still = cmp ne %same 0
        br %still @done @apply
    @apply
        store %w CompWin.x %nx
        store %w CompWin.y %ny
        %ew = add %ww 6
        %eh = add %wh 6
        %oxe = add %wx %ew
        %oye = add %wy %eh
        call cs_repaint %k %ws %chs %sf %view %g %wx %wy %oxe %oye
        %nxe = add %nx %ew
        %nye = add %ny %eh
        call cs_repaint %k %ws %chs %sf %view %g %nx %ny %nxe %nye
        ret
    @done
        ret
}
# 1 nếu App trên cùng có đề nghị kích thước chưa nhận (WM phải gọi nó dù không có phím / chuột)
func cs_wants_run bv64 %k:ptr<CompCtl,1> %ws:ptr<CompWin,7> %chs:ptr<IpcChannel,7> %sf:ptr<CompSlot,7> %g:ptr<IpcChannel,1> {
    @ens ule %r 1
    @req uge %sf 0x10000
    @req ult %sf 0x40000000
    @b0
        %act = load %g IpcChannel.active_app
        %has = cmp ne %act 0
        br %has @chk @no
    @chk
        %slot = sub %act 1
        %ok = cmp ult %slot 7
        br %ok @get @no
    @get
        %ch = call cs_chan %chs %slot
        %cf = load %ch IpcChannel.configure
        ret %cf
    @no
        ret 0
}

# =============================================================================
# CẦU NỐI KERNEL (lát 5 — tách quyền): CHỈ các hàm dưới đây giữ thẻ io<0,0xffff>. Chúng tạo con trỏ tới bảng cảnh,
# kênh App và surface rồi gọi phần compositor thuần (cs_*), vốn KHÔNG giữ io: verifier cấm cs_* tạo con trỏ bằng const,
# dùng hwio hay gọi hàm cần io -> compositor chỉ chạm được đúng bộ nhớ được trao (bảng cảnh, kênh, surface, Backbuffer,
# kênh toàn cục), không chạm được phần cứng, bảng trang hay RAM của App.
# =============================================================================

func comp_ctl ptr<CompCtl,1> %io:io<0,0xffff> {
    @b0
        %c = const 0x79c00 ptr<CompCtl,1>
        ret %c
}

func comp_ws ptr<CompWin,7> %io:io<0,0xffff> {
    @b0
        %w = const 0x79c80 ptr<CompWin,7>
        ret %w
}

func comp_chs ptr<IpcChannel,7> %io:io<0,0xffff> {
    @b0
        %c = const 0x79200 ptr<IpcChannel,7>
        ret %c
}

func comp_sf ptr<CompSlot,7> %io:io<0,0xffff> {
    @ens uge %r 0x10000
    @ens ult %r 0x40000000
    @b0
        %s = const 0x12000000 ptr<CompSlot,7>
        ret %s
}

func comp_enabled bv64 %io:io<0,0xffff> {
    @ens ule %r 1
    @b0
        %k = call comp_ctl %io
        %e = call cs_enabled %k
        ret %e
}

func comp_target ptr<VgaCell,1382400> %io:io<0,0xffff> %fb:ptr<VgaCell,1382400> %slot:bv64 {
    @req uge %fb 0x10000
    @req ult %fb 0x80000000
    @req ult %slot 7
    @ens uge %r 0x10000
    @ens ult %r 0x80000000
    @b0
        %k = call comp_ctl %io
        %ws = call comp_ws %io
        %chs = call comp_chs %io
        %sf = call comp_sf %io
        %res = call cs_target %k %ws %chs %sf %fb %slot
        ret %res
}

func comp_clear_slot void %io:io<0,0xffff> %slot:bv64 {
    @req ult %slot 7
    @b0
        %k = call comp_ctl %io
        %ws = call comp_ws %io
        %chs = call comp_chs %io
        %sf = call comp_sf %io
        call cs_clear_slot %k %ws %chs %sf %slot
        ret
}

func comp_scene_init void %io:io<0,0xffff> {
    @b0
        %k = call comp_ctl %io
        %ws = call comp_ws %io
        %chs = call comp_chs %io
        %sf = call comp_sf %io
        call cs_scene_init %k %ws %chs %sf
        ret
}

func comp_focus void %io:io<0,0xffff> %view:ptr<VgaCell,1382400> %g:ptr<IpcChannel,1> %slot:bv64 {
    @req uge %view 0x10000
    @req ult %view 0x80000000
    @req uge %g 0x10000
    @req ult %g 0x80000000
    @req ult %slot 7
    @b0
        %k = call comp_ctl %io
        %ws = call comp_ws %io
        %chs = call comp_chs %io
        %sf = call comp_sf %io
        call cs_focus %k %ws %chs %sf %view %g %slot
        ret
}

func comp_close void %io:io<0,0xffff> %view:ptr<VgaCell,1382400> %g:ptr<IpcChannel,1> %slot:bv64 {
    @req uge %view 0x10000
    @req ult %view 0x80000000
    @req uge %g 0x10000
    @req ult %g 0x80000000
    @req ult %slot 7
    @b0
        %k = call comp_ctl %io
        %ws = call comp_ws %io
        %chs = call comp_chs %io
        %sf = call comp_sf %io
        call cs_close %k %ws %chs %sf %view %g %slot
        ret
}

func comp_mouse_in void %io:io<0,0xffff> %g:ptr<IpcChannel,1> %c:ptr<IpcChannel,1> %slot:bv64 {
    @req ult %slot 7
    @b0
        %k = call comp_ctl %io
        %ws = call comp_ws %io
        %chs = call comp_chs %io
        %sf = call comp_sf %io
        call cs_mouse_in %k %ws %chs %sf %g %c %slot
        ret
}

func comp_present void %io:io<0,0xffff> %fb:ptr<VgaCell,1382400> %g:ptr<IpcChannel,1> %c:ptr<IpcChannel,1> %slot:bv64 {
    @req uge %fb 0x10000
    @req ult %fb 0x80000000
    @req uge %g 0x10000
    @req ult %g 0x80000000
    @req ult %slot 7
    @b0
        %k = call comp_ctl %io
        %ws = call comp_ws %io
        %chs = call comp_chs %io
        %sf = call comp_sf %io
        call cs_present %k %ws %chs %sf %fb %g %c %slot
        ret
}

func comp_click bv64 %io:io<0,0xffff> %view:ptr<VgaCell,1382400> %g:ptr<IpcChannel,1> {
    @req uge %view 0x10000
    @req ult %view 0x80000000
    @req uge %g 0x10000
    @req ult %g 0x80000000
    @ens ule %r 2
    @b0
        %k = call comp_ctl %io
        %ws = call comp_ws %io
        %chs = call comp_chs %io
        %sf = call comp_sf %io
        %res = call cs_click %k %ws %chs %sf %view %g
        ret %res
}

func comp_drag_tick void %io:io<0,0xffff> %view:ptr<VgaCell,1382400> %g:ptr<IpcChannel,1> {
    @req uge %view 0x10000
    @req ult %view 0x80000000
    @req uge %g 0x10000
    @req ult %g 0x80000000
    @b0
        %k = call comp_ctl %io
        %ws = call comp_ws %io
        %chs = call comp_chs %io
        %sf = call comp_sf %io
        call cs_drag_tick %k %ws %chs %sf %view %g
        ret
}

# Bit i = slot i đang có cửa sổ trong cảnh (cho chỉ báo trên Dock)
func cs_run_mask bv64 %k:ptr<CompCtl,1> %ws:ptr<CompWin,7> %chs:ptr<IpcChannel,7> %sf:ptr<CompSlot,7> {
    @req uge %sf 0x10000
    @req ult %sf 0x40000000
    @ens ult %r 128
    @b0
        %c = call cs_ctl %k
        %n = load %c CompCtl.count
        jmp @l 0 0
    @l %i:bv64 %m:bv64
        @inv ule %i 7
        @inv ult %m 128
        %more = cmp ult %i 7
        br %more @in @done
    @in
        %live = cmp ult %i %n
        br %live @body @done
    @body
        %z = call cs_z %ws %i
        %s = load %z CompWin.z
        %ok0 = cmp ne %s 0
        br %ok0 @set @next0
    @set
        %sl = sub %s 1
        %bit = shl 1 %sl
        %m1 = or %m %bit
        %i1 = add %i 1
        jmp @l %i1 %m1
    @next0
        %i2 = add %i 1
        jmp @l %i2 %m
    @done
        ret %m
}

func comp_run_mask bv64 %io:io<0,0xffff> {
    @ens ult %r 128
    @b0
        %k = call comp_ctl %io
        %ws = call comp_ws %io
        %chs = call comp_chs %io
        %sf = call comp_sf %io
        %res = call cs_run_mask %k %ws %chs %sf
        ret %res
}

func comp_wants_run bv64 %io:io<0,0xffff> %g:ptr<IpcChannel,1> {
    @ens ule %r 1
    @b0
        %k = call comp_ctl %io
        %ws = call comp_ws %io
        %chs = call comp_chs %io
        %sf = call comp_sf %io
        %res = call cs_wants_run %k %ws %chs %sf %g
        ret %res
}

# Lúc boot (sau vmm_probe_ram): giữ 21 khung đầu của bể cho 7 surface và ánh xạ đồng nhất chúng.
# Trả 1 nếu bật được compositor.
func comp_init bv64 %io:io<0,0xffff> %vmm:ptr<DiskQword,512> {
    @req uge %vmm 0x10000
    @req ult %vmm 0x80000000
    @ens ule %r 1
    @b0
        call comp_scene_init %io
        # 21 khung = bit 0..20 của Qword bitmap 128; phải TRỐNG cả (đã được vmm_probe_ram mở, chưa ai cấp)
        %lim = call mem_get_q 512 %vmm 6
        %enough = cmp uge %lim 21
        br %enough @chk @no
    @chk
        %bm = call mem_get_q 512 %vmm 128
        %used = and %bm 0x1fffff
        %free = cmp eq %used 0
        br %free @take @no
    @take
        %bm2 = or %bm 0x1fffff
        call mem_set_q 512 %vmm 128 %bm2
        %nalloc = call mem_get_q 512 %vmm 2
        %nalloc2 = add_sat %nalloc 21
        call mem_set_q 512 %vmm 2 %nalloc2
        %nfree = call mem_get_q 512 %vmm 7
        %nfree2 = sub_sat %nfree 21
        call mem_set_q 512 %vmm 7 %nfree2
        %pd = const 0x12000 ptr<DiskQword,512>
        jmp @map 0
    @map %k:bv64
        @inv ule %k 21
        %more = cmp ult %k 21
        br %more @ent @mapped
    @ent
        %idx = add %k 144
        %off = shl %k 21
        %phys = add %off 0x12000000
        %e = or %phys 0x83
        call mem_set_q 512 %pd %idx %e
        %k2 = add %k 1
        jmp @map %k2
    @mapped
        call mmu_flush %io
        # bật compositor (trước khi xóa surface: comp_clear_slot chỉ chạy khi đã bật)
        %kc = call comp_ctl %io
        store %kc CompCtl.enabled 1
        jmp @clr 0
    @clr %s:bv64
        @inv ule %s 7
        %smore = cmp ult %s 7
        br %smore @clr1 @yes
    @clr1
        call comp_clear_slot %io %s
        %s2 = add %s 1
        jmp @clr %s2
    @yes
        ret 1
    @no
        ret 0
}
