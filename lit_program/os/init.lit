# File: lit_program/os/init.lit
include wm.lit
include ../drivers/serial.lit
include ../drivers/usb_xhci.lit

func sys_init_drivers void %0:io<0,0xffff> %1:ptr<KeyMap,8> %2:ptr<DiskQword,64> %3:ptr<DiskQword,64> {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req uge %3 0x10000
    @req ult %3 0x80000000

    @b0
        call blk_init %0
        %kd = call drv_kbd_init %0 %1
        call hw_set %0 300 %kd                # HW[300] = chẩn đoán i8042 (dòng KBD)
        call usb_init %0

        # Gắn LightFS (mã gắn -> HW[33] để chẩn đoán) và gán các App trong apps/ vào slot Dock
        %6 = call lfs_mount %0
        %7 = const 33 bv64
        call hw_set %0 %7 %6
        call lfs_scan_apps %0
        %8 = const 0 bv64
        call std_mem_zero %2
        call std_mem_zero %3

        %14 = const 79 bv8
        %15 = const 75 bv8
        %16 = const 10 bv8
        call drv_serial_putc %0 %14
        call drv_serial_putc %0 %15
        call drv_serial_putc %0 %16
        ret
}

func sys_init_desktop void %0:io<0,0xffff> %1:ptr<VgaCell,2073600> %2:ptr<VgaCell,2073600> %3:ptr<IpcChannel,1> %4:ptr<DiskQword,64> {
    @req uge %1 0x10000
    @req ult %1 0x40000000
    @req uge %2 0x10000
    @req ult %2 0x40000000
    @req uge %3 0x10000
    @req ult %3 0x80000000
    @req uge %4 0x10000
    @req ult %4 0x80000000

    @b0
        call ipc_channel_init %3
        call app_chan_init_all %0

        %7 = const 0 bv64
        %8 = const 1920 bv64
        %9 = const 1080 bv64
        %10 = const 0x161b26 bv32

        call gfx_fill_rect_scr %2 %7 %7 %8 %9 %10
        # Nạp App + vẽ Dock (khung nhìn gốc (320, 359), giữa đáy màn hình) vào bộ đệm sau
        call dock_load_apps %0 %3
        call dock_redraw %0 %2
        %dsb = call dock_ds %0
        store %dsb DockState.drawn 1
        store %3 80 %7
        call gfx_blit_rect %1 %2 %7 %7 %8 %9
        call fb_present_rect %0 %1 %7 %7 %8 %9

        %11 = const 960 bv64
        %12 = const 540 bv64
        call gfx_draw_cursor %1 %11 %12
        %13 = const 972 bv64
        %14 = const 558 bv64
        call fb_present_rect %0 %1 %11 %12 %13 %14
        ret
}
