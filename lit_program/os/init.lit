# File: lit_program/os/init.lit
# Danh sách các chương trình khởi chạy khi bật máy

include ../drivers/serial.lit

func init_startup void %0:io<0,0xffff> %1:ptr<KernelState,1> %2:ptr<HeapSlot,64> %3:ptr<VgaCell,2000> {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x70000000
    @req uge %3 0x10000
    @req ult %3 0x80000000

    @b0
        # 1. Nạp Driver VGA (Task #1)
        %4 = const 0 bv64
        %5 = call kregister_task %1 %4
        call drv_vga_init %0

        # 2. Nạp Ứng dụng Desktop UI (Task #2) kèm cấp phát 8 khối Heap
        %6 = call kregister_task %1 %5
        %7 = const 0 bv64
        %8 = call kalloc_heap8 %1 %2 %7
        call app_desktop_run %3 %8

        # 3. Báo cáo qua cổng Serial rằng Startup đã chạy xong ("OK\n")
        %9 = const 79 bv8
        %10 = const 75 bv8
        %11 = const 10 bv8
        call drv_serial_putc %0 %9
        call drv_serial_putc %0 %10
        call drv_serial_putc %0 %11
        ret
}
