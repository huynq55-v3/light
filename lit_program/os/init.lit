# File: lit_program/os/init.lit
# STARTUP LIST: Khởi tạo các Driver (VGA, Keyboard, Serial) và Ứng dụng Desktop

include ../drivers/serial.lit

func init_startup void %0:io<0,0xffff> %1:ptr<KernelState,1> %2:ptr<HeapSlot,64> %3:ptr<VgaCell,2000> %4:ptr<KeyMap,8> {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x70000000
    @req uge %3 0x10000
    @req ult %3 0x80000000
    @req uge %4 0x10000
    @req ult %4 0x80000000

    @b0
        # 1. Nạp Driver VGA (Task #1)
        %5 = const 0 bv64
        %6 = call kregister_task %1 %5
        call drv_vga_init %0

        # 2. Nạp Driver Bàn phím PS/2 (Task #2)
        %7 = call kregister_task %1 %6
        call drv_kbd_init %4

        # 3. Nạp Ứng dụng Desktop UI (Task #3) kèm cấp phát 8 khối Heap
        %8 = call kregister_task %1 %7
        %9 = const 0 bv64
        %10 = call kalloc_heap8 %1 %2 %9
        call app_desktop_init %3 %10

        # 4. In "OK\n" ra cổng Serial báo hiệu Startup hoàn tất, chuẩn bị vào Vòng lặp Lập lịch!
        %11 = const 79 bv8
        %12 = const 75 bv8
        %13 = const 10 bv8
        call drv_serial_putc %0 %11
        call drv_serial_putc %0 %12
        call drv_serial_putc %0 %13
        ret
}
