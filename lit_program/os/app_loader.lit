    @b4
        %6 = const 2 bv64
        %7 = cmp eq %1 %6
        br %7 @b5 @b6

    @b5
        %22 = const 0x3000000000 ptr<DiskQword,1>
        jmp @b99 %22

    @b6
        %8 = const 3 bv64
        %9 = cmp eq %1 %8
        br %9 @b7 @b8

    @b7
        %23 = const 0x4000000000 ptr<DiskQword,1>
