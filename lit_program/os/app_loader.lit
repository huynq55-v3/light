# =============================================================================
# 3b. BỘ CẤP PHÁT KHUNG RAM VẬT LÝ 2MB & CHUNK CỦA APP (CẤP / THU HỒI TƯỜNG MINH)
#     Bể khung: VMM_POOL_BASE = 0x12000000 (288MB), khung f = [0x12000000 + f*2MB, +2MB), f < 24576 (bể tối đa 48GB).
#     Bảng quản trị VMM (0x7f000, 512 Qwords):
#       [2] = số khung đang cấp   [3] = đỉnh địa chỉ RAM khả dụng   [4] = tổng RAM khả dụng   [5] = mmap_len
#       [6] = số chỉ số khung của bể (0..24576)   [7] = số khung TRỐNG   [8..14] = số Chunk đang có của slot 0..6
#       [128..511] = bitmap 24576 khung: bit = 0 trống; bit = 1 đã cấp HOẶC không phải RAM (vmm_probe_ram chỉ mở
#                    những khung nằm trọn trong vùng RAM type 1 của memory map -> không bao giờ cấp lỗ PCI/ACPI/reserved)
# Mô hình App: chunk c (0..16382) của slot s = trang 2MB thứ c+1 của cửa sổ (s+1)*64GB; chunk 0..14 tĩnh (30MB),
# chunk 15.. cấp từ bể. App luôn nhận heap ptr<DiskQword,%n> với n = số_chunk * 262144 -> kiểu chỉ phủ vùng ĐÃ map.
# =============================================================================

func sys_get_vmm_table ptr<DiskQword,512> %0:io<0,0xffff> {
    @ens uge %1 0x10000
    @ens ult %1 0x80000000

    @b0
        %1 = const 0x7f000 ptr<DiskQword,512>
        ret %1
}

func vmm_tbl_inc void %0:ptr<DiskQword,512> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ult %1 512

    @b0
        %2 = call vmm_tbl_get %0 %1
        %3 = const 0xffffffff bv64
        %4 = call std_min %2 %3
        %5 = const 1 bv64
        %6 = add %4 %5
        call vmm_tbl_set %0 %1 %6
        ret
}

func vmm_tbl_dec void %0:ptr<DiskQword,512> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ult %1 512

    @b0
        %2 = call vmm_tbl_get %0 %1
        %3 = const 1 bv64
        %4 = call std_sat_sub %2 %3
        call vmm_tbl_set %0 %1 %4
        ret
}

# Số chunk hiện có của slot %1, kẹp về [15 .. 16383]
func vmm_granted bv64 %0:ptr<DiskQword,512> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ult %1 7
    @ens uge %5 15
    @ens ule %5 16383

    @b0
        %2 = const 8 bv64
        %3 = add %2 %1
        %4 = call vmm_tbl_get %0 %3
        %6 = const 15 bv64
        %7 = const 16383 bv64
        %5 = call std_clamp %4 %6 %7
        ret %5
}

# Cấp khung trống có chỉ số nhỏ nhất (bỏ qua nhanh từng Qword bitmap đã đầy). Trả f (< 24576) hoặc 24576 nếu hết.
func vmm_frame_alloc bv64 %0:ptr<DiskQword,512> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @ens ule %30 24576

    @b0
        %1 = const 0 bv64
        %2 = const 6 bv64
        %3 = call vmm_tbl_get %0 %2
        %4 = const 24576 bv64
        %5 = call std_min %3 %4             # lim = số chỉ số khung của bể
        jmp @b1 %1

    @b1 %6:bv64                             # q = Qword bitmap thứ q (khung q*64 .. q*64+63)
        @inv ule %6 384
        %7 = const 6 bv64
        %8 = shl %6 %7
        %9 = cmp ult %8 %5
        br %9 @b2 @b9

    @b2
        %10 = const 128 bv64
        %11 = add %6 %10
        %12 = call vmm_tbl_get %0 %11
        %13 = const 0xffffffffffffffff bv64
        %14 = cmp ne %12 %13
        br %14 @b3 @b8

    @b3
        jmp @b4 %1

    @b4 %15:bv64
        @inv ule %15 64
        %16 = const 64 bv64
        %17 = cmp ult %15 %16
        br %17 @b5 @b8

    @b5
        %18 = lshr %12 %15
        %19 = const 1 bv64
        %20 = and %18 %19
        %21 = cmp eq %20 %1
        br %21 @b6 @b7

    @b6
        %22 = add %8 %15                    # f = q*64 + bit
        %23 = cmp ult %22 %5
        br %23 @b61 @b9

    @b61
        %24 = shl %19 %15
        %25 = or %12 %24
        call vmm_tbl_set %0 %11 %25
        %26 = const 2 bv64
        call vmm_tbl_inc %0 %26
        %27 = const 7 bv64
        call vmm_tbl_dec %0 %27
        jmp @b99 %22

    @b7
        %28 = add %15 %19
        jmp @b4 %28

    @b8
        %29 = const 1 bv64
        %31 = add %6 %29
        jmp @b1 %31

    @b9
        jmp @b99 %4

    @b99 %30:bv64
        @inv ule %30 24576
        ret %30
}

# Trả khung %1 về bể. Chỉ khung đang cấp (bit = 1) trong phạm vi bể; gọi với khung lấy từ ô PD do vmm_map_chunk ghi.
func vmm_frame_free void %0:ptr<DiskQword,512> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ult %1 24576

    @b0
        %2 = const 6 bv64
        %3 = call vmm_tbl_get %0 %2
        %4 = cmp ult %1 %3
        br %4 @b1 @b9

    @b1
        %5 = const 6 bv64
        %6 = lshr %1 %5
        %7 = const 128 bv64
        %8 = add %6 %7                      # 128..511
        %9 = const 63 bv64
        %10 = and %1 %9
        %11 = call vmm_tbl_get %0 %8
        %12 = lshr %11 %10
        %13 = const 1 bv64
        %14 = and %12 %13
        %15 = const 0 bv64
        %16 = cmp ne %14 %15
        br %16 @b2 @b9

    @b2
        %17 = shl %13 %10
        %18 = const 0xffffffffffffffff bv64
        %19 = xor %17 %18
        %20 = and %11 %19
        call vmm_tbl_set %0 %8 %20
        %21 = const 2 bv64
        call vmm_tbl_dec %0 %21
        %22 = const 7 bv64
        call vmm_tbl_inc %0 %22
        jmp @b9

    @b9
        ret
}

# Gắn 1 khung mới vào Chunk %3 (1..16382) của App %2: PD_Pool[slot * 16384 + chunk + 1] = khung | Present | RW | 2MB.
# Trả 1 nếu OK, 0 nếu hết khung. Người gọi phải nạp lại CR3 trước khi chạm vào chunk.
func vmm_map_chunk bv64 %0:ptr<DiskQword,131072> %1:ptr<DiskQword,512> %2:bv64 %3:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req ult %2 7
    @req uge %3 1
    @req ule %3 16382
    @ens ule %20 1

    @b0
        %4 = call vmm_frame_alloc %1
        %5 = const 24576 bv64
        %6 = cmp ult %4 %5
        br %6 @b1 @b2

    @b1
        %7 = const 21 bv64
        %8 = shl %4 %7                      # frame * 2MB
        %9 = const 0x12000000 bv64          # VMM_POOL_BASE
        %10 = add %9 %8
        %11 = const 0x83 bv64               # Present | RW | 2MB HugePage
        %12 = or %10 %11
        %13 = const 14 bv64
        %14 = shl %2 %13                    # slot * 16384
        %15 = const 1 bv64
        %16 = add %3 %15                    # trang = chunk + 1 (<= 16383)
        %17 = add %14 %16                   # pd_idx < 114688
        %18 = slice %0 %17 ptr<DiskQword,1>
        store %18 0 %12
        jmp @b99 %15

    @b2
        %19 = const 0 bv64
        jmp @b99 %19

    @b99 %20:bv64
        @inv ule %20 1
        ret %20
}

# Xóa trắng chunk %2 của App %1 qua cửa sổ ảo của App (vxor256: 32 byte/lệnh). Khung từ bể có thể còn dữ liệu của
# App khác -> PHẢI xóa trước khi giao, nếu không là rò rỉ dữ liệu giữa các App.
func vmm_zero_chunk void %0:io<0,0xffff> %1:bv64 %2:bv64 {
    @req ult %1 7
    @req ule %2 16382

    @b0
        %3 = call sys_get_app_state_ptr %0 %1
        %4 = const 18 bv64
        %5 = shl %2 %4                      # chunk * 262144 Qword
        %6 = slice %3 %5 ptr<DiskQword,262144>
        %7 = const 0 bv64
        jmp @b1 %7

    @b1 %8:bv64
        @inv ule %8 65536
        %9 = const 65536 bv64
        %10 = cmp ult %8 %9
        br %10 @b2 @b3

    @b2
        %11 = const 2 bv64
        %12 = shl %8 %11                    # i * 4 Qword
        %13 = slice %6 %12 ptr<DiskQword,4>
        vxor256 %13 %13 %13
        %14 = const 1 bv64
        %15 = add %8 %14
        jmp @b1 %15

    @b3
        ret
}

# CẤP: đưa số chunk của App %3 lên %4 (kẹp 15..16383), mỗi chunk mới được xóa trắng. Dừng sớm nếu hết khung.
# Trả số chunk thực có sau khi cấp.
func vmm_commit_chunks bv64 %0:io<0,0xffff> %1:ptr<DiskQword,131072> %2:ptr<DiskQword,512> %3:bv64 %4:bv64 {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req ult %3 7
    @ens uge %12 15
    @ens ule %12 16383

    @b0
        %5 = const 1 bv64
        %6 = const 15 bv64
        %7 = const 16383 bv64
        %8 = call std_clamp %4 %6 %7        # want
        %9 = call vmm_granted %2 %3         # have
        %10 = const 8 bv64
        %11 = add %10 %3
        jmp @b1 %9

    @b1 %12:bv64
        @inv uge %12 15
        @inv ule %12 16383
        %13 = cmp ult %12 %8
        br %13 @b2 @b4

    @b2
        %14 = call vmm_map_chunk %1 %2 %3 %12
        %15 = const 0 bv64
        %16 = cmp ne %14 %15
        br %16 @b3 @b4

    @b3
        %17 = add %12 %5
        jmp @b1 %17

    @b4
        call vmm_tbl_set %2 %11 %12
        %18 = const 0x10000 bv64
        hwio_w %0 3 %18                     # nạp lại CR3 trước khi chạm vào chunk mới
        jmp @b5 %9

    @b5 %19:bv64
        @inv ule %19 16383
        %20 = cmp ult %19 %12
        br %20 @b6 @b99

    @b6
        call vmm_zero_chunk %0 %3 %19
        %21 = add %19 %5
        jmp @b5 %21

    @b99
        ret %12
}

# THU HỒI: gỡ chunk %4 .. (có - 1) của App %3 (kẹp %4 về 15..16383), trả khung về bể, nạp lại CR3 (xả TLB BSP;
# AP tự xả TLB trước mỗi job `parallel`). An toàn vì App không thể giữ con trỏ qua tick: Layout cấm trường ptr và
# heap được truyền lại mỗi lần gọi với độ dài mới.
func vmm_release_chunks void %0:io<0,0xffff> %1:ptr<DiskQword,131072> %2:ptr<DiskQword,512> %3:bv64 %4:bv64 {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req ult %3 7

    @b0
        %5 = const 1 bv64
        %6 = const 15 bv64
        %7 = const 16383 bv64
        %8 = call std_clamp %4 %6 %7        # keep
        %9 = call vmm_granted %2 %3         # have
        %40 = const 8 bv64
        %41 = add %40 %3
        jmp @b1 %8

    @b1 %10:bv64
        @inv uge %10 15
        @inv ule %10 16383
        %11 = cmp ult %10 %9
        br %11 @b2 @b4

    @b2
        %12 = const 14 bv64
        %13 = shl %3 %12
        %14 = add %10 %5                    # trang = chunk + 1
        %15 = add %13 %14
        %16 = slice %1 %15 ptr<DiskQword,1>
        %17 = load %16 0 bv64
        %18 = const 0 bv64
        store %16 0 %18                     # gỡ ánh xạ
        %19 = const 1 bv64
        %20 = and %17 %19                   # Present?
        %21 = const 0xffffffe00000 bv64
        %22 = and %17 %21
        %23 = const 0x12000000 bv64
        %24 = cmp uge %22 %23
        %25 = call std_sat_sub %22 %23
        %26 = const 21 bv64
        %27 = lshr %25 %26
        %28 = const 24576 bv64
        %29 = cmp ult %27 %28
        %30 = and %24 %29
        %31 = and %30 %20
        br %31 @b21 @b3

    @b21
        call vmm_frame_free %2 %27
        jmp @b3

    @b3
        %32 = add %10 %5
        jmp @b1 %32

    @b4
        %33 = call std_min %8 %9
        call vmm_tbl_set %2 %41 %33
        %34 = const 0x10000 bv64
        hwio_w %0 3 %34
        ret
}

# Thu hồi toàn bộ Chunk động (15..) của App %3 khi App đóng
func vmm_free_app_chunks void %0:io<0,0xffff> %1:ptr<DiskQword,131072> %2:ptr<DiskQword,512> %3:bv64 {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req ult %3 7

    @b0
        %4 = const 15 bv64
        call vmm_release_chunks %0 %1 %2 %3 %4
        ret
}

# Xử lý yêu cầu bộ nhớ của App %2 trong IPC (offset 168 = mem_req: số chunk 2MB mong muốn, 0 = không yêu cầu):
# lớn hơn hiện có -> cấp; nhỏ hơn -> thu hồi. Luôn ghi số khung trống của bể vào offset 176 (mem_free).
func app_service_mem_req void %0:io<0,0xffff> %1:ptr<IpcChannel,1> %2:bv64 {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req ult %2 7

    @b0
        %3 = const 0xa00000 ptr<DiskQword,131072>
        %4 = call sys_get_vmm_table %0
        %5 = load %1 168 bv64
        %6 = const 0 bv64
        %7 = cmp eq %5 %6
        br %7 @b9 @b1

    @b1
        store %1 168 %6
        %8 = call vmm_granted %4 %2
        %9 = cmp ugt %5 %8
        br %9 @b2 @b3

    @b2
        %10 = call vmm_commit_chunks %0 %3 %4 %2 %5
        jmp @b9

    @b3
        %11 = cmp ult %5 %8
        br %11 @b4 @b9

    @b4
        call vmm_release_chunks %0 %3 %4 %2 %5
        jmp @b9

    @b9
        %12 = const 7 bv64
        %13 = call vmm_tbl_get %4 %12
        %14 = const 0xffffffff bv64
        %15 = call std_min %13 %14
        store %1 176 %15
        ret
}

# =============================================================================
# 4. CÁC HÀM ĐIỀU PHỐI TỔNG QUÁT THEO SLOT (0..6)
# =============================================================================

func app_dispatch_entry void %0:io<0,0xffff> %1:ptr<VgaCell,921600> %2:ptr<IpcChannel,1> %3:ptr<DiskQword,64> %4:ptr<DiskQword,64> %5:smp %6:bv64 {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req uge %3 0x10000
    @req ult %3 0x80000000
    @req uge %4 0x10000
    @req ult %4 0x80000000
    @req ult %6 7

    @b0
        %7 = call sys_get_app_code_ptr %0 %6
        %8 = call sys_get_app_state_ptr %0 %6

        # Heap = toàn bộ chunk ĐÃ map của App: độ dài = số_chunk * 262144 Qword (ABI: %6:bv64 %7:ptr<DiskQword,%6>)
        %9 = call sys_get_vmm_table %0
        %10 = call vmm_granted %9 %6
        %11 = const 18 bv64
        %12 = shl %10 %11
        %13 = const 7 bv64
        %14 = call vmm_tbl_get %9 %13
        %15 = const 0xffffffff bv64
        %16 = call std_min %14 %15
        store %2 176 %16                    # mem_free: số khung 2MB còn trống

        # Thẻ smp (%5) cho phép App dùng `parallel`/`smp_workers`; App không thể đọc/ghi bảng SMP.
        # 2. Chạy App
        call %7 %1 %2 %8 %3 %4 %5 %12 %8

        # 3. Cấp/thu hồi bộ nhớ App vừa yêu cầu -> lần gọi kế tiếp App nhận heap với độ dài mới
        call app_service_mem_req %0 %2 %6
        ret
}

func app_dispatch_draw_icon void %0:io<0,0xffff> %1:ptr<VgaCell,921600> %2:bv64 %3:bv64 %4:bv64 {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req ule %2 1200
    @req ule %3 650
    @req ult %4 7

    @b0
        %5 = call sys_get_app_icon_ptr %0 %4
        call %5 %1 %2 %3
        ret
}

func app_dispatch_load_app void %0:io<0,0xffff> %1:bv64 %2:bv64 {
    @req ult %1 7
    @req ult %2 268430000

    @b0
        %3 = call sys_get_app_code_buf_ptr %0 %1
        call drv_ata_load_app %0 %3 %2
        ret
}

func app_dispatch_zero_state void %0:io<0,0xffff> %1:bv64 {
    @req ult %1 7

    @b0
        %2 = call sys_get_app_state_ptr %0 %1
        %3 = const 0 bv64
        %4 = slice %2 %3 ptr<DiskQword,64>
        call std_mem_zero %4
        ret
}

func app_dispatch_disk_io_old void %0:io<0,0xffff> %1:bv64 %2:bv64 %3:bv64 {
    @req ult %1 7
    @req ult %2 0x100000000000000

    @b0
        %4 = call sys_get_app_state_ptr %0 %1
        %5 = const 0xffffff bv64
        %6 = and %2 %5                      # lba (bits 0..23)

        %7 = const 24 bv64
        %8 = lshr %2 %7
        %9 = const 0xffff bv64
        %10 = and %8 %9                     # num_sectors (bits 24..39: 0..65535)

        %20 = const 40 bv64
        %21 = lshr %2 %20
        %22 = and %21 %9                    # dst_sec_off (bits 40..55: 0..65535)

        %11 = const 0 bv64
        %12 = cmp ne %3 %11
        br %12 @b1 @b2

    @b1
        %23 = slice %4 %11 ptr<DiskQword,64>
        call drv_ata_write_sector %0 %23 %6
        ret

    @b2
        %24 = const 1 bv64
        %25 = call std_max %10 %24          # actual_sectors >= 1
        %26 = add %22 %25                   # total_sectors_needed <= 131070
        %27 = const 65536 bv64              # Arena = 65536 Sectors (32MB)
        %28 = cmp ule %26 %27
        br %28 @b3 @b4                      # vượt Arena -> bỏ qua yêu cầu

    @b3
        # 1. Số Chunk 2MB cần có để chứa vùng đích = ceil(total_sectors / 4096) (1..16)
        %40 = const 4095 bv64
        %41 = add %26 %40
        %42 = const 12 bv64
        %43 = lshr %41 %42
        %430 = const 20000 bv64
        %431 = cmp uge %25 %430
        br %431 @b34 @b35

    @b34
        %432 = const 16 bv64
        jmp @b36 %432

    @b35
        jmp @b36 %43

    @b36 %433:bv64
        @inv uge %433 1
        @inv ule %433 16
        %15 = const 0xa00000 ptr<DiskQword,131072>
        %16 = call sys_get_vmm_table %0
        %44 = call vmm_commit_chunks %0 %15 %16 %1 %433
        %45 = cmp uge %44 %43
        br %45 @b31 @b4                     # thiếu RAM vật lý -> bỏ qua, không đọc vào vùng chưa map

    @b31
        # 2. Vòng lặp đọc theo lô (tối đa 256 Sectors = 128KB mỗi lệnh ATA) từ LBA %6 vào Arena
        jmp @b32 %11

    @b32 %29:bv64
        @inv ule %29 65535
        %30 = cmp ult %29 %25
        br %30 @b33 @b4

    @b33
        %50 = call std_sat_sub %25 %29      # rem = actual_sectors - i (>= 1)
        %51 = const 256 bv64
        %52 = call std_clamp %50 %24 %51    # batch_cnt = clamp(rem, 1, 256)
        %31 = add %22 %29                   # sec_slot = dst_sec_off + i
        %32 = const 65535 bv64
        %33 = call std_min %31 %32          # kẹp <= 65535
        %34 = const 6 bv64
        %35 = shl %33 %34                   # qword_off = sec_slot * 64 (<= 4194240)
        %36 = slice %4 %35 ptr<DiskQword,16384>
        %37 = add %6 %29                    # cur_lba = lba + i
        call drv_ata_read_sectors_batch %0 %36 %37 %52

        %53 = add %29 %52
        %38 = call std_min %53 %32
        jmp @b32 %38

    @b4
        ret
}

# Điều phối Đọc/Ghi Đĩa (định dạng 56 bit: lba[0..23] | n[24..39] | dst[40..55])
func app_dispatch_disk_io void %0:io<0,0xffff> %1:bv64 %2:bv64 %3:bv64 {
    @req ult %1 7

    @b0
        %9 = const 0xffffffffffffff bv64
        %10 = and %2 %9
        call app_dispatch_disk_io_old %0 %1 %10 %3
        ret
}

# =============================================================================
# 4. ĐỌC MEMORY MAP CỦA BOOTLOADER (Multiboot) ĐỂ BIẾT RAM THỰC TẾ
#    Boot stub (elf64.rs) sao chép sẵn: Multiboot Info (96B) -> 0x7d000, Memory Map (tối đa 0xF00B) -> 0x7d100.
#    Mỗi entry mmap dài 24B = size(4)=20 | base(8) | len(8) | type(4); mọi trường đều rơi vào Qword căn chỉnh 8B:
#      q[3k+0] = size | base_lo << 32      q[3k+1] = base_hi | len_lo << 32      q[3k+2] = len_hi | type << 32
# =============================================================================

func mem_info_q bv64 %0:ptr<DiskQword,512> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ult %1 512

    @b0
        %2 = slice %0 %1 ptr<DiskQword,1>
        %3 = load %2 0 bv64
        ret %3
}

func mem_mmap_q bv64 %0:ptr<DiskQword,480> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ult %1 480

    @b0
        %2 = slice %0 %1 ptr<DiskQword,1>
        %3 = load %2 0 bv64
        ret %3
}

# Mở các khung của bể nằm TRỌN trong [%1, %2) (một vùng RAM type 1): khung f khi 288MB + f*2MB >= %1 và
# 288MB + (f+1)*2MB <= %2. Khung đã mở (vùng mmap chồng nhau) không bị đếm lại.
func vmm_pool_unlock_range void %0:ptr<DiskQword,512> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ule %1 0xffffffffffff
    @req ule %2 0x1fffffffffffe

    @b0
        %3 = const 0x12000000 bv64
        %4 = call std_max %1 %3
        %5 = call std_sat_sub %4 %3
        %6 = const 0x1fffff bv64
        %7 = add %5 %6
        %8 = const 21 bv64
        %9 = lshr %7 %8                     # khung đầu = ceil((base - 288MB) / 2MB)
        %10 = call std_sat_sub %2 %3
        %11 = lshr %10 %8                   # khung cuối (không gồm) = floor((end - 288MB) / 2MB)
        %12 = const 24576 bv64
        %13 = call std_min %11 %12
        %14 = call std_min %9 %13
        jmp @b1 %14

    @b1 %15:bv64
        @inv ule %15 24576
        %16 = cmp ult %15 %13
        br %16 @b2 @b9

    @b2
        %17 = const 6 bv64
        %18 = lshr %15 %17
        %19 = const 128 bv64
        %20 = add %18 %19                   # 128..511
        %21 = const 63 bv64
        %22 = and %15 %21
        %23 = call vmm_tbl_get %0 %20
        %24 = lshr %23 %22
        %25 = const 1 bv64
        %26 = and %24 %25
        %27 = const 0 bv64
        %28 = cmp ne %26 %27
        br %28 @b3 @b4

    @b3
        %29 = shl %25 %22
        %30 = const 0xffffffffffffffff bv64
        %31 = xor %29 %30
        %32 = and %23 %31
        call vmm_tbl_set %0 %20 %32
        %33 = const 7 bv64
        call vmm_tbl_inc %0 %33
        jmp @b4

    @b4
        %34 = const 1 bv64
        %35 = add %15 %34
        jmp @b1 %35

    @b9
        ret
}

# Đọc Memory Map: [3] = đỉnh RAM khả dụng, [4] = tổng RAM khả dụng, [5] = độ dài mmap, [6] = số chỉ số khung của bể,
# [7] = số khung trống. Bitmap khởi đầu KHÓA toàn bộ; chỉ khung nằm trọn trong vùng RAM type 1 mới được mở
# (thay cho cách cũ: mở hết tới đỉnh RAM rồi khóa cứng lỗ PCI 3..4GB — sai trên máy thật có vùng reserved/ACPI).
func vmm_probe_ram void %100:io<0,0xffff> %0:ptr<DiskQword,512> {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        %2 = const 0 bv64
        jmp @b90 %2

    @b90 %110:bv64
        @inv ule %110 512
        %111 = const 512 bv64
        %112 = cmp ult %110 %111
        br %112 @b91 @b92

    @b91
        %113 = const 128 bv64
        %114 = cmp uge %110 %113
        %115 = const 0xffffffffffffffff bv64
        %116 = mul %114 %115                # 128.. -> khóa hết; 0..127 -> 0
        call vmm_tbl_set %0 %110 %116
        %117 = const 1 bv64
        %118 = add %110 %117
        jmp @b90 %118

    @b92
        %1 = const 0x7d000 ptr<DiskQword,512>
        %3 = call mem_info_q %1 %2
        %4 = const 0x40 bv64
        %5 = and %3 %4
        %6 = cmp ne %5 %2
        br %6 @b1 @b80

    @b80
        # Không có memory map: chỉ dùng 256MB đầu của bể (288MB..544MB), mức tối thiểu Light OS cần
        %81 = const 0x12000000 bv64
        %82 = const 0x22000000 bv64
        call vmm_pool_unlock_range %0 %81 %82
        jmp @b9

    @b1
        %10 = const 5 bv64
        %11 = call mem_info_q %1 %10
        %12 = const 32 bv64
        %13 = lshr %11 %12
        %14 = const 0xf00 bv64
        %15 = call std_min %13 %14
        call vmm_tbl_set %0 %10 %15
        jmp @b2 %2

    @b2 %20:bv64
        @inv ule %20 160
        %21 = const 160 bv64
        %22 = cmp ult %20 %21
        br %22 @b3 @b9

    @b3
        %23 = const 24 bv64
        %24 = mul %20 %23
        %25 = add %24 %23
        %26 = const 5 bv64
        %27 = call vmm_tbl_get %0 %26
        %28 = cmp ule %25 %27
        br %28 @b4 @b9

    @b4
        %30 = const 0x7d100 ptr<DiskQword,480>
        %31 = const 3 bv64
        %32 = mul %20 %31
        %33 = call mem_mmap_q %30 %32
        %34 = const 0xffffffff bv64
        %35 = and %33 %34
        %36 = const 20 bv64
        %37 = cmp eq %35 %36
        br %37 @b5 @b9

    @b5
        %40 = const 32 bv64
        %41 = lshr %33 %40                  # base_lo
        %42 = const 1 bv64
        %43 = add %32 %42
        %44 = call mem_mmap_q %30 %43       # base_hi | len_lo << 32
        %45 = const 0xffffffff bv64
        %46 = and %44 %45                   # base_hi
        %47 = shl %46 %40
        %48 = or %41 %47                    # base
        %49 = lshr %44 %40                  # len_lo
        %50 = const 2 bv64
        %51 = add %32 %50
        %52 = call mem_mmap_q %30 %51       # len_hi | type << 32
        %53 = and %52 %45                   # len_hi
        %54 = shl %53 %40
        %55 = or %49 %54                    # len
        %56 = lshr %52 %40                  # type
        %57 = cmp eq %56 %42                # type 1 = RAM khả dụng
        br %57 @b6 @b8

    @b6
        %59 = const 0xffffffffffff bv64     # giới hạn 256TB vật lý (48-bit physical address)
        %480 = call std_min %48 %59
        %550 = call std_min %55 %59
        %60 = add %480 %550                 # end = base + len (không tràn bv64)
        %61 = const 3 bv64
        %62 = call vmm_tbl_get %0 %61
        %63 = call std_max %62 %60
        call vmm_tbl_set %0 %61 %63
        %64 = const 4 bv64
        %65 = call vmm_tbl_get %0 %64
        %650 = call std_min %65 %59
        %66 = add %650 %550
        call vmm_tbl_set %0 %64 %66
        call vmm_pool_unlock_range %0 %480 %60
        jmp @b8

    @b8
        %70 = const 1 bv64
        %71 = add %20 %70
        jmp @b2 %71

    @b9
        # Số chỉ số khung của bể = ceil((đỉnh RAM - 288MB) / 2MB), kẹp <= 24576 (khung ngoài bitmap không bao giờ cấp)
        %80 = const 3 bv64
        %83 = call vmm_tbl_get %0 %80
        %84 = const 0x12000000 bv64
        %85 = call std_sat_sub %83 %84
        %86 = const 0xffffffffffff bv64
        %87 = call std_min %85 %86
        %88 = const 0x1fffff bv64
        %89 = add %87 %88
        %90 = const 21 bv64
        %91 = lshr %89 %90
        %92 = const 24576 bv64
        %93 = call std_min %91 %92
        %94 = const 6 bv64
        call vmm_tbl_set %0 %94 %93
        %95 = const 0x22000000 bv64
        %96 = cmp ugt %83 %95
        br %96 @b12 @b11

    @b11
        # Không có mmap (đỉnh RAM chưa biết): bể 128 khung đã mở ở @b80
        %97 = const 128 bv64
        call vmm_tbl_set %0 %94 %97
        jmp @b12

    @b12
        ret
}
