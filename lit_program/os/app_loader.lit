func sys_get_app_state_ptr ptr<DiskQword,4294705152> %0:io<0,0xffff> %1:bv64 {
    @req ult %1 7
    @ens uge %30 0x10000
    @ens ult %30 0x10000000000

    @b0
        %2 = const 0 bv64
        %3 = cmp eq %1 %2
        br %3 @b1 @b2

    @b1
        %20 = const 0x1000200000 ptr<DiskQword,4294705152>
        jmp @b99 %20

    @b2
        %4 = const 1 bv64
        %5 = cmp eq %1 %4
        br %5 @b3 @b4

    @b3
        %21 = const 0x2000200000 ptr<DiskQword,4294705152>
        jmp @b99 %21

    @b4
        %6 = const 2 bv64
        %7 = cmp eq %1 %6
        br %7 @b5 @b6

    @b5
        %22 = const 0x3000200000 ptr<DiskQword,4294705152>
        jmp @b99 %22

    @b6
        %8 = const 3 bv64
        %9 = cmp eq %1 %8
        br %9 @b7 @b8

    @b7
        %23 = const 0x4000200000 ptr<DiskQword,4294705152>
        jmp @b99 %23

    @b8
        %10 = const 4 bv64
        %11 = cmp eq %1 %10
        br %11 @b9 @b10

    @b9
        %24 = const 0x5000200000 ptr<DiskQword,4294705152>
        jmp @b99 %24

    @b10
        %12 = const 5 bv64
        %13 = cmp eq %1 %12
        br %13 @b11 @b12

    @b11
        %25 = const 0x6000200000 ptr<DiskQword,4294705152>
        jmp @b99 %25

    @b12
        %26 = const 0x7000200000 ptr<DiskQword,4294705152>
        jmp @b99 %26

    @b99 %30:ptr<DiskQword,4294705152>
        @inv uge %30 0x10000
        @inv ult %30 0x10000000000
        ret %30
}

