# =============================================================================
# 3b. BỘ CẤP PHÁT KHUNG RAM VẬT LÝ (FRAME ALLOCATOR) & CHUNK 2MB THEO NHU CẦU (HỖ TRỢ TỚI 16GB RAM)
#     Bể khung: VMM_POOL_BASE = 0x12000000 (288MB), lên tới 16384 khung x 2MB = 16GB (tự động co giãn theo vmm_probe_ram).
#     Bảng quản trị VMM (0x7f000, 256 Qwords):
#       [2] = số khung đã cấp   [3] = đỉnh địa chỉ RAM khả dụng   [4] = tổng RAM khả dụng   [5] = mmap_len
#       [6] = tổng số khung 2MB khả dụng trong bể (128..16384)     [8..14] = số Chunk đang có của slot 0..6
#       [128..255] = Bitmap 16384 khung (128 Qwords = 16384 bits; bit = 1: đã cấp hoặc nằm trong PCI hole)
# =============================================================================

func sys_get_vmm_table ptr<DiskQword,512> %0:io<0,0xffff> {
    @ens uge %1 0x10000
    @ens ult %1 0x80000000

    @b0
        %1 = const 0x7f000 ptr<DiskQword,512>
        ret %1
}

# Tìm khung 2MB trống đầu tiên trong bể (0 .. max_frames - 1), đánh dấu đã cấp. Trả về chỉ số khung (0..16383) hoặc 16384 nếu hết khung
func vmm_frame_alloc bv64 %0:ptr<DiskQword,512> {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @ens ule %20 16384

    @b0
        %1 = const 0 bv64
        %30 = const 6 bv64
        %31 = call vmm_tbl_get %0 %30
        %32 = const 128 bv64
        %33 = const 16384 bv64
        %3 = call std_clamp %31 %32 %33     # max_frames (128 .. 16384)
        jmp @b1 %1

    @b1 %2:bv64
        @inv ule %2 16384
        %4 = cmp ult %2 %3
        br %4 @b2 @b5

    @b2
        %5 = const 6 bv64
        %60 = lshr %2 %5                    # 0..127
        %61 = const 128 bv64
        %6 = add %60 %61                    # chỉ số Qword của bitmap (128..255)
        %7 = const 63 bv64
        %8 = and %2 %7                      # chỉ số bit trong Qword
        %9 = call vmm_tbl_get %0 %6
        %10 = lshr %9 %8
        %11 = const 1 bv64
        %12 = and %10 %11
        %13 = cmp eq %12 %1
        br %13 @b3 @b4

    @b3
        %14 = shl %11 %8
        %15 = or %9 %14
        call vmm_tbl_set %0 %6 %15          # đánh dấu khung đã cấp
        %16 = const 2 bv64
        %17 = call vmm_tbl_get %0 %16
        %18 = const 0xffff bv64
        %19 = and %17 %18
        %21 = add %19 %11
        call vmm_tbl_set %0 %16 %21         # tăng bộ đếm khung đã cấp
        jmp @b99 %2

    @b4
        %22 = const 1 bv64
        %23 = add %2 %22
        jmp @b1 %23

    @b5
        jmp @b99 %33

    @b99 %20:bv64
        @inv ule %20 16384
        ret %20
}

# Trả khung %1 (0..16383) về bể (bỏ qua nếu khung chưa được cấp để chống giải phóng kép)
func vmm_frame_free void %0:ptr<DiskQword,512> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ult %1 16384

    @b0
        %200 = const 6 bv64
        %201 = call vmm_tbl_get %0 %200
        %202 = cmp ult %1 %201              # chỉ khung trong bể thật (không đụng vùng DIMM mô hình)
        br %202 @b100 @b2

    @b100
        %2 = const 6 bv64
        %30 = lshr %1 %2
        %31 = const 128 bv64
        %3 = add %30 %31                    # 128..255
        %4 = const 63 bv64
        %5 = and %1 %4
        %6 = call vmm_tbl_get %0 %3
        %7 = lshr %6 %5
        %8 = const 1 bv64
        %9 = and %7 %8
        %10 = const 0 bv64
        %11 = cmp ne %9 %10
        br %11 @b1 @b2

    @b1
        %12 = shl %8 %5
        %13 = const 0xffffffffffffffff bv64
        %14 = xor %12 %13
        %15 = and %6 %14
        call vmm_tbl_set %0 %3 %15
        %16 = const 2 bv64
        %17 = call vmm_tbl_get %0 %16
        %18 = call std_sat_sub %17 %8
        call vmm_tbl_set %0 %16 %18
        jmp @b2

    @b2
        ret
}

# Gắn 1 khung RAM mới vào Chunk %3 (1..16382) của App %2: PD_Pool[slot * 16384 + chunk + 1] = khung | Present | RW | 2MB. Trả 1 nếu OK, 0 nếu hết khung
func vmm_map_chunk bv64 %0:ptr<DiskQword,131072> %1:ptr<DiskQword,512> %2:bv64 %3:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req ult %2 7
    @req uge %3 1
    @req ule %3 16382
    @ens ule %20 1

    @b0
        %4 = call vmm_frame_alloc %1
        %5 = const 16384 bv64
        %6 = cmp ult %4 %5
        br %6 @b1 @b2

    @b1
        %7 = const 21 bv64
        %8 = shl %4 %7                      # frame * 2MB
        %9 = const 0x12000000 bv64          # VMM_POOL_BASE
        %10 = add %9 %8
        %11 = const 0x83 bv64               # Present | RW | 2MB HugePage
        %12 = or %10 %11
        %13 = const 14 bv64
        %14 = shl %2 %13                    # slot * 16384
        %15 = const 1 bv64
        %16 = add %3 %15                    # trang = chunk + 1 (<= 16383)
        %17 = add %14 %16                   # pd_idx < 65536
        %18 = slice %0 %17 ptr<DiskQword,1>
        store %18 0 %12
        jmp @b99 %15

    @b2
        %19 = const 0 bv64
        jmp @b99 %19

    @b99 %20:bv64
        @inv ule %20 1
        ret %20
}

# Cấp nhanh thêm Chunk 2MB cho luồng nạp đĩa (không cần zero-fill vì sẽ được ghi đè ngay lập tức bởi dữ liệu sector từ đĩa)
func vmm_ensure_chunks_nozero bv64 %0:io<0,0xffff> %1:ptr<DiskQword,131072> %2:ptr<DiskQword,512> %3:bv64 %4:bv64 {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req ult %3 7
    @ens uge %99 1
    @ens ule %99 16383

    @b0
        %5 = const 1 bv64
        %105 = const 15 bv64
        %6 = const 16383 bv64
        %7 = call std_clamp %4 %105 %6
        %8 = const 8 bv64
        %9 = add %8 %3
        %10 = call vmm_tbl_get %2 %9
        %11 = call std_clamp %10 %105 %6
        %30 = cmp ule %7 %11
        br %30 @b10 @b1

    @b10
        jmp @b99 %11

    @b1
        jmp @b11 %11

    @b11 %12:bv64
        @inv uge %12 15
        @inv ule %12 16383
        %13 = cmp ult %12 %7
        br %13 @b2 @b4

    @b2
        %14 = call vmm_map_chunk %1 %2 %3 %12
        %15 = const 0 bv64
        %16 = cmp ne %14 %15
        br %16 @b3 @b4

    @b3
        %17 = add %12 %5
        jmp @b11 %17

    @b4
        call vmm_tbl_set %2 %9 %12
        %18 = const 0x10000 bv64
        hwio_w %0 3 %18
        jmp @b99 %12

    @b99 %99:bv64
        @inv uge %99 1
        @inv ule %99 16383
        ret %99
}

# Thu hồi toàn bộ Chunk động (15..16382) của App %3 về bể khung, xóa các ô PD tương ứng, nạp lại CR3
func vmm_free_app_chunks void %0:io<0,0xffff> %1:ptr<DiskQword,131072> %2:ptr<DiskQword,512> %3:bv64 {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req ult %3 7

    @b0
        %4 = const 1 bv64
        %105 = const 15 bv64
        %5 = const 16383 bv64
        %6 = const 8 bv64
        %7 = add %6 %3
        %8 = call vmm_tbl_get %2 %7
        %9 = call std_clamp %8 %105 %5      # granted thuộc [15 .. 16383]
        jmp @b1 %105

    @b1 %10:bv64
        @inv uge %10 15
        @inv ule %10 16383
        %11 = cmp ult %10 %9
        br %11 @b2 @b4

    @b2
        %12 = const 14 bv64
        %13 = shl %3 %12
        %14 = add %10 %4                    # trang = chunk + 1
        %15 = add %13 %14                   # pd_idx < 65536
        %16 = slice %1 %15 ptr<DiskQword,1>
        %17 = load %16 0 bv64
        %18 = const 0 bv64
        store %16 0 %18                     # gỡ ánh xạ
        %19 = const 0xffffffe00000 bv64
        %20 = and %17 %19                   # địa chỉ vật lý của khung
        %21 = const 0x12000000 bv64         # VMM_POOL_BASE
        %120 = cmp uge %20 %21
        %22 = call std_sat_sub %20 %21
        %23 = const 21 bv64
        %24 = lshr %22 %23                  # chỉ số khung trong bể
        %25 = const 16384 bv64
        %26 = cmp ult %24 %25
        %121 = and %120 %26
        br %121 @b21 @b3

    @b21
        call vmm_frame_free %2 %24
        jmp @b3

    @b3
        %27 = add %10 %4
        jmp @b1 %27

    @b4
        call vmm_tbl_set %2 %7 %105         # App giữ nguyên 15 Chunk tĩnh (30MB)
        %28 = const 0x10000 bv64
        hwio_w %0 3 %28
        ret
}

# =============================================================================
# 4. CÁC HÀM ĐIỀU PHỐI TỔNG QUÁT THEO SLOT (0..6)
# =============================================================================

func app_dispatch_entry void %0:io<0,0xffff> %1:ptr<VgaCell,921600> %2:ptr<IpcChannel,1> %3:ptr<DiskQword,64> %4:ptr<DiskQword,64> %5:smp %6:bv64 {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req uge %3 0x10000
    @req ult %3 0x80000000
    @req uge %4 0x10000
    @req ult %4 0x80000000
    @req ult %6 7

    @b0
        %7 = call sys_get_app_code_ptr %0 %6
        %8 = call sys_get_app_state_ptr %0 %6

        # Thẻ smp (%5) cho phép App dùng `parallel`/`smp_workers`; App không thể đọc/ghi bảng SMP.
        # 2. Chạy App
        call %7 %1 %2 %8 %3 %4 %5

        ret
}

func app_dispatch_draw_icon void %0:io<0,0xffff> %1:ptr<VgaCell,921600> %2:bv64 %3:bv64 %4:bv64 {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req ule %2 1200
    @req ule %3 650
    @req ult %4 7

    @b0
        %5 = call sys_get_app_icon_ptr %0 %4
        call %5 %1 %2 %3
        ret
}

func app_dispatch_load_app void %0:io<0,0xffff> %1:bv64 %2:bv64 {
    @req ult %1 7
    @req ult %2 268430000

    @b0
        %3 = call sys_get_app_code_buf_ptr %0 %1
        call drv_ata_load_app %0 %3 %2
        ret
}

func app_dispatch_zero_state void %0:io<0,0xffff> %1:bv64 {
    @req ult %1 7

    @b0
        %2 = call sys_get_app_state_ptr %0 %1
        %3 = const 0 bv64
        %4 = slice %2 %3 ptr<DiskQword,64>
        call std_mem_zero %4
        ret
}

func app_dispatch_disk_io_old void %0:io<0,0xffff> %1:bv64 %2:bv64 %3:bv64 {
    @req ult %1 7
    @req ult %2 0x100000000000000

    @b0
        %4 = call sys_get_app_state_ptr %0 %1
        %5 = const 0xffffff bv64
        %6 = and %2 %5                      # lba (bits 0..23)

        %7 = const 24 bv64
        %8 = lshr %2 %7
        %9 = const 0xffff bv64
        %10 = and %8 %9                     # num_sectors (bits 24..39: 0..65535)

        %20 = const 40 bv64
        %21 = lshr %2 %20
        %22 = and %21 %9                    # dst_sec_off (bits 40..55: 0..65535)

        %11 = const 0 bv64
        %12 = cmp ne %3 %11
        br %12 @b1 @b2

    @b1
        %23 = slice %4 %11 ptr<DiskQword,64>
        call drv_ata_write_sector %0 %23 %6
        ret

    @b2
        %24 = const 1 bv64
        %25 = call std_max %10 %24          # actual_sectors >= 1
        %26 = add %22 %25                   # total_sectors_needed <= 131070
        %27 = const 65536 bv64              # Arena = 65536 Sectors (32MB)
        %28 = cmp ule %26 %27
        br %28 @b3 @b4                      # vượt Arena -> bỏ qua yêu cầu

    @b3
        # 1. Số Chunk 2MB cần có để chứa vùng đích = ceil(total_sectors / 4096) (1..16)
        %40 = const 4095 bv64
        %41 = add %26 %40
        %42 = const 12 bv64
        %43 = lshr %41 %42
        %430 = const 20000 bv64
        %431 = cmp uge %25 %430
        br %431 @b34 @b35

    @b34
        %432 = const 16 bv64
        jmp @b36 %432

    @b35
        jmp @b36 %43

    @b36 %433:bv64
        @inv uge %433 1
        @inv ule %433 16
        %15 = const 0xa00000 ptr<DiskQword,131072>
        %16 = call sys_get_vmm_table %0
        %44 = call vmm_ensure_chunks_nozero %0 %15 %16 %1 %433
        %45 = cmp uge %44 %43
        br %45 @b31 @b4                     # thiếu RAM vật lý -> bỏ qua, không đọc vào vùng chưa map

    @b31
        # 2. Vòng lặp đọc theo lô (tối đa 256 Sectors = 128KB mỗi lệnh ATA) từ LBA %6 vào Arena
        jmp @b32 %11

    @b32 %29:bv64
        @inv ule %29 65535
        %30 = cmp ult %29 %25
        br %30 @b33 @b4

    @b33
        %50 = call std_sat_sub %25 %29      # rem = actual_sectors - i (>= 1)
        %51 = const 256 bv64
        %52 = call std_clamp %50 %24 %51    # batch_cnt = clamp(rem, 1, 256)
        %31 = add %22 %29                   # sec_slot = dst_sec_off + i
        %32 = const 65535 bv64
        %33 = call std_min %31 %32          # kẹp <= 65535
        %34 = const 6 bv64
        %35 = shl %33 %34                   # qword_off = sec_slot * 64 (<= 4194240)
        %36 = slice %4 %35 ptr<DiskQword,16384>
        %37 = add %6 %29                    # cur_lba = lba + i
        call drv_ata_read_sectors_batch %0 %36 %37 %52

        %53 = add %29 %52
        %38 = call std_min %53 %32
        jmp @b32 %38

    @b4
        ret
}

# Điều phối Đọc/Ghi Đĩa (định dạng 56 bit: lba[0..23] | n[24..39] | dst[40..55])
func app_dispatch_disk_io void %0:io<0,0xffff> %1:bv64 %2:bv64 %3:bv64 {
    @req ult %1 7

    @b0
        %9 = const 0xffffffffffffff bv64
        %10 = and %2 %9
        call app_dispatch_disk_io_old %0 %1 %10 %3
        ret
}

# =============================================================================
# 4. ĐỌC MEMORY MAP CỦA BOOTLOADER (Multiboot) ĐỂ BIẾT RAM THỰC TẾ
#    Boot stub (elf64.rs) sao chép sẵn: Multiboot Info (96B) -> 0x7d000, Memory Map (tối đa 0xF00B) -> 0x7d100.
#    Mỗi entry mmap dài 24B = size(4)=20 | base(8) | len(8) | type(4); mọi trường đều rơi vào Qword căn chỉnh 8B:
#      q[3k+0] = size | base_lo << 32      q[3k+1] = base_hi | len_lo << 32      q[3k+2] = len_hi | type << 32
# =============================================================================

func mem_info_q bv64 %0:ptr<DiskQword,512> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ult %1 512

    @b0
        %2 = slice %0 %1 ptr<DiskQword,1>
        %3 = load %2 0 bv64
        ret %3
}

func mem_mmap_q bv64 %0:ptr<DiskQword,480> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ult %1 480

    @b0
        %2 = slice %0 %1 ptr<DiskQword,1>
        %3 = load %2 0 bv64
        ret %3
}

# Ghi vào Bảng VMM %0: [3] = địa chỉ cao nhất của RAM khả dụng (byte), [4] = tổng RAM khả dụng (byte), [5] = tổng độ dài mmap (byte, đã kẹp 0xF00)
# Đồng thời tính [6] = tổng số khung 2MB khả dụng trong bể (128..16384 = tới 16GB) và khóa trước lỗ hổng PCI MMIO (3GB..4GB)
func vmm_probe_ram void %100:io<0,0xffff> %0:ptr<DiskQword,512> {
    @req uge %0 0x10000
    @req ult %0 0x80000000

    @b0
        %1 = const 0x7d000 ptr<DiskQword,512>
        %2 = const 0 bv64
        %3 = call mem_info_q %1 %2
        %4 = const 0x40 bv64
        %5 = and %3 %4
        %6 = cmp ne %5 %2
        br %6 @b1 @b9

    @b1
        %10 = const 5 bv64
        %11 = call mem_info_q %1 %10
        %12 = const 32 bv64
        %13 = lshr %11 %12
        %14 = const 0xf00 bv64
        %15 = call std_min %13 %14
        call vmm_tbl_set %0 %10 %15
        jmp @b2 %2

    @b2 %20:bv64
        @inv ule %20 160
        %21 = const 160 bv64
        %22 = cmp ult %20 %21
        br %22 @b3 @b9

    @b3
        %23 = const 24 bv64
        %24 = mul %20 %23
        %25 = add %24 %23
        %26 = const 5 bv64
        %27 = call vmm_tbl_get %0 %26
        %28 = cmp ule %25 %27
        br %28 @b4 @b9

    @b4
        %30 = const 0x7d100 ptr<DiskQword,480>
        %31 = const 3 bv64
        %32 = mul %20 %31
        %33 = call mem_mmap_q %30 %32
        %34 = const 0xffffffff bv64
        %35 = and %33 %34
        %36 = const 20 bv64
        %37 = cmp eq %35 %36
        br %37 @b5 @b9

    @b5
        %40 = const 32 bv64
        %41 = lshr %33 %40                  # base_lo
        %42 = const 1 bv64
        %43 = add %32 %42
        %44 = call mem_mmap_q %30 %43       # base_hi | len_lo << 32
        %45 = const 0xffffffff bv64
        %46 = and %44 %45                   # base_hi
        %47 = shl %46 %40
        %48 = or %41 %47                    # base
        %49 = lshr %44 %40                  # len_lo
        %50 = const 2 bv64
        %51 = add %32 %50
        %52 = call mem_mmap_q %30 %51       # len_hi | type << 32
        %53 = and %52 %45                   # len_hi
        %54 = shl %53 %40
        %55 = or %49 %54                    # len
        %56 = lshr %52 %40                  # type
        %57 = cmp eq %56 %42                # type 1 = RAM khả dụng
        br %57 @b6 @b8

    @b6
        %59 = const 0xffffffffffff bv64     # giới hạn 256TB vật lý (48-bit physical address)
        %480 = call std_min %48 %59
        %550 = call std_min %55 %59
        %60 = add %480 %550                 # end = base + len (không tràn bv64)
        %61 = const 3 bv64
        %62 = call vmm_tbl_get %0 %61
        %63 = call std_max %62 %60
        call vmm_tbl_set %0 %61 %63
        %64 = const 4 bv64
        %65 = call vmm_tbl_get %0 %64
        %650 = call std_min %65 %59
        %66 = add %650 %550
        call vmm_tbl_set %0 %64 %66
        jmp @b8

    @b8
        %70 = const 1 bv64
        %71 = add %20 %70
        jmp @b2 %71

    @b9
        # Xóa sạch toàn bộ 256 Qwords của Bảng VMM về 0 trước khi tính toán
        jmp @b90 %2

    @b90 %110:bv64
        @inv ule %110 512
        %111 = const 512 bv64
        %112 = cmp ult %110 %111
        br %112 @b91 @b92

    @b91
        %113 = const 128 bv64
        %114 = cmp uge %110 %113
        br %114 @b911 @b912

    @b911
        call vmm_tbl_set %0 %110 %2
        jmp @b912

    @b912
        %115 = const 1 bv64
        %116 = add %110 %115
        jmp @b90 %116

    @b92
        # Tính tổng số khung 2MB thực tế trong bể từ đỉnh địa chỉ RAM khả dụng ([3])
        %80 = const 3 bv64
        %81 = call vmm_tbl_get %0 %80
        %82 = const 0x12000000 bv64
        %83 = call std_sat_sub %81 %82
        %84 = const 21 bv64
        %85 = lshr %83 %84                  # total_pool_frames = (max_phys - 288MB) / 2MB
        %86 = const 128 bv64
        %87 = const 16384 bv64
        %88 = call std_clamp %85 %86 %87    # 128 .. 16384 khung (tối đa 16GB)
        %89 = const 6 bv64
        call vmm_tbl_set %0 %89 %88

        # Nếu RAM vượt qua mốc 3GB (> 1392 khung), đánh dấu khóa vùng PCI MMIO hole (3GB..4GB = khung 1392..1903 = Qwords 149..157)
        %90 = const 1392 bv64
        %91 = cmp ugt %88 %90
        br %91 @b10 @b12

    @b10
        %92 = const 149 bv64
        jmp @b11 %92

    @b11 %93:bv64
        @inv uge %93 149
        @inv ule %93 158
        %94 = const 158 bv64
        %95 = cmp ult %93 %94
        br %95 @b111 @b112

    @b111
        %96 = const 0xffffffffffffffff bv64
        call vmm_tbl_set %0 %93 %96
        %97 = const 1 bv64
        %98 = add %93 %97
        jmp @b11 %98

    @b112
        # Cộng 576 khung PCI hole đã khóa vào bộ đếm used ([2]) để tính free_frames chính xác
        %101 = const 2 bv64
        %102 = const 576 bv64
        call vmm_tbl_set %0 %101 %102
        jmp @b12

    @b12
        ret
}
