# File: lit_program/os/app_loader.lit
# LIGHT OS: Nạp App, cửa sổ ảo 64GB mỗi App & Bộ quản lý khung RAM vật lý 2MB
#
# MÔ HÌNH BỘ NHỚ CỦA MỖI APP (slot 0..6), cửa sổ ảo bắt đầu tại (slot+1) * 64GB:
#   - Trang 0 (+0MB)         : Code/Icon của App
#   - Trang 1..15 (+2..32MB) : Chunk 0..14 của Arena (Chunk 0 chứa State[0..63]); cả 16 trang được ánh xạ TĨNH
#                              từ khung vật lý (slot+2) * 32MB trong vmm_alloc_app_arena
#   - Chunk 15 trở lên       : cấp từ bể khung (VMM_POOL_BASE = 0x12000000) khi App ghi mem_req (IPC 168) hoặc khi
#                              đọc đĩa vào Arena; thu hồi khi App giảm mem_req hoặc đóng (xem mục 3b)
#
# BẢNG QUẢN TRỊ VMM (0x7f000, 512 Qwords):
#   xem mục 3b

include ../drivers/ata_disk.lit
include ../lib/cap_mem.lit
include ../lib/std_lib.lit
include ../lib/ipc_bus.lit

func vmm_tbl_get bv64 %0:ptr<DiskQword,512> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ult %1 512

    @b0
        %2 = slice %0 %1 ptr<DiskQword,1>
        %3 = load %2 0 bv64
        ret %3
}

func vmm_tbl_set void %0:ptr<DiskQword,512> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ult %1 512

    @b0
        %3 = slice %0 %1 ptr<DiskQword,1>
        store %3 0 %2
        ret
}

# 1. Cấp phát ĐỘNG 1 Lô 64GB mới trong Page Table lúc khởi tạo cho App thứ %3 (0..6) - mở khóa 16GB địa chỉ ảo (16 bảng PD)
func vmm_alloc_app_arena void %0:io<0,0xffff> %1:ptr<DiskQword,512> %2:ptr<DiskQword,131072> %3:bv64 {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req ult %3 7

    @b0
        %8 = const 1 bv64
        %9 = add %3 %8
        %10 = const 6 bv64
        %11 = shl %9 %10                    # pdpt_base = (app_idx + 1) * 64
        %40 = const 17 bv64
        %41 = shl %3 %40                    # app_idx * 131072 byte (32 PD x 4096)
        %42 = const 0xa00003 bv64           # PD_Pool tại 0xA00000 | Present | RW
        %43 = add %42 %41
        %44 = const 0 bv64
        jmp @b1 %44

    @b1 %45:bv64
        @inv ule %45 32
        %46 = const 32 bv64
        %47 = cmp ult %45 %46
        br %47 @b2 @b3

    @b2
        %48 = const 12 bv64
        %49 = shl %45 %48                   # pd_sub * 4096
        %50 = add %43 %49
        %51 = add %11 %45                   # pdpt_idx = pdpt_base + pd_sub
        %52 = slice %1 %51 ptr<DiskQword,1>
        store %52 0 %50
        %53 = add %45 %8
        jmp @b1 %53

    @b3
        %13 = const 14 bv64
        %14 = shl %3 %13                    # pd_base = app_idx * 16384 (32 PD * 512 entries)
        %15 = const 2 bv64
        %16 = add %3 %15
        %17 = const 25 bv64
        %18 = shl %16 %17                   # phys_base = (app_idx + 2) * 32MB
        %19 = const 0x83 bv64
        %20 = or %18 %19

        # Mở trọn vẹn 16 trang 2MB (32MB: 1 trang Code + 15 trang Arena) từ vùng RAM vật lý riêng của App!
        %60 = const 0 bv64
        jmp @b31 %60

    @b31 %61:bv64
        @inv ule %61 16
        %62 = const 16 bv64
        %63 = cmp ult %61 %62
        br %63 @b32 @b33

    @b32
        %64 = const 21 bv64
        %65 = shl %61 %64                   # page * 2MB
        %66 = add %20 %65                   # (phys_base + page*2MB) | 0x83
        %67 = add %14 %61                   # pd_idx = pd_base + page
        %68 = slice %2 %67 ptr<DiskQword,1>
        store %68 0 %66
        %69 = const 1 bv64
        %70 = add %61 %69
        jmp @b31 %70

    @b33
        # Ghi nhận App đang có tối thiểu 15 Chunk Arena tĩnh sẵn sàng trong RAM
        %27 = const 0x7f000 ptr<DiskQword,512>
        %28 = const 8 bv64
        %29 = add %28 %3
        %30 = call vmm_tbl_get %27 %29
        %31 = const 15 bv64
        %32 = call std_max %30 %31
        call vmm_tbl_set %27 %29 %32

        %26 = const 0x10000 bv64
        hwio_w %0 3 %26
        ret
}

