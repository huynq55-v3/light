# File: lit_program/os/app_loader.lit
# LIGHT OS: Bộ Cấp phát Lô 64GB & Điều phối Tổng quát theo Slot (0..6)

include ../drivers/ata_disk.lit
include ../lib/cap_mem.lit
include ../lib/std_lib.lit
include ../lib/ipc_bus.lit

# 1. Cấp phát ĐỘNG 1 Lô 64GB mới trong Page Table cho App thứ %3 (0..6)
func vmm_alloc_app_arena void %0:io<0,0xffff> %1:ptr<DiskQword,512> %2:ptr<DiskQword,4096> %3:bv64 {
    # %0: Root IO (để flush CR3), %1: Bảng PDPT (0x11000), %2: Bể bảng trang PD_Pool (0x20000), %3: app_idx
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req ult %3 7

    @b0
        # 1. Tính địa chỉ vật lý của bảng PD riêng cho App thứ %3: pd_phys = 0x20000 + app_idx * 4096
        %4 = const 12 bv64
        %5 = shl %3 %4
        %6 = const 0x20003 bv64             # 0x20000 | Present | RW (0x03)
        %7 = add %6 %5

        # 2. Ghi vào ô PDPT[(app_idx + 1) * 64] -> Mở khóa Lô 64GB tại địa chỉ ảo (app_idx + 1) * 64GB!
        %8 = const 1 bv64
        %9 = add %3 %8
        %10 = const 6 bv64
        %11 = shl %9 %10                    # pdpt_idx = (app_idx + 1) * 64
        %12 = slice %1 %11 ptr<DiskQword,1>
        store %12 0 %7

        # 3. Cấp phát 2 trang 2MB HugePage (Code + Heap) từ RAM vật lý (16MB + app_idx * 8MB) vào PD_Pool
        %13 = const 9 bv64
        %14 = shl %3 %13                    # pd_pool_qword_idx = app_idx * 512
        %15 = const 2 bv64
        %16 = add %3 %15
        %17 = const 23 bv64
        %18 = shl %16 %17                   # phys_base = (app_idx + 2) * 8MB
        %19 = const 0x83 bv64               # Present | RW | 2MB HugePage
        %20 = or %18 %19

        # Ghi trang Code (0..2MB của Lô 64GB)
        %21 = slice %2 %14 ptr<DiskQword,1>
        store %21 0 %20

        # Ghi trang Heap/Data (2..4MB của Lô 64GB)
        %22 = add %14 %8
        %23 = const 0x200000 bv64
        %24 = add %20 %23
        %25 = slice %2 %22 ptr<DiskQword,1>
        store %25 0 %24

        # 4. Làm mới thanh ghi CR3 (0x10000) để CPU kích hoạt ngay Lô 64GB vừa tạo!
        %26 = const 0x10000 bv64
        hwio_w %0 3 %26
        ret
}

# =============================================================================
# 2. CÁC HÀM HELPER LẤY CON TRỎ TỚI LÔ 64GB CỦA APP (DE-DUPLICATION)
# =============================================================================

# Lấy con trỏ vùng nhớ Persistent State (0xX000200000) của App thứ %1 (0..6)
func sys_get_app_state_ptr ptr<DiskQword,64> %0:io<0,0xffff> %1:bv64 {
    @req ult %1 7
    @ens uge %30 0x10000
    @ens ult %30 0x10000000000

    @b0
        %2 = const 0 bv64
        %3 = cmp eq %1 %2
        br %3 @b1 @b2

    @b1
        %20 = const 0x1000200000 ptr<DiskQword,64>
        jmp @b99 %20

    @b2
        %4 = const 1 bv64
        %5 = cmp eq %1 %4
        br %5 @b3 @b4

    @b3
        %21 = const 0x2000200000 ptr<DiskQword,64>
        jmp @b99 %21

    @b4
        %6 = const 2 bv64
        %7 = cmp eq %1 %6
        br %7 @b5 @b6

    @b5
        %22 = const 0x3000200000 ptr<DiskQword,64>
        jmp @b99 %22

    @b6
        %8 = const 3 bv64
        %9 = cmp eq %1 %8
        br %9 @b7 @b8

    @b7
        %23 = const 0x4000200000 ptr<DiskQword,64>
        jmp @b99 %23

    @b8
        %10 = const 4 bv64
        %11 = cmp eq %1 %10
        br %11 @b9 @b10

    @b9
        %24 = const 0x5000200000 ptr<DiskQword,64>
        jmp @b99 %24

    @b10
        %12 = const 5 bv64
        %13 = cmp eq %1 %12
        br %13 @b11 @b12

    @b11
        %25 = const 0x6000200000 ptr<DiskQword,64>
        jmp @b99 %25

    @b12
        %26 = const 0x7000200000 ptr<DiskQword,64>
        jmp @b99 %26

    @b99 %30:ptr<DiskQword,64>
        @inv uge %30 0x10000
        @inv ult %30 0x10000000000
        ret %30
}

# Lấy con trỏ hàm Entry chính (0xX000000000) của App thứ %1 (0..6)
func sys_get_app_code_ptr ptr<DiskQword,1> %0:io<0,0xffff> %1:bv64 {
    @req ult %1 7
    @ens uge %30 0x10000
    @ens ult %30 0x10000000000

    @b0
        %2 = const 0 bv64
        %3 = cmp eq %1 %2
        br %3 @b1 @b2

    @b1
        %20 = const 0x1000000000 ptr<DiskQword,1>
        jmp @b99 %20

    @b2
        %4 = const 1 bv64
        %5 = cmp eq %1 %4
        br %5 @b3 @b4

    @b3
        %21 = const 0x2000000000 ptr<DiskQword,1>
        jmp @b99 %21

    @b4
        %6 = const 2 bv64
        %7 = cmp eq %1 %6
        br %7 @b5 @b6

    @b5
        %22 = const 0x3000000000 ptr<DiskQword,1>
        jmp @b99 %22

    @b6
        %8 = const 3 bv64
        %9 = cmp eq %1 %8
        br %9 @b7 @b8

    @b7
        %23 = const 0x4000000000 ptr<DiskQword,1>
        jmp @b99 %23

    @b8
        %10 = const 4 bv64
        %11 = cmp eq %1 %10
        br %11 @b9 @b10

    @b9
        %24 = const 0x5000000000 ptr<DiskQword,1>
        jmp @b99 %24

    @b10
        %12 = const 5 bv64
        %13 = cmp eq %1 %12
        br %13 @b11 @b12

    @b11
        %25 = const 0x6000000000 ptr<DiskQword,1>
        jmp @b99 %25

    @b12
        %26 = const 0x7000000000 ptr<DiskQword,1>
        jmp @b99 %26

    @b99 %30:ptr<DiskQword,1>
        @inv uge %30 0x10000
        @inv ult %30 0x10000000000
        ret %30
}

# Lấy con trỏ hàm vẽ Icon Dock (0xX000000008) của App thứ %1 (0..6)
func sys_get_app_icon_ptr ptr<DiskQword,1> %0:io<0,0xffff> %1:bv64 {
    @req ult %1 7
    @ens uge %30 0x10000
    @ens ult %30 0x10000000000

    @b0
        %2 = const 0 bv64
        %3 = cmp eq %1 %2
        br %3 @b1 @b2

    @b1
        %20 = const 0x1000000008 ptr<DiskQword,1>
        jmp @b99 %20

    @b2
        %4 = const 1 bv64
        %5 = cmp eq %1 %4
        br %5 @b3 @b4

    @b3
        %21 = const 0x2000000008 ptr<DiskQword,1>
        jmp @b99 %21

    @b4
        %6 = const 2 bv64
        %7 = cmp eq %1 %6
        br %7 @b5 @b6

    @b5
        %22 = const 0x3000000008 ptr<DiskQword,1>
        jmp @b99 %22

    @b6
        %8 = const 3 bv64
        %9 = cmp eq %1 %8
        br %9 @b7 @b8

    @b7
        %23 = const 0x4000000008 ptr<DiskQword,1>
        jmp @b99 %23

    @b8
        %10 = const 4 bv64
        %11 = cmp eq %1 %10
        br %11 @b9 @b10

    @b9
        %24 = const 0x5000000008 ptr<DiskQword,1>
        jmp @b99 %24

    @b10
        %12 = const 5 bv64
        %13 = cmp eq %1 %12
        br %13 @b11 @b12

    @b11
        %25 = const 0x6000000008 ptr<DiskQword,1>
        jmp @b99 %25

    @b12
        %26 = const 0x7000000008 ptr<DiskQword,1>
        jmp @b99 %26

    @b99 %30:ptr<DiskQword,1>
        @inv uge %30 0x10000
        @inv ult %30 0x10000000000
        ret %30
}

# Lấy con trỏ bộ đệm nạp Code 16384 Qwords (128KB) của App thứ %1 (0..6)
func sys_get_app_code_buf_ptr ptr<DiskQword,16384> %0:io<0,0xffff> %1:bv64 {
    @req ult %1 7
    @ens uge %30 0x10000
    @ens ult %30 0x10000000000

    @b0
        %2 = const 0 bv64
        %3 = cmp eq %1 %2
        br %3 @b1 @b2

    @b1
        %20 = const 0x1000000000 ptr<DiskQword,16384>
        jmp @b99 %20

    @b2
        %4 = const 1 bv64
        %5 = cmp eq %1 %4
        br %5 @b3 @b4

    @b3
        %21 = const 0x2000000000 ptr<DiskQword,16384>
        jmp @b99 %21

    @b4
        %6 = const 2 bv64
        %7 = cmp eq %1 %6
        br %7 @b5 @b6

    @b5
        %22 = const 0x3000000000 ptr<DiskQword,16384>
        jmp @b99 %22

    @b6
        %8 = const 3 bv64
        %9 = cmp eq %1 %8
        br %9 @b7 @b8

    @b7
        %23 = const 0x4000000000 ptr<DiskQword,16384>
        jmp @b99 %23

    @b8
        %10 = const 4 bv64
        %11 = cmp eq %1 %10
        br %11 @b9 @b10

    @b9
        %24 = const 0x5000000000 ptr<DiskQword,16384>
        jmp @b99 %24

    @b10
        %12 = const 5 bv64
        %13 = cmp eq %1 %12
        br %13 @b11 @b12

    @b11
        %25 = const 0x6000000000 ptr<DiskQword,16384>
        jmp @b99 %25

    @b12
        %26 = const 0x7000000000 ptr<DiskQword,16384>
        jmp @b99 %26

    @b99 %30:ptr<DiskQword,16384>
        @inv uge %30 0x10000
        @inv ult %30 0x10000000000
        ret %30
}

# =============================================================================
# 3. CÁC HÀM ĐIỀU PHỐI TỔNG QUÁT THEO SLOT (0..6) ĐƯỢC THU GỌN BẰNG HELPER
# =============================================================================

func app_dispatch_entry void %0:io<0,0xffff> %1:ptr<VgaCell,921600> %2:ptr<IpcChannel,1> %3:ptr<DiskQword,64> %4:ptr<DiskQword,64> %5:ptr<DiskQword,64> %6:bv64 {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req uge %3 0x10000
    @req ult %3 0x80000000
    @req uge %4 0x10000
    @req ult %4 0x80000000
    @req uge %5 0x10000
    @req ult %5 0x80000000
    @req ult %6 7

    @b0
        %7 = call sys_get_app_code_ptr %0 %6
        %8 = call sys_get_app_state_ptr %0 %6
        call %7 %1 %2 %8 %3 %4 %5
        ret
}

func app_dispatch_draw_icon void %0:io<0,0xffff> %1:ptr<VgaCell,921600> %2:bv64 %3:bv64 %4:bv64 {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req ule %2 1200
    @req ule %3 650
    @req ult %4 7

    @b0
        %5 = call sys_get_app_icon_ptr %0 %4
        call %5 %1 %2 %3
        ret
}

func app_dispatch_load_app void %0:io<0,0xffff> %1:bv64 %2:bv64 {
    @req ult %1 7
    @req ult %2 16777216

    @b0
        %3 = call sys_get_app_code_buf_ptr %0 %1
        call drv_ata_load_app %0 %3 %2
        ret
}

func app_dispatch_zero_state void %0:io<0,0xffff> %1:bv64 {
    @req ult %1 7

    @b0
        %2 = call sys_get_app_state_ptr %0 %1
        call std_mem_zero %2
        ret
}

func app_dispatch_get_state bv64 %0:io<0,0xffff> %1:bv64 %2:bv64 {
    @req ult %1 7
    @req ult %2 64

    @b0
        %3 = call sys_get_app_state_ptr %0 %1
        %4 = call cap_state_get %3 %2
        ret %4
}

func app_dispatch_disk_io void %0:io<0,0xffff> %1:bv64 %2:bv64 %3:bv64 {
    # %1: app_slot (0..6), %2: lba (< 268435456), %3: is_write (0 = Read, 1 = Write)
    @req ult %1 7
    @req ult %2 268435456

    @b0
        %4 = call sys_get_app_state_ptr %0 %1
        %5 = const 0 bv64
        %6 = cmp ne %3 %5
        br %6 @b1 @b2

    @b1
        call drv_ata_write_sector %0 %4 %2
        ret

    @b2
        call drv_ata_read_sector %0 %4 %2
        ret
}

func app_dispatch_set_state void %0:io<0,0xffff> %1:bv64 %2:bv64 %3:bv64 {
    # %1: app_slot (0..6), %2: state index (0..63), %3: value
    @req ult %1 7
    @req ult %2 64

    @b0
        %4 = call sys_get_app_state_ptr %0 %1
        call cap_state_set %4 %2 %3
        ret
}
