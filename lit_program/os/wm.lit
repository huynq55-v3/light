func gfx_draw_cursor void %0:ptr<VgaCell,921600> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ult %1 1260
    @req ult %2 700

    @b0
        %3 = const 0x22d3ee bv32
        %4 = const 0x0f172a bv32

        %5 = const 1 bv64
        %6 = add %1 %5
        %7 = add %2 %5
        call gfx_put_pixel %0 %1 %2 %3
        call gfx_put_pixel %0 %6 %2 %3
        call gfx_put_pixel %0 %1 %7 %3

        %8 = const 2 bv64
        %9 = add %1 %8
        %10 = add %2 %8
        call gfx_put_pixel %0 %9 %2 %3
        call gfx_put_pixel %0 %6 %7 %3
        call gfx_put_pixel %0 %1 %10 %3

        %11 = const 3 bv64
        %12 = const 4 bv64
        %13 = add %1 %11
        %14 = add %2 %11
        %15 = add %1 %12
        %16 = add %2 %12
        call gfx_put_pixel %0 %13 %2 %3
        call gfx_put_pixel %0 %9 %7 %3
        call gfx_put_pixel %0 %6 %10 %3
        call gfx_put_pixel %0 %1 %14 %3

        call gfx_put_pixel %0 %15 %2 %3
        call gfx_put_pixel %0 %13 %7 %3
        call gfx_put_pixel %0 %9 %10 %3
        call gfx_put_pixel %0 %6 %14 %3
        call gfx_put_pixel %0 %1 %16 %3

        %17 = const 5 bv64
        %18 = const 6 bv64
        %19 = add %1 %17
        %20 = add %2 %17
        %21 = add %1 %18
        %22 = add %2 %18
        call gfx_put_pixel %0 %19 %2 %3
        call gfx_put_pixel %0 %15 %7 %3
        call gfx_put_pixel %0 %13 %10 %3
        call gfx_put_pixel %0 %9 %14 %3
        call gfx_put_pixel %0 %6 %16 %3
        call gfx_put_pixel %0 %1 %20 %3

        call gfx_put_pixel %0 %21 %2 %3
        call gfx_put_pixel %0 %19 %7 %3
        call gfx_put_pixel %0 %15 %10 %3
        call gfx_put_pixel %0 %13 %14 %3
        call gfx_put_pixel %0 %9 %16 %3
        call gfx_put_pixel %0 %6 %20 %3
        call gfx_put_pixel %0 %1 %22 %3

        %23 = const 7 bv64
        %24 = const 8 bv64
        %25 = add %1 %23
        %26 = add %2 %23
        %27 = add %1 %24
        %28 = add %2 %24
        call gfx_put_pixel %0 %25 %2 %3
        call gfx_put_pixel %0 %21 %7 %3
        call gfx_put_pixel %0 %19 %10 %3
        call gfx_put_pixel %0 %15 %14 %3
        call gfx_put_pixel %0 %13 %16 %3
        call gfx_put_pixel %0 %9 %20 %3
        call gfx_put_pixel %0 %6 %22 %3
        call gfx_put_pixel %0 %1 %26 %3

        call gfx_put_pixel %0 %27 %2 %3
        call gfx_put_pixel %0 %25 %7 %3
        call gfx_put_pixel %0 %21 %10 %3
        call gfx_put_pixel %0 %19 %14 %3
        call gfx_put_pixel %0 %15 %16 %3
        call gfx_put_pixel %0 %13 %20 %3
        call gfx_put_pixel %0 %9 %22 %3
        call gfx_put_pixel %0 %6 %26 %3
        call gfx_put_pixel %0 %1 %28 %3

        %29 = const 9 bv64
        %30 = const 10 bv64
        %31 = add %1 %29
        %32 = add %2 %29
        %33 = add %1 %30
        %34 = add %2 %30
        call gfx_put_pixel %0 %25 %10 %4
        call gfx_put_pixel %0 %21 %14 %4
        call gfx_put_pixel %0 %19 %16 %4
        call gfx_put_pixel %0 %15 %20 %4
        call gfx_put_pixel %0 %13 %22 %4
        call gfx_put_pixel %0 %9 %26 %4
        call gfx_put_pixel %0 %6 %28 %4
        call gfx_put_pixel %0 %1 %32 %3

        %35 = const 11 bv64
        %36 = const 12 bv64
        %37 = add %1 %35
        %38 = add %2 %35
        %39 = add %1 %36
        %40 = add %2 %36
        call gfx_put_pixel %0 %19 %20 %4
        call gfx_put_pixel %0 %15 %22 %4
        call gfx_put_pixel %0 %13 %26 %4
        call gfx_put_pixel %0 %9 %28 %4
        call gfx_put_pixel %0 %6 %32 %3
        call gfx_put_pixel %0 %1 %38 %3

        %41 = const 13 bv64
        %42 = const 14 bv64
        %43 = add %1 %41
        %44 = add %2 %41
        %45 = add %1 %42
        %46 = add %2 %42
        call gfx_put_pixel %0 %13 %28 %4
        call gfx_put_pixel %0 %9 %32 %4
        call gfx_put_pixel %0 %6 %38 %3
        call gfx_put_pixel %0 %1 %44 %3

        %47 = const 15 bv64
        %48 = const 16 bv64
        %49 = add %1 %47
        %50 = add %2 %47
        %51 = add %1 %48
        %52 = add %2 %48
        call gfx_put_pixel %0 %9 %38 %4
        call gfx_put_pixel %0 %6 %44 %3
        call gfx_put_pixel %0 %1 %50 %3

        %53 = const 17 bv64
        %54 = add %1 %53
        %55 = add %2 %53
        call gfx_put_pixel %0 %6 %50 %3
        call gfx_put_pixel %0 %1 %55 %3
        ret
}
# SHELL TỰ ĐỘNG RESET TOÀN DIỆN APP KHI NHẬN TÍN HIỆU ĐÓNG [X]:
# 1. Xóa sạch vùng nhớ State của App về 0 (như lần đầu tiên mở lên)
# 2. Dừng toàn bộ các nhân SMP Worker nếu App đang chạy đa nhân
# 3. Xóa bit chạy ngầm của App trong ipc_bg_mask (offset 152)
# 4. Reset các cờ cửa sổ trên IpcChannel
# 5. Xóa cửa sổ trên Backbuffer & đưa IpcChannel về trạng thái rảnh
func shell_close_and_reset_app void %0:io<0,0xffff> %1:ptr<VgaCell,921600> %2:ptr<IpcChannel,1> %3:smp %4:bv64 {
    # %1: backbuffer, %2: ipc, %3: thẻ smp (không dùng: `parallel` luôn chờ worker xong nên không còn worker treo), %4: app_slot (0..6)
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req ult %4 7

    @b0
        # 1. Reset vùng nhớ Persistent State của App thứ %4 về 0!
        call app_dispatch_zero_state %0 %4

        # 1b. Trả toàn bộ Chunk RAM động (1..16382) của App %4 về Bể Khung RAM của Kernel
        %60 = const 0xa00000 ptr<DiskQword,131072>
        %61 = call sys_get_vmm_table %0
        call vmm_free_app_chunks %0 %60 %61 %4

        # 3. Xóa bit chạy ngầm của slot %4 trong ipc_bg_mask (offset 152)
        %5 = const 1 bv64
        %6 = shl %5 %4
        %7 = const 0xffffffffffffffff bv64
        %8 = xor %6 %7
        %9 = load %2 152 bv64
        %10 = and %9 %8
        store %2 152 %10

        # 4. Reset các cờ cửa sổ trên IpcChannel
        %11 = const 0 bv64
        store %2 0 %11
        store %2 32 %11
        store %2 56 %11
        store %2 88 %11
        store %2 96 %11
        store %2 104 %11
        store %2 112 %11

        # 5. Xóa sạch vùng cửa sổ trên màn hình Desktop
        %12 = const 180 bv64
        %13 = const 50 bv64
        %14 = const 1100 bv64
        %15 = const 615 bv64
        %16 = const 0x161b26 bv32
        call gfx_fill_rect %1 %12 %13 %14 %15 %16
        call ui_invalidate_rect %2 %12 %13 %14 %15
        ret
}

# Điều phối nhịp chạy ngầm tổng quát dựa trên Bitmask (offset 152) — Không phụ thuộc vào bất kỳ App cụ thể nào
func shell_bg_tick_apps void %0:io<0,0xffff> %1:ptr<VgaCell,921600> %2:ptr<IpcChannel,1> %3:ptr<DiskQword,64> %4:ptr<DiskQword,64> %5:smp {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req uge %3 0x10000
    @req ult %3 0x80000000
    @req uge %4 0x10000
    @req ult %4 0x80000000

    @b0
        %6 = load %2 152 bv64               # ipc_bg_mask
        %7 = load %2 56 bv64                # active_app (1..7)
        %8 = const 0 bv64
        %9 = cmp eq %6 %8
        br %9 @b5 @b6

    @b6
        jmp @b1 %8

    @b1 %10:bv64
        @inv ule %10 7
        %11 = const 7 bv64
        %12 = cmp ult %10 %11
        br %12 @b2 @b5

    @b2
        %13 = const 1 bv64
        %14 = add %10 %13
        %15 = cmp eq %14 %7                 # Nếu đang là Foreground App thì đã chạy ở luồng chính rồi
        br %15 @b4 @b21

    @b21
        %16 = shl %13 %10
        %17 = and %6 %16
        %18 = cmp ne %17 %8
        br %18 @b3 @b4

    @b3
        call app_dispatch_entry %0 %1 %2 %3 %4 %5 %10
        jmp @b4

    @b4
        %19 = add %10 %13
        jmp @b1 %19

    @b5
        ret
}

# =============================================================================
# THANH DOCK TỰ ĐỘNG QUÉT VFS VÀ CẤP PHÁT LÔ 64GB CHO TỐI ĐA 7 APPS
# =============================================================================
func dock_render_bar void %0:io<0,0xffff> %1:ptr<VgaCell,921600> %2:ptr<IpcChannel,1> %3:ptr<DiskQword,64> {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req uge %3 0x10000
    @req ult %3 0x80000000

    @b0
        # Nền thanh Dock động căn giữa màn hình (rộng 510px, x: 385..895)
        %6 = const 385 bv64
        %7 = const 895 bv64
        %8 = const 630 bv64
        %9 = const 712 bv64
        %10 = const 0x0b0e14 bv32
        call gfx_fill_rect %1 %6 %8 %7 %9 %10

        %11 = const 381 bv64
        %12 = const 891 bv64
        %13 = const 624 bv64
        %14 = const 706 bv64
        %15 = const 0x262f45 bv32
        call gfx_fill_rect %1 %11 %13 %12 %14 %15

        %16 = const 626 bv64
        %17 = const 0x566991 bv32
        call gfx_fill_rect %1 %11 %13 %12 %16 %17

        # Vòng lặp duyệt tất cả các App slot 0..6 trong VFS
        %18 = const 0 bv64
        jmp @b1 %18

    @b1 %19:bv64
        @inv ule %19 7
        %20 = const 7 bv64
        %21 = cmp ult %19 %20
        br %21 @b2 @b5

    @b2
        %22 = call vfs_entry_is_app %3 %19
        %23 = const 0 bv64
        %24 = cmp ne %22 %23
        br %24 @b3 @b4

    @b3
        # Tự động cấp phát Lô 64GB độc lập cho App thứ %19
        %31 = const 0x11000 ptr<DiskQword,512>
        %32 = const 0xa00000 ptr<DiskQword,131072>
        call vmm_alloc_app_arena %0 %31 %32 %19
        call app_dispatch_zero_state %0 %19

        # Nạp binary của App từ VFS vào Lô Code tương ứng
        %33 = call vfs_entry_get_lba %3 %19
        call app_dispatch_load_app %0 %19 %33

        # Tự động tính tọa độ hiển thị icon của từng App trên Dock
        %34 = const 70 bv64
        %35 = mul %19 %34
        %36 = const 395 bv64
        %37 = add %36 %35
        %38 = const 634 bv64
        call app_dispatch_draw_icon %0 %1 %37 %38 %19
        jmp @b4

    @b4
        %39 = const 1 bv64
        %40 = add %19 %39
        jmp @b1 %40

    @b5
        call ui_invalidate_rect %2 %11 %13 %7 %9
        ret
}

# =============================================================================
# IPC VÀ ĐIỀU PHỐI CỬA SỔ DESKTOP KHÔNG CÒN HARDCODE APP
# =============================================================================
func app_desktop_ipc_task void %0:io<0,0xffff> %1:ptr<VgaCell,921600> %2:ptr<VgaCell,921600> %3:ptr<IpcChannel,1> %4:ptr<DiskQword,64> {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req uge %3 0x10000
    @req ult %3 0x80000000
    @req uge %4 0x10000
    @req ult %4 0x80000000

    @b0
        %9 = const 0x7c000 ptr<DiskQword,64>
        %10 = load %3 16 bv64
        %11 = load %3 24 bv64
        %12 = load %3 32 bv64
        %13 = const 0 bv64
        %14 = const 1 bv64
        %15 = const 2 bv64
        %44 = load %3 64 bv64
        %45 = load %3 72 bv64
        %95 = const 0x7e000 smp

        %16 = cmp ne %12 %13
        br %16 @b1 @b20

    @b1
        %17 = const 624 bv64
        %18 = cmp uge %11 %17
        br %18 @b2 @b18

    @b18
        %65 = load %3 56 bv64
        %66 = cmp ne %65 %13
        br %66 @b8 @b19

    @b19
        store %3 32 %13
        jmp @b6

    @b2
        # Vùng click Dock: x trong [390..880]
        %19 = const 390 bv64
        %20 = const 880 bv64
        %21 = cmp uge %10 %19
        %22 = cmp ult %10 %20
        %23 = and %21 %22
        br %23 @b3 @b19

    @b3
        # Tự động tính slot được click: clicked_slot = (mouse_x - 390) / 70
        %24 = sub %10 %19
        %25 = const 70 bv64
        %26 = udiv %24 %25
        %27 = call vfs_entry_is_app %4 %26
        %28 = cmp ne %27 %13
        br %28 @b4 @b19

    @b4
        # Lấy App đang mở hiện tại trước khi switch
        %100 = load %3 56 bv64
        %30 = add %26 %14
        %101 = cmp ne %100 %30
        br %101 @b41 @b42

    @b41
        # Khi chuyển sang App khác: Xóa sạch vùng cửa sổ làm việc cũ trên Backbuffer (%2) và VRAM
        %102 = const 180 bv64
        %103 = const 50 bv64
        %104 = const 1100 bv64
        %105 = const 615 bv64
        %106 = const 0x161b26 bv32
        call gfx_fill_rect %2 %102 %103 %104 %105 %106
        call ui_invalidate_rect %3 %102 %103 %104 %105
        jmp @b42

    @b42
        store %3 0 %13
        store %3 56 %30
        store %3 32 %13
        store %3 88 %13
        store %3 112 %13
        jmp @b8

    @b20
        %71 = load %3 0 bv64
        %72 = load %3 56 bv64
        %73 = cmp ne %71 %13
        %74 = cmp ne %72 %13
        br %74 @b201 @b6

    @b201
        # Kiểm tra xem CHÍNH Foreground App hiện tại (%72) có bật bit chạy liên tục trong ipc_bg_mask (offset 152) không
        %96 = load %3 152 bv64
        %97 = sub %72 %14
        %98 = shl %14 %97
        %99 = and %96 %98
        %108 = cmp ne %99 %13
        %109 = or %73 %108
        br %109 @b8 @b6

    @b8
        %50 = load %3 56 bv64
        %51 = cmp ne %50 %13
        br %51 @b81 @b6

    @b81
        %52 = sub %50 %14
        %200 = const 7 bv64
        %201 = cmp ult %52 %200
        br %201 @b82 @b6

    @b82
        call app_dispatch_entry %0 %2 %3 %9 %4 %95 %52
        store %3 32 %13

        # Kiểm tra xem App có vừa phát tín hiệu bấm nút [X] (offset 88 != 0) không?
        %53 = call ipc_win_take_close_req %3
        %54 = cmp ne %53 %13
        br %54 @b14 @b15

    @b14
        # Shell đứng ra đóng cửa sổ và Reset toàn bộ trạng thái của App %52 về như mới!
        call shell_close_and_reset_app %0 %2 %3 %95 %52
        jmp @b6

    @b15
        # Kiểm tra yêu cầu đọc đĩa từ App %52
        %55 = call ipc_disk_take_read_req %3
        %56 = cmp ne %55 %13
        br %56 @b13 @b16

    @b13
        call app_dispatch_disk_io %0 %52 %55 %13
        call app_dispatch_entry %0 %2 %3 %9 %4 %95 %52
        jmp @b6

    @b16
        # Kiểm tra yêu cầu ghi đĩa từ App %52
        %60 = call ipc_disk_take_write_req %3
        %61 = cmp ne %60 %13
        br %61 @b17 @b6

    @b17
        call app_dispatch_disk_io %0 %52 %60 %14
        call app_dispatch_entry %0 %2 %3 %9 %4 %95 %52
        jmp @b6

    @b6
        # Điều phối nhịp chạy ngầm tổng quát cho các App đăng ký trong ipc_bg_mask
        call shell_bg_tick_apps %0 %2 %3 %9 %4 %95

        %37 = load %3 80 bv64
        %38 = cmp ne %37 %13
        br %38 @b7 @b10

    @b7
        store %3 80 %13

        %80 = const 12 bv64
        %81 = const 18 bv64
        %82 = add %44 %80
        %83 = add %45 %81
        call gfx_blit_rect %1 %2 %44 %45 %82 %83
        call fb_present_rect %0 %1 %44 %45 %82 %83

        %84 = load %3 120 bv64
        %85 = load %3 128 bv64
        %86 = load %3 136 bv64
        %87 = load %3 144 bv64
        call gfx_blit_rect %1 %2 %84 %85 %86 %87
        call fb_present_rect %0 %1 %84 %85 %86 %87

        call gfx_draw_cursor %1 %10 %11
        %800 = add %10 %80
        %801 = add %11 %81
        call fb_present_rect %0 %1 %10 %11 %800 %801
        store %3 64 %10
        store %3 72 %11
        jmp @b12

    @b10
        %46 = cmp ne %10 %44
        %47 = cmp ne %11 %45
        %48 = or %46 %47
        br %48 @b11 @b12

    @b11
        %88 = const 12 bv64
        %89 = const 18 bv64
        %90 = add %44 %88
        %91 = add %45 %89
        call gfx_blit_rect %1 %2 %44 %45 %90 %91
        call fb_present_rect %0 %1 %44 %45 %90 %91
        call gfx_draw_cursor %1 %10 %11
        %802 = add %10 %88
        %803 = add %11 %89
        call fb_present_rect %0 %1 %10 %11 %802 %803
        store %3 64 %10
        store %3 72 %11
        jmp @b12

    @b12
        ret
}
