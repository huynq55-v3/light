func gfx_draw_cursor void %0:ptr<VgaCell,2073600> %1:bv64 %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ult %1 1900
    @req ult %2 1060

    @b0
        %3 = const 0x22d3ee bv32
        %4 = const 0x0f172a bv32

        %5 = const 1 bv64
        %6 = add %1 %5
        %7 = add %2 %5
        call gfx_put_pixel_scr %0 %1 %2 %3
        call gfx_put_pixel_scr %0 %6 %2 %3
        call gfx_put_pixel_scr %0 %1 %7 %3

        %8 = const 2 bv64
        %9 = add %1 %8
        %10 = add %2 %8
        call gfx_put_pixel_scr %0 %9 %2 %3
        call gfx_put_pixel_scr %0 %6 %7 %3
        call gfx_put_pixel_scr %0 %1 %10 %3

        %11 = const 3 bv64
        %12 = const 4 bv64
        %13 = add %1 %11
        %14 = add %2 %11
        %15 = add %1 %12
        %16 = add %2 %12
        call gfx_put_pixel_scr %0 %13 %2 %3
        call gfx_put_pixel_scr %0 %9 %7 %3
        call gfx_put_pixel_scr %0 %6 %10 %3
        call gfx_put_pixel_scr %0 %1 %14 %3

        call gfx_put_pixel_scr %0 %15 %2 %3
        call gfx_put_pixel_scr %0 %13 %7 %3
        call gfx_put_pixel_scr %0 %9 %10 %3
        call gfx_put_pixel_scr %0 %6 %14 %3
        call gfx_put_pixel_scr %0 %1 %16 %3

        %17 = const 5 bv64
        %18 = const 6 bv64
        %19 = add %1 %17
        %20 = add %2 %17
        %21 = add %1 %18
        %22 = add %2 %18
        call gfx_put_pixel_scr %0 %19 %2 %3
        call gfx_put_pixel_scr %0 %15 %7 %3
        call gfx_put_pixel_scr %0 %13 %10 %3
        call gfx_put_pixel_scr %0 %9 %14 %3
        call gfx_put_pixel_scr %0 %6 %16 %3
        call gfx_put_pixel_scr %0 %1 %20 %3

        call gfx_put_pixel_scr %0 %21 %2 %3
        call gfx_put_pixel_scr %0 %19 %7 %3
        call gfx_put_pixel_scr %0 %15 %10 %3
        call gfx_put_pixel_scr %0 %13 %14 %3
        call gfx_put_pixel_scr %0 %9 %16 %3
        call gfx_put_pixel_scr %0 %6 %20 %3
        call gfx_put_pixel_scr %0 %1 %22 %3

        %23 = const 7 bv64
        %24 = const 8 bv64
        %25 = add %1 %23
        %26 = add %2 %23
        %27 = add %1 %24
        %28 = add %2 %24
        call gfx_put_pixel_scr %0 %25 %2 %3
        call gfx_put_pixel_scr %0 %21 %7 %3
        call gfx_put_pixel_scr %0 %19 %10 %3
        call gfx_put_pixel_scr %0 %15 %14 %3
        call gfx_put_pixel_scr %0 %13 %16 %3
        call gfx_put_pixel_scr %0 %9 %20 %3
        call gfx_put_pixel_scr %0 %6 %22 %3
        call gfx_put_pixel_scr %0 %1 %26 %3

        call gfx_put_pixel_scr %0 %27 %2 %3
        call gfx_put_pixel_scr %0 %25 %7 %3
        call gfx_put_pixel_scr %0 %21 %10 %3
        call gfx_put_pixel_scr %0 %19 %14 %3
        call gfx_put_pixel_scr %0 %15 %16 %3
        call gfx_put_pixel_scr %0 %13 %20 %3
        call gfx_put_pixel_scr %0 %9 %22 %3
        call gfx_put_pixel_scr %0 %6 %26 %3
        call gfx_put_pixel_scr %0 %1 %28 %3

        %29 = const 9 bv64
        %30 = const 10 bv64
        %31 = add %1 %29
        %32 = add %2 %29
        %33 = add %1 %30
        %34 = add %2 %30
        call gfx_put_pixel_scr %0 %25 %10 %4
        call gfx_put_pixel_scr %0 %21 %14 %4
        call gfx_put_pixel_scr %0 %19 %16 %4
        call gfx_put_pixel_scr %0 %15 %20 %4
        call gfx_put_pixel_scr %0 %13 %22 %4
        call gfx_put_pixel_scr %0 %9 %26 %4
        call gfx_put_pixel_scr %0 %6 %28 %4
        call gfx_put_pixel_scr %0 %1 %32 %3

        %35 = const 11 bv64
        %36 = const 12 bv64
        %37 = add %1 %35
        %38 = add %2 %35
        %39 = add %1 %36
        %40 = add %2 %36
        call gfx_put_pixel_scr %0 %19 %20 %4
        call gfx_put_pixel_scr %0 %15 %22 %4
        call gfx_put_pixel_scr %0 %13 %26 %4
        call gfx_put_pixel_scr %0 %9 %28 %4
        call gfx_put_pixel_scr %0 %6 %32 %3
        call gfx_put_pixel_scr %0 %1 %38 %3

        %41 = const 13 bv64
        %42 = const 14 bv64
        %43 = add %1 %41
        %44 = add %2 %41
        %45 = add %1 %42
        %46 = add %2 %42
        call gfx_put_pixel_scr %0 %13 %28 %4
        call gfx_put_pixel_scr %0 %9 %32 %4
        call gfx_put_pixel_scr %0 %6 %38 %3
        call gfx_put_pixel_scr %0 %1 %44 %3

        %47 = const 15 bv64
        %48 = const 16 bv64
        %49 = add %1 %47
        %50 = add %2 %47
        %51 = add %1 %48
        %52 = add %2 %48
        call gfx_put_pixel_scr %0 %9 %38 %4
        call gfx_put_pixel_scr %0 %6 %44 %3
        call gfx_put_pixel_scr %0 %1 %50 %3

        %53 = const 17 bv64
        %54 = add %1 %53
        %55 = add %2 %53
        call gfx_put_pixel_scr %0 %6 %50 %3
        call gfx_put_pixel_scr %0 %1 %55 %3
        ret
}
# SHELL TỰ ĐỘNG RESET TOÀN DIỆN APP KHI NHẬN TÍN HIỆU ĐÓNG [X]:
# 1. Xóa sạch vùng nhớ State của App về 0 (như lần đầu tiên mở lên)
# 2. Dừng toàn bộ các nhân SMP Worker nếu App đang chạy đa nhân
# 3. Xóa bit chạy ngầm của App trong ipc_bg_mask (offset 152)
# 4. Reset các cờ cửa sổ trên IpcChannel
# 5. Xóa cửa sổ trên Backbuffer & đưa IpcChannel về trạng thái rảnh
func shell_close_and_reset_app void %0:io<0,0xffff> %1:ptr<VgaCell,1382400> %2:ptr<IpcChannel,1> %3:smp %4:bv64 {
    # %1: backbuffer, %2: ipc, %3: thẻ smp (không dùng: `parallel` luôn chờ worker xong nên không còn worker treo), %4: app_slot (0..6)
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req ult %4 7

    @b0
        # 1. Reset vùng nhớ Persistent State của App thứ %4 về 0!
        call app_dispatch_zero_state %0 %4
        %chn = call app_chan %0 %4
        call ipc_channel_init %chn
        call comp_clear_slot %0 %4               # surface sạch: App mở lại không thấy điểm ảnh cũ

        # 1b. Trả toàn bộ Chunk RAM động (1..16382) của App %4 về Bể Khung RAM của Kernel
        %60 = const 0xa00000 ptr<DiskQword,131072>
        %61 = call sys_get_vmm_table %0
        call vmm_free_app_chunks %0 %60 %61 %4

        # 3. Xóa bit chạy ngầm của slot %4 trong ipc_bg_mask (offset 152)
        %5 = const 1 bv64
        %6 = shl %5 %4
        %7 = const 0xffffffffffffffff bv64
        %8 = xor %6 %7
        %9 = load %2 152 bv64
        %10 = and %9 %8
        store %2 152 %10

        # 4. Reset các cờ cửa sổ trên IpcChannel
        %11 = const 0 bv64
        store %2 0 %11
        store %2 32 %11
        store %2 56 %11
        store %2 88 %11
        store %2 96 %11
        store %2 104 %11
        store %2 112 %11

        # 5. Gỡ cửa sổ khỏi cảnh compositor: cửa sổ kế tiếp lên foreground, vẽ lại khung nhìn
        call comp_close %0 %1 %2 %4
        ret
}

# Điều phối nhịp chạy ngầm tổng quát dựa trên Bitmask (offset 152) — Không phụ thuộc vào bất kỳ App cụ thể nào
func shell_bg_tick_apps void %0:io<0,0xffff> %1:ptr<VgaCell,1382400> %2:ptr<IpcChannel,1> %3:ptr<DiskQword,64> %4:ptr<DiskQword,64> %5:smp {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req uge %3 0x10000
    @req ult %3 0x80000000
    @req uge %4 0x10000
    @req ult %4 0x80000000

    @b0
        %6 = load %2 152 bv64               # ipc_bg_mask
        %7 = load %2 56 bv64                # active_app (1..7)
        %8 = const 0 bv64
        %9 = cmp eq %6 %8
        br %9 @b5 @b6

    @b6
        jmp @b1 %8

    @b1 %10:bv64
        @inv ule %10 7
        %11 = const 7 bv64
        %12 = cmp ult %10 %11
        br %12 @b2 @b5

    @b2
        %13 = const 1 bv64
        %14 = add %10 %13
        %15 = cmp eq %14 %7                 # Nếu đang là Foreground App thì đã chạy ở luồng chính rồi
        br %15 @b4 @b21

    @b21
        %16 = shl %13 %10
        %17 = and %6 %16
        %18 = cmp ne %17 %8
        br %18 @b3 @b4

    @b3
        call app_dispatch_entry %0 %1 %2 %3 %4 %5 %10
        jmp @b4

    @b4
        %19 = add %10 %13
        jmp @b1 %19

    @b5
        ret
}

# =============================================================================
# DOCK (lát 6): cầu nối kernel. Phần vẽ thuần ở os/dock.lit; ở đây chỉ những việc cần io: nạp App, đọc tên trong
# LightFS, gọi mã App vẽ icon, đưa vùng Dock lên màn hình.
# =============================================================================
func dock_ds ptr<DockState,1> %io:io<0,0xffff> {
    @b0
        %d = const 0x79e00 ptr<DockState,1>
        ret %d
}

# Lúc boot: cấp Lô 64GB + nạp mã cho mọi App trong apps/ (slot 0..6, gán bởi lfs_scan_apps), ghi tên + bố cục Dock
func dock_load_apps void %io:io<0,0xffff> %g:ptr<IpcChannel,1> {
    @b0
        %ds = call dock_ds %io
        jmp @l 0 0 0
    @l %i:bv64 %n:bv64 %m:bv64
        @inv ule %i 7
        @inv ule %n %i
        @inv ult %m 128
        %more = cmp ult %i 7
        br %more @slot @done
    @slot
        %has = call lfs_app_present %io %i
        %hp = cmp ne %has 0
        br %hp @load @next
    @load
        %pt = const 0x11000 ptr<DiskQword,512>
        %ar = const 0xa00000 ptr<DiskQword,131072>
        call vmm_alloc_app_arena %io %pt %ar %i
        call app_dispatch_zero_state %io %i
        %ok = call app_dispatch_load_app %io %i
        %okp = cmp ne %ok 0
        br %okp @name @next
    @name
        %si = add %i 24
        %fid = call lfs_sget %io %si
        %fz = cmp ne %fid 0
        %fl = cmp ule %fid 256
        %fok = and %fz %fl
        br %fok @rd @noname
    @noname
        jmp @mark 0
    @rd
        %tab = call lfs_tab %io
        %idx = sub %fid 1
        %nm = call lfs_tget %tab %idx 8
        jmp @mark %nm
    @mark %v:bv64
        call dk_set_name %ds %i %v
        %bit = shl 1 %i
        %m1 = or %m %bit
        %n1 = add %i 1
        %i1 = add %i 1
        jmp @l %i1 %n1 %m1
    @next
        %i2 = add %i 1
        jmp @l %i2 %n %m
    @done
        store %ds DockState.n %n
        store %ds DockState.present %m
        %x0 = call dk_layout_x0 %n
        store %ds DockState.x0 %x0
        store %ds DockState.drawn 0
        store %ds DockState.hover 7
        store %ds DockState.focus 7
        store %ds DockState.run 0
        %kx = add %x0 360                   # 320 + x0 + 14 + 26 = tâm icon ô 0 trên màn hình
        store %g IpcChannel.dock_x0 %kx
        ret
}

# Vẽ lại toàn bộ Dock vào bộ đệm sau theo DockState
func dock_redraw void %io:io<0,0xffff> %back:ptr<VgaCell,2073600> {
    @req uge %back 0x10000
    @req ult %back 0x40000000
    @b0
        %ds = call dock_ds %io
        %v = slice %back 689600 ptr<VgaCell,1382400>
        call dk_draw_base %v %ds
        %n = load %ds DockState.n
        %x0 = load %ds DockState.x0
        %pm = load %ds DockState.present
        jmp @l 0
    @l %i:bv64
        @inv ule %i 7
        %more = cmp ult %i %n
        br %more @slot @out
    @slot
        %bit = shl 1 %i
        %p0 = and %pm %bit
        %p = cmp ne %p0 0
        br %p @icon @next
    @icon
        %ix = call dk_icon_x %x0 %i
        %iy = call dk_icon_y %ds %i
        call app_dispatch_draw_icon %io %v %ix %iy %i
        %uc = call dk_icon_under %ds %i
        call dk_round_icon %v %ix %iy %uc
        jmp @next
    @next
        %i1 = add %i 1
        jmp @l %i1
    @out
        ret
}

# Mỗi nhịp WM: tính ô đang rê chuột, App đang mở / focus; đổi -> vẽ lại Dock, đưa lên màn hình, vẽ lại con trỏ
func dock_tick void %io:io<0,0xffff> %front:ptr<VgaCell,2073600> %back:ptr<VgaCell,2073600> %g:ptr<IpcChannel,1> {
    @req uge %front 0x10000
    @req ult %front 0x40000000
    @req uge %back 0x10000
    @req ult %back 0x40000000
    @b0
        %ds = call dock_ds %io
        %sx = load %g IpcChannel.scr_x
        %sy = load %g IpcChannel.scr_y
        # Phím F vừa đặt chuột lên ô Dock: ghi nhớ chỗ đó, không hover cho tới khi chuột thật di chuyển
        %kp = load %g IpcChannel.kbd_pick
        %kpn = cmp ne %kp 0
        br %kpn @kset @kchk
    @kset
        store %g IpcChannel.kbd_pick 0
        store %ds DockState.kbd 1
        store %ds DockState.kx %sx
        store %ds DockState.ky %sy
        jmp @hov
    @kchk
        %kb = load %ds DockState.kbd
        %kbn = cmp ne %kb 0
        br %kbn @kcmp @hov
    @kcmp
        %kx = load %ds DockState.kx
        %ky = load %ds DockState.ky
        %mx = cmp ne %kx %sx
        %my = cmp ne %ky %sy
        %mv = or %mx %my
        br %mv @kclr @hov
    @kclr
        store %ds DockState.kbd 0
        jmp @hov
    @hov
        %h1 = call dk_hit %ds %sx %sy
        %kb2 = load %ds DockState.kbd
        %kon = cmp ne %kb2 0
        br %kon @hk @hn
    @hk
        jmp @hsel 7
    @hn
        jmp @hsel %h1
    @hsel %h0:bv64
        @inv ule %h0 7
        %pm = load %ds DockState.present
        %hb = shl 1 %h0
        %hp0 = and %pm %hb
        %hp = cmp ne %hp0 0
        br %hp @hv @nohv
    @nohv
        jmp @hv2 7
    @hv
        jmp @hv2 %h0
    @hv2 %hov:bv64
        @inv ule %hov 7
        %act = load %g IpcChannel.active_app
        %fg = cmp ne %act 0
        br %fg @fa @fn
    @fa
        %f = sub %act 1
        %fb = shl 1 %f
        jmp @st %f %fb
    @fn
        jmp @st 7 0
    @st %foc:bv64 %fbit:bv64
        @inv ule %foc 7
        @inv ult %fbit 128
        %cm = call comp_run_mask %io
        %run = or %cm %fbit
        %od = load %ds DockState.drawn
        %oh = load %ds DockState.hover
        %or = load %ds DockState.run
        %of = load %ds DockState.focus
        %c0 = cmp eq %od 0
        %c1 = cmp ne %oh %hov
        %c2 = cmp ne %or %run
        %c3 = cmp ne %of %foc
        %c01 = or %c0 %c1
        %c23 = or %c2 %c3
        %ch = or %c01 %c23
        br %ch @draw @same
    @draw
        store %ds DockState.hover %hov
        store %ds DockState.run %run
        store %ds DockState.focus %foc
        store %ds DockState.drawn 1
        call dock_redraw %io %back
        # vùng Dock trên màn hình: x [320, 1600), y [359 + 580, 1079)
        call gfx_blit_rect %front %back 320 939 1600 1079
        call fb_present_rect %io %front 320 939 1600 1079
        %cx = load %g IpcChannel.cursor_x
        %cy = load %g IpcChannel.cursor_y
        call gfx_draw_cursor %front %cx %cy
        %cx2 = add %cx 12
        %cy2 = add %cy 18
        call fb_present_rect %io %front %cx %cy %cx2 %cy2
        ret
    @same
        ret
}

# =============================================================================
# THANH TRÊN CÙNG: cầu nối (đọc RTC, đưa lên màn hình). Phần vẽ thuần ở os/topbar.lit
# =============================================================================
func tb_state ptr<TopState,1> %io:io<0,0xffff> {
    @b0
        %t = const 0x79f00 ptr<TopState,1>
        ret %t
}

func rtc_reg bv64 %io:io<0,0xffff> %r:bv8 {
    @b0
        hwio_w %io 0x70 %r
        %v = hwio_r %io 0x71
        %b = and %v 0xff
        ret %b
}

# Đọc RTC (chờ hết chu kỳ cập nhật, có giới hạn). Trả phút | giờ << 8 | ngày << 16 | tháng << 24 | năm << 32 (nhị phân, 24h)
func rtc_read bv64 %io:io<0,0xffff> {
    @b0
        jmp @w 0
    @w %i:bv64
        @inv ule %i 100000
        %more = cmp ult %i 100000
        br %more @poll @read
    @poll
        %a = call rtc_reg %io 0x0a:bv8
        %uip = and %a 0x80
        %busy = cmp ne %uip 0
        br %busy @next @read
    @next
        %i1 = add %i 1
        jmp @w %i1
    @read
        %mi0 = call rtc_reg %io 0x02:bv8
        %h0 = call rtc_reg %io 0x04:bv8
        %d0 = call rtc_reg %io 0x07:bv8
        %m0 = call rtc_reg %io 0x08:bv8
        %y0 = call rtc_reg %io 0x09:bv8
        %fb = call rtc_reg %io 0x0b:bv8
        %pm = and %h0 0x80
        %h7 = and %h0 0x7f
        %bin0 = and %fb 4
        %bin = cmp ne %bin0 0
        br %bin @raw @bcd
    @bcd
        %mi1 = call tb_bcd %mi0
        %h1 = call tb_bcd %h7
        %d1 = call tb_bcd %d0
        %m1 = call tb_bcd %m0
        %y1 = call tb_bcd %y0
        jmp @h12 %mi1 %h1 %d1 %m1 %y1
    @raw
        jmp @h12 %mi0 %h7 %d0 %m0 %y0
    @h12 %mi:bv64 %h:bv64 %d:bv64 %m:bv64 %y:bv64
        # chế độ 12 giờ (bit 1 của thanh ghi B = 0): bit 7 của giờ = chiều
        %f24 = and %fb 2
        %is24 = cmp ne %f24 0
        br %is24 @h24 @t12
    @h24
        jmp @pack %h
    @t12
        %h12 = urem %h 12
        %ispm = cmp ne %pm 0
        br %ispm @addpm @am
    @addpm
        %hp = add %h12 12
        jmp @pack %hp
    @am
        jmp @pack %h12
    @pack %hh:bv64
        %a8 = and %mi 0xff
        %b8 = and %hh 0xff
        %c8 = and %d 0xff
        %e8 = and %m 0xff
        %f8 = and %y 0xff
        %s1 = shl %b8 8
        %s2 = shl %c8 16
        %s3 = shl %e8 24
        %s4 = shl %f8 32
        %o1 = or %a8 %s1
        %o2 = or %o1 %s2
        %o3 = or %o2 %s3
        %o4 = or %o3 %s4
        ret %o4
}

# Mỗi nhịp WM: vẽ lại thanh trên cùng khi đổi phút hoặc đổi App focus
func topbar_tick void %io:io<0,0xffff> %front:ptr<VgaCell,2073600> %back:ptr<VgaCell,2073600> %g:ptr<IpcChannel,1> {
    @req uge %front 0x10000
    @req ult %front 0x40000000
    @req uge %back 0x10000
    @req ult %back 0x40000000
    @b0
        %ts = call tb_state %io
        %ds = call dock_ds %io
        # phút trước: chỉ đọc thanh ghi phút (rẻ); đổi phút / chưa vẽ -> đọc đủ
        %mi = call rtc_reg %io 0x02:bv8
        %act = load %g IpcChannel.active_app
        %fg = cmp ne %act 0
        br %fg @fa @fn
    @fa
        %f = sub %act 1
        jmp @st %f
    @fn
        jmp @st 7
    @st %foc:bv64
        @inv ule %foc 7
        %od = load %ts TopState.drawn
        %of = load %ts TopState.focus
        %os = load %ts TopState.stamp
        %omr = and %os 0xff
        %c0 = cmp eq %od 0
        %c1 = cmp ne %of %foc
        %c2 = cmp ne %omr %mi
        %c01 = or %c0 %c1
        %ch = or %c01 %c2
        br %ch @draw @same
    @draw
        %raw = call rtc_read %io
        %t = call tb_localize %raw
        %rmin = and %raw 0xff
        %keep0 = and %t 0xffffffffffffff00
        %stamp = or %keep0 %rmin            # phút thô (để so lần sau) — phút không đổi khi cộng múi giờ
        store %ts TopState.stamp %stamp
        store %ts TopState.focus %foc
        store %ts TopState.drawn 1
        %isd = cmp eq %foc 7
        br %isd @nm0 @nm
    @nm0
        jmp @paint 0
    @nm
        %f6 = call math_min %foc 6
        %n = call dk_name %ds %f6
        jmp @paint %n
    @paint %name:bv64
        call tb_draw %back %name %t
        call gfx_blit_rect %front %back 0 0 1920 32
        call fb_present_rect %io %front 0 0 1920 32
        %cx = load %g IpcChannel.cursor_x
        %cy = load %g IpcChannel.cursor_y
        call gfx_draw_cursor %front %cx %cy
        %cx2 = add %cx 12
        %cy2 = add %cy 18
        call fb_present_rect %io %front %cx %cy %cx2 %cy2
        ret
    @same
        ret
}

# =============================================================================
# IPC VÀ ĐIỀU PHỐI CỬA SỔ DESKTOP KHÔNG CÒN HARDCODE APP
# =============================================================================
func app_desktop_ipc_task void %0:io<0,0xffff> %1:ptr<VgaCell,2073600> %2:ptr<VgaCell,2073600> %3:ptr<IpcChannel,1> %4:ptr<DiskQword,64> {
    @req uge %1 0x10000
    @req ult %1 0x40000000
    @req uge %2 0x10000
    @req ult %2 0x40000000
    @req uge %3 0x10000
    @req ult %3 0x80000000
    @req uge %4 0x10000
    @req ult %4 0x80000000

    @b0
        %9 = const 0x7c000 ptr<DiskQword,64>
        # Chuột trên màn hình (184/192) -> quy đổi sang khung nhìn App (16/24), kẹp trong [0,1259] x [0,699]
        %10 = load %3 184 bv64
        %11 = load %3 192 bv64
        %900 = const 320 bv64
        %901 = const 160 bv64
        %902 = call std_max %10 %900
        %903 = sub %902 %900
        %904 = const 1259 bv64
        %905 = call std_min %903 %904
        store %3 16 %905
        %906 = call std_max %11 %901
        %907 = sub %906 %901
        %908 = const 699 bv64
        %909 = call std_min %907 %908
        store %3 24 %909
        # Khung nhìn của App: VRAM cắt tại gốc (320, 160) = 160 * 1920 + 320
        %910 = const 307520 bv64
        %911 = slice %2 %910 ptr<VgaCell,1382400>
        # Đang kéo cửa sổ bằng thanh tiêu đề -> dời theo chuột
        call comp_drag_tick %0 %911 %3
        %12 = load %3 32 bv64
        %13 = const 0 bv64
        %14 = const 1 bv64
        %15 = const 2 bv64
        %44 = load %3 64 bv64
        %45 = load %3 72 bv64
        %95 = const 0x7e000 smp

        %16 = cmp ne %12 %13
        br %16 @b1 @b20

    @b1
        %17 = const 983 bv64                # đỉnh Dock trên màn hình (624 + 359)
        %18 = cmp uge %11 %17
        br %18 @b2 @b18

    @b18
        # Compositor xử lý trước: đưa cửa sổ dưới lên trên / bắt đầu kéo (cú nhấn bị tiêu thụ)
        %cc = call comp_click %0 %911 %3
        %ccx = cmp eq %cc 2
        br %ccx @b18x @b18c

    @b18x
        # Nút [X] do compositor vẽ: đóng App trên cùng
        %cxa = load %3 56 bv64
        %cxok0 = cmp ne %cxa 0
        br %cxok0 @b18y @b19

    @b18y
        %cxs = sub %cxa 1
        call shell_close_and_reset_app %0 %911 %3 %95 %cxs
        jmp @b19

    @b18c
        %ccon = cmp ne %cc 0
        br %ccon @b19 @b18a

    @b18a
        %65 = load %3 56 bv64
        %66 = cmp ne %65 %13
        br %66 @b8 @b19

    @b19
        store %3 32 %13
        jmp @b6

    @b2
        # Ô Dock được click (bố cục do dock.lit tính); 7 = trượt
        %dsk = call dock_ds %0
        %26 = call dk_hit %dsk %10 %11
        %23 = cmp ult %26 7
        br %23 @b3 @b19

    @b3
        %260 = const 6 bv64
        %261 = call std_min %26 %260
        %27 = call lfs_app_present %0 %261
        %28 = cmp ne %27 %13
        br %28 @b4 @b19

    @b4
        # Lấy App đang mở hiện tại trước khi switch
        %100 = load %3 56 bv64
        %30 = add %261 %14
        %101 = cmp ne %100 %30
        br %101 @b41 @b42

    @b41
        # Khi chuyển sang App khác: compositor đưa cửa sổ của nó lên trên (mở nếu chưa có) và vẽ lại cảnh
        call comp_focus %0 %911 %3 %261
        jmp @b42

    @b42
        store %3 0 %13
        store %3 56 %30
        store %3 32 %13
        store %3 88 %13
        store %3 112 %13
        # App vừa được đưa lên foreground phải vẽ lại khung cửa sổ: xóa cờ win_drawn trên kênh RIÊNG của nó
        %chn = call app_chan %0 %261
        store %chn IpcChannel.win_drawn 0
        jmp @b8

    @b20
        %71 = load %3 0 bv64
        %72 = load %3 56 bv64
        %73 = cmp ne %71 %13
        %74 = cmp ne %72 %13
        br %74 @b201 @b6

    @b201
        # Kiểm tra xem CHÍNH Foreground App hiện tại (%72) có bật bit chạy liên tục trong ipc_bg_mask (offset 152) không
        %96 = load %3 152 bv64
        %97 = sub %72 %14
        %98 = shl %14 %97
        %99 = and %96 %98
        %108 = cmp ne %99 %13
        %1090 = or %73 %108
        # hoặc compositor vừa đề nghị kích thước mới (configure) cho App trên cùng
        %cfgr = call comp_wants_run %0 %3
        %cfgp = cmp ne %cfgr 0
        %109 = or %1090 %cfgp
        br %109 @b8 @b6

    @b8
        %50 = load %3 56 bv64
        %51 = cmp ne %50 %13
        br %51 @b81 @b6

    @b81
        %52 = sub %50 %14
        %200 = const 7 bv64
        %201 = cmp ult %52 %200
        br %201 @b82 @b6

    @b82
        call app_dispatch_entry %0 %911 %3 %9 %4 %95 %52
        store %3 32 %13

        # Kiểm tra xem App có vừa phát tín hiệu bấm nút [X] (offset 88 != 0) không?
        %53 = call ipc_win_take_close_req %3
        %54 = cmp ne %53 %13
        br %54 @b14 @b15

    @b14
        # Shell đứng ra đóng cửa sổ và Reset toàn bộ trạng thái của App %52 về như mới!
        call shell_close_and_reset_app %0 %911 %3 %95 %52
        jmp @b6

    @b15
        jmp @b6

    @b6
        # Điều phối nhịp chạy ngầm tổng quát cho các App đăng ký trong ipc_bg_mask
        call shell_bg_tick_apps %0 %911 %3 %9 %4 %95

        %37 = load %3 80 bv64
        %38 = cmp ne %37 %13
        br %38 @b7 @b10

    @b7
        store %3 80 %13

        %80 = const 12 bv64
        %81 = const 18 bv64
        %82 = add %44 %80
        %83 = add %45 %81
        call gfx_blit_rect %1 %2 %44 %45 %82 %83
        call fb_present_rect %0 %1 %44 %45 %82 %83

        # Vùng bẩn do App báo theo tọa độ khung nhìn -> cộng gốc (320, 160) ra tọa độ màn hình
        %840 = load %3 120 bv64
        %850 = load %3 128 bv64
        %860 = load %3 136 bv64
        %870 = load %3 144 bv64
        %84 = add %840 %900
        %85 = add %850 %901
        %86 = add %860 %900
        %87 = add %870 %901
        call gfx_blit_rect %1 %2 %84 %85 %86 %87
        call fb_present_rect %0 %1 %84 %85 %86 %87

        call gfx_draw_cursor %1 %10 %11
        %800 = add %10 %80
        %801 = add %11 %81
        call fb_present_rect %0 %1 %10 %11 %800 %801
        store %3 64 %10
        store %3 72 %11
        jmp @b12

    @b10
        %46 = cmp ne %10 %44
        %47 = cmp ne %11 %45
        %48 = or %46 %47
        br %48 @b11 @b12

    @b11
        %88 = const 12 bv64
        %89 = const 18 bv64
        %90 = add %44 %88
        %91 = add %45 %89
        call gfx_blit_rect %1 %2 %44 %45 %90 %91
        call fb_present_rect %0 %1 %44 %45 %90 %91
        call gfx_draw_cursor %1 %10 %11
        %802 = add %10 %88
        %803 = add %11 %89
        call fb_present_rect %0 %1 %10 %11 %802 %803
        store %3 64 %10
        store %3 72 %11
        jmp @b12

    @b12
        # Dock: chỉ báo App đang mở / focus, hiệu ứng rê chuột
        call dock_tick %0 %1 %2 %3
        call topbar_tick %0 %1 %2 %3
        ret
}
