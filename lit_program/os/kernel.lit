# File: lit_program/os/kernel.lit
# KERNEL CORE: Quản lý Bộ nhớ (Heap), Bảng Tiến trình (Task) và Điểm vào Khởi động (Boot Entry)

include ../apps/desktop_app.lit

layout KernelState 16 {
    0: bv64 @inv ule val 64             # heap_used <= 64
    8: bv64 @inv ule val 16             # task_count <= 16
}

# 1. Cấp phát 8 khối Heap (Có @ens cam kết con trỏ trả về %5 nằm trong vùng RAM hợp lệ!)
func kalloc_heap8 ptr<HeapSlot,8> %0:ptr<KernelState,1> %1:ptr<HeapSlot,64> %2:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req uge %1 0x10000
    @req ult %1 0x70000000
    @req ule %2 56
    @ens uge %5 0x10000                 # <--- Cam kết đầu ra: con trỏ %5 >= 0x10000
    @ens ult %5 0x80000000              # <--- Cam kết đầu ra: con trỏ %5 < 0x80000000

    @b0
        %3 = const 8 bv64
        %4 = add %2 %3
        store %0 0 %4
        %5 = slice %1 %2 ptr<HeapSlot,8>
        ret %5
}

# 2. Đăng ký Tiến trình vào bảng Task (Có @ens cam kết giá trị trả về %3 == %1 + 1!)
func kregister_task bv64 %0:ptr<KernelState,1> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ult %1 16
    @ens eq %3 add %1 1                 # <--- Cam kết đầu ra: %3 luôn bằng %1 + 1

    @b0
        %2 = const 1 bv64
        %3 = add %1 %2
        store %0 8 %3
        ret %3
}

# 3. Nạp danh sách Startup (init.lit) và khởi chạy tại hàm cuối cùng (kernel_boot_entry)
include init.lit

func kernel_boot_entry void %0:io<0,0xffff> {
    @b0
        %1 = const 0x78000 ptr<KernelState,1>
        %2 = const 0 bv64
        store %1 0 %2
        store %1 8 %2

        %3 = const 0x80000 ptr<HeapSlot,64>
        %4 = const 0xb8000 ptr<VgaCell,2000>

        call init_startup %0 %1 %3 %4
        ret
}
