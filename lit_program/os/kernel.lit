# File: lit_program/os/kernel.lit
# LIGHT OS MICRO-EXOKERNEL: Cấp Lô 64GB Động qua Bảng Quản trị Shell

include init.lit

layout KernelState 16 {
    0: bv64 @inv ule val 64
    8: bv64 @inv ule val 16
}

func kregister_task bv64 %0:ptr<KernelState,1> %1:bv64 {
    @req uge %0 0x10000
    @req ult %0 0x80000000
    @req ult %1 16
    @ens eq %3 add %1 1

    @b0
        %2 = const 1 bv64
        %3 = add %1 %2
        store %0 8 %3
        ret %3
}

func kscheduler_loop void %0:io<0,0xffff> %1:ptr<KeyMap,8> %2:ptr<IpcChannel,1> %3:ptr<VgaCell,921600> %4:ptr<VgaCell,921600> %5:ptr<DiskQword,64> {
    @req uge %1 0x10000
    @req ult %1 0x80000000
    @req uge %2 0x10000
    @req ult %2 0x80000000
    @req uge %3 0x10000
    @req ult %3 0x80000000
    @req uge %4 0x10000
    @req ult %4 0x80000000
    @req uge %5 0x10000
    @req ult %5 0x80000000

    @b0
        %10 = const 0 bv64
        jmp @b1 %10

    @b1 %11:bv64
        @inv uge %1 0x10000
        call drv_kbd_poll_task %0 %1 %2
        call app_desktop_ipc_task %0 %3 %4 %2 %5
        jmp @b1 %11
}

func kernel_boot_entry void %0:io<0,0xffff> {

    @b0
        # 1. LÔ 0 (0 GB): Hệ thống Kernel, VFS, VRAM & Backbuffer
        %1 = const 0x78000 ptr<KernelState,1>
        %2 = const 0 bv64
        store %1 0 %2
        store %1 8 %2

        %3 = const 0x79000 ptr<IpcChannel,1>
        %4 = const 0x7a000 ptr<KeyMap,8>
        %5 = const 0x7b000 ptr<DiskQword,64>
        %6 = const 0x7c000 ptr<DiskQword,64>
        %9 = const 0x200000 ptr<VgaCell,921600>
        %10 = const 0x600000 ptr<VgaCell,921600>

        %11 = call kregister_task %1 %2
        %12 = call kregister_task %1 %11

        # Khởi tạo Bảng quản trị VMM (bitmap khung RAM + số Chunk của từng App) về 0 = bể trống hoàn toàn
        %20 = call sys_get_vmm_table %0
        call std_mem_zero %20
        call vmm_probe_ram %0 %20                # Đọc Memory Map: [3] = đỉnh RAM khả dụng, [4] = tổng RAM khả dụng (byte)

        call sys_init_drivers %0 %4 %5 %6
        call sys_init_desktop %0 %9 %10 %3 %5

        call kscheduler_loop %0 %4 %3 %9 %10 %5
        ret
}
