# Cấu hình nhúng trong lightos.efi (grub-mkstandalone). @ESP_UUID@ được thay bằng UUID của phân vùng ESP.
set timeout=3
set default=0
insmod part_gpt
insmod fat
insmod all_video
insmod multiboot
search --no-floppy --fs-uuid --set=esp @ESP_UUID@
menuentry "Light OS" {
    set root=$esp
    multiboot /EFI/lightos/kernel.elf
    boot
}
menuentry "Ubuntu" {
    set root=$esp
    chainloader /EFI/ubuntu/shimx64.efi
}
menuentry "UEFI Firmware Settings" {
    fwsetup
}
