# Light-Bench 03 — chỉ số đầu tiên có a[j] == x, hoặc n nếu không có
include ../../lit_program/std/core.lit

func find_q bv64 %n:bv64 %a:ptr<DiskQword,%n> %x:bv64 {
    @ens ule %r %n
    @b0
        jmp @l 0
    @l %i:bv64
        @inv ule %i %n
        %more = cmp ult %i %n
        br %more @body @done
    @body
        %p = slice %a %i ptr<DiskQword,1>
        %v = load %p 0 bv64
        %hit = cmp eq %v %x
        br %hit @found @next
    @found
        ret %i
    @next
        %i2 = add %i 1
        jmp @l %i2
    @done
        ret %n
}
