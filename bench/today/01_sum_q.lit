# Light-Bench 01 — tổng các phần tử (quay vòng mod 2^64)
include ../../lit_program/std/core.lit

func sum_q bv64 %n:bv64 %a:ptr<DiskQword,%n> {
    @b0
        jmp @l 0 0
    @l %i:bv64 %s:bv64
        @inv ule %i %n
        %more = cmp ult %i %n
        br %more @body @done
    @body
        %p = slice %a %i ptr<DiskQword,1>
        %v = load %p 0 bv64
        %s2 = add_wrap %s %v
        %i2 = add %i 1
        jmp @l %i2 %s2
    @done
        ret %s
}
