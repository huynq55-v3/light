# Light-Bench 09 — đảo ngược a[0..n) tại chỗ
include ../../lit_program/std/core.lit

func reverse_q void %n:bv64 %a:ptr<DiskQword,%n> {
    @b0
        jmp @l 0 %n
    @l %i:bv64 %j:bv64
        @inv ule %i %j
        @inv ule %j %n
        @dec sub %j %i
        %w = sub %j %i
        %more = cmp ugt %w 1
        br %more @swap @done
    @swap
        %j1 = sub %j 1
        %pi = slice %a %i ptr<DiskQword,1>
        %pj = slice %a %j1 ptr<DiskQword,1>
        %x = load %pi 0 bv64
        %y = load %pj 0 bv64
        store %pi 0 %y
        store %pj 0 %x
        %i2 = add %i 1
        jmp @l %i2 %j1
    @done
        ret
}
