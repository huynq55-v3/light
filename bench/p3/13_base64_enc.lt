// Light-Bench 13 (P3, đặc tả đầy đủ) — mã hoá base64 (RFC 4648, có '=') s[0..n) vào out, trả số ký tự = 4 * ceil(n / 3)
include "../../lit_program/std/core.lit";

data B64: u8 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

fn b64_ch(i: u64) -> u8
    requires i < 64
{
    let t = addr(B64);
    return t[i];
}

// nhóm 24 bit w (k = 1..3 byte thật) -> 4 ký tự ở out[o..o+4)
fn b64_put(cap: u64, out: ptr<u8, cap>, o: u64, w: u64, k: u64)
    requires k >= 1, k <= 3, w < 0x1000000, cap >= 4, o <= cap -% 4
{
    out[o] = b64_ch(w >> 18);
    out[o + 1] = b64_ch((w >> 12) & 63);
    if k >= 2 {
        out[o + 2] = b64_ch((w >> 6) & 63);
        if k >= 3 {
            out[o + 3] = b64_ch(w & 63);
        } else {
            out[o + 3] = '=';
        }
    } else {
        out[o + 2] = '=';
        out[o + 3] = '=';
    }
}

// P3: đặc tả đầy đủ bằng số học toán học. Kiểm tra chỗ trống lúc chạy vẫn giữ (checker bit-vector cần nó để chứng
// minh an toàn bộ nhớ); checker số nguyên chứng minh nhánh đó không bao giờ xảy ra khi requires đúng.
fn base64_enc(n: u64, s: ptr<u8, n>, cap: u64, out: ptr<u8, cap>) -> u64
    requires cap >= 4 * ((n + 2) / 3)
    ensures result == 4 * ((n + 2) / 3)
{
    var i = 0;
    var o = 0;
    while n - i >= 3 invariant i <= n, i % 3 == 0, o * 3 == i * 4, o <= cap decreases n - i {
        if cap - o < 4 { return o; }
        let w = (s[i] << 16) | (s[i + 1] << 8) | s[i + 2];
        b64_put(cap, out, o, w, 3);
        i += 3;
        o += 4;
    }
    let rest = n - i;
    if rest == 0 { return o; }
    if cap - o < 4 { return o; }
    var w = s[i] << 16;
    if rest > 1 { w = w | (s[i + 1] << 8); }
    b64_put(cap, out, o, w, rest);
    return o + 4;
}
