// Light-Bench 05 (P3, đặc tả đầy đủ) — vị trí byte 0 đầu tiên trong s[0..n), hoặc n
include "../../lit_program/std/core.lit";

fn strnlen_b(n: u64, s: ptr<u8, n>) -> u64
    ensures result <= n
    ensures forall j in 0..result: s[j] != 0
    ensures result < n ==> s[result] == 0
{
    var i = 0;
    while i < n invariant i <= n, forall j in 0..i: s[j] != 0 {
        if s[i] == 0 { break; }
        i += 1;
    }
    return i;
}
