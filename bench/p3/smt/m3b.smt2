(define-sort BV () (_ BitVec 64))
(declare-const M0 (Array BV BV)) (declare-const M (Array BV BV))
(declare-const a BV) (declare-const n BV) (declare-const i BV) (declare-const j BV)
(assert (and true (bvult n #x0000010000000000) (bvule #x0000000000000000 i) (bvule i j) (bvule j n) (bvugt (bvsub j i) #x0000000000000001) (= (bvadd i j) n)))
(define-fun A ((t BV)) BV (bvadd a (bvmul #x0000000000000008 t)))
(assert (forall ((t BV)) (! (=> (and (bvule #x0000000000000000 t) (or (bvult t i) (and (bvule j t) (bvult t n)))) (= (select M (A t)) (select M0 (A (bvsub (bvsub n #x0000000000000001) t))))) :pattern ((select M (A t))))))
(assert (forall ((t BV)) (! (=> (and (bvule i t) (bvult t j)) (= (select M (A t)) (select M0 (A t)))) :pattern ((select M (A t))))))
(define-fun j1 () BV (bvsub j #x0000000000000001))
(define-fun M2 () (Array BV BV) (store (store M (A i) (select M (A j1))) (A j1) (select M (A i))))
(define-fun i2 () BV (bvadd i #x0000000000000001))
(assert (not (and
  (forall ((t BV)) (=> (and (bvule #x0000000000000000 t) (or (bvult t i2) (and (bvule j1 t) (bvult t n)))) (= (select M2 (A t)) (select M0 (A (bvsub (bvsub n #x0000000000000001) t))))))
  (forall ((t BV)) (=> (and (bvule i2 t) (bvult t j1)) (= (select M2 (A t)) (select M0 (A t))))))))
(check-sat)
