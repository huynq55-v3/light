; reverse: store hai qword vào M (8 byte mỗi qword), khung: phần ngoài [i] và [j1] không đổi; inv dạng qword
(define-fun ld ((M (Array (_ BitVec 64) (_ BitVec 8))) (p (_ BitVec 64))) (_ BitVec 64)
  (concat (select M (bvadd p #x0000000000000007)) (concat (select M (bvadd p #x0000000000000006)) (concat (select M (bvadd p #x0000000000000005)) (concat (select M (bvadd p #x0000000000000004))
  (concat (select M (bvadd p #x0000000000000003)) (concat (select M (bvadd p #x0000000000000002)) (concat (select M (bvadd p #x0000000000000001)) (select M p)))))))))
(define-fun st ((M (Array (_ BitVec 64) (_ BitVec 8))) (p (_ BitVec 64)) (v (_ BitVec 64))) (Array (_ BitVec 64) (_ BitVec 8))
  (store (store (store (store (store (store (store (store M p ((_ extract 7 0) v)) (bvadd p #x0000000000000001) ((_ extract 15 8) v)) (bvadd p #x0000000000000002) ((_ extract 23 16) v)) (bvadd p #x0000000000000003) ((_ extract 31 24) v))
   (bvadd p #x0000000000000004) ((_ extract 39 32) v)) (bvadd p #x0000000000000005) ((_ extract 47 40) v)) (bvadd p #x0000000000000006) ((_ extract 55 48) v)) (bvadd p #x0000000000000007) ((_ extract 63 56) v)))
(declare-const M0 (Array (_ BitVec 64) (_ BitVec 8))) (declare-const M (Array (_ BitVec 64) (_ BitVec 8)))
(declare-const a (_ BitVec 64)) (declare-const n (_ BitVec 64)) (declare-const i (_ BitVec 64)) (declare-const j (_ BitVec 64))
(assert (bvult n #x0000010000000000)) (assert (bvult a #x0001000000000000)) (assert (= ((_ extract 2 0) a) #b000))
(assert (bvule i j)) (assert (bvule j n)) (assert (bvugt (bvsub j i) #x0000000000000001))
; inv: forall t < i: M[a+8t] == M0[a+8(n-1-t)], forall t in j..n: M[a+8t] == M0[a+8(n-1-t)], forall t in i..j: M[a+8t]==M0[a+8t]
(define-fun A ((t (_ BitVec 64))) (_ BitVec 64) (bvadd a (bvmul #x0000000000000008 t)))
(assert (forall ((t (_ BitVec 64))) (! (=> (or (bvult t i) (and (bvule j t) (bvult t n))) (= (ld M (A t)) (ld M0 (A (bvsub (bvsub n #x0000000000000001) t))))) :pattern ((ld M (A t))))))
(assert (forall ((t (_ BitVec 64))) (! (=> (and (bvule i t) (bvult t j)) (= (ld M (A t)) (ld M0 (A t)))) :pattern ((ld M (A t))))))
(define-fun j1 () (_ BitVec 64) (bvsub j #x0000000000000001))
(define-fun x () (_ BitVec 64) (ld M (A i)))
(define-fun y () (_ BitVec 64) (ld M (A j1)))
(define-fun M2 () (Array (_ BitVec 64) (_ BitVec 8)) (st (st M (A i) y) (A j1) x))
(define-fun i2 () (_ BitVec 64) (bvadd i #x0000000000000001))
(assert (not (forall ((t (_ BitVec 64))) (=> (or (bvult t i2) (and (bvule j1 t) (bvult t n))) (= (ld M2 (A t)) (ld M0 (A (bvsub (bvsub n #x0000000000000001) t))))))))
(check-sat)
