; base64 kiểu thật: mã bv (o += 4, i += 3 mỗi vòng), đặc tả Int: o == 4*(i/3) quy nạp + kết thúc
(declare-const ib (_ BitVec 64))
(declare-const ob (_ BitVec 64))
(declare-const nb (_ BitVec 64))
(define-fun i () Int (bv2nat ib))
(define-fun o () Int (bv2nat ob))
(define-fun n () Int (bv2nat nb))
; invariant: i % 3 == 0, o * 3 == 4 * i, i <= n ; bước: rest = n - i < 3 , tail: r = o + 4 (rest>0)
(assert (= (mod i 3) 0)) (assert (= (* 3 o) (* 4 i))) (assert (<= i n))
(assert (bvult (bvsub nb ib) #x0000000000000003)) (assert (not (= (bvsub nb ib) #x0000000000000000)))
(assert (bvult nb #x1000000000000000))
(define-fun r () Int (bv2nat (bvadd ob #x0000000000000004)))
(assert (not (= r (* 4 (div (+ n 2) 3)))))
(check-sat)
