(declare-const ib (_ BitVec 64))
(declare-const ob (_ BitVec 64))
(declare-const nb (_ BitVec 64))
(declare-const t (_ BitVec 64))
(declare-const rb (_ BitVec 64))
(define-fun i () Int (bv2nat ib))
(define-fun o () Int (bv2nat ob))
(define-fun n () Int (bv2nat nb))
(assert (and (<= 0 i) (< i 18446744073709551616) (<= 0 o) (< o 18446744073709551616) (<= 0 n) (< n 18446744073709551616)))
(assert (= (mod i 3) 0)) (assert (= (* 3 o) (* 4 i))) (assert (<= i n))
; t = sub nb ib (kiểm tràn đã chứng minh: nb >= ib) -> bóng Int
(assert (= t (bvsub nb ib))) (assert (= (bv2nat t) (- n i)))
; cmp ult t 3 -> bóng
(assert (bvult t #x0000000000000003)) (assert (< (bv2nat t) 3))
(assert (not (= t #x0000000000000000))) (assert (not (= (bv2nat t) 0)))
(assert (bvult nb #x1000000000000000)) (assert (< n 1152921504606846976))
(assert (= rb (bvadd ob #x0000000000000004))) (assert (= (bv2nat rb) (+ o 4)))
(assert (not (= (bv2nat rb) (* 4 (div (+ n 2) 3)))))
(check-sat-using (then simplify solve-eqs (! smt :arith.solver 6)))
