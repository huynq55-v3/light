// Light-Bench 11 (P3, đặc tả đầy đủ) — 1 nếu a[0..n) không giảm (a[j] <= a[j+1]), ngược lại 0
include "../../lit_program/std/core.lit";

fn is_sorted_q(n: u64, a: ptr<u64, n>) -> u64
    ensures result <= 1
    ensures result == 1 <==> forall j in 1..n: a[j - 1] <= a[j]
{
    for i in 1..n invariant forall j in 1..i: a[j - 1] <= a[j] {
        if a[i - 1] > a[i] { return 0; }
    }
    return 1;
}
