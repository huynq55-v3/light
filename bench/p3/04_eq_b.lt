// Light-Bench 04 (P3, đặc tả đầy đủ) — 1 nếu a[0..k) == b[0..k), ngược lại 0
include "../../lit_program/std/core.lit";

fn eq_b(n: u64, a: ptr<u8, n>, m: u64, b: ptr<u8, m>, k: u64) -> u64
    requires k <= n, k <= m
    ensures result <= 1
    ensures result == 1 <==> forall j in 0..k: a[j] == b[j]
{
    for i in 0..k invariant forall j in 0..i: a[j] == b[j] {
        if a[i] != b[i] { return 0; }
    }
    return 1;
}
