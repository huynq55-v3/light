// P1: hai hàm phụ không vòng lặp của Light-Bench 13 (base64)
include "../../lit_program/std/core.lit";

data B64: u8 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

fn b64_ch(i: u64) -> u8
    requires i < 64
{
    let t = addr(B64);
    return t[i];
}

// nhóm 24 bit w (k = 1..3 byte thật) -> 4 ký tự ở out[o..o+4)
fn b64_put(cap: u64, out: ptr<u8, cap>, o: u64, w: u64, k: u64)
    requires k >= 1, k <= 3, w < 0x1000000
    requires cap >= 4, o <= cap -% 4
{
    out[o] = b64_ch(w >> 18);
    out[o + 1] = b64_ch((w >> 12) & 63);
    if k >= 2 {
        out[o + 2] = b64_ch((w >> 6) & 63);
    } else {
        out[o + 2] = '=';
    }
    if k >= 3 {
        out[o + 3] = b64_ch(w & 63);
    } else {
        out[o + 3] = '=';
    }
}
