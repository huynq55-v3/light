// Light-Bench 04 — 1 nếu a[0..k) == b[0..k), ngược lại 0
include "../../lit_program/std/core.lit";

fn eq_b(n: u64, a: ptr<u8, n>, m: u64, b: ptr<u8, m>, k: u64) -> u64
    requires k <= n, k <= m
    ensures result <= 1
{
    for i in 0..k {
        if a[i] != b[i] { return 0; }
    }
    return 1;
}
