// Light-Bench 14 — ước chung lớn nhất (Euclid); gcd(0, 0) = 0
fn gcd(a: u64, b: u64) -> u64
    ensures result != 0 || (a == 0 && b == 0)
{
    var x = a;
    var y = b;
    while y != 0 invariant x != 0 || y != 0 || (a == 0 && b == 0) decreases y {
        let m = x % y;
        x = y;
        y = m;
    }
    return x;
}
