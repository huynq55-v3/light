# Ví dụ 6: Sử dụng Thư Viện Chuẩn THỰC SỰ thông qua lệnh CALL
# Gọi trực tiếp hàm std_print từ stdlib/io.lit

IMPORT "../stdlib/io.lit"

FUNC main() -> i64
  # Chuẩn bị thông điệp
  ALLOC %greeting 28
  STORE_STR %greeting 0 "Welcome to Light Standard!\n"

  # GỌI HÀM THƯ VIỆN CHUẨN THỰC THỤ: std_print(buf, len)
  %len = CONST i64 27
  %res = CALL std_print %greeting %len

  # Thoát chương trình với exit code = 0
  %exit_code = CONST i64 0
  RET %exit_code
END_FUNC
