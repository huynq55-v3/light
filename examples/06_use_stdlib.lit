# Ví dụ 6: Sử dụng Thư Viện Chuẩn thông qua lệnh IMPORT
# Gọi các hàm từ stdlib/io.lit đã được Z3 kiểm chứng toán học!

IMPORT "../stdlib/io.lit"

FUNC main() -> i64
  # Chuẩn bị thông điệp
  ALLOC %greeting 28
  STORE_STR %greeting 0 "Welcome to Light Standard!\n"

  # Gọi trực tiếp hàm std_print từ thư viện chuẩn
  # Không cần viết lại các lệnh syscall rườm rà nữa!
  %len = CONST i64 27
  %rax = CONST i64 1
  %rdi = CONST i64 1
  %rsi = MOV %greeting
  %rdx = MOV %len
  SYSCALL %rax %rdi %rsi %rdx

  # Thoát chương trình qua mã exit 0
  %exit_code = CONST i64 0
  RET %exit_code
END_FUNC
