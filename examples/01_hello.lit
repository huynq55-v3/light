# Ví dụ 1: In ra terminal bằng Syscall Linux (x86_64)
# Không cần libc, không phụ thuộc C runtime!

FUNC main() -> i64
  # Cấp phát 24 bytes buffer
  %buffer = ALLOC slice<u8> 24
  STORE_STR %buffer "Hello from Light Lang!\n"
  %ptr = SLICE_PTR %buffer

  # Linux Syscall sys_write(fd=1, buf=%ptr, count=23)
  %rax = CONST i64 1
  %rdi = CONST i64 1
  %rsi = MOV %ptr
  %rdx = CONST i64 23
  SYSCALL

  %zero = CONST i64 0
  RET %zero
END_FUNC
