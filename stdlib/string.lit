# ==============================================================================
# LIGHT STANDARD LIBRARY: stdlib/string.lit
# Formally verified string and character manipulation module using Z3 SMT Solver
# Powers Lexing and Parsing for the Self-Hosting Compiler
# ==============================================================================

# Safely read 1 byte character from slice at index idx
# Formally verified: 100% immune to Out-of-bounds errors due to idx < len(s) contract!
FUNC str_char_at(s: slice<u8>, idx: i64) -> i64
  REQUIRE idx >= 0 && idx < len(s)

  %ptr = SLICE_PTR s
  %byte = LOAD8 %ptr idx

  ENSURE %byte >= 0 && %byte <= 255
  RET %byte
END_FUNC

# Check if a character is whitespace (Space=32, Tab=9, Newline=10, Return=13)
FUNC is_whitespace(c: i64) -> bool
  REQUIRE c >= 0 && c <= 255

  %c_space = CONST i64 32
  %is_sp = EQ i64 c %c_space

  %c_tab = CONST i64 9
  %is_tb = EQ i64 c %c_tab

  %c_nl = CONST i64 10
  %is_nl = EQ i64 c %c_nl

  %c_cr = CONST i64 13
  %is_cr = EQ i64 c %c_cr

  %or1 = OR bool %is_sp %is_tb
  %or2 = OR bool %is_nl %is_cr
  %res = OR bool %or1 %or2

  RET %res
END_FUNC

# Check if a character is an ASCII digit ('0'=48 to '9'=57)
FUNC is_digit(c: i64) -> bool
  REQUIRE c >= 0 && c <= 255

  %c_zero = CONST i64 48
  %c_nine = CONST i64 57
  %gte = GTE i64 c %c_zero
  %lte = LTE i64 c %c_nine
  %res = AND bool %gte %lte

  RET %res
END_FUNC

# Convert an ASCII digit character ('0'..'9') to its integer value (0..9)
FUNC digit_to_int(c: i64) -> i64
  REQUIRE c >= 48 && c <= 57

  %c_zero = CONST i64 48
  %digit = SUB i64 c %c_zero

  ENSURE %digit >= 0 && %digit <= 9
  RET %digit
END_FUNC

# Byte-by-byte equality check between two slices
FUNC str_eq(a: slice<u8>, b: slice<u8>) -> bool
  REQUIRE len(a) >= 0 && len(b) >= 0

  %len_a = SLICE_LEN a
  %len_b = SLICE_LEN b
  %len_match = EQ i64 %len_a %len_b

  %not_match = NEQ i64 %len_a %len_b
  %i = CONST i64 0
  %same = CONST bool true

  LOOP cmp_loop
    INVARIANT %i >= 0 && %i <= len(a)
    INVARIANT %i <= len(b)

    %done = GTE i64 %i %len_a
    BREAK_IF %done

    %ptr_a = SLICE_PTR a
    %ca = LOAD8 %ptr_a %i

    %ptr_b = SLICE_PTR b
    %cb = LOAD8 %ptr_b %i

    %diff = NEQ i64 %ca %cb
    BREAK_IF %diff

    %next_i = ADD i64 %i 1
    %i = MOV %next_i
  END_LOOP cmp_loop

  %is_equal = EQ i64 %i %len_a
  %final_res = AND bool %len_match %is_equal
  RET %final_res
END_FUNC

# Search for target byte in slice. Returns 0-based index or -1 if not found.
FUNC find_char(s: slice<u8>, target: i64) -> i64
  REQUIRE len(s) >= 0 && target >= 0 && target <= 255

  %len = SLICE_LEN s
  %ptr = SLICE_PTR s
  %i = CONST i64 0

  LOOP find_loop
    INVARIANT %i >= 0 && %i <= len(s)

    %done = GTE i64 %i %len
    BREAK_IF %done

    %c = LOAD8 %ptr %i
    %found = EQ i64 %c target
    RET_IF %found %i

    %next_i = ADD i64 %i 1
    %i = MOV %next_i
  END_LOOP find_loop

  %not_found = CONST i64 -1
  RET %not_found
END_FUNC

# Parse ASCII digit slice into positive i64 integer
FUNC parse_i64(s: slice<u8>) -> i64
  REQUIRE len(s) > 0

  %len = SLICE_LEN s
  %ptr = SLICE_PTR s
  %i = CONST i64 0
  %acc = CONST i64 0
  %c_zero = CONST i64 48
  %ten = CONST i64 10

  LOOP parse_loop
    INVARIANT %i >= 0 && %i <= len(s)

    %done = GTE i64 %i %len
    BREAK_IF %done

    %c = LOAD8 %ptr %i
    %digit = SUB i64 %c %c_zero

    %mul = MUL i64 %acc %ten
    %next_acc = ADD i64 %mul %digit
    %acc = MOV %next_acc

    %next_i = ADD i64 %i 1
    %i = MOV %next_i
  END_LOOP parse_loop

  RET %acc
END_FUNC
