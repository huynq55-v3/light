# ==============================================================================
# LIGHT STANDARD LIBRARY: stdlib/io.lit
# Formally verified I/O & Process Control module using Z3 SMT Solver
# ==============================================================================

# Safely print a byte slice with specified length
FUNC std_print_slice(s: slice<u8>, len: i64) -> i64
  REQUIRE len > 0 && len <= len(s)

  %rdx = MOV len
  %rsi = MOV s
  %rax = CONST i64 1
  %rdi = CONST i64 1
  SYSCALL %rax %rdi %rsi %rdx

  %res = CONST i64 0
  ENSURE %res == 0
  RET %res
END_FUNC

# Safely print an entire byte slice
FUNC std_print_all(s: slice<u8>) -> i64
  REQUIRE len(s) > 0

  %len = SLICE_LEN s
  %ptr = SLICE_PTR s
  %rdx = MOV %len
  %rsi = MOV %ptr
  %rax = CONST i64 1
  %rdi = CONST i64 1
  SYSCALL %rax %rdi %rsi %rdx

  %res = CONST i64 0
  RET %res
END_FUNC

# Safely terminate process with an exit status code
FUNC std_exit(code: i64) -> i64
  REQUIRE code >= 0 && code <= 255

  %rax = CONST i64 60
  %rdi = MOV code
  %rsi = CONST i64 0
  %rdx = CONST i64 0
  SYSCALL %rax %rdi %rsi %rdx

  RET code
END_FUNC
