# ==============================================================================
# LIGHT STANDARD LIBRARY: std/io.lit
# Module I/O & Process Control được kiểm chứng toán học 100% bằng Z3 SMT Solver
# ==============================================================================

# In chuỗi an toàn từ slice<u8> với độ dài len chỉ định
# HỢP ĐỒNG BẢO MẬT: len phải lớn hơn 0 VÀ KHÔNG ĐƯỢC VƯỢT QUÁ len(s)!
FUNC std_print_slice(s: slice<u8>, len: i64) -> i64
  REQUIRE len > 0 && len <= len(s)

  %ptr = SLICE_PTR s
  %rdx = MOV len
  %rsi = MOV %ptr
  %rax = CONST i64 1
  %rdi = CONST i64 1
  SYSCALL %rax %rdi %rsi %rdx

  %res = CONST i64 0
  ENSURE %res == 0
  RET %res
END_FUNC

# In toàn bộ slice<u8> (tự động lấy đúng len(s))
FUNC std_print_all(s: slice<u8>) -> i64
  REQUIRE len(s) > 0

  %ptr = SLICE_PTR s
  %len = SLICE_LEN s
  %rdx = MOV %len
  %rsi = MOV %ptr
  %rax = CONST i64 1
  %rdi = CONST i64 1
  SYSCALL %rax %rdi %rsi %rdx

  %res = CONST i64 0
  RET %res
END_FUNC

# Thoát tiến trình an toàn với exit code
FUNC std_exit(code: i64) -> i64
  REQUIRE code >= 0 && code <= 255

  %rax = CONST i64 60
  %rdi = MOV code
  %rsi = CONST i64 0
  %rdx = CONST i64 0
  SYSCALL %rax %rdi %rsi %rdx

  RET code
END_FUNC
