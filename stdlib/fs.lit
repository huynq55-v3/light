# ==============================================================================
# LIGHT STANDARD LIBRARY: stdlib/fs.lit
# Formally verified Linux raw syscall filesystem module using Z3 SMT Solver
# ==============================================================================

# Linux sys_open: open file at null-terminated path
# flags: 0 = O_RDONLY, 1 = O_WRONLY, 2 = O_RDWR, 577 = O_WRONLY|O_CREAT|O_TRUNC
# mode: permission mode (e.g. 420 for 0o644, 493 for 0o755)
# Returns: file descriptor (fd >= 0) on success, or -1 on error
FUNC sys_open(path: slice<u8>, flags: i64, mode: i64) -> i64
  REQUIRE len(path) > 0

  %rax = CONST i64 2
  %rdi = SLICE_PTR path
  %rsi = MOV flags
  %rdx = MOV mode
  %fd = SYSCALL %rax %rdi %rsi %rdx

  ENSURE %fd >= -1
  RET %fd
END_FUNC

# Linux sys_read: read up to count bytes from fd into buffer
# Formally verified: count is guaranteed never to overflow the buffer slice!
FUNC sys_read(fd: i64, buf: slice<u8>, count: i64) -> i64
  REQUIRE fd >= 0 && count >= 0 && count <= len(buf)

  %rax = CONST i64 0
  %rdi = MOV fd
  %rsi = SLICE_PTR buf
  %rdx = MOV count
  %bytes_read = SYSCALL %rax %rdi %rsi %rdx

  ENSURE %bytes_read >= -1 && %bytes_read <= count
  RET %bytes_read
END_FUNC

# Linux sys_write: write count bytes from buffer to fd
# Formally verified: count is guaranteed never to exceed buffer boundary!
FUNC sys_write(fd: i64, buf: slice<u8>, count: i64) -> i64
  REQUIRE fd >= 0 && count >= 0 && count <= len(buf)

  %rax = CONST i64 1
  %rdi = MOV fd
  %rsi = SLICE_PTR buf
  %rdx = MOV count
  %bytes_written = SYSCALL %rax %rdi %rsi %rdx

  ENSURE %bytes_written >= -1 && %bytes_written <= count
  RET %bytes_written
END_FUNC

# Linux sys_close: close file descriptor
FUNC sys_close(fd: i64) -> i64
  REQUIRE fd >= 0

  %rax = CONST i64 3
  %rdi = MOV fd
  %rsi = CONST i64 0
  %rdx = CONST i64 0
  %res = SYSCALL %rax %rdi %rsi %rdx

  ENSURE %res >= -1
  RET %res
END_FUNC

# High-level file reading: read file into destination buffer
FUNC fs_read_file(path: slice<u8>, out_buf: slice<u8>) -> i64
  REQUIRE len(path) > 0 && len(out_buf) > 0

  %flags = CONST i64 0
  %mode = CONST i64 0
  %fd = CALL sys_open path %flags %mode

  %zero = CONST i64 0
  %is_err = LT i64 %fd %zero
  RET_IF %is_err %fd

  %cap = SLICE_LEN out_buf
  %bytes = CALL sys_read %fd out_buf %cap
  %dummy = CALL sys_close %fd

  ENSURE %bytes >= -1 && %bytes <= len(out_buf)
  RET %bytes
END_FUNC

# High-level file writing: write entire buffer to file (creates or truncates)
FUNC fs_write_file(path: slice<u8>, content: slice<u8>) -> i64
  REQUIRE len(path) > 0 && len(content) >= 0

  %flags = CONST i64 577
  %mode = CONST i64 493
  %fd = CALL sys_open path %flags %mode

  %zero = CONST i64 0
  %is_err = LT i64 %fd %zero
  RET_IF %is_err %fd

  %len = SLICE_LEN content
  %bytes = CALL sys_write %fd content %len
  %dummy = CALL sys_close %fd

  ENSURE %bytes >= -1 && %bytes <= len(content)
  RET %bytes
END_FUNC

# High-level file writing: write exact count bytes from buffer to file
FUNC fs_write_file_bytes(path: slice<u8>, content: slice<u8>, count: i64) -> i64
  REQUIRE len(path) > 0 && count >= 0 && count <= len(content)

  %flags = CONST i64 577
  %mode = CONST i64 493
  %fd = CALL sys_open path %flags %mode

  %zero = CONST i64 0
  %is_err = LT i64 %fd %zero
  RET_IF %is_err %fd

  %bytes = CALL sys_write %fd content count
  %dummy = CALL sys_close %fd

  ENSURE %bytes >= -1 && %bytes <= count
  RET %bytes
END_FUNC

