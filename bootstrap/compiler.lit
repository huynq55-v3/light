# ==============================================================================
# LIGHT SELF-HOSTING BOOTSTRAP COMPILER (Stage 1)
# Written directly in Light (.lit) flat SSA language!
# Fully verified with Z3 SMT Solver
# ==============================================================================

IMPORT "../stdlib/io.lit"
IMPORT "../stdlib/string.lit"
IMPORT "../stdlib/fs.lit"

# Emit 64-byte ELF64 Header and 56-byte Program Header into destination buffer
FUNC emit_elf_header(buf: slice<u8>, code_len: i64) -> i64
  REQUIRE len(buf) >= 120 && code_len >= 0

  %ptr = SLICE_PTR buf

  # ELF Magic: 0x7F 'E' 'L' 'F'
  %b0 = CONST i64 127
  STORE8 %ptr 0 %b0
  %b1 = CONST i64 69
  STORE8 %ptr 1 %b1
  %b2 = CONST i64 76
  STORE8 %ptr 2 %b2
  %b3 = CONST i64 70
  STORE8 %ptr 3 %b3

  # EI_CLASS = 2 (64-bit), EI_DATA = 1 (Little Endian), EI_VERSION = 1
  %two = CONST i64 2
  STORE8 %ptr 4 %two
  %one = CONST i64 1
  STORE8 %ptr 5 %one
  STORE8 %ptr 6 %one

  # e_type = 2 (ET_EXEC) at offset 16
  STORE8 %ptr 16 %two

  # e_machine = 0x3E (AMD x86-64 = 62) at offset 18
  %mach = CONST i64 62
  STORE8 %ptr 18 %mach

  # e_version = 1 at offset 20
  STORE8 %ptr 20 %one

  # e_entry = 0x400078 (4194424) at offset 24
  %entry = CONST i64 4194424
  STORE64 %ptr 24 %entry

  # e_phoff = 64 at offset 32
  %phoff = CONST i64 64
  STORE64 %ptr 32 %phoff

  # e_ehsize = 64 at offset 52
  STORE8 %ptr 52 %phoff

  # e_phentsize = 56 at offset 54
  %phentsize = CONST i64 56
  STORE8 %ptr 54 %phentsize

  # e_phnum = 1 at offset 56
  STORE8 %ptr 56 %one

  # Program Header (offset 64):
  # p_type = 1 (PT_LOAD) at offset 64
  STORE8 %ptr 64 %one

  # p_flags = 7 (PF_R | PF_W | PF_X) at offset 68
  %flags = CONST i64 7
  STORE8 %ptr 68 %flags

  # p_vaddr = 0x400000 (4194304) at offset 80
  %vaddr = CONST i64 4194304
  STORE64 %ptr 80 %vaddr

  # p_paddr = 0x400000 at offset 88
  STORE64 %ptr 88 %vaddr

  # Total binary size = 120 + code_len
  %hdr_len = CONST i64 120
  %total_sz = ADD i64 %hdr_len code_len

  # p_filesz at offset 96
  STORE64 %ptr 96 %total_sz

  # p_memsz at offset 104: 64KB virtual memory allocation for code + data segment + heap
  %min_memsz = CONST i64 65536
  STORE64 %ptr 104 %min_memsz

  # p_align = 4096 at offset 112
  %align = CONST i64 4096
  STORE64 %ptr 112 %align

  RET %hdr_len
END_FUNC

# Emit single byte into buffer at pos
FUNC emit_byte(buf: slice<u8>, pos: i64, b: i64) -> i64
  REQUIRE pos >= 0 && pos < len(buf) && b >= 0 && b <= 255
  %ptr = SLICE_PTR buf
  STORE8 %ptr pos b
  %next_pos = ADD i64 pos 1
  ENSURE %next_pos == pos + 1
  RET %next_pos
END_FUNC

# Emit 64-bit integer into buffer at pos (little-endian)
FUNC emit_u64(buf: slice<u8>, pos: i64, val: i64) -> i64
  REQUIRE pos >= 0 && pos + 8 <= len(buf)
  %ptr = SLICE_PTR buf
  STORE64 %ptr pos val
  %next_pos = ADD i64 pos 8
  ENSURE %next_pos == pos + 8
  RET %next_pos
END_FUNC

# Emit: mov reg, imm64 (10 bytes: 0x48, 0xB8+reg, imm64)
FUNC emit_mov_imm(buf: slice<u8>, pos: i64, reg: i64, imm: i64) -> i64
  REQUIRE pos >= 0 && pos + 10 <= len(buf) && reg >= 0 && reg <= 7
  %ptr = SLICE_PTR buf
  %b_rex = CONST i64 72
  STORE8 %ptr pos %b_rex
  %p1 = ADD i64 pos 1
  %b_base = CONST i64 184
  %opcode = ADD i64 %b_base reg
  STORE8 %ptr %p1 %opcode
  %p2 = ADD i64 pos 2
  STORE64 %ptr %p2 imm
  %next_pos = ADD i64 pos 10
  ENSURE %next_pos == pos + 10
  RET %next_pos
END_FUNC

# Emit: mov dst, src (3 bytes: 0x48, 0x89, 0xC0 | (src<<3) | dst)
FUNC emit_mov_rr(buf: slice<u8>, pos: i64, dst: i64, src: i64) -> i64
  REQUIRE pos >= 0 && pos + 3 <= len(buf) && dst >= 0 && dst <= 7 && src >= 0 && src <= 7
  %ptr = SLICE_PTR buf
  %b_rex = CONST i64 72
  STORE8 %ptr pos %b_rex
  %p1 = ADD i64 pos 1
  %b_89 = CONST i64 137
  STORE8 %ptr %p1 %b_89
  %p2 = ADD i64 pos 2
  %eight = CONST i64 8
  %src_sh = MUL i64 src %eight
  %c0 = CONST i64 192
  %tmp = ADD i64 %c0 %src_sh
  %modrm = ADD i64 %tmp dst
  STORE8 %ptr %p2 %modrm
  %next_pos = ADD i64 pos 3
  ENSURE %next_pos == pos + 3
  RET %next_pos
END_FUNC

# Emit: add dst, src (3 bytes: 0x48, 0x01, 0xC0 | (src<<3) | dst)
FUNC emit_add_rr(buf: slice<u8>, pos: i64, dst: i64, src: i64) -> i64
  REQUIRE pos >= 0 && pos + 3 <= len(buf) && dst >= 0 && dst <= 7 && src >= 0 && src <= 7
  %ptr = SLICE_PTR buf
  %b_rex = CONST i64 72
  STORE8 %ptr pos %b_rex
  %p1 = ADD i64 pos 1
  %b_01 = CONST i64 1
  STORE8 %ptr %p1 %b_01
  %p2 = ADD i64 pos 2
  %eight = CONST i64 8
  %src_sh = MUL i64 src %eight
  %c0 = CONST i64 192
  %tmp = ADD i64 %c0 %src_sh
  %modrm = ADD i64 %tmp dst
  STORE8 %ptr %p2 %modrm
  %next_pos = ADD i64 pos 3
  ENSURE %next_pos == pos + 3
  RET %next_pos
END_FUNC

# Emit: sub dst, src (3 bytes: 0x48, 0x29, 0xC0 | (src<<3) | dst)
FUNC emit_sub_rr(buf: slice<u8>, pos: i64, dst: i64, src: i64) -> i64
  REQUIRE pos >= 0 && pos + 3 <= len(buf) && dst >= 0 && dst <= 7 && src >= 0 && src <= 7
  %ptr = SLICE_PTR buf
  %b_rex = CONST i64 72
  STORE8 %ptr pos %b_rex
  %p1 = ADD i64 pos 1
  %b_29 = CONST i64 41
  STORE8 %ptr %p1 %b_29
  %p2 = ADD i64 pos 2
  %eight = CONST i64 8
  %src_sh = MUL i64 src %eight
  %c0 = CONST i64 192
  %tmp = ADD i64 %c0 %src_sh
  %modrm = ADD i64 %tmp dst
  STORE8 %ptr %p2 %modrm
  %next_pos = ADD i64 pos 3
  ENSURE %next_pos == pos + 3
  RET %next_pos
END_FUNC

# Emit: imul dst, src (4 bytes: 0x48, 0x0F, 0xAF, 0xC0 | (dst<<3) | src)
FUNC emit_mul_rr(buf: slice<u8>, pos: i64, dst: i64, src: i64) -> i64
  REQUIRE pos >= 0 && pos + 4 <= len(buf) && dst >= 0 && dst <= 7 && src >= 0 && src <= 7
  %ptr = SLICE_PTR buf
  %b_rex = CONST i64 72
  STORE8 %ptr pos %b_rex
  %p1 = ADD i64 pos 1
  %b_0f = CONST i64 15
  STORE8 %ptr %p1 %b_0f
  %p2 = ADD i64 pos 2
  %b_af = CONST i64 175
  STORE8 %ptr %p2 %b_af
  %p3 = ADD i64 pos 3
  %eight = CONST i64 8
  %dst_sh = MUL i64 dst %eight
  %c0 = CONST i64 192
  %tmp = ADD i64 %c0 %dst_sh
  %modrm = ADD i64 %tmp src
  STORE8 %ptr %p3 %modrm
  %next_pos = ADD i64 pos 4
  ENSURE %next_pos == pos + 4
  RET %next_pos
END_FUNC

# Emit: and dst, src (3 bytes: 0x48, 0x21, 0xC0 | (src<<3) | dst)
FUNC emit_and_rr(buf: slice<u8>, pos: i64, dst: i64, src: i64) -> i64
  REQUIRE pos >= 0 && pos + 3 <= len(buf) && dst >= 0 && dst <= 7 && src >= 0 && src <= 7
  %ptr = SLICE_PTR buf
  %b_rex = CONST i64 72
  STORE8 %ptr pos %b_rex
  %p1 = ADD i64 pos 1
  %b_21 = CONST i64 33
  STORE8 %ptr %p1 %b_21
  %p2 = ADD i64 pos 2
  %eight = CONST i64 8
  %src_sh = MUL i64 src %eight
  %c0 = CONST i64 192
  %tmp = ADD i64 %c0 %src_sh
  %modrm = ADD i64 %tmp dst
  STORE8 %ptr %p2 %modrm
  %next_pos = ADD i64 pos 3
  ENSURE %next_pos == pos + 3
  RET %next_pos
END_FUNC

# Emit: or dst, src (3 bytes: 0x48, 0x09, 0xC0 | (src<<3) | dst)
FUNC emit_or_rr(buf: slice<u8>, pos: i64, dst: i64, src: i64) -> i64
  REQUIRE pos >= 0 && pos + 3 <= len(buf) && dst >= 0 && dst <= 7 && src >= 0 && src <= 7
  %ptr = SLICE_PTR buf
  %b_rex = CONST i64 72
  STORE8 %ptr pos %b_rex
  %p1 = ADD i64 pos 1
  %b_09 = CONST i64 9
  STORE8 %ptr %p1 %b_09
  %p2 = ADD i64 pos 2
  %eight = CONST i64 8
  %src_sh = MUL i64 src %eight
  %c0 = CONST i64 192
  %tmp = ADD i64 %c0 %src_sh
  %modrm = ADD i64 %tmp dst
  STORE8 %ptr %p2 %modrm
  %next_pos = ADD i64 pos 3
  ENSURE %next_pos == pos + 3
  RET %next_pos
END_FUNC

# Emit: xor dst, src (3 bytes: 0x48, 0x31, 0xC0 | (src<<3) | dst)
FUNC emit_xor_rr(buf: slice<u8>, pos: i64, dst: i64, src: i64) -> i64
  REQUIRE pos >= 0 && pos + 3 <= len(buf) && dst >= 0 && dst <= 7 && src >= 0 && src <= 7
  %ptr = SLICE_PTR buf
  %b_rex = CONST i64 72
  STORE8 %ptr pos %b_rex
  %p1 = ADD i64 pos 1
  %b_31 = CONST i64 49
  STORE8 %ptr %p1 %b_31
  %p2 = ADD i64 pos 2
  %eight = CONST i64 8
  %src_sh = MUL i64 src %eight
  %c0 = CONST i64 192
  %tmp = ADD i64 %c0 %src_sh
  %modrm = ADD i64 %tmp dst
  STORE8 %ptr %p2 %modrm
  %next_pos = ADD i64 pos 3
  ENSURE %next_pos == pos + 3
  RET %next_pos
END_FUNC

# Emit: cmp r1, r2 (3 bytes: 0x48, 0x39, 0xC0 | (r2<<3) | r1)
FUNC emit_cmp_rr(buf: slice<u8>, pos: i64, r1: i64, r2: i64) -> i64
  REQUIRE pos >= 0 && pos + 3 <= len(buf) && r1 >= 0 && r1 <= 7 && r2 >= 0 && r2 <= 7
  %ptr = SLICE_PTR buf
  %b_rex = CONST i64 72
  STORE8 %ptr pos %b_rex
  %p1 = ADD i64 pos 1
  %b_39 = CONST i64 57
  STORE8 %ptr %p1 %b_39
  %p2 = ADD i64 pos 2
  %eight = CONST i64 8
  %r2_sh = MUL i64 r2 %eight
  %c0 = CONST i64 192
  %tmp = ADD i64 %c0 %r2_sh
  %modrm = ADD i64 %tmp r1
  STORE8 %ptr %p2 %modrm
  %next_pos = ADD i64 pos 3
  ENSURE %next_pos == pos + 3
  RET %next_pos
END_FUNC

# Emit: push reg (1 byte: 0x50 + reg)
FUNC emit_push_reg(buf: slice<u8>, pos: i64, reg: i64) -> i64
  REQUIRE pos >= 0 && pos + 1 <= len(buf) && reg >= 0 && reg <= 7
  %ptr = SLICE_PTR buf
  %b_base = CONST i64 80
  %opcode = ADD i64 %b_base reg
  STORE8 %ptr pos %opcode
  %next_pos = ADD i64 pos 1
  ENSURE %next_pos == pos + 1
  RET %next_pos
END_FUNC

# Emit: pop reg (1 byte: 0x58 + reg)
FUNC emit_pop_reg(buf: slice<u8>, pos: i64, reg: i64) -> i64
  REQUIRE pos >= 0 && pos + 1 <= len(buf) && reg >= 0 && reg <= 7
  %ptr = SLICE_PTR buf
  %b_base = CONST i64 88
  %opcode = ADD i64 %b_base reg
  STORE8 %ptr pos %opcode
  %next_pos = ADD i64 pos 1
  ENSURE %next_pos == pos + 1
  RET %next_pos
END_FUNC

# Emit: movzx rax, byte ptr [rax + rcx] (5 bytes: 48 0f b6 04 08)
FUNC emit_load8_idx(buf: slice<u8>, pos: i64) -> i64
  REQUIRE pos >= 0 && pos + 5 <= len(buf)
  %ptr = SLICE_PTR buf
  %b0 = CONST i64 72
  STORE8 %ptr pos %b0
  %p1 = ADD i64 pos 1
  %b1 = CONST i64 15
  STORE8 %ptr %p1 %b1
  %p2 = ADD i64 pos 2
  %b2 = CONST i64 182
  STORE8 %ptr %p2 %b2
  %p3 = ADD i64 pos 3
  %b3 = CONST i64 4
  STORE8 %ptr %p3 %b3
  %p4 = ADD i64 pos 4
  %b4 = CONST i64 8
  STORE8 %ptr %p4 %b4
  %next_pos = ADD i64 pos 5
  ENSURE %next_pos == pos + 5
  RET %next_pos
END_FUNC

# Emit: mov byte ptr [rax + rcx], dl (3 bytes: 88 14 08)
FUNC emit_store8_idx(buf: slice<u8>, pos: i64) -> i64
  REQUIRE pos >= 0 && pos + 3 <= len(buf)
  %ptr = SLICE_PTR buf
  %b0 = CONST i64 136
  STORE8 %ptr pos %b0
  %p1 = ADD i64 pos 1
  %b1 = CONST i64 20
  STORE8 %ptr %p1 %b1
  %p2 = ADD i64 pos 2
  %b2 = CONST i64 8
  STORE8 %ptr %p2 %b2
  %next_pos = ADD i64 pos 3
  ENSURE %next_pos == pos + 3
  RET %next_pos
END_FUNC

# Emit: mov rax, qword ptr [rax + rcx] (4 bytes: 48 8b 04 08)
FUNC emit_load64_idx(buf: slice<u8>, pos: i64) -> i64
  REQUIRE pos >= 0 && pos + 4 <= len(buf)
  %ptr = SLICE_PTR buf
  %b0 = CONST i64 72
  STORE8 %ptr pos %b0
  %p1 = ADD i64 pos 1
  %b1 = CONST i64 139
  STORE8 %ptr %p1 %b1
  %p2 = ADD i64 pos 2
  %b2 = CONST i64 4
  STORE8 %ptr %p2 %b2
  %p3 = ADD i64 pos 3
  %b3 = CONST i64 8
  STORE8 %ptr %p3 %b3
  %next_pos = ADD i64 pos 4
  ENSURE %next_pos == pos + 4
  RET %next_pos
END_FUNC

# Emit: mov qword ptr [rax + rcx], rdx (4 bytes: 48 89 14 08)
FUNC emit_store64_idx(buf: slice<u8>, pos: i64) -> i64
  REQUIRE pos >= 0 && pos + 4 <= len(buf)
  %ptr = SLICE_PTR buf
  %b0 = CONST i64 72
  STORE8 %ptr pos %b0
  %p1 = ADD i64 pos 1
  %b1 = CONST i64 137
  STORE8 %ptr %p1 %b1
  %p2 = ADD i64 pos 2
  %b2 = CONST i64 20
  STORE8 %ptr %p2 %b2
  %p3 = ADD i64 pos 3
  %b3 = CONST i64 8
  STORE8 %ptr %p3 %b3
  %next_pos = ADD i64 pos 4
  ENSURE %next_pos == pos + 4
  RET %next_pos
END_FUNC

# Emit: test reg, reg (3 bytes: 0x48, 0x85, 0xC0 | (reg<<3) | reg)
FUNC emit_test_rr(buf: slice<u8>, pos: i64, reg: i64) -> i64
  REQUIRE pos >= 0 && pos + 3 <= len(buf) && reg >= 0 && reg <= 7
  %ptr = SLICE_PTR buf
  %b_rex = CONST i64 72
  STORE8 %ptr pos %b_rex
  %p1 = ADD i64 pos 1
  %b_85 = CONST i64 133
  STORE8 %ptr %p1 %b_85
  %p2 = ADD i64 pos 2
  %eight = CONST i64 8
  %reg_sh = MUL i64 reg %eight
  %c0 = CONST i64 192
  %tmp = ADD i64 %c0 %reg_sh
  %modrm = ADD i64 %tmp reg
  STORE8 %ptr %p2 %modrm
  %next_pos = ADD i64 pos 3
  ENSURE %next_pos == pos + 3
  RET %next_pos
END_FUNC

# Emit: jmp short rel8 (2 bytes: 0xEB, rel8)
FUNC emit_jmp_rel8(buf: slice<u8>, pos: i64, rel8: i64) -> i64
  REQUIRE pos >= 0 && pos + 2 <= len(buf) && rel8 >= 0 && rel8 <= 255
  %ptr = SLICE_PTR buf
  %b_eb = CONST i64 235
  STORE8 %ptr pos %b_eb
  %p1 = ADD i64 pos 1
  STORE8 %ptr %p1 rel8
  %next_pos = ADD i64 pos 2
  ENSURE %next_pos == pos + 2
  RET %next_pos
END_FUNC

# Emit: jz short rel8 (2 bytes: 0x74, rel8)
FUNC emit_jz_rel8(buf: slice<u8>, pos: i64, rel8: i64) -> i64
  REQUIRE pos >= 0 && pos + 2 <= len(buf) && rel8 >= 0 && rel8 <= 255
  %ptr = SLICE_PTR buf
  %b_74 = CONST i64 116
  STORE8 %ptr pos %b_74
  %p1 = ADD i64 pos 1
  STORE8 %ptr %p1 rel8
  %next_pos = ADD i64 pos 2
  ENSURE %next_pos == pos + 2
  RET %next_pos
END_FUNC

# Emit: jnz short rel8 (2 bytes: 0x75, rel8)
FUNC emit_jnz_rel8(buf: slice<u8>, pos: i64, rel8: i64) -> i64
  REQUIRE pos >= 0 && pos + 2 <= len(buf) && rel8 >= 0 && rel8 <= 255
  %ptr = SLICE_PTR buf
  %b_75 = CONST i64 117
  STORE8 %ptr pos %b_75
  %p1 = ADD i64 pos 1
  STORE8 %ptr %p1 rel8
  %next_pos = ADD i64 pos 2
  ENSURE %next_pos == pos + 2
  RET %next_pos
END_FUNC

# Emit: syscall (2 bytes: 0x0F, 0x05)
FUNC emit_syscall_inst(buf: slice<u8>, pos: i64) -> i64
  REQUIRE pos >= 0 && pos + 2 <= len(buf)
  %ptr = SLICE_PTR buf
  %b_0f = CONST i64 15
  STORE8 %ptr pos %b_0f
  %p1 = ADD i64 pos 1
  %b_05 = CONST i64 5
  STORE8 %ptr %p1 %b_05
  %next_pos = ADD i64 pos 2
  ENSURE %next_pos == pos + 2
  RET %next_pos
END_FUNC

# Emit: ret (1 byte: 0xC3)
FUNC emit_ret_inst(buf: slice<u8>, pos: i64) -> i64
  REQUIRE pos >= 0 && pos + 1 <= len(buf)
  %ptr = SLICE_PTR buf
  %b_c3 = CONST i64 195
  STORE8 %ptr pos %b_c3
  %next_pos = ADD i64 pos 1
  ENSURE %next_pos == pos + 1
  RET %next_pos
END_FUNC

# Parse register name (%rax, %rcx, %rdx, %rbx, %rsi, %rdi, or %r0..%r7) into 0..7 ID
FUNC parse_reg_id(buf: slice<u8>, pos: i64) -> i64
  REQUIRE pos >= 0 && pos + 4 <= len(buf)

  %ptr = SLICE_PTR buf
  %p2 = ADD i64 pos 2
  %c2 = LOAD8 %ptr %p2
  %p3 = ADD i64 pos 3
  %c3 = LOAD8 %ptr %p3

  # Check if %r0 .. %r7 (ASCII 48 .. 55)
  %c_0 = CONST i64 48
  %c_7 = CONST i64 55
  %is_digit_low = GTE i64 %c2 %c_0
  %is_digit_high = LTE i64 %c2 %c_7
  %is_r_num = AND bool %is_digit_low %is_digit_high
  %digit_id = SUB i64 %c2 %c_0
  RET_IF %is_r_num %digit_id

  # Check 'a' (97) -> rax = 0
  %c_a = CONST i64 97
  %is_a = EQ i64 %c2 %c_a
  %zero = CONST i64 0
  RET_IF %is_a %zero

  # Check 'c' (99) -> rcx = 1
  %c_c = CONST i64 99
  %is_c = EQ i64 %c2 %c_c
  %one = CONST i64 1
  RET_IF %is_c %one

  # Check 'b' (98): if c3 == 'p' (112) -> rbp = 5, else rbx = 3
  %c_b = CONST i64 98
  %is_b = EQ i64 %c2 %c_b
  %c_p = CONST i64 112
  %is_bp = EQ i64 %c3 %c_p
  %is_rbp = AND bool %is_b %is_bp
  %five = CONST i64 5
  RET_IF %is_rbp %five
  %three = CONST i64 3
  RET_IF %is_b %three

  # Check 's' (115): if c3 == 'p' (112) -> rsp = 4, else rsi = 6
  %c_s = CONST i64 115
  %is_s = EQ i64 %c2 %c_s
  %is_sp = EQ i64 %c3 %c_p
  %is_rsp = AND bool %is_s %is_sp
  %four = CONST i64 4
  RET_IF %is_rsp %four
  %six = CONST i64 6
  RET_IF %is_s %six

  # Check 'd' (100): if c3 == 'i' (105) -> rdi = 7, else rdx = 2
  %c_i = CONST i64 105
  %is_i = EQ i64 %c3 %c_i
  %seven = CONST i64 7
  RET_IF %is_i %seven

  %two = CONST i64 2
  ENSURE %two >= 0 && %two <= 7
  RET %two
END_FUNC

# Emit standalone exit machine code at offset 120
FUNC emit_exit_code(buf: slice<u8>, exit_code: i64) -> i64
  REQUIRE len(buf) >= 136 && exit_code >= 0 && exit_code <= 255

  %ptr = SLICE_PTR buf

  # mov rdi, exit_code -> 48 c7 c7 <code: 4 bytes>
  %b_rex = CONST i64 72
  STORE8 %ptr 120 %b_rex
  %b_c7 = CONST i64 199
  STORE8 %ptr 121 %b_c7
  STORE8 %ptr 122 %b_c7
  STORE8 %ptr 123 exit_code

  # mov rax, 60 (sys_exit) -> 48 c7 c0 3c 00 00 00
  STORE8 %ptr 127 %b_rex
  STORE8 %ptr 128 %b_c7
  %b_c0 = CONST i64 192
  STORE8 %ptr 129 %b_c0
  %b_sys_exit = CONST i64 60
  STORE8 %ptr 130 %b_sys_exit

  # syscall -> 0f 05
  %b_0f = CONST i64 15
  STORE8 %ptr 134 %b_0f
  %b_05 = CONST i64 5
  STORE8 %ptr 135 %b_05

  %total_len = CONST i64 136
  RET %total_len
END_FUNC

# Emit standalone print string and exit machine code at offset 120
# String data is expected at offset 176 (virtual address 0x4000b0)
FUNC emit_print_and_exit(buf: slice<u8>, str_len: i64, exit_code: i64) -> i64
  REQUIRE len(buf) >= 176 && str_len >= 0 && exit_code >= 0 && exit_code <= 255

  %ptr = SLICE_PTR buf

  # 1. mov rax, 1 (sys_write) -> 48 c7 c0 01 00 00 00
  %b_rex = CONST i64 72
  %b_c7 = CONST i64 199
  %b_c0 = CONST i64 192
  %b_one = CONST i64 1
  STORE8 %ptr 120 %b_rex
  STORE8 %ptr 121 %b_c7
  STORE8 %ptr 122 %b_c0
  STORE8 %ptr 123 %b_one

  # 2. mov rdi, 1 (stdout) -> 48 c7 c7 01 00 00 00
  STORE8 %ptr 127 %b_rex
  STORE8 %ptr 128 %b_c7
  STORE8 %ptr 129 %b_c7
  STORE8 %ptr 130 %b_one

  # 3. mov rsi, 0x4000b0 -> 48 be b0 00 40 00 00 00 00 00
  %b_be = CONST i64 190
  %b_b0 = CONST i64 176
  %b_40 = CONST i64 64
  STORE8 %ptr 134 %b_rex
  STORE8 %ptr 135 %b_be
  STORE8 %ptr 136 %b_b0
  STORE8 %ptr 138 %b_40

  # 4. mov rdx, str_len -> 48 c7 c2 <str_len> 00 00 00
  %b_c2 = CONST i64 194
  STORE8 %ptr 144 %b_rex
  STORE8 %ptr 145 %b_c7
  STORE8 %ptr 146 %b_c2
  STORE8 %ptr 147 str_len

  # 5. syscall -> 0f 05
  %b_0f = CONST i64 15
  %b_05 = CONST i64 5
  STORE8 %ptr 151 %b_0f
  STORE8 %ptr 152 %b_05

  # 6. mov rdi, exit_code -> 48 c7 c7 <exit_code> 00 00 00
  STORE8 %ptr 153 %b_rex
  STORE8 %ptr 154 %b_c7
  STORE8 %ptr 155 %b_c7
  STORE8 %ptr 156 exit_code

  # 7. mov rax, 60 (sys_exit) -> 48 c7 c0 3c 00 00 00
  %b_sys_exit = CONST i64 60
  STORE8 %ptr 160 %b_rex
  STORE8 %ptr 161 %b_c7
  STORE8 %ptr 162 %b_c0
  STORE8 %ptr 163 %b_sys_exit

  # 8. syscall -> 0f 05
  STORE8 %ptr 167 %b_0f
  STORE8 %ptr 168 %b_05

  # NOP padding 169..175: 0x90 (144)
  %b_nop = CONST i64 144
  STORE8 %ptr 169 %b_nop
  STORE8 %ptr 170 %b_nop
  STORE8 %ptr 171 %b_nop
  STORE8 %ptr 172 %b_nop
  STORE8 %ptr 173 %b_nop
  STORE8 %ptr 174 %b_nop
  STORE8 %ptr 175 %b_nop

  %code_end = CONST i64 176
  RET %code_end
END_FUNC

# Copy string between start and end from src into dst at dst_start, unescaping \n
FUNC copy_str_unescaped(src_ptr: i64, start: i64, end: i64, dst_ptr: i64, dst_start: i64) -> i64
  REQUIRE start >= 0 && start <= end && dst_start >= 0

  %len_s = SUB i64 end start

  %i = CONST i64 0
  %out_idx = MOV dst_start
  %backslash = CONST i64 92
  %c_n = CONST i64 110
  %nl_byte = CONST i64 10

  LOOP unescape_loop
    INVARIANT %i >= 0 && %i <= len_s

    %done = GTE i64 %i %len_s
    BREAK_IF %done

    %cur_src = ADD i64 start %i
    %c = LOAD8 src_ptr %cur_src

    %is_bs = EQ i64 %c %backslash
    %false_b = CONST bool false
    %not_bs = EQ bool %is_bs %false_b
    BR_IF %not_bs copy_normal

    # Check next char
    %next_i = ADD i64 %i 1
    %has_next = LT i64 %next_i %len_s
    %not_has_next = EQ bool %has_next %false_b
    BR_IF %not_has_next copy_normal

    %next_src = ADD i64 start %next_i
    %c_next = LOAD8 src_ptr %next_src
    %is_n = EQ i64 %c_next %c_n
    %not_n = EQ bool %is_n %false_b
    BR_IF %not_n copy_normal

    # It is \n: store newline byte 10
    STORE8 dst_ptr %out_idx %nl_byte
    %next_out = ADD i64 %out_idx 1
    %out_idx = MOV %next_out
    %step2 = ADD i64 %i 2
    %i = MOV %step2
    JUMP step_done

    LABEL copy_normal
    STORE8 dst_ptr %out_idx %c
    %next_out2 = ADD i64 %out_idx 1
    %out_idx = MOV %next_out2
    %step1 = ADD i64 %i 1
    %i = MOV %step1

    LABEL step_done
  END_LOOP unescape_loop

  %total_written = SUB i64 %out_idx dst_start
  RET %total_written
END_FUNC


# Compile input .lit file and emit standalone ELF binary
FUNC compile_file(src_path: slice<u8>, out_path: slice<u8>) -> i64
  REQUIRE len(src_path) > 0 && len(out_path) > 0

  # Read source file
  %src_buf = ALLOC slice<u8> 1024
  %bytes_read = CALL fs_read_file src_path %src_buf

  %zero = CONST i64 0
  %read_err = LTE i64 %bytes_read %zero
  RET_IF %read_err %bytes_read

  %pos = CONST i64 0
  %parsed_exit = CONST i64 0
  %has_string = CONST bool false
  %str_len = CONST i64 0
  %has_dyn_code = CONST bool false
  %cur_code_pos = CONST i64 120

  # Allocate prefix slice for "RET "
  %p_ret = ALLOC slice<u8> 4
  STORE_STR %p_ret "RET "

  # Allocate prefix slice for "STORE_STR"
  %p_store = ALLOC slice<u8> 9
  STORE_STR %p_store "STORE_STR"

  # Allocate prefix slice for "CONST i64 "
  %p_const = ALLOC slice<u8> 10
  STORE_STR %p_const "CONST i64 "

  # Allocate prefix slice for "ADD i64 "
  %p_add = ALLOC slice<u8> 8
  STORE_STR %p_add "ADD i64 "

  # Allocate prefix slice for "SUB i64 "
  %p_sub = ALLOC slice<u8> 8
  STORE_STR %p_sub "SUB i64 "

  # Allocate prefix slice for "MUL i64 "
  %p_mul = ALLOC slice<u8> 8
  STORE_STR %p_mul "MUL i64 "

  # Allocate prefix slice for "MOV "
  %p_mov = ALLOC slice<u8> 4
  STORE_STR %p_mov "MOV "

  # Allocate prefix slice for "SYSCALL"
  %p_sys = ALLOC slice<u8> 7
  STORE_STR %p_sys "SYSCALL"

  # Allocate prefix slice for "STORE8 "
  %p_s8 = ALLOC slice<u8> 7
  STORE_STR %p_s8 "STORE8 "

  # Allocate prefix slice for "LOAD8 "
  %p_l8 = ALLOC slice<u8> 6
  STORE_STR %p_l8 "LOAD8 "

  # Allocate prefix slice for "STORE64 "
  %p_s64 = ALLOC slice<u8> 8
  STORE_STR %p_s64 "STORE64 "

  # Allocate prefix slice for "LOAD64 "
  %p_l64 = ALLOC slice<u8> 7
  STORE_STR %p_l64 "LOAD64 "

  # Allocate prefix slice for "ALLOC "
  %p_alloc = ALLOC slice<u8> 6
  STORE_STR %p_alloc "ALLOC "

  # Allocate prefix slice for "SLICE_PTR "
  %p_sptr = ALLOC slice<u8> 10
  STORE_STR %p_sptr "SLICE_PTR "

  # Allocate ELF binary buffer (2048 bytes)
  %elf_buf = ALLOC slice<u8> 2048
  %src_raw_ptr = SLICE_PTR %src_buf
  %c_pct_val = CONST i64 37
  %t_flag = CONST bool true

  # Scan lines
  LOOP parse_file_loop
    INVARIANT %pos >= 0 && %pos <= len(src_buf)

    %done = GTE i64 %pos %bytes_read
    BREAK_IF %done

    # Skip whitespace
    %start = CALL skip_whitespace %src_buf %pos

    %at_eof = GTE i64 %start %bytes_read
    BREAK_IF %at_eof

    # Find end of current line (ASCII 10 = '\n')
    %nl_char = CONST i64 10
    %nl = CALL find_char_from %src_buf %start %nl_char

    # Ensure buffer space in line for instruction parsing
    %safe_margin = CONST i64 16
    %needed_len = ADD i64 %start %safe_margin
    %near_eof = GT i64 %needed_len %bytes_read
    BR_IF %near_eof advance_pos

    # Bound check for current code buffer position
    %max_pos = CONST i64 500
    %code_overflow = GT i64 %cur_code_pos %max_pos
    %err_ovf = CONST i64 -2
    RET_IF %code_overflow %err_ovf

    # 1. Check if line starts with "RET "
    %is_ret = CALL str_starts_with %src_buf %start %p_ret
    %false_b = CONST bool false
    %not_ret = EQ bool %is_ret %false_b
    BR_IF %not_ret check_reg_line

    # Check if char after "RET " is '%' (ASCII 37)
    %ret_arg_p = ADD i64 %start 4
    %c_arg = LOAD8 %src_raw_ptr %ret_arg_p
    %is_ret_reg = EQ i64 %c_arg %c_pct_val
    %not_ret_reg = EQ bool %is_ret_reg %false_b
    BR_IF %not_ret_reg parse_imm_ret

    # It is RET %reg -> emit mov rdi, ret_reg; mov rax, 60; syscall
    %ret_reg = CALL parse_reg_id %src_buf %ret_arg_p
    %c1 = CALL emit_mov_rr %elf_buf %cur_code_pos 7 %ret_reg
    %c2 = CALL emit_mov_imm %elf_buf %c1 0 60
    %c3 = CALL emit_syscall_inst %elf_buf %c2
    %cur_code_pos = MOV %c3
    %t_flag = CONST bool true
    %has_dyn_code = MOV %t_flag
    JUMP advance_pos

    LABEL parse_imm_ret
    %ret_len = CONST i64 4
    %val_start = ADD i64 %start %ret_len
    %val = CALL parse_int_from %src_buf %val_start %nl
    %parsed_exit = MOV %val
    JUMP advance_pos

    LABEL check_reg_line
    # 2. Check if line defines a register: starts with '%'
    %c_start = LOAD8 %src_raw_ptr %start
    %is_pct = EQ i64 %c_start %c_pct_val
    %not_pct = EQ bool %is_pct %false_b
    BR_IF %not_pct check_syscall

    %dst_reg = CALL parse_reg_id %src_buf %start
    %eq_char = CONST i64 61
    %eq_pos = CALL find_char_from %src_buf %start %eq_char
    %no_eq = GTE i64 %eq_pos %nl
    BR_IF %no_eq advance_pos
    %after_eq = ADD i64 %eq_pos 1
    %rhs_pos = CALL skip_whitespace %src_buf %after_eq

    # 2a. Check if rhs is "CONST i64 "
    %is_const = CALL str_starts_with %src_buf %rhs_pos %p_const
    %not_const = EQ bool %is_const %false_b
    BR_IF %not_const check_add

    %c_val_p = ADD i64 %rhs_pos 10
    %c_val = CALL parse_int_from %src_buf %c_val_p %nl
    %next_pos_c = CALL emit_mov_imm %elf_buf %cur_code_pos %dst_reg %c_val
    %cur_code_pos = MOV %next_pos_c
    %t_flag_c = CONST bool true
    %has_dyn_code = MOV %t_flag_c
    JUMP advance_pos

    LABEL check_add
    # 2b. Check if rhs is "ADD i64 "
    %is_add = CALL str_starts_with %src_buf %rhs_pos %p_add
    %not_add = EQ bool %is_add %false_b
    BR_IF %not_add check_sub

    %r1_check = ADD i64 %rhs_pos 16
    %r1_near_eof = GT i64 %r1_check %bytes_read
    BR_IF %r1_near_eof advance_pos

    %r1_pos = ADD i64 %rhs_pos 8
    %r1 = CALL parse_reg_id %src_buf %r1_pos
    %sp_c = CONST i64 32
    %sp_pos = CALL find_char_from %src_buf %r1_pos %sp_c
    %r2_pos = CALL skip_whitespace %src_buf %sp_pos
    %r2 = CALL parse_reg_id %src_buf %r2_pos
    %next_pos_a = CALL emit_add_rr %elf_buf %cur_code_pos %r1 %r2
    %cur_code_pos = MOV %next_pos_a
    %t_flag_a = CONST bool true
    %has_dyn_code = MOV %t_flag_a
    JUMP advance_pos

    LABEL check_sub
    # 2c. Check if rhs is "SUB i64 "
    %is_sub = CALL str_starts_with %src_buf %rhs_pos %p_sub
    %not_sub = EQ bool %is_sub %false_b
    BR_IF %not_sub check_mul

    %r1_s_check = ADD i64 %rhs_pos 16
    %r1_s_near = GT i64 %r1_s_check %bytes_read
    BR_IF %r1_s_near advance_pos

    %r1_s_p = ADD i64 %rhs_pos 8
    %r1_s = CALL parse_reg_id %src_buf %r1_s_p
    %sp_pos_s = CALL find_char_from %src_buf %r1_s_p %sp_c
    %r2_s_p = CALL skip_whitespace %src_buf %sp_pos_s
    %r2_s = CALL parse_reg_id %src_buf %r2_s_p
    %next_pos_s = CALL emit_sub_rr %elf_buf %cur_code_pos %r1_s %r2_s
    %cur_code_pos = MOV %next_pos_s
    %t_flag_s = CONST bool true
    %has_dyn_code = MOV %t_flag_s
    JUMP advance_pos

    LABEL check_mul
    # 2d. Check if rhs is "MUL i64 "
    %is_mul = CALL str_starts_with %src_buf %rhs_pos %p_mul
    %not_mul = EQ bool %is_mul %false_b
    BR_IF %not_mul check_mov

    %r1_m_check = ADD i64 %rhs_pos 16
    %r1_m_near = GT i64 %r1_m_check %bytes_read
    BR_IF %r1_m_near advance_pos

    %r1_m_p = ADD i64 %rhs_pos 8
    %r1_m = CALL parse_reg_id %src_buf %r1_m_p
    %sp_pos_m = CALL find_char_from %src_buf %r1_m_p %sp_c
    %r2_m_p = CALL skip_whitespace %src_buf %sp_pos_m
    %r2_m = CALL parse_reg_id %src_buf %r2_m_p
    %next_pos_m = CALL emit_mul_rr %elf_buf %cur_code_pos %r1_m %r2_m
    %cur_code_pos = MOV %next_pos_m
    %t_flag_m = CONST bool true
    %has_dyn_code = MOV %t_flag_m
    JUMP advance_pos

    LABEL check_mov
    # 2e. Check if rhs is "MOV "
    %is_mov = CALL str_starts_with %src_buf %rhs_pos %p_mov
    %not_mov = EQ bool %is_mov %false_b
    BR_IF %not_mov check_load8

    %r_src_p = ADD i64 %rhs_pos 4
    %r_src_check = ADD i64 %r_src_p 4
    %r_src_near = GT i64 %r_src_check %bytes_read
    BR_IF %r_src_near advance_pos

    %r_src = CALL parse_reg_id %src_buf %r_src_p
    %next_pos_mov = CALL emit_mov_rr %elf_buf %cur_code_pos %dst_reg %r_src
    %cur_code_pos = MOV %next_pos_mov
    %t_flag_mov = CONST bool true
    %has_dyn_code = MOV %t_flag_mov
    JUMP advance_pos

    LABEL check_load8
    # 2f. Check if rhs is "LOAD8 "
    %is_l8 = CALL str_starts_with %src_buf %rhs_pos %p_l8
    %not_l8 = EQ bool %is_l8 %false_b
    BR_IF %not_l8 check_load64

    %l8_near_check = ADD i64 %rhs_pos 16
    %l8_near = GT i64 %l8_near_check %bytes_read
    BR_IF %l8_near advance_pos

    %ptr_l8_p = ADD i64 %rhs_pos 6
    %ptr_l8_r = CALL parse_reg_id %src_buf %ptr_l8_p
    %cl0 = CALL emit_mov_rr %elf_buf %cur_code_pos 0 %ptr_l8_r

    %sp_l8 = CALL find_char_from %src_buf %ptr_l8_p %sp_c
    %off_l8_p = CALL skip_whitespace %src_buf %sp_l8

    %c_off_l8 = LOAD8 %src_raw_ptr %off_l8_p
    %is_off_l8_r = EQ i64 %c_off_l8 %c_pct_val
    %not_off_l8_r = EQ bool %is_off_l8_r %false_b
    BR_IF %not_off_l8_r l8_imm_off

    %off_l8_r = CALL parse_reg_id %src_buf %off_l8_p
    %cl1 = CALL emit_mov_rr %elf_buf %cl0 1 %off_l8_r
    JUMP l8_emit_load

    LABEL l8_imm_off
    %off_l8_imm = CALL parse_int_from %src_buf %off_l8_p %nl
    %cl1 = CALL emit_mov_imm %elf_buf %cl0 1 %off_l8_imm

    LABEL l8_emit_load
    %cl3 = CALL emit_load8_idx %elf_buf %cl1
    %cl4 = CALL emit_mov_rr %elf_buf %cl3 %dst_reg 0
    %cur_code_pos = MOV %cl4
    %t_l8 = CONST bool true
    %has_dyn_code = MOV %t_l8
    JUMP advance_pos

    LABEL check_load64
    # 2g. Check if rhs is "LOAD64 "
    %is_l64 = CALL str_starts_with %src_buf %rhs_pos %p_l64
    %not_l64 = EQ bool %is_l64 %false_b
    BR_IF %not_l64 check_alloc

    %l64_near_chk = ADD i64 %rhs_pos 16
    %l64_near = GT i64 %l64_near_chk %bytes_read
    BR_IF %l64_near advance_pos

    %ptr_l64_p = ADD i64 %rhs_pos 7
    %ptr_l64_r = CALL parse_reg_id %src_buf %ptr_l64_p
    %cl64_0 = CALL emit_mov_rr %elf_buf %cur_code_pos 0 %ptr_l64_r

    %sp_l64 = CALL find_char_from %src_buf %ptr_l64_p %sp_c
    %off_l64_p = CALL skip_whitespace %src_buf %sp_l64

    %c_off_l64 = LOAD8 %src_raw_ptr %off_l64_p
    %is_off_l64_r = EQ i64 %c_off_l64 %c_pct_val
    %not_off_l64_r = EQ bool %is_off_l64_r %false_b
    BR_IF %not_off_l64_r l64_imm_off

    %off_l64_r = CALL parse_reg_id %src_buf %off_l64_p
    %cl64_1 = CALL emit_mov_rr %elf_buf %cl64_0 1 %off_l64_r
    JUMP l64_emit_load

    LABEL l64_imm_off
    %off_l64_imm = CALL parse_int_from %src_buf %off_l64_p %nl
    %cl64_1 = CALL emit_mov_imm %elf_buf %cl64_0 1 %off_l64_imm

    LABEL l64_emit_load
    %cl64_3 = CALL emit_load64_idx %elf_buf %cl64_1
    %cl64_4 = CALL emit_mov_rr %elf_buf %cl64_3 %dst_reg 0
    %cur_code_pos = MOV %cl64_4
    %t_l64 = CONST bool true
    %has_dyn_code = MOV %t_l64
    JUMP advance_pos

    LABEL check_alloc
    # 2h. Check if rhs is "ALLOC "
    %is_alloc = CALL str_starts_with %src_buf %rhs_pos %p_alloc
    %not_alloc = EQ bool %is_alloc %false_b
    BR_IF %not_alloc check_sptr

    %data_vaddr = CONST i64 4194816
    %next_pos_al = CALL emit_mov_imm %elf_buf %cur_code_pos %dst_reg %data_vaddr
    %cur_code_pos = MOV %next_pos_al
    %t_al = CONST bool true
    %has_dyn_code = MOV %t_al
    JUMP advance_pos

    LABEL check_sptr
    # 2i. Check if rhs is "SLICE_PTR "
    %is_sptr = CALL str_starts_with %src_buf %rhs_pos %p_sptr
    %not_sptr = EQ bool %is_sptr %false_b
    BR_IF %not_sptr advance_pos

    %buf_arg_p = ADD i64 %rhs_pos 10
    %buf_r_chk = ADD i64 %buf_arg_p 4
    %buf_r_near = GT i64 %buf_r_chk %bytes_read
    BR_IF %buf_r_near advance_pos

    %buf_r = CALL parse_reg_id %src_buf %buf_arg_p
    %next_pos_sp = CALL emit_mov_rr %elf_buf %cur_code_pos %dst_reg %buf_r
    %cur_code_pos = MOV %next_pos_sp
    %t_sp = CONST bool true
    %has_dyn_code = MOV %t_sp
    JUMP advance_pos

    LABEL check_syscall
    # Check if line is "SYSCALL"
    %is_sys = CALL str_starts_with %src_buf %start %p_sys
    %not_sys = EQ bool %is_sys %false_b
    BR_IF %not_sys check_store8

    %next_pos_sys = CALL emit_syscall_inst %elf_buf %cur_code_pos
    %cur_code_pos = MOV %next_pos_sys
    %t_flag_sys = CONST bool true
    %has_dyn_code = MOV %t_flag_sys
    JUMP advance_pos

    LABEL check_store8
    # Check if line is "STORE8 "
    %is_s8 = CALL str_starts_with %src_buf %start %p_s8
    %not_s8 = EQ bool %is_s8 %false_b
    BR_IF %not_s8 check_store64

    %s8_near_chk = ADD i64 %start 16
    %s8_near = GT i64 %s8_near_chk %bytes_read
    BR_IF %s8_near advance_pos

    %ptr_s8_p = ADD i64 %start 7
    %ptr_s8_r = CALL parse_reg_id %src_buf %ptr_s8_p
    %cs0 = CALL emit_mov_rr %elf_buf %cur_code_pos 0 %ptr_s8_r

    %sp_s8_1 = CALL find_char_from %src_buf %ptr_s8_p %sp_c
    %off_s8_p = CALL skip_whitespace %src_buf %sp_s8_1

    %c_off_s8 = LOAD8 %src_raw_ptr %off_s8_p
    %is_off_s8_r = EQ i64 %c_off_s8 %c_pct_val
    %not_off_s8_r = EQ bool %is_off_s8_r %false_b
    BR_IF %not_off_s8_r s8_imm_off

    %off_s8_r = CALL parse_reg_id %src_buf %off_s8_p
    %cs1 = CALL emit_mov_rr %elf_buf %cs0 1 %off_s8_r
    JUMP s8_parse_val

    LABEL s8_imm_off
    %sp_s8_2 = CALL find_char_from %src_buf %off_s8_p %sp_c
    %off_s8_imm = CALL parse_int_from %src_buf %off_s8_p %sp_s8_2
    %cs1 = CALL emit_mov_imm %elf_buf %cs0 1 %off_s8_imm

    LABEL s8_parse_val
    %sp_s8_3 = CALL find_char_from %src_buf %off_s8_p %sp_c
    %val_s8_p = CALL skip_whitespace %src_buf %sp_s8_3

    %c_val_s8 = LOAD8 %src_raw_ptr %val_s8_p
    %is_val_s8_r = EQ i64 %c_val_s8 %c_pct_val
    %not_val_s8_r = EQ bool %is_val_s8_r %false_b
    BR_IF %not_val_s8_r s8_imm_val

    %val_s8_r = CALL parse_reg_id %src_buf %val_s8_p
    %cs2 = CALL emit_mov_rr %elf_buf %cs1 2 %val_s8_r
    JUMP s8_emit_store

    LABEL s8_imm_val
    %val_s8_imm = CALL parse_int_from %src_buf %val_s8_p %nl
    %cs2 = CALL emit_mov_imm %elf_buf %cs1 2 %val_s8_imm

    LABEL s8_emit_store
    %cs4 = CALL emit_store8_idx %elf_buf %cs2
    %cur_code_pos = MOV %cs4
    %t_s8 = CONST bool true
    %has_dyn_code = MOV %t_s8
    JUMP advance_pos

    LABEL check_store64
    # Check if line is "STORE64 "
    %is_s64 = CALL str_starts_with %src_buf %start %p_s64
    %not_s64 = EQ bool %is_s64 %false_b
    BR_IF %not_s64 check_store

    %s64_near_chk = ADD i64 %start 16
    %s64_near = GT i64 %s64_near_chk %bytes_read
    BR_IF %s64_near advance_pos

    %ptr_s64_p = ADD i64 %start 8
    %ptr_s64_r = CALL parse_reg_id %src_buf %ptr_s64_p
    %cs64_0 = CALL emit_mov_rr %elf_buf %cur_code_pos 0 %ptr_s64_r

    %sp_s64_1 = CALL find_char_from %src_buf %ptr_s64_p %sp_c
    %off_s64_p = CALL skip_whitespace %src_buf %sp_s64_1

    %c_off_s64 = LOAD8 %src_raw_ptr %off_s64_p
    %is_off_s64_r = EQ i64 %c_off_s64 %c_pct_val
    %not_off_s64_r = EQ bool %is_off_s64_r %false_b
    BR_IF %not_off_s64_r s64_imm_off

    %off_s64_r = CALL parse_reg_id %src_buf %off_s64_p
    %cs64_1 = CALL emit_mov_rr %elf_buf %cs64_0 1 %off_s64_r
    JUMP s64_parse_val

    LABEL s64_imm_off
    %sp_s64_2 = CALL find_char_from %src_buf %off_s64_p %sp_c
    %off_s64_imm = CALL parse_int_from %src_buf %off_s64_p %sp_s64_2
    %cs64_1 = CALL emit_mov_imm %elf_buf %cs64_0 1 %off_s64_imm

    LABEL s64_parse_val
    %sp_s64_3 = CALL find_char_from %src_buf %off_s64_p %sp_c
    %val_s64_p = CALL skip_whitespace %src_buf %sp_s64_3

    %c_val_s64 = LOAD8 %src_raw_ptr %val_s64_p
    %is_val_s64_r = EQ i64 %c_val_s64 %c_pct_val
    %not_val_s64_r = EQ bool %is_val_s64_r %false_b
    BR_IF %not_val_s64_r s64_imm_val

    %val_s64_r = CALL parse_reg_id %src_buf %val_s64_p
    %cs64_2 = CALL emit_mov_rr %elf_buf %cs64_1 2 %val_s64_r
    JUMP s64_emit_store

    LABEL s64_imm_val
    %val_s64_imm = CALL parse_int_from %src_buf %val_s64_p %nl
    %cs64_2 = CALL emit_mov_imm %elf_buf %cs64_1 2 %val_s64_imm

    LABEL s64_emit_store
    %cs64_4 = CALL emit_store64_idx %elf_buf %cs64_2
    %cur_code_pos = MOV %cs64_4
    %t_s64 = CONST bool true
    %has_dyn_code = MOV %t_s64
    JUMP advance_pos

    LABEL check_store
    # 3. Check if line has STORE_STR
    %is_store = CALL str_starts_with %src_buf %start %p_store
    %not_store = EQ bool %is_store %false_b
    BR_IF %not_store advance_pos

    # Find first quote (ASCII 34 = '"')
    %quote_char = CONST i64 34
    %q1 = CALL find_char_from %src_buf %start %quote_char
    %no_q1 = GTE i64 %q1 %nl
    BR_IF %no_q1 advance_pos

    %q1_plus_1 = ADD i64 %q1 1
    %q2 = CALL find_char_from %src_buf %q1_plus_1 %quote_char
    %no_q2 = GTE i64 %q2 %nl
    BR_IF %no_q2 advance_pos

    # Copy string bytes unescaped into elf_buf starting at offset 512
    %dest_off = CONST i64 512
    %src_raw = SLICE_PTR %src_buf
    %dst_raw = SLICE_PTR %elf_buf
    %copied = CALL copy_str_unescaped %src_raw %q1_plus_1 %q2 %dst_raw %dest_off
    %str_len = MOV %copied
    %true_b = CONST bool true
    %has_string = MOV %true_b

    LABEL advance_pos

    # Advance to next line (after \n)
    %one = CONST i64 1
    %next_pos = ADD i64 %nl %one
    %pos = MOV %next_pos
  END_LOOP parse_file_loop

  # 1. Check if we emitted dynamic instructions
  %false_dyn = CONST bool false
  %not_dyn = EQ bool %has_dyn_code %false_dyn
  BR_IF %not_dyn check_str_or_plain

  # If has_string is true in dynamic mode:
  %no_str_in_dyn = EQ bool %has_string %false_dyn
  BR_IF %no_str_in_dyn write_pure_dyn

  # Bounded string check (0..500)
  %max_dyn_str = CONST i64 500
  %str_too_big_d = GT i64 %str_len %max_dyn_str
  %err_d = CONST i64 -1
  RET_IF %str_too_big_d %err_d
  %str_neg_d = LT i64 %str_len %zero
  RET_IF %str_neg_d %err_d

  # Dynamic code + string: total payload = 392 + str_len
  %c_392 = CONST i64 392
  %dyn_str_payload = ADD i64 %c_392 %str_len
  %hdr_dyn_str = CALL emit_elf_header %elf_buf %dyn_str_payload
  %c_512 = CONST i64 512
  %total_dyn_sz = ADD i64 %c_512 %str_len
  %res_dyn_str = CALL fs_write_file_bytes out_path %elf_buf %total_dyn_sz
  RET %res_dyn_str

  LABEL write_pure_dyn
  # Bounded dynamic code check (120..1000)
  %c_120 = CONST i64 120
  %dyn_code_len = SUB i64 %cur_code_pos %c_120
  %hdr_dyn = CALL emit_elf_header %elf_buf %dyn_code_len
  %res_dyn = CALL fs_write_file_bytes out_path %elf_buf %cur_code_pos
  RET %res_dyn

  LABEL check_str_or_plain
  # Ensure exit code is valid u8 (0..255)
  %c_255 = CONST i64 255
  %exit_too_high = GT i64 %parsed_exit %c_255
  %err_code = CONST i64 -1
  RET_IF %exit_too_high %err_code
  %exit_neg = LT i64 %parsed_exit %zero
  RET_IF %exit_neg %err_code

  # Check if we emit string print or plain exit
  %false_flag = CONST bool false
  %no_str = EQ bool %has_string %false_flag
  BR_IF %no_str emit_plain_exit

  # Bounded string check (0..500)
  %max_str = CONST i64 500
  %str_too_big = GT i64 %str_len %max_str
  RET_IF %str_too_big %err_code
  %str_neg = LT i64 %str_len %zero
  RET_IF %str_neg %err_code

  # Emit ELF header for print + exit
  # Payload = 56 bytes machine code + str_len bytes data
  %code_payload = CONST i64 56
  %total_payload = ADD i64 %code_payload %str_len
  %hdr_len = CALL emit_elf_header %elf_buf %total_payload
  %code_end = CALL emit_print_and_exit %elf_buf %str_len %parsed_exit
  %total_bin_sz = ADD i64 176 %str_len

  # Write exact binary size to disk
  %res1 = CALL fs_write_file_bytes out_path %elf_buf %total_bin_sz
  RET %res1

  LABEL emit_plain_exit
  %code_len = CONST i64 16
  %hdr_len2 = CALL emit_elf_header %elf_buf %code_len
  %bin_sz = CALL emit_exit_code %elf_buf %parsed_exit
  %exact_sz = CONST i64 136
  %res2 = CALL fs_write_file_bytes out_path %elf_buf %exact_sz
  RET %res2
END_FUNC

# Compiler main entry point
FUNC main() -> i64
  %msg = ALLOC slice<u8> 80
  STORE_STR %msg "🚀 Light Self-Hosting Compiler v0.1 starting compilation...\n"
  %msg_len = SLICE_LEN %msg
  %dummy1 = CALL std_print_slice %msg %msg_len

  # 1. Compile test_syscall.lit -> syscall.bin
  %src0 = ALLOC slice<u8> 20
  STORE_STR %src0 "test_syscall.lit\0"
  %out0 = ALLOC slice<u8> 16
  STORE_STR %out0 "syscall.bin\0"
  %res0 = CALL compile_file %src0 %out0

  # 2. Compile test_advanced.lit -> advanced.bin
  %src1 = ALLOC slice<u8> 20
  STORE_STR %src1 "test_advanced.lit\0"
  %out1 = ALLOC slice<u8> 16
  STORE_STR %out1 "advanced.bin\0"
  %res1 = CALL compile_file %src1 %out1

  # 3. Compile test_calc.lit -> calc.bin
  %src2 = ALLOC slice<u8> 16
  STORE_STR %src2 "test_calc.lit\0"
  %out2 = ALLOC slice<u8> 16
  STORE_STR %out2 "calc.bin\0"
  %res2 = CALL compile_file %src2 %out2

  # 4. Compile test_mem.lit -> mem.bin
  %src3 = ALLOC slice<u8> 16
  STORE_STR %src3 "test_mem.lit\0"
  %out3 = ALLOC slice<u8> 16
  STORE_STR %out3 "mem.bin\0"
  %res3 = CALL compile_file %src3 %out3

  # 5. Compile test_mem64.lit -> mem64.bin
  %src4 = ALLOC slice<u8> 16
  STORE_STR %src4 "test_mem64.lit\0"
  %out4 = ALLOC slice<u8> 16
  STORE_STR %out4 "mem64.bin\0"
  %res4 = CALL compile_file %src4 %out4

  %success_msg = ALLOC slice<u8> 80
  STORE_STR %success_msg "🎉 Successfully compiled test suite (syscall, calc, mem, mem64)!\n"
  %s_len = SLICE_LEN %success_msg
  %dummy2 = CALL std_print_slice %success_msg %s_len

  %zero = CONST i64 0
  RET %zero
END_FUNC
