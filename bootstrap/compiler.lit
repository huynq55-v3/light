# Emit: mov [rbp - slot], src (7 bytes: 48 89 modrm b0 b1 b2 b3)
FUNC emit_store_stack(buf: slice<u8>, pos: i64, src: i64, slot: i64) -> i64
  REQUIRE pos >= 0 && pos + 7 <= len(buf) && src >= 0 && src <= 7 && slot >= 0 && slot <= 32768
