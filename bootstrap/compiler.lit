# Emit: call rel32 (5 bytes: 0xE8, rel32)
FUNC emit_call_inst(buf: slice<u8>, pos: i64, target_offset: i64) -> i64
  REQUIRE pos >= 0 && pos + 5 <= len(buf) && target_offset >= 0
  %ptr = SLICE_PTR buf
  %b_e8 = CONST i64 232
  STORE8 %ptr pos %b_e8

  %next_inst = ADD i64 pos 5
  %rel = SUB i64 target_offset %next_inst
  %zero = CONST i64 0
  %is_neg = LT i64 %rel %zero
  %false_b = CONST bool false
  %not_neg = EQ bool %is_neg %false_b
  BR_IF %not_neg call_pos_rel

  %c_2pow32 = CONST i64 4294967296
  %rel_u32_n = ADD i64 %rel %c_2pow32
  %rel_val = MOV %rel_u32_n
  JUMP call_emit_bytes

  LABEL call_pos_rel
  %rel_val = MOV %rel

  LABEL call_emit_bytes
  %b0 = MOD i64 %rel_val 256
  %p1 = ADD i64 pos 1
  STORE8 %ptr %p1 %b0

  %v1 = DIV i64 %rel_val 256
  %b1 = MOD i64 %v1 256
  %p2 = ADD i64 pos 2
  STORE8 %ptr %p2 %b1

  %v2 = DIV i64 %v1 256
  %b2 = MOD i64 %v2 256
  %p3 = ADD i64 pos 3
  STORE8 %ptr %p3 %b2

  %v3 = DIV i64 %v2 256
  %b3 = MOD i64 %v3 256
  %p4 = ADD i64 pos 4
  STORE8 %ptr %p4 %b3

  %next_pos = ADD i64 pos 5
  ENSURE %next_pos == pos + 5
  RET %next_pos
END_FUNC

