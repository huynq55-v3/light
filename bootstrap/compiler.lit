# ==============================================================================
# LIGHT STANDARD LIBRARY: stdlib/io.lit
# Formally verified I/O & Process Control module using Z3 SMT Solver
# ==============================================================================

# Safely print a byte slice with specified length
FUNC std_print_slice(s: slice<u8>, len: i64) -> i64
  REQUIRE len > 0 && len <= len(s)

  %rdx = MOV len
  %rsi = MOV s
  %rax = CONST i64 1
  %rdi = CONST i64 1
  SYSCALL %rax %rdi %rsi %rdx

  %res = CONST i64 0
  ENSURE %res == 0
  RET %res
END_FUNC

# Safely print an entire byte slice
FUNC std_print_all(s: slice<u8>) -> i64
  REQUIRE len(s) > 0

  %len = SLICE_LEN s
  %ptr = SLICE_PTR s
  %rdx = MOV %len
  %rsi = MOV %ptr
  %rax = CONST i64 1
  %rdi = CONST i64 1
  SYSCALL %rax %rdi %rsi %rdx

  %res = CONST i64 0
  RET %res
END_FUNC

# Safely terminate process with an exit status code
FUNC std_exit(code: i64) -> i64
  REQUIRE code >= 0 && code <= 255

  %rax = CONST i64 60
  %rdi = MOV code
  %rsi = CONST i64 0
  %rdx = CONST i64 0
  SYSCALL %rax %rdi %rsi %rdx

  RET code
END_FUNC

# ==============================================================================
# LIGHT STANDARD LIBRARY: stdlib/string.lit
# Formally verified string and character manipulation module using Z3 SMT Solver
# Powers Lexing and Parsing for the Self-Hosting Compiler
# ==============================================================================

# Safely read 1 byte character from slice at index idx
# Formally verified: 100% immune to Out-of-bounds errors due to idx < len(s) contract!
FUNC str_char_at(s: slice<u8>, idx: i64) -> i64
  REQUIRE idx >= 0 && idx < len(s)

  %ptr = SLICE_PTR s
  %byte = LOAD8 %ptr idx

  ENSURE %byte >= 0 && %byte <= 255
  RET %byte
END_FUNC

# Check if a character is whitespace (Space=32, Tab=9, Newline=10, Return=13)
FUNC is_whitespace(c: i64) -> bool
  REQUIRE c >= 0 && c <= 255

  %c_space = CONST i64 32
  %is_sp = EQ i64 c %c_space

  %c_tab = CONST i64 9
  %is_tb = EQ i64 c %c_tab

  %c_nl = CONST i64 10
  %is_nl = EQ i64 c %c_nl

  %c_cr = CONST i64 13
  %is_cr = EQ i64 c %c_cr

  %or1 = OR bool %is_sp %is_tb
  %or2 = OR bool %is_nl %is_cr
  %res = OR bool %or1 %or2

  RET %res
END_FUNC

# Check if a character is an ASCII digit ('0'=48 to '9'=57)
FUNC is_digit(c: i64) -> bool
  REQUIRE c >= 0 && c <= 255

  %c_zero = CONST i64 48
  %c_nine = CONST i64 57
  %gte = GTE i64 c %c_zero
  %lte = LTE i64 c %c_nine
  %res = AND bool %gte %lte

  RET %res
END_FUNC

# Convert an ASCII digit character ('0'..'9') to its integer value (0..9)
FUNC digit_to_int(c: i64) -> i64
  REQUIRE c >= 48 && c <= 57

  %c_zero = CONST i64 48
  %digit = SUB i64 c %c_zero

  ENSURE %digit >= 0 && %digit <= 9
  RET %digit
END_FUNC

# Byte-by-byte equality check between two slices
FUNC str_eq(a: slice<u8>, b: slice<u8>) -> bool
  REQUIRE len(a) >= 0 && len(b) >= 0

  %len_a = SLICE_LEN a
  %len_b = SLICE_LEN b
  %len_match = EQ i64 %len_a %len_b

  %not_match = NEQ i64 %len_a %len_b
  %i = CONST i64 0
  %same = CONST bool true

  LOOP cmp_loop
    INVARIANT %i >= 0 && %i <= len(a)
    INVARIANT %i <= len(b)

    %done = GTE i64 %i %len_a
    BREAK_IF %done

    %ptr_a = SLICE_PTR a
    %ca = LOAD8 %ptr_a %i

    %ptr_b = SLICE_PTR b
    %cb = LOAD8 %ptr_b %i

    %diff = NEQ i64 %ca %cb
    BREAK_IF %diff

    %next_i = ADD i64 %i 1
    %i = MOV %next_i
  END_LOOP cmp_loop

  %is_equal = EQ i64 %i %len_a
  %final_res = AND bool %len_match %is_equal
  RET %final_res
END_FUNC

# Search for target byte in slice. Returns 0-based index or -1 if not found.
FUNC find_char(s: slice<u8>, target: i64) -> i64
  REQUIRE len(s) >= 0 && target >= 0 && target <= 255

  %len = SLICE_LEN s
  %ptr = SLICE_PTR s
  %i = CONST i64 0

  LOOP find_loop
    INVARIANT %i >= 0 && %i <= len(s)

    %done = GTE i64 %i %len
    BREAK_IF %done

    %c = LOAD8 %ptr %i
    %found = EQ i64 %c target
    RET_IF %found %i

    %next_i = ADD i64 %i 1
    %i = MOV %next_i
  END_LOOP find_loop

  %not_found = CONST i64 -1
  RET %not_found
END_FUNC

# Parse ASCII digit slice into positive i64 integer
FUNC parse_i64(s: slice<u8>) -> i64
  REQUIRE len(s) > 0

  %len = SLICE_LEN s
  %ptr = SLICE_PTR s
  %i = CONST i64 0
  %acc = CONST i64 0
  %c_zero = CONST i64 48
  %ten = CONST i64 10

  LOOP parse_loop
    INVARIANT %i >= 0 && %i <= len(s)

    %done = GTE i64 %i %len
    BREAK_IF %done

    %c = LOAD8 %ptr %i
    %digit = SUB i64 %c %c_zero

    %mul = MUL i64 %acc %ten
    %next_acc = ADD i64 %mul %digit
    %acc = MOV %next_acc

    %next_i = ADD i64 %i 1
    %i = MOV %next_i
  END_LOOP parse_loop

  RET %acc
END_FUNC

# Skip whitespace (Space=32, Tab=9) starting at start_idx
FUNC skip_whitespace(s: slice<u8>, start_idx: i64) -> i64
  REQUIRE start_idx >= 0 && start_idx <= len(s)

  %len = SLICE_LEN s
  %ptr = SLICE_PTR s
  %idx = MOV start_idx
  %c_space = CONST i64 32
  %c_tab = CONST i64 9

  LOOP skip_loop
    INVARIANT %idx >= 0 && %idx <= len(s)

    %done = GTE i64 %idx %len
    BREAK_IF %done

    %c = LOAD8 %ptr %idx
    %not_sp = NEQ i64 %c %c_space
    %not_tb = NEQ i64 %c %c_tab
    %not_ws = AND bool %not_sp %not_tb
    RET_IF %not_ws %idx

    %next_idx = ADD i64 %idx 1
    %idx = MOV %next_idx
  END_LOOP skip_loop

  ENSURE %idx >= start_idx && %idx <= len(s)
  RET %idx
END_FUNC

# Check if slice s starting at offset starts with prefix
FUNC str_starts_with(s: slice<u8>, offset: i64, prefix: slice<u8>) -> bool
  REQUIRE offset >= 0 && offset <= len(s) && len(prefix) >= 0

  %len_s = SLICE_LEN s
  %len_p = SLICE_LEN prefix
  %rem = SUB i64 %len_s offset
  %too_short = LT i64 %rem %len_p
  %false_val = CONST bool false
  RET_IF %too_short %false_val

  %ptr_s = SLICE_PTR s
  %ptr_p = SLICE_PTR prefix
  %i = CONST i64 0

  LOOP match_loop
    INVARIANT %i >= 0 && %i <= len(prefix)

    %done = GTE i64 %i %len_p
    BREAK_IF %done

    %s_idx = ADD i64 offset %i
    %c_s = LOAD8 %ptr_s %s_idx
    %c_p = LOAD8 %ptr_p %i

    %diff = NEQ i64 %c_s %c_p
    RET_IF %diff %false_val

    %next_i = ADD i64 %i 1
    %i = MOV %next_i
  END_LOOP match_loop

  %true_val = CONST bool true
  RET %true_val
END_FUNC

# Search for target byte starting from start_idx. Returns index or len(s) if not found.
FUNC find_char_from(s: slice<u8>, start_idx: i64, target: i64) -> i64
  REQUIRE start_idx >= 0 && start_idx <= len(s) && target >= 0 && target <= 255

  %len = SLICE_LEN s
  %ptr = SLICE_PTR s
  %i = MOV start_idx

  LOOP find_from_loop
    INVARIANT %i >= 0 && %i <= len(s)

    %done = GTE i64 %i %len
    BREAK_IF %done

    %c = LOAD8 %ptr %i
    %found = EQ i64 %c target
    RET_IF %found %i

    %next_i = ADD i64 %i 1
    %i = MOV %next_i
  END_LOOP find_from_loop

  ENSURE %i >= start_idx && %i <= len(s)
  RET %i
END_FUNC

# Parse positive integer from slice between start and end
FUNC parse_int_from(s: slice<u8>, start: i64, end: i64) -> i64
  REQUIRE start >= 0 && start <= end && end <= len(s)

  %ptr = SLICE_PTR s
  %i = MOV start
  %acc = CONST i64 0
  %c_zero = CONST i64 48
  %c_nine = CONST i64 57
  %ten = CONST i64 10

  LOOP parse_from_loop
    INVARIANT %i >= 0 && %i <= end

    %done = GTE i64 %i end
    BREAK_IF %done

    %c = LOAD8 %ptr %i
    %is_ge = GTE i64 %c %c_zero
    %is_le = LTE i64 %c %c_nine
    %is_d = AND bool %is_ge %is_le
    %false_b = CONST bool false
    %is_not_digit = EQ bool %is_d %false_b
    BREAK_IF %is_not_digit

    %digit = SUB i64 %c %c_zero
    %mul = MUL i64 %acc %ten
    %next_acc = ADD i64 %mul %digit
    %acc = MOV %next_acc

    %next_i = ADD i64 %i 1
    %i = MOV %next_i
  END_LOOP parse_from_loop

  RET %acc
END_FUNC

# ==============================================================================
# LIGHT STANDARD LIBRARY: stdlib/fs.lit
# Formally verified Linux raw syscall filesystem module using Z3 SMT Solver
# ==============================================================================

# Linux sys_open: open file at null-terminated path
# flags: 0 = O_RDONLY, 1 = O_WRONLY, 2 = O_RDWR, 577 = O_WRONLY|O_CREAT|O_TRUNC
# mode: permission mode (e.g. 420 for 0o644, 493 for 0o755)
# Returns: file descriptor (fd >= 0) on success, or -1 on error
FUNC sys_open(path: slice<u8>, flags: i64, mode: i64) -> i64
  REQUIRE len(path) > 0

  %rdi = SLICE_PTR path
  %rsi = MOV flags
  %rdx = MOV mode
  %rax = CONST i64 2
  %fd = SYSCALL %rax %rdi %rsi %rdx

  ENSURE %fd >= -1
  RET %fd
END_FUNC

# Linux sys_read: read up to count bytes from fd into buffer
# Formally verified: count is guaranteed never to overflow the buffer slice!
FUNC sys_read(fd: i64, buf: slice<u8>, count: i64) -> i64
  REQUIRE fd >= 0 && count >= 0 && count <= len(buf)

  %rdi = MOV fd
  %rsi = SLICE_PTR buf
  %rdx = MOV count
  %rax = CONST i64 0
  %bytes_read = SYSCALL %rax %rdi %rsi %rdx

  ENSURE %bytes_read >= -1 && %bytes_read <= count
  RET %bytes_read
END_FUNC

# Linux sys_write: write count bytes from buffer to fd
# Formally verified: count is guaranteed never to exceed buffer boundary!
FUNC sys_write(fd: i64, buf: slice<u8>, count: i64) -> i64
  REQUIRE fd >= 0 && count >= 0 && count <= len(buf)

  %rdi = MOV fd
  %rsi = SLICE_PTR buf
  %rdx = MOV count
  %rax = CONST i64 1
  %bytes_written = SYSCALL %rax %rdi %rsi %rdx

  ENSURE %bytes_written >= -1 && %bytes_written <= count
  RET %bytes_written
END_FUNC

# Linux sys_close: close file descriptor
FUNC sys_close(fd: i64) -> i64
  REQUIRE fd >= 0

  %rdi = MOV fd
  %rsi = CONST i64 0
  %rdx = CONST i64 0
  %rax = CONST i64 3
  %res = SYSCALL %rax %rdi %rsi %rdx

  ENSURE %res >= -1
  RET %res
END_FUNC

# Linux sys_unlink: delete a name and possibly the file it refers to
FUNC sys_unlink(path: slice<u8>) -> i64
  REQUIRE len(path) > 0

  %rdi = SLICE_PTR path
  %rsi = CONST i64 0
  %rdx = CONST i64 0
  %rax = CONST i64 87
  %res = SYSCALL %rax %rdi %rsi %rdx

  ENSURE %res >= -4096
  RET %res
END_FUNC

# High-level file reading: read file into destination buffer
FUNC fs_read_file(path: slice<u8>, out_buf: slice<u8>, count: i64) -> i64
  REQUIRE len(path) > 0 && count > 0 && count <= len(out_buf)

  %flags = CONST i64 0
  %mode = CONST i64 0
  %fd = CALL sys_open path %flags %mode

  %zero = CONST i64 0
  %is_err = LT i64 %fd %zero
  RET_IF %is_err %fd

  %bytes = CALL sys_read %fd out_buf count
  %dummy = CALL sys_close %fd

  ENSURE %bytes >= -1 && %bytes <= count
  RET %bytes
END_FUNC

# High-level file writing: write entire buffer to file (creates or truncates)
FUNC fs_write_file(path: slice<u8>, content: slice<u8>) -> i64
  REQUIRE len(path) > 0 && len(content) >= 0

  %flags = CONST i64 577
  %mode = CONST i64 493
  %fd = CALL sys_open path %flags %mode

  %zero = CONST i64 0
  %is_err = LT i64 %fd %zero
  RET_IF %is_err %fd

  %len = SLICE_LEN content
  %bytes = CALL sys_write %fd content %len
  %dummy = CALL sys_close %fd

  ENSURE %bytes >= -1 && %bytes <= len(content)
  RET %bytes
END_FUNC

# High-level file writing: write exact count bytes from buffer to file
FUNC fs_write_file_bytes(path: slice<u8>, content: slice<u8>, count: i64) -> i64
  REQUIRE len(path) > 0 && count >= 0 && count <= len(content)

  # Unlink file first to prevent ETXTBSY if overwriting a running executable
  %dummy_ul = CALL sys_unlink path

  %flags = CONST i64 577
  %mode = CONST i64 493
  %fd = CALL sys_open path %flags %mode

  %zero = CONST i64 0
  %is_err = LT i64 %fd %zero
  RET_IF %is_err %fd

  %bytes = CALL sys_write %fd content count
  %dummy = CALL sys_close %fd

  ENSURE %bytes >= -1 && %bytes <= count
  RET %bytes
END_FUNC


# ==============================================================================
# LIGHT SELF-HOSTING BOOTSTRAP COMPILER (Stage 1)
# Written directly in Light (.lit) flat SSA language!
# Fully verified with Z3 SMT Solver
# ==============================================================================


# Emit 64-byte ELF64 Header and 56-byte Program Header into destination buffer
FUNC emit_elf_header(buf: slice<u8>, code_len: i64, entry_offset: i64) -> i64
  REQUIRE len(buf) >= 120 && code_len >= 0 && entry_offset >= 120

  %ptr = SLICE_PTR buf

  # ELF Magic: 0x7F 'E' 'L' 'F'
  %b0 = CONST i64 127
  STORE8 %ptr 0 %b0
  %b1 = CONST i64 69
  STORE8 %ptr 1 %b1
  %b2 = CONST i64 76
  STORE8 %ptr 2 %b2
  %b3 = CONST i64 70
  STORE8 %ptr 3 %b3

  # EI_CLASS = 2 (64-bit), EI_DATA = 1 (Little Endian), EI_VERSION = 1
  %two = CONST i64 2
  STORE8 %ptr 4 %two
  %one = CONST i64 1
  STORE8 %ptr 5 %one
  STORE8 %ptr 6 %one

  # e_type = 2 (ET_EXEC) at offset 16
  STORE8 %ptr 16 %two

  # e_machine = 0x3E (AMD x86-64 = 62) at offset 18
  %mach = CONST i64 62
  STORE8 %ptr 18 %mach

  # e_version = 1 at offset 20
  STORE8 %ptr 20 %one

  # e_entry = 0x400000 + entry_offset at offset 24
  %base_entry = CONST i64 4194304
  %entry = ADD i64 %base_entry entry_offset
  STORE64 %ptr 24 %entry

  # e_phoff = 64 at offset 32
  %phoff = CONST i64 64
  STORE64 %ptr 32 %phoff

  # e_ehsize = 64 at offset 52
  STORE8 %ptr 52 %phoff

  # e_phentsize = 56 at offset 54
  %phentsize = CONST i64 56
  STORE8 %ptr 54 %phentsize

  # e_phnum = 1 at offset 56
  STORE8 %ptr 56 %one

  # Program Header (offset 64):
  # p_type = 1 (PT_LOAD) at offset 64
  STORE8 %ptr 64 %one

  # p_flags = 7 (PF_R | PF_W | PF_X) at offset 68
  %flags = CONST i64 7
  STORE8 %ptr 68 %flags

  # p_vaddr = 0x400000 (4194304) at offset 80
  %vaddr = CONST i64 4194304
  STORE64 %ptr 80 %vaddr

  # p_paddr = 0x400000 at offset 88
  STORE64 %ptr 88 %vaddr

  # Total binary size = 120 + code_len
  %hdr_len = CONST i64 120
  %total_sz = ADD i64 %hdr_len code_len

  # p_filesz at offset 96
  STORE64 %ptr 96 %total_sz

  # p_memsz at offset 104: 16MB virtual memory allocation for code + data segment + heap
  %min_memsz = CONST i64 16777216
  STORE64 %ptr 104 %min_memsz

  # p_align = 4096 at offset 112
  %align = CONST i64 4096
  STORE64 %ptr 112 %align

  RET %hdr_len
END_FUNC

# Emit single byte into buffer at pos
FUNC emit_byte(buf: slice<u8>, pos: i64, b: i64) -> i64
  REQUIRE pos >= 0 && pos < len(buf) && b >= 0 && b <= 255
  %ptr = SLICE_PTR buf
  STORE8 %ptr pos b
  %next_pos = ADD i64 pos 1
  ENSURE %next_pos == pos + 1
  RET %next_pos
END_FUNC

# Emit 64-bit integer into buffer at pos (little-endian)
FUNC emit_u64(buf: slice<u8>, pos: i64, val: i64) -> i64
  REQUIRE pos >= 0 && pos + 8 <= len(buf)
  %ptr = SLICE_PTR buf
  STORE64 %ptr pos val
  %next_pos = ADD i64 pos 8
  ENSURE %next_pos == pos + 8
  RET %next_pos
END_FUNC

# Emit: mov reg, imm64 (10 bytes: 0x48, 0xB8+reg, imm64)
FUNC emit_mov_imm(buf: slice<u8>, pos: i64, reg: i64, imm: i64) -> i64
  REQUIRE pos >= 0 && pos + 10 <= len(buf) && reg >= 0 && reg <= 7
  %ptr = SLICE_PTR buf
  %b_rex = CONST i64 72
  STORE8 %ptr pos %b_rex
  %p1 = ADD i64 pos 1
  %b_base = CONST i64 184
  %opcode = ADD i64 %b_base reg
  STORE8 %ptr %p1 %opcode
  %p2 = ADD i64 pos 2
  STORE64 %ptr %p2 imm
  %next_pos = ADD i64 pos 10
  ENSURE %next_pos == pos + 10
  RET %next_pos
END_FUNC

# Emit: mov dst, src (3 bytes: 0x48, 0x89, 0xC0 | (src<<3) | dst)
FUNC emit_mov_rr(buf: slice<u8>, pos: i64, dst: i64, src: i64) -> i64
  REQUIRE pos >= 0 && pos + 3 <= len(buf) && dst >= 0 && dst <= 7 && src >= 0 && src <= 7
  %ptr = SLICE_PTR buf
  %b_rex = CONST i64 72
  STORE8 %ptr pos %b_rex
  %p1 = ADD i64 pos 1
  %b_89 = CONST i64 137
  STORE8 %ptr %p1 %b_89
  %p2 = ADD i64 pos 2
  %eight = CONST i64 8
  %src_sh = MUL i64 src %eight
  %c0 = CONST i64 192
  %tmp = ADD i64 %c0 %src_sh
  %modrm = ADD i64 %tmp dst
  STORE8 %ptr %p2 %modrm
  %next_pos = ADD i64 pos 3
  ENSURE %next_pos == pos + 3
  RET %next_pos
END_FUNC

# Emit: add dst, src (3 bytes: 0x48, 0x01, 0xC0 | (src<<3) | dst)
FUNC emit_add_rr(buf: slice<u8>, pos: i64, dst: i64, src: i64) -> i64
  REQUIRE pos >= 0 && pos + 3 <= len(buf) && dst >= 0 && dst <= 7 && src >= 0 && src <= 7
  %ptr = SLICE_PTR buf
  %b_rex = CONST i64 72
  STORE8 %ptr pos %b_rex
  %p1 = ADD i64 pos 1
  %b_01 = CONST i64 1
  STORE8 %ptr %p1 %b_01
  %p2 = ADD i64 pos 2
  %eight = CONST i64 8
  %src_sh = MUL i64 src %eight
  %c0 = CONST i64 192
  %tmp = ADD i64 %c0 %src_sh
  %modrm = ADD i64 %tmp dst
  STORE8 %ptr %p2 %modrm
  %next_pos = ADD i64 pos 3
  ENSURE %next_pos == pos + 3
  RET %next_pos
END_FUNC

# Emit: sub dst, src (3 bytes: 0x48, 0x29, 0xC0 | (src<<3) | dst)
FUNC emit_sub_rr(buf: slice<u8>, pos: i64, dst: i64, src: i64) -> i64
  REQUIRE pos >= 0 && pos + 3 <= len(buf) && dst >= 0 && dst <= 7 && src >= 0 && src <= 7
  %ptr = SLICE_PTR buf
  %b_rex = CONST i64 72
  STORE8 %ptr pos %b_rex
  %p1 = ADD i64 pos 1
  %b_29 = CONST i64 41
  STORE8 %ptr %p1 %b_29
  %p2 = ADD i64 pos 2
  %eight = CONST i64 8
  %src_sh = MUL i64 src %eight
  %c0 = CONST i64 192
  %tmp = ADD i64 %c0 %src_sh
  %modrm = ADD i64 %tmp dst
  STORE8 %ptr %p2 %modrm
  %next_pos = ADD i64 pos 3
  ENSURE %next_pos == pos + 3
  RET %next_pos
END_FUNC

# Emit: imul dst, src (4 bytes: 0x48, 0x0F, 0xAF, 0xC0 | (dst<<3) | src)
FUNC emit_mul_rr(buf: slice<u8>, pos: i64, dst: i64, src: i64) -> i64
  REQUIRE pos >= 0 && pos + 4 <= len(buf) && dst >= 0 && dst <= 7 && src >= 0 && src <= 7
  %ptr = SLICE_PTR buf
  %b_rex = CONST i64 72
  STORE8 %ptr pos %b_rex
  %p1 = ADD i64 pos 1
  %b_0f = CONST i64 15
  STORE8 %ptr %p1 %b_0f
  %p2 = ADD i64 pos 2
  %b_af = CONST i64 175
  STORE8 %ptr %p2 %b_af
  %p3 = ADD i64 pos 3
  %eight = CONST i64 8
  %dst_sh = MUL i64 dst %eight
  %c0 = CONST i64 192
  %tmp = ADD i64 %c0 %dst_sh
  %modrm = ADD i64 %tmp src
  STORE8 %ptr %p3 %modrm
  %next_pos = ADD i64 pos 4
  ENSURE %next_pos == pos + 4
  RET %next_pos
END_FUNC

# Emit: signed idiv of rax by rcx. If is_mod is true, mov rax, rdx (remainder), else mov rax, rax (quotient)
# 8 bytes: 48 99 (cqo); 48 f7 f9 (idiv rcx); 48 89 c0 (mov rax, rax) OR 48 89 d0 (mov rax, rdx)
FUNC emit_idiv_rr(buf: slice<u8>, pos: i64, is_mod: bool) -> i64
  REQUIRE pos >= 0 && pos + 8 <= len(buf)
  %ptr = SLICE_PTR buf
  # 48 99 (cqo)
  %b_48 = CONST i64 72
  STORE8 %ptr pos %b_48
  %p1 = ADD i64 pos 1
  %b_99 = CONST i64 153
  STORE8 %ptr %p1 %b_99
  # 48 f7 f9 (idiv rcx)
  %p2 = ADD i64 pos 2
  STORE8 %ptr %p2 %b_48
  %p3 = ADD i64 pos 3
  %b_f7 = CONST i64 247
  STORE8 %ptr %p3 %b_f7
  %p4 = ADD i64 pos 4
  %b_f9 = CONST i64 249
  STORE8 %ptr %p4 %b_f9
  # 48 89 c0 (mov rax, rax) or 48 89 d0 (mov rax, rdx)
  %p5 = ADD i64 pos 5
  STORE8 %ptr %p5 %b_48
  %p6 = ADD i64 pos 6
  %b_89 = CONST i64 137
  STORE8 %ptr %p6 %b_89
  %p7 = ADD i64 pos 7
  %b_c0 = CONST i64 192
  %b_d0 = CONST i64 208
  BR_IF is_mod emit_mod_res
