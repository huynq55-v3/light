# ==============================================================================
# LIGHT SELF-HOSTING BOOTSTRAP COMPILER (Stage 1)
# Written directly in Light (.lit) flat SSA language!
# Fully verified with Z3 SMT Solver
# ==============================================================================

IMPORT "../stdlib/io.lit"
IMPORT "../stdlib/string.lit"
IMPORT "../stdlib/fs.lit"

# Emit 64-byte ELF64 Header and 56-byte Program Header into destination buffer
FUNC emit_elf_header(buf: slice<u8>, code_len: i64) -> i64
  REQUIRE len(buf) >= 120 && code_len >= 0

  %ptr = SLICE_PTR buf

  # ELF Magic: 0x7F 'E' 'L' 'F'
  %b0 = CONST i64 127
  STORE8 %ptr 0 %b0
  %b1 = CONST i64 69
  STORE8 %ptr 1 %b1
  %b2 = CONST i64 76
  STORE8 %ptr 2 %b2
  %b3 = CONST i64 70
  STORE8 %ptr 3 %b3

  # EI_CLASS = 2 (64-bit), EI_DATA = 1 (Little Endian), EI_VERSION = 1
  %two = CONST i64 2
  STORE8 %ptr 4 %two
  %one = CONST i64 1
  STORE8 %ptr 5 %one
  STORE8 %ptr 6 %one

  # e_type = 2 (ET_EXEC) at offset 16
  STORE8 %ptr 16 %two

  # e_machine = 0x3E (AMD x86-64 = 62) at offset 18
  %mach = CONST i64 62
  STORE8 %ptr 18 %mach

  # e_version = 1 at offset 20
  STORE8 %ptr 20 %one

  # e_entry = 0x400078 (4194424) at offset 24
  %entry = CONST i64 4194424
  STORE64 %ptr 24 %entry

  # e_phoff = 64 at offset 32
  %phoff = CONST i64 64
  STORE64 %ptr 32 %phoff

  # e_ehsize = 64 at offset 52
  STORE8 %ptr 52 %phoff

  # e_phentsize = 56 at offset 54
  %phentsize = CONST i64 56
  STORE8 %ptr 54 %phentsize

  # e_phnum = 1 at offset 56
  STORE8 %ptr 56 %one

  # Program Header (offset 64):
  # p_type = 1 (PT_LOAD) at offset 64
  STORE8 %ptr 64 %one

  # p_flags = 7 (PF_R | PF_W | PF_X) at offset 68
  %flags = CONST i64 7
  STORE8 %ptr 68 %flags

  # p_vaddr = 0x400000 (4194304) at offset 80
  %vaddr = CONST i64 4194304
  STORE64 %ptr 80 %vaddr

  # p_paddr = 0x400000 at offset 88
  STORE64 %ptr 88 %vaddr

  # Total binary size = 120 + code_len
  %hdr_len = CONST i64 120
  %total_sz = ADD i64 %hdr_len code_len

  # p_filesz at offset 96
  STORE64 %ptr 96 %total_sz

  # p_memsz at offset 104
  STORE64 %ptr 104 %total_sz

  # p_align = 4096 at offset 112
  %align = CONST i64 4096
  STORE64 %ptr 112 %align

  RET %hdr_len
END_FUNC

# Emit standalone exit machine code at offset 120
FUNC emit_exit_code(buf: slice<u8>, exit_code: i64) -> i64
  REQUIRE len(buf) >= 136 && exit_code >= 0 && exit_code <= 255

  %ptr = SLICE_PTR buf

  # mov rdi, exit_code -> 48 c7 c7 <code: 4 bytes>
  %b_rex = CONST i64 72
  STORE8 %ptr 120 %b_rex
  %b_c7 = CONST i64 199
  STORE8 %ptr 121 %b_c7
  STORE8 %ptr 122 %b_c7
  STORE8 %ptr 123 exit_code

  # mov rax, 60 (sys_exit) -> 48 c7 c0 3c 00 00 00
  STORE8 %ptr 127 %b_rex
  STORE8 %ptr 128 %b_c7
  %b_c0 = CONST i64 192
  STORE8 %ptr 129 %b_c0
  %b_sys_exit = CONST i64 60
  STORE8 %ptr 130 %b_sys_exit

  # syscall -> 0f 05
  %b_0f = CONST i64 15
  STORE8 %ptr 134 %b_0f
  %b_05 = CONST i64 5
  STORE8 %ptr 135 %b_05

  %total_len = CONST i64 136
  RET %total_len
END_FUNC

# Emit standalone print string and exit machine code at offset 120
# String data is expected at offset 176 (virtual address 0x4000b0)
FUNC emit_print_and_exit(buf: slice<u8>, str_len: i64, exit_code: i64) -> i64
  REQUIRE len(buf) >= 176 && str_len >= 0 && exit_code >= 0 && exit_code <= 255

  %ptr = SLICE_PTR buf

  # 1. mov rax, 1 (sys_write) -> 48 c7 c0 01 00 00 00
  %b_rex = CONST i64 72
  %b_c7 = CONST i64 199
  %b_c0 = CONST i64 192
  %b_one = CONST i64 1
  STORE8 %ptr 120 %b_rex
  STORE8 %ptr 121 %b_c7
  STORE8 %ptr 122 %b_c0
  STORE8 %ptr 123 %b_one

  # 2. mov rdi, 1 (stdout) -> 48 c7 c7 01 00 00 00
  STORE8 %ptr 127 %b_rex
  STORE8 %ptr 128 %b_c7
  STORE8 %ptr 129 %b_c7
  STORE8 %ptr 130 %b_one

  # 3. mov rsi, 0x4000b0 -> 48 be b0 00 40 00 00 00 00 00
  %b_be = CONST i64 190
  %b_b0 = CONST i64 176
  %b_40 = CONST i64 64
  STORE8 %ptr 134 %b_rex
  STORE8 %ptr 135 %b_be
  STORE8 %ptr 136 %b_b0
  STORE8 %ptr 138 %b_40

  # 4. mov rdx, str_len -> 48 c7 c2 <str_len> 00 00 00
  %b_c2 = CONST i64 194
  STORE8 %ptr 144 %b_rex
  STORE8 %ptr 145 %b_c7
  STORE8 %ptr 146 %b_c2
  STORE8 %ptr 147 str_len

  # 5. syscall -> 0f 05
  %b_0f = CONST i64 15
  %b_05 = CONST i64 5
  STORE8 %ptr 151 %b_0f
  STORE8 %ptr 152 %b_05

  # 6. mov rdi, exit_code -> 48 c7 c7 <exit_code> 00 00 00
  STORE8 %ptr 153 %b_rex
  STORE8 %ptr 154 %b_c7
  STORE8 %ptr 155 %b_c7
  STORE8 %ptr 156 exit_code

  # 7. mov rax, 60 (sys_exit) -> 48 c7 c0 3c 00 00 00
  %b_sys_exit = CONST i64 60
  STORE8 %ptr 160 %b_rex
  STORE8 %ptr 161 %b_c7
  STORE8 %ptr 162 %b_c0
  STORE8 %ptr 163 %b_sys_exit

  # 8. syscall -> 0f 05
  STORE8 %ptr 167 %b_0f
  STORE8 %ptr 168 %b_05

  # NOP padding 169..175: 0x90 (144)
  %b_nop = CONST i64 144
  STORE8 %ptr 169 %b_nop
  STORE8 %ptr 170 %b_nop
  STORE8 %ptr 171 %b_nop
  STORE8 %ptr 172 %b_nop
  STORE8 %ptr 173 %b_nop
  STORE8 %ptr 174 %b_nop
  STORE8 %ptr 175 %b_nop

  %code_end = CONST i64 176
  RET %code_end
END_FUNC

# Copy string between start and end from src into dst at dst_start, unescaping \n
FUNC copy_str_unescaped(src_ptr: i64, start: i64, end: i64, dst_ptr: i64, dst_start: i64) -> i64
  REQUIRE start >= 0 && start <= end && dst_start >= 0

  %len_s = SUB i64 end start

  %i = CONST i64 0
  %out_idx = MOV dst_start
  %backslash = CONST i64 92
  %c_n = CONST i64 110
  %nl_byte = CONST i64 10

  LOOP unescape_loop
    INVARIANT %i >= 0 && %i <= len_s

    %done = GTE i64 %i %len_s
    BREAK_IF %done

    %cur_src = ADD i64 start %i
    %c = LOAD8 src_ptr %cur_src

    %is_bs = EQ i64 %c %backslash
    %false_b = CONST bool false
    %not_bs = EQ bool %is_bs %false_b
    BR_IF %not_bs copy_normal

    # Check next char
    %next_i = ADD i64 %i 1
    %has_next = LT i64 %next_i %len_s
    %not_has_next = EQ bool %has_next %false_b
    BR_IF %not_has_next copy_normal

    %next_src = ADD i64 start %next_i
    %c_next = LOAD8 src_ptr %next_src
    %is_n = EQ i64 %c_next %c_n
    %not_n = EQ bool %is_n %false_b
    BR_IF %not_n copy_normal

    # It is \n: store newline byte 10
    STORE8 dst_ptr %out_idx %nl_byte
    %next_out = ADD i64 %out_idx 1
    %out_idx = MOV %next_out
    %step2 = ADD i64 %i 2
    %i = MOV %step2
    JUMP step_done

    LABEL copy_normal
    STORE8 dst_ptr %out_idx %c
    %next_out2 = ADD i64 %out_idx 1
    %out_idx = MOV %next_out2
    %step1 = ADD i64 %i 1
    %i = MOV %step1

    LABEL step_done
  END_LOOP unescape_loop

  %total_written = SUB i64 %out_idx dst_start
  RET %total_written
END_FUNC


# Compile input .lit file and emit standalone ELF binary
FUNC compile_file(src_path: slice<u8>, out_path: slice<u8>) -> i64
  REQUIRE len(src_path) > 0 && len(out_path) > 0

  # Read source file
  %src_buf = ALLOC slice<u8> 1024
  %bytes_read = CALL fs_read_file src_path %src_buf

  %zero = CONST i64 0
  %read_err = LTE i64 %bytes_read %zero
  RET_IF %read_err %bytes_read

  %pos = CONST i64 0
  %parsed_exit = CONST i64 0
  %has_string = CONST bool false
  %str_len = CONST i64 0

  # Allocate prefix slice for "RET "
  %p_ret = ALLOC slice<u8> 4
  STORE_STR %p_ret "RET "

  # Allocate prefix slice for "STORE_STR"
  %p_store = ALLOC slice<u8> 9
  STORE_STR %p_store "STORE_STR"

  # Allocate ELF binary buffer (1024 bytes)
  %elf_buf = ALLOC slice<u8> 1024

  # Scan lines
  LOOP parse_file_loop
    INVARIANT %pos >= 0 && %pos <= len(src_buf)

    %done = GTE i64 %pos %bytes_read
    BREAK_IF %done

    # Skip whitespace
    %start = CALL skip_whitespace %src_buf %pos

    %at_eof = GTE i64 %start %bytes_read
    BREAK_IF %at_eof

    # Find end of current line (ASCII 10 = '\n')
    %nl_char = CONST i64 10
    %nl = CALL find_char_from %src_buf %start %nl_char

    # Check if line starts with "RET "
    %is_ret = CALL str_starts_with %src_buf %start %p_ret
    %false_b = CONST bool false
    %not_ret = EQ bool %is_ret %false_b
    BR_IF %not_ret check_store

    # Parse integer after "RET "
    %ret_len = CONST i64 4
    %val_start = ADD i64 %start %ret_len
    %val = CALL parse_int_from %src_buf %val_start %nl
    %parsed_exit = MOV %val
    JUMP line_done

    LABEL check_store
    # Check if line has STORE_STR
    %is_store = CALL str_starts_with %src_buf %start %p_store
    %not_store = EQ bool %is_store %false_b
    BR_IF %not_store line_done

    # Find first quote (ASCII 34 = '"')
    %quote_char = CONST i64 34
    %q1 = CALL find_char_from %src_buf %start %quote_char
    %no_q1 = GTE i64 %q1 %nl
    BR_IF %no_q1 line_done

    %q1_plus_1 = ADD i64 %q1 1
    %q2 = CALL find_char_from %src_buf %q1_plus_1 %quote_char
    %no_q2 = GTE i64 %q2 %nl
    BR_IF %no_q2 line_done

    # Copy string bytes unescaped into elf_buf starting at offset 176
    %dest_off = CONST i64 176
    %src_raw = SLICE_PTR %src_buf
    %dst_raw = SLICE_PTR %elf_buf
    %copied = CALL copy_str_unescaped %src_raw %q1_plus_1 %q2 %dst_raw %dest_off
    %str_len = MOV %copied
    %true_b = CONST bool true
    %has_string = MOV %true_b

    LABEL line_done

    # Advance to next line (after \n)
    %one = CONST i64 1
    %next_pos = ADD i64 %nl %one
    %pos = MOV %next_pos
  END_LOOP parse_file_loop

  # Ensure exit code is valid u8 (0..255)
  %c_255 = CONST i64 255
  %exit_too_high = GT i64 %parsed_exit %c_255
  %err_code = CONST i64 -1
  RET_IF %exit_too_high %err_code
  %exit_neg = LT i64 %parsed_exit %zero
  RET_IF %exit_neg %err_code

  # Check if we emit string print or plain exit
  %false_flag = CONST bool false
  %no_str = EQ bool %has_string %false_flag
  BR_IF %no_str emit_plain_exit

  # Bounded string check (0..500)
  %max_str = CONST i64 500
  %str_too_big = GT i64 %str_len %max_str
  RET_IF %str_too_big %err_code
  %str_neg = LT i64 %str_len %zero
  RET_IF %str_neg %err_code

  # Emit ELF header for print + exit
  # Payload = 56 bytes machine code + str_len bytes data
  %code_payload = CONST i64 56
  %total_payload = ADD i64 %code_payload %str_len
  %hdr_len = CALL emit_elf_header %elf_buf %total_payload
  %code_end = CALL emit_print_and_exit %elf_buf %str_len %parsed_exit
  %total_bin_sz = ADD i64 176 %str_len

  # Write exact binary size to disk
  %res1 = CALL fs_write_file_bytes out_path %elf_buf %total_bin_sz
  RET %res1

  LABEL emit_plain_exit
  %code_len = CONST i64 16
  %hdr_len2 = CALL emit_elf_header %elf_buf %code_len
  %bin_sz = CALL emit_exit_code %elf_buf %parsed_exit
  %exact_sz = CONST i64 136
  %res2 = CALL fs_write_file_bytes out_path %elf_buf %exact_sz
  RET %res2
END_FUNC

# Compiler main entry point
FUNC main() -> i64
  %msg = ALLOC slice<u8> 80
  STORE_STR %msg "🚀 Light Self-Hosting Compiler v0.1 starting compilation...\n"
  %msg_len = SLICE_LEN %msg
  %dummy1 = CALL std_print_slice %msg %msg_len

  %src_path = ALLOC slice<u8> 16
  STORE_STR %src_path "test_hello.lit\0"

  %out_path = ALLOC slice<u8> 16
  STORE_STR %out_path "hello.bin\0"

  # Compile test_hello.lit -> hello.bin!
  %compile_res = CALL compile_file %src_path %out_path

  %success_msg = ALLOC slice<u8> 64
  STORE_STR %success_msg "🎉 Successfully compiled test_hello.lit -> hello.bin!\n"
  %s_len = SLICE_LEN %success_msg
  %dummy2 = CALL std_print_slice %success_msg %s_len

  %zero = CONST i64 0
  RET %zero
END_FUNC
