  %false_b = CONST bool false
  %not_neg = EQ bool %is_neg %false_b
  BR_IF %not_neg jmp_pos_rel

  %c_2pow32 = CONST i64 4294967296
  %rel_u32_n = ADD i64 %rel %c_2pow32
  %rel_val = MOV %rel_u32_n
  JUMP jmp_emit_bytes

  LABEL jmp_pos_rel
  %rel_val = MOV %rel

  LABEL jmp_emit_bytes
  %b0 = MOD i64 %rel_val 256
  %p1 = ADD i64 pos 1
  STORE8 %ptr %p1 %b0

  %v1 = DIV i64 %rel_val 256
  %b1 = MOD i64 %v1 256
  %p2 = ADD i64 pos 2
  STORE8 %ptr %p2 %b1

  %v2 = DIV i64 %v1 256
  %b2 = MOD i64 %v2 256
  %p3 = ADD i64 pos 3
  STORE8 %ptr %p3 %b2

  %v3 = DIV i64 %v2 256
  %b3 = MOD i64 %v3 256
  %p4 = ADD i64 pos 4
  STORE8 %ptr %p4 %b3

  %next_pos = ADD i64 pos 5
  ENSURE %next_pos == pos + 5
  RET %next_pos
END_FUNC

# Emit: jnz rel32 (6 bytes: 0x0F, 0x85, rel32)
FUNC emit_jnz_rel32(buf: slice<u8>, pos: i64, target_offset: i64) -> i64
  REQUIRE pos >= 0 && pos + 6 <= len(buf) && target_offset >= 0
  %ptr = SLICE_PTR buf
  %b_0f = CONST i64 15
  STORE8 %ptr pos %b_0f
  %p1 = ADD i64 pos 1
  %b_85 = CONST i64 133
  STORE8 %ptr %p1 %b_85

  %next_inst = ADD i64 pos 6
  %rel = SUB i64 target_offset %next_inst
  %zero = CONST i64 0
  %is_neg = LT i64 %rel %zero
  %false_b = CONST bool false
  %not_neg = EQ bool %is_neg %false_b
  BR_IF %not_neg jnz_pos_rel

  %c_2pow32 = CONST i64 4294967296
  %rel_u32_n = ADD i64 %rel %c_2pow32
  %rel_val = MOV %rel_u32_n
  JUMP jnz_emit_bytes

  LABEL jnz_pos_rel
  %rel_val = MOV %rel

  LABEL jnz_emit_bytes
  %b0 = MOD i64 %rel_val 256
  %p2 = ADD i64 pos 2
  STORE8 %ptr %p2 %b0

  %v1 = DIV i64 %rel_val 256
  %b1 = MOD i64 %v1 256
  %p3 = ADD i64 pos 3
  STORE8 %ptr %p3 %b1

  %v2 = DIV i64 %v1 256
  %b2 = MOD i64 %v2 256
  %p4 = ADD i64 pos 4
  STORE8 %ptr %p4 %b2

  %v3 = DIV i64 %v2 256
  %b3 = MOD i64 %v3 256
  %p5 = ADD i64 pos 5
  STORE8 %ptr %p5 %b3

  %next_pos = ADD i64 pos 6
  ENSURE %next_pos == pos + 6
  RET %next_pos
END_FUNC

# Parse register name (%rax, %rcx, %rdx, %rbx, %rsi, %rdi, or %r0..%r7) into 0..7 ID
FUNC parse_reg_id(buf: slice<u8>, pos: i64) -> i64
  REQUIRE pos >= 0 && pos + 4 <= len(buf)

  %ptr = SLICE_PTR buf
  %p2 = ADD i64 pos 2
  %c2 = LOAD8 %ptr %p2
  %p3 = ADD i64 pos 3
  %c3 = LOAD8 %ptr %p3

  # Check if %r0 .. %r3 (ASCII 48 .. 51) -> rax (0), rcx (1), rdx (2), rbx (3)
  %c_0 = CONST i64 48
  %c_3 = CONST i64 51
  %is_digit_low = GTE i64 %c2 %c_0
  %is_digit_3 = LTE i64 %c2 %c_3
  %is_r0_r3 = AND bool %is_digit_low %is_digit_3
  %digit_id = SUB i64 %c2 %c_0
  RET_IF %is_r0_r3 %digit_id

  # %r4 -> rsi (6)
  %c_4 = CONST i64 52
  %is_r4 = EQ i64 %c2 %c_4
  %six_reg = CONST i64 6
  RET_IF %is_r4 %six_reg

  # %r5 .. %r7 -> rdi (7)
  %c_7 = CONST i64 55
  %is_r5_low = GTE i64 %c2 %c_4
  %is_r5_high = LTE i64 %c2 %c_7
  %is_r5_r7 = AND bool %is_r5_low %is_r5_high
  %seven_reg = CONST i64 7
  RET_IF %is_r5_r7 %seven_reg

  # Check 'a' (97) -> rax = 0
  %c_a = CONST i64 97
  %is_a = EQ i64 %c2 %c_a
  %zero = CONST i64 0
  RET_IF %is_a %zero

  # Check 'c' (99) -> rcx = 1
  %c_c = CONST i64 99
  %is_c = EQ i64 %c2 %c_c
  %one = CONST i64 1
  RET_IF %is_c %one

  # Check 'b' (98): if c3 == 'p' (112) -> rbp = 5, else rbx = 3
  %c_b = CONST i64 98
  %is_b = EQ i64 %c2 %c_b
  %c_p = CONST i64 112
  %is_bp = EQ i64 %c3 %c_p
  %is_rbp = AND bool %is_b %is_bp
  %five = CONST i64 5
  RET_IF %is_rbp %five
  %three = CONST i64 3
  RET_IF %is_b %three

  # Check 's' (115): if c3 == 'p' (112) -> rsp = 4, else rsi = 6
  %c_s = CONST i64 115
  %is_s = EQ i64 %c2 %c_s
  %is_sp = EQ i64 %c3 %c_p
  %is_rsp = AND bool %is_s %is_sp
  %four = CONST i64 4
  RET_IF %is_rsp %four
  %six = CONST i64 6
  RET_IF %is_s %six

  # Check 'd' (100): if c3 == 'i' (105) -> rdi = 7, else rdx = 2
  %c_i = CONST i64 105
  %is_i = EQ i64 %c3 %c_i
  %seven = CONST i64 7
  RET_IF %is_i %seven

  %two = CONST i64 2
  ENSURE %two >= 0 && %two <= 7
  RET %two
END_FUNC

# Check if operand at pos is a named variable (not a standard physical register)
FUNC is_named_var(buf: slice<u8>, pos: i64) -> bool
  REQUIRE pos >= 0 && pos + 4 <= len(buf)
  %ptr = SLICE_PTR buf
  %p0 = LOAD8 %ptr pos
  %c_pct = CONST i64 37
  %is_pct = EQ i64 %p0 %c_pct
  %false_b = CONST bool false
  %not_pct = EQ bool %is_pct %false_b
  BR_IF %not_pct check_alpha_start

  %p1 = ADD i64 pos 1
  %c1 = LOAD8 %ptr %p1
  %c_r = CONST i64 114
  %not_r = NEQ i64 %c1 %c_r
  %true_b = CONST bool true
  RET_IF %not_r %true_b

  # c1 is 'r'.
  %p2 = ADD i64 pos 2
  %c2 = LOAD8 %ptr %p2
  %p3 = ADD i64 pos 3
  %c3 = LOAD8 %ptr %p3

  # Common delimiters
  %c_sp = CONST i64 32
  %c_eq = CONST i64 61

  # Check if c2 is digit '0'..'7'
  %c_0 = CONST i64 48
  %c_7 = CONST i64 55
  %is_d_low = GTE i64 %c2 %c_0
  %is_d_high = LTE i64 %c2 %c_7
  %is_digit = AND bool %is_d_low %is_d_high
  %not_digit = EQ bool %is_digit %false_b
  BR_IF %not_digit check_named_abcds

  # It is %r0..%r7 -> check if length is 3 (delimiter at pos+3)
  %is_sp = LTE i64 %c3 %c_sp
  %is_eq = EQ i64 %c3 %c_eq
  %is_end3 = OR bool %is_sp %is_eq
  %is_phys_r = AND bool %is_digit %is_end3
  RET_IF %is_phys_r %false_b
  RET %true_b

  LABEL check_named_abcds
  # Physical register like %rax, %rcx, %rdx, %rbx, %rsp, %rbp, %rsi, %rdi
  # Check if pos+4 is within buffer
  %p4 = ADD i64 pos 4
  %len_b = SLICE_LEN buf
  %has_p4 = LT i64 %p4 %len_b
  %not_has_p4 = EQ bool %has_p4 %false_b
  RET_IF %not_has_p4 %true_b

  # Check if delimiter at pos+4
  %c4 = LOAD8 %ptr %p4
  %is_sp4 = LTE i64 %c4 %c_sp
  %is_eq4 = EQ i64 %c4 %c_eq
  %is_end4 = OR bool %is_sp4 %is_eq4
  RET_IF %is_end4 %false_b

  RET %true_b

  LABEL check_alpha_start
  # Check if p0 is in 'a'..'z' (97..122)
  %c_a = CONST i64 97
  %c_z = CONST i64 122
  %is_low_a = GTE i64 %p0 %c_a
  %is_high_z = LTE i64 %p0 %c_z
  %is_lower = AND bool %is_low_a %is_high_z
  %t_alpha = CONST bool true
  RET_IF %is_lower %t_alpha

  # Check if p0 is in 'A'..'Z' (65..90)
  %c_A = CONST i64 65
  %c_Z = CONST i64 90
  %is_low_A = GTE i64 %p0 %c_A
  %is_high_Z = LTE i64 %p0 %c_Z
  %is_upper = AND bool %is_low_A %is_high_Z
  RET_IF %is_upper %t_alpha

  # Check if p0 is '_' (95)
  %c_under = CONST i64 95
  %is_under = EQ i64 %p0 %c_under
  RET_IF %is_under %t_alpha

  RET %false_b
END_FUNC

# Emit machine code: mov byte [rdi + offset], val
# Encoded as: c6 47 <offset> <val> (4 bytes)
FUNC emit_store_byte_imm(buf: slice<u8>, pos: i64, offset: i64, val: i64) -> i64
  REQUIRE pos >= 0 && pos + 4 <= len(buf) && offset >= 0 && offset <= 128 && val >= 0 && val <= 255

  %ptr = SLICE_PTR buf
  %b_c6 = CONST i64 198
  STORE8 %ptr pos %b_c6
  %p1 = ADD i64 pos 1
  %b_47 = CONST i64 71
  STORE8 %ptr %p1 %b_47
  %p2 = ADD i64 pos 2
  STORE8 %ptr %p2 offset
  %p3 = ADD i64 pos 3
  STORE8 %ptr %p3 val
  %next = ADD i64 pos 4

  ENSURE %next == pos + 4
  RET %next
END_FUNC

# Emit string literal bytes into elf_buf as immediate store instructions
FUNC emit_str_bytes(buf: slice<u8>, code_pos: i64, str_buf: slice<u8>, count: i64) -> i64
  REQUIRE code_pos >= 0 && code_pos <= 500000 && len(buf) >= 600000 && count >= 0 && count <= len(str_buf) && count <= 128

  %s_ptr = SLICE_PTR str_buf
  %i = CONST i64 0
  %c_4 = CONST i64 4

  LOOP str_byte_loop
    INVARIANT %i >= 0 && %i <= count

    %done = GTE i64 %i count
    BREAK_IF %done

    %off_code = MUL i64 %i %c_4
    %cur = ADD i64 code_pos %off_code
    %b = LOAD8 %s_ptr %i
    %dummy = CALL emit_store_byte_imm buf %cur %i %b

    %next_i = ADD i64 %i 1
    %i = MOV %next_i
  END_LOOP str_byte_loop

  %total_code = MUL i64 count %c_4
  %cur_end = ADD i64 code_pos %total_code
  %zero_b = CONST i64 0
  %final_cur = CALL emit_store_byte_imm buf %cur_end count %zero_b

  RET %final_cur
END_FUNC

# Emit standalone exit machine code at offset 120
FUNC emit_exit_code(buf: slice<u8>, exit_code: i64) -> i64
  REQUIRE len(buf) >= 136 && exit_code >= 0 && exit_code <= 255

  %ptr = SLICE_PTR buf

  # mov rdi, exit_code -> 48 c7 c7 <code: 4 bytes>
  %b_rex = CONST i64 72
  STORE8 %ptr 120 %b_rex
  %b_c7 = CONST i64 199
  STORE8 %ptr 121 %b_c7
  STORE8 %ptr 122 %b_c7
  STORE8 %ptr 123 exit_code

  # mov rax, 60 (sys_exit) -> 48 c7 c0 3c 00 00 00
  STORE8 %ptr 127 %b_rex
  STORE8 %ptr 128 %b_c7
  %b_c0 = CONST i64 192
  STORE8 %ptr 129 %b_c0
  %b_sys_exit = CONST i64 60
  STORE8 %ptr 130 %b_sys_exit

  # syscall -> 0f 05
  %b_0f = CONST i64 15
  STORE8 %ptr 134 %b_0f
  %b_05 = CONST i64 5
  STORE8 %ptr 135 %b_05

  %total_len = CONST i64 136
  RET %total_len
END_FUNC

# Emit standalone print string and exit machine code at offset 120
# String data is expected at offset 176 (virtual address 0x4000b0)
FUNC emit_print_and_exit(buf: slice<u8>, str_len: i64, exit_code: i64) -> i64
  REQUIRE len(buf) >= 176 && str_len >= 0 && exit_code >= 0 && exit_code <= 255

  %ptr = SLICE_PTR buf

  # 1. mov rax, 1 (sys_write) -> 48 c7 c0 01 00 00 00
  %b_rex = CONST i64 72
  %b_c7 = CONST i64 199
  %b_c0 = CONST i64 192
  %b_one = CONST i64 1
  STORE8 %ptr 120 %b_rex
  STORE8 %ptr 121 %b_c7
  STORE8 %ptr 122 %b_c0
  STORE8 %ptr 123 %b_one

  # 2. mov rdi, 1 (stdout) -> 48 c7 c7 01 00 00 00
  STORE8 %ptr 127 %b_rex
  STORE8 %ptr 128 %b_c7
  STORE8 %ptr 129 %b_c7
  STORE8 %ptr 130 %b_one

  # 3. mov rsi, 0x4000b0 -> 48 be b0 00 40 00 00 00 00 00
  %b_be = CONST i64 190
  %b_b0 = CONST i64 176
  %b_40 = CONST i64 64
  STORE8 %ptr 134 %b_rex
  STORE8 %ptr 135 %b_be
  STORE8 %ptr 136 %b_b0
  STORE8 %ptr 138 %b_40

  # 4. mov rdx, str_len -> 48 c7 c2 <str_len> 00 00 00
  %b_c2 = CONST i64 194
  STORE8 %ptr 144 %b_rex
  STORE8 %ptr 145 %b_c7
  STORE8 %ptr 146 %b_c2
  STORE8 %ptr 147 str_len

  # 5. syscall -> 0f 05
  %b_0f = CONST i64 15
  %b_05 = CONST i64 5
  STORE8 %ptr 151 %b_0f
  STORE8 %ptr 152 %b_05

  # 6. mov rdi, exit_code -> 48 c7 c7 <exit_code> 00 00 00
  STORE8 %ptr 153 %b_rex
  STORE8 %ptr 154 %b_c7
  STORE8 %ptr 155 %b_c7
  STORE8 %ptr 156 exit_code

  # 7. mov rax, 60 (sys_exit) -> 48 c7 c0 3c 00 00 00
  %b_sys_exit = CONST i64 60
  STORE8 %ptr 160 %b_rex
  STORE8 %ptr 161 %b_c7
  STORE8 %ptr 162 %b_c0
  STORE8 %ptr 163 %b_sys_exit

  # 8. syscall -> 0f 05
  STORE8 %ptr 167 %b_0f
  STORE8 %ptr 168 %b_05

  # NOP padding 169..175: 0x90 (144)
  %b_nop = CONST i64 144
  STORE8 %ptr 169 %b_nop
  STORE8 %ptr 170 %b_nop
  STORE8 %ptr 171 %b_nop
  STORE8 %ptr 172 %b_nop
  STORE8 %ptr 173 %b_nop
  STORE8 %ptr 174 %b_nop
  STORE8 %ptr 175 %b_nop

  %code_end = CONST i64 176
  RET %code_end
END_FUNC

# Copy string between start and end from src into dst, unescaping \n
FUNC copy_str_unescaped(src_ptr: i64, start: i64, end: i64, dst_ptr: i64) -> i64
  REQUIRE start >= 0 && start <= end

  %len_s = SUB i64 end start

  %i = CONST i64 0
  %out_idx = CONST i64 0
  %backslash = CONST i64 92
  %c_n = CONST i64 110
  %nl_byte = CONST i64 10

  LOOP unescape_loop
    INVARIANT %i >= 0 && %i <= len_s

    %done = GTE i64 %i %len_s
    BREAK_IF %done

    %cur_src = ADD i64 start %i
    %c = LOAD8 src_ptr %cur_src

    %is_bs = EQ i64 %c %backslash
    %false_b = CONST bool false
    %not_bs = EQ bool %is_bs %false_b
    BR_IF %not_bs copy_normal

    # Check next char
    %next_i = ADD i64 %i 1
    %has_next = LT i64 %next_i %len_s
    %not_has_next = EQ bool %has_next %false_b
    BR_IF %not_has_next copy_normal

    %next_src = ADD i64 start %next_i
    %c_next = LOAD8 src_ptr %next_src
    %is_n = EQ i64 %c_next %c_n
    %not_n = EQ bool %is_n %false_b
    BR_IF %not_n check_zero_escape

    # It is \n: store newline byte 10
    STORE8 dst_ptr %out_idx %nl_byte
    %next_out = ADD i64 %out_idx 1
    %out_idx = MOV %next_out
    %step2 = ADD i64 %i 2
    %i = MOV %step2
    JUMP step_done

    LABEL check_zero_escape
    %c_0_esc = CONST i64 48
    %is_0_esc = EQ i64 %c_next %c_0_esc
    %not_0_esc = EQ bool %is_0_esc %false_b
    BR_IF %not_0_esc copy_normal

    # It is \0: store zero byte 0
    %zero_byte = CONST i64 0
    STORE8 dst_ptr %out_idx %zero_byte
    %next_out_0 = ADD i64 %out_idx 1
    %out_idx = MOV %next_out_0
    %step2_0 = ADD i64 %i 2
    %i = MOV %step2_0
    JUMP step_done

    LABEL copy_normal
    STORE8 dst_ptr %out_idx %c
    %next_out2 = ADD i64 %out_idx 1
    %out_idx = MOV %next_out2
    %step1 = ADD i64 %i 1
    %i = MOV %step1

    LABEL step_done
  END_LOOP unescape_loop

  RET %out_idx
END_FUNC

# Copy label name into a clean 16-byte zero-padded buffer
FUNC copy_label_name(src_buf: slice<u8>, start: i64, nl: i64, out_buf: slice<u8>) -> i64
  REQUIRE start >= 0 && start <= len(src_buf) && nl >= start && nl <= len(src_buf) && len(out_buf) >= 16

  %src_ptr = SLICE_PTR src_buf
  %out_ptr = SLICE_PTR out_buf
  %zero = CONST i64 0

  # Clear out_buf (16 bytes) to 0
  STORE64 %out_ptr 0 %zero
  STORE64 %out_ptr 8 %zero

  # Copy up to 16 bytes
  %i = CONST i64 0
  %max_16 = CONST i64 16
  %len_raw = SUB i64 nl start

  LOOP copy_lbl_loop
    INVARIANT %i >= 0 && %i <= 16

    %done_16 = GTE i64 %i %max_16
    BREAK_IF %done_16
    %done_str = GTE i64 %i %len_raw
    BREAK_IF %done_str

    %src_idx = ADD i64 start %i
    %ch = LOAD8 %src_ptr %src_idx
    # Stop at space (ASCII 32), \r (13), or '(' (40)
    %c_sp = CONST i64 32
    %is_sp = EQ i64 %ch %c_sp
    BREAK_IF %is_sp
    %c_cr = CONST i64 13
    %is_cr = EQ i64 %ch %c_cr
    BREAK_IF %is_cr
    %c_lp = CONST i64 40
    %is_lp = EQ i64 %ch %c_lp
    BREAK_IF %is_lp

    STORE8 %out_ptr %i %ch
    %next_i = ADD i64 %i 1
    %i = MOV %next_i
  END_LOOP copy_lbl_loop

  RET %zero
END_FUNC

# Copy null-terminated C-string from raw memory pointer into slice
FUNC copy_cstr_to_slice(src_ptr: i64, dst_buf: slice<u8>) -> i64
  REQUIRE len(dst_buf) >= 128

  %zero = CONST i64 0
  %is_null = LTE i64 src_ptr %zero
  RET_IF %is_null %zero

  %dst_ptr = SLICE_PTR dst_buf
  %i = CONST i64 0
  %max_120 = CONST i64 120

  LOOP cstr_copy_loop
    INVARIANT %i >= 0 && %i <= 120
    INVARIANT %i <= len(dst_buf)

    %done = GTE i64 %i %max_120
    BREAK_IF %done

    %ch = LOAD8 src_ptr %i
    %is_zero = EQ i64 %ch %zero
    BREAK_IF %is_zero

    STORE8 %dst_ptr %i %ch

    %next_i = ADD i64 %i 1
    %i = MOV %next_i
  END_LOOP cstr_copy_loop

  STORE8 %dst_ptr %i %zero
  ENSURE %i >= 0 && %i <= 120
  RET %i
END_FUNC

# Derive output executable path by stripping trailing '.lit'
FUNC derive_out_path(src_buf: slice<u8>, src_len: i64, out_buf: slice<u8>) -> i64
  REQUIRE src_len >= 0 && src_len <= len(src_buf) && src_len <= 120 && len(out_buf) >= 128

  %zero = CONST i64 0
  %src_ptr = SLICE_PTR src_buf
  %out_ptr = SLICE_PTR out_buf
  %c_4 = CONST i64 4
  %has_4 = GTE i64 src_len %c_4
  %false_b = CONST bool false
  %no_ext_chk = EQ bool %has_4 %false_b
  BR_IF %no_ext_chk copy_full_name

  # Check if ends with ".lit"
  %idx_dot = SUB i64 src_len 4
  %b_dot = LOAD8 %src_ptr %idx_dot
  %c_dot = CONST i64 46
  %is_dot = EQ i64 %b_dot %c_dot
  %not_dot = EQ bool %is_dot %false_b
  BR_IF %not_dot copy_full_name

  %idx_l = SUB i64 src_len 3
  %b_l = LOAD8 %src_ptr %idx_l
  %c_l = CONST i64 108
  %is_l = EQ i64 %b_l %c_l
  %not_l = EQ bool %is_l %false_b
  BR_IF %not_l copy_full_name

  %idx_i = SUB i64 src_len 2
  %b_i = LOAD8 %src_ptr %idx_i
  %c_i = CONST i64 105
  %is_i = EQ i64 %b_i %c_i
  %not_i = EQ bool %is_i %false_b
  BR_IF %not_i copy_full_name

  %idx_t = SUB i64 src_len 1
  %b_t = LOAD8 %src_ptr %idx_t
  %c_t = CONST i64 116
  %is_t = EQ i64 %b_t %c_t
  %not_t = EQ bool %is_t %false_b
  BR_IF %not_t copy_full_name

  # Ends with ".lit"! Target length is src_len - 4
  %out_len_lit = SUB i64 src_len 4
  %target_len = MOV %out_len_lit
  JUMP do_copy_out

  LABEL copy_full_name
  %target_len = MOV src_len

  LABEL do_copy_out
  %i = CONST i64 0
  LOOP out_copy_loop
    INVARIANT %i >= 0 && %i <= target_len
    INVARIANT target_len >= 0 && target_len <= 120
    INVARIANT %i <= len(src_buf)
    INVARIANT %i <= len(out_buf)

    %done = GTE i64 %i %target_len
    BREAK_IF %done

    %byte_val = LOAD8 %src_ptr %i
    STORE8 %out_ptr %i %byte_val

    %next_i = ADD i64 %i 1
    %i = MOV %next_i
  END_LOOP out_copy_loop

  STORE8 %out_ptr %target_len %zero
  ENSURE %target_len >= 0 && %target_len <= 120
  RET %target_len
END_FUNC

# Look up or allocate local variable stack slot (returns slot offset 8, 16, 24, ...)
FUNC find_or_add_var(var_table: slice<u8>, var_count: i64, name_p1: i64, name_p2: i64) -> i64
  REQUIRE len(var_table) >= 65536 && var_count >= 0 && var_count <= 2600
  %ptr = SLICE_PTR var_table
  %vi = CONST i64 0
  %c_24 = CONST i64 24

  LOOP find_var_loop
    INVARIANT %vi >= 0 && %vi <= var_count

    %done = GTE i64 %vi var_count
    BREAK_IF %done

    %off = MUL i64 %vi %c_24
    %cand_p1 = LOAD64 %ptr %off
    %off8 = ADD i64 %off 8
    %cand_p2 = LOAD64 %ptr %off8

    %m1 = EQ i64 %cand_p1 name_p1
    %m2 = EQ i64 %cand_p2 name_p2
    %matched = AND bool %m1 %m2
    %false_b = CONST bool false
    %not_m = EQ bool %matched %false_b
    BR_IF %not_m next_var_entry

    %off16 = ADD i64 %off 16
    %existing_slot = LOAD64 %ptr %off16
    RET %existing_slot

    LABEL next_var_entry
    %next_vi = ADD i64 %vi 1
    %vi = MOV %next_vi
  END_LOOP find_var_loop

  # Variable not found, allocate new slot: slot = (var_count + 1) * 8
  %one = CONST i64 1
  %v_idx = ADD i64 var_count %one
  %c_8 = CONST i64 8
  %new_slot = MUL i64 %v_idx %c_8

  %new_off = MUL i64 var_count %c_24
  STORE64 %ptr %new_off name_p1
  %new_off8 = ADD i64 %new_off 8
  STORE64 %ptr %new_off8 name_p2
  %new_off16 = ADD i64 %new_off 16
  STORE64 %ptr %new_off16 %new_slot

  RET %new_slot
END_FUNC

# Search label table for matching 16-byte label name and return code offset
FUNC find_label_offset(tables: slice<u8>, lbl_count: i64, target_p1: i64, target_p2: i64) -> i64
  REQUIRE len(tables) >= 65536 && lbl_count >= 0 && lbl_count <= 800
  %ptr = SLICE_PTR tables
  %li = CONST i64 0
  %c_24 = CONST i64 24
  %zero = CONST i64 0

  LOOP find_lbl_loop
    INVARIANT %li >= 0 && %li <= lbl_count

    %done = GTE i64 %li lbl_count
    BREAK_IF %done

    %off = MUL i64 %li %c_24
    %cand_p1 = LOAD64 %ptr %off
    %off8 = ADD i64 %off 8
    %cand_p2 = LOAD64 %ptr %off8

    %m1 = EQ i64 %cand_p1 target_p1
    %m2 = EQ i64 %cand_p2 target_p2
    %matched = AND bool %m1 %m2
    %false_b = CONST bool false
    %not_m = EQ bool %matched %false_b
    BR_IF %not_m next_entry

    %off16 = ADD i64 %off 16
    %target_off = LOAD64 %ptr %off16
    RET %target_off

    LABEL next_entry
    %next_li = ADD i64 %li 1
    %li = MOV %next_li
  END_LOOP find_lbl_loop

  RET %zero
END_FUNC

# Resolve all branch and jump fixups by writing 4-byte rel32 offsets into ELF buffer
FUNC resolve_jump_fixups(elf_buf: slice<u8>, tables: slice<u8>, fix_count: i64, lbl_count: i64) -> i64
  REQUIRE len(elf_buf) >= 262144 && len(tables) >= 65536 && fix_count >= 0 && fix_count <= 1200 && lbl_count >= 0 && lbl_count <= 800

  %tbl_ptr = SLICE_PTR tables
  %c_32768 = CONST i64 32768
  %fix_ptr = ADD i64 %tbl_ptr %c_32768
  %elf_ptr = SLICE_PTR elf_buf
  %i = CONST i64 0
  %c_24 = CONST i64 24

  LOOP fix_loop
    INVARIANT %i >= 0 && %i <= fix_count

    %done = GTE i64 %i fix_count
    BREAK_IF %done

    %off = MUL i64 %i %c_24
    %disp_site = LOAD64 %fix_ptr %off
    %off8 = ADD i64 %off 8
    %target_p1 = LOAD64 %fix_ptr %off8
    %off16 = ADD i64 %off 16
    %target_p2 = LOAD64 %fix_ptr %off16

    # Call find_label_offset
    %target_off = CALL find_label_offset tables lbl_count %target_p1 %target_p2

    # Check if target_off is valid (valid code starts at offset 120 after ELF header)
    %c_120_min = CONST i64 120
    %is_undef = LT i64 %target_off %c_120_min
    %false_b_u = CONST bool false
    %not_undef = EQ bool %is_undef %false_b_u
    BR_IF %not_undef jmp_calc_rel

    # Undefined symbol! Print error and return error code 1
    %err_undef_msg = ALLOC slice<u8> 64
    STORE_STR %err_undef_msg "🚨 Error: Undefined function or label reference!\n"
    %msg_len_u = SLICE_LEN %err_undef_msg
    %dummy_err = CALL std_print_slice %err_undef_msg %msg_len_u
    %err_ret_val = CONST i64 1
    RET %err_ret_val

    LABEL jmp_calc_rel
    # Compute rel32 = target_off - (disp_site + 4)
    %next_after_disp = ADD i64 %disp_site 4
    %rel = SUB i64 %target_off %next_after_disp
    %zero = CONST i64 0
    %is_neg = LT i64 %rel %zero
    %false_b = CONST bool false
    %not_neg = EQ bool %is_neg %false_b
    BR_IF %not_neg jmp_rel_pos

    %c_2pow32 = CONST i64 4294967296
    %rel_val = ADD i64 %rel %c_2pow32
    JUMP write_rel_bytes

    LABEL jmp_rel_pos
    %rel_val = MOV %rel

    LABEL write_rel_bytes
    # Check disp_site is within buffer
    %c_max_elf = CONST i64 250000
    %disp_ok = LT i64 %disp_site %c_max_elf
    %not_ok = EQ bool %disp_ok %false_b
    BR_IF %not_ok next_fix_entry

    %b0 = MOD i64 %rel_val 256
    STORE8 %elf_ptr %disp_site %b0

    %v1 = DIV i64 %rel_val 256
    %b1 = MOD i64 %v1 256
    %dp1 = ADD i64 %disp_site 1
    STORE8 %elf_ptr %dp1 %b1

    %v2 = DIV i64 %v1 256
    %b2 = MOD i64 %v2 256
    %dp2 = ADD i64 %disp_site 2
    STORE8 %elf_ptr %dp2 %b2

    %v3 = DIV i64 %v2 256
    %b3 = MOD i64 %v3 256
    %dp3 = ADD i64 %disp_site 3
    STORE8 %elf_ptr %dp3 %b3

    LABEL next_fix_entry
    %next_i = ADD i64 %i 1
    %i = MOV %next_i
  END_LOOP fix_loop

  %zero_ret = CONST i64 0
  RET %zero_ret
END_FUNC

# Find directory prefix length of a path (e.g. "examples/foo.lit" -> 9 for "examples/")
FUNC find_dir_len(path: slice<u8>, path_len: i64) -> i64
  REQUIRE len(path) >= 0 && path_len >= 0 && path_len <= len(path)
  %ptr = SLICE_PTR path
  %i = MOV path_len
  %c_slash = CONST i64 47
  %zero = CONST i64 0

  LOOP dir_loop
    INVARIANT %i >= 0 && %i <= path_len
    %done = LTE i64 %i %zero
    BREAK_IF %done

    %prev_i = SUB i64 %i 1
    %ch = LOAD8 %ptr %prev_i
    %is_slash = EQ i64 %ch %c_slash
    RET_IF %is_slash %i

    %i = MOV %prev_i
  END_LOOP dir_loop

  ENSURE %zero >= 0 && %zero <= path_len
  RET %zero
END_FUNC

# Copy count bytes from src_ptr to dst_ptr
FUNC copy_bytes(src_ptr: i64, dst_ptr: i64, count: i64) -> i64
  REQUIRE count >= 0

  %i = CONST i64 0

  LOOP copy_b_loop
    INVARIANT %i >= 0 && %i <= count

    %done = GTE i64 %i count
    BREAK_IF %done

    %b = LOAD8 src_ptr %i
    STORE8 dst_ptr %i %b

    %next_i = ADD i64 %i 1
    %i = MOV %next_i
  END_LOOP copy_b_loop

  RET count
END_FUNC

# Read source file and recursively resolve and inline top-level IMPORT statements
FUNC load_source_with_imports(src_path: slice<u8>, out_buf: slice<u8>, out_cap: i64) -> i64
  REQUIRE len(src_path) >= 128 && len(out_buf) >= 524288 && out_cap >= 0 && out_cap <= len(out_buf)

  # Buffer for the primary file
  %main_buf = ALLOC slice<u8> 524288
  %main_ptr = SLICE_PTR %main_buf
  %main_cap = CONST i64 524287
  %main_bytes = CALL fs_read_file src_path %main_buf %main_cap

  %zero = CONST i64 0
  %read_err = LTE i64 %main_bytes %zero
  RET_IF %read_err %main_bytes

  # Guarantee null termination at main_bytes
  STORE8 %main_ptr %main_bytes %zero

  # Find directory prefix length of src_path
  %src_len = CALL find_char_from src_path 0 0
  %dir_len = CALL find_dir_len src_path %src_len
  %c_128_max = CONST i64 128
  %dir_ovf = GT i64 %dir_len %c_128_max
  BR_IF %dir_ovf end_import_scan

  # Prefix slice for "IMPORT "
  %p_imp = ALLOC slice<u8> 7
  STORE_STR %p_imp "IMPORT "

  %out_ptr = SLICE_PTR out_buf
  %src_path_ptr = SLICE_PTR src_path

  %c_max_out = CONST i64 520000
  %pos = CONST i64 0
  %out_pos = CONST i64 0

  LOOP import_scan_loop
    INVARIANT %pos >= 0 && %pos <= len(main_buf)
    INVARIANT %out_pos >= 0 && %out_pos <= len(out_buf)

    %done = GTE i64 %pos %main_bytes
    BREAK_IF %done

    %line_start = CALL skip_whitespace %main_buf %pos
    %at_eof = GTE i64 %line_start %main_bytes
    BREAK_IF %at_eof

    %c_nl = CONST i64 10
    %nl = CALL find_char_from %main_buf %line_start %c_nl

    # Check if line starts with "IMPORT "
    %is_imp = CALL str_starts_with %main_buf %line_start %p_imp
    %false_b = CONST bool false
    %not_imp = EQ bool %is_imp %false_b
    BR_IF %not_imp copy_regular_line

    # IMPORT line detected: extract quoted path
    %c_quote = CONST i64 34
    %q1 = CALL find_char_from %main_buf %line_start %c_quote
    %has_q1 = LT i64 %q1 %main_bytes
    %not_has_q1 = EQ bool %has_q1 %false_b
    BR_IF %not_has_q1 next_import_line

    %q1_next = ADD i64 %q1 1
    %q2 = CALL find_char_from %main_buf %q1_next %c_quote

    %has_both = LT i64 %q1_next %q2
    %not_valid_q = EQ bool %has_both %false_b
    BR_IF %not_valid_q next_import_line

    %rel_len = SUB i64 %q2 %q1_next
    %c_max_p = CONST i64 100
    %path_ovf = GT i64 %rel_len %c_max_p
    BR_IF %path_ovf next_import_line

    %c_240 = CONST i64 240
    %sum_len = ADD i64 %dir_len %rel_len
    %sum_too_big = GT i64 %sum_len %c_240
    BR_IF %sum_too_big next_import_line

    # Construct resolved path in 256-byte buffer
    %imp_path = ALLOC slice<u8> 256
    %imp_ptr = SLICE_PTR %imp_path

    # Copy directory prefix
    %dummy_d = CALL copy_bytes %src_path_ptr %imp_ptr %dir_len

    # Append relative path from IMPORT line
    %q1_ptr = ADD i64 %main_ptr %q1_next
    %dest_imp_ptr = ADD i64 %imp_ptr %dir_len
    %dummy_r = CALL copy_bytes %q1_ptr %dest_imp_ptr %rel_len

    # Null terminate imp_path
    %full_path_len = ADD i64 %dir_len %rel_len
    STORE8 %imp_ptr %full_path_len %zero

    # Read the imported file into temporary buffer
    %file_imp_buf = ALLOC slice<u8> 65536
    %file_imp_cap = CONST i64 65536
    %imp_bytes_read = CALL fs_read_file %imp_path %file_imp_buf %file_imp_cap

    %imp_read_ok = GT i64 %imp_bytes_read %zero
    %not_imp_ok = EQ bool %imp_read_ok %false_b
    BR_IF %not_imp_ok next_import_line

    # Check bounds on out_buf before inlining
    %out_rem = SUB i64 %c_max_out %out_pos
    %too_big_imp = GT i64 %imp_bytes_read %out_rem
    BR_IF %too_big_imp next_import_line

    # Inline imported file contents into out_buf
    %file_imp_ptr = SLICE_PTR %file_imp_buf
    %dest_out_ptr = ADD i64 %out_ptr %out_pos
    %dummy_imp = CALL copy_bytes %file_imp_ptr %dest_out_ptr %imp_bytes_read
    %next_out_p = ADD i64 %out_pos %imp_bytes_read
    %out_pos = MOV %next_out_p

    # Add trailing newline after imported file
    %c_ten = CONST i64 10
    STORE8 %out_ptr %out_pos %c_ten
    %next_out_nl = ADD i64 %out_pos 1
    %out_pos = MOV %next_out_nl
    JUMP next_import_line

    LABEL copy_regular_line
    # Copy line from %pos up to %nl + 1 (including newline) into out_buf
    %has_nl_char = LT i64 %nl %main_bytes
    %one_nl = CONST i64 1
    %line_end_with_nl = ADD i64 %nl %one_nl
    %line_end = MOV %line_end_with_nl
    BR_IF %has_nl_char got_line_end
    %line_end = MOV %nl

    LABEL got_line_end
    %line_bytes = SUB i64 %line_end %pos

    %out_rem2 = SUB i64 %c_max_out %out_pos
    %line_too_big = GT i64 %line_bytes %out_rem2
    BR_IF %line_too_big next_import_line

    %cur_src_ptr = ADD i64 %main_ptr %pos
    %dest_out_ptr2 = ADD i64 %out_ptr %out_pos
    %dummy_line = CALL copy_bytes %cur_src_ptr %dest_out_ptr2 %line_bytes
    %next_out_p2 = ADD i64 %out_pos %line_bytes
    %out_pos = MOV %next_out_p2

    LABEL next_import_line
    %c_1 = CONST i64 1
    %next_pos_l = ADD i64 %nl %c_1
    %is_past_end = GTE i64 %next_pos_l %main_bytes
    BR_IF %is_past_end end_import_scan
    %pos = MOV %next_pos_l
  END_LOOP import_scan_loop

  LABEL end_import_scan
  STORE8 %out_ptr %out_pos %zero
  RET %out_pos
END_FUNC


# Compile input .lit file and emit standalone ELF binary
FUNC compile_file(src_path: slice<u8>, out_path: slice<u8>) -> i64
  REQUIRE len(src_path) >= 128 && len(out_path) > 0

  # Read source file and resolve IMPORTs (512KB buffer)
  %src_buf = ALLOC slice<u8> 524288
  %buf_cap = CONST i64 524288
  %bytes_read = CALL load_source_with_imports src_path %src_buf %buf_cap

  %zero = CONST i64 0
  %read_err = LTE i64 %bytes_read %zero
  RET_IF %read_err %bytes_read

  %pos = CONST i64 0
  %parsed_exit = CONST i64 0
  %has_string = CONST bool false
  %str_len = CONST i64 0
  %has_dyn_code = CONST bool false
  %cur_code_pos = CONST i64 120
  %in_main = CONST bool true
  %main_offset = CONST i64 120
  %help_fn_offset = CONST i64 120
  %data_bump = CONST i64 6291456

  # Allocate prefix slice for "FUNC "
  %p_func = ALLOC slice<u8> 5
  STORE_STR %p_func "FUNC "

  # Allocate prefix slice for "CALL "
  %p_call = ALLOC slice<u8> 5
  STORE_STR %p_call "CALL "

  # Allocate prefix slice for "main"
  %p_main = ALLOC slice<u8> 4
  STORE_STR %p_main "main"

  # Allocate prefix slice for "RET "
  %p_ret = ALLOC slice<u8> 4
  STORE_STR %p_ret "RET "

  # Allocate prefix slice for "RET_IF "
  %p_ret_if = ALLOC slice<u8> 7
  STORE_STR %p_ret_if "RET_IF "

  # Allocate prefix slice for "STORE_STR"
  %p_store = ALLOC slice<u8> 9
  STORE_STR %p_store "STORE_STR"

  # Allocate prefix slice for "CONST "
  %p_const = ALLOC slice<u8> 6
  STORE_STR %p_const "CONST "

  # Allocate prefix slice for "ADD i64 "
  %p_add = ALLOC slice<u8> 8
  STORE_STR %p_add "ADD i64 "

  # Allocate prefix slice for "SUB i64 "
  %p_sub = ALLOC slice<u8> 8
  STORE_STR %p_sub "SUB i64 "

  # Allocate prefix slice for "MUL i64 "
  %p_mul = ALLOC slice<u8> 8
  STORE_STR %p_mul "MUL i64 "

  # Allocate prefix slice for "DIV i64 "
  %p_div = ALLOC slice<u8> 8
  STORE_STR %p_div "DIV i64 "

  # Allocate prefix slice for "MOD i64 "
  %p_mod = ALLOC slice<u8> 8
  STORE_STR %p_mod "MOD i64 "

  # Allocate prefix slice for "AND bool "
  %p_and = ALLOC slice<u8> 9
  STORE_STR %p_and "AND bool "

  # Allocate prefix slice for "OR bool "
  %p_or = ALLOC slice<u8> 8
  STORE_STR %p_or "OR bool "

  # Allocate prefix slice for "MOV "
  %p_mov = ALLOC slice<u8> 4
  STORE_STR %p_mov "MOV "

  # Allocate prefix slice for "SYSCALL"
  %p_sys = ALLOC slice<u8> 7
  STORE_STR %p_sys "SYSCALL"

  # Allocate prefix slice for "STORE8 "
  %p_s8 = ALLOC slice<u8> 7
  STORE_STR %p_s8 "STORE8 "

  # Allocate prefix slice for "LOAD8 "
  %p_l8 = ALLOC slice<u8> 6
  STORE_STR %p_l8 "LOAD8 "

  # Allocate prefix slice for "STORE64 "
  %p_s64 = ALLOC slice<u8> 8
  STORE_STR %p_s64 "STORE64 "

  # Allocate prefix slice for "LOAD64 "
  %p_l64 = ALLOC slice<u8> 7
  STORE_STR %p_l64 "LOAD64 "

  # Allocate prefix slice for "ALLOC "
  %p_alloc = ALLOC slice<u8> 6
  STORE_STR %p_alloc "ALLOC "

  # Allocate prefix slice for "SLICE_PTR "
  %p_sptr = ALLOC slice<u8> 10
  STORE_STR %p_sptr "SLICE_PTR "

  # Allocate prefix slice for "SLICE_LEN "
  %p_slen = ALLOC slice<u8> 10
  STORE_STR %p_slen "SLICE_LEN "

  # Allocate comparison prefixes
  %p_lte = ALLOC slice<u8> 4
  STORE_STR %p_lte "LTE "

  %p_gte = ALLOC slice<u8> 4
  STORE_STR %p_gte "GTE "

  %p_neq = ALLOC slice<u8> 4
  STORE_STR %p_neq "NEQ "

  %p_lt = ALLOC slice<u8> 3
  STORE_STR %p_lt "LT "

  %p_gt = ALLOC slice<u8> 3
  STORE_STR %p_gt "GT "

  %p_eq = ALLOC slice<u8> 3
  STORE_STR %p_eq "EQ "

  # Allocate loop prefixes
  %p_loop = ALLOC slice<u8> 5
  STORE_STR %p_loop "LOOP "

  %p_break = ALLOC slice<u8> 9
  STORE_STR %p_break "BREAK_IF "

  %p_endloop = ALLOC slice<u8> 9
  STORE_STR %p_endloop "END_LOOP "

  # Allocate prefix slice for "LABEL "
  %p_label = ALLOC slice<u8> 6
  STORE_STR %p_label "LABEL "

  # Allocate prefix slice for "JUMP "
  %p_jump = ALLOC slice<u8> 5
  STORE_STR %p_jump "JUMP "

  # Allocate prefix slice for "BR_IF "
  %p_brif = ALLOC slice<u8> 6
  STORE_STR %p_brif "BR_IF "

  # Allocate unified tables buffer (64KB: 0..32768 for labels, 32768..65536 for fixups)
  %tables = ALLOC slice<u8> 65536
  %lbl_ptr = SLICE_PTR %tables
  %lbl_count = CONST i64 0

  %c_32768 = CONST i64 32768
  %fix_ptr = ADD i64 %lbl_ptr %c_32768
  %fix_count = CONST i64 0

  # Allocate temporary 16-byte buffer for label name normalization
  %lbl_tmp = ALLOC slice<u8> 16
  %lbl_tmp_ptr = SLICE_PTR %lbl_tmp

  # Allocate local variable table (4KB)
  %var_table = ALLOC slice<u8> 65536
  %var_count = CONST i64 0

  # Allocate ELF binary buffer (1MB)
  %elf_buf = ALLOC slice<u8> 1048576
  %elf_raw_ptr = SLICE_PTR %elf_buf
  %src_raw_ptr = SLICE_PTR %src_buf

  # Allocate temporary 256-byte buffer for string unescaping
  %str_tmp = ALLOC slice<u8> 256
  %str_tmp_ptr = SLICE_PTR %str_tmp

  %c_pct_val = CONST i64 37
  %t_flag = CONST bool true
  %sp_c = CONST i64 32
  %cur_loop_p1 = CONST i64 0
  %cur_loop_p2 = CONST i64 0
  %cur_loop_end_p1 = CONST i64 0

  # Scan lines
  LOOP parse_file_loop
    INVARIANT %pos >= 0 && %pos <= len(src_buf)

    %done = GTE i64 %pos %bytes_read
    BREAK_IF %done

    # Skip whitespace
    %start = CALL skip_whitespace %src_buf %pos

    %at_eof = GTE i64 %start %bytes_read
    BREAK_IF %at_eof

    # Find end of current line (ASCII 10 = '\n')
    %nl_char = CONST i64 10
    %nl = CALL find_char_from %src_buf %start %nl_char

    # Ensure buffer space in line for instruction parsing
    %safe_margin = CONST i64 16
    %needed_len = ADD i64 %start %safe_margin
    %near_eof = GT i64 %needed_len %bytes_read
    BR_IF %near_eof advance_pos

    # Bound check for current code buffer position
    %max_pos = CONST i64 490000
    %code_overflow = GT i64 %cur_code_pos %max_pos
    %err_ovf = CONST i64 -2
    RET_IF %code_overflow %err_ovf

    # 1. Check if line starts with "RET "
    %is_ret = CALL str_starts_with %src_buf %start %p_ret
    %false_b = CONST bool false
    %not_ret = EQ bool %is_ret %false_b
    BR_IF %not_ret check_ret_if

    # Check if named variable or physical register or immediate
    %ret_arg_p = ADD i64 %start 4
    %ret_chk = ADD i64 %ret_arg_p 4
    %ret_near = GT i64 %ret_chk %bytes_read
    BR_IF %ret_near advance_pos

    # Check if named variable FIRST!
    %ret_named = CALL is_named_var %src_buf %ret_arg_p
    %not_ret_named = EQ bool %ret_named %false_b
    BR_IF %not_ret_named check_ret_phys

    # Named variable return: load from stack
    %dummy_rn = CALL copy_label_name %src_buf %ret_arg_p %nl %lbl_tmp
    %rn_p1 = LOAD64 %lbl_tmp_ptr 0
    %rn_p2 = LOAD64 %lbl_tmp_ptr 8
    %rn_slot = CALL find_or_add_var %var_table %var_count %rn_p1 %rn_p2

    # Check if in_main
    %not_im_named = EQ bool %in_main %false_b
    BR_IF %not_im_named ret_named_helper

    # In main: load into rdi (7), exit 60
    %c_r1 = CALL emit_load_stack %elf_buf %cur_code_pos 7 %rn_slot
    %c_r2 = CALL emit_mov_imm %elf_buf %c_r1 0 60
    %c_r3 = CALL emit_syscall_inst %elf_buf %c_r2
    %cur_code_pos = MOV %c_r3
    %t_rn = CONST bool true
    %has_dyn_code = MOV %t_rn
    JUMP advance_pos

    LABEL ret_named_helper
    # In helper: load into rax (0), epilogue
    %c_rh1 = CALL emit_load_stack %elf_buf %cur_code_pos 0 %rn_slot
    %c_rh2 = CALL emit_func_epilogue %elf_buf %c_rh1
    %cur_code_pos = MOV %c_rh2
    %t_rnh = CONST bool true
    %has_dyn_code = MOV %t_rnh
    JUMP advance_pos

    LABEL check_ret_phys
    %c_arg = LOAD8 %src_raw_ptr %ret_arg_p
    %is_ret_reg = EQ i64 %c_arg %c_pct_val
    %not_ret_reg = EQ bool %is_ret_reg %false_b
    BR_IF %not_ret_reg parse_imm_ret

    LABEL ret_phys_reg
    # Check if in_main:
    %false_im = CONST bool false
    %not_im = EQ bool %in_main %false_im
    BR_IF %not_im ret_helper_func

    # It is RET %reg in main -> emit mov rdi, ret_reg; mov rax, 60; syscall
    %ret_reg = CALL parse_reg_id %src_buf %ret_arg_p
    %c1 = CALL emit_mov_rr %elf_buf %cur_code_pos 7 %ret_reg
    %c2 = CALL emit_mov_imm %elf_buf %c1 0 60
    %c3 = CALL emit_syscall_inst %elf_buf %c2
    %cur_code_pos = MOV %c3
    %t_flag = CONST bool true
    %has_dyn_code = MOV %t_flag
    JUMP advance_pos

    LABEL ret_helper_func
    # In helper function: mov rax, ret_reg; emit_func_epilogue
    %ret_reg_h = CALL parse_reg_id %src_buf %ret_arg_p
    %c_h1 = CALL emit_mov_rr %elf_buf %cur_code_pos 0 %ret_reg_h
    %c_h2 = CALL emit_func_epilogue %elf_buf %c_h1
    %cur_code_pos = MOV %c_h2
    %t_h = CONST bool true
    %has_dyn_code = MOV %t_h
    JUMP advance_pos

    LABEL parse_imm_ret
    %ret_len = CONST i64 4
    %val_start = ADD i64 %start %ret_len
    %val = CALL parse_int_from %src_buf %val_start %nl
    %parsed_exit = MOV %val
    JUMP advance_pos

    LABEL check_ret_if
    %is_ret_if = CALL str_starts_with %src_buf %start %p_ret_if
    %not_ret_if = EQ bool %is_ret_if %false_b
    BR_IF %not_ret_if check_reg_line

    # Parse RET_IF %cond %val
    %cond_p_raw = ADD i64 %start 7
    %cond_p = CALL skip_whitespace %src_buf %cond_p_raw
    %cond_chk = ADD i64 %cond_p 4
    %cond_near = GT i64 %cond_chk %bytes_read
    BR_IF %cond_near advance_pos

    %sp_cond = CALL find_char_from %src_buf %cond_p %sp_c
    %dummy_cnd = CALL copy_label_name %src_buf %cond_p %sp_cond %lbl_tmp
    %cnd_p1 = LOAD64 %lbl_tmp_ptr 0
    %cnd_p2 = LOAD64 %lbl_tmp_ptr 8
    %cnd_slot = CALL find_or_add_var %var_table %var_count %cnd_p1 %cnd_p2

    # Emit: load cond into rax (0), test rax, rax, jz rel8
    %c_ri1 = CALL emit_load_stack %elf_buf %cur_code_pos 0 %cnd_slot
    %b_48_ri = CONST i64 72
    %c_ri2 = CALL emit_byte %elf_buf %c_ri1 %b_48_ri
    %b_85_ri = CONST i64 133
    %c_ri3 = CALL emit_byte %elf_buf %c_ri2 %b_85_ri
    %b_c0_ri = CONST i64 192
    %c_ri4 = CALL emit_byte %elf_buf %c_ri3 %b_c0_ri
    %b_74_ri = CONST i64 116
    %c_ri5 = CALL emit_byte %elf_buf %c_ri4 %b_74_ri
    %jz_imm_pos = MOV %c_ri5
    %zero_ri = CONST i64 0
    %body_start = CALL emit_byte %elf_buf %c_ri5 %zero_ri

    # Parse val (arg 2 of RET_IF)
    %val_p = CALL skip_whitespace %src_buf %sp_cond
    %val_chk = ADD i64 %val_p 4
    %val_near = GT i64 %val_chk %bytes_read
    BR_IF %val_near advance_pos

    %is_val_named = CALL is_named_var %src_buf %val_p
    %not_val_n = EQ bool %is_val_named %false_b
    BR_IF %not_val_n rif_check_phys

    # Named variable return value
    %dummy_v_rif = CALL copy_label_name %src_buf %val_p %nl %lbl_tmp
    %v_rif_p1 = LOAD64 %lbl_tmp_ptr 0
    %v_rif_p2 = LOAD64 %lbl_tmp_ptr 8
    %val_slot = CALL find_or_add_var %var_table %var_count %v_rif_p1 %v_rif_p2

    # Check if in_main
    %not_im_rif = EQ bool %in_main %false_b
    BR_IF %not_im_rif rif_named_helper

    # In main: load into rdi (7), mov rax, 60, syscall
    %c_rv1 = CALL emit_load_stack %elf_buf %body_start 7 %val_slot
    %c_rv2 = CALL emit_mov_imm %elf_buf %c_rv1 0 60
    %pos_aft_ret_blk = CALL emit_syscall_inst %elf_buf %c_rv2
    JUMP rif_patch_jz

    LABEL rif_named_helper
    # In helper: load into rax (0), epilogue
    %c_rv1_h = CALL emit_load_stack %elf_buf %body_start 0 %val_slot
    %pos_aft_ret_blk = CALL emit_func_epilogue %elf_buf %c_rv1_h
    JUMP rif_patch_jz

    LABEL rif_check_phys
    %c_val_rif = LOAD8 %src_raw_ptr %val_p
    %is_vrif_pct = EQ i64 %c_val_rif %c_pct_val
    %not_vrif_pct = EQ bool %is_vrif_pct %false_b
    BR_IF %not_vrif_pct rif_val_imm

    # Physical register return value
    %v_reg = CALL parse_reg_id %src_buf %val_p
    %not_im_rif2 = EQ bool %in_main %false_b
    BR_IF %not_im_rif2 rif_phys_helper

    # In main: mov rdi, v_reg; mov rax, 60; syscall
    %c_rv1_p = CALL emit_mov_rr %elf_buf %body_start 7 %v_reg
    %c_rv2_p = CALL emit_mov_imm %elf_buf %c_rv1_p 0 60
    %pos_aft_ret_blk = CALL emit_syscall_inst %elf_buf %c_rv2_p
    JUMP rif_patch_jz

    LABEL rif_phys_helper
    # In helper: mov rax, v_reg; epilogue
    %c_rv1_ph = CALL emit_mov_rr %elf_buf %body_start 0 %v_reg
    %pos_aft_ret_blk = CALL emit_func_epilogue %elf_buf %c_rv1_ph
    JUMP rif_patch_jz

    LABEL rif_val_imm
    # Immediate integer return value
    %v_imm = CALL parse_int_from %src_buf %val_p %nl
    %not_im_rif3 = EQ bool %in_main %false_b
    BR_IF %not_im_rif3 rif_imm_helper

    # In main: mov rdi, imm; mov rax, 60; syscall
    %c_rv1_i = CALL emit_mov_imm %elf_buf %body_start 7 %v_imm
    %c_rv2_i = CALL emit_mov_imm %elf_buf %c_rv1_i 0 60
    %pos_aft_ret_blk = CALL emit_syscall_inst %elf_buf %c_rv2_i
    JUMP rif_patch_jz

    LABEL rif_imm_helper
    # In helper: mov rax, imm; epilogue
    %c_rv1_ih = CALL emit_mov_imm %elf_buf %body_start 0 %v_imm
    %pos_aft_ret_blk = CALL emit_func_epilogue %elf_buf %c_rv1_ih

    LABEL rif_patch_jz
    %rel8 = SUB i64 %pos_aft_ret_blk %body_start
    STORE8 %elf_raw_ptr %jz_imm_pos %rel8
    %cur_code_pos = MOV %pos_aft_ret_blk
    %t_rif = CONST bool true
    %has_dyn_code = MOV %t_rif
    JUMP advance_pos

    LABEL check_reg_line
    # 2. Check if line defines a register or variable: starts with '%'
    %c_start = LOAD8 %src_raw_ptr %start
    %is_pct = EQ i64 %c_start %c_pct_val
    %not_pct = EQ bool %is_pct %false_b
    BR_IF %not_pct check_func

    %is_dst_named = CALL is_named_var %src_buf %start
    %dst_slot = CONST i64 0
    %not_dst_named = EQ bool %is_dst_named %false_b
    BR_IF %not_dst_named reg_dst_phys

    # Named destination variable: look up or add slot
    %dummy_dst_n = CALL copy_label_name %src_buf %start %nl %lbl_tmp
    %dn_p1 = LOAD64 %lbl_tmp_ptr 0
    %dn_p2 = LOAD64 %lbl_tmp_ptr 8
    %slot_alloc = CALL find_or_add_var %var_table %var_count %dn_p1 %dn_p2
    %dst_slot = MOV %slot_alloc
    # If slot was newly allocated: (var_count + 1) * 8
    %c_8_v = CONST i64 8
    %cur_expected = MUL i64 %var_count %c_8_v
    %is_new_var = GT i64 %dst_slot %cur_expected
    %false_nv = CONST bool false
    %not_new_var = EQ bool %is_new_var %false_nv
    BR_IF %not_new_var done_alloc_var
    %max_var_lim = CONST i64 2500
    %var_ovf = GTE i64 %var_count %max_var_lim
    BR_IF %var_ovf done_alloc_var
    %next_var_cnt = ADD i64 %var_count 1
    %var_count = MOV %next_var_cnt

    LABEL done_alloc_var
    # Use rax (0) as scratch register for evaluating RHS
    %dst_reg = CONST i64 0
    JUMP parse_eq_rhs

    LABEL reg_dst_phys
    %dst_reg = CALL parse_reg_id %src_buf %start

    LABEL parse_eq_rhs
    %eq_char = CONST i64 61
    %eq_pos = CALL find_char_from %src_buf %start %eq_char
    %no_eq = GTE i64 %eq_pos %nl
    BR_IF %no_eq advance_pos
    %after_eq = ADD i64 %eq_pos 1
    %rhs_pos = CALL skip_whitespace %src_buf %after_eq

    # 2a. Check if rhs starts with "CONST "
    %is_const = CALL str_starts_with %src_buf %rhs_pos %p_const
    %not_const = EQ bool %is_const %false_b
    BR_IF %not_const check_add

    %type_ch_p = ADD i64 %rhs_pos 6
    %type_ch = LOAD8 %src_raw_ptr %type_ch_p
    %c_ch_i = CONST i64 105
    %is_type_i = EQ i64 %type_ch %c_ch_i
    %not_type_i = EQ bool %is_type_i %false_b
    BR_IF %not_type_i parse_const_bool

    # CONST i64:
    %c_val_p = ADD i64 %rhs_pos 10
    %c_val = CALL parse_int_from %src_buf %c_val_p %nl
    JUMP emit_the_const

    LABEL parse_const_bool
    %b_val_p = ADD i64 %rhs_pos 11
    %b_ch = LOAD8 %src_raw_ptr %b_val_p
    %c_t_ascii = CONST i64 116
    %is_t_ascii = EQ i64 %b_ch %c_t_ascii
    %not_t_ascii = EQ bool %is_t_ascii %false_b
    BR_IF %not_t_ascii const_bool_false
    %c_val = CONST i64 1
    JUMP emit_the_const

    LABEL const_bool_false
    %c_val = CONST i64 0

    LABEL emit_the_const
    %not_named_c = EQ bool %is_dst_named %false_b
    BR_IF %not_named_c emit_const_phys

    # Named destination: emit mov rax, c_val; emit_store_stack dst_slot
    %c_pos1 = CALL emit_mov_imm %elf_buf %cur_code_pos 0 %c_val
    %c_pos2 = CALL emit_store_stack %elf_buf %c_pos1 0 %dst_slot
    %cur_code_pos = MOV %c_pos2
    %t_nc = CONST bool true
    %has_dyn_code = MOV %t_nc
    JUMP advance_pos

    LABEL emit_const_phys
    %next_pos_c = CALL emit_mov_imm %elf_buf %cur_code_pos %dst_reg %c_val
    %cur_code_pos = MOV %next_pos_c
    %t_flag_c = CONST bool true
    %has_dyn_code = MOV %t_flag_c
    JUMP advance_pos

    LABEL check_add
    # 2b. Check if rhs is "ADD i64 "
    %is_add = CALL str_starts_with %src_buf %rhs_pos %p_add
    %not_add = EQ bool %is_add %false_b
    BR_IF %not_add check_sub

    %r1_check = ADD i64 %rhs_pos 16
    %r1_near_eof = GT i64 %r1_check %bytes_read
    BR_IF %r1_near_eof advance_pos

    %r1_pos = ADD i64 %rhs_pos 8
    %sp_pos = CALL find_char_from %src_buf %r1_pos %sp_c
    %r2_pos = CALL skip_whitespace %src_buf %sp_pos

    # Load operand 1 into rdi (7)
    %is_r1_named = CALL is_named_var %src_buf %r1_pos
    %not_r1_n = EQ bool %is_r1_named %false_b
    BR_IF %not_r1_n load_r1_phys

    %dummy_r1n = CALL copy_label_name %src_buf %r1_pos %sp_pos %lbl_tmp
    %r1n_p1 = LOAD64 %lbl_tmp_ptr 0
    %r1n_p2 = LOAD64 %lbl_tmp_ptr 8
    %r1n_slot = CALL find_or_add_var %var_table %var_count %r1n_p1 %r1n_p2
    %pos_after_r1 = CALL emit_load_stack %elf_buf %cur_code_pos 7 %r1n_slot
    JUMP load_op2

    LABEL load_r1_phys
    %r1_add = CALL parse_reg_id %src_buf %r1_pos
    %pos_after_r1 = CALL emit_mov_rr %elf_buf %cur_code_pos 7 %r1_add

    LABEL load_op2
    # Load operand 2 into rsi (6)
    %is_r2_named = CALL is_named_var %src_buf %r2_pos
    %not_r2_n = EQ bool %is_r2_named %false_b
    BR_IF %not_r2_n load_r2_phys

    %dummy_r2n = CALL copy_label_name %src_buf %r2_pos %nl %lbl_tmp
    %r2n_p1 = LOAD64 %lbl_tmp_ptr 0
    %r2n_p2 = LOAD64 %lbl_tmp_ptr 8
    %r2n_slot = CALL find_or_add_var %var_table %var_count %r2n_p1 %r2n_p2
    %pos_after_r2 = CALL emit_load_stack %elf_buf %pos_after_r1 6 %r2n_slot
    JUMP do_add_op

    LABEL load_r2_phys
    %c_r2_ch = LOAD8 %src_raw_ptr %r2_pos
    %is_r2_pct = EQ i64 %c_r2_ch %c_pct_val
    %not_r2_pct = EQ bool %is_r2_pct %false_b
    BR_IF %not_r2_pct r2_imm_add

    %r2_add = CALL parse_reg_id %src_buf %r2_pos
    %pos_after_r2 = CALL emit_mov_rr %elf_buf %pos_after_r1 6 %r2_add
    JUMP do_add_op

    LABEL r2_imm_add
    %r2_imm_val = CALL parse_int_from %src_buf %r2_pos %nl
    %pos_after_r2 = CALL emit_mov_imm %elf_buf %pos_after_r1 6 %r2_imm_val

    LABEL do_add_op
    # emit add rdi, rsi (rdi = 7, rsi = 6)
    %pos_after_add = CALL emit_add_rr %elf_buf %pos_after_r2 7 6

    # Store result
    %not_dst_n_add = EQ bool %is_dst_named %false_b
    BR_IF %not_dst_n_add st_dst_phys_add

    # Store rdi (7) into dst_slot
    %pos_aft_st_add = CALL emit_store_stack %elf_buf %pos_after_add 7 %dst_slot
    %cur_code_pos = MOV %pos_aft_st_add
    %t_add_n = CONST bool true
    %has_dyn_code = MOV %t_add_n
    JUMP advance_pos

    LABEL st_dst_phys_add
    %pos_after_phys = CALL emit_mov_rr %elf_buf %pos_after_add %dst_reg 7
    %cur_code_pos = MOV %pos_after_phys
    %t_add_p = CONST bool true
    %has_dyn_code = MOV %t_add_p
    JUMP advance_pos

    LABEL check_sub
    # 2c. Check if rhs is "SUB i64 "
    %is_sub = CALL str_starts_with %src_buf %rhs_pos %p_sub
    %not_sub = EQ bool %is_sub %false_b
    BR_IF %not_sub check_mul

    %r1_s_check = ADD i64 %rhs_pos 16
    %r1_s_near = GT i64 %r1_s_check %bytes_read
    BR_IF %r1_s_near advance_pos

    %r1_s_p = ADD i64 %rhs_pos 8
    %sp_pos_s = CALL find_char_from %src_buf %r1_s_p %sp_c
    %r2_s_p = CALL skip_whitespace %src_buf %sp_pos_s

    # Load operand 1 into rdi (7)
    %is_r1_s_named = CALL is_named_var %src_buf %r1_s_p
    %not_r1_sn = EQ bool %is_r1_s_named %false_b
    BR_IF %not_r1_sn load_r1_s_phys

    %dummy_r1sn = CALL copy_label_name %src_buf %r1_s_p %sp_pos_s %lbl_tmp
    %r1sn_p1 = LOAD64 %lbl_tmp_ptr 0
    %r1sn_p2 = LOAD64 %lbl_tmp_ptr 8
    %r1sn_slot = CALL find_or_add_var %var_table %var_count %r1sn_p1 %r1sn_p2
    %pos_after_r1s = CALL emit_load_stack %elf_buf %cur_code_pos 7 %r1sn_slot
    JUMP load_op2_s

    LABEL load_r1_s_phys
    %r1_s = CALL parse_reg_id %src_buf %r1_s_p
    %pos_after_r1s = CALL emit_mov_rr %elf_buf %cur_code_pos 7 %r1_s

    LABEL load_op2_s
    # Load operand 2 into rsi (6)
    %is_r2_s_named = CALL is_named_var %src_buf %r2_s_p
    %not_r2_sn = EQ bool %is_r2_s_named %false_b
    BR_IF %not_r2_sn load_r2_s_phys

    %dummy_r2sn = CALL copy_label_name %src_buf %r2_s_p %nl %lbl_tmp
    %r2sn_p1 = LOAD64 %lbl_tmp_ptr 0
    %r2sn_p2 = LOAD64 %lbl_tmp_ptr 8
    %r2sn_slot = CALL find_or_add_var %var_table %var_count %r2sn_p1 %r2sn_p2
    %pos_after_r2s = CALL emit_load_stack %elf_buf %pos_after_r1s 6 %r2sn_slot
    JUMP do_sub_op

    LABEL load_r2_s_phys
    %c_r2s_ch = LOAD8 %src_raw_ptr %r2_s_p
    %is_r2s_pct = EQ i64 %c_r2s_ch %c_pct_val
    %not_r2s_pct = EQ bool %is_r2s_pct %false_b
    BR_IF %not_r2s_pct r2_imm_sub

    %r2_s = CALL parse_reg_id %src_buf %r2_s_p
    %pos_after_r2s = CALL emit_mov_rr %elf_buf %pos_after_r1s 6 %r2_s
    JUMP do_sub_op

    LABEL r2_imm_sub
    %r2s_imm_val = CALL parse_int_from %src_buf %r2_s_p %nl
    %pos_after_r2s = CALL emit_mov_imm %elf_buf %pos_after_r1s 6 %r2s_imm_val

    LABEL do_sub_op
    # emit sub rdi, rsi (rdi = 7, rsi = 6)
    %pos_after_sub = CALL emit_sub_rr %elf_buf %pos_after_r2s 7 6

    # Store result
    %not_dst_n_sub = EQ bool %is_dst_named %false_b
    BR_IF %not_dst_n_sub st_dst_phys_sub

    %pos_aft_st_sub = CALL emit_store_stack %elf_buf %pos_after_sub 7 %dst_slot
    %cur_code_pos = MOV %pos_aft_st_sub
    %t_sub_n = CONST bool true
    %has_dyn_code = MOV %t_sub_n
    JUMP advance_pos

    LABEL st_dst_phys_sub
    %pos_aft_ph_sub = CALL emit_mov_rr %elf_buf %pos_after_sub %dst_reg 7
    %cur_code_pos = MOV %pos_aft_ph_sub
    %t_sub_p = CONST bool true
    %has_dyn_code = MOV %t_sub_p
    JUMP advance_pos

    LABEL check_mul
    # 2d. Check if rhs is "MUL i64 "
    %is_mul = CALL str_starts_with %src_buf %rhs_pos %p_mul
    %not_mul = EQ bool %is_mul %false_b
    BR_IF %not_mul check_div

    %r1_m_check = ADD i64 %rhs_pos 16
    %r1_m_near = GT i64 %r1_m_check %bytes_read
    BR_IF %r1_m_near advance_pos

    %r1_m_p = ADD i64 %rhs_pos 8
    %sp_pos_m = CALL find_char_from %src_buf %r1_m_p %sp_c
    %r2_m_p = CALL skip_whitespace %src_buf %sp_pos_m

    # Load operand 1 into rdi (7)
    %is_r1_m_named = CALL is_named_var %src_buf %r1_m_p
    %not_r1_mn = EQ bool %is_r1_m_named %false_b
    BR_IF %not_r1_mn load_r1_m_phys

    %dummy_r1mn = CALL copy_label_name %src_buf %r1_m_p %sp_pos_m %lbl_tmp
    %r1mn_p1 = LOAD64 %lbl_tmp_ptr 0
    %r1mn_p2 = LOAD64 %lbl_tmp_ptr 8
    %r1mn_slot = CALL find_or_add_var %var_table %var_count %r1mn_p1 %r1mn_p2
    %pos_after_r1m = CALL emit_load_stack %elf_buf %cur_code_pos 7 %r1mn_slot
    JUMP load_op2_m

    LABEL load_r1_m_phys
    %r1_m = CALL parse_reg_id %src_buf %r1_m_p
    %pos_after_r1m = CALL emit_mov_rr %elf_buf %cur_code_pos 7 %r1_m

    LABEL load_op2_m
    # Load operand 2 into rsi (6)
    %is_r2_m_named = CALL is_named_var %src_buf %r2_m_p
    %not_r2_mn = EQ bool %is_r2_m_named %false_b
    BR_IF %not_r2_mn load_r2_m_phys

    %dummy_r2mn = CALL copy_label_name %src_buf %r2_m_p %nl %lbl_tmp
    %r2mn_p1 = LOAD64 %lbl_tmp_ptr 0
    %r2mn_p2 = LOAD64 %lbl_tmp_ptr 8
    %r2mn_slot = CALL find_or_add_var %var_table %var_count %r2mn_p1 %r2mn_p2
    %pos_after_r2m = CALL emit_load_stack %elf_buf %pos_after_r1m 6 %r2mn_slot
    JUMP do_mul_op

    LABEL load_r2_m_phys
    %c_r2m_ch = LOAD8 %src_raw_ptr %r2_m_p
    %is_r2m_pct = EQ i64 %c_r2m_ch %c_pct_val
    %not_r2m_pct = EQ bool %is_r2m_pct %false_b
    BR_IF %not_r2m_pct r2_imm_mul

    %r2_m = CALL parse_reg_id %src_buf %r2_m_p
    %pos_after_r2m = CALL emit_mov_rr %elf_buf %pos_after_r1m 6 %r2_m
    JUMP do_mul_op

    LABEL r2_imm_mul
    %r2m_imm_val = CALL parse_int_from %src_buf %r2_m_p %nl
    %pos_after_r2m = CALL emit_mov_imm %elf_buf %pos_after_r1m 6 %r2m_imm_val

    LABEL do_mul_op
    # emit mul rdi, rsi (rdi = 7, rsi = 6)
    %pos_after_mul = CALL emit_mul_rr %elf_buf %pos_after_r2m 7 6

    # Store result
    %not_dst_n_mul = EQ bool %is_dst_named %false_b
    BR_IF %not_dst_n_mul st_dst_phys_mul

    %pos_aft_st_mul = CALL emit_store_stack %elf_buf %pos_after_mul 7 %dst_slot
    %cur_code_pos = MOV %pos_aft_st_mul
    %t_mul_n = CONST bool true
    %has_dyn_code = MOV %t_mul_n
    JUMP advance_pos

    LABEL st_dst_phys_mul
    %pos_aft_ph_mul = CALL emit_mov_rr %elf_buf %pos_after_mul %dst_reg 7
    %cur_code_pos = MOV %pos_aft_ph_mul
    %t_mul_p = CONST bool true
    %has_dyn_code = MOV %t_mul_p
    JUMP advance_pos

    LABEL check_div
    # Check if rhs is "DIV i64 "
    %is_div = CALL str_starts_with %src_buf %rhs_pos %p_div
    %not_div = EQ bool %is_div %false_b
    BR_IF %not_div check_mod

    %r1_d_check = ADD i64 %rhs_pos 16
    %r1_d_near = GT i64 %r1_d_check %bytes_read
    BR_IF %r1_d_near advance_pos

    %r1_d_p = ADD i64 %rhs_pos 8
    %sp_pos_d = CALL find_char_from %src_buf %r1_d_p %sp_c
    %r2_d_p = CALL skip_whitespace %src_buf %sp_pos_d

    # Load operand 1 into rax (0)
    %is_r1_d_named = CALL is_named_var %src_buf %r1_d_p
    %not_r1_dn = EQ bool %is_r1_d_named %false_b
    BR_IF %not_r1_dn load_r1_d_phys

    %dummy_r1dn = CALL copy_label_name %src_buf %r1_d_p %sp_pos_d %lbl_tmp
    %r1dn_p1 = LOAD64 %lbl_tmp_ptr 0
    %r1dn_p2 = LOAD64 %lbl_tmp_ptr 8
    %r1dn_slot = CALL find_or_add_var %var_table %var_count %r1dn_p1 %r1dn_p2
    %pos_after_r1d = CALL emit_load_stack %elf_buf %cur_code_pos 0 %r1dn_slot
    JUMP load_op2_d

    LABEL load_r1_d_phys
    %r1_d = CALL parse_reg_id %src_buf %r1_d_p
    %pos_after_r1d = CALL emit_mov_rr %elf_buf %cur_code_pos 0 %r1_d

    LABEL load_op2_d
    # Load operand 2 into rcx (1)
    %is_r2_d_named = CALL is_named_var %src_buf %r2_d_p
    %not_r2_dn = EQ bool %is_r2_d_named %false_b
    BR_IF %not_r2_dn load_r2_d_phys

    %dummy_r2dn = CALL copy_label_name %src_buf %r2_d_p %nl %lbl_tmp
    %r2dn_p1 = LOAD64 %lbl_tmp_ptr 0
    %r2dn_p2 = LOAD64 %lbl_tmp_ptr 8
    %r2dn_slot = CALL find_or_add_var %var_table %var_count %r2dn_p1 %r2dn_p2
    %pos_after_r2d = CALL emit_load_stack %elf_buf %pos_after_r1d 1 %r2dn_slot
    JUMP do_div_op

    LABEL load_r2_d_phys
    %c_r2d_ch = LOAD8 %src_raw_ptr %r2_d_p
    %is_r2d_pct = EQ i64 %c_r2d_ch %c_pct_val
    %not_r2d_pct = EQ bool %is_r2d_pct %false_b
    BR_IF %not_r2d_pct r2_imm_div

    %r2_d = CALL parse_reg_id %src_buf %r2_d_p
    %pos_after_r2d = CALL emit_mov_rr %elf_buf %pos_after_r1d 1 %r2_d
    JUMP do_div_op

    LABEL r2_imm_div
    %r2d_imm_val = CALL parse_int_from %src_buf %r2_d_p %nl
    %pos_after_r2d = CALL emit_mov_imm %elf_buf %pos_after_r1d 1 %r2d_imm_val

    LABEL do_div_op
    # emit idiv (false = div) -> result in rax (0)
    %false_idiv = CONST bool false
    %pos_after_div = CALL emit_idiv_rr %elf_buf %pos_after_r2d %false_idiv

    # Store result from rax (0)
    %not_dst_n_div = EQ bool %is_dst_named %false_b
    BR_IF %not_dst_n_div st_dst_phys_div

    %pos_aft_st_div = CALL emit_store_stack %elf_buf %pos_after_div 0 %dst_slot
    %cur_code_pos = MOV %pos_aft_st_div
    %t_div_n = CONST bool true
    %has_dyn_code = MOV %t_div_n
    JUMP advance_pos

    LABEL st_dst_phys_div
    %pos_aft_ph_div = CALL emit_mov_rr %elf_buf %pos_after_div %dst_reg 0
    %cur_code_pos = MOV %pos_aft_ph_div
    %t_div_p = CONST bool true
    %has_dyn_code = MOV %t_div_p
    JUMP advance_pos

    LABEL check_mod
    # Check if rhs is "MOD i64 "
    %is_mod = CALL str_starts_with %src_buf %rhs_pos %p_mod
    %not_mod = EQ bool %is_mod %false_b
    BR_IF %not_mod check_and

    %r1_mod_chk = ADD i64 %rhs_pos 16
    %r1_mod_near = GT i64 %r1_mod_chk %bytes_read
    BR_IF %r1_mod_near advance_pos

    %r1_mod_p = ADD i64 %rhs_pos 8
    %sp_pos_mod = CALL find_char_from %src_buf %r1_mod_p %sp_c
    %r2_mod_p = CALL skip_whitespace %src_buf %sp_pos_mod

    # Load operand 1 into rax (0)
    %is_r1_mod_named = CALL is_named_var %src_buf %r1_mod_p
    %not_r1_modn = EQ bool %is_r1_mod_named %false_b
    BR_IF %not_r1_modn load_r1_mod_phys

    %dummy_r1modn = CALL copy_label_name %src_buf %r1_mod_p %sp_pos_mod %lbl_tmp
    %r1modn_p1 = LOAD64 %lbl_tmp_ptr 0
    %r1modn_p2 = LOAD64 %lbl_tmp_ptr 8
    %r1modn_slot = CALL find_or_add_var %var_table %var_count %r1modn_p1 %r1modn_p2
    %pos_after_r1mod = CALL emit_load_stack %elf_buf %cur_code_pos 0 %r1modn_slot
    JUMP load_op2_mod

    LABEL load_r1_mod_phys
    %r1_mod = CALL parse_reg_id %src_buf %r1_mod_p
    %pos_after_r1mod = CALL emit_mov_rr %elf_buf %cur_code_pos 0 %r1_mod

    LABEL load_op2_mod
    # Load operand 2 into rcx (1)
    %is_r2_mod_named = CALL is_named_var %src_buf %r2_mod_p
    %not_r2_modn = EQ bool %is_r2_mod_named %false_b
    BR_IF %not_r2_modn load_r2_mod_phys

    %dummy_r2modn = CALL copy_label_name %src_buf %r2_mod_p %nl %lbl_tmp
    %r2modn_p1 = LOAD64 %lbl_tmp_ptr 0
    %r2modn_p2 = LOAD64 %lbl_tmp_ptr 8
    %r2modn_slot = CALL find_or_add_var %var_table %var_count %r2modn_p1 %r2modn_p2
    %pos_after_r2mod = CALL emit_load_stack %elf_buf %pos_after_r1mod 1 %r2modn_slot
    JUMP do_mod_op

    LABEL load_r2_mod_phys
    %c_r2mod_ch = LOAD8 %src_raw_ptr %r2_mod_p
    %is_r2mod_pct = EQ i64 %c_r2mod_ch %c_pct_val
    %not_r2mod_pct = EQ bool %is_r2mod_pct %false_b
    BR_IF %not_r2mod_pct r2_imm_mod

    %r2_mod = CALL parse_reg_id %src_buf %r2_mod_p
    %pos_after_r2mod = CALL emit_mov_rr %elf_buf %pos_after_r1mod 1 %r2_mod
    JUMP do_mod_op

    LABEL r2_imm_mod
    %r2mod_imm_val = CALL parse_int_from %src_buf %r2_mod_p %nl
    %pos_after_r2mod = CALL emit_mov_imm %elf_buf %pos_after_r1mod 1 %r2mod_imm_val

    LABEL do_mod_op
    # emit idiv (true = mod) -> remainder in rax (0)
    %true_imod = CONST bool true
    %pos_after_mod = CALL emit_idiv_rr %elf_buf %pos_after_r2mod %true_imod

    # Store result from rax (0)
    %not_dst_n_mod = EQ bool %is_dst_named %false_b
    BR_IF %not_dst_n_mod st_dst_phys_mod

    %pos_aft_st_mod = CALL emit_store_stack %elf_buf %pos_after_mod 0 %dst_slot
    %cur_code_pos = MOV %pos_aft_st_mod
    %t_mod_n = CONST bool true
    %has_dyn_code = MOV %t_mod_n
    JUMP advance_pos

    LABEL st_dst_phys_mod
    %pos_aft_ph_mod = CALL emit_mov_rr %elf_buf %pos_after_mod %dst_reg 0
    %cur_code_pos = MOV %pos_aft_ph_mod
    %t_mod_p = CONST bool true
    %has_dyn_code = MOV %t_mod_p
    JUMP advance_pos

    LABEL check_and
    # Check if rhs is "AND bool "
    %is_and = CALL str_starts_with %src_buf %rhs_pos %p_and
    %not_and = EQ bool %is_and %false_b
    BR_IF %not_and check_or

    %r1_and_chk = ADD i64 %rhs_pos 16
    %r1_and_near = GT i64 %r1_and_chk %bytes_read
    BR_IF %r1_and_near advance_pos

    %r1_and_p = ADD i64 %rhs_pos 9
    %sp_pos_and = CALL find_char_from %src_buf %r1_and_p %sp_c
    %r2_and_p = CALL skip_whitespace %src_buf %sp_pos_and

    # Load operand 1 into rdi (7)
    %is_r1_and_named = CALL is_named_var %src_buf %r1_and_p
    %not_r1_andn = EQ bool %is_r1_and_named %false_b
    BR_IF %not_r1_andn load_r1_and_phys

    %dummy_r1andn = CALL copy_label_name %src_buf %r1_and_p %sp_pos_and %lbl_tmp
    %r1andn_p1 = LOAD64 %lbl_tmp_ptr 0
    %r1andn_p2 = LOAD64 %lbl_tmp_ptr 8
    %r1andn_slot = CALL find_or_add_var %var_table %var_count %r1andn_p1 %r1andn_p2
    %pos_after_r1and = CALL emit_load_stack %elf_buf %cur_code_pos 7 %r1andn_slot
    JUMP load_op2_and

    LABEL load_r1_and_phys
    %r1_and = CALL parse_reg_id %src_buf %r1_and_p
    %pos_after_r1and = CALL emit_mov_rr %elf_buf %cur_code_pos 7 %r1_and

    LABEL load_op2_and
    # Load operand 2 into rsi (6)
    %is_r2_and_named = CALL is_named_var %src_buf %r2_and_p
    %not_r2_andn = EQ bool %is_r2_and_named %false_b
    BR_IF %not_r2_andn load_r2_and_phys

    %dummy_r2andn = CALL copy_label_name %src_buf %r2_and_p %nl %lbl_tmp
    %r2andn_p1 = LOAD64 %lbl_tmp_ptr 0
    %r2andn_p2 = LOAD64 %lbl_tmp_ptr 8
    %r2andn_slot = CALL find_or_add_var %var_table %var_count %r2andn_p1 %r2andn_p2
    %pos_after_r2and = CALL emit_load_stack %elf_buf %pos_after_r1and 6 %r2andn_slot
    JUMP do_and_op

    LABEL load_r2_and_phys
    %c_r2and_ch = LOAD8 %src_raw_ptr %r2_and_p
    %is_r2and_pct = EQ i64 %c_r2and_ch %c_pct_val
    %not_r2and_pct = EQ bool %is_r2and_pct %false_b
    BR_IF %not_r2and_pct r2_imm_and

    %r2_and = CALL parse_reg_id %src_buf %r2_and_p
    %pos_after_r2and = CALL emit_mov_rr %elf_buf %pos_after_r1and 6 %r2_and
    JUMP do_and_op

    LABEL r2_imm_and
    %r2and_imm_val = CALL parse_int_from %src_buf %r2_and_p %nl
    %pos_after_r2and = CALL emit_mov_imm %elf_buf %pos_after_r1and 6 %r2and_imm_val

    LABEL do_and_op
    # emit and rdi, rsi (rdi = 7, rsi = 6)
    %pos_after_and = CALL emit_and_rr %elf_buf %pos_after_r2and 7 6

    # Store result
    %not_dst_n_and = EQ bool %is_dst_named %false_b
    BR_IF %not_dst_n_and st_dst_phys_and

    %pos_aft_st_and = CALL emit_store_stack %elf_buf %pos_after_and 7 %dst_slot
    %cur_code_pos = MOV %pos_aft_st_and
    %t_and_n = CONST bool true
    %has_dyn_code = MOV %t_and_n
    JUMP advance_pos

    LABEL st_dst_phys_and
    %pos_aft_ph_and = CALL emit_mov_rr %elf_buf %pos_after_and %dst_reg 7
    %cur_code_pos = MOV %pos_aft_ph_and
    %t_and_p = CONST bool true
    %has_dyn_code = MOV %t_and_p
    JUMP advance_pos

    LABEL check_or
    # Check if rhs is "OR bool "
    %is_or = CALL str_starts_with %src_buf %rhs_pos %p_or
    %not_or = EQ bool %is_or %false_b
    BR_IF %not_or check_mov

    %r1_or_chk = ADD i64 %rhs_pos 16
    %r1_or_near = GT i64 %r1_or_chk %bytes_read
    BR_IF %r1_or_near advance_pos

    %r1_or_p = ADD i64 %rhs_pos 8
    %sp_pos_or = CALL find_char_from %src_buf %r1_or_p %sp_c
    %r2_or_p = CALL skip_whitespace %src_buf %sp_pos_or

    # Load operand 1 into rdi (7)
    %is_r1_or_named = CALL is_named_var %src_buf %r1_or_p
    %not_r1_orn = EQ bool %is_r1_or_named %false_b
    BR_IF %not_r1_orn load_r1_or_phys

    %dummy_r1orn = CALL copy_label_name %src_buf %r1_or_p %sp_pos_or %lbl_tmp
    %r1orn_p1 = LOAD64 %lbl_tmp_ptr 0
    %r1orn_p2 = LOAD64 %lbl_tmp_ptr 8
    %r1orn_slot = CALL find_or_add_var %var_table %var_count %r1orn_p1 %r1orn_p2
    %pos_after_r1or = CALL emit_load_stack %elf_buf %cur_code_pos 7 %r1orn_slot
    JUMP load_op2_or

    LABEL load_r1_or_phys
    %r1_or = CALL parse_reg_id %src_buf %r1_or_p
    %pos_after_r1or = CALL emit_mov_rr %elf_buf %cur_code_pos 7 %r1_or

    LABEL load_op2_or
    # Load operand 2 into rsi (6)
    %is_r2_or_named = CALL is_named_var %src_buf %r2_or_p
    %not_r2_orn = EQ bool %is_r2_or_named %false_b
    BR_IF %not_r2_orn load_r2_or_phys

    %dummy_r2orn = CALL copy_label_name %src_buf %r2_or_p %nl %lbl_tmp
    %r2orn_p1 = LOAD64 %lbl_tmp_ptr 0
    %r2orn_p2 = LOAD64 %lbl_tmp_ptr 8
    %r2orn_slot = CALL find_or_add_var %var_table %var_count %r2orn_p1 %r2orn_p2
    %pos_after_r2or = CALL emit_load_stack %elf_buf %pos_after_r1or 6 %r2orn_slot
    JUMP do_or_op

    LABEL load_r2_or_phys
    %c_r2or_ch = LOAD8 %src_raw_ptr %r2_or_p
    %is_r2or_pct = EQ i64 %c_r2or_ch %c_pct_val
    %not_r2or_pct = EQ bool %is_r2or_pct %false_b
    BR_IF %not_r2or_pct r2_imm_or

    %r2_or = CALL parse_reg_id %src_buf %r2_or_p
    %pos_after_r2or = CALL emit_mov_rr %elf_buf %pos_after_r1or 6 %r2_or
    JUMP do_or_op

    LABEL r2_imm_or
    %r2or_imm_val = CALL parse_int_from %src_buf %r2_or_p %nl
    %pos_after_r2or = CALL emit_mov_imm %elf_buf %pos_after_r1or 6 %r2or_imm_val

    LABEL do_or_op
    # emit or rdi, rsi (rdi = 7, rsi = 6)
    %pos_after_or = CALL emit_or_rr %elf_buf %pos_after_r2or 7 6

    # Store result
    %not_dst_n_or = EQ bool %is_dst_named %false_b
    BR_IF %not_dst_n_or st_dst_phys_or

    %pos_aft_st_or = CALL emit_store_stack %elf_buf %pos_after_or 7 %dst_slot
    %cur_code_pos = MOV %pos_aft_st_or
    %t_or_n = CONST bool true
    %has_dyn_code = MOV %t_or_n
    JUMP advance_pos

    LABEL st_dst_phys_or
    %pos_aft_ph_or = CALL emit_mov_rr %elf_buf %pos_after_or %dst_reg 7
    %cur_code_pos = MOV %pos_aft_ph_or
    %t_or_p = CONST bool true
    %has_dyn_code = MOV %t_or_p
    JUMP advance_pos

    LABEL check_mov
    # 2e. Check if rhs is "MOV "
    %is_mov = CALL str_starts_with %src_buf %rhs_pos %p_mov
    %not_mov = EQ bool %is_mov %false_b
    BR_IF %not_mov check_load8

    %r_src_p = ADD i64 %rhs_pos 4
    %r_src_check = ADD i64 %r_src_p 4
    %r_src_near = GT i64 %r_src_check %bytes_read
    BR_IF %r_src_near advance_pos

    # Check if src is named or physical
    %is_src_n = CALL is_named_var %src_buf %r_src_p
    %not_src_n = EQ bool %is_src_n %false_b
    BR_IF %not_src_n mov_phys_src

    %dummy_msn = CALL copy_label_name %src_buf %r_src_p %nl %lbl_tmp
    %msn_p1 = LOAD64 %lbl_tmp_ptr 0
    %msn_p2 = LOAD64 %lbl_tmp_ptr 8
    %msn_slot = CALL find_or_add_var %var_table %var_count %msn_p1 %msn_p2

    # Destination is physical or named?
    %not_dst_n_m1 = EQ bool %is_dst_named %false_b
    BR_IF %not_dst_n_m1 mov_src_named_dst_phys

    # src named, dst named: load into rax (0), store to dst_slot
    %pos_after_ms = CALL emit_load_stack %elf_buf %cur_code_pos 0 %msn_slot
    %pos_after_md = CALL emit_store_stack %elf_buf %pos_after_ms 0 %dst_slot
    %cur_code_pos = MOV %pos_after_md
    %t_mov_n = CONST bool true
    %has_dyn_code = MOV %t_mov_n
    JUMP advance_pos

    LABEL mov_src_named_dst_phys
    # src named, dst physical: load directly into dst_reg (no rax clobber!)
    %pos_after_m1 = CALL emit_load_stack %elf_buf %cur_code_pos %dst_reg %msn_slot
    %cur_code_pos = MOV %pos_after_m1
    %t_mov_p1 = CONST bool true
    %has_dyn_code = MOV %t_mov_p1
    JUMP advance_pos

    LABEL mov_phys_src
    %r_src = CALL parse_reg_id %src_buf %r_src_p
    %not_dst_n_m2 = EQ bool %is_dst_named %false_b
    BR_IF %not_dst_n_m2 mov_src_phys_dst_phys

    # src physical, dst named: store r_src directly into dst_slot!
    %pos_after_m2 = CALL emit_store_stack %elf_buf %cur_code_pos %r_src %dst_slot
    %cur_code_pos = MOV %pos_after_m2
    %t_mov_p2 = CONST bool true
    %has_dyn_code = MOV %t_mov_p2
    JUMP advance_pos

    LABEL mov_src_phys_dst_phys
    # src physical, dst physical: mov dst_reg, r_src!
    %pos_after_m3 = CALL emit_mov_rr %elf_buf %cur_code_pos %dst_reg %r_src
    %cur_code_pos = MOV %pos_after_m3
    %t_mov_p3 = CONST bool true
    %has_dyn_code = MOV %t_mov_p3
    JUMP advance_pos

    LABEL check_load8
    # 2f. Check if rhs is "LOAD8 "
    %is_l8 = CALL str_starts_with %src_buf %rhs_pos %p_l8
    %not_l8 = EQ bool %is_l8 %false_b
    BR_IF %not_l8 check_load64

    %l8_near_check = ADD i64 %rhs_pos 16
    %l8_near = GT i64 %l8_near_check %bytes_read
    BR_IF %l8_near advance_pos

    %ptr_l8_p = ADD i64 %rhs_pos 6
    %is_ptr_l8_n = CALL is_named_var %src_buf %ptr_l8_p
    %not_ptr_l8_n = EQ bool %is_ptr_l8_n %false_b
    BR_IF %not_ptr_l8_n l8_phys_ptr

    %sp_l8 = CALL find_char_from %src_buf %ptr_l8_p %sp_c
    %dummy_l8p = CALL copy_label_name %src_buf %ptr_l8_p %sp_l8 %lbl_tmp
    %l8p_p1 = LOAD64 %lbl_tmp_ptr 0
    %l8p_p2 = LOAD64 %lbl_tmp_ptr 8
    %l8p_slot = CALL find_or_add_var %var_table %var_count %l8p_p1 %l8p_p2
    %cl0 = CALL emit_load_stack %elf_buf %cur_code_pos 0 %l8p_slot
    JUMP l8_parse_offset

    LABEL l8_phys_ptr
    %ptr_l8_r = CALL parse_reg_id %src_buf %ptr_l8_p
    %cl0 = CALL emit_mov_rr %elf_buf %cur_code_pos 0 %ptr_l8_r
    %sp_l8 = CALL find_char_from %src_buf %ptr_l8_p %sp_c

    LABEL l8_parse_offset
    %off_l8_p = CALL skip_whitespace %src_buf %sp_l8
    %off_l8_chk = ADD i64 %off_l8_p 4
    %off_l8_near = GT i64 %off_l8_chk %bytes_read
    BR_IF %off_l8_near advance_pos

    %is_off_l8_n = CALL is_named_var %src_buf %off_l8_p
    %not_off_l8_n = EQ bool %is_off_l8_n %false_b
    BR_IF %not_off_l8_n check_l8_phys_off

    %dummy_l8o = CALL copy_label_name %src_buf %off_l8_p %nl %lbl_tmp
    %l8o_p1 = LOAD64 %lbl_tmp_ptr 0
    %l8o_p2 = LOAD64 %lbl_tmp_ptr 8
    %l8o_slot = CALL find_or_add_var %var_table %var_count %l8o_p1 %l8o_p2
    %cl1 = CALL emit_load_stack %elf_buf %cl0 1 %l8o_slot
    JUMP l8_emit_load

    LABEL check_l8_phys_off
    %c_off_l8 = LOAD8 %src_raw_ptr %off_l8_p
    %is_off_l8_r = EQ i64 %c_off_l8 %c_pct_val
    %not_off_l8_r = EQ bool %is_off_l8_r %false_b
    BR_IF %not_off_l8_r l8_imm_off

    LABEL l8_phys_off
    %off_l8_r = CALL parse_reg_id %src_buf %off_l8_p
    %cl1 = CALL emit_mov_rr %elf_buf %cl0 1 %off_l8_r
    JUMP l8_emit_load

    LABEL l8_imm_off
    %off_l8_imm = CALL parse_int_from %src_buf %off_l8_p %nl
    %cl1 = CALL emit_mov_imm %elf_buf %cl0 1 %off_l8_imm

    LABEL l8_emit_load
    %cl3 = CALL emit_load8_idx %elf_buf %cl1
    %not_dst_l8_n = EQ bool %is_dst_named %false_b
    BR_IF %not_dst_l8_n l8_store_phys

    %cl4 = CALL emit_store_stack %elf_buf %cl3 0 %dst_slot
    %cur_code_pos = MOV %cl4
    %t_l8 = CONST bool true
    %has_dyn_code = MOV %t_l8
    JUMP advance_pos

    LABEL l8_store_phys
    %cl4 = CALL emit_mov_rr %elf_buf %cl3 %dst_reg 0
    %cur_code_pos = MOV %cl4
    %t_l8 = CONST bool true
    %has_dyn_code = MOV %t_l8
    JUMP advance_pos

    LABEL check_load64
    # 2g. Check if rhs is "LOAD64 "
    %is_l64 = CALL str_starts_with %src_buf %rhs_pos %p_l64
    %not_l64 = EQ bool %is_l64 %false_b
    BR_IF %not_l64 check_alloc

    %l64_near_chk = ADD i64 %rhs_pos 16
    %l64_near = GT i64 %l64_near_chk %bytes_read
    BR_IF %l64_near advance_pos

    %ptr_l64_p = ADD i64 %rhs_pos 7
    %is_ptr_l64_n = CALL is_named_var %src_buf %ptr_l64_p
    %not_ptr_l64_n = EQ bool %is_ptr_l64_n %false_b
    BR_IF %not_ptr_l64_n l64_phys_ptr

    %sp_l64 = CALL find_char_from %src_buf %ptr_l64_p %sp_c
    %dummy_l64p = CALL copy_label_name %src_buf %ptr_l64_p %sp_l64 %lbl_tmp
    %l64p_p1 = LOAD64 %lbl_tmp_ptr 0
    %l64p_p2 = LOAD64 %lbl_tmp_ptr 8
    %l64p_slot = CALL find_or_add_var %var_table %var_count %l64p_p1 %l64p_p2
    %cl64_0 = CALL emit_load_stack %elf_buf %cur_code_pos 0 %l64p_slot
    JUMP l64_parse_offset

    LABEL l64_phys_ptr
    %ptr_l64_r = CALL parse_reg_id %src_buf %ptr_l64_p
    %cl64_0 = CALL emit_mov_rr %elf_buf %cur_code_pos 0 %ptr_l64_r
    %sp_l64 = CALL find_char_from %src_buf %ptr_l64_p %sp_c

    LABEL l64_parse_offset
    %off_l64_p = CALL skip_whitespace %src_buf %sp_l64
    %off_l64_chk = ADD i64 %off_l64_p 4
    %off_l64_near = GT i64 %off_l64_chk %bytes_read
    BR_IF %off_l64_near advance_pos

    %is_off_l64_n = CALL is_named_var %src_buf %off_l64_p
    %not_off_l64_n = EQ bool %is_off_l64_n %false_b
    BR_IF %not_off_l64_n check_l64_phys_off

    %dummy_l64o = CALL copy_label_name %src_buf %off_l64_p %nl %lbl_tmp
    %l64o_p1 = LOAD64 %lbl_tmp_ptr 0
    %l64o_p2 = LOAD64 %lbl_tmp_ptr 8
    %l64o_slot = CALL find_or_add_var %var_table %var_count %l64o_p1 %l64o_p2
    %cl64_1 = CALL emit_load_stack %elf_buf %cl64_0 1 %l64o_slot
    JUMP l64_emit_load

    LABEL check_l64_phys_off
    %c_off_l64 = LOAD8 %src_raw_ptr %off_l64_p
    %is_off_l64_r = EQ i64 %c_off_l64 %c_pct_val
    %not_off_l64_r = EQ bool %is_off_l64_r %false_b
    BR_IF %not_off_l64_r l64_imm_off

    LABEL l64_phys_off
    %off_l64_r = CALL parse_reg_id %src_buf %off_l64_p
    %cl64_1 = CALL emit_mov_rr %elf_buf %cl64_0 1 %off_l64_r
    JUMP l64_emit_load

    LABEL l64_imm_off
    %off_l64_imm = CALL parse_int_from %src_buf %off_l64_p %nl
    %cl64_1 = CALL emit_mov_imm %elf_buf %cl64_0 1 %off_l64_imm

    LABEL l64_emit_load
    %cl64_3 = CALL emit_load64_idx %elf_buf %cl64_1
    %not_dst_l64_n = EQ bool %is_dst_named %false_b
    BR_IF %not_dst_l64_n l64_store_phys

    %cl64_4 = CALL emit_store_stack %elf_buf %cl64_3 0 %dst_slot
    %cur_code_pos = MOV %cl64_4
    %t_l64 = CONST bool true
    %has_dyn_code = MOV %t_l64
    JUMP advance_pos

    LABEL l64_store_phys
    %cl64_4 = CALL emit_mov_rr %elf_buf %cl64_3 %dst_reg 0
    %cur_code_pos = MOV %cl64_4
    %t_l64 = CONST bool true
    %has_dyn_code = MOV %t_l64
    JUMP advance_pos

    LABEL check_alloc
    # 2h. Check if rhs is "ALLOC "
    %is_alloc = CALL str_starts_with %src_buf %rhs_pos %p_alloc
    %not_alloc = EQ bool %is_alloc %false_b
    BR_IF %not_alloc check_sptr

    %alloc_chk = ADD i64 %rhs_pos 8
    %alloc_near = GT i64 %alloc_chk %bytes_read
    BR_IF %alloc_near advance_pos

    %alloc_args_p = ADD i64 %rhs_pos 6
    %sp_c = CONST i64 32
    %sp_alloc = CALL find_char_from %src_buf %alloc_args_p %sp_c
    %size_p = CALL skip_whitespace %src_buf %sp_alloc
    %size_p_ovf = GT i64 %size_p %nl
    BR_IF %size_p_ovf advance_pos

    %alloc_size = CALL parse_int_from %src_buf %size_p %nl
    %c_16 = CONST i64 16
    %size_aligned = ADD i64 %alloc_size %c_16
    %not_dst_n_al = EQ bool %is_dst_named %false_b
    BR_IF %not_dst_n_al emit_alloc_phys

    # Named destination: emit mov rax, data_bump; emit_store_stack dst_slot
    %al_pos1 = CALL emit_mov_imm %elf_buf %cur_code_pos 0 %data_bump
    %al_pos2 = CALL emit_store_stack %elf_buf %al_pos1 0 %dst_slot
    %cur_code_pos = MOV %al_pos2
    JUMP alloc_bump_finish

    LABEL emit_alloc_phys
    %next_pos_al = CALL emit_mov_imm %elf_buf %cur_code_pos %dst_reg %data_bump
    %cur_code_pos = MOV %next_pos_al

    LABEL alloc_bump_finish
    %next_data_bump = ADD i64 %data_bump %size_aligned
    %data_bump = MOV %next_data_bump
    %t_al = CONST bool true
    %has_dyn_code = MOV %t_al
    JUMP advance_pos

    LABEL check_sptr
    # 2i. Check if rhs is "SLICE_PTR "
    %is_sptr = CALL str_starts_with %src_buf %rhs_pos %p_sptr
    %not_sptr = EQ bool %is_sptr %false_b
    BR_IF %not_sptr check_slen

    %buf_arg_p = ADD i64 %rhs_pos 10
    %buf_r_chk = ADD i64 %buf_arg_p 4
    %buf_r_near = GT i64 %buf_r_chk %bytes_read
    BR_IF %buf_r_near advance_pos

    %is_buf_named = CALL is_named_var %src_buf %buf_arg_p
    %not_buf_n = EQ bool %is_buf_named %false_b
    BR_IF %not_buf_n sptr_phys_buf

    %dummy_spn = CALL copy_label_name %src_buf %buf_arg_p %nl %lbl_tmp
    %spn_p1 = LOAD64 %lbl_tmp_ptr 0
    %spn_p2 = LOAD64 %lbl_tmp_ptr 8
    %spn_slot = CALL find_or_add_var %var_table %var_count %spn_p1 %spn_p2
    %pos_after_sptr = CALL emit_load_stack %elf_buf %cur_code_pos 0 %spn_slot
    JUMP sptr_store_dst

    LABEL sptr_phys_buf
    %buf_r = CALL parse_reg_id %src_buf %buf_arg_p
    %pos_after_sptr = CALL emit_mov_rr %elf_buf %cur_code_pos 0 %buf_r

    LABEL sptr_store_dst
    %not_dst_sptr_n = EQ bool %is_dst_named %false_b
    BR_IF %not_dst_sptr_n sptr_store_phys

    %next_pos_sp = CALL emit_store_stack %elf_buf %pos_after_sptr 0 %dst_slot
    %cur_code_pos = MOV %next_pos_sp
    %t_sp = CONST bool true
    %has_dyn_code = MOV %t_sp
    JUMP advance_pos

    LABEL sptr_store_phys
    %next_pos_sp2 = CALL emit_mov_rr %elf_buf %pos_after_sptr %dst_reg 0
    %cur_code_pos = MOV %next_pos_sp2
    %t_sp2 = CONST bool true
    %has_dyn_code = MOV %t_sp2
    JUMP advance_pos

    LABEL check_slen
    # Check if rhs is "SLICE_LEN "
    %is_slen = CALL str_starts_with %src_buf %rhs_pos %p_slen
    %not_slen = EQ bool %is_slen %false_b
    BR_IF %not_slen check_call

    %buf_arg_sl = ADD i64 %rhs_pos 10
    %buf_sl_chk = ADD i64 %buf_arg_sl 4
    %buf_sl_near = GT i64 %buf_sl_chk %bytes_read
    BR_IF %buf_sl_near advance_pos

    # Load buffer pointer into rax (0)
    %is_buf_sl_n = CALL is_named_var %src_buf %buf_arg_sl
    %not_bsl_n = EQ bool %is_buf_sl_n %false_b
    BR_IF %not_bsl_n slen_phys_buf

    %dummy_sln = CALL copy_label_name %src_buf %buf_arg_sl %nl %lbl_tmp
    %sln_p1 = LOAD64 %lbl_tmp_ptr 0
    %sln_p2 = LOAD64 %lbl_tmp_ptr 8
    %sln_slot = CALL find_or_add_var %var_table %var_count %sln_p1 %sln_p2
    %pos_after_slen = CALL emit_load_stack %elf_buf %cur_code_pos 0 %sln_slot
    JUMP slen_call_strlen

    LABEL slen_phys_buf
    %buf_sl_r = CALL parse_reg_id %src_buf %buf_arg_sl
    %pos_after_slen = CALL emit_mov_rr %elf_buf %cur_code_pos 0 %buf_sl_r

    LABEL slen_call_strlen
    # emit inline strlen on rax -> leaves length in rax (0)
    %pos_aft_strlen = CALL emit_inline_strlen %elf_buf %pos_after_slen

    # Store result
    %not_dst_sl_n = EQ bool %is_dst_named %false_b
    BR_IF %not_dst_sl_n slen_store_phys

    %next_pos_sl = CALL emit_store_stack %elf_buf %pos_aft_strlen 0 %dst_slot
    %cur_code_pos = MOV %next_pos_sl
    %t_sl = CONST bool true
    %has_dyn_code = MOV %t_sl
    JUMP advance_pos

    LABEL slen_store_phys
    %next_pos_sl2 = CALL emit_mov_rr %elf_buf %pos_aft_strlen %dst_reg 0
    %cur_code_pos = MOV %next_pos_sl2
    %t_sl2 = CONST bool true
    %has_dyn_code = MOV %t_sl2
    JUMP advance_pos

    LABEL check_call
    # 2j. Check if rhs is "CALL "
    %is_call = CALL str_starts_with %src_buf %rhs_pos %p_call
    %not_call = EQ bool %is_call %false_b
    BR_IF %not_call check_cmp

    # Find space after func_name
    %fn_nm_p = ADD i64 %rhs_pos 5
    %dummy_fn_call = CALL copy_label_name %src_buf %fn_nm_p %nl %lbl_tmp
    %fn_call_p1 = LOAD64 %lbl_tmp_ptr 0
    %fn_call_p2 = LOAD64 %lbl_tmp_ptr 8
    %sp_call_1 = CALL find_char_from %src_buf %fn_nm_p %sp_c
    %arg1_p = CALL skip_whitespace %src_buf %sp_call_1

    # Check if arg1 is present (before end of line)
    %has_arg1 = LT i64 %arg1_p %nl
    %not_has_arg1 = EQ bool %has_arg1 %false_b
    BR_IF %not_has_arg1 emit_the_call_noparams

    # Ensure buffer bounds for arg1_p
    %arg1_chk = ADD i64 %arg1_p 4
    %arg1_near = GT i64 %arg1_chk %bytes_read
    BR_IF %arg1_near emit_the_call_noparams

    # Parse arg1: named var -> load stack, phys reg -> mov reg, imm -> mov imm
    %is_a1_named = CALL is_named_var %src_buf %arg1_p
    %not_a1_n = EQ bool %is_a1_named %false_b
    BR_IF %not_a1_n check_arg1_phys

    %dummy_a1n = CALL copy_label_name %src_buf %arg1_p %nl %lbl_tmp
    %a1n_p1 = LOAD64 %lbl_tmp_ptr 0
    %a1n_p2 = LOAD64 %lbl_tmp_ptr 8
    %a1n_slot = CALL find_or_add_var %var_table %var_count %a1n_p1 %a1n_p2
    %c_arg1 = CALL emit_load_stack %elf_buf %cur_code_pos 7 %a1n_slot
    JUMP check_arg2

    LABEL check_arg1_phys
    %c_arg1_ch = LOAD8 %src_raw_ptr %arg1_p
    %is_arg1_r = EQ i64 %c_arg1_ch %c_pct_val
    %not_arg1_r = EQ bool %is_arg1_r %false_b
    BR_IF %not_arg1_r arg1_imm_lbl

    %arg1_r = CALL parse_reg_id %src_buf %arg1_p
    %c_arg1 = CALL emit_mov_rr %elf_buf %cur_code_pos 7 %arg1_r
    JUMP check_arg2

    LABEL arg1_imm_lbl
    %arg1_imm = CALL parse_int_from %src_buf %arg1_p %nl
    %c_arg1 = CALL emit_mov_imm %elf_buf %cur_code_pos 7 %arg1_imm

    LABEL check_arg2
    %sp_call_2 = CALL find_char_from %src_buf %arg1_p %sp_c
    %arg2_p = CALL skip_whitespace %src_buf %sp_call_2
    %has_arg2 = LT i64 %arg2_p %nl
    %not_has_arg2 = EQ bool %has_arg2 %false_b
    BR_IF %not_has_arg2 call_after_arg1

    %arg2_chk = ADD i64 %arg2_p 4
    %arg2_near = GT i64 %arg2_chk %bytes_read
    BR_IF %arg2_near call_after_arg1

    # Parse arg2: named var -> load stack, phys reg -> mov reg, imm -> mov imm
    %is_a2_named = CALL is_named_var %src_buf %arg2_p
    %not_a2_n = EQ bool %is_a2_named %false_b
    BR_IF %not_a2_n check_arg2_phys

    %dummy_a2n = CALL copy_label_name %src_buf %arg2_p %nl %lbl_tmp
    %a2n_p1 = LOAD64 %lbl_tmp_ptr 0
    %a2n_p2 = LOAD64 %lbl_tmp_ptr 8
    %a2n_slot = CALL find_or_add_var %var_table %var_count %a2n_p1 %a2n_p2
    %c_arg2 = CALL emit_load_stack %elf_buf %c_arg1 6 %a2n_slot
    JUMP check_arg3

    LABEL check_arg2_phys
    %c_arg2_ch = LOAD8 %src_raw_ptr %arg2_p
    %is_arg2_r = EQ i64 %c_arg2_ch %c_pct_val
    %not_arg2_r = EQ bool %is_arg2_r %false_b
    BR_IF %not_arg2_r arg2_imm_lbl

    %arg2_r = CALL parse_reg_id %src_buf %arg2_p
    %c_arg2 = CALL emit_mov_rr %elf_buf %c_arg1 6 %arg2_r
    JUMP check_arg3

    LABEL arg2_imm_lbl
    %arg2_imm = CALL parse_int_from %src_buf %arg2_p %nl
    %c_arg2 = CALL emit_mov_imm %elf_buf %c_arg1 6 %arg2_imm

    LABEL check_arg3
    %sp_call_3 = CALL find_char_from %src_buf %arg2_p %sp_c
    %arg3_p = CALL skip_whitespace %src_buf %sp_call_3
    %has_arg3 = LT i64 %arg3_p %nl
    %not_has_arg3 = EQ bool %has_arg3 %false_b
    BR_IF %not_has_arg3 call_after_arg2

    %arg3_chk = ADD i64 %arg3_p 4
    %arg3_near = GT i64 %arg3_chk %bytes_read
    BR_IF %arg3_near call_after_arg2

    # Parse arg3: named var -> load stack, phys reg -> mov reg, imm -> mov imm
    %is_a3_named = CALL is_named_var %src_buf %arg3_p
    %not_a3_n = EQ bool %is_a3_named %false_b
    BR_IF %not_a3_n check_arg3_phys

    %dummy_a3n = CALL copy_label_name %src_buf %arg3_p %nl %lbl_tmp
    %a3n_p1 = LOAD64 %lbl_tmp_ptr 0
    %a3n_p2 = LOAD64 %lbl_tmp_ptr 8
    %a3n_slot = CALL find_or_add_var %var_table %var_count %a3n_p1 %a3n_p2
    %c_arg3 = CALL emit_load_stack %elf_buf %c_arg2 2 %a3n_slot
    JUMP check_arg4

    LABEL check_arg3_phys
    %c_arg3_ch = LOAD8 %src_raw_ptr %arg3_p
    %is_arg3_r = EQ i64 %c_arg3_ch %c_pct_val
    %not_arg3_r = EQ bool %is_arg3_r %false_b
    BR_IF %not_arg3_r arg3_imm_lbl

    %arg3_r = CALL parse_reg_id %src_buf %arg3_p
    %c_arg3 = CALL emit_mov_rr %elf_buf %c_arg2 2 %arg3_r
    JUMP check_arg4

    LABEL arg3_imm_lbl
    %arg3_imm = CALL parse_int_from %src_buf %arg3_p %nl
    %c_arg3 = CALL emit_mov_imm %elf_buf %c_arg2 2 %arg3_imm

    LABEL check_arg4
    %sp_call_4 = CALL find_char_from %src_buf %arg3_p %sp_c
    %arg4_p = CALL skip_whitespace %src_buf %sp_call_4
    %has_arg4 = LT i64 %arg4_p %nl
    %not_has_arg4 = EQ bool %has_arg4 %false_b
    BR_IF %not_has_arg4 call_after_arg3

    %arg4_chk = ADD i64 %arg4_p 4
    %arg4_near = GT i64 %arg4_chk %bytes_read
    BR_IF %arg4_near call_after_arg3

    # Parse arg4: named var -> load stack, phys reg -> mov reg, imm -> mov imm
    %is_a4_named = CALL is_named_var %src_buf %arg4_p
    %not_a4_n = EQ bool %is_a4_named %false_b
    BR_IF %not_a4_n check_arg4_phys

    %dummy_a4n = CALL copy_label_name %src_buf %arg4_p %nl %lbl_tmp
    %a4n_p1 = LOAD64 %lbl_tmp_ptr 0
    %a4n_p2 = LOAD64 %lbl_tmp_ptr 8
    %a4n_slot = CALL find_or_add_var %var_table %var_count %a4n_p1 %a4n_p2
    %c_arg4 = CALL emit_load_stack %elf_buf %c_arg3 1 %a4n_slot
    JUMP call_after_arg4

    LABEL check_arg4_phys
    %c_arg4_ch = LOAD8 %src_raw_ptr %arg4_p
    %is_arg4_r = EQ i64 %c_arg4_ch %c_pct_val
    %not_arg4_r = EQ bool %is_arg4_r %false_b
    BR_IF %not_arg4_r arg4_imm_lbl

    %arg4_r = CALL parse_reg_id %src_buf %arg4_p
    %c_arg4 = CALL emit_mov_rr %elf_buf %c_arg3 1 %arg4_r
    JUMP call_after_arg4

    LABEL arg4_imm_lbl
    %arg4_imm = CALL parse_int_from %src_buf %arg4_p %nl
    %c_arg4 = CALL emit_mov_imm %elf_buf %c_arg3 1 %arg4_imm

    LABEL call_after_arg4
    %call_pos = MOV %c_arg4
    JUMP emit_the_call

    LABEL call_after_arg3
    %call_pos = MOV %c_arg3
    JUMP emit_the_call

    LABEL call_after_arg2
    %call_pos = MOV %c_arg2
    JUMP emit_the_call

    LABEL call_after_arg1
    %call_pos = MOV %c_arg1
    JUMP emit_the_call

    LABEL emit_the_call_noparams
    %call_pos = MOV %cur_code_pos

    LABEL emit_the_call
    %c_call = CALL emit_call_inst %elf_buf %call_pos 0
    %disp_site_c = ADD i64 %call_pos 1

    # Record fixup for function call
    %max_fix_lim_c = CONST i64 1200
    %fix_ovf_c = GTE i64 %fix_count %max_fix_lim_c
    BR_IF %fix_ovf_c call_done_fix

    %c_24_call = CONST i64 24
    %fc_entry = MUL i64 %fix_count %c_24_call
    STORE64 %fix_ptr %fc_entry %disp_site_c
    %fc_e8 = ADD i64 %fc_entry 8
    STORE64 %fix_ptr %fc_e8 %fn_call_p1
    %fc_e16 = ADD i64 %fc_entry 16
    STORE64 %fix_ptr %fc_e16 %fn_call_p2
    %next_fix_cnt_c = ADD i64 %fix_count 1
    %fix_count = MOV %next_fix_cnt_c

    LABEL call_done_fix
    # Return value from rax (0) into dst_reg or dst_slot
    %not_dst_call_n = EQ bool %is_dst_named %false_b
    BR_IF %not_dst_call_n call_store_phys

    %c_ret_v = CALL emit_store_stack %elf_buf %c_call 0 %dst_slot
    %cur_code_pos = MOV %c_ret_v
    %t_call = CONST bool true
    %has_dyn_code = MOV %t_call
    JUMP advance_pos

    LABEL call_store_phys
    %c_ret_v2 = CALL emit_mov_rr %elf_buf %c_call %dst_reg 0
    %cur_code_pos = MOV %c_ret_v2
    %t_call2 = CONST bool true
    %has_dyn_code = MOV %t_call2
    JUMP advance_pos

    LABEL check_cmp
    # Check "LTE "
    %is_lte = CALL str_starts_with %src_buf %rhs_pos %p_lte
    %not_lte = EQ bool %is_lte %false_b
    BR_IF %not_lte check_gte
    %cc_cmp = CONST i64 158
    %op_len_cmp = CONST i64 4
    JUMP do_emit_cmp

    LABEL check_gte
    # Check "GTE "
    %is_gte = CALL str_starts_with %src_buf %rhs_pos %p_gte
    %not_gte = EQ bool %is_gte %false_b
    BR_IF %not_gte check_neq
    %cc_cmp = CONST i64 157
    %op_len_cmp = CONST i64 4
    JUMP do_emit_cmp

    LABEL check_neq
    # Check "NEQ "
    %is_neq = CALL str_starts_with %src_buf %rhs_pos %p_neq
    %not_neq = EQ bool %is_neq %false_b
    BR_IF %not_neq check_lt
    %cc_cmp = CONST i64 149
    %op_len_cmp = CONST i64 4
    JUMP do_emit_cmp

    LABEL check_lt
    # Check "LT "
    %is_lt = CALL str_starts_with %src_buf %rhs_pos %p_lt
    %not_lt = EQ bool %is_lt %false_b
    BR_IF %not_lt check_gt
    %cc_cmp = CONST i64 156
    %op_len_cmp = CONST i64 3
    JUMP do_emit_cmp

    LABEL check_gt
    # Check "GT "
    %is_gt = CALL str_starts_with %src_buf %rhs_pos %p_gt
    %not_gt = EQ bool %is_gt %false_b
    BR_IF %not_gt check_eq
    %cc_cmp = CONST i64 159
    %op_len_cmp = CONST i64 3
    JUMP do_emit_cmp

    LABEL check_eq
    # Check "EQ "
    %is_eq = CALL str_starts_with %src_buf %rhs_pos %p_eq
    %not_eq = EQ bool %is_eq %false_b
    BR_IF %not_eq chk_rhs_sys
    %cc_cmp = CONST i64 148
    %op_len_cmp = CONST i64 3

    LABEL do_emit_cmp
    %cmp_chk = ADD i64 %rhs_pos 16
    %cmp_near = GT i64 %cmp_chk %bytes_read
    BR_IF %cmp_near advance_pos

    # Skip type name: pos_after_op = rhs_pos + op_len_cmp
    %type_p_cmp = ADD i64 %rhs_pos %op_len_cmp
    %sp_type_cmp = CALL find_char_from %src_buf %type_p_cmp %sp_c
    %r1_cmp_p = CALL skip_whitespace %src_buf %sp_type_cmp
    %sp_r1_cmp = CALL find_char_from %src_buf %r1_cmp_p %sp_c
    %r2_cmp_p = CALL skip_whitespace %src_buf %sp_r1_cmp

    # Load r1 into rdi (7)
    %is_r1_cn = CALL is_named_var %src_buf %r1_cmp_p
    %not_r1_cn = EQ bool %is_r1_cn %false_b
    BR_IF %not_r1_cn check_r1_cphys

    %dummy_r1cn = CALL copy_label_name %src_buf %r1_cmp_p %sp_r1_cmp %lbl_tmp
    %r1cn_p1 = LOAD64 %lbl_tmp_ptr 0
    %r1cn_p2 = LOAD64 %lbl_tmp_ptr 8
    %r1cn_slot = CALL find_or_add_var %var_table %var_count %r1cn_p1 %r1cn_p2
    %pos_after_cr1 = CALL emit_load_stack %elf_buf %cur_code_pos 7 %r1cn_slot
    JUMP load_op2_cmp

    LABEL check_r1_cphys
    %c_r1_cch = LOAD8 %src_raw_ptr %r1_cmp_p
    %is_r1_cpct = EQ i64 %c_r1_cch %c_pct_val
    %not_r1_cpct = EQ bool %is_r1_cpct %false_b
    BR_IF %not_r1_cpct r1_cimm_lbl

    %r1_cphys = CALL parse_reg_id %src_buf %r1_cmp_p
    %pos_after_cr1 = CALL emit_mov_rr %elf_buf %cur_code_pos 7 %r1_cphys
    JUMP load_op2_cmp

    LABEL r1_cimm_lbl
    %r1_cimm = CALL parse_int_from %src_buf %r1_cmp_p %sp_r1_cmp
    %pos_after_cr1 = CALL emit_mov_imm %elf_buf %cur_code_pos 7 %r1_cimm

    LABEL load_op2_cmp
    # Load r2 into rsi (6)
    %is_r2_cn = CALL is_named_var %src_buf %r2_cmp_p
    %not_r2_cn = EQ bool %is_r2_cn %false_b
    BR_IF %not_r2_cn check_r2_cphys

    %dummy_r2cn = CALL copy_label_name %src_buf %r2_cmp_p %nl %lbl_tmp
    %r2cn_p1 = LOAD64 %lbl_tmp_ptr 0
    %r2cn_p2 = LOAD64 %lbl_tmp_ptr 8
    %r2cn_slot = CALL find_or_add_var %var_table %var_count %r2cn_p1 %r2cn_p2
    %pos_after_cr2 = CALL emit_load_stack %elf_buf %pos_after_cr1 6 %r2cn_slot
    JUMP do_the_cmp

    LABEL check_r2_cphys
    %c_r2_cch = LOAD8 %src_raw_ptr %r2_cmp_p
    %is_r2_cpct = EQ i64 %c_r2_cch %c_pct_val
    %not_r2_cpct = EQ bool %is_r2_cpct %false_b
    BR_IF %not_r2_cpct r2_cimm_lbl

    %r2_cphys = CALL parse_reg_id %src_buf %r2_cmp_p
    %pos_after_cr2 = CALL emit_mov_rr %elf_buf %pos_after_cr1 6 %r2_cphys
    JUMP do_the_cmp

    LABEL r2_cimm_lbl
    %r2_cimm = CALL parse_int_from %src_buf %r2_cmp_p %nl
    %pos_after_cr2 = CALL emit_mov_imm %elf_buf %pos_after_cr1 6 %r2_cimm

    LABEL do_the_cmp
    %c_cmp1 = CALL emit_cmp_rr %elf_buf %pos_after_cr2 7 6
    %c_cmp2 = CALL emit_setcc %elf_buf %c_cmp1 %cc_cmp
    %c_cmp3 = CALL emit_movzx_reg_al %elf_buf %c_cmp2 0

    %not_dst_n_cmp = EQ bool %is_dst_named %false_b
    BR_IF %not_dst_n_cmp cmp_done_store
    %c_cmp4 = CALL emit_store_stack %elf_buf %c_cmp3 0 %dst_slot
    %cur_code_pos = MOV %c_cmp4
    %t_cmp_s = CONST bool true
    %has_dyn_code = MOV %t_cmp_s
    JUMP advance_pos

    LABEL cmp_done_store
    %c_cmp_m = CALL emit_mov_rr %elf_buf %c_cmp3 %dst_reg 0
    %cur_code_pos = MOV %c_cmp_m
    %t_cmp = CONST bool true
    %has_dyn_code = MOV %t_cmp
    JUMP advance_pos

    LABEL chk_rhs_sys
    # Check if rhs is "SYSCALL"
    %is_rhs_sys = CALL str_starts_with %src_buf %rhs_pos %p_sys
    %not_rhs_sys = EQ bool %is_rhs_sys %false_b
    BR_IF %not_rhs_sys advance_pos

    %c_sys_inst = CALL emit_syscall_inst %elf_buf %cur_code_pos

    # Result of syscall is in rax (0). Store to dst_slot or dst_reg
    %not_dst_sys_n = EQ bool %is_dst_named %false_b
    BR_IF %not_dst_sys_n sys_store_phys

    %c_sys_ret = CALL emit_store_stack %elf_buf %c_sys_inst 0 %dst_slot
    %cur_code_pos = MOV %c_sys_ret
    %t_sys_n = CONST bool true
    %has_dyn_code = MOV %t_sys_n
    JUMP advance_pos

    LABEL sys_store_phys
    %c_sys_ret2 = CALL emit_mov_rr %elf_buf %c_sys_inst %dst_reg 0
    %cur_code_pos = MOV %c_sys_ret2
    %t_sys_p = CONST bool true
    %has_dyn_code = MOV %t_sys_p
    JUMP advance_pos

    LABEL check_func
    # Check if line is "FUNC "
    %is_fn = CALL str_starts_with %src_buf %start %p_func
    %not_fn = EQ bool %is_fn %false_b
    BR_IF %not_fn check_syscall

    %fn_near_chk = ADD i64 %start 16
    %fn_near = GT i64 %fn_near_chk %bytes_read
    BR_IF %fn_near advance_pos

    %fn_name_p = ADD i64 %start 5
    %is_fn_main = CALL str_starts_with %src_buf %fn_name_p %p_main
    %not_fn_main = EQ bool %is_fn_main %false_b
    BR_IF %not_fn_main setup_helper_fn

    # It is FUNC main:
    %t_im = CONST bool true
    %in_main = MOV %t_im
    %zero_vc_m = CONST i64 0
    %var_count = MOV %zero_vc_m
    %main_offset = MOV %cur_code_pos
    %c_pro_m = CALL emit_func_prologue %elf_buf %cur_code_pos
    %cur_code_pos = MOV %c_pro_m

    # Check if main has parameters (e.g. FUNC main(argc: i64, argv1: i64))
    %c_40_lp_m = CONST i64 40
    %fn_lp_m = CALL find_char_from %src_buf %fn_name_p %c_40_lp_m
    %c_41_rp_m = CONST i64 41
    %fn_rp_m = CALL find_char_from %src_buf %fn_lp_m %c_41_rp_m
    %no_pm_m = GTE i64 %fn_lp_m %fn_rp_m
    BR_IF %no_pm_m main_p_done

    %pm0_raw = ADD i64 %fn_lp_m 1
    %pm0_start = CALL skip_whitespace %src_buf %pm0_raw
    %pm0_empty = GTE i64 %pm0_start %fn_rp_m
    BR_IF %pm0_empty main_p_done

    # Param 0: argc -> [rbp + 8]
    %c_col_m = CONST i64 58
    %pm0_col = CALL find_char_from %src_buf %pm0_start %c_col_m
    %dummy_pm0 = CALL copy_label_name %src_buf %pm0_start %pm0_col %lbl_tmp
    %pm0_p1 = LOAD64 %lbl_tmp_ptr 0
    %pm0_p2 = LOAD64 %lbl_tmp_ptr 8
    %slot_pm0 = CALL find_or_add_var %var_table %var_count %pm0_p1 %pm0_p2
    %next_vcm0 = ADD i64 %var_count 1
    %var_count = MOV %next_vcm0
    %c_pm1 = CALL emit_mov_rax_rbp_disp8 %elf_buf %cur_code_pos 8
    %c_pm2 = CALL emit_store_stack %elf_buf %c_pm1 0 %slot_pm0
    %cur_code_pos = MOV %c_pm2

    # Check Param 1: argv1 -> [rbp + 24]
    %c_comma_m = CONST i64 44
    %pm1_comma = CALL find_char_from %src_buf %pm0_col %c_comma_m
    %no_pm1 = GTE i64 %pm1_comma %fn_rp_m
    BR_IF %no_pm1 main_p_done

    %pm1_raw = ADD i64 %pm1_comma 1
    %pm1_start = CALL skip_whitespace %src_buf %pm1_raw
    %pm1_col = CALL find_char_from %src_buf %pm1_start %c_col_m
    %dummy_pm1 = CALL copy_label_name %src_buf %pm1_start %pm1_col %lbl_tmp
    %pm1_p1 = LOAD64 %lbl_tmp_ptr 0
    %pm1_p2 = LOAD64 %lbl_tmp_ptr 8
    %slot_pm1 = CALL find_or_add_var %var_table %var_count %pm1_p1 %pm1_p2
    %next_vcm1 = ADD i64 %var_count 1
    %var_count = MOV %next_vcm1
    %c_pm3 = CALL emit_mov_rax_rbp_disp8 %elf_buf %cur_code_pos 24
    %c_pm4 = CALL emit_store_stack %elf_buf %c_pm3 0 %slot_pm1
    %cur_code_pos = MOV %c_pm4

    LABEL main_p_done
    %t_fn_m = CONST bool true
    %has_dyn_code = MOV %t_fn_m
    JUMP advance_pos

    LABEL setup_helper_fn
    # It is a helper function:
    %f_im = CONST bool false
    %in_main = MOV %f_im
    %zero_vc_h = CONST i64 0
    %var_count = MOV %zero_vc_h

    # Record function entry point into symbol table (%lbl_ptr)
    %dummy_fn_def = CALL copy_label_name %src_buf %fn_name_p %nl %lbl_tmp
    %fn_def_p1 = LOAD64 %lbl_tmp_ptr 0
    %fn_def_p2 = LOAD64 %lbl_tmp_ptr 8

    %max_lbl_lim_f = CONST i64 800
    %lbl_ovf_f = GTE i64 %lbl_count %max_lbl_lim_f
    BR_IF %lbl_ovf_f do_fn_prologue

    %c_24_f = CONST i64 24
    %lf_entry = MUL i64 %lbl_count %c_24_f
    STORE64 %lbl_ptr %lf_entry %fn_def_p1
    %lf_e8 = ADD i64 %lf_entry 8
    STORE64 %lbl_ptr %lf_e8 %fn_def_p2
    %lf_e16 = ADD i64 %lf_entry 16
    STORE64 %lbl_ptr %lf_e16 %cur_code_pos
    %next_lbl_cnt_f = ADD i64 %lbl_count 1
    %lbl_count = MOV %next_lbl_cnt_f

    LABEL do_fn_prologue
    %c_pro = CALL emit_func_prologue %elf_buf %cur_code_pos
    %cur_code_pos = MOV %c_pro

    # Parse and bind function parameters from src_buf into stack slots
    %c_40_lp = CONST i64 40
    %fn_lp = CALL find_char_from %src_buf %fn_name_p %c_40_lp
    %c_41_rp = CONST i64 41
    %fn_rp = CALL find_char_from %src_buf %fn_lp %c_41_rp
    %has_no_params = GTE i64 %fn_lp %fn_rp
    BR_IF %has_no_params fn_params_done

    %p0_raw = ADD i64 %fn_lp 1
    %p0_start = CALL skip_whitespace %src_buf %p0_raw
    %p0_empty = GTE i64 %p0_start %fn_rp
    BR_IF %p0_empty fn_params_done

    # Param 0 (rdi = 7)
    %c_58_col = CONST i64 58
    %p0_colon = CALL find_char_from %src_buf %p0_start %c_58_col
    %dummy_p0 = CALL copy_label_name %src_buf %p0_start %p0_colon %lbl_tmp
    %p0_p1 = LOAD64 %lbl_tmp_ptr 0
    %p0_p2 = LOAD64 %lbl_tmp_ptr 8
    %slot_p0 = CALL find_or_add_var %var_table %var_count %p0_p1 %p0_p2
    %next_vc0 = ADD i64 %var_count 1
    %var_count = MOV %next_vc0
    %c_st_p0 = CALL emit_store_stack %elf_buf %cur_code_pos 7 %slot_p0
    %cur_code_pos = MOV %c_st_p0

    # Check for Param 1 (rsi = 6)
    %c_44_com = CONST i64 44
    %com1 = CALL find_char_from %src_buf %p0_colon %c_44_com
    %has_com1 = LT i64 %com1 %fn_rp
    %not_has_com1 = EQ bool %has_com1 %false_b
    BR_IF %not_has_com1 fn_params_done

    %p1_raw = ADD i64 %com1 1
    %p1_start = CALL skip_whitespace %src_buf %p1_raw
    %p1_colon = CALL find_char_from %src_buf %p1_start %c_58_col
    %dummy_p1 = CALL copy_label_name %src_buf %p1_start %p1_colon %lbl_tmp
    %p1_p1 = LOAD64 %lbl_tmp_ptr 0
    %p1_p2 = LOAD64 %lbl_tmp_ptr 8
    %slot_p1 = CALL find_or_add_var %var_table %var_count %p1_p1 %p1_p2
    %next_vc1 = ADD i64 %var_count 1
    %var_count = MOV %next_vc1
    %c_st_p1 = CALL emit_store_stack %elf_buf %cur_code_pos 6 %slot_p1
    %cur_code_pos = MOV %c_st_p1

    # Check for Param 2 (rdx = 2)
    %com2 = CALL find_char_from %src_buf %p1_colon %c_44_com
    %has_com2 = LT i64 %com2 %fn_rp
    %not_has_com2 = EQ bool %has_com2 %false_b
    BR_IF %not_has_com2 fn_params_done

    %p2_raw = ADD i64 %com2 1
    %p2_start = CALL skip_whitespace %src_buf %p2_raw
    %p2_colon = CALL find_char_from %src_buf %p2_start %c_58_col
    %dummy_p2 = CALL copy_label_name %src_buf %p2_start %p2_colon %lbl_tmp
    %p2_p1 = LOAD64 %lbl_tmp_ptr 0
    %p2_p2 = LOAD64 %lbl_tmp_ptr 8
    %slot_p2 = CALL find_or_add_var %var_table %var_count %p2_p1 %p2_p2
    %next_vc2 = ADD i64 %var_count 1
    %var_count = MOV %next_vc2
    %c_st_p2 = CALL emit_store_stack %elf_buf %cur_code_pos 2 %slot_p2
    %cur_code_pos = MOV %c_st_p2

    # Check for Param 3 (rcx = 1)
    %com3 = CALL find_char_from %src_buf %p2_colon %c_44_com
    %has_com3 = LT i64 %com3 %fn_rp
    %not_has_com3 = EQ bool %has_com3 %false_b
    BR_IF %not_has_com3 fn_params_done

    %p3_raw = ADD i64 %com3 1
    %p3_start = CALL skip_whitespace %src_buf %p3_raw
    %p3_colon = CALL find_char_from %src_buf %p3_start %c_58_col
    %dummy_p3 = CALL copy_label_name %src_buf %p3_start %p3_colon %lbl_tmp
    %p3_p1 = LOAD64 %lbl_tmp_ptr 0
    %p3_p2 = LOAD64 %lbl_tmp_ptr 8
    %slot_p3 = CALL find_or_add_var %var_table %var_count %p3_p1 %p3_p2
    %next_vc3 = ADD i64 %var_count 1
    %var_count = MOV %next_vc3
    %c_st_p3 = CALL emit_store_stack %elf_buf %cur_code_pos 1 %slot_p3
    %cur_code_pos = MOV %c_st_p3

    LABEL fn_params_done
    %t_fn = CONST bool true
    %has_dyn_code = MOV %t_fn
    JUMP advance_pos

    LABEL check_syscall
    # Check if line is "SYSCALL"
    %is_sys = CALL str_starts_with %src_buf %start %p_sys
    %not_sys = EQ bool %is_sys %false_b
    BR_IF %not_sys check_store8

    %next_pos_sys = CALL emit_syscall_inst %elf_buf %cur_code_pos
    %cur_code_pos = MOV %next_pos_sys
    %t_flag_sys = CONST bool true
    %has_dyn_code = MOV %t_flag_sys
    JUMP advance_pos

    LABEL check_store8
    # Check if line is "STORE8 "
    %is_s8 = CALL str_starts_with %src_buf %start %p_s8
    %not_s8 = EQ bool %is_s8 %false_b
    BR_IF %not_s8 check_store64

    %s8_near_chk = ADD i64 %start 16
    %s8_near = GT i64 %s8_near_chk %bytes_read
    BR_IF %s8_near advance_pos

    %ptr_s8_p = ADD i64 %start 7
    %is_ps8_n = CALL is_named_var %src_buf %ptr_s8_p
    %not_ps8_n = EQ bool %is_ps8_n %false_b
    BR_IF %not_ps8_n s8_phys_ptr

    %sp_s8_1 = CALL find_char_from %src_buf %ptr_s8_p %sp_c
    %dummy_ps8 = CALL copy_label_name %src_buf %ptr_s8_p %sp_s8_1 %lbl_tmp
    %ps8_p1 = LOAD64 %lbl_tmp_ptr 0
    %ps8_p2 = LOAD64 %lbl_tmp_ptr 8
    %ps8_slot = CALL find_or_add_var %var_table %var_count %ps8_p1 %ps8_p2
    %cs0 = CALL emit_load_stack %elf_buf %cur_code_pos 0 %ps8_slot
    JUMP s8_parse_offset

    LABEL s8_phys_ptr
    %ptr_s8_r = CALL parse_reg_id %src_buf %ptr_s8_p
    %cs0 = CALL emit_mov_rr %elf_buf %cur_code_pos 0 %ptr_s8_r
    %sp_s8_1 = CALL find_char_from %src_buf %ptr_s8_p %sp_c

    LABEL s8_parse_offset
    %off_s8_p = CALL skip_whitespace %src_buf %sp_s8_1
    %off_s8_chk = ADD i64 %off_s8_p 4
    %off_s8_near = GT i64 %off_s8_chk %bytes_read
    BR_IF %off_s8_near advance_pos

    %is_os8_n = CALL is_named_var %src_buf %off_s8_p
    %not_os8_n = EQ bool %is_os8_n %false_b
    BR_IF %not_os8_n check_s8_phys_off

    %sp_s8_2 = CALL find_char_from %src_buf %off_s8_p %sp_c
    %dummy_os8 = CALL copy_label_name %src_buf %off_s8_p %sp_s8_2 %lbl_tmp
    %os8_p1 = LOAD64 %lbl_tmp_ptr 0
    %os8_p2 = LOAD64 %lbl_tmp_ptr 8
    %os8_slot = CALL find_or_add_var %var_table %var_count %os8_p1 %os8_p2
    %cs1 = CALL emit_load_stack %elf_buf %cs0 1 %os8_slot
    JUMP s8_parse_val

    LABEL check_s8_phys_off
    %c_off_s8 = LOAD8 %src_raw_ptr %off_s8_p
    %is_off_s8_r = EQ i64 %c_off_s8 %c_pct_val
    %not_off_s8_r = EQ bool %is_off_s8_r %false_b
    BR_IF %not_off_s8_r s8_imm_off

    LABEL s8_phys_off
    %off_s8_r = CALL parse_reg_id %src_buf %off_s8_p
    %cs1 = CALL emit_mov_rr %elf_buf %cs0 1 %off_s8_r
    JUMP s8_parse_val

    LABEL s8_imm_off
    %sp_s8_2 = CALL find_char_from %src_buf %off_s8_p %sp_c
    %off_s8_imm = CALL parse_int_from %src_buf %off_s8_p %sp_s8_2
    %cs1 = CALL emit_mov_imm %elf_buf %cs0 1 %off_s8_imm

    LABEL s8_parse_val
    %sp_s8_3 = CALL find_char_from %src_buf %off_s8_p %sp_c
    %val_s8_p = CALL skip_whitespace %src_buf %sp_s8_3
    %val_s8_chk = ADD i64 %val_s8_p 4
    %val_s8_near = GT i64 %val_s8_chk %bytes_read
    BR_IF %val_s8_near advance_pos

    %is_vs8_n = CALL is_named_var %src_buf %val_s8_p
    %not_vs8_n = EQ bool %is_vs8_n %false_b
    BR_IF %not_vs8_n check_s8_phys_val

    %dummy_vs8 = CALL copy_label_name %src_buf %val_s8_p %nl %lbl_tmp
    %vs8_p1 = LOAD64 %lbl_tmp_ptr 0
    %vs8_p2 = LOAD64 %lbl_tmp_ptr 8
    %vs8_slot = CALL find_or_add_var %var_table %var_count %vs8_p1 %vs8_p2
    %cs2 = CALL emit_load_stack %elf_buf %cs1 2 %vs8_slot
    JUMP s8_emit_store

    LABEL check_s8_phys_val
    %c_val_s8 = LOAD8 %src_raw_ptr %val_s8_p
    %is_val_s8_r = EQ i64 %c_val_s8 %c_pct_val
    %not_val_s8_r = EQ bool %is_val_s8_r %false_b
    BR_IF %not_val_s8_r s8_imm_val

    LABEL s8_phys_val
    %val_s8_r = CALL parse_reg_id %src_buf %val_s8_p
    %cs2 = CALL emit_mov_rr %elf_buf %cs1 2 %val_s8_r
    JUMP s8_emit_store

    LABEL s8_imm_val
    %val_s8_imm = CALL parse_int_from %src_buf %val_s8_p %nl
    %cs2 = CALL emit_mov_imm %elf_buf %cs1 2 %val_s8_imm

    LABEL s8_emit_store
    %cs4 = CALL emit_store8_idx %elf_buf %cs2
    %cur_code_pos = MOV %cs4
    %t_s8 = CONST bool true
    %has_dyn_code = MOV %t_s8
    JUMP advance_pos

    LABEL check_store64
    # Check if line is "STORE64 "
    %is_s64 = CALL str_starts_with %src_buf %start %p_s64
    %not_s64 = EQ bool %is_s64 %false_b
    BR_IF %not_s64 check_store

    %s64_near_chk = ADD i64 %start 16
    %s64_near = GT i64 %s64_near_chk %bytes_read
    BR_IF %s64_near advance_pos

    %ptr_s64_p = ADD i64 %start 8
    %is_ps64_n = CALL is_named_var %src_buf %ptr_s64_p
    %not_ps64_n = EQ bool %is_ps64_n %false_b
    BR_IF %not_ps64_n s64_phys_ptr

    %sp_s64_1 = CALL find_char_from %src_buf %ptr_s64_p %sp_c
    %dummy_ps64 = CALL copy_label_name %src_buf %ptr_s64_p %sp_s64_1 %lbl_tmp
    %ps64_p1 = LOAD64 %lbl_tmp_ptr 0
    %ps64_p2 = LOAD64 %lbl_tmp_ptr 8
    %ps64_slot = CALL find_or_add_var %var_table %var_count %ps64_p1 %ps64_p2
    %cs64_0 = CALL emit_load_stack %elf_buf %cur_code_pos 0 %ps64_slot
    JUMP s64_parse_offset

    LABEL s64_phys_ptr
    %ptr_s64_r = CALL parse_reg_id %src_buf %ptr_s64_p
    %cs64_0 = CALL emit_mov_rr %elf_buf %cur_code_pos 0 %ptr_s64_r
    %sp_s64_1 = CALL find_char_from %src_buf %ptr_s64_p %sp_c

    LABEL s64_parse_offset
    %off_s64_p = CALL skip_whitespace %src_buf %sp_s64_1
    %off_s64_chk = ADD i64 %off_s64_p 4
    %off_s64_near = GT i64 %off_s64_chk %bytes_read
    BR_IF %off_s64_near advance_pos

    %is_os64_n = CALL is_named_var %src_buf %off_s64_p
    %not_os64_n = EQ bool %is_os64_n %false_b
    BR_IF %not_os64_n check_s64_phys_off

    %sp_s64_2 = CALL find_char_from %src_buf %off_s64_p %sp_c
    %dummy_os64 = CALL copy_label_name %src_buf %off_s64_p %sp_s64_2 %lbl_tmp
    %os64_p1 = LOAD64 %lbl_tmp_ptr 0
    %os64_p2 = LOAD64 %lbl_tmp_ptr 8
    %os64_slot = CALL find_or_add_var %var_table %var_count %os64_p1 %os64_p2
    %cs64_1 = CALL emit_load_stack %elf_buf %cs64_0 1 %os64_slot
    JUMP s64_parse_val

    LABEL check_s64_phys_off
    %c_off_s64 = LOAD8 %src_raw_ptr %off_s64_p
    %is_off_s64_r = EQ i64 %c_off_s64 %c_pct_val
    %not_off_s64_r = EQ bool %is_off_s64_r %false_b
    BR_IF %not_off_s64_r s64_imm_off

    LABEL s64_phys_off
    %off_s64_r = CALL parse_reg_id %src_buf %off_s64_p
    %cs64_1 = CALL emit_mov_rr %elf_buf %cs64_0 1 %off_s64_r
    JUMP s64_parse_val

    LABEL s64_imm_off
    %sp_s64_2 = CALL find_char_from %src_buf %off_s64_p %sp_c
    %off_s64_imm = CALL parse_int_from %src_buf %off_s64_p %sp_s64_2
    %cs64_1 = CALL emit_mov_imm %elf_buf %cs64_0 1 %off_s64_imm

    LABEL s64_parse_val
    %sp_s64_3 = CALL find_char_from %src_buf %off_s64_p %sp_c
    %val_s64_p = CALL skip_whitespace %src_buf %sp_s64_3
    %val_s64_chk = ADD i64 %val_s64_p 4
    %val_s64_near = GT i64 %val_s64_chk %bytes_read
    BR_IF %val_s64_near advance_pos

    %is_vs64_n = CALL is_named_var %src_buf %val_s64_p
    %not_vs64_n = EQ bool %is_vs64_n %false_b
    BR_IF %not_vs64_n check_s64_phys_val

    %dummy_vs64 = CALL copy_label_name %src_buf %val_s64_p %nl %lbl_tmp
    %vs64_p1 = LOAD64 %lbl_tmp_ptr 0
    %vs64_p2 = LOAD64 %lbl_tmp_ptr 8
    %vs64_slot = CALL find_or_add_var %var_table %var_count %vs64_p1 %vs64_p2
    %cs64_2 = CALL emit_load_stack %elf_buf %cs64_1 2 %vs64_slot
    JUMP s64_emit_store

    LABEL check_s64_phys_val
    %c_val_s64 = LOAD8 %src_raw_ptr %val_s64_p
    %is_val_s64_r = EQ i64 %c_val_s64 %c_pct_val
    %not_val_s64_r = EQ bool %is_val_s64_r %false_b
    BR_IF %not_val_s64_r s64_imm_val

    LABEL s64_phys_val
    %val_s64_r = CALL parse_reg_id %src_buf %val_s64_p
    %cs64_2 = CALL emit_mov_rr %elf_buf %cs64_1 2 %val_s64_r
    JUMP s64_emit_store

    LABEL s64_imm_val
    %val_s64_imm = CALL parse_int_from %src_buf %val_s64_p %nl
    %cs64_2 = CALL emit_mov_imm %elf_buf %cs64_1 2 %val_s64_imm

    LABEL s64_emit_store
    %cs64_4 = CALL emit_store64_idx %elf_buf %cs64_2
    %cur_code_pos = MOV %cs64_4
    %t_s64 = CONST bool true
    %has_dyn_code = MOV %t_s64
    JUMP advance_pos

    LABEL check_store
    # 3. Check if line has STORE_STR
    %is_store = CALL str_starts_with %src_buf %start %p_store
    %not_store = EQ bool %is_store %false_b
    BR_IF %not_store check_label

    # Find first quote (ASCII 34 = '"')
    %quote_char = CONST i64 34
    %q1 = CALL find_char_from %src_buf %start %quote_char
    %no_q1 = GTE i64 %q1 %nl
    BR_IF %no_q1 advance_pos

    # Find closing quote
    %q1_plus_1 = ADD i64 %q1 1
    %q2 = CALL find_char_from %src_buf %q1_plus_1 %quote_char
    %no_q2 = GTE i64 %q2 %nl
    BR_IF %no_q2 advance_pos

    # Parse destination variable name between 'STORE_STR ' (start + 9) and q1
    %c_9_st = CONST i64 9
    %st_vn_raw = ADD i64 %start %c_9_st
    %st_vn_start = CALL skip_whitespace %src_buf %st_vn_raw
    %dummy_st_vn = CALL copy_label_name %src_buf %st_vn_start %q1 %lbl_tmp
    %st_vn_p1 = LOAD64 %lbl_tmp_ptr 0
    %st_vn_p2 = LOAD64 %lbl_tmp_ptr 8
    %st_vn_slot = CALL find_or_add_var %var_table %var_count %st_vn_p1 %st_vn_p2

    # Unescape string into str_tmp buffer
    %zero_st = CONST i64 0
    %copied = CALL copy_str_unescaped %src_raw_ptr %q1_plus_1 %q2 %str_tmp_ptr

    # Bounds check on string length: 0 <= copied <= 128
    %c_128_st = CONST i64 128
    %st_too_long = GT i64 %copied %c_128_st
    BR_IF %st_too_long advance_pos
    %st_neg = LT i64 %copied %zero_st
    BR_IF %st_neg advance_pos

    # Emit code: mov rdi, [rbp - st_vn_slot]
    %c_st0 = CALL emit_load_stack %elf_buf %cur_code_pos 7 %st_vn_slot

    # Emit instructions storing each byte into [rdi + offset]
    %c_st1 = CALL emit_str_bytes %elf_buf %c_st0 %str_tmp %copied
    %cur_code_pos = MOV %c_st1
    %t_store = CONST bool true
    %has_dyn_code = MOV %t_store
    JUMP advance_pos

    LABEL check_label
    # Check if line is "LABEL "
    %is_lbl = CALL str_starts_with %src_buf %start %p_label
    %not_lbl = EQ bool %is_lbl %false_b
    BR_IF %not_lbl check_jump

    %name_p_l = ADD i64 %start 6
    %nl_too_short_l = LT i64 %nl %name_p_l
    BR_IF %nl_too_short_l advance_pos

    %dummy_l = CALL copy_label_name %src_buf %name_p_l %nl %lbl_tmp
    %part1_l = LOAD64 %lbl_tmp_ptr 0
    %part2_l = LOAD64 %lbl_tmp_ptr 8

    # Check lbl_count bounds (0..800)
    %max_lbl_lim = CONST i64 800
    %lbl_ovf = GTE i64 %lbl_count %max_lbl_lim
    BR_IF %lbl_ovf advance_pos

    %c_24 = CONST i64 24
    %l_entry = MUL i64 %lbl_count %c_24
    STORE64 %lbl_ptr %l_entry %part1_l
    %l_e8 = ADD i64 %l_entry 8
    STORE64 %lbl_ptr %l_e8 %part2_l
    %l_e16 = ADD i64 %l_entry 16
    STORE64 %lbl_ptr %l_e16 %cur_code_pos
    %next_lbl_cnt = ADD i64 %lbl_count 1
    %lbl_count = MOV %next_lbl_cnt
    JUMP advance_pos

    LABEL check_jump
    # Check if line is "JUMP "
    %is_jmp = CALL str_starts_with %src_buf %start %p_jump
    %not_jmp = EQ bool %is_jmp %false_b
    BR_IF %not_jmp check_brif

    %name_p_j = ADD i64 %start 5
    %nl_too_short_j = LT i64 %nl %name_p_j
    BR_IF %nl_too_short_j advance_pos

    %dummy_j = CALL copy_label_name %src_buf %name_p_j %nl %lbl_tmp
    %part1_j = LOAD64 %lbl_tmp_ptr 0
    %part2_j = LOAD64 %lbl_tmp_ptr 8

    # Check fix_count bounds (0..1200)
    %max_fix_lim = CONST i64 1200
    %fix_ovf_j = GTE i64 %fix_count %max_fix_lim
    BR_IF %fix_ovf_j advance_pos

    %next_code_j = CALL emit_jmp_rel32 %elf_buf %cur_code_pos 0
    %disp_pos_j = ADD i64 %cur_code_pos 1

    %c_24_j = CONST i64 24
    %f_entry_j = MUL i64 %fix_count %c_24_j
    STORE64 %fix_ptr %f_entry_j %disp_pos_j
    %fj_e8 = ADD i64 %f_entry_j 8
    STORE64 %fix_ptr %fj_e8 %part1_j
    %fj_e16 = ADD i64 %f_entry_j 16
    STORE64 %fix_ptr %fj_e16 %part2_j
    %next_fix_cnt_j = ADD i64 %fix_count 1
    %fix_count = MOV %next_fix_cnt_j
    %cur_code_pos = MOV %next_code_j
    %t_jmp = CONST bool true
    %has_dyn_code = MOV %t_jmp
    JUMP advance_pos

    LABEL check_brif
    # Check if line is "BR_IF "
    %is_br = CALL str_starts_with %src_buf %start %p_brif
    %not_br = EQ bool %is_br %false_b
    BR_IF %not_br check_loop

    %cond_p_br = ADD i64 %start 6
    %cond_chk_br = ADD i64 %cond_p_br 4
    %near_cond_br = GT i64 %cond_chk_br %bytes_read
    BR_IF %near_cond_br advance_pos

    # Check if condition is named variable or physical register
    %is_cond_named = CALL is_named_var %src_buf %cond_p_br
    %not_cn = EQ bool %is_cond_named %false_b
    BR_IF %not_cn test_cond_phys

    %dummy_cn = CALL copy_label_name %src_buf %cond_p_br %nl %lbl_tmp
    %cn_p1 = LOAD64 %lbl_tmp_ptr 0
    %cn_p2 = LOAD64 %lbl_tmp_ptr 8
    %cn_slot = CALL find_or_add_var %var_table %var_count %cn_p1 %cn_p2
    # Load into rax (0), test rax, rax
    %c_load_cn = CALL emit_load_stack %elf_buf %cur_code_pos 0 %cn_slot
    %c_test_br = CALL emit_test_rr %elf_buf %c_load_cn 0
    JUMP find_br_target

    LABEL test_cond_phys
    %cond_r_br = CALL parse_reg_id %src_buf %cond_p_br
    %c_test_br = CALL emit_test_rr %elf_buf %cur_code_pos %cond_r_br

    LABEL find_br_target
    %sp_br = CALL find_char_from %src_buf %cond_p_br %sp_c
    %name_p_br = CALL skip_whitespace %src_buf %sp_br
    %nl_too_short_br = LT i64 %nl %name_p_br
    BR_IF %nl_too_short_br advance_pos

    %dummy_br = CALL copy_label_name %src_buf %name_p_br %nl %lbl_tmp
    %part1_br = LOAD64 %lbl_tmp_ptr 0
    %part2_br = LOAD64 %lbl_tmp_ptr 8

    # Check fix_count bounds (0..1200)
    %max_fix_lim2 = CONST i64 1200
    %fix_ovf_br = GTE i64 %fix_count %max_fix_lim2
    BR_IF %fix_ovf_br advance_pos

    %next_code_br = CALL emit_jnz_rel32 %elf_buf %c_test_br 0
    %disp_pos_br = ADD i64 %c_test_br 2

    %c_24_br = CONST i64 24
    %fb_entry = MUL i64 %fix_count %c_24_br
    STORE64 %fix_ptr %fb_entry %disp_pos_br
    %fb_e8 = ADD i64 %fb_entry 8
    STORE64 %fix_ptr %fb_e8 %part1_br
    %fb_e16 = ADD i64 %fb_entry 16
    STORE64 %fix_ptr %fb_e16 %part2_br
    %next_fix_cnt_br = ADD i64 %fix_count 1
    %fix_count = MOV %next_fix_cnt_br
    %cur_code_pos = MOV %next_code_br
    %t_br = CONST bool true
    %has_dyn_code = MOV %t_br
    JUMP advance_pos

    LABEL check_loop
    # Check if line is "LOOP "
    %is_lp_stmt = CALL str_starts_with %src_buf %start %p_loop
    %not_lp_stmt = EQ bool %is_lp_stmt %false_b
    BR_IF %not_lp_stmt check_break

    %name_p_lp = ADD i64 %start 5
    %nl_too_short_lp = LT i64 %nl %name_p_lp
    BR_IF %nl_too_short_lp advance_pos

    %dummy_lp = CALL copy_label_name %src_buf %name_p_lp %nl %lbl_tmp
    %part1_lp = LOAD64 %lbl_tmp_ptr 0
    %part2_lp = LOAD64 %lbl_tmp_ptr 8

    # Check lbl_count bounds (0..800)
    %max_lbl_lim_lp = CONST i64 800
    %lbl_ovf_lp = GTE i64 %lbl_count %max_lbl_lim_lp
    BR_IF %lbl_ovf_lp advance_pos

    # Record loop header as label targeting cur_code_pos
    %c_24_lp = CONST i64 24
    %llp_entry = MUL i64 %lbl_count %c_24_lp
    STORE64 %lbl_ptr %llp_entry %part1_lp
    %llp_e8 = ADD i64 %llp_entry 8
    STORE64 %lbl_ptr %llp_e8 %part2_lp
    %llp_e16 = ADD i64 %llp_entry 16
    STORE64 %lbl_ptr %llp_e16 %cur_code_pos
    %next_lbl_cnt_lp = ADD i64 %lbl_count 1
    %lbl_count = MOV %next_lbl_cnt_lp

    # Track active loop name and end label (end label = part1 + 1000000000)
    %cur_loop_p1 = MOV %part1_lp
    %cur_loop_p2 = MOV %part2_lp
    %c_end_bias = CONST i64 1000000000
    %cur_loop_end_p1 = ADD i64 %part1_lp %c_end_bias
    JUMP advance_pos

    LABEL check_break
    # Check if line is "BREAK_IF "
    %is_bk_stmt = CALL str_starts_with %src_buf %start %p_break
    %not_bk_stmt = EQ bool %is_bk_stmt %false_b
    BR_IF %not_bk_stmt check_endloop

    %cond_p_bk = ADD i64 %start 9
    %cond_chk_bk = ADD i64 %cond_p_bk 4
    %near_cond_bk = GT i64 %cond_chk_bk %bytes_read
    BR_IF %near_cond_bk advance_pos

    # Check if condition is named variable or physical register
    %is_cnd_bk_named = CALL is_named_var %src_buf %cond_p_bk
    %not_cbkn = EQ bool %is_cnd_bk_named %false_b
    BR_IF %not_cbkn test_cond_bk_phys

    %dummy_cbkn = CALL copy_label_name %src_buf %cond_p_bk %nl %lbl_tmp
    %cbkn_p1 = LOAD64 %lbl_tmp_ptr 0
    %cbkn_p2 = LOAD64 %lbl_tmp_ptr 8
    %cbkn_slot = CALL find_or_add_var %var_table %var_count %cbkn_p1 %cbkn_p2
    # Load into rax (0), test rax, rax
    %c_load_cbk = CALL emit_load_stack %elf_buf %cur_code_pos 0 %cbkn_slot
    %c_test_bk = CALL emit_test_rr %elf_buf %c_load_cbk 0
    JUMP do_break_jump

    LABEL test_cond_bk_phys
    %cond_r_bk = CALL parse_reg_id %src_buf %cond_p_bk
    %c_test_bk = CALL emit_test_rr %elf_buf %cur_code_pos %cond_r_bk

    LABEL do_break_jump
    # Check fix_count bounds (0..1200)
    %max_fix_lim_bk = CONST i64 1200
    %fix_ovf_bk = GTE i64 %fix_count %max_fix_lim_bk
    BR_IF %fix_ovf_bk advance_pos

    %next_code_bk = CALL emit_jnz_rel32 %elf_buf %c_test_bk 0
    %disp_pos_bk = ADD i64 %c_test_bk 2

    # Record fixup targeting cur_loop_end
    %c_24_bk = CONST i64 24
    %fbk_entry = MUL i64 %fix_count %c_24_bk
    STORE64 %fix_ptr %fbk_entry %disp_pos_bk
    %fbk_e8 = ADD i64 %fbk_entry 8
    STORE64 %fix_ptr %fbk_e8 %cur_loop_end_p1
    %fbk_e16 = ADD i64 %fbk_entry 16
    STORE64 %fix_ptr %fbk_e16 %cur_loop_p2
    %next_fix_cnt_bk = ADD i64 %fix_count 1
    %fix_count = MOV %next_fix_cnt_bk
    %cur_code_pos = MOV %next_code_bk
    %t_bk = CONST bool true
    %has_dyn_code = MOV %t_bk
    JUMP advance_pos

    LABEL check_endloop
    # Check if line is "END_LOOP "
    %is_el_stmt = CALL str_starts_with %src_buf %start %p_endloop
    %not_el_stmt = EQ bool %is_el_stmt %false_b
    BR_IF %not_el_stmt advance_pos

    # 1. Emit jmp rel32 targeting loop header (cur_loop_p1, cur_loop_p2)
    %max_fix_lim_el = CONST i64 1200
    %fix_ovf_el = GTE i64 %fix_count %max_fix_lim_el
    BR_IF %fix_ovf_el advance_pos

    %next_code_el = CALL emit_jmp_rel32 %elf_buf %cur_code_pos 0
    %disp_pos_el = ADD i64 %cur_code_pos 1

    %c_24_el = CONST i64 24
    %fel_entry = MUL i64 %fix_count %c_24_el
    STORE64 %fix_ptr %fel_entry %disp_pos_el
    %fel_e8 = ADD i64 %fel_entry 8
    STORE64 %fix_ptr %fel_e8 %cur_loop_p1
    %fel_e16 = ADD i64 %fel_entry 16
    STORE64 %fix_ptr %fel_e16 %cur_loop_p2
    %next_fix_cnt_el = ADD i64 %fix_count 1
    %fix_count = MOV %next_fix_cnt_el
    %cur_code_pos = MOV %next_code_el

    # 2. Record loop exit point as label cur_loop_end targeting new cur_code_pos
    %max_lbl_lim_el = CONST i64 800
    %lbl_ovf_el = GTE i64 %lbl_count %max_lbl_lim_el
    BR_IF %lbl_ovf_el advance_pos

    %lel_entry = MUL i64 %lbl_count %c_24_el
    STORE64 %lbl_ptr %lel_entry %cur_loop_end_p1
    %lel_e8 = ADD i64 %lel_entry 8
    STORE64 %lbl_ptr %lel_e8 %cur_loop_p2
    %lel_e16 = ADD i64 %lbl_count %c_24_el
    %lel_e16_off = ADD i64 %lel_entry 16
    STORE64 %lbl_ptr %lel_e16_off %cur_code_pos
    %next_lbl_cnt_el = ADD i64 %lbl_count 1
    %lbl_count = MOV %next_lbl_cnt_el
    %t_el = CONST bool true
    %has_dyn_code = MOV %t_el
    JUMP advance_pos

    LABEL advance_pos

    # Advance to next line (after \n)
    %one = CONST i64 1
    %next_pos = ADD i64 %nl %one
    %pos = MOV %next_pos
  END_LOOP parse_file_loop

  # Resolve all jump and branch fixups
  %res_fix = CALL resolve_jump_fixups %elf_buf %tables %fix_count %lbl_count
  %zero_chk_rf = CONST i64 0
  %has_fix_err = GT i64 %res_fix %zero_chk_rf
  %err_fix_code = CONST i64 2
  RET_IF %has_fix_err %err_fix_code

  # 1. Check if we emitted dynamic instructions
  %false_dyn = CONST bool false
  %not_dyn = EQ bool %has_dyn_code %false_dyn
  BR_IF %not_dyn check_str_or_plain

  # Emit dynamic ELF binary
  %c_120 = CONST i64 120
  %dyn_code_len = SUB i64 %cur_code_pos %c_120
  %hdr_dyn = CALL emit_elf_header %elf_buf %dyn_code_len %main_offset
  %res_dyn = CALL fs_write_file_bytes out_path %elf_buf %cur_code_pos
  %zero_ok = CONST i64 0
  %is_write_err = LT i64 %res_dyn %zero_ok
  RET_IF %is_write_err %res_dyn
  RET %zero_ok

  LABEL check_str_or_plain
  # Ensure exit code is valid u8 (0..255)
  %c_255 = CONST i64 255
  %exit_too_high = GT i64 %parsed_exit %c_255
  %err_code = CONST i64 1
  RET_IF %exit_too_high %err_code
  %exit_neg = LT i64 %parsed_exit %zero
  RET_IF %exit_neg %err_code

  # Check if we emit string print or plain exit
  %false_flag = CONST bool false
  %no_str = EQ bool %has_string %false_flag
  BR_IF %no_str emit_plain_exit

  # Bounded string check (0..500)
  %max_str = CONST i64 500
  %str_too_big = GT i64 %str_len %max_str
  RET_IF %str_too_big %err_code
  %str_neg = LT i64 %str_len %zero
  RET_IF %str_neg %err_code

  # Emit ELF header for print + exit
  # Payload = 56 bytes machine code + str_len bytes data
  %c_120_def = CONST i64 120
  %code_payload = CONST i64 56
  %total_payload = ADD i64 %code_payload %str_len
  %hdr_len = CALL emit_elf_header %elf_buf %total_payload %c_120_def
  %code_end = CALL emit_print_and_exit %elf_buf %str_len %parsed_exit
  %total_bin_sz = ADD i64 176 %str_len

  # Write exact binary size to disk
  %res1 = CALL fs_write_file_bytes out_path %elf_buf %total_bin_sz
  %is_w1_err = LT i64 %res1 %zero_ok
  RET_IF %is_w1_err %res1
  RET %zero_ok

  LABEL emit_plain_exit
  %c_120_def2 = CONST i64 120
  %code_len = CONST i64 16
  %hdr_len2 = CALL emit_elf_header %elf_buf %code_len %c_120_def2
  %bin_sz = CALL emit_exit_code %elf_buf %parsed_exit
  %exact_sz = CONST i64 136
  %res2 = CALL fs_write_file_bytes out_path %elf_buf %exact_sz
  %is_w2_err = LT i64 %res2 %zero_ok
  RET_IF %is_w2_err %res2
  RET %zero_ok
END_FUNC

# Compiler main entry point
FUNC main(argc: i64, argv1: i64) -> i64
  %false_b = CONST bool false
  %c_2 = CONST i64 2
  %has_arg = GTE i64 argc %c_2
  %no_arg = EQ bool %has_arg %false_b
  BR_IF %no_arg show_usage

  # 1. Copy argv[1] into src_path buffer
  %src_path = ALLOC slice<u8> 128
  %src_len = CALL copy_cstr_to_slice argv1 %src_path

  # 2. Derive out_path by stripping .lit extension
  %out_path = ALLOC slice<u8> 128
  %out_len = CALL derive_out_path %src_path %src_len %out_path

  # 3. Print compiling banner
  %b_msg = ALLOC slice<u8> 64
  STORE_STR %b_msg "🚀 Light Native Compiler compiling source...\n"
  %b_len = SLICE_LEN %b_msg
  %dummy_b = CALL std_print_slice %b_msg %b_len

  # 4. Compile source file to target binary
  %res = CALL compile_file %src_path %out_path

  # Bound check on res: if res != 0, exit with error code res
  %zero = CONST i64 0
  %is_err = NEQ i64 %res %zero
  RET_IF %is_err %res

  # 5. Print success message and return 0
  %s_msg = ALLOC slice<u8> 64
  STORE_STR %s_msg "🎉 Compilation completed successfully!\n"
  %s_len = SLICE_LEN %s_msg
  %dummy_s = CALL std_print_slice %s_msg %s_len

  RET %zero

  LABEL show_usage
  %usage = ALLOC slice<u8> 64
  STORE_STR %usage "Usage: lightc-native <source.lit>\n"
  %u_len = SLICE_LEN %usage
  %dummy_u = CALL std_print_slice %usage %u_len
  %one = CONST i64 1
  RET %one
END_FUNC