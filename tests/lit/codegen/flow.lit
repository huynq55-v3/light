# Vòng lặp, tham số block hoán vị (parallel move có chu trình), gọi hàm, nhiều biến sống (spill)
func t_fib bv64 %0:bv64 {
    @b0
        %1 = const 0 bv64
        %2 = const 1 bv64
        %3 = const 255 bv64
        %4 = and %0 %3
        jmp @b1 %1 %2 %4
    @b1 %5:bv64 %6:bv64 %7:bv64
        %8 = const 0 bv64
        %9 = cmp eq %7 %8
        br %9 @b3 @b2
    @b2
        %10 = add %5 %6
        %11 = const 1 bv64
        %12 = sub %7 %11
        jmp @b1 %6 %10 %12
    @b3
        ret %5
}
func t_swap3 bv64 %0:bv64 %1:bv64 %2:bv64 %3:bv64 {
    @b0
        %20 = const 15 bv64
        %21 = and %3 %20
        jmp @b1 %0 %1 %2 %21
    @b1 %4:bv64 %5:bv64 %6:bv64 %7:bv64
        %8 = const 0 bv64
        %9 = cmp eq %7 %8
        br %9 @b3 @b2
    @b2
        %11 = const 1 bv64
        %12 = sub %7 %11
        %13 = mul %4 %12
        %14 = add %13 %6
        jmp @b1 %6 %14 %5 %12
    @b3
        %15 = mul %4 %20
        %16 = xor %15 %5
        %17 = add %16 %6
        ret %17
}
func t_swapsame bv64 %0:bv64 %1:bv64 {
    @b0
        %20 = const 7 bv64
        %21 = and %1 %20
        jmp @b1 %0 %0 %21
    @b1 %4:bv64 %5:bv64 %7:bv64
        %8 = const 0 bv64
        %9 = cmp eq %7 %8
        br %9 @b3 @b2
    @b2
        %11 = const 1 bv64
        %12 = sub %7 %11
        %13 = add %4 %11
        jmp @b1 %5 %13 %12
    @b3
        %16 = shl %4 %20
        %17 = add %16 %5
        ret %17
}
