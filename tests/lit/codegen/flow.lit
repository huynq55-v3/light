# Vòng lặp lồng nhau, biến sống qua vòng lặp và qua lời gọi trong vòng lặp
func t_nested bv64 %0:bv64 %1:bv64 {
    @b0
        %2 = const 7 bv64
        %3 = and %0 %2
        %4 = and %1 %2
        %5 = const 0 bv64
        jmp @b1 %5 %5
    @b1 %6:bv64 %7:bv64
        %8 = cmp ult %6 %3
        br %8 @b2 @b5
    @b2
        jmp @b3 %5 %7
    @b3 %9:bv64 %10:bv64
        %11 = cmp ult %9 %4
        br %11 @b4 @b6
    @b4
        %12 = mul %6 %9
        %13 = call rec %9
        %14 = add %12 %13
        %15 = add %10 %14
        %16 = add %15 %1
        %17 = const 1 bv64
        %18 = add %9 %17
        jmp @b3 %18 %16
    @b6
        %19 = const 1 bv64
        %20 = add %6 %19
        jmp @b1 %20 %10
    @b5
        %21 = mul %7 %0
        ret %21
}
func t_narrow bv64 %0:bv64 {
    @b0
        %1 = const 0xffff bv64
        %2 = and %0 %1
        %3 = narrow %2 bv16
