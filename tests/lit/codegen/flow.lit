func rec bv64 %0:bv64 {
    @b0
        %1 = const 2 bv64
        %2 = cmp ult %0 %1
        br %2 @b1 @b2
    @b1
        ret %0
    @b2
        %3 = const 1 bv64
        %4 = sub %0 %3
        %5 = call rec %4
        %6 = sub %4 %3
        %7 = call rec %6
        %8 = add %5 %7
        ret %8
}
