layout Q 8 {
    0: bv64
}
# Vòng lặp load/and/add (giống benchmark audit) trên 1M phần tử, lặp 4 lần
func bench_loop bv64 %0:ptr<Q,1048576> {
    @b0
        %1 = const 0 bv64
        jmp @b1 %1 %1 %1
    @b1 %2:bv64 %3:bv64 %30:bv64
        %4 = const 1048576 bv64
        %5 = cmp ult %2 %4
        br %5 @b2 @b3
    @b2
        %6 = slice %0 %2 ptr<Q,1>
        %7 = load %6 0 bv64
        %8 = const 0xff bv64
        %9 = and %7 %8
        %10 = add %3 %9
        %11 = const 1 bv64
        %12 = add %2 %11
        jmp @b1 %12 %10 %30
    @b3
        %13 = const 1 bv64
        %14 = add %30 %13
        %15 = const 4 bv64
        %16 = cmp ult %14 %15
        br %16 @b4 @b5
    @b4
        jmp @b1 %1 %3 %14
    @b5
        ret %3
}
# Nhân ma trận 64x64 (3 vòng lặp lồng nhau)
func bench_matmul bv64 %0:ptr<Q,1048576> {
    @b0
        %1 = const 0 bv64
        %2 = const 64 bv64
        %3 = const 1 bv64
        %4 = const 4096 bv64
        %5 = const 8192 bv64
        jmp @b1 %1
    @b1 %10:bv64
        %11 = cmp ult %10 %2
        br %11 @b2 @b9
    @b2
        jmp @b3 %1
    @b3 %20:bv64
        %21 = cmp ult %20 %2
        br %21 @b4 @b8
    @b4
        jmp @b5 %1 %1
    @b5 %30:bv64 %31:bv64
        %32 = cmp ult %30 %2
        br %32 @b6 @b7
    @b6
        %33 = mul %10 %2
        %34 = add %33 %30
        %35 = slice %0 %34 ptr<Q,1>
        %36 = load %35 0 bv64
        %37 = mul %30 %2
        %38 = add %37 %20
        %39 = add %38 %4
        %40 = slice %0 %39 ptr<Q,1>
        %41 = load %40 0 bv64
        %42 = mul %36 %41
        %43 = add %31 %42
        %44 = add %30 %3
        jmp @b5 %44 %43
    @b7
        %50 = mul %10 %2
        %51 = add %50 %20
        %52 = add %51 %5
        %53 = slice %0 %52 ptr<Q,1>
        store %53 0 %31
        %54 = add %20 %3
        jmp @b3 %54
    @b8
        %60 = add %10 %3
        jmp @b1 %60
    @b9
        %61 = load %0 65536 bv64
        ret %61
}
