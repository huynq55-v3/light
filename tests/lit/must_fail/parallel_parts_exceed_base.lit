# Thay cho ca "sync xóa active_spawns": các phần giao cho worker phải nằm trọn trong vùng gốc
# EXPECT: vượt kích thước
layout Q 8 {
    0: bv64
}
func wk void %0:ptr<Q,4> %1:bv64 %2:bv64 {
    @b0
        ret
}
func f void %0:smp %1:ptr<Q,16> {
    @b0
        %2 = const 5 bv64
        %3 = const 0 bv64
        parallel %0 %2 wk %1 %3
        ret
}
