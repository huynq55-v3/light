// EXPECT: Vi phạm điều kiện đầu ra
// gọi zero(a) trong vòng lặp, b có thể chồng a
include "../../../lit_program/std/core.lit";
fn zero(n: u64, a: ptr<u64, n>) {
    for i in 0..n {
        a[i] = 0;
    }
}
fn f(k: u64, n: u64, a: ptr<u64, n>, m: u64, b: ptr<u64, m>)
    requires m >= 1
    ensures b[0] == old(b[0])
{
    for i in 0..k {
        zero(n, a);
    }
}
