# EXPECT: Vi phạm bất biến (@inv #0) khi nhảy vào @b1
layout Q 8 {
    0: bv64
}
func f void %0:bv64 {
    @b0
        %1 = const 0 bv64
        jmp @b1 %1
    @b1 %2:bv64
        @inv ule %2 10
        %3 = const 100 bv64
        %4 = cmp ult %2 %3
