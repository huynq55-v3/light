# Lỗ hổng còn mở: hàm cha vẫn ghi vào lát cắt đã giao cho nhân AP mà không cần sync
layout Q 8 {
    0: bv64
}
func evil void %1:ptr<Q,64> %9:ptr<Q,64> %8:bv64 {
    @b0
        %2 = const 1 bv64
        %4 = const 0 bv64
        %5 = slice %9 %2 ptr<Q,1>
        spawn %1 %2 %8 %5 %4
        store %5 0 %4
        ret
}
