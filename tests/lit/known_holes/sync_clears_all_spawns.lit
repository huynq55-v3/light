# Lỗ hổng còn mở: sync có thể trả 0 (nhân 1 còn chạy) nhưng verifier xóa mọi active_spawns -> giao vùng chồng lấn cho nhân 2
layout Q 8 {
    0: bv64
}
func evil void %1:ptr<Q,64> %9:ptr<Q,64> %8:bv64 {
    @b0
        %2 = const 1 bv64
        %3 = const 2 bv64
        %4 = const 0 bv64
        %10 = const 4 bv64
        %5 = slice %9 %10 ptr<Q,4>
        spawn %1 %2 %8 %5 %4
        %6 = sync %1 %2
        %7 = slice %9 %10 ptr<Q,2>
        spawn %1 %3 %8 %7 %4
        ret
}
