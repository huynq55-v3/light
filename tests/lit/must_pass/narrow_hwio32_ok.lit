# narrow có chứng minh + I/O 32-bit cổng PCI (0xCF8/0xCFC)
layout R 4 {
    0: bv32 @inv ult val 64
}
func doorbell void %0:ptr<R,1> %1:bv64 {
    @b0
        %2 = const 63 bv64
        %3 = and %1 %2
        %4 = narrow %3 bv32
        store %0 0 %4
        ret
}
func cfg_rd bv64 %0:io<0xcf8,0xcff> %1:bv64 {
    @req ult %1 64
    @ens ule %6 0xffffffff
    @b0
        %2 = const 0x80000000 bv64
        %3 = const 2 bv64
        %4 = shl %1 %3
        %5 = or %2 %4
        %7 = narrow %5 bv32
        hwio_w %0 0xcf8 %7
        %6 = hwio_r %0 0xcfc
        ret %6
}
func to8 bv8 %0:bv64 {
    @b0
        %1 = const 0xff bv64
        %2 = and %0 %1
        %3 = narrow %2 bv8
        ret %3
}
