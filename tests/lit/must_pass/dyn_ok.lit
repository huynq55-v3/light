# ptr<L,%n>: độ dài là một biến SSA (bất biến). Mọi truy cập vẫn được Z3 chứng minh trong biên.
layout Q 8 {
    0: bv64
}
layout RegionHdr 8 {
    0: bv64                                 # số phần tử đã cấp
}

# Bộ cấp phát vùng (bump): trả về offset của khối %3 phần tử trong arena dài %0, hoặc MAX nếu hết chỗ.
# Không có free riêng lẻ: cả vùng được bỏ một lần (khi App thoát).
func region_try bv64 %0:bv64 %1:ptr<Q,%0> %2:ptr<RegionHdr,1> %3:bv64 {
    @ens or eq %9 0xffffffffffffffff and ule %9 %0 ule %3 sub %0 %9
    @b0
        %4 = load %2 0 bv64
        %5 = cmp ule %4 %0
        br %5 @b1 @b3
    @b1
        %6 = sub %0 %4                      # còn trống
        %7 = cmp ule %3 %6
        br %7 @b2 @b3
    @b2
        %8 = add %4 %3
        store %2 0 %8
        jmp @b4 %4
    @b3
        %10 = const 0xffffffffffffffff bv64
        jmp @b4 %10
    @b4 %9:bv64
        @inv or eq %9 0xffffffffffffffff and ule %9 %0 ule %3 sub %0 %9
        ret %9
}

# Tổng các phần tử của ptr động: vòng lặp mang cặp (ptr, độ dài) qua tham số block
func dyn_sum bv64 %0:bv64 %1:ptr<Q,%0> {
    @b0
        %2 = const 0 bv64
        jmp @b1 %0 %1 %2 %2
    @b1 %3:bv64 %4:ptr<Q,%3> %5:bv64 %6:bv64
        @inv ule %5 %3
        %7 = cmp ult %5 %3
        br %7 @b2 @b3
    @b2
        %8 = slice %4 %5 ptr<Q,1>
        %9 = load %8 0 bv64
        %10 = const 0xff bv64
        %11 = and %9 %10
        %12 = xor %6 %11
        %13 = const 1 bv64
        %14 = add %5 %13
        jmp @b1 %3 %4 %14 %12
    @b3
        ret %6
}

# Trả về ptr động: độ dài là tham số của hàm, người gọi nhận kiểu ptr<Q,%đối_số>
func dyn_head ptr<Q,%2> %0:bv64 %1:ptr<Q,%0> %2:bv64 {
    @req ule %2 %0
    @b0
        %3 = const 0 bv64
        %4 = slice %1 %3 ptr<Q,%2>
        ret %4
}

# Giới hạn ngầm: độ dài * kích thước phần tử <= RAM, nên nhân không tràn
func dyn_bytes bv64 %0:bv64 %1:ptr<Q,%0> {
    @b0
        %2 = const 8 bv64
        %3 = mul %0 %2
        ret %3
}

func wk void %0:ptr<Q,4> %1:bv64 %2:bv64 {
    @b0
        %3 = const 0 bv64
        store %0 24 %3
        ret
}

func app_like void %0:smp %1:ptr<Q,4096> %2:ptr<RegionHdr,1> %3:bv64 {
    @req ule %3 4096
    @b0
        %4 = const 4096 bv64
        %5 = call region_try %4 %1 %2 %3
        %6 = const 0xffffffffffffffff bv64
        %7 = cmp ne %5 %6
        br %7 @b1 @b9
    @b1
        %8 = slice %1 %5 ptr<Q,%3>          # khối mới cấp: ptr<Q,%3>
        %9 = call dyn_sum %3 %8
        %10 = const 16 bv64
        %11 = cmp uge %3 %10
        br %11 @b2 @b9
    @b2
        %12 = call dyn_head %3 %8 %10       # ptr<Q,%10> = 16 phần tử
        %13 = const 4 bv64
        parallel %0 %13 wk %12 %9
        store %12 120 %9                    # phần tử thứ 15
        %14 = call dyn_bytes %3 %8
        jmp @b9
    @b9
        ret
}

# Các bản "đúng" của ca must_fail dyn_*: chuyển đổi tĩnh <-> động khi đã chứng minh đủ độ dài, SIMD, ata_read
func take8 void %0:ptr<Q,8> {
    @b0
        ret
}
func take_n void %0:bv64 %1:ptr<Q,%0> {
    @b0
        ret
}
func conv void %0:bv64 %1:ptr<Q,%0> %2:ptr<Q,4> %3:bv64 {
    @req uge %0 8
    @req ule %3 4
    @b0
        call take8 %1
        call take_n %3 %2
        call take_n %0 %1
        vxor256 %1 %2 %2
        %4 = const 7 bv64
        %5 = slice %1 %4 ptr<Q,1>
        %6 = load %5 0 bv64
        store %1 56 %6
        ret
}
func disk void %0:io<0x1f0,0x1f7> %1:bv64 %2:ptr<Q,%1> {
    @req uge %1 128
    @b0
        %3 = const 0 bv64
        %4 = const 2 bv64
        ata_read %0 %2 %3 %4
        ret
}
