        %2 = slice %0 %1 ptr<Q,1>
        %3 = load %2 0 bv64
        ret %3
}
func half bv64 %0:bv64 {
    @ens ule %2 0x7fffffffffffffff
    @b0
        %1 = const 1 bv64
        %2 = lshr %0 %1
