layout Q 8 {
    0: bv64
}
# Worker ghi part[j] = arg + i, @req phụ thuộc chỉ số phần
func wk void %0:ptr<Q,4> %1:bv64 %2:bv64 {
    @req ult %2 4
    @req ule %1 100
    @b0
        %3 = add %1 %2
        %4 = const 3 bv64
        %5 = slice %0 %4 ptr<Q,1>
        store %5 0 %3
        ret
}
func f bv64 %0:smp %1:ptr<Q,16> %2:bv64 {
    @req uge %2 1
    @req ule %2 4
    @b0
        %3 = const 9 bv64
        parallel %0 %2 wk %1 %3
        %4 = smp_workers %0
        ret %4
}
