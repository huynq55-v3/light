# std/widget.lit (bộ widget cho cửa sổ đổi kích thước) phải qua kiểm chứng + một App nhỏ chọn kích thước theo
# đề nghị configure, vẽ nút / nhãn theo kích thước đó và báo lại cho compositor
include ../../../lit_program/std/widget.lit

data LBL Byte {
    "OK"
}

func demo_main void %fb:ptr<VgaCell,1382400> %ipc:ptr<IpcChannel,1> %font:ptr<DiskQword,64> {
    @req uge %fb 0x10000
    @req ult %fb 0x80000000
    @req uge %font 0x10000
    @req ult %font 0x80000000
    @b0
        %w = call wg_pick_w %ipc 500 400 900
        %h = call wg_pick_h %ipc 300 200 500
        call wg_window_open %fb %font %ipc %w %h 0x4f4d4544 0xffffff
        %px = call wg_client %fb
        %cw = sub %w 4
        %ch = sub %h 34
        %l = addr LBL
        %bx = sub %cw 80
        call wg_button %px %cw %ch %bx 8 64 28 LBL.len %l 0xdbeafe 0x0f172a
        call wg_damage_window %ipc %w %h
        %mx = call wg_mouse_x %ipc
        %my = call wg_mouse_y %ipc
        %hit = call wg_hit %mx %my %bx 8 64 28
        ret
}
