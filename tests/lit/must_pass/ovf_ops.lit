# Phép số học tường minh khi tràn: không cần @req nào, verifier vẫn phải chấp nhận (kể cả chia an toàn trong mul_ovf)
func ovf_add_wrap bv64 %0:bv64 %1:bv64 {
    @b0
        %2 = add_wrap %0 %1
        ret %2
}
func ovf_add_sat bv64 %0:bv64 %1:bv64 {
    @b0
        %2 = add_sat %0 %1
        ret %2
}
func ovf_add_ovf bv64 %0:bv64 %1:bv64 {
    @b0
        %2 = add_ovf %0 %1
        ret %2
}
func ovf_sub_wrap bv64 %0:bv64 %1:bv64 {
    @b0
        %2 = sub_wrap %0 %1
        ret %2
}
func ovf_sub_sat bv64 %0:bv64 %1:bv64 {
    @b0
        %2 = sub_sat %0 %1
        ret %2
}
func ovf_sub_ovf bv64 %0:bv64 %1:bv64 {
    @b0
        %2 = sub_ovf %0 %1
        ret %2
}
func ovf_mul_wrap bv64 %0:bv64 %1:bv64 {
    @b0
        %2 = mul_wrap %0 %1
        ret %2
}
func ovf_mul_sat bv64 %0:bv64 %1:bv64 {
    @b0
        %2 = mul_sat %0 %1
        ret %2
}
func ovf_mul_ovf bv64 %0:bv64 %1:bv64 {
    @b0
        %2 = mul_ovf %0 %1
        ret %2
}
func ovf_checked_add bv64 %0:bv64 %1:bv64 {
    @b0
        %2 = add_ovf %0 %1
        %3 = const 0 bv64
        %4 = cmp ne %2 %3
        br %4 @b1 @b2

    @b1
        ret %3

    @b2
        %5 = add %0 %1
        ret %5
}
